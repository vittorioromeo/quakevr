// Arcane Dimensions bridge (docs/vr-port/ARCANE_DIMENSIONS.md, 5.1 and 5.3): what AD's imported QuakeC (QC/ad/,
// generated by Misc/quakevr/ad_import.py, every name prefixed ad_) needs from Quake VR, and the two switches that
// let it run. Phase 1a: AD's code is compiled in and nothing of it runs (no spawn function of AD's has a map
// classname's name; the engine calls none of AD's entry points); both switches are off.

// AD's data is installed and validated (the engine's discovery of an `ad` folder; P1b). Off until then.
float() VR_Pack_AD =
{
    return FALSE;
};

// This map plays by AD's rules (the AD campaign, or a map the engine detected as made for AD before spawn; P1b).
// Off until then.
float() AD_Rules =
{
    return FALSE;
};
