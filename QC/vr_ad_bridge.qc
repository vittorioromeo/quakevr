// Arcane Dimensions bridge (docs/vr-port/ARCANE_DIMENSIONS.md, 5.3 and 15): what AD's imported QuakeC (QC/ad/,
// generated by Misc/quakevr/ad_import.py, every name prefixed ad_) needs from Quake VR and Quake VR from it, in maps
// played by AD's rules (AD_Rules(): the engine's vr_ad_rules, vr_ad.cpp). After AD's files: it uses their names; its
// functions are declared in vr_ad_defs.qc for Quake VR's files and AD's patches to call.
//
// Who owns what in an AD map (the engine's spawn hook, vr_ad.cpp VR_AD_OwnsClassname):
// - AD's code: AD's own entities and monsters, and AD's world logic (doors, buttons, triggers, lights, paths...);
// - Quake VR's: the player, the vanilla monsters (decision 1), the items and weapons, the spawn points, the
//   intermission and the level exits, with AD's keys and flags adapted here.
// Damage between the two goes through each side's own T_Damage: Quake VR's for the player and our monsters
// (VR_AD_DamageOurs), AD's for AD's entities (AD_Damage), with our hit hooks on AD's monsters (VR_AD_Hit).

// ---------------------------------------------------------------------------------------------------------------------
// AD's patches' hooks (ad_import.py PATCHES, "bridge")

// AD's engine detection (worldspawn): the Fitz path. Our engine's extensions are not the ones AD's effects need
// (effectinfo particles, CSQC stats, DP fog): AD's sprite particles and plain fog.
float() VR_AD_Extensions =
{
    return FALSE;
};

// AD's worldspawn set the player's r_wateralpha from its water_alpha key: never a player's setting (the engine reads
// the key itself, gl_rmisc.c).
void(float a) VR_AD_WaterAlpha =
{
};

// AD's fog controller's fog, by svc_fog as MG's (stuffed commands are filtered): TRUE, AD's stuffcmd is not sent.
float(entity client, float density, vector colour) VR_AD_Fog =
{
    if(client.flags & FL_CLIENT)
    {
        MG_SetFog(client, density, colour);
    }
    return TRUE;
};

// AD's code owns `e`'s damage, pain and death: AD's monsters, breakables, its other damageable entities (not a player).
// An AD monster's corpse or dying body that Quake VR's corpses took (vr_ad_monsters.qc) is Quake VR's: gibbed as one.
float(entity e) AD_Run =
{
    return !(e.flags & FL_CLIENT) && (e.ad_classtype || e.ad_th_die || e.ad_th_pain) && e.vr_corpse != 2 &&
           !e.vr_corpse_dying && !e.vr_shootnade;
};

// AD's T_Damage on one of Quake VR's own (the player, our monsters, our gibs and props): our T_Damage takes it, with
// its VR damage, armour, death and hooks. TRUE: done (AD's T_Damage returns). AD's NOARMOR damage (its debuffs, its
// falls into water) skips the armour.
float(entity targ, entity inflictor, entity attacker, float damage, float checkarmor) VR_AD_DamageOurs =
{
    if(AD_Run(targ))
    {
        return FALSE;
    }
    if(!targ.takedamage || damage <= 0)
    {
        return TRUE;
    }
    float type = targ.armortype;
    if(checkarmor == ad_NOARMOR)
    {
        targ.armortype = 0;
    }
    float oldOurs = vr_ad_ourdamage;
    vr_ad_ourdamage = TRUE; // (AD's code applied its ammo resistance already: AD_Resist)
    T_Damage(targ, inflictor, attacker, damage);
    vr_ad_ourdamage = oldOurs;
    if(checkarmor == ad_NOARMOR && targ.armortype == 0)
    {
        targ.armortype = type;
    }
    return TRUE;
};

float vr_ad_melee; // the blow AD's T_Damage deals now is a VR melee one (AD_Damage)

// AD's T_Damage took `take` health from `targ`: our hit hooks on AD's monsters (decision 14): the damage numbers, gore
// on the walls behind, small gibs, wounds painted on the model.
void(entity targ, entity inflictor, entity attacker, float take) VR_AD_Hit =
{
    if(take <= 0 || !(targ.flags & FL_MONSTER))
    {
        return;
    }
    VR_DamageNumber(targ, inflictor, attacker, take, 0, vr_ad_melee);
    VR_Gore_Hit(targ, inflictor, take);
    VR_SmallGib_Hit(targ, inflictor, attacker, take);
    VR_Wound_Hit(targ, inflictor, attacker, take);
};

// A path_corner of AD's touched by one of our monsters: ours (t_movetarget) moves it on. TRUE: done.
float() VR_AD_PathCornerTouch =
{
    if(!(other.flags & FL_MONSTER) || AD_Run(other))
    {
        return FALSE;
    }
    t_movetarget();
    return TRUE;
};

.float vr_ad_shotserial, vr_ad_shotweapon, vr_ad_shotpellets, vr_ad_shothand;
.vector vr_ad_shotfrom, vr_ad_impactdir;
.vector vr_ad_launchfrom;
.float vr_ad_pelletscale; // a player's AD pellet: its damage, times AD's (AD_FirePellets)

// AD ammo and backpacks refresh the classic viewmodel. Our weapon ids are not AD's item bits
// (WID_SHOTGUN 4 is AD's nailgun); refresh the two VR hands through our own model/ammo table.
float(entity targ) VR_AD_SetCurrentAmmo =
{
    if(!(targ.flags & FL_CLIENT)) return FALSE;
    entity oldSelf = self;
    self = targ;
    W_SetCurrentAmmoFor(cVR_MainHand);
    W_SetCurrentAmmoFor(cVR_OffHand);
    self = oldSelf;
    return TRUE;
};

// AD's projectile pellet's damage, times AD's (4): a player's by the settings (vr_ad_pellet_damage, Weapon Damage).
float(entity pellet) VR_AD_PelletDamage =
{
    return pellet.vr_ad_pelletscale ? pellet.vr_ad_pelletscale : 1;
};

// ---------------------------------------------------------------------------------------------------------------------
// Damage from Quake VR's side

// T_DamageImpl on an entity AD's code owns: AD's T_Damage, after the multipliers of the Gameplay menu and a sneak
// attack's (as T_DamageDeal's; Quad Damage is AD's T_Damage's own), the motion log, a melee kill's bloodlust.
float(entity targ, entity inflictor, entity attacker, float damage, float isVRMelee) AD_Damage =
{
    if(!targ.takedamage)
    {
        return FALSE;
    }
    if((attacker.flags & FL_CLIENT) && (targ.flags & FL_MONSTER))
    {
        damage = damage * cvar_hget(cvarh_vr_damage_to_enemies) * VR_Stealth_SneakMult(targ, attacker);
    }
    VR_Motion_Hit(targ, attacker, damage, isVRMelee);
    float alive = targ.health > 0;
    float before = targ.health;
    float oldMelee = vr_ad_melee;
    vr_ad_melee = isVRMelee;
    ad_T_Damage(targ, inflictor, attacker, damage, ad_DAMARMOR);
    vr_ad_melee = oldMelee;
    if(isVRMelee && alive && getVRMeleeBloodlust() == QVR_MELEEBLOODLUST_ENABLED)
    {
        float take = before - targ.health;
        if(targ.health <= 0)
        {
            T_Heal(attacker, ceil(1 + take / 12) * cvar_hget(cvarh_vr_melee_bloodlust_mult) * 0.75, 1);
        }
        else if(take > 0)
        {
            T_Heal(attacker, ceil(take / 12), 1);
        }
    }
    return TRUE;
};

// ---------------------------------------------------------------------------------------------------------------------
// The world

// worldspawn's end, in an AD map: AD's world setup (its precaches, body queue, light-style, pendulum and map-variable
// arrays, fall and gravity rules, the particle chain), with the world as self.
void() AD_WorldSpawn =
{
    vr_ad_data = (VR_Pack_AD() && cvar("vr_ad_mounted") != 0);
    if(vr_ad_data)
    {
        precache_sound("vr/torch_light.wav"); // (AD's burning lights our fire: vr_ad_player.qc)
        AD_EvilStart(); // (AD's Evil skill: the choice for this level; AD's flag agreeing; vr_ad_player.qc)
    }
    if(!AD_Rules())
    {
        if(vr_ad_data)
        {
            AD_WorldDefaults(); // (outside AD maps: AD's defaults for its artifacts, pickups and debuffs; vr_ad_items.qc)
        }
        return;
    }
    ad_worldspawn();
};

// vr_ad_test (Debug > Tests > Arcane Dimensions): 1 plays the map's first cinematic camera (misc_camera with a
// targetname) on the player; 2 reports the cinematic system's and the player's state (one "adtest:" line).
void(float request) AD_Test =
{
    entity p = find(world, classname, "player");
    if(request >= 10)
    {
        AD_RulesTest(request, p); // (the follow-ups' tests, any map: vr_ad_player.qc)
        return;
    }
    if(request == 1)
    {
        entity cam = find(world, classname, "misc_camera");
        while(cam && cam.targetname == "") cam = find(cam, classname, "misc_camera");
        if(!cam || !p)
        {
            bprint("adtest: no misc_camera with a targetname here\n");
            return;
        }
        entity oself = self, oother = other;
        self = cam;
        other = p;
        ad_activator = p;
        ad_misc_camera_use();
        self = oself;
        other = oother;
        bprint(sprintf("adtest: camera %s started at %v\n", cam.targetname, cam.origin));
        return;
    }
    if(request == 5)
    {
        // 5: a Widowmaker pickup (weapon_upgrade_ssg) 48 units ahead (vr_pickup_test 2 takes it); 6: the upgrades held.
        entity oself5 = self;
        makevectors(p.angles);
        self = spawn();
        self.classname = "weapon_upgrade_ssg";
        setorigin(self, p.origin + v_forward * 48);
        weapon_upgrade_ssg();
        bprint(sprintf("adtest: %s (%s) put at %v\n", self.classname, self.netname, self.origin));
        self = oself5;
        return;
    }
    if(request == 6)
    {
        // (each record's upgrades: 1 the Shadow Axe, 2 the Widowmaker, 4 the Plasma Gun; parm64 packs them so)
        bprint(sprintf("adtest: upgrades: main hand %s (%g), off hand %s (%g), ", WeaponIdToWeaponName(VRGetEntWeapon(p, cVR_MainHand)),
            AD_UpgradeCode(p.weaponinst), WeaponIdToWeaponName(VRGetEntWeapon(p, cVR_OffHand)), AD_UpgradeCode(p.weaponinst2)));
        bprint(sprintf("packed with the holsters' %g; player's own %g\n", AD_PackWeaponUpgrades(p),
            p.ad_moditems & (ad_IT_UPGRADE_AXE | ad_IT_UPGRADE_SSG | ad_IT_UPGRADE_LG)));
        return;
    }
    if(request == 8 || request == 9)
    {
        // 8: the worldspawn keys take_weapons (the shotgun) and give_weapons (the nailgun, the rocket launcher), 9:
        // no_axestart, on the parms of the player's loadout now (SetChangeParms): the slots they leave (not applied).
        entity os8 = self;
        self = p;
        SetChangeParms();
        self = os8;
        bprint(sprintf("adtest: slots before %g %g | %g %g %g ", parm8, parm10, parm11, parm12, parm13));
        bprint(sprintf("%g %g %g\n", parm14, parm15, parm16));
        if(request == 8) AD_WorldWeaponKeysWith(ad_IT_NAILGUN | ad_IT_ROCKET_LAUNCHER, ad_IT_SHOTGUN, FALSE);
        else AD_WorldWeaponKeysWith(0, 0, TRUE);
        bprint(sprintf("adtest: slots after %g %g | %g %g %g ", parm8, parm10, parm11, parm12, parm13));
        bprint(sprintf("%g %g %g\n", parm14, parm15, parm16));
        bprint(sprintf("adtest: owned shotgun %g nailgun %g rocket launcher %g axe %g\n", (parm1 & IT_SHOTGUN) != 0,
            (parm1 & IT_NAILGUN) != 0, (parm1 & IT_ROCKET_LAUNCHER) != 0, (parm1 & IT_AXE) != 0));
        return;
    }
    if(request == 7)
    {
        // 7: an older game's upgrades (the player's own, AD's .moditems: all three) put on the weapons he carries.
        p.ad_moditems = p.ad_moditems | ad_IT_UPGRADE_AXE | ad_IT_UPGRADE_SSG | ad_IT_UPGRADE_LG;
        AD_UpgradesToWeapons(p);
        AD_Test(6);
        return;
    }
    if(request == 3 || request == 4)
    {
        // 3: the Widowmaker's shot (the super shotgun with AD's SSG upgrade, AD's pellets by the Projectile Rules);
        // 4: the Plasma Gun's (the lightning gun with AD's LG upgrade): what they fired, the ammo they took.
        entity oself = self;
        self = p;
        float wid = request == 3 ? WID_SUPER_SHOTGUN : WID_LIGHTNING;
        p.ammo_shells = 50;
        p.ammo_cells = 50;
        VRGiveEntWeapon(p, cVR_MainHand, wid, 0, WeaponIdToBaseClipSize(wid));
        p.weaponinst.wi_adup = AD_UpgradeFor(wid); // (that weapon upgraded)
        W_SetCurrentAmmoFor(cVR_MainHand);
        float shells = p.ammo_shells, cells = p.ammo_cells;
        entity e;
        float before = 0, after = 0;
        for(e = nextent(world); e; e = nextent(e)) if(e.classname == "proj_bullet" || e.ad_classtype == ad_CT_PROJ_PLASMA) before++;
        if(request == 3) W_FireSuperShotgun(cVR_MainHand);
        else AD_FirePlasma(cVR_MainHand);
        for(e = nextent(world); e; e = nextent(e)) if(e.classname == "proj_bullet" || e.ad_classtype == ad_CT_PROJ_PLASMA) after++;
        bprint(sprintf("adtest: %s fired %g projectiles; reserve shells %g -> %g, cells %g -> %g, clip %g\n",
            request == 3 ? "Widowmaker" : "Plasma Gun", after - before, shells, p.ammo_shells, cells, p.ammo_cells,
            VRGetEntWeaponClip(p, cVR_MainHand)));
        bprint(sprintf("adtest: AD's pellets %g, Shadow Axe x%g\n", AD_Pellets(p), AD_AxeScale(cVR_MainHand)));
        self = oself;
        return;
    }
    bprint(sprintf("adtest: cinematic %g active %g player movetype %g solid %g takedamage %g origin %v health %g\n",
        ad_cinematic_running, ad_cam_active, p.movetype, p.solid, p.takedamage, p.origin, p.health));
};

// StartFrame, in an AD map: AD's (skill, frame count); the test aid.
// The sky's changes (P1b's loose ends; AD stuffed console commands to one player): a trigger_skybox's sky by the
// engine's svc_skybox to every client, and again after a load (vr_ad_skysent: AD's trig_skybox, a saved global, sent
// once each map and load); the sky fog by the player's .vr_ad_skyfog (STAT_QVR_ADSKYFOG: the client's sky fog while it
// is set; saved with him), never the player's own r_skyfog.
float SVC_SKYBOX = 37; // (FitzQuake's: [string] the sky's name)
.float vr_ad_skyfog;        // the sky fog AD set: its density (0-1) + 1; 0: the map's own (its worldspawn, r_skyfog)
nosave float vr_ad_skysent; // the trigger_skybox's sky sent since this map or load

void() AD_SendSkybox =
{
    if(ad_trig_skybox == "")
    {
        return;
    }
    WriteByte(MSG_ALL, SVC_SKYBOX);
    WriteString(MSG_ALL, ad_trig_skybox);
    vr_ad_skysent = TRUE;
    dprint(sprintf("VR: AD's sky %s sent\n", ad_trig_skybox));
};

float(entity targ) VR_AD_Skybox =
{
    AD_SendSkybox();
    return TRUE;
};

float(entity client, float density) VR_AD_SkyFog =
{
    if(client.flags & FL_CLIENT)
    {
        client.vr_ad_skyfog = 1 + max(0, min(1, density));
    }
    return TRUE;
};

void() AD_Frame =
{
    if(!vr_ad_data)
    {
        return;
    }
    if(!vr_ad_skysent && ad_trig_skybox != "" && time > 0.3 && find(world, classname, "player"))
    {
        AD_SendSkybox(); // (a loaded game's: the clients have the map's own sky again)
    }
    if(AD_Rules())
    {
        ad_StartFrame();
    }
    else
    {
        ad_skill = skill; // (AD's entities outside AD maps: vr_ad_items.qc)
        ad_framecount = ad_framecount + 1;
    }
    AD_EvilFrame(); // (AD's Evil skill: AD's skill 4 for its code; a loaded game's choice; vr_ad_player.qc)
    float request = cvar("vr_ad_test");
    if(request)
    {
        cvar_set("vr_ad_test", "0");
        AD_Test(request);
    }
};

// ---------------------------------------------------------------------------------------------------------------------
// The player

entity vr_ad_spot; // the spawn point AD_SelectSpawnPoint chose (its target fires as the player arrives)
nosave float vr_ad_firstframe; // AD's first-frame setup done (a map's start, a loaded game's: nosave)
.float vr_ad_laddergravity; // a player held on an AD ladder (its gravity to give back)

// SelectSpawnPoint, single player in an AD map: AD's (info_player_start2 by the exit's startspawn2, the hub's returns;
// the developer start), or world for Quake VR's own choice.
entity() AD_SelectSpawnPoint =
{
    vr_ad_spot = world;
    if(!AD_Rules() || coop || deathmatch)
    {
        return world;
    }
    vr_ad_spot = ad_SelectSpawnPoint();
    return vr_ad_spot;
};

// PutClientInServer's end, in an AD map: what AD's code reads of a player (its class, its entity state, the debuffs
// and AD's powerups reset), and the spawn point's targets to fire.
void() AD_PlayerSpawned =
{
    if(!AD_Rules())
    {
        return;
    }
    ad_client_ent = self;
    self.ad_classtype = ad_CT_PLAYER;
    self.ad_classgroup = ad_CG_PLAYERS;
    self.ad_estate = ad_ESTATE_ON;
    self.ad_gibhealth = -40;
    self.ad_gibbed = FALSE;
    self.ad_bbmins = self.mins;
    self.ad_bbmaxs = self.maxs;
    self.ad_steptype = ad_FS_TYPEMEDIUM;
    ad_intermission_running = ad_cinematic_running = 0;
    if(world.ad_ckeyhint == TRUE) self.ad_ckeyhint = TRUE;
    ad_ResetPowerSystem(self, 0, TRUE); // (AD's own powerups; Quake VR's are ours)
    ad_ResetDebuffSystem(self);
    self.ad_target2 = vr_ad_spot ? vr_ad_spot.target : "";
};

// PlayerPreThink, in any map while AD's data is there (its ladders spawn anywhere): AD's ladders (trigger_ladder: the
// keyboard climb for non-VR play only; tracked VR hands climb the real rungs, vr_ad_player.qc).
void() AD_PlayerPreThink =
{
    if(!vr_ad_data || self.deadflag)
    {
        return;
    }
    // AD support: no keyboard ladder gravity lock or upward boost while VR hands climb the ladder (VR_AD_LadderManual).
    if(VR_AD_LadderManual(self))
    {
        self.ad_onladder = ad_LADDER_NONE;
        if(self.vr_ad_laddergravity) self.gravity = self.vr_ad_laddergravity;
        self.vr_ad_laddergravity = 0;
        return;
    }
    if(self.ad_onladder == ad_LADDER_JUMP)
    {
        self.ad_onladder = ad_LADDER_NONE;
        if(!self.vr_ad_laddergravity) self.vr_ad_laddergravity = self.gravity ? self.gravity : 1;
        if(self.button2)
        {
            self.velocity = '0 0 0';
            self.velocity_z = self.ad_entladder.speed;
            self.gravity = 0.0000001;
            if(self.ad_timeladder < time)
            {
                self.ad_timeladder = time + self.ad_entladder.waitmin;
                ad_Client_LadderSounds(self);
            }
        }
        else
        {
            self.flags = self.flags | FL_JUMPRELEASED;
            self.velocity = 0.9 * self.velocity;
            self.velocity_z = 0;
            self.gravity = 0.0000001;
        }
    }
    else
    {
        if(self.ad_onladder == ad_LADDER_VEL)
        {
            self.ad_onladder = ad_LADDER_NONE;
        }
        if(self.vr_ad_laddergravity)
        {
            self.gravity = self.vr_ad_laddergravity;
            self.vr_ad_laddergravity = 0;
        }
    }
};

// PlayerPostThink (after the weapons), in an AD map: AD's first-frame setup (its config flags, the fog controller,
// the liquids' alpha), the spawn point's targets, the debuffs (poison, burning, bleeding).
void() AD_PlayerPostThink =
{
    if(!vr_ad_data)
    {
        return;
    }
    AD_ArtifactsTick(); // (any map: AD's artifacts' time, the HUD's readings; vr_ad_items.qc)
    if(!AD_Rules())
    {
        AD_DebuffsTick(); // (any map: AD's poison and bleeding; vr_ad_player.qc)
        return;
    }
    if(!vr_ad_firstframe)
    {
        vr_ad_firstframe = TRUE;
        ad_prethink = TRUE;
        ad_postthink = TRUE;
        ad_mapvar_cvar = TRUE;
        ad_sync_configflag();
        ad_liquid_alpha = world.ad_water_alpha ? world.ad_water_alpha : cvar("r_wateralpha");
        if(ad_fog_active) ad_change_fog(self);
        else ad_setup_fog_controller();
    }
    if(self.deadflag || ad_cinematic_running > 0)
    {
        return;
    }
    if(self.ad_target2 != "")
    {
        string fire = self.ad_target2;
        self.ad_target2 = "";
        ad_trigger_strs(fire, self);
    }
    AD_DebuffsTick();
};

// PlayerPostThink's landing, in an AD map: AD's fall rules (decision 15): the map's fall speeds and damage
// (worldspawn fall_speedlow/high, fall_dmg, fall_dmgwater; AD's defaults otherwise). TRUE: taken (Quake VR's skipped).
float() AD_PlayerLanded =
{
    if(!AD_Rules())
    {
        return FALSE;
    }
    if((self.jump_flag < ad_map_fallspeedlow) && (self.flags & FL_ONGROUND) && (self.health > 0))
    {
        if(self.watertype == CONTENT_WATER)
        {
            sound(self, CHAN_BODY, "player/h2ojump.wav", 1, ATTN_NORM);
            if(ad_map_falldmgwater > 0)
            {
                self.deathtype = "falling";
                T_Damage(self, world, world, ad_map_falldmgwater);
                sound(self, CHAN_VOICE, "player/land.wav", 1, ATTN_NORM);
            }
        }
        else if(self.jump_flag < ad_map_fallspeedhigh && ad_map_falldmg > 0)
        {
            self.deathtype = "falling";
            T_Damage(self, world, world, ad_map_falldmg);
            sound(self, CHAN_VOICE, "player/land2.wav", 1, ATTN_NORM);
        }
        else
        {
            sound(self, CHAN_VOICE, "player/land.wav", 1, ATTN_NORM);
        }
        if(self.watertype != CONTENT_WATER && time - self.stl_climb_time > 0.5)
            VR_Stealth_Noise(self.origin, min(500, -self.jump_flag * 0.6), self, STL_N_STEP);
        self.jump_flag = 0;
    }
    return TRUE;
};

// Our items in AD maps: AD's respawn (decision 25: AD levels only) and STARTOFF keys.
.string vr_ad_offmodel; // a STARTOFF item's model, until a trigger brings it in
.vector vr_ad_offmins, vr_ad_offmaxs;

// A STARTOFF item (64) triggered: it appears (placed as it would have been at the map's start).
void() AD_ItemAppear =
{
    if(self.vr_ad_offmodel == "")
    {
        return;
    }
    setmodel(self, self.vr_ad_offmodel);
    setsize(self, self.vr_ad_offmins, self.vr_ad_offmaxs);
    self.vr_ad_offmodel = "";
    self.use = SUB_Null;
    self.nextthink = time + 0.1;
    self.think = PlaceItem;
};

// StartItem, in an AD map: an item AD's STARTOFF flag holds back waits, unseen and untouchable, for its trigger.
// TRUE: it waits.
float() AD_ItemStartOff =
{
    if(!VR_SF_Has(self, VR_SF_STARTOFF) || self.targetname == "" || self.model == "")
    {
        return FALSE;
    }
    self.vr_ad_offmodel = self.model;
    self.vr_ad_offmins = self.mins;
    self.vr_ad_offmaxs = self.maxs;
    setmodel(self, "");
    self.solid = SOLID_NOT;
    self.use = AD_ItemAppear;
    return TRUE;
};

// A respawning item (RESPAWN 16, respawn_trig) triggered after it was taken: back now.
void() AD_ItemRespawnUse =
{
    if(self.model != string_null)
    {
        return;
    }
    self.use = SUB_Null;
    VR_PickupObj_Regen();
};

// VR_PickupObj_Taken, the item taken in an AD map: AD's respawn (RESPAWN flag 16): after respawn_time (default 30 s),
// or when triggered (respawn_trig), at most respawn_count times (0: always).
void(entity xItem) AD_ItemTaken =
{
    if(xItem.ad_touch2 == ad_BackpackTouch) return; // AD support: AD-owned bags keep their own respawn state

    if(!VR_SF_Has(xItem, VR_SF_ITEM_RESPAWN) || xItem.model != string_null)
    {
        return;
    }
    if(xItem.ad_respawn_count > 0)
    {
        xItem.ad_respawn_count = xItem.ad_respawn_count - 1;
        if(xItem.ad_respawn_count == 0) xItem.spawnflags = xItem.spawnflags - VR_SF_Bit(VR_SF_AD, VR_SF_ITEM_RESPAWN);
    }
    if(xItem.ad_respawn_trig || xItem.ad_respawn_time < 0)
    {
        xItem.use = AD_ItemRespawnUse;
        return;
    }
    xItem.think2 = VR_PickupObj_Regen;
    xItem.nextthink2 = time + (xItem.ad_respawn_time > 0 ? max(1, xItem.ad_respawn_time) : 30);
};

// health_touch, a megahealth taken in an AD map: AD's rot (decision 15): one rot for the player however many megahealths
// he took (Quake's: one each, so two rot twice as fast), from 5 s on, a point a second down to his maximum, ticked
// with AD's debuffs (AD_PlayerPostThink). TRUE: taken (Quake's rot not started).
float(entity p) AD_MegaRot =
{
    if(!AD_Rules())
    {
        return FALSE;
    }
    ad_RotDeBuff(p, 0);
    VR_ItemUtil_EntAddItem(p, IID_SUPERHEALTH);
    return TRUE;
};

// ---------------------------------------------------------------------------------------------------------------------
// Levels: parms, exits

// The state AD keeps from level to level, in parm57..72 (Quake VR's own hold parm1..56): its map variables (AD's
// parm11..16) and its weapon upgrades (AD's parm10, less what a level change takes).
// parm57..62 map variables; parm63 AD's upgrades (moditems).
float vr_ad_resetinv; // the exit taken resets the inventory (AD's RESETINV changelevel flag)

// SetChangeParms (first): AD's state into its parms. TRUE: the exit resets the inventory (SetNewParms done).
float() AD_SetChangeParms =
{
    if(!AD_Rules())
    {
        return FALSE;
    }
    parm57 = ad_mapvar[0]; parm58 = ad_mapvar[1]; parm59 = ad_mapvar[2];
    parm60 = ad_mapvar[3]; parm61 = ad_mapvar[4]; parm62 = ad_mapvar[5];
    parm63 = 0;
    if(self.health > 0 && !vr_ad_resetinv)
    {
        parm63 = self.ad_moditems - (self.ad_moditems & ad_IT_MODRESET);
    }
    if(vr_ad_resetinv)
    {
        vr_ad_resetinv = FALSE;
        SetNewParms();
        return TRUE;
    }
    return FALSE;
};

// ---------------------------------------------------------------------------------------------------------------------
// AD's worldspawn weapon keys (P1b's loose ends), on Quake VR's hands and holsters, as the level starts (AD's own
// DecodeLevelParms reads them on its .items bits): `no_axestart` 1, a map made for starting with nothing: no weapon in
// a hand or a holster, none owned, no upgrade (Evil keeps its Shadow Axe's blows: AD_AxeScale); `take_weapons` (AD's
// item bits) each of those weapons gone from the hands and the holsters (never the axe, as AD's); `give_weapons` each
// one not already carried put in the first free holster (the hips', the chest's, the back's, then a hand), owned; with
// none free, owned only (its pickup elsewhere: the weapons are physical). Here on the parms the records are made from:
// the weapon slots are parm8/parm10 (the hands) and parm11..16 (the holsters), each with its flags (parm23..30), magazine
// (parm31..38), id (parm41..48) and upgrades (parm64's 3 bits).

// Slot `i` (0 the main hand, 1 the off hand, 2..7 the holsters: AD_CarriedInst's order): its weapon id.
float(float i) AD_ParmWid =
{
    if(i == 0) return parm8;
    if(i == 1) return parm10;
    if(i == 2) return parm11;
    if(i == 3) return parm12;
    if(i == 4) return parm13;
    if(i == 5) return parm14;
    if(i == 6) return parm15;
    return parm16;
};

// Slot `i` set to weapon `xWid`, a new one (no flags, an empty magazine, a new id, no upgrade).
void(float i, float xWid) AD_ParmSet =
{
    if(i == 0) { parm8 = xWid; parm23 = 0; parm31 = 0; parm41 = 0; }
    else if(i == 1) { parm10 = xWid; parm24 = 0; parm32 = 0; parm42 = 0; }
    else if(i == 2) { parm11 = xWid; parm25 = 0; parm33 = 0; parm43 = 0; }
    else if(i == 3) { parm12 = xWid; parm26 = 0; parm34 = 0; parm44 = 0; }
    else if(i == 4) { parm13 = xWid; parm27 = 0; parm35 = 0; parm45 = 0; }
    else if(i == 5) { parm14 = xWid; parm28 = 0; parm36 = 0; parm46 = 0; }
    else if(i == 6) { parm15 = xWid; parm29 = 0; parm37 = 0; parm47 = 0; }
    else { parm16 = xWid; parm30 = 0; parm38 = 0; parm48 = 0; }
    float k = pow(8, i);
    float code = floor(parm64 / k) - floor(parm64 / (k * 8)) * 8;
    parm64 = parm64 - code * k;
};

// AD's weapon item bits (the same as Quake's IT_ bits) and Quake VR's weapon ids, in order.
float(float n) AD_KeyBit =
{
    if(n == 0) return ad_IT_SHOTGUN;
    if(n == 1) return ad_IT_SUPER_SHOTGUN;
    if(n == 2) return ad_IT_NAILGUN;
    if(n == 3) return ad_IT_SUPER_NAILGUN;
    if(n == 4) return ad_IT_GRENADE_LAUNCHER;
    if(n == 5) return ad_IT_ROCKET_LAUNCHER;
    return ad_IT_LIGHTNING;
};
float(float n) AD_KeyWid =
{
    if(n == 0) return WID_SHOTGUN;
    if(n == 1) return WID_SUPER_SHOTGUN;
    if(n == 2) return WID_NAILGUN;
    if(n == 3) return WID_SUPER_NAILGUN;
    if(n == 4) return WID_GRENADE_LAUNCHER;
    if(n == 5) return WID_ROCKET_LAUNCHER;
    return WID_LIGHTNING;
};

// AD_DecodeLevelParms: the map's worldspawn weapon keys on the parms (`xGive`, `xTake`: AD's item bits; `xNone`:
// no_axestart).
void(float xGive, float xTake, float xNone) AD_WorldWeaponKeysWith =
{
    float i, n;
    if(xNone && !AD_Evil())
    {
        for(i = 0; i < 8; i++)
        {
            AD_ParmSet(i, WID_FIST);
        }
        parm1 = parm1 - (parm1 & (IT_AXE | IT_SHOTGUN | IT_SUPER_SHOTGUN | IT_NAILGUN | IT_SUPER_NAILGUN | IT_GRENADE_LAUNCHER |
                                  IT_ROCKET_LAUNCHER | IT_LIGHTNING));
        parm64 = 0;
        dprint("VR: AD's no_axestart: the level starts with no weapon\n");
        return;
    }
    for(n = 0; n < 7; n++)
    {
        float wid = AD_KeyWid(n);
        if(xTake & AD_KeyBit(n))
        {
            for(i = 0; i < 8; i++)
            {
                if(AD_ParmWid(i) == wid)
                {
                    AD_ParmSet(i, WID_FIST);
                }
            }
            parm1 = parm1 - (parm1 & AD_KeyBit(n));
            dprint(sprintf("VR: AD's take_weapons: the %s taken\n", WeaponIdToWeaponName(wid)));
        }
        if(xGive & AD_KeyBit(n))
        {
            float carried = FALSE;
            for(i = 0; i < 8; i++)
            {
                carried = (carried || AD_ParmWid(i) == wid);
            }
            parm1 = parm1 | AD_KeyBit(n);
            if(carried)
            {
                continue;
            }
            // The first free holster: the hips', the chest's, the back's; then a hand.
            float slot = -1;
            float order[8];
            order[0] = 4; order[1] = 5; order[2] = 6; order[3] = 7; order[4] = 2; order[5] = 3; order[6] = 0; order[7] = 1;
            for(i = 0; i < 8 && slot < 0; i++)
            {
                if(AD_ParmWid(order[i]) == WID_FIST)
                {
                    slot = order[i];
                }
            }
            if(slot >= 0)
            {
                AD_ParmSet(slot, wid);
            }
            dprint(sprintf("VR: AD's give_weapons: the %s %s\n", WeaponIdToWeaponName(wid),
                slot >= 0 ? "put in a free holster or hand" : "owned (no holster or hand free)"));
        }
    }
};

void() AD_WorldWeaponKeys =
{
    AD_WorldWeaponKeysWith(world.ad_give_weapons, world.ad_take_weapons, world.ad_no_axestart);
};

// DecodeLevelParms (before the parms are read), in an AD map: AD's worldspawn inventory keys on the level's start
// (reset_health, max_health as a minimum, ammo_* with currentammo, armortype/armorvalue), its map variables and
// upgrades from parm57..63, AD's serverflags synced. (give_weapons/take_weapons/no_axestart: section 15's list.)
void() AD_DecodeLevelParms =
{
    if(!AD_Rules())
    {
        return;
    }
    ad_mapvar_cvar = TRUE;
    if((serverflags & ad_SVR_RUNE_ALL) && world.model == "maps/start.bsp")
    {
        SetNewParms(); // (AD: every rune found, back to the hub: a new episode)
    }
    ad_sync_serverflags();
    if(world.ad_reset_health > 0 && world.ad_reset_health <= ad_HEAL_PLAYMAX) parm2 = world.ad_reset_health;
    else if(world.max_health > 0 && parm2 < world.max_health) parm2 = world.max_health;
    if(world.ammo_shells || (world.currentammo && parm4 > 0)) parm4 = world.currentammo ? world.ammo_shells : max(parm4, world.ammo_shells);
    if(world.ammo_nails || (world.currentammo && parm5 > 0)) parm5 = world.currentammo ? world.ammo_nails : max(parm5, world.ammo_nails);
    if(world.ammo_rockets || (world.currentammo && parm6 > 0)) parm6 = world.currentammo ? world.ammo_rockets : max(parm6, world.ammo_rockets);
    if(world.ammo_cells || (world.currentammo && parm7 > 0)) parm7 = world.currentammo ? world.ammo_cells : max(parm7, world.ammo_cells);
    parm4 = clamp(parm4, 0, ad_AMMO_MAXSHELLS); parm5 = clamp(parm5, 0, ad_AMMO_MAXNAILS);
    parm6 = clamp(parm6, 0, ad_AMMO_MAXROCKETS); parm7 = clamp(parm7, 0, ad_AMMO_MAXROCKETS);
    if(world.armortype >= 1 && world.armortype <= 3)
    {
        parm1 = parm1 - (parm1 & (IT_ARMOR1 | IT_ARMOR2 | IT_ARMOR3));
        float value = world.armortype == 1 ? ad_ARMOR_GRN_VALUE : world.armortype == 2 ? ad_ARMOR_YEL_VALUE : ad_ARMOR_RED_VALUE;
        parm1 = parm1 | (world.armortype == 1 ? IT_ARMOR1 : world.armortype == 2 ? IT_ARMOR2 : IT_ARMOR3);
        parm9 = (world.armortype == 1 ? ad_ARMOR_GRN_TYPE : world.armortype == 2 ? ad_ARMOR_YEL_TYPE : ad_ARMOR_RED_TYPE) * 100;
        parm3 = world.armorvalue > 0 ? min(world.armorvalue, value) : value;
    }
    ad_mapvar[0] = parm57; ad_mapvar[1] = parm58; ad_mapvar[2] = parm59;
    ad_mapvar[3] = parm60; ad_mapvar[4] = parm61; ad_mapvar[5] = parm62;
    self.ad_moditems = parm63;
    AD_WorldWeaponKeys(); // (give_weapons, take_weapons, no_axestart: on our hands and holsters)
};

void() AD_ChangelevelUse;

// trigger_changelevel's spawn, in an AD map: AD's keys (no map: this map again; ad_tears' exits all go to the hub, as
// AD's own; STARTOFF: off until triggered).
void() AD_ChangelevelSpawn =
{
    if(!AD_Rules())
    {
        return;
    }
    if(!self.map) self.map = mapname;
    if(mapname == "ad_tears") self.map = "start";
    self.ad_estate = VR_SF_Has(self, VR_SF_STARTOFF) ? ad_ESTATE_OFF : ad_ESTATE_ON;
    if(self.targetname != "") self.use = AD_ChangelevelUse;
};

// A trigger targeting an AD map's exit switches it on (AD's entity state).
void() AD_ChangelevelUse =
{
    self.ad_estate = ad_ESTATE_ON;
};

// changelevel_touch, in an AD map: FALSE while the exit is off; else AD's on-exit rules (the debuffs and AD's powerups
// end, the exit's map variables, the next map's spawn point (startspawn2), the inventory reset flag).
float() AD_ChangelevelTouch =
{
    if(!AD_Rules())
    {
        return TRUE;
    }
    if(self.ad_estate & ad_ESTATE_BLOCK)
    {
        return FALSE;
    }
    ad_ResetPowerSystem(other, 0, TRUE);
    ad_ResetDebuffSystem(other);
    if(self.ad_mapvar_update != '0 0 0') ad_mapvar_range(self.ad_mapvar_update);
    float n = (self.ad_startspawn2 >= 1 && self.ad_startspawn2 <= 7) ? self.ad_startspawn2 : 0;
    ad_update_configflag(ad_SVR_SPAWN_BIT1, n & 1 ? TRUE : FALSE);
    ad_update_configflag(ad_SVR_SPAWN_BIT2, n & 2 ? TRUE : FALSE);
    ad_update_configflag(ad_SVR_SPAWN_BIT3, n & 4 ? TRUE : FALSE);
    vr_ad_resetinv = VR_SF_Has(self, VR_SF_EXIT_RESETINV);
    return TRUE;
};

// ---------------------------------------------------------------------------------------------------------------------
// Our monsters in AD maps: AD's spawn flags and keys (decision 1)

// AD's delayed spawn (64) and angry spawn (128): the monster waits for its trigger (as MG's deferred ones, invisible,
// not solid), then appears (with AD's spawn effect unless 32) and, angry, goes for whoever triggered it.
void() AD_MonsterRunStart =
{
    entity oldact = activator;
    activator = self.MG_monster_activator;
    self.MG_monster_start();
    if(VR_SF_Has(self, VR_SF_MON_ANGRY)) monster_use();
    activator = oldact;
};

// One of our entities used by AD's triggers and items: AD's code keeps its own activator (ad_activator), ours reads
// activator: the player AD's trigger names, when ours names none. Wherever AD's data is (its entities in any map:
// section 16; P1b's loose ends: in AD maps only before 2026-10-12).
void() AD_SyncActivator =
{
    if(vr_ad_data && !(activator.flags & FL_CLIENT) && (ad_activator.flags & FL_CLIENT))
    {
        activator = ad_activator;
    }
};

// Our SUB_UseTargets wherever AD's data is: AD's entities it fires read AD's activator: the player ours names.
void() AD_ShareActivator =
{
    if(vr_ad_data && (activator.flags & FL_CLIENT))
    {
        ad_activator = activator;
    }
};

void() AD_MonsterActivate =
{
    AD_SyncActivator();
    if(!self.MG_deferred) return;
    self.MG_deferred = FALSE;
    self.solid = self.MG_monster_solid;
    self.movetype = self.MG_monster_move;
    setmodel(self, self.MG_monster_model);
    setsize(self, self.MG_monster_mins, self.MG_monster_maxs);
    self.flags = self.flags | FL_MONSTER;
    self.MG_monster_activator = activator;
    spawn_tdeath(self.origin, self);
    if(!VR_SF_Has(self, VR_SF_MON_NOSPAWNFX)) spawn_tfog(self.origin);
    self.think = AD_MonsterRunStart;
    self.nextthink = time + 0.1;
};

// walk/fly/swimmonster_start, in an AD map: AD's keys (nomonstercount), and its delayed spawn. TRUE: deferred.
float(void() start) AD_MonsterPrepare =
{
    if(!AD_Rules())
    {
        return FALSE;
    }
    if(self.ad_nomonstercount)
    {
        total_monsters = total_monsters - 1;
    }
    if(!VR_SF_Has(self, VR_SF_MON_DELAYED))
    {
        return FALSE;
    }
    self.MG_monster_start = start;
    self.MG_monster_model = self.model;
    self.MG_monster_mins = self.mins;
    self.MG_monster_maxs = self.maxs;
    self.MG_monster_solid = self.solid;
    self.MG_monster_move = self.movetype;
    self.MG_deferred = TRUE;
    self.use = AD_MonsterActivate;
    self.nextthink = 0;
    self.think = SUB_Null;
    self.takedamage = DAMAGE_NO;
    self.solid = SOLID_NOT;
    self.movetype = MOVETYPE_NONE;
    self.flags = self.flags - (self.flags & FL_MONSTER);
    setmodel(self, "");
    return TRUE;
};

// Killed, in an AD map: one of our monsters' AD keys (deathtarget fires as it dies).
void(entity targ, entity attacker) AD_MonsterKilled =
{
    if(!AD_Rules() || !(targ.flags & FL_MONSTER) || AD_Run(targ))
    {
        return;
    }
    if(targ.ad_deathtarget != "")
    {
        ad_trigger_strs(targ.ad_deathtarget, attacker);
    }
};

// ---------------------------------------------------------------------------------------------------------------------
// AD's projectile pellets (decisions 2 and 22): vr_ad_projectiles 0 Auto (AD's in AD maps), 1 Vanilla, 2 AD's wherever
// AD's data is mounted; a map's no_sgprojectile key keeps AD's own hitscan.

// Whether AD's projectile rules play here (vr_ad_projectiles: Auto in AD maps, AD's wherever its data is mounted).
float() AD_ProjectileRules =
{
    float mode = cvar("vr_ad_projectiles");
    if(mode == 1 || !cvar("vr_ad_mounted"))
    {
        return FALSE;
    }
    return mode == 2 || AD_Rules();
};

float(entity p) AD_Pellets =
{
    if(AD_Rules() && world.ad_no_sgprojectile > 0)
    {
        return FALSE;
    }
    return AD_ProjectileRules();
};

// A vanilla monster's projectile (`kind`: AD_PROJ_*): AD's speed for the skill where AD's projectile rules apply
// (as AD_Pellets: Auto in AD maps, AD's wherever its data is mounted), Quake's `idSpeed` otherwise (decision 22).
float(float idSpeed, float kind) AD_MonsterSpeed =
{
    if(!AD_ProjectileRules())
    {
        return idSpeed;
    }
    float s = skill;
    if(kind == AD_PROJ_HKNIGHT) return ad_SPEED_HKSPIKE + s * ad_SPEED_HKSKILL;
    if(kind == AD_PROJ_WIZARD) return ad_SPEED_WIZSPIKE + s * ad_SPEED_WIZSKILL;
    if(kind == AD_PROJ_OGRE) return ad_SPEED_MONGRENADE + s * ad_SPEED_MONGLSKILL;
    if(kind == AD_PROJ_ZOMBIE) return ad_SPEED_ZOMBFLESH + s * ad_SPEED_ZOMBIESKILL;
    return idSpeed;
};

// FireBullets, the player's: AD's pellets (a tracer and `shotcount` pellets) from the muzzle along the gun, at AD's
// spread for the shotgun or the super shotgun times vr_ad_pellet_spread, AD's speed times vr_ad_pellet_speed, each
// pellet's damage the Weapon Damage setting's (vr_pellet_damage) times vr_ad_pellet_damage.
void(float xHand, float shotcount, vector dir, vector spread, vector muzzle) AD_FirePellets =
{
    float ssg = shotcount > 6; // (a super shotgun's pair of barrels; one barrel fires as the shotgun, as ours)
    float wid = VRGetWeapon(xHand);
    float shotgun = wid == WID_SHOTGUN || wid == WID_SUPER_SHOTGUN || wid == WID_GRUNTGUN;
    // The burst rifle is a bullet, not a shotgun blast: retain its tighter spread.
    if(wid == WID_GRUNTGUN && cvar_hget(cvarh_vr_grunt_burst)) shotgun = FALSE;
    vector pattern = (shotgun ? AD_SharpSpread(ssg ? ad_SPREAD_SSG : ad_SPREAD_SG) : spread);
    pattern = pattern * cvar("vr_ad_pellet_spread");
    float speed = (ssg ? ad_SPEED_PLAYERSSG : ad_SPEED_PLAYERSG) * max(0.1, cvar("vr_ad_pellet_speed"));
    float scale = cvar("vr_ad_pellet_damage") * (vr_pellet_damage ? vr_pellet_damage : ad_DAMAGE_PSHELL) / ad_DAMAGE_PSHELL;
    if(shotgun && VRGet2HAiming(self))
    {
        pattern = pattern * cvar_hget(cvarh_vr_2h_spread_reduction);
    }
    float pellets = shotcount;
    vr_sgib_blastserial++;
    float serial = vr_sgib_blastserial;
    makevectors(vectoangles(dir));
    ad_Launch_Bullet(muzzle, dir, ad_CT_PROJ_TRACE, speed);
    while(shotcount > 0)
    {
        vector d = dir + crandom() * pattern_x * v_right + crandom() * pattern_y * v_up;
        ad_Launch_Bullet(muzzle, d, ssg ? ad_CT_PROJ_SSG : ad_CT_PROJ_SG, speed + crandom() * 10);
        if(wid == WID_SUPER_SHOTGUN && AD_HandUpgraded(xHand, ad_IT_UPGRADE_SSG))
        {
            ad_newmis.weapon = TRUE; // (AD's: the Widowmaker's pellets kill zombies; it asked the player's upgrade)
        }
        ad_newmis.vr_ad_pelletscale = scale;
        ad_newmis.vr_ad_shotserial = serial;
        ad_newmis.vr_ad_shotweapon = shotgun ? (ssg ? QVR_DECAP_SSG : QVR_DECAP_SHOTGUN) : 0;
        ad_newmis.vr_ad_shotpellets = pellets;
        ad_newmis.vr_ad_shotfrom = muzzle;
        ad_newmis.vr_ad_shothand = xHand;
        shotcount = shotcount - 1;
    }
};

// EnemyFireBullets (a grunt's shotgun): AD's monster pellets, at AD's speed for the skill. TRUE: fired.
float(float shotcount, vector dir, vector spread, vector src) AD_EnemyPellets =
{
    if(!AD_Pellets(self))
    {
        return FALSE;
    }
    float speed = ad_SPEED_MONSG + skill * ad_SPEED_MONSGMULT;
    makevectors(vectoangles(dir));
    ad_Launch_Bullet(src, dir, ad_CT_PROJ_TRACE, speed);
    while(shotcount > 0)
    {
        vector d = dir + crandom() * spread_x * v_right + crandom() * spread_y * v_up;
        ad_Launch_Bullet(src, d, ad_CT_PROJ_SG, speed + crandom() * 10);
        shotcount = shotcount - 1;
    }
    return TRUE;
};

// ---------------------------------------------------------------------------------------------------------------------
// AD's weapons (decision 23; decision 38, "more immersive": 2026-10-12): an upgrade belongs to the weapon picked up with
// it (its record's .wi_adup, vr_weaponinst.qc), not to the player as in AD: the Shadow Axe is that axe (it hits harder),
// the Widowmaker that super shotgun (21 pellets for 3 shells, reloaded at the hip), the Plasma Gun that lightning gun
// (plasma bolts). It goes with the weapon from hand to holster, to the ground, into saves and to the next level
// (parm64); a plain axe found later stays plain, and two axes held are a Shadow Axe and an axe. A player's own upgrades
// (AD's .moditems: saves and level changes made before) are put on his weapons of their kinds as he spawns or loads
// (AD_UpgradesToWeapons). Quake VR's models, holsters and reloading; AD's own models and VR polish come later (P3/P4).

.float vr_ad_upgrade; // a weapon pickup that is AD's upgrade (its .moditems bit): weapon_touch gives it (AD_UpgradePickedUp)

// Whether the weapon `xInst` (its record, vr_weaponinst.qc; world: none, a plain weapon) of player `xPlayer` has AD's
// upgrade `xBit`, where the upgrades play (Weapon Upgrades' scope). The one place every upgrade is asked about.
float(entity xPlayer, entity xInst, float xBit) AD_WeaponUpgraded =
{
    return xInst != world && (xInst.wi_adup & xBit) && VR_AD_FeatureScope(AD_UpgradeScope());
};

// The upgrade a weapon of kind `xWid` can have (0: none).
float(float xWid) AD_UpgradeFor =
{
    if(xWid == WID_AXE) return ad_IT_UPGRADE_AXE;
    if(xWid == WID_SUPER_SHOTGUN) return ad_IT_UPGRADE_SSG;
    if(xWid == WID_LIGHTNING) return ad_IT_UPGRADE_LG;
    return 0;
};

// weapon_touch, the weapon of `xPickup` (an upgrade's pickup) just given to `p`'s hand `xHand`: its upgrade on it.
void(entity xPickup, entity p, float xHand) AD_UpgradeGiven =
{
    entity inst = VRGetEntWeaponInst(p, xHand);
    if(!xPickup.vr_ad_upgrade || inst == world)
    {
        return;
    }
    inst.wi_adup = inst.wi_adup | xPickup.vr_ad_upgrade;
    dprint(sprintf("VR: %s: the %s in hand %g (weapon %g) is upgraded\n", xPickup.netname, WeaponIdToWeaponName(VRGetEntWeapon(p, xHand)),
        xHand, inst.wi_uid));
};

// The upgrades of a record as 3 bits (1 the Shadow Axe, 2 the Widowmaker, 4 the Plasma Gun), and back.
float(entity xInst) AD_UpgradeCode =
{
    if(xInst == world) return 0;
    return ((xInst.wi_adup & ad_IT_UPGRADE_AXE) ? 1 : 0) + ((xInst.wi_adup & ad_IT_UPGRADE_SSG) ? 2 : 0) +
           ((xInst.wi_adup & ad_IT_UPGRADE_LG) ? 4 : 0);
};
void(entity xInst, float xCode) AD_UpgradeDecode =
{
    if(xInst == world) return;
    xInst.wi_adup = ((xCode & 1) ? ad_IT_UPGRADE_AXE : 0) | ((xCode & 2) ? ad_IT_UPGRADE_SSG : 0) | ((xCode & 4) ? ad_IT_UPGRADE_LG : 0);
};

// `p`'s eight weapon records (the hands', the holsters'): the `i`th.
entity(entity p, float i) AD_CarriedInst =
{
    if(i == 0) return p.weaponinst;
    if(i == 1) return p.weaponinst2;
    if(i == 2) return p.holsterweaponinst0;
    if(i == 3) return p.holsterweaponinst1;
    if(i == 4) return p.holsterweaponinst2;
    if(i == 5) return p.holsterweaponinst3;
    if(i == 6) return p.holsterweaponinst4;
    return p.holsterweaponinst5;
};

// SetChangeParms: the carried weapons' upgrades, 3 bits each, the hands' then the holsters' (24 bits: exact in a float).
float(entity p) AD_PackWeaponUpgrades =
{
    float packed = 0, k = 1;
    for(float i = 0; i < 8; i++)
    {
        packed = packed + AD_UpgradeCode(AD_CarriedInst(p, i)) * k;
        k = k * 8;
    }
    return packed;
};

// DecodeLevelParms, the records carried: their upgrades back (a weapon of a kind that can't have one: none).
void(entity p, float xPacked) AD_UnpackWeaponUpgrades =
{
    float wids[8];
    wids[0] = p.weapon; wids[1] = p.weapon2; wids[2] = p.holsterweapon0; wids[3] = p.holsterweapon1;
    wids[4] = p.holsterweapon2; wids[5] = p.holsterweapon3; wids[6] = p.holsterweapon4; wids[7] = p.holsterweapon5;
    for(float i = 0; i < 8; i++)
    {
        float code = xPacked - floor(xPacked / 8) * 8;
        xPacked = floor(xPacked / 8);
        entity inst = AD_CarriedInst(p, i);
        AD_UpgradeDecode(inst, code);
        if(inst != world)
        {
            inst.wi_adup = inst.wi_adup & AD_UpgradeFor(wids[i]);
        }
    }
};

// A player's own upgrades (AD's .moditems, as before 2026-10-12: a save or a level change made then) onto every weapon of
// their kinds he carries, then his no more. PutClientInServer and OnLoadGame.
void(entity p) AD_UpgradesToWeapons =
{
    float mine = p.ad_moditems & (ad_IT_UPGRADE_AXE | ad_IT_UPGRADE_SSG | ad_IT_UPGRADE_LG);
    if(!mine)
    {
        return;
    }
    float wids[8];
    wids[0] = p.weapon; wids[1] = p.weapon2; wids[2] = p.holsterweapon0; wids[3] = p.holsterweapon1;
    wids[4] = p.holsterweapon2; wids[5] = p.holsterweapon3; wids[6] = p.holsterweapon4; wids[7] = p.holsterweapon5;
    for(float i = 0; i < 8; i++)
    {
        entity inst = AD_CarriedInst(p, i);
        if(inst != world)
        {
            inst.wi_adup = inst.wi_adup | (mine & AD_UpgradeFor(wids[i]));
        }
    }
    p.ad_moditems = p.ad_moditems - mine;
    dprint(sprintf("VR: AD's upgrades %g (the player's, an older game's) put on his weapons of their kinds\n", mine));
};

// The same for the weapon in self's hand `xHand`.
float(float xHand, float xBit) AD_HandUpgraded =
{
    return AD_WeaponUpgraded(self, VRGetEntWeaponInst(self, xHand), xBit);
};

// W_FireAxe's blow of the axe in `xHand`: the Shadow Axe's (AD's 35 for the axe's 20).
float(float xHand) AD_AxeScale =
{
    return (AD_HandUpgraded(xHand, ad_IT_UPGRADE_AXE) || AD_Evil()) ? ad_DAMAGE_PLAYAXE2 / ad_DAMAGE_PLAYAXE1 : 1; // (Evil: AD's Shadow Axe in any map)
};

// W_FireSuperShotgun's pellets from `xHand`: the Widowmaker's 21 when a third shell is in the reserve (taken), else
// `pellets`.
float(float xHand, float pellets) AD_WidowmakerPellets =
{
    if(!AD_HandUpgraded(xHand, ad_IT_UPGRADE_SSG) || self.ammo_shells < 1)
    {
        return pellets;
    }
    self.ammo_shells = self.ammo_shells - 1;
    return pellets * ad_QUANTITY_WM / ad_QUANTITY_SSG;
};

// Whether the super shotgun of record `xInst` (world: not known, a plain one) is the Widowmaker: reloaded at the hip (the
// simple reload), never broken open (vr_reload.qc VR_Reload_ManualForInst).
float(entity xInst) AD_Widowmaker =
{
    return AD_WeaponUpgraded(self, xInst, ad_IT_UPGRADE_SSG);
};

// Whether the lightning gun in `xHand` with flags `xFlags` is AD's Plasma Gun (not Rogue's plasma, its secondary ammo).
float(float xHand, float xFlags) AD_PlasmaGun =
{
    return AD_HandUpgraded(xHand, ad_IT_UPGRADE_LG) && !(xFlags & QVR_WPNFLAG_USE_SECONDARY_AMMO);
};

// The Plasma Gun's shot (W_Attack, every 0.2 s): a plasma bolt from the muzzle, a cell; under water it misfires.
void(float xHand) AD_FirePlasma =
{
    if(getCurrentAmmoOrClip(xHand) < 1)
    {
        return;
    }
    if(self.waterlevel > 1)
    {
        sound(self, VRGetGunChannel(xHand), ad_SOUND_MISFIRE, 1, ATTN_NORM);
        return;
    }
    sound(self, VRGetGunChannel(xHand), ad_SOUND_PLASMA_FIRE, 1, ATTN_NORM);
    self.punchangle_x = -2;
    delAmmoOrClipAndUpdateCounter(xHand, AID_CELLS, 1);
    ad_launch_plasma(VRGetMuzzlePos(xHand), VRGetWeaponFireRotFwd(xHand), ad_CT_PLAYER, ad_SPEED_PLAYPLASMA);
    weaponfired(self, xHand);
    VRGunHaptic(xHand, 0.3, 60, 0.7);
};

// AD's own weapon pickup (an AD entity that is one: its upgrades and weapons spawn as Quake VR's) touched by a player:
// never taken (AD's would set the player's .weapon, our hands' weapon id). TRUE: AD's touch returns.
float() VR_AD_WeaponTouch =
{
    if(other.flags & FL_CLIENT)
    {
        dprint(sprintf("VR: AD's own %s pickup is not taken by a Quake VR player\n", self.classname));
        return TRUE;
    }
    return FALSE;
};

// AD's weapon upgrade pickups as Quake VR's weapon pickups (the base weapon, AD's pickup model), where the upgrades play
// (AD_UpgradeScope: by default AD maps, and any map while Additional Content is Everywhere).
void(string xModel, string xClassname, float xWeaponId, float xUpgrade, string xName) AD_UpgradeItem =
{
    if(!VR_AD_FeatureScope(AD_UpgradeScope()))
    {
        remove(self);
        return;
    }
    if(!AD_Rules())
    {
        AD_WeaponsOnDemand(); // (outside AD's world setup: the Plasma Gun's sounds)
    }
    self.classname = xClassname; // (weapon_touch reads the weapon from it)
    impl_weapon_item(xModel, xWeaponId);
    self.vr_ad_upgrade = xUpgrade;
    self.netname = xName;
};


/*QUAKED weapon_upgrade_axe (0 .5 .8) (-16 -16 0) (16 16 56)
Arcane Dimensions' Shadow Axe, in its maps (vr_ad_bridge.qc): the axe, and every axe you hold hits as AD's (35 for 20).
*/
void() weapon_upgrade_axe =
{
    AD_UpgradeItem(ad_MODEL_GWEAP_UPAXE, "weapon_axe", WID_AXE, ad_IT_UPGRADE_AXE, "Shadow Axe");
    self.skin = 4; // (AD's Shadow Axe skin)
};

/*QUAKED weapon_hammer (0 .5 .8) (-16 -16 0) (16 16 56)
Arcane Dimensions' name for its Shadow Axe (weapon_upgrade_axe), in its maps.
*/
void() weapon_hammer =
{
    weapon_upgrade_axe();
};

/*QUAKED weapon_upgrade_ssg (0 .5 .8) (-16 -16 0) (16 16 56)
Arcane Dimensions' Widowmaker, in its maps (vr_ad_bridge.qc): the super shotgun, and every one you hold fires AD's
21 pellets for 3 shells; reloaded at the hip.
*/
void() weapon_upgrade_ssg =
{
    AD_UpgradeItem(ad_MODEL_GWEAP_UPSSG, "weapon_supershotgun", WID_SUPER_SHOTGUN, ad_IT_UPGRADE_SSG, "Widowmaker");
};

/*QUAKED weapon_upgrade_lg (0 .5 .8) (-16 -16 0) (16 16 56)
Arcane Dimensions' Plasma Gun, in its maps (vr_ad_bridge.qc): the lightning gun, and every one you hold fires AD's
plasma bolts.
*/
void() weapon_upgrade_lg =
{
    AD_UpgradeItem(ad_MODEL_GWEAP_UPLG, "weapon_lightning", WID_LIGHTNING, ad_IT_UPGRADE_LG, "Plasma Gun");
};

/*QUAKED weapon_plasmagun (0 .5 .8) (-16 -16 0) (16 16 56)
Arcane Dimensions' name for its Plasma Gun (weapon_upgrade_lg), in its maps.
*/
void() weapon_plasmagun =
{
    weapon_upgrade_lg();
};

/*QUAKED weapon_upgrade_ghook (0 .5 .8) (-16 -16 0) (16 16 56)
Arcane Dimensions' grappling hook: Quake VR's is the player's own (Movement > Grappling Hook); nothing to pick up.
*/
void() weapon_upgrade_ghook =
{
    remove(self);
};

// ---------------------------------------------------------------------------------------------------------------------
// Test aids (vr_test_monsters, Debug > Tests > Whole-Map Monsters: vr_monsters_test.qc)

// One of AD's monsters waiting for its trigger (AD's delayed spawn): its use brings it in.
float(entity e) AD_TestWaiting =
{
    return AD_Run(e) && !(e.flags & FL_MONSTER) && (e.use == ad_monster_spawn || e.use == ad_monster_spawndelay);
};

// Wakes one of AD's monsters (self) to hunt `p`, by AD's own AI. TRUE: it was one.
float(entity p) AD_TestWake =
{
    if(!AD_Run(self) || !self.ad_th_run)
    {
        return FALSE;
    }
    self.enemy = p;
    ad_FoundTarget();
    return TRUE;
};

void(entity pellet) VR_AD_PelletPrepare =
{
    pellet.vr_ad_impactdir = normalize(pellet.velocity);
};

void(entity pellet) VR_AD_PelletLaunch =
{
    pellet.vr_ad_launchfrom = pellet.origin;
};

// A blast's head/limb pop odds as hitscan's (one roll at the whole blast's share, ApplyMultiDamage): AD's pellets land
// one by one, each re-arming with the share so far, and a kill or a corpse hit rolls each time. So every roll after
// the blast's first on a victim only tops it up: the chance it pops by now is the chance at the share so far, whatever
// the earlier rolls (q = (P - Pbefore) / (1 - Pbefore)); the whole blast's odds are one roll's at its final share.
// A pellet of the blast that has just killed the victim (its body not a corpse yet, VR_DECAP_DIED_LATE) rolls its top-up
// as a late cut (a thrown axe's); a body the blast popped is not gibbed by its later pellets (hitscan's popped blast
// never gibs).
.float vr_ad_popserial; // the blast (vr_ad_shotserial) whose pellets last rolled on it
.float vr_ad_popchance; // and the chance it had popped by then (the global scale in)
.float vr_ad_popped;    // and whether it popped its head or a limb

// What of `e` is cut off: its head (4096) and its limbs (bits).
float(entity e) VR_AD_Cuts =
{
    float limbs = ragdolllimbs(e, 2);
    return (e.vr_headless ? 4096 : 0) + (limbs > 0 ? (limbs & 2047) : 0);
};

// The armed pellet's chance (vr_decap_chance, its share so far) made that top-up; its own chance (the scale in) returned.
float(entity victim, float serial) VR_AD_PopTopUp =
{
    float scale = max(0, cvar_hget(vr_decap_limb >= 0 ? cvarh_vr_limbs_chance_scale : cvarh_vr_decap_chance_scale));
    float now = min(1, vr_decap_chance * scale);
    float before = victim.vr_ad_popserial == serial ? victim.vr_ad_popchance : 0;
    float q = before >= 1 ? 0 : max(0, (now - before) / (1 - before));
    vr_decap_chance = scale > 0 ? q / scale : 0;
    if(cvar_hget(cvarh_vr_debug_shots))
    {
        bprint(sprintf("adshots: pop blast %g chance %.3f before %.3f roll %.3f\n", serial, now, before, q));
    }
    return now;
};

// (A corpse's damage from a projectile pellet or a rifle laser at its head or a limb: worn into that piece, as every
// weapon's is: VR_Limb_CorpseWear, vr_limbs.qc. They tag the hit with VR_SetHitKind below.)

// AD projectile impacts keep the launching shot's identity across flight frames and weapon switches.
void(entity victim, entity pellet, float damage) VR_AD_PelletHit =
{
    entity os = self;
    vector dir = pellet.vr_ad_impactdir;
    // A close shot must never retrace behind its launch point into another limb of the corpse.
    float back = min(32, vlen(pellet.origin - pellet.vr_ad_launchfrom));
    VR_TouchTrace(pellet.origin - dir * back, pellet.origin + dir * 32);
    vector at = trace_ent == victim ? trace_endpos : pellet.origin;
    float part = PositionalDamage(victim, at, dir);
    damage = damage * PositionalDamageFactor(part);
    VR_SetHitKind(QVR_HITKIND_SHOT, pellet.vr_ad_shothand, at, dir);
    float serial = vr_sgib_blastserial;
    float weapon = vr_decap_weapon;
    float pellets = vr_decap_pellets;
    vector src = vr_decap_src;
    if(pellet.vr_ad_shotserial)
    {
        vr_sgib_blast = TRUE;
        vr_sgib_blastserial = pellet.vr_ad_shotserial;
        vr_decap_weapon = pellet.vr_ad_shotweapon;
        vr_decap_pellets = pellet.vr_ad_shotpellets;
        vr_decap_src = pellet.vr_ad_shotfrom;
        VR_Decap_Pellet(victim, damage, at, dir);
    }
    self = pellet.owner;
    float blast = pellet.vr_ad_shotserial;
    float pop = (blast && VR_Decap_BlastArm(victim));
    float popnow = pop ? VR_AD_PopTopUp(victim, blast) : 0;
    float cuts = pop ? VR_AD_Cuts(victim) : 0;
    float justdied = ((victim.health <= 0) && (victim.vr_corpse != 2) && !victim.vr_corpse_dying &&
                     (time - victim.vr_decap_died < VR_DECAP_DIED_LATE));
    // Per-pellet small gibs remain immediate; only head/limb share accumulates across flight frames.
    vr_sgib_blast = FALSE;
    self = os;
    float ours = vr_ad_ourdamage;
    vr_ad_ourdamage = TRUE; // AD's touch already applied shell resistance; shared settings/hooks run once.
    T_Damage(victim, pellet, pellet.owner, damage);
    vr_ad_ourdamage = ours;
    // (Killed or the corpse's damage took the armed pop: it rolled. A zombie's knock-down roll in VR_Decap_After is
    // not counted.)
    float rolled = (pop && (vr_decap_ent != victim));
    if(pop && !rolled && justdied && (victim.vr_ad_popserial == blast))
    {
        rolled = TRUE;
        vr_decap_ent = world;
        if(VR_Decap_Roll(victim))
        {
            if(vr_decap_limb >= 0) VR_Limb_Cut(victim, vr_decap_by, vr_decap_vel, vr_decap_how, vr_decap_limb, TRUE);
            else VR_Decap_Cut(victim, vr_decap_by, vr_decap_vel, vr_decap_how);
        }
    }
    if(rolled)
    {
        float same = victim.vr_ad_popserial == blast;
        victim.vr_ad_popchance = max(popnow, same ? victim.vr_ad_popchance : 0);
        victim.vr_ad_popped = ((same && victim.vr_ad_popped) || (VR_AD_Cuts(victim) != cuts));
        victim.vr_ad_popserial = blast;
    }
    if(pop) VR_Decap_After(victim);
    if(blast && (victim.vr_ad_popserial == blast) && victim.vr_ad_popped && (victim.health < -1))
    {
        victim.health = -1;
    }
    if(cvar_hget(cvarh_vr_debug_shots)) bprint(sprintf("adshots: pellet %s part %g damage %g pop %g at %v\n", victim.classname, part, damage, pop, at));
    vr_sgib_blastserial = serial;
    vr_decap_weapon = weapon;
    vr_decap_pellets = pellets;
    vr_decap_src = src;
    VR_ClearHitKind();
};

// Preserve AD's explosion/radius/resistance rules while using Quake VR's catching, batting and shot interception.
void() VR_AD_RocketBoom =
{
    VR_GrenShot_Spent(self);
    entity oo = other;
    other = world;
    ad_Touch_Missile();
    other = oo;
};
void(entity missile) VR_AD_Ordnance =
{
    if(missile.ad_classtype == ad_CT_PROJ_GLMON || missile.ad_classtype == ad_CT_PROJ_GL)
    {
        // (setmodel gives an alias model its bounds as its size: AD's own box back, as vanilla's setsize after its
        // setmodel, so a grenade left uncatchable does not bounce off walls and ride over floors on a player-sized hull)
        vector boxlo = missile.mins, boxhi = missile.maxs;
        setmodel(missile, "progs/grenade.mdl");
        setsize(missile, boxlo, boxhi);
        VR_Grenade_Make(missile, ad_Explode_Grenade, max(0, missile.nextthink - time),
            (missile.owner.flags & FL_CLIENT) != 0);
    }
    else if(missile.ad_classtype == ad_CT_PROJ_ARMY || missile.ad_classtype == ad_CT_PROJ_ROCKET)
    {
        missile.vr_ammo_boom = VR_AD_RocketBoom;
        VR_GrenShot_Make(missile);
    }
};

// AD native monsters and Quake VR's bridge both pass through this launch hook, exactly once.
float(entity shooter, float speed) VR_AD_PelletSpeed =
{
    return speed * ((shooter.flags & FL_MONSTER) ? max(0.1, cvar("vr_ad_enemy_pellet_speed")) : 1);
};

// AD ammo appearance only: preserve Quake VR's ammo counts, hands and force-grabbable physics.
string(float ammo, float big, string fallback) AD_AmmoModel =
{
    if(!VR_AD_FeatureScope(cvar("vr_ad_ammo_models"))) return fallback;
    string chosen = fallback;
    if(ammo == AID_SHELLS) chosen = big ? "progs/ammo_shells1.mdl" : "progs/ammo_shells0.mdl";
    else if(ammo == AID_NAILS) chosen = big ? "progs/ammo_nails1.mdl" : "progs/ammo_nails0.mdl";
    else if(ammo == AID_ROCKETS) chosen = big ? "progs/ammo_rockets1.mdl" : "progs/ammo_rockets0.mdl";
    else if(ammo == AID_CELLS) chosen = big ? "progs/ammo_cells1.mdl" : "progs/ammo_cells0.mdl";
    return fileexists(chosen) ? chosen : fallback;
};

// An ammo box (self) given AD's model (AD_AmmoModel; `xSize` the vanilla box's size, its box already set): AD's MDL boxes
// are centred where Quake's BSP boxes have a corner origin, so the model's own bounds, and in an ordinary map the old
// box's placement kept; the map's box frame by AD's rules (-1 random 1-7, past 7 the first, 0 none).
void(vector xSize) AD_AmmoBoxFit =
{
    if(self.model == "" || substring(self.model, 0, 11) != "progs/ammo_")
    {
        return;
    }
    vector lo = modelbounds(self, FALSE); // (vector builtin results kept apart)
    vector hi = modelbounds(self, TRUE);
    setsize(self, lo, hi);
    if(!AD_Rules())
    {
        setorigin(self, self.origin + xSize * 0.5);
    }
    if(self.ad_frame_box == -1) self.frame = rint(1 + random() * 6);
    else if(self.ad_frame_box > 7) self.frame = 1;
    else self.frame = max(0, self.ad_frame_box);
};
