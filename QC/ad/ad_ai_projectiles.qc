// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/ai_projectiles.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 PROJECTILE Systems
 ------------------

 * Bullets (PROJECTILE)
 * Plasma
 * Nails
 * Rockets
 * Grenades
 
 PLAYER Projectile Collision (movetypes)
 ---------------------------------------
 
 * ID software Quake originally had most player projectiles (rockets/nails)
   use a large collision size (MOVETYPE_FLYMISSILE) and this especially
   helped with flying enemies (scrags) that strafe around quickly.
   
 * AD changed all the player projectile collision boxes to a smaller
   size (MOVETYPE_FLY) to add a greater challenge to combat and this
   is noticeable when fighting flying monsters.
   This change was linked to the setting of the sv_aim console command,
   which has been changed from 0.93 to 1 in most modern quake clients.
   The sv_aim command was used to help steer projectiles into monsters
   to ultimately make the combat easier for keyboard only players.

 * Projectiles move in discreet steps on the server and with a small
   movetype they can often skip through objects. This was probably the
   reason ID software had large collision and changing them to small
   only makes combat more difficult and less fun.
   
 * The projectile size is now linked to a worldspawn variables which
   defaults to 0 and will keep the original ID software default while
   giving map makers the choice to override this option.
   
   There is also an impulse command (105) to toggle this setting and
   its reported on the mod info table on the console (developer 1)
   
   The new worldspawn variable is - no_bigprojectiles
   
   This change will affect the following ammo type/weapons:
   shells(SG/SSG/WSG), nails(NG/SNG), rockets(RL) and cells(PG).
   
 * There is a big projectile collision for grenades but ID software
   never used it. All grenades are setup with MOVETYPE_BOUNCE
   which is always a small collision.

======================================================================*/
/*======================================================================
 BULLET PROJECTILES 
 * Projectile and hitscan system supported
 * Uses original damage accumulation system
======================================================================*/
void() ad_Particle_Bullet =
{
	// Is the touch function blocked?
	if (self.waitmin > time) return;
	if (self.delay < time) ad_entity_remove(self, 1);
	else {
		if (random() < 0.5) {
			self.oldorigin = ad_crandom() * '1 1 1';
			if (random() < 0.8) self.lip = rint(random()*4);
			else self.lip = 112 + rint(random()*4);
			particle (self.origin, self.oldorigin, self.lip, 1 + rint(random()*2));
		}
		self.think = ad_Particle_Bullet;
		self.nextthink = time + self.speed;
	}
};

//----------------------------------------------------------------------
void() ad_Touch_Bullet =
{
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other == self.owner) return;			// Touching self, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	if (self.waitmin > time) return;			// bullet touch has been disabled
	ad_entity_remove(self, 1);						// Setup bullet for removal	
	
	//----------------------------------------------------------------------
	// Hit monster/interactive object, impact blood
	//----------------------------------------------------------------------
	if (other.takedamage) {
		// Due to how difficult projectile shotguns were to hit thing
		// An extra +4 damage (dead center tracer) was added to help
		// In AD 1.7+ the bullet projectiles are now using wide impact
		// against monsters which means more pellets will hit.
		// The extra tracer pellet damage is not required anymore.

		// Check pellet type for damage
		if (self.ad_classtype == ad_CT_PROJ_TRACEPART) self.dmg = 0;
		else if (self.ad_classtype == ad_CT_PROJ_TRACE) self.dmg = 0;
			// Old code kept for reference
			// No extra trace damage for zombies, it will kill them
			//if (other.classgroup == CG_ZOMBIE) self.dmg = 0;
			//else self.dmg = DAMAGE_PTSHELL;	
		// Default shell pellet damage
		else self.dmg = ad_DAMAGE_PSHELL * VR_AD_PelletDamage(self);	
		
		// Check for breakable/pushable no monster damage
		if (ad_ai_immunebreakable(self.owner, other)) {
			self.dmg = 0;
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
			WriteCoord (ad_MSG_BROADCAST, self.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		}
		// Show bullet resistance as small blood+gunshot+smoke
		else if (other.ad_resist_shells != 0) {
			self.dmg = ad_Resist_Damage(other, ad_IT_SHELLS, self.dmg);
			ad_Resist_Shells(other, self.origin, self.velocity, self.dmg);
		}
		else {
			// Hitting monsters does twice the amount of blood effects
			if (other.flags & ad_FL_MONSTER) ad_spawn_touchblood (self, other, self.dmg*2);
			else ad_spawn_touchblood (self, other, self.dmg);
		}
		
		// Finally do the damage, if any available (after resistance)
		if (self.dmg > 0) ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);
	}
	//----------------------------------------------------------------------
	// Hit world/static object, impact particles
	//----------------------------------------------------------------------
	else {
		// Tracer bullet, dead center and inflight particle emitter
		// Originally did no damage, but changed to buff particle SG
		if (self.ad_classtype == ad_CT_PROJ_TRACE) {
			self.lip = random();
			// NG tink sound or SG ricochet sound (hardcoded client sounds)
			if (self.lip < 0.5) sound(self, ad_CHAN_VOICE, "weapons/tink1.wav", random()*0.5, ad_ATTN_LOW);
			else if (self.lip < 0.7) sound(self, ad_CHAN_VOICE, "weapons/ric2.wav", random()*0.5, ad_ATTN_LOW);
			else sound(self, ad_CHAN_VOICE, "weapons/ric3.wav", random()*0.5, ad_ATTN_LOW);
		}
		else {
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
			WriteCoord (ad_MSG_BROADCAST, self.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		}
	}
};

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir, float ad_proj_type, float ad_proj_speed) ad_Launch_Bullet =
{
	ad_newmis = spawn();
	ad_newmis.owner = self;
	ad_newmis.classname = "proj_bullet";	// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_proj_type;		// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJSHELLS;	// Ammo type
	//----------------------------------------------------------------------
	// Horrible hack! If the player has the TSG or quad, flag it for zombies
	//----------------------------------------------------------------------
	if (self.ad_moditems & ad_IT_UPGRADE_SSG || self.super_damage_finished > 0)
		ad_newmis.weapon = ad_TRUE;
	
	//----------------------------------------------------------------------
	// Setup player/monster projectile collision
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_PLAYER) {
		if (ad_playerprojsize == 0) 
			ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;	// Large collision
		else ad_newmis.movetype = ad_MOVETYPE_FLY;		// Small collision
	}
	else ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;	// Default = large collision
	
	//----------------------------------------------------------------------
	ad_newmis.solid = ad_SOLID_BBOX;
	ad_newmis.touch = ad_Touch_Bullet;					// touch function
	ad_newmis.waitmin = 0;								// Touch function active

	// Particle tracer (true aim, no damage)
	if (ad_proj_type == ad_CT_PROJ_TRACE || ad_proj_type == ad_CT_PROJ_TRACEPART) {
		ad_newmis.delay = time + ad_LIFE_SHELLS;			// Maximum life time
		if (self.weapon & ad_IT_SUPER_SHOTGUN) ad_newmis.count = 1;
		else ad_newmis.count = 1 + rint(random()*2);	// Default particles for SG
		ad_newmis.speed = 0.02;						// Next function interval (very high tick)
		ad_newmis.think = ad_Particle_Bullet;				// Particle trail
		ad_newmis.nextthink = time + ad_newmis.speed;
	}
	// SG/SSG shells (scatter effect)
	else {
		ad_newmis.think = ad_SUB_Remove;
		ad_newmis.nextthink = time + ad_LIFE_SHELLS;	// Stop projectile going forever
	}

	ad_newmis.mdl = ad_MODEL_PROJ_DIAM2;
	setmodel(ad_newmis, ad_newmis.mdl);				// Diamond model
	ad_newmis.frame = random()*15;					// Full range of sizes
	ad_newmis.skin = 16 + random()*7;				// Bright colours

	ad_newmis.velocity = ad_dir * ad_proj_speed;			// Constant speed multiplier
	ad_newmis.angles = vectoangles(ad_dir);			// Create direction angle
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);	// Zero size
	setorigin (ad_newmis, ad_org);					// Move to starting position
	ad_newmis.avelocity = ad_vecrand(100,200,ad_FALSE);
	
};

//----------------------------------------------------------------------
void(float ad_bullet_count, vector ad_bullet_spread, float ad_bullet_type) ad_Launch_Shells =
{
	local	vector ad_src_origin, ad_bullet_dir, ad_spread_dir;
	local float ad_bullet_speed, ad_var_speed;
	
	// Is the player firing the shotgun?
	if (self.flags & ad_FL_CLIENT) {
		makevectors(self.v_angle);
		// Infront of player model and down towards gun
		ad_src_origin = self.origin + ad_attack_vector('10 0 8');
		if (ad_bullet_type == ad_CT_PROJ_SG) ad_bullet_speed = ad_SPEED_PLAYERSG;
		else ad_bullet_speed = ad_SPEED_PLAYERSSG;
		// Either straight line or auto aim assist (builtin function 44)
		if (ad_autoaim_cvar < 1) ad_bullet_dir = aim(self, ad_SPEED_PLAYAIM);
		else ad_bullet_dir = normalize(v_forward * ad_bullet_speed);
	}
	else {
		makevectors(self.angles);
		// At the end of the new soldier gun model
		ad_src_origin = self.origin + ad_attack_vector(self.ad_attack_offset);
		ad_bullet_speed = ad_SPEED_MONSG + (ad_skill*ad_SPEED_MONSGMULT);
		// fire somewhat behind the player, so a dodging player is harder to hit
		ad_bullet_dir = self.enemy.origin - self.enemy.velocity*0.2;
		ad_bullet_dir = normalize (ad_bullet_dir - self.origin);
	}

	// Setup particle emitter/tracer shot (true aim)
	ad_Launch_Bullet(ad_src_origin, ad_bullet_dir, ad_CT_PROJ_TRACE, ad_bullet_speed);
	// Reduced the amount of visual noise infront of the player
	// The projectiles below are particle trail emitters only
	//	Launch_Bullet(src_origin+(v_right*(crandom()*10)), bullet_dir, CT_PROJ_TRACEPART, bullet_speed + (crandom()*30) );
	//	Launch_Bullet(src_origin+(v_right*(crandom()*10)), bullet_dir, CT_PROJ_TRACEPART, bullet_speed + (crandom()*30) );

	while (ad_bullet_count > 0) {
		ad_var_speed = ad_crandom()*10 + ad_bullet_speed;		// Slight speed variance
		ad_spread_dir = ad_bullet_dir + (ad_crandom()*ad_bullet_spread_x) * v_right + (ad_crandom()*ad_bullet_spread_y) * v_up;
		ad_Launch_Bullet(ad_src_origin, ad_spread_dir, ad_bullet_type, ad_var_speed);

		ad_bullet_count = ad_bullet_count - 1;
	}
};

/*======================================================================
 PLASMA PROJECTILES 
 * requires custom particle trail
 * Has radius and impact touch damage
======================================================================*/
// Compiler forward reference
void(vector ad_org, vector ad_dir, float ad_proj_type, float ad_proj_speed) ad_launch_plasma;

//----------------------------------------------------------------------
void() ad_Particle_Plasma =
{
	// projectile has touched something
	if (self.waitmin > time) return;
	
	// Projectile has run out of time
	if (self.ad_attack_finished < time) {ad_entity_remove(self, 0.1); return;}

	// Generate sprite particles? DP not active?
	if (random() < 0.5 && !ad_ext_dppart) {
		self.oldorigin = ad_crandom() * '1 1 1';
		if (self.ad_poisonous) self.lip = 56 + rint(random()*8);
		else self.lip = 40 + rint(random()*8);
		particle (self.origin, self.oldorigin, self.lip, 4 + rint(random()*4));
		if (self.ad_poisonous) self.lip = 182 + rint(random()*8);
		else self.lip = 198 + rint(random()*4);
		particle (self.origin, self.oldorigin, self.lip, 2 + rint(random()*2));
	}

	// The Player plasma projectile grows over frames
	if (self.ad_classproj == ad_CT_PLAYER) {
		if (self.ad_pain_finished < time) {
			self.frame = self.frame + 1;
			if (self.frame < 6) self.ad_pain_finished = time + 0.1;
			else self.frame = 6;
		}
	}

	// Keep looping
	self.think = ad_Particle_Plasma;
	self.nextthink = time + self.speed;	
};

//----------------------------------------------------------------------
void() ad_Touch_PlasmaProjectile =
{
	local vector ad_org, ad_vec, ad_dir;
	local entity ad_tself;
	
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other == self.owner) return;			// Touching self, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	if (self.waitmin > time) return;			// plasma touch has been disabled
	
	// Default damage for plasma (override on worldspawn)
	if (self.ad_classproj == ad_CT_PLAYER) self.pos1 = ad_map_plasmagundmg; 
	// Default damage for all monsters
	else if (self.ad_classproj == ad_CT_REFLECTLIGHT) self.pos1 = ad_DAMAGE_PGREFLECT;
	else if (self.ad_classproj == ad_CT_REFLECTPLASMA) self.pos1 = ad_DAMAGE_PGREFLECT;
	else if (self.ad_classproj == ad_CT_SUMMONLIGHT) self.pos1 = ad_DAMAGE_PGSUMMON;
	else if (self.ad_classproj == ad_CT_MONMINOTAUR) self.pos1 = ad_DAMAGE_PGMINOTAUR;
	else if (self.ad_classproj == ad_CT_MONGAUNT) self.pos1 = ad_DAMAGE_PGGAUNT;
	else if (self.ad_classproj == ad_CT_MONTURRETB) self.pos1 = ad_DAMAGE_PGTURRETB;
	else if (self.ad_classproj == ad_CT_MONFLOYD) self.pos1 = ad_DAMAGE_PGFLOYD;
	else if (self.ad_classproj == ad_CT_MONDEFLECTOR) self.pos1 = ad_DAMAGE_PGDEFLECT;
	else self.pos1 = ad_DAMAGE_PLASMA;

	// Check for breakable/pushable immunity first
	if (ad_ai_immunebreakable(self.owner, other)) self.pos1 = '0 0 0';
	self.dmg = self.pos1_x + random()*self.pos1_y;
	
	// Plasma Splashdamage affects everything, check for 0 dmg first
	// This will also apply a poisonous debuff from the attacker
	if (self.pos1_z > 0) 
		ad_T_RadiusDamage (self, self.owner, self.pos1_z, world, ad_DAMAGEALL);

	//----------------------------------------------------------------------
	// Hit monster/interactive object, impact blood
	//----------------------------------------------------------------------
	if (other.takedamage) {
		// Check for breakable/pushable no monster damage
		if (ad_ai_immunebreakable(self.owner, other)) {
			// Using a cut down version of ammo resistance
			ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, self.origin, ad_SOUND_PLASMA_HIT);
			ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
			if (random() < 0.5) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
			if (random() < 0.5) ad_SpawnProjectileSmoke(self.origin, 300, 50, 150);
		}
		// Check for plasma/cell resistance
		else if (other.ad_resist_cells != 0) {
			self.dmg = ad_Resist_Damage(other, ad_IT_CELLS, self.dmg);
			ad_Resist_Plasma(other, self.origin);
		}
		else {
			// Hitting monsters does twice the amount of blood effects
			if (other.flags & ad_FL_MONSTER) ad_spawn_touchblood (self, other, self.dmg*2);
			else ad_spawn_touchblood (self, other, self.dmg);

			// Switch poisonous to poison sprite, but keep plasma explosion
			// Otherwise this sounds confusing with a rocket explosion
			if (self.ad_poisonous) self.lip = ad_EXPLODE_POISON_SMALL;
			else {
				// Randomly pick between quoth electric and blue explosions
				if (random() < 0.3) self.lip = ad_EXPLODE_PLASMA_SMALL;
				else self.lip = ad_EXPLODE_ELECT_SMALL;
			}
			ad_SpawnExplosion(self.lip, self.origin, ad_SOUND_PLASMA_HIT);
		}
		
		// Plasma hits always kill any zombie (1 hit)
		if (other.ad_classgroup == ad_CG_ZOMBIE) self.dmg = ad_DAMAGE_ZOMBIECLASS;
		// Don't bother with damage if there is none!
		if (self.dmg > 0) ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);

	}
	//----------------------------------------------------------------------
	// Hit world/static object, impact particles
	//----------------------------------------------------------------------
	else {
		// New special coloured particle explosion (rogue expansion)
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		if (self.ad_poisonous) WriteByte (ad_MSG_BROADCAST, 51);
		else WriteByte (ad_MSG_BROADCAST, 35);
		WriteByte (ad_MSG_BROADCAST, 8);

		// Poisonous sprite explosion instead
		if (self.ad_poisonous) self.lip = ad_EXPLODE_POISON_SMALL;
		// Classic quoth electric impact explosion
		else self.lip = ad_EXPLODE_ELECT_SMALL;
		ad_SpawnExplosion(self.lip, self.origin, ad_SOUND_PLASMA_HIT);
	}
	// Check for any plasma reflection? (player only function)
	if (self.ad_classproj == ad_CT_PLAYER && other.ad_reflectplasma) {
		ad_org = self.origin;
		// Random chance that plasma will reflect straight back
		if (random() < 0.2 && self.owner) 
			ad_dir = normalize(self.owner.origin - ad_org);
		else {
			// Pick random location instead
			ad_vec = ad_org + ad_vecrand(0,1000,1);
			ad_dir = normalize(ad_vec - ad_org);
		}
		// Switch around self to make sure reflection happens once
		ad_tself = self; self = other;
		ad_launch_plasma(ad_org, ad_dir, ad_CT_REFLECTPLASMA, ad_SPEED_REFLECTION);
		self = ad_tself;
	}
	
	// Remove plasma bolt
	ad_entity_remove(self, 1);
};

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir, float ad_proj_type, float ad_proj_speed) ad_launch_plasma =
{
	ad_newmis = spawn ();
	ad_newmis.owner = self;
	ad_newmis.classname = "proj_plasma";	// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_CT_PROJ_PLASMA;	// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJCELLS;	// Ammo type
	ad_newmis.ad_classproj = ad_proj_type;		// Monster type number
	ad_newmis.ad_attack_speed = ad_proj_speed;	// Save for later

	// The player plasma projectile use to be linked to autoaim condition
	// Switched to larger collision, so that greater chance to hit enemies
	// Monsters always use large collision (otherwise infighting would be less)
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_PLAYER) {
		if (ad_playerprojsize == 0) 
			ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;	// Large collision
		else ad_newmis.movetype = ad_MOVETYPE_FLY;		// Small collision
	}
	else {
		// Monster get the raw deal, small projectile collision
		ad_newmis.movetype = ad_MOVETYPE_FLY;
		// Minotaur, Gaunt, dprince is rapid fire, don't need glow effect (slow down)
		if (ad_proj_type != ad_CT_MONGAUNT && ad_proj_type != ad_CT_MONMINOTAUR && ad_proj_type != ad_CT_MONDPRINCE) 
			ad_newmis.effects = ad_EF_DIMLIGHT;
	}

	//----------------------------------------------------------------------
	ad_newmis.solid = ad_SOLID_BBOX;
	ad_newmis.touch = ad_Touch_PlasmaProjectile;
	ad_newmis.ad_attack_finished = time + ad_LIFE_PROJECTILE;
	ad_newmis.ad_poisonous = ad_newmis.owner.ad_poisonous;
	
	// Setup model and special parameters (zombie, boss)
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_MONARMYPLASMA) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMAGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	}
	else if (ad_proj_type == ad_CT_MONELIMATOR) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMAGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	}
	else if (ad_proj_type == ad_CT_MONCENTURION) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMAGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	}
	else if (ad_proj_type == ad_CT_MONGAUNT) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_GAPLASMAGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_GAPLASMA);
	}
	else if (ad_proj_type == ad_CT_MONDEFLECTOR) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMAGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	}
	else if (ad_proj_type == ad_CT_MONEEL) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMAGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	}
	else if (ad_proj_type == ad_CT_MONSEEKER) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	else if (ad_proj_type == ad_CT_MONMAMMOTH) setmodel (ad_newmis, ad_MODEL_PROJ_PLASMA);
	else if (ad_proj_type == ad_CT_MONTURRETB) setmodel (ad_newmis, ad_MODEL_PROJ_LASERBLUE);
	else if (ad_proj_type == ad_CT_MONFLOYD) setmodel (ad_newmis, ad_MODEL_PROJ_LASERBLUE);
	else if (ad_proj_type == ad_CT_MONMINOTAUR) setmodel (ad_newmis, ad_MODEL_PROJ_MPLASMA);
	else if (ad_proj_type == ad_CT_SUMMONLIGHT) setmodel (ad_newmis, ad_MODEL_PROJ_LIGHTNING2);
	else if (ad_proj_type == ad_CT_REFLECTLIGHT) setmodel (ad_newmis, ad_MODEL_PROJ_LIGHTNING2);
	else if (ad_proj_type == ad_CT_REFLECTPLASMA) {
		setmodel (ad_newmis, ad_MODEL_PROJ_PGPLASMA);
		ad_newmis.avelocity = ad_vecrand(0,300,ad_TRUE);	// randomize avel
		ad_newmis.angles_y = rint(random()*360);	// Random angle
		ad_newmis.frame = 3;						// Medium size
	}
	else {
		setmodel (ad_newmis, ad_MODEL_PROJ_PGPLASMA);
		ad_newmis.ad_pain_finished = time + 0.1;		// Update model frame every 0.1s
		ad_newmis.avelocity = ad_vecrand(0,300,ad_TRUE);	// randomize avel
		ad_newmis.angles_y = rint(random()*360);	// Random angle
		ad_newmis.frame = 0;						// Start really small
	}

	//----------------------------------------------------------------------
	// Is DP engine active for new particle trail?
	if (ad_ext_dppart) {
		if (ad_newmis.ad_poisonous) ad_newmis.ad_traileffectnum = particleeffectnum(ad_DPP_TRPOISON);
		else ad_newmis.ad_traileffectnum = particleeffectnum(ad_DPP_TRPLASMA);
		ad_newmis.effects = 0;
	}

	// Manually generate special particle trail (blue or green)
	ad_newmis.count = 1 + rint(random()*2);	// Default particles
	ad_newmis.speed = 0.02;					// Next function interval (very high tick)
	ad_newmis.think = ad_Particle_Plasma;			// Particle trail
	ad_newmis.nextthink = time + ad_newmis.speed;

	// Standard projectile setup (origin, size and velocity)
	//----------------------------------------------------------------------
	ad_newmis.velocity = ad_dir * ad_newmis.ad_attack_speed;
	if (ad_proj_type != ad_CT_PLAYER) ad_newmis.angles = vectoangles(ad_dir);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		
	setorigin (ad_newmis, ad_org);
};

/*======================================================================
 SMALL PROJECTILES - used all over the place ...
 
 * player (nailgun, super nailgun)
 * Wizards (double spit)
 * Hell Knights (magic spray)
 * spike shooters (regular, super, laser)
 * Enforcers (laser)
 * Crossbow Knights (bolts)
 * Zombies (flesh)
======================================================================*/
// Forward compiler reference because of peircing nails function
void(vector ad_org, vector ad_dir, float ad_proj_type, float ad_proj_speed) ad_launch_projectile;

//----------------------------------------------------------------------
void() ad_Think_Projectile =
{
	// Original projectile lifetime timer
	if (self.ad_attack_lifetime < time) {ad_entity_remove(self, 0.1); return;}
	// Make sure onground flag is never set
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	// Keep updating velocity/angle, to prevent from stopping
	self.velocity = self.finalangle * self.ad_attack_speed;
	self.angles = vectoangles(self.finalangle);
	self.nextthink = time + 0.1;
	self.think = ad_Think_Projectile;
};

//----------------------------------------------------------------------
void() ad_Touch_Projectile =
{
	local vector ad_org, ad_dir, ad_vec;
	local float ad_proj_type, ad_proj_speed;
	local entity ad_tself;
	
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other == self.owner) return;			// no touching self
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing

	// No more touch/world interaction
	self.touch = ad_SUB_Null;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	
	//----------------------------------------------------------------------
	//	Laser impact/stop sound (precached by owner)
	if (self.ad_classtype == ad_CT_PROJ_LASER) {
		if (self.ad_attack_ricochet > 0)
			sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_RIC, 1, ad_ATTN_STATIC);
		else sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_HIT, 1, ad_ATTN_STATIC);
	}
	// Golem rock impact sound (precached by owner)
	else if (self.ad_classtype == ad_CT_PROJ_GROCK) {
		self.lip = random();
		self.volume = 0.5 + random()*0.5;
		if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, ad_SOUND_IMP_ROCK1, self.volume, ad_ATTN_BREAK);
		else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, ad_SOUND_IMP_ROCK2, self.volume, ad_ATTN_BREAK);
		else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, ad_SOUND_IMP_ROCK3, self.volume, ad_ATTN_BREAK);
		else sound (self, ad_CHAN_WEAPON, ad_SOUND_IMP_ROCK4, self.volume, ad_ATTN_BREAK);
	}

	//----------------------------------------------------------------------
	// hit something that bleeds
	if (other.takedamage) {
		// SNG spikes are essentially double damage (cheap way of 2 x nails)
		if (self.ad_classtype == ad_CT_PROJ_SNG) self.dmg = ad_DAMAGE_SNGSPIKE;
		// Reflected nails (can only happen from the player)
		else if (self.ad_classtype == ad_CT_PROJ_REFNG) self.dmg = ad_DAMAGE_NGREFSPIKE;
		// Bob and enforcer lasers are different
		else if (self.owner.ad_classtype == ad_CT_MONJIM) 
				self.dmg = ad_DAMAGE_BOBLASER + (random() * ad_DAMAGE_BOBLASER);
		else if (self.ad_classtype == ad_CT_PROJ_LASER) self.dmg = ad_DAMAGE_LASER;
		else if (self.ad_classtype == ad_CT_PROJ_RICLASER) {
			// Minimum damage = spike after all the bouncing around
			if (self.dmg < ad_DAMAGE_NGSPIKE) self.dmg = ad_DAMAGE_NGSPIKE;
		}
		// Special damage and sound effects for crossbow knights
		else if (self.ad_classtype == ad_CT_PROJ_BOLT1) {
			// hit4 = flesh wound, hit1 = ting sound
			if (random() < 0.3) sound (self, ad_CHAN_WEAPON, "weapons/bolt_hit1.wav", 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_WEAPON, "weapons/bolt_hit4.wav", 1, ad_ATTN_NORM);
			// Reduce the damage if the bolt has hit another dcrossbow knight
			if (other.ad_classtype == self.owner.ad_classtype) self.dmg = ad_DAMAGE_BOLT0;
			else self.dmg = ad_DAMAGE_BOLT1;
		}
		else if (self.ad_classtype == ad_CT_PROJ_BLBOLT || self.ad_classtype == ad_CT_PROJ_BLBOLT2) 
			self.dmg = ad_DAMAGE_BOGLORD;
		// Zombies have special impact sound
		else if (self.ad_classtype == ad_CT_PROJ_FLESH) {
			sound (self, ad_CHAN_WEAPON, "zombie/z_hit.wav", 1, ad_ATTN_NORM);
			self.dmg = ad_DAMAGE_FLESH;
		}
		// Scorpion spikes cannot hurt other spider types
		// This is to prevent the minion scorpion killing other minions
		else if (self.ad_classtype == ad_CT_PROJ_SCORP) {
			if (other.ad_classgroup == self.owner.ad_classgroup) self.dmg = 0;
			else self.dmg = ad_DAMAGE_NGSPIKE;
		}
		// Rock projectiles cannot hurt stone monsters!
		else if (self.ad_classtype == ad_CT_PROJ_GROCK) {
			if (other.ad_classgroup == self.owner.ad_classgroup) self.dmg = 0;
			else self.dmg = ad_DAMAGE_NGSPIKE;
		}
		// Default spike damage (nails)
		else self.dmg = ad_DAMAGE_NGSPIKE;
		
		//----------------------------------------------------------------------
		// Check for breakable/pushable monster immunity
		if (ad_ai_immunebreakable(self.owner, other)) {
			// Zero damage and make sure no resistance checks
			self.dmg = self.ad_classgroup = 0;
			// Remove poisonous effect
			self.ad_poisonous = ad_FALSE;
			// Show ammo resistance effect
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
			WriteCoord (ad_MSG_BROADCAST, self.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.origin_z);
			if (random() < 0.5) ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
		}

		//----------------------------------------------------------------------
		// Check for poison debuff (using poisonous flag)
		if (self.ad_poisonous == ad_TRUE) ad_PoisonDeBuff(other);

		//----------------------------------------------------------------------
		// Check for NG/SNG nail resistance
		if (self.ad_classgroup == ad_CG_PROJNAILS && other.ad_resist_nails != 0) {
			self.dmg = ad_Resist_Damage(other, ad_IT_NAILS, self.dmg);
			ad_Resist_Nails(other, self.origin);
			self.ad_projeffect = 0;
			// Check for any nail reflection?
			if (other.ad_reflectnails && random() < other.ad_resist_nails) {
				ad_org = self.origin;
				// Random chance that nail will reflect straight back
				if (random() < 0.2 && self.owner) 
					ad_dir = normalize(self.owner.origin - ad_org);
				else {
					// Pick random location instead
					// Flatten the Z axis so the reflection looks less random
					ad_vec = ad_vecrand(0,100,1);
					ad_vec_z = random()*25;
					ad_vec = ad_vec + ad_org;
					ad_dir = normalize(ad_vec - ad_org);
				}
				// Switch around self to make sure reflection happens once
				ad_tself = self; self = other;
				ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_REFNG, ad_SPEED_REFLECTION);
				self = ad_tself;
			}
		}
		
		//----------------------------------------------------------------------
		// Produce blood particles at impact and apply damage to target
		// Work with dmgresist instead, don't destroy dmg value
		if (self.dmg > 0) {
			ad_spawn_touchblood (self, other, self.dmg);
			ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);
		}

		//----------------------------------------------------------------------
		// Nail Piercing affect, move nail through monster
		if (self.ad_projeffect & ad_IT_ARTPIERCE) {
			// a small pile of gibs!
			if (random() < 0.2) ad_SpawnMeatSpray (self, other, ad_crandom() * 100);
			// Setup projectile ready for monster tests
			self.movetype = ad_MOVETYPE_FLY;
			self.solid = ad_SOLID_BBOX;
			self.oldorigin = self.origin;
			self.count = 0;

			// Loop forward 8 times to find space on the other side
			while (self.count < 8) {
				// Trace forward from current position
				self.ad_finaldest = self.oldorigin + self.finalangle*512;
				traceline(self.oldorigin, self.ad_finaldest,ad_FALSE,self);
				// Still inside bleeding object?
				if (trace_ent == other)
					self.oldorigin = self.oldorigin + self.finalangle*16;
				// On the other side!
				else self.count = 8;
				self.count = self.count + 1;
			}
			// Is the other side free space to spawn?
			if (pointcontents(self.oldorigin) == ad_CONTENT_EMPTY) {
				ad_tself = self;
				ad_org = self.oldorigin;
				ad_dir = self.finalangle;
				ad_proj_type = self.ad_classtype;
				ad_proj_speed = self.ad_attack_speed;
				self = self.owner;
				// Once a projectile hits an object it is impossible
				// to reset its velocity/angles and carry on
				// It is easier to create a new projectile and delete
				// the currently damaged one instead!
				ad_launch_projectile(ad_org, ad_dir, ad_proj_type, ad_proj_speed);
				self = ad_tself;
			}
		}
	}
	//----------------------------------------------------------------------
	else {
		// Rocochet feature for lasers (Laser Canon from hipnotic mod)
		if (self.ad_attack_ricochet > 0) {
			self.ad_attack_ricochet = self.ad_attack_ricochet - 1;
			// Gradually wear down the damage from ricohets
			self.dmg = self.dmg * 0.9;
			
			// Use angles to create forward vector
			self.pos1 = self.angles;
			self.pos1_x = -self.pos1_x;
			makevectors(self.pos1);
			// Need to intersect the surface to create the plane normal
			// Start and finish points have to be either side of impact
			self.pos2 = self.origin - (v_forward * 16);
			self.ad_pos3 = self.origin + (v_forward * 16);
			
			// Ignore all monsters and trace backward from impact
			traceline (self.pos2, self.ad_pos3, ad_FALSE, self);
			// Move entity to impact point so its not stuck
			setorigin(self, trace_endpos);

			// Show Laser impact on geo surface
			if (self.ad_attack_ricochet == 0 || random() < 0.25) {
				WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
				WriteByte (ad_MSG_BROADCAST, ad_TE_KNIGHTSPIKE);
				WriteCoord (ad_MSG_BROADCAST, self.origin_x);
				WriteCoord (ad_MSG_BROADCAST, self.origin_y);
				WriteCoord (ad_MSG_BROADCAST, self.origin_z);
			}
			
			// Create ricochet angle using trace_plane_normal
			// 'trace_plane_normal' the normal of the surface hit
			self.ad_pos3 = normalize(self.finalangle);
			self.velocity = self.ad_pos3 + ( 2 * trace_plane_normal );
			self.velocity = normalize(self.velocity);
			// Save for think function
			self.finalangle = self.velocity;
			self.velocity = self.finalangle * self.ad_attack_speed;

			// make sure projectile facing correct direction
			self.angles = vectoangles(self.finalangle);
			// Make sure the projectile is still flying
			self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
			// Reset movement functionality
			self.movetype = ad_MOVETYPE_FLYMISSILE;
			self.solid = ad_SOLID_BBOX;
			// Make sure all touch/think is working
			self.touch = ad_Touch_Projectile;
			self.nextthink = time + 0.1;
			self.think = ad_Think_Projectile;
			return;
		}
			
		//----------------------------------------------------------------------
		// Some projectiles need to be left lying around for a while
		else if (self.ad_bodyfadeaway) {
			if (self.ad_classtype == ad_CT_PROJ_FLESH) 
				sound (self, ad_CHAN_WEAPON, "zombie/z_miss.wav", 1, ad_ATTN_NORM);
			else if (self.ad_classtype == ad_CT_PROJ_SPID)
				sound (self, ad_CHAN_WEAPON, "spider/miss.wav", 1, ad_ATTN_NORM);
			else if (self.ad_classtype == ad_CT_PROJ_SWAMP)
				sound (self, ad_CHAN_WEAPON, "swampling/miss.wav", 1, ad_ATTN_NORM);
			else if (self.ad_classtype == ad_CT_PROJ_VORE)
				sound (self, ad_CHAN_WEAPON, "voreling/miss.wav", 1, ad_ATTN_NORM);
			else if (self.ad_classtype == ad_CT_PROJ_ELF)
				sound (self, ad_CHAN_WEAPON, "xmas/elf/miss.wav", 1, ad_ATTN_NORM);
			else if (self.ad_classtype == ad_CT_PROJ_BOLT1) {
				if (random() < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/bolt_hit2.wav", 1, ad_ATTN_NORM);
				else sound (self, ad_CHAN_WEAPON, "weapons/bolt_hit3.wav", 1, ad_ATTN_NORM);
			}
				
			self.velocity = self.avelocity = '0 0 0';
			// Straight away make projectiles vanish
			self.nextthink = time + 2 + random();
			self.ltime = self.nextthink;
			self.think = ad_model_fade;	
			return;
		}
		
		//----------------------------------------------------------------------
		// Standard engine impact particles and sounds
		else {
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			
			if (self.ad_classtype == ad_CT_PROJ_SNG) WriteByte (ad_MSG_BROADCAST, ad_TE_SUPERSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_LASER) WriteByte (ad_MSG_BROADCAST, ad_TE_KNIGHTSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_GROCK) WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
			else if (self.ad_classtype == ad_CT_PROJ_WIZ) WriteByte (ad_MSG_BROADCAST, ad_TE_WIZSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_SPID) WriteByte (ad_MSG_BROADCAST, ad_TE_WIZSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_SWAMP) WriteByte (ad_MSG_BROADCAST, ad_TE_WIZSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_VORE) WriteByte (ad_MSG_BROADCAST, ad_TE_SUPERSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_ELF) WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
			else if (self.ad_classtype == ad_CT_PROJ_FURY2) WriteByte (ad_MSG_BROADCAST, ad_TE_WIZSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_NOUR1) WriteByte (ad_MSG_BROADCAST, ad_TE_WIZSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_BLBOLT) WriteByte (ad_MSG_BROADCAST, ad_TE_WIZSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_BLBOLT2) WriteByte (ad_MSG_BROADCAST, ad_TE_KNIGHTSPIKE);
			else if (self.ad_classtype == ad_CT_PROJ_HKN) WriteByte (ad_MSG_BROADCAST, ad_TE_KNIGHTSPIKE);
			else WriteByte (ad_MSG_BROADCAST, ad_TE_SPIKE);
			
			WriteCoord (ad_MSG_BROADCAST, self.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		}
	}
	
	// Hide projectile and wait for any sounds to finish playing
	ad_entity_remove(self,2);
};

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir, float ad_proj_type, float ad_proj_speed) ad_launch_projectile =
{
	ad_newmis = spawn ();
	ad_newmis.owner = self;
	ad_newmis.classname = "proj_nail";		// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_proj_type;		// Class type number, quick identity

	if (ad_newmis.ad_classtype == ad_CT_PROJ_NG || ad_newmis.ad_classtype == ad_CT_PROJ_SNG) 
		ad_newmis.ad_classgroup = ad_CG_PROJNAILS;	// Ammo type
	else ad_newmis.ad_classgroup = ad_CG_PROJALL;	// Ammo type (default)

	// Switch model collision based on auto aim functionality
	// Monsters always use large collision (otherwise infighting would be less)
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_PLAYER) {
		if (ad_playerprojsize == 0) 
			ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;	// Large collision
		else ad_newmis.movetype = ad_MOVETYPE_FLY;		// Small collision
		// Check if the player has the nail piercer effect active
		if (self.ad_moditems & ad_IT_ARTPIERCE && ad_newmis.ad_classgroup == ad_CG_PROJNAILS) {
			ad_newmis.ad_projeffect = ad_IT_ARTPIERCE;
		}
	}
	// lasers/plasma are small and glowing
	else if (ad_proj_type == ad_CT_PROJ_LASER) {			
		ad_newmis.movetype = ad_MOVETYPE_FLY;
		ad_newmis.effects = ad_EF_DIMLIGHT;
	}
	// Crossbow bolts are small and stick around
	else if (ad_proj_type == ad_CT_PROJ_BOLT1) {
		ad_newmis.movetype = ad_MOVETYPE_FLY;
		ad_newmis.ad_bodyfadeaway = ad_TRUE;
	}
	// Default = large collision
	else ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;

	//----------------------------------------------------------------------
	ad_newmis.solid = ad_SOLID_BBOX;
	ad_newmis.touch = ad_Touch_Projectile;
	ad_newmis.nextthink = time + ad_LIFE_PROJECTILE;
	ad_newmis.think = ad_SUB_Remove;
	ad_newmis.ad_poisonous = ad_newmis.owner.ad_poisonous;

	// Setup model
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_PROJ_NG) setmodel (ad_newmis, ad_MODEL_PROJ_NG);
	else if (ad_proj_type == ad_CT_PROJ_SNG) setmodel (ad_newmis, ad_MODEL_PROJ_SNG);
	else if (ad_proj_type == ad_CT_PROJ_REFNG) setmodel (ad_newmis, ad_MODEL_PROJ_NGRED);
	// Santa Snowball machine gun!
	else if (ad_proj_type == ad_CT_PROJ_SANTA) setmodel (ad_newmis, ad_MODEL_PROJ_SNOWBALL);
	// Crossbow Knight has poison/regular bolts
	else if (ad_proj_type == ad_CT_PROJ_BOLT1) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_BOLT2);
		else setmodel (ad_newmis, ad_MODEL_PROJ_BOLT1);
	}
	// Hell Knight + Death Knight magic attack (can be poisonous)
	else if (ad_proj_type == ad_CT_PROJ_HKN) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_HKNGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_HKN);
	}
	// Death Lord - like Death Knight magic attack (spike ball instead)
	else if (ad_proj_type == ad_CT_PROJ_DLORD) {
		setmodel (ad_newmis, ad_MODEL_PROJ_DLORD1);
		// If can see enemy, steer the spike ball
		if (ad_visible(self.enemy)) {
			ad_newmis.enemy = self.enemy;
			ad_newmis.nextthink = time + 0.1;
			ad_newmis.think = self.ad_th_updmissile;
		}
	}
	// Enforcer (can be poisonous)
	else if (ad_proj_type == ad_CT_PROJ_LASER || ad_proj_type == ad_CT_PROJ_RICLASER) {
		// Ricochet special setup
		if (ad_proj_type == ad_CT_PROJ_RICLASER) {
			// Allow for projectile to ricochet up to 3 times
			ad_newmis.ad_attack_ricochet = 3;
			// Damage is reduced every time it ricochet's
			ad_newmis.dmg = ad_DAMAGE_LASER;
			// Need special think function to reset velocity/angle
			// Shift projectile end of life to variable instead
			ad_newmis.ad_attack_lifetime = time + ad_LIFE_PROJECTILE;
			ad_newmis.nextthink = time + 0.1;
			ad_newmis.think = ad_Think_Projectile;
		}
		// Select model type based on poisonous key
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_LASERGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_LASER);
		// If DP/FTE engine use new particle trail, glowing for Fitz engines
		if (ad_ext_dppart) {
			if (ad_newmis.ad_poisonous) ad_newmis.ad_traileffectnum = particleeffectnum(ad_DPP_TRPOISON);
			else ad_newmis.ad_traileffectnum = particleeffectnum(ad_DPP_TRLASER);
			ad_newmis.effects = 0;	// Remove any glows
		}
	}
	// Wraith fire bones (nails) can be poisonous as well
	else if (ad_proj_type == ad_CT_PROJ_WBONE) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_WPOISON);
		else setmodel (ad_newmis, ad_MODEL_PROJ_WBONE);
	}
	// Wizards/Scrags can be poisonous and have a diff skin (head+gibs)
	// Cannot show change with projectile because its already green!
	else if (ad_proj_type == ad_CT_PROJ_WIZ) setmodel (ad_newmis, ad_MODEL_PROJ_WIZ);

	// Dark Minotaur; can be poisonous (default) or blood
	else if (ad_proj_type == ad_CT_PROJ_MPOISON) setmodel (ad_newmis, ad_MODEL_PROJ_MPOISON);
	else if (ad_proj_type == ad_CT_PROJ_MBLOOD) setmodel (ad_newmis, ad_MODEL_PROJ_MBLOOD);

	// Monster Nails (MONNG) = Red Coloured Nails
	else if (ad_proj_type == ad_CT_PROJ_MONNG) setmodel (ad_newmis, ad_MODEL_PROJ_NGRED);
	else if (ad_proj_type == ad_CT_PROJ_SCORP) setmodel (ad_newmis, ad_MODEL_PROJ_SCORP);
	else if (ad_proj_type == ad_CT_PROJ_FURY2) setmodel (ad_newmis, ad_MODEL_PROJ_FURY2);
	else if (ad_proj_type == ad_CT_PROJ_NOUR1) setmodel (ad_newmis, ad_MODEL_PROJ_NOUR1);
	// Boglord / Fire Shambler nail/lightning attack
	else if (ad_proj_type == ad_CT_PROJ_BLBOLT) {
		if (self.spawnflags & ad_MON_BOGL_STRONG) {
			ad_newmis.ad_classtype = ad_CT_PROJ_BLBOLT2;
			setmodel (ad_newmis, ad_MODEL_PROJ_BLORDBOLT2);
		}
		else setmodel (ad_newmis, ad_MODEL_PROJ_BLORDBOLT1);
	}
	// Golem rock storm attack
	else if (ad_proj_type == ad_CT_PROJ_GROCK) {
		if (random() < 0.5) setmodel (ad_newmis, ad_MODEL_PROJ_GROCK1);
		else setmodel (ad_newmis, ad_MODEL_PROJ_GROCK2);
		ad_newmis.frame = rint(random()*9);
		ad_newmis.avelocity = ad_vecrand(0,200,ad_TRUE);
	}

	// Standard projectile setup (origin, size and velocity)
	//----------------------------------------------------------------------
	ad_newmis.ad_attack_speed = ad_proj_speed;
	ad_newmis.finalangle = ad_dir;
	ad_newmis.velocity = ad_newmis.finalangle * ad_newmis.ad_attack_speed;
	ad_newmis.angles = vectoangles(ad_newmis.finalangle);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		
	setorigin (ad_newmis, ad_org);
};

/*======================================================================
 This missile touch function is designed for monsters NOT players
 * No DIRECT damage, just radius and a lot lower (40 vs 110)
 * Half damage to shamblers (inside T_RadiusDamage)
 * Will work with homing or direct missile attacks
 * checks for breakables that can be destroyed with explosives
 * uses default explosion function 
======================================================================*/
void() ad_Touch_HomingMissile =
{
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	
	//----------------------------------------------------------------------
	// Check for breakable/pushable monster immunity
	if (ad_ai_immunebreakable(self.ad_oldenemy, other)) {
		// Show ammo resistance on bmodel
		ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE,self.origin,ad_SOUND_RESIST_ROCKET);
		ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
		ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
		ad_SpawnProjectileSmoke(self.origin, 300, 50, 150);
	}
	else {
		//----------------------------------------------------------------------
		// Check for breakables that can be triggered
		if (ad_ai_foundbreakable(self.ad_oldenemy, other, ad_TRUE) && other.ad_brktrigmissile != 0) {
			// Found a breakable which is prone to explosive damage
			ad_trigger_ent(other, self.ad_oldenemy);
		}
		else {
			// Homing Missiles always kill any zombie class
			if (other.ad_classgroup == ad_CG_ZOMBIE) 
				ad_T_Damage (other, world, world, ad_DAMAGE_ZOMBIECLASS, ad_NOARMOR);
			else {
				// Missile explosion base/rnd/splash
				self.pos1 = '0 0 0';
				if (self.ad_classtype == ad_CT_PROJ_SHUB1) self.pos1 = self.ad_oldenemy.pos2;
				else if (self.ad_classtype == ad_CT_PROJ_SHAL) self.pos1 = ad_DAMAGE_HMSHAL;
				else if (self.ad_classtype == ad_CT_PROJ_SERG) self.pos1 = ad_DAMAGE_HMSERG;
				// Default uses classic grenade/rocket damage
				else self.pos1_z = ad_DAMAGE_MONROCKET;
			
				// pre-calculate missile damage
				self.dmg = self.pos1_x + (random() * self.pos1_y);
				
				// Check for any rocket ammo resistance (Direct damage only)
				if (other.ad_resist_rockets != 0) {
					self.dmg = ad_Resist_Damage(other, ad_IT_ROCKETS, self.dmg);
				}

				//----------------------------------------------------------------------
				// BLAST BELT
				// Resistance = 100% splashdamage, 50% direct
				if (other.flags & ad_FL_CLIENT && other.ad_moditems & ad_IT_ARTBLASTBELT) {
					ad_PlayBlastBeltSound(other);	// Play impact sound
					if (other.health > 0) {
						// Need some damage otherwise projectile does nothing!
						if (self.dmg <= 0 && self.pos1_z > 0)
							ad_T_Damage (other, self, self.ad_oldenemy, self.pos1_z*ad_ART_BLASTBELT_DD, ad_DAMARMOR);
						// Any Direct damage is reduced
						else if (self.dmg > 0) 
							ad_T_Damage (other, self, self.ad_oldenemy, self.dmg*ad_ART_BLASTBELT_DD, ad_DAMARMOR);
					}
					// ALWAYS do radius damage (can affect other targets)
					// Exceptions are done in RadiusDamage \ T_Damage functions
					if (self.pos1_z > 0)
						ad_T_RadiusDamage (self, self.ad_oldenemy, self.pos1_z, self.ad_oldenemy, ad_IGNORECLASS);
				}
				else {
					// DEFAULT
					// Only call T_ functions if there is damage to do!
					if (self.dmg > 0 && other.health > 0) 
						ad_T_Damage (other, self, self.ad_oldenemy, self.dmg, ad_DAMARMOR);
					
					if (self.pos1_z > 0) {
						// Stop multiple enemies of the same class type (same as wraiths)
						// killing themselves with their own homing missiles!
						// Radius damage also applies poison debuff if present on attacker
						ad_T_RadiusDamage (self, self.ad_oldenemy, self.pos1_z, self.ad_oldenemy, ad_IGNORECLASS);
					}
					else {
						// Check for poison debuff (using poisonous flag)
						if (self.ad_poisonous == ad_TRUE) ad_PoisonDeBuff(other);
					}
				}
				//----------------------------------------------------------------------
			}
		}

		//----------------------------------------------------------------------
		// Rocket resistance is shown with puffs of smoke
		if (other.ad_resist_rockets > 0) ad_Resist_Rockets(other, self.origin);
		else {
			// Use special effect for voreball explosions in DP
			if (ad_ext_dppart) {
				// DP effect name set before homing missile launched
				if (self.ad_poisonous == ad_TRUE) self.ad_dpp_name = ad_DPP_TEPOISON;
				pointparticles(particleeffectnum(self.ad_dpp_name), self.origin, '0 0 0', 1);
				// Play standard explosion sound
				sound(self, ad_CHAN_WEAPON, ad_SOUND_REXP3, 1, ad_ATTN_NORM);
			}
			else {
				if (self.ad_poisonous) {
					// New special coloured particle explosion (rogue expansion)
					WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
					WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
					WriteCoord (ad_MSG_BROADCAST, self.origin_x);
					WriteCoord (ad_MSG_BROADCAST, self.origin_y);
					WriteCoord (ad_MSG_BROADCAST, self.origin_z);
					WriteByte (ad_MSG_BROADCAST, 51);
					WriteByte (ad_MSG_BROADCAST, 8);
					// Sprite explosion for Fitz engines
					ad_SpawnExplosion(ad_EXPLODE_POISON_SMALL, self.origin, ad_SOUND_REXP3);
				}
				else {
					// Standard explosion
					WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
					WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
					WriteCoord (ad_MSG_BROADCAST, self.origin_x);
					WriteCoord (ad_MSG_BROADCAST, self.origin_y);
					WriteCoord (ad_MSG_BROADCAST, self.origin_z);
					// Sprite explosion for Fitz engines
					ad_SpawnExplosion(ad_EXPLODE_SMALL, self.origin, ad_SOUND_REXP3);
				}
			}
		}
	}

	// Hide+Delete homing missile, no longer needed
	// Wait for any sounds to finish playing
	ad_entity_remove(self, 4);
};

//----------------------------------------------------------------------
// Re-direct any map hacks to the new function replacement
void() ad_ShalMissileTouch = { ad_Touch_HomingMissile(); };

//----------------------------------------------------------------------
void() ad_Steer_HomingMissile =
{
	// If tracking enemies dies or end level? remove homing missiles
	if (self.enemy.health < 1) { remove(self); return; }
	if (ad_intermission_running > 0) { remove(self); return; }
	if (ad_cinematic_running > 0) { remove(self); return; }

	// After 1s let homing missiles impact on ower
	if (self.waitmin < time) self.owner = self;

	// Stop missile tracking if owner is dead and mode is enabled
	if (self.owner.health < 1 && self.ad_no_trackondeath == ad_TRUE)
		self.ad_no_trackondeath = ad_NEGATIVE;

	// Has projectile tracking been disabled?
	if (self.ad_no_trackondeath == ad_NEGATIVE) return;
	
	// Full YAW movement speed, no restriction
	self.ad_finaldest = self.enemy.origin + self.v_angle;
	self.ad_attack_track = normalize(self.ad_finaldest - self.origin);
	
	// Update velocity and model facing angle
	self.velocity = self.ad_attack_track * self.ad_attack_speed;
	self.angles = vectoangles(self.velocity);
	
	// Slow speed update that the missile can steer around corners
	// sloppy slow updates allows for a better game experience		
	self.nextthink = time + 0.2;
	self.think = ad_Steer_HomingMissile;	
};

//----------------------------------------------------------------------
void(vector ad_orgofs, vector ad_targofs, float ad_proj_type, float ad_proj_speed) ad_Launch_HomingMissile =
{
	local vector ad_org, ad_dir;
	local float ad_dist, ad_flytime;

	// Check if there is space to spawn entity
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	if (ad_entity_pcontent(ad_org)) return;
	
	ad_newmis = spawn ();
	// Owner is always excluded from touch functions, save in oldenemy
	// and after one second remove owner so will touch everything
	ad_newmis.owner = ad_newmis.ad_oldenemy = self;
	ad_newmis.classname = "proj_rocket";		// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_proj_type;			// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJROCKETS;		// Ammo type

	ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;	// Default = large collision
	ad_newmis.enemy = self.enemy;				// Used for homing target
	ad_newmis.v_angle = ad_targofs;				// Store for later

	//----------------------------------------------------------------------
	// Aim the missile slightly above enemy
	ad_dir = normalize((self.enemy.origin + ad_newmis.v_angle) - ad_org);
	ad_dist = vlen (self.enemy.origin - ad_org);
	ad_flytime = ad_dist * 0.002;
	if (ad_flytime < 0.1) ad_flytime = 0.1;

	//----------------------------------------------------------------------
	ad_newmis.solid = ad_SOLID_BBOX;
	ad_newmis.touch = ad_Touch_HomingMissile;
	ad_newmis.nextthink = ad_flytime + time;
	ad_newmis.think = ad_Steer_HomingMissile;
	ad_newmis.ad_attack_speed = ad_proj_speed;
	
	// Setup default homing missile mode
	// Priority : ENTITY > IMPULSE > WORLDSPAWN
	if (self.ad_no_trackondeath == ad_NEGATIVE) ad_newmis.ad_no_trackondeath = ad_FALSE;
	else if (self.ad_no_trackondeath == ad_TRUE) ad_newmis.ad_no_trackondeath = ad_TRUE;
	else if (ad_map_notrackondeath == ad_TRUE) ad_newmis.ad_no_trackondeath = ad_TRUE;
	else ad_newmis.ad_no_trackondeath = ad_FALSE;
	
	// Allow 3s for the homing missile to travel away
	ad_newmis.waitmin = time + 3;
	ad_newmis.ad_poisonous = ad_newmis.owner.ad_poisonous;

	// Setup model for each missile type
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_PROJ_SHAL) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_SHALGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_SHAL);
		ad_newmis.ad_dpp_name = ad_DPP_TEVORESPIKE;
	}
	else if (ad_proj_type == ad_CT_PROJ_SERG) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_SHALGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_SERG);
		ad_newmis.ad_dpp_name = ad_DPP_TEEXPLODE;
	}
	else if (ad_proj_type == ad_CT_PROJ_SHUB1) {
		setmodel(ad_newmis, ad_MODEL_PROJ_SHUB1);
		ad_newmis.ad_dpp_name = ad_DPP_TEEXPLODE;
		// Push the homing missing up from center
		makevectors(self.angles);
		// The angles key will reverse direction
		// for up-side-down Shub
		ad_dir = v_up*0.5;
	}

	// Standard projectile setup (origin, size and velocity)
	//----------------------------------------------------------------------
	ad_newmis.ad_attack_track = ad_dir;
	ad_newmis.velocity = ad_newmis.ad_attack_track * ad_newmis.ad_attack_speed;
	ad_newmis.angles = vectoangles(self.velocity);
	ad_newmis.avelocity = ad_vecrand(100,200,ad_FALSE);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		
	setorigin (ad_newmis, ad_org);
};

/*======================================================================
 ROCKETS
 * Half damage to shamblers (T_MissileTouch and T_RadiusDamage)
 * checks for breakables that can be destroyed with explosives
 * All rockets have direct & radius damage (based on projectile type)
======================================================================*/
void() ad_Touch_Missile =
{
	local float ad_lavadmg;
	
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other == self.owner) return;			// Touching self, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	if (self.ad_oldenemy) {		// stop packs of owners killing each other
		if (other.ad_classtype == self.ad_oldenemy.ad_classtype) return;	}
	// Guardian skull wizards have special poison explosion
	if (self.ad_classtype == ad_CT_PROJ_SKULLW && self.ad_th_updmissile != ad_SUB_Null) {
		self.ad_th_updmissile(); return; }
	
	//----------------------------------------------------------------------
	// Check for breakable/pushable monster immunity
	if (ad_ai_immunebreakable(self.owner, other)) {
		// Show ammo resistance
		ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE,self.origin,ad_SOUND_RESIST_ROCKET);
		ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
		if (random() < 0.5) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
		if (random() < 0.5) ad_SpawnProjectileSmoke(self.origin, 300, 50, 150);
	}
	else {
		//----------------------------------------------------------------------
		// Check for breakables that can be triggered
		if (ad_ai_foundbreakable(self.owner, other, ad_TRUE) && other.ad_brktrigmissile != 0) {
			// Found a breakable which is prone to explosive damage
			ad_trigger_ent(other, self.owner);
		}
		else {
			// Setup rocket damage (vector = base + random and splash)
			if (self.ad_classtype == ad_CT_PROJ_ROCKET) self.pos1 = ad_DAMAGE_RLPLAYER;
			// Boss ID - E1M7
			else if (self.ad_classtype == ad_CT_PROJ_LAVA) {self.pos1 = ad_DAMAGE_RLPLAYER; ad_lavadmg=ad_TRUE;}
			// BOSS Custom version with custom damage (self.pos2)
			else if (self.ad_classtype == ad_CT_PROJ_CHTHON) {self.pos1 = self.owner.pos2; ad_lavadmg=ad_TRUE;}
			// BOSS Custom for ad_mountain (Chthon model)
			else if (self.ad_classtype == ad_CT_PROJ_FIRETOP) {self.pos1 = ad_DAMAGE_RLFIRETOP; ad_lavadmg=ad_TRUE;}
			// BOSS Custom for ad_magma (Stone demon model)
			else if (self.ad_classtype == ad_CT_PROJ_EIDO1) self.pos1 = ad_DAMAGE_RLEIDO;
			// BOSS Custom for ad_azad (Ice Golem model)
			else if (self.ad_classtype == ad_CT_PROJ_ICEG1) self.pos1 = ad_DAMAGE_RLICEG;
			// BOSS Custom for ad_sepulcher (Fire Shambler)
			else if (self.ad_classtype == ad_CT_PROJ_BLORD2) self.pos1 = ad_DAMAGE_RLBLORD;
			// BOSS Custom for ad_sepulcher (Green Shambler)
			else if (self.ad_classtype == ad_CT_PROJ_BLORD) {
				self.pos1 = ad_DAMAGE_RLBLORD;
				// Don't spawn gib models at impact (could be solid)
				self.oldorigin = self.origin;
				self.origin = self.origin - 8*normalize(self.velocity);
				// Special gib model, frame and movement pattern
				self.ad_gib1mdl = ad_MODEL_PROJ_BLORD1S;
				self.ad_gib1frame = 9;
				// Throw gib quantity based on skill level
				ad_ThrowGib(11, rint(0.5 + random()*3) );
				// Restore origin for rest of rocket impact
				self.origin = self.oldorigin;
			}
			else if (self.ad_classtype == ad_CT_PROJ_ARMY) self.pos1 = ad_DAMAGE_RLARMY;
			else if (self.ad_classtype == ad_CT_PROJ_SWEEP1) self.pos1 = ad_DAMAGE_RLSWEEPER;
			else if (self.ad_classtype == ad_CT_PROJ_DGUARDQ) {self.pos1 = ad_DAMAGE_RLDGUARDQ; ad_lavadmg=ad_TRUE;}
			else if (self.ad_classtype == ad_CT_PROJ_DROLE) {self.pos1 = ad_DAMAGE_RLDROLE; ad_lavadmg=ad_TRUE;}
			else if (self.ad_classtype == ad_CT_PROJ_FURY1) self.pos1 = ad_DAMAGE_RLFURY;
			else if (self.ad_classtype == ad_CT_PROJ_DPRINCE1) self.pos1 = ad_DAMAGE_RLDPRINCE;
			else if (self.ad_classtype == ad_CT_PROJ_GARG) {self.pos1 = ad_DAMAGE_RLGARG; ad_lavadmg=ad_TRUE;}
			else if (self.ad_classtype == ad_CT_PROJ_JIM2) self.pos1 = ad_DAMAGE_RLJIM2;
			else if (self.ad_classtype == ad_CT_PROJ_SKULLW) self.pos1 = ad_DAMAGE_RLSKULLW;
			else if (self.ad_classtype == ad_CT_PROJ_DEFLECT1) self.pos1 = ad_DAMAGE_RLDEFLECT;
			else if (self.ad_classtype == ad_CT_PROJ_SEEKER) self.pos1 = ad_DAMAGE_RLSEEKER;
			else if (self.ad_classtype == ad_CT_PROJ_MAMMOTH) self.pos1 = ad_DAMAGE_RLMAMMOTH;
			//else if (self.classtype == CT_PROJ_BARON) self.pos1 = DAMAGE_RLBARON;
			else if (self.ad_classtype == ad_CT_PROJ_JUDGER) self.pos1 = ad_DAMAGE_RLJUDGE;
			else if (self.ad_classtype == ad_CT_PROJ_JUSTICER) self.pos1 = ad_DAMAGE_RLJUDGE;
			else if (self.ad_classtype == ad_CT_PROJ_RAINDEER) self.pos1 = ad_DAMAGE_RLRAINDEER;

			// Instant death explosion for zombies from rocket explosions!
			// Is doesn't make sense that this is not a default for explosives
			// This will affect _zombie, _zombiek, _mummy monster types 
			if (other.ad_classgroup == ad_CG_ZOMBIE) {
				// Change direct damage direct to make sure it zombie gibs
				if (self.pos1_x < ad_DAMAGE_RLKILLZOM) self.pos1_x = ad_DAMAGE_RLKILLZOM;
			}

			// pre-calculate DIRECT ONLY rocket damage
			self.dmg = self.pos1_x + (random() * self.pos1_y);
			
			// Check for any rocket ammo resistance
			if (other.ad_resist_rockets != 0)
				self.dmg = ad_Resist_Damage(other, ad_IT_ROCKETS, self.dmg);
			
			//----------------------------------------------------------------------
			// LAVA SHIELD
			// Resistance = 50% fire/lava attacks
			// Monsters - Boss, Chthon, Firetop, Drole, Quoth Deathguard and Gargoyle
			if (other.flags & ad_FL_CLIENT && other.ad_moditems & ad_IT_ARTLAVASHIELD && ad_lavadmg == ad_TRUE) {
				ad_PlayLavaShieldSound(other);
				self.dmg = floor(self.dmg * 0.5);
				if (self.dmg <= 0) self.dmg = 0;
			}

			//----------------------------------------------------------------------
			// BLAST BELT
			// Resistance = 100% splashdamage, 50% direct
			if (other.flags & ad_FL_CLIENT && other.ad_moditems & ad_IT_ARTBLASTBELT) {
				ad_PlayBlastBeltSound(other);	// Play impact sound
				if (other.health > 0) {
					// Need some damage otherwise projectile does nothing!
					if (self.dmg <= 0 && self.pos1_z > 0)
						ad_T_Damage (other, self, self.owner, self.pos1_z*ad_ART_BLASTBELT_DD, ad_DAMARMOR);
					// Any direct damage is reduced
					else if (self.dmg > 0) 
						ad_T_Damage (other, self, self.owner, self.dmg*ad_ART_BLASTBELT_DD, ad_DAMARMOR);
				}
				// ALWAYS do radius damage (can affect other targets)
				// Exceptions are done in RadiusDamage \ T_Damage functions
				if (self.pos1_z > 0) 
					ad_T_RadiusDamage (self, self.owner, self.pos1_z, other, ad_DAMAGEALL);
			}
			else {
				// DEFAULT
				// Only call T_ functions if there is damage to do!
				if (self.dmg > 0 && other.health > 0) 
					ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);
				if (self.pos1_z > 0) 
					ad_T_RadiusDamage (self, self.owner, self.pos1_z, other, ad_DAMAGEALL);
			}
			//----------------------------------------------------------------------
		}
		
		// Rocket resistance is shown with puffs of smoke
		if (other.ad_resist_rockets > 0) ad_Resist_Rockets(other, self.origin);
		else {
			//----------------------------------------------------------------------
			// Check for poison debuff (using poisonous flag)
			if (self.ad_poisonous == ad_TRUE) {
				// Use new poison explosion
				self.height = ad_EXPLODE_POISON_MED;
				// Poisonous projectiles
				ad_PoisonDeBuff(other);
			}

			// Move the explosion effect higher up from point of contact
			self.origin = self.origin - 8*normalize(self.velocity);

			// Default ID particle explosion for fire explosions
			if (self.height < ad_EXPLODE_PLASMA_SMALL) {
				WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
				WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
				WriteCoord (ad_MSG_BROADCAST, self.origin_x);
				WriteCoord (ad_MSG_BROADCAST, self.origin_y);
				WriteCoord (ad_MSG_BROADCAST, self.origin_z);
			}

			// Play original explosion sound or replacement
			if (self.noise == "") self.noise = ad_SOUND_REXP3;
			ad_SpawnExplosion(self.height, self.origin, self.noise);
		}
	}
	
	// Hide + Delete rocket, no longer needed
	ad_entity_remove(self, 1);
};
	
//----------------------------------------------------------------------
void() ad_Puff_Missile = {
	ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, self.origin, "");
	ad_entity_remove(self, 0.1);
};

//----------------------------------------------------------------------
// Re-direct any map hacks to the new function replacement
void() ad_T_MissileTouch = { ad_Touch_Missile(); };

//----------------------------------------------------------------------
void() ad_Steer_LimitedMissile =
{
	local float ad_veclen, ad_vecdist;
	
	// No tracking during intermission / cinematic
	if (ad_intermission_running > 0) { ad_Puff_Missile(); return; }
	if (ad_cinematic_running > 0) { ad_Puff_Missile(); return; }
	// Remove projectile after a certain time limit
	if (self.ad_attack_finished < time) {
		// Do nothing if controlled via custom particle trail
		if (self.ad_part_qctrail == 0) ad_Puff_Missile();
		return;
	}

	// play sound when starting the missile in flight
	if (self.ad_attack_instant == ad_TRUE && self.noise1 != "")
		sound (self, ad_CHAN_WEAPON, self.noise1, 1, ad_ATTN_NORM);
	// Only play first sound once
	self.ad_attack_instant = ad_FALSE;

	// Stop steering if attacker or enemy is dead
	if (self.owner.health < 1) self.ad_attack_disabled = ad_TRUE;
	else if (self.enemy.health < 1) self.ad_attack_disabled = ad_TRUE;
			
	// How often to steer projectile
	self.think = ad_Steer_LimitedMissile;
	self.nextthink =  time + 0.2;

	// The amount of time to keep steering rocket
	// Time = 0.2 * ( 5 + skill * 5) 
	// EASY = 1s, NORMAL = 2s, HARD = 3s, NM = 4s
	self.count = self.count + 1;
	if ( self.count > (5 + (ad_skill*5)) ) self.ad_attack_disabled = ad_TRUE;

	if (!self.ad_attack_disabled) {
		// -------------------------------------------------------------
		// Steering rocket towards the enemy PART 1
		// -------------------------------------------------------------
		// First check - Is the rocket too close to the enemy?
		// Based on skill level change that distance to get closer
		// This can change if projectile is fast and tick rate slow
		// The distance check has to happen before sightline checks
		// otherwise the missile will do one last deadly adjustment!
		//
		// -------------------------------------------------------------
		// Work out distance to enemy (target) origin
		ad_veclen = vlen(self.enemy.origin - self.origin);
		// Skill distance: 160=Easy, 140=Normal, 120=Hard, 100=NM
		ad_vecdist = ad_SPEED_ROCSTEERDIS - (ad_skill * ad_SPEED_ROCSTEERDISSKILL);
		// Stop steering towards enemy if too close
		if (ad_veclen < ad_vecdist) self.ad_attack_disabled = ad_TRUE;
		else {
			// -------------------------------------------------------------
			// Steering rocket towards the enemy PART 2
			// -------------------------------------------------------------
			// Having the sight check on the rocket means it will turn corners
			// really fast and look/feel unfair (shalrath problems).
			//
			// Part 1 - place a sight check from attacker to enemy
			// If the enemy has moved behind cover this will break LoS
			// and stop the rocket steering around corners
			//
			// Part 2 - Restrict steering speed to stop sudden turns
			// Slowly build up to super accurate turning direction
			//
			// -------------------------------------------------------------
			// All AI sight checks are designed for self as primary source
			// This 'Trace' does not involve self, reqs attacker -> enemy
			traceline(self.owner.origin + self.ad_attack_offset, self.ad_attack_origin, ad_TRUE, self.owner);
			// Update tracking origin and direction
			if (trace_fraction == 1) {
				self.ad_attack_origin = self.enemy.origin;
				self.ad_attack_track = self.ad_attack_origin - self.origin;
				// Accuracy starts low and increase over time
				if (self.ad_attack_steering < 1) {
					self.ad_attack_track = self.ad_attack_track * self.ad_attack_steering;
					self.ad_attack_steering = self.ad_attack_steering + ad_SPEED_ROCSTEERINCACC;
				}
				// Normalize (ready for speed) after any steering adjustment
				self.ad_attack_track = normalize(self.ad_attack_track);
			}
			// Once sight line broken, no more steering
			else self.ad_attack_disabled = ad_TRUE;
		}
	}	

	// Make sure projectile velocity has an upper limit
	// Speed increase: 70=Easy, 80=Normal, 90=Hard, 100=NM
	if (self.ad_attack_speed < self.ad_attack_maxspeed) {
		self.ad_attack_speed = self.ad_attack_speed + ad_SPEED_ROCSTEERINC + (ad_skill * ad_SPEED_ROCSTEERINCSKILL);
		if (self.ad_attack_speed > self.ad_attack_maxspeed) self.ad_attack_speed = self.ad_attack_maxspeed;
	}
		
	// Update direction, velocity and facing angle (facing velocity)
	self.velocity = self.ad_attack_track * self.ad_attack_speed;
	if (self.ad_attack_angle) self.angles = vectoangles(self.velocity);
};

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir, vector ad_avel, float ad_proj_type, float ad_proj_speed) ad_Launch_Missile =
{
	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_org)) return;
	
	ad_newmis = spawn ();
	ad_newmis.owner = self;
	ad_newmis.classname = "proj_rocket";	// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_proj_type;		// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJROCKETS;	// Ammo type

	// Player rockets need to take into account autoaim
	if (self.ad_classtype == ad_CT_PLAYER) {
		if (ad_playerprojsize == 0) 
			ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;	// Large collision
		else ad_newmis.movetype = ad_MOVETYPE_FLY;		// Small collision
	}
	else {
		// default monster missile width is thin!
		ad_newmis.movetype = ad_MOVETYPE_FLY;
		// Horrible exception for the missile touch function
		// Gargoyle rockets need to pass through other gargoyles
		// otherwise a pack of them would kill each other!
		if (self.ad_classtype == ad_CT_MONGARGOYLE) ad_newmis.ad_oldenemy = self;
	}

	//----------------------------------------------------------------------
	ad_newmis.solid = ad_SOLID_BBOX;
	ad_newmis.touch = ad_Touch_Missile;				// Default touch/impact
	ad_newmis.height = ad_EXPLODE_SMALL;				// Default impact sound
	ad_newmis.ad_attack_speed = ad_newmis.ad_attack_maxspeed = ad_proj_speed;	// current/max speed
	ad_newmis.ad_poisonous = ad_newmis.owner.ad_poisonous;	// Take poison from owner (firing)
	ad_newmis.ad_attack_finished = time + ad_LIFE_ROCKET;// Used later for steering
	ad_newmis.nextthink = ad_newmis.ad_attack_finished;	// End of projectile life
	ad_newmis.think = ad_SUB_Remove;

	// Setup model for each missile type
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_PROJ_ROCKET) setmodel(ad_newmis, ad_MODEL_PROJ_ROCKET);
	else if (ad_proj_type == ad_CT_PROJ_GARG) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_GARGOYLEGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_GARGOYLE);
	}
	else if (ad_proj_type == ad_CT_PROJ_FURY1) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_SHALGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_FURY1);
	}
	else if (ad_proj_type == ad_CT_PROJ_SKULLW) {
		if (ad_newmis.ad_poisonous) {
			setmodel (ad_newmis, ad_MODEL_PROJ_SWSKULLP);
			// Copy over poison explosive function just incase
			// Skull wizard dies before projectile hits something
			ad_newmis.ad_th_updmissile = self.ad_th_updmissile;
		}
		else {
			// Classic skullwizard flaming skull projectile!
			setmodel(ad_newmis, ad_MODEL_PROJ_SWSKULL);
			ad_newmis.ad_th_updmissile = ad_SUB_Null;
		}
	}
	else if (ad_proj_type == ad_CT_PROJ_DGUARDQ) {
		setmodel (ad_newmis, ad_MODEL_PROJ_DGUARDQ);
		ad_newmis.noise = "dguard/hit.wav";
	}
	else if (ad_proj_type == ad_CT_PROJ_DROLE) {
		if (ad_newmis.ad_poisonous) setmodel (ad_newmis, ad_MODEL_PROJ_DROLEGRN);
		else setmodel (ad_newmis, ad_MODEL_PROJ_DROLE);
		ad_newmis.noise = "drole/r_explode.wav";
		ad_newmis.nextthink = time + 0.025;
		ad_newmis.think = self.ad_th_updmissile;
	}
	else if (ad_proj_type == ad_CT_PROJ_RAINDEER) {
		setmodel(ad_newmis, ad_MODEL_PROJ_RAIND);
		ad_newmis.noise = "xmas/raindeer/hit.wav";
	}
	//----------------------------------------------------------------------
	else if (ad_proj_type == ad_CT_PROJ_BLORD) {
		// If the boglord dies before the impact of the 'rocket'
		// then the self.owner field will be invalid. 
		// Setup the 'correct' projectile type beforehand instead!
		if (self.spawnflags & ad_MON_BOGL_STRONG) {
			ad_newmis.ad_classtype = ad_CT_PROJ_BLORD2;
			setmodel (ad_newmis, ad_MODEL_PROJ_BLORD2B);
		}
		else setmodel (ad_newmis, ad_MODEL_PROJ_BLORD1B);
		ad_newmis.frame = 7; // Large size
		ad_newmis.noise = "boglord/slime_explode.wav";
	}
	//----------------------------------------------------------------------
	// All robot and boss monsters block poisonous flag
	else if (ad_proj_type == ad_CT_PROJ_JIM2) {
		setmodel(ad_newmis, ad_MODEL_PROJ_ROCKET);
		ad_newmis.noise = "jim/rocket_hit.wav";
	}
	else if (ad_proj_type == ad_CT_PROJ_SEEKER) {
		setmodel(ad_newmis, ad_MODEL_PROJ_ROCKET);
		ad_newmis.noise = "seeker/rocket_hit.wav";
	}
	//----------------------------------------------------------------------
	// Bosses
	else if (ad_proj_type == ad_CT_PROJ_LAVA) setmodel (ad_newmis, ad_MODEL_PROJ_LAVA);
	else if (ad_proj_type == ad_CT_PROJ_FIRETOP) setmodel (ad_newmis, ad_MODEL_PROJ_LAVA);
	else if (ad_proj_type == ad_CT_PROJ_CHTHON) {
		if (self.spawnflags & ad_MON_CHTHON_GREEN) setmodel (ad_newmis, ad_MODEL_PROJ_SLIME);
		else setmodel (ad_newmis, ad_MODEL_PROJ_LAVA);
	}
	else if (ad_proj_type == ad_CT_PROJ_EIDO1) {
		setmodel(ad_newmis, ad_MODEL_PROJ_EIDO1);
		ad_newmis.frame = 7;
		if (random() < 0.5) ad_newmis.noise = "eidolon/rock_hit1.wav";
		else ad_newmis.noise = "eidolon/rock_hit2.wav";
		if (random() < 0.5) ad_newmis.height = ad_EXPLODE_MED;
	}
	else if (ad_proj_type == ad_CT_PROJ_ICEG1) {
		setmodel (ad_newmis, ad_MODEL_PROJ_GSHARD);
		ad_newmis.noise = "golem/iceshard_impact.wav";
		ad_newmis.height = ad_EXPLODE_ICE_BIG;
		ad_newmis.nextthink = time + 0.1;
		ad_newmis.think = self.ad_th_updmissile;
		ad_newmis.pos1 = self.enemy.origin;
	}
	//----------------------------------------------------------------------
	// Limited rocket steering types
	else if (ad_proj_type == ad_CT_PROJ_ARMY) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_ROCKETGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_ROCKET);
		ad_newmis.noise = "soldier/rocket_hit.wav";
		ad_newmis.ad_attack_speed = 200;
		ad_newmis.ad_attack_rage = ad_TRUE;
		ad_newmis.ad_attack_angle = ad_TRUE;
	}
	else if (ad_proj_type == ad_CT_PROJ_DEFLECT1) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_ROCKETGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_ROCKET);
		ad_newmis.noise = "deflector/rocket_hit.wav";
		ad_newmis.ad_attack_speed = 200;
		ad_newmis.ad_attack_rage = ad_TRUE;	// Steering missile
		ad_newmis.ad_attack_angle = ad_TRUE;	// Rotate towards direction
	}
	else if (ad_proj_type == ad_CT_PROJ_DPRINCE1) {
		setmodel(ad_newmis, self.ad_attack_proj1);
		// Custom trails for Blue/Red rockets
		ad_newmis.ad_part_qctrail = ad_TRUE;	// Custom trail
		ad_newmis.ad_part_style = self.ad_part_style;
		ad_newmis.ad_part_trstyle = self.ad_part_trstyle;
		ad_newmis.ad_dpp_name = self.ad_dpp_name;
		ad_newmis.ad_attack_speed = 100;
		ad_newmis.ad_attack_rage = ad_TRUE;	// Steering missile
	}
	else if (ad_proj_type == ad_CT_PROJ_JUDGER) {
		setmodel(ad_newmis, ad_MODEL_PROJ_JUDGER);
		ad_newmis.noise = "judge/magic_hit.wav";
		ad_newmis.ad_attack_speed = 100;
		ad_newmis.ad_attack_rage = ad_TRUE;	// Steering missile
		ad_newmis.ad_attack_angle = ad_TRUE;	// Rotate towards direction
		ad_newmis.ad_attack_offset = '0 0 32';	// Really tall
		ad_newmis.ad_attack_steering = 0.5;
	}
	else if (ad_proj_type == ad_CT_PROJ_JUSTICER) {
		setmodel(ad_newmis, ad_MODEL_PROJ_JUDGER);
	}
	// Baron was replaced with Justice instead
	//else if (proj_type == CT_PROJ_BARON) {
	//	setmodel(newmis, MODEL_PROJ_BARON1);
	//	newmis.noise = "baron/magic_hit.wav";
	//	newmis.attack_speed = 100;
	//	newmis.attack_rage = TRUE;	// Steering missile
	//}
	else if (ad_proj_type == ad_CT_PROJ_MAMMOTH) {
		setmodel(ad_newmis, ad_MODEL_PROJ_ROCKET);
		ad_newmis.noise = "mammoth/rocket_hit.wav";
		ad_newmis.ad_attack_speed = 200;
		ad_newmis.ad_attack_rage = ad_TRUE;	// Steering missile
		ad_newmis.ad_attack_angle = ad_TRUE;	// Rotate towards direction
	}
	else if (ad_proj_type == ad_CT_PROJ_SWEEP1) {
		setmodel(ad_newmis, ad_MODEL_PROJ_SWEEPER1);
		ad_newmis.noise = "sweeper/mine_hit.wav";
		// Play sound on spawn of rocket
		ad_newmis.ad_attack_instant = ad_TRUE;
		ad_newmis.noise1 = "sweeper/mine_fire.wav";
		ad_newmis.ad_attack_speed = 200;
		ad_newmis.ad_attack_rage = ad_TRUE;	// Steering missile
		ad_newmis.ad_attack_angle = ad_TRUE;	// Rotate towards direction
	}

	// Limited missile steering
	//----------------------------------------------------------------------
	if (ad_newmis.ad_attack_rage == ad_TRUE) {
		// Use firing entity for attack tracking setup
		ad_newmis.ad_attack_track = ad_dir;
		if (ad_newmis.ad_attack_steering == 0)
			ad_newmis.ad_attack_steering = ad_SPEED_ROCSTEERBASE;
		ad_newmis.enemy = ad_SUB_entEnemyTarget();
		ad_newmis.ad_attack_origin = ad_newmis.enemy.origin;
		ad_newmis.ad_attack_disabled = ad_FALSE;
		ad_newmis.ad_part_exitpuff = ad_TRUE;
		// Is the plasma particle trail required?
		// Particle function runs faster than steering, store for later
		if (ad_newmis.ad_part_qctrail == ad_TRUE ) {
			ad_newmis.ad_part_secfunc = ad_Steer_LimitedMissile;
			ad_newmis.ad_part_sectimer = time + 0.1;
		}
		else {
			// Default setup for steering rocket
			ad_newmis.think = ad_Steer_LimitedMissile;
			ad_newmis.nextthink = time + 0.1;
		}
	}
	
	// Standard projectile setup (origin, size and velocity)
	//----------------------------------------------------------------------
	ad_newmis.velocity = ad_dir * ad_newmis.ad_attack_maxspeed;
	ad_newmis.avelocity = ad_avel;
	ad_newmis.angles = vectoangles(ad_newmis.velocity);
	ad_newmis.oldorigin = ad_newmis.origin = ad_org;	// Save starting origin
	setorigin (ad_newmis, ad_newmis.origin);		// Move to start point
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

	// Special particle trail
	//----------------------------------------------------------------------
	if (ad_newmis.ad_part_qctrail == ad_TRUE ) {
		// Is DP engine active for new particle trail?
		if (ad_ext_dppart && ad_newmis.ad_dpp_name != "") {
			ad_newmis.ad_traileffectnum = particleeffectnum(ad_newmis.ad_dpp_name);
			ad_newmis.effects = 0;
		}
		// Setup particle defaults for hazard emitter
		ad_Default_ParticleTrail(ad_newmis);
		ad_newmis.think = ad_Custom_ParticleTrail;	
		ad_newmis.nextthink = time + 0.02;
	}
};

/*======================================================================
 GRENADES
 * Half damage to shamblers (T_MissileTouch and T_RadiusDamage)
 * checks for breakables that can be destroyed with explosives
 * Grenade damage is based on dmg key (default = player)
======================================================================*/
void() ad_Explode_Grenade =
{
	// Block touch functions
	if (self.state == ad_STATE_DISABLED) return;
	self.touch = ad_SUB_Null;
	self.state = ad_STATE_DISABLED;
	
	// Customize damage based on projectile type
	if (self.ad_classtype == ad_CT_PROJ_GLMON) self.dmg = ad_DAMAGE_MONGRENADE;
	else if (self.ad_classtype == ad_CT_PROJ_MEGG) self.dmg = 0;
	else if (self.ad_classtype == ad_CT_PROJ_NOUR2) {
		self.dmg = ad_DAMAGE_MONGRENADE;
		// Don't spawn gib models at impact (could be solid)
		self.oldorigin = self.origin;
		self.origin = self.origin - 8*normalize(self.velocity);
		// Special gib model, frame and movement pattern
		self.ad_gib1mdl = ad_MODEL_PROJ_NOUR2S;
		self.ad_gib1sound = ad_GIB_IMPACT_ACID;
		self.max_health = ad_MON_GIBFOUNTAIN;
		self.ad_gib1frame = 9;
		self.ad_gibtype = ad_GIBTYPE_POISON;
		// Setup particles from gib on floor
		self.ad_gibpartstyle = ad_PARTICLE_BURST_YELLOW;
		// Setup damage and impact explosion
		self.ad_gib1dmg = rint( 2 + (random() * ad_skill) );
		self.ad_gib1exp = ad_EXPLODE_BURST_POISON;
		// Throw gib quantity based on skill level
		ad_ThrowGib(11, rint( 1 + random() * (1 + ad_skill) ));
		// Restore origin for rest of grenade impact
		self.origin = self.oldorigin;
		self.noise = "nour/explode2.wav";
	}
	// Default player grenade
	else if (!self.dmg) self.dmg = ad_DAMAGE_PLAYGRENADE; 

	//----------------------------------------------------------------------
	// Grenades ALWAYS do radius damage (work through findradius list)
	// Exceptions are done in RadiusDamage \ T_Damage functions
	if (self.dmg > 0)
		ad_T_RadiusDamage (self, self.owner, self.dmg, world, ad_DAMAGEALL);
	
	//----------------------------------------------------------------------
	// BLAST BELT
	// Resistance = 100% splashdamage, 50% direct
	if (self.ad_activate.flags & ad_FL_CLIENT && self.ad_activate.takedamage == ad_DAMAGE_AIM
		&& self.ad_activate.ad_moditems & ad_IT_ARTBLASTBELT ) {
		ad_PlayBlastBeltSound(other);	// Play impact sound
		// Any direct damage is reduced
		if (self.dmg > 0 && self.ad_activate.health > 0) 
			ad_T_Damage (self.ad_activate, self, self.owner, self.dmg*ad_ART_BLASTBELT_DD, ad_DAMARMOR);
	}
	//----------------------------------------------------------------------

	// Show Rocket resistance with puffs of smoke
	if (self.ad_activate.ad_resist_rockets > 0) 
		ad_Resist_Rockets(self.ad_activate, self.origin);
	else {
		//----------------------------------------------------------------------
		// Check for poison debuff (using poisonous flag)
		if (self.ad_poisonous == ad_TRUE) {
			// Use new poison explosion
			self.height = ad_EXPLODE_POISON_MED;
			// Poisonous projectiles
			ad_PoisonDeBuff(other);
		}
		// Default ID particle explosion for fire explosions
		if (self.height < ad_EXPLODE_PLASMA_SMALL) {
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
			WriteCoord (ad_MSG_BROADCAST, self.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		}
		// Play original explosion sound
		ad_SpawnExplosion(self.height, self.origin, ad_SOUND_REXP3);
	}
	// Hide grenade, no longer needed
	ad_entity_remove(self, 1);
};

//----------------------------------------------------------------------
void() ad_Touch_Grenade =
{
	if (ad_entity_pcontent(self.origin)) {remove(self); return;}
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (other == self.owner) return;			// Touching attacker, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	
	self.ad_activate = other;		// Always keep track of what to damage
	
	// Let minion eggs re-bounce in opposite direction
	// Don't want them to explode like grenades
	if (self.ad_classtype == ad_CT_PROJ_MEGG && other.takedamage == ad_DAMAGE_AIM) {
		if (ad_CheckZeroVector(self.velocity) == ad_FALSE) {
			self.angles = vectoangles(self.mangle);
			self.angles_y = ad_anglemod(self.angles_y + 180);
			self.velocity = -self.mangle;	// Reverse direction
			self.mangle = self.velocity;	// Update new direction
			sound (self, ad_CHAN_WEAPON, self.noise, 1, ad_ATTN_NORM);
			// Reset egg timer if still bouncing a lot
			if ( vlen(self.velocity) > 100 ) self.nextthink = time + ad_LIFE_EGG;
		}
	}
	else {
		//----------------------------------------------------------------------
		// Check for any func_breakables that can be triggered
		// Any monster firing a grenade at a breakable will explode without bounce
		// Check before damage_aim because only player/monster have that setting
		if (ad_ai_foundbreakable(self.owner, self.ad_activate, ad_TRUE)
			&& (self.owner.flags & ad_FL_MONSTER)) {
			// Found a breakable which is prone to explosive damage
			ad_trigger_ent(self.ad_activate, self.owner);
			ad_Explode_Grenade();
		}
		// Hit something that bleeds? (allows for grenade impact)
		else if (self.ad_activate.takedamage == ad_DAMAGE_AIM) {
			ad_Explode_Grenade(); 
		}
		else {
			// bounce sound and stop spinning
			sound (self, ad_CHAN_WEAPON, self.noise, 1, ad_ATTN_NORM);
			if (ad_CheckZeroVector(self.velocity)) self.avelocity = '0 0 0';
		}
	}
};

//----------------------------------------------------------------------
// Re-direct all the map hacks to the new function
void() ad_maphack_grenade = {
	self.ad_classtype = ad_CT_PROJ_GLMON;
	self.ad_classgroup = ad_CG_PROJGRENADES;
	if (!self.height) self.height = ad_EXPLODE_SMALL;
	ad_Explode_Grenade();
};

// These are the usual suspects for map hacks
void() ad_OgreGrenadeExplode = { ad_maphack_grenade(); };
void() ad_GrenadeExplode = { ad_maphack_grenade(); };
void() ad_GrenadeTouch = { ad_maphack_grenade(); };

// Compile forward functions for Launch_Grenade
void() ad_Touch_ShellCasing;

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir, vector ad_avel, float ad_proj_type) ad_Launch_Grenade =
{
	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_org)) return;
	
	ad_newmis = spawn ();
	ad_newmis.owner = self;
	ad_newmis.classname = "proj_grenade";	// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_proj_type;		// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJGRENADES;// Ammo type
	ad_newmis.movetype = ad_MOVETYPE_BOUNCE;

	//----------------------------------------------------------------------
	ad_newmis.solid = ad_SOLID_BBOX;
	ad_newmis.touch = ad_Touch_Grenade;
	ad_newmis.nextthink = time + ad_LIFE_GRENADE;
	ad_newmis.think = ad_Explode_Grenade;
	ad_newmis.noise = "weapons/bounce.wav";
	ad_newmis.ad_bbmins = ad_newmis.ad_bbmaxs = ad_VEC_ORIGIN;
	ad_newmis.height = ad_EXPLODE_SMALL;
	ad_newmis.ad_poisonous = ad_newmis.owner.ad_poisonous;

	// Setup model for each missile type
	//----------------------------------------------------------------------
	// proj_gl is used by the player (separate so easier to change)
	if (ad_proj_type == ad_CT_PROJ_GL) setmodel(ad_newmis, ad_MODEL_PROJ_GRENADE);
	// proj_glmon is used by any monster firing grenades
	else if (ad_proj_type == ad_CT_PROJ_GLMON) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_GRENADEGRN);
		else setmodel(ad_newmis, ad_MODEL_PROJ_GRENADE);
	}
	else if (ad_proj_type == ad_CT_PROJ_FLESH) {
		if (ad_newmis.ad_poisonous) setmodel(ad_newmis, ad_MODEL_PROJ_FLESHP);
		else setmodel (ad_newmis, ad_MODEL_PROJ_FLESH);
	}
	else if (ad_proj_type == ad_CT_PROJ_MEGG) {
		if (self.ad_classtype == ad_CT_MONWRAITH) {
			setmodel( ad_newmis, ad_MODEL_PROJ_WEGG);
			ad_newmis.noise = "wraith/bounce.wav";
		}
		else if (self.ad_classtype == ad_CT_MONSHAL) {
			setmodel( ad_newmis, ad_MODEL_PROJ_SEGG);
			ad_newmis.noise = "shalrath/bounce.wav";
		}
		ad_newmis.ad_classgroup = ad_CG_MINIONEGG;		// Proper group type
		ad_newmis.enemy = ad_SUB_entEnemyTarget();	// Make sure got right enemy
		ad_newmis.ad_bbmins = ad_VEC_HULLE_MIN;			// Small egg size
		ad_newmis.ad_bbmaxs = ad_VEC_HULLE_MAX;
		ad_newmis.frame = self.ad_attachment.frame;	// Current ball size (frame)
		ad_newmis.think = ad_Hatch_Egg;				// Eventually hatch
		ad_newmis.nextthink = time + ad_LIFE_EGG;		// Short timer
	}
	else if (ad_proj_type == ad_CT_PROJ_SPID) {
		setmodel (ad_newmis, ad_MODEL_PROJ_SPID);
		ad_newmis.frame = rint((random() * 9));
	}
	else if (ad_proj_type == ad_CT_PROJ_ELF) {
		setmodel (ad_newmis, ad_MODEL_PROJ_ELF);
		ad_newmis.frame = rint((random() * 9));
	}
	else if (ad_proj_type == ad_CT_PROJ_SWAMP) {
		setmodel (ad_newmis, ad_MODEL_PROJ_SWAMP);
		ad_newmis.frame = rint((random() * 9));
	}
	else if (ad_proj_type == ad_CT_PROJ_VORE) {
		setmodel (ad_newmis, ad_MODEL_PROJ_VORE);
		ad_newmis.frame = rint((4 + random() * 4));
	}
	else if (ad_proj_type == ad_CT_PROJ_NOUR2) {
		setmodel (ad_newmis, ad_MODEL_PROJ_NOUR2B);
		ad_newmis.skin = self.skin;
		ad_newmis.frame = 7; // Large size
		ad_newmis.noise = "nour/bounce.wav";
	}
	else if (ad_proj_type == ad_CT_PROJ_CHTHON2) {
		setmodel (ad_newmis, ad_MODEL_PROJ_CHTHON1);
		ad_newmis.skin = self.skin;
		ad_newmis.frame = rint((random() * 9));
		ad_newmis.noise = "chthon/bounce.wav";
		ad_newmis.dmg = self.ad_pos3_z;
	}
	else if (ad_proj_type == ad_CT_PROJ_SHUB2) {
		setmodel (ad_newmis, ad_MODEL_PROJ_SHUB2);
		ad_newmis.frame = rint((random() * 9));
		ad_newmis.noise = "shub/bounce.wav";
		ad_newmis.dmg = self.ad_pos3_z;
	}
	else if (ad_proj_type == ad_CT_PROJ_SHELLC) {
		setmodel(ad_newmis, ad_MODEL_PROJ_SHELLC);
		ad_newmis.touch = ad_Touch_ShellCasing;
		ad_newmis.think = ad_model_fade;
		ad_newmis.nextthink = time + random() + ad_LIFE_SHELLS;
		ad_newmis.ltime = ad_newmis.nextthink;
	}
	
	// These projectile fly like grenades but are really spikes!
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_PROJ_SPID || ad_proj_type == ad_CT_PROJ_VORE ||
		ad_proj_type == ad_CT_PROJ_SWAMP || ad_proj_type == ad_CT_PROJ_ELF ||
		ad_proj_type == ad_CT_PROJ_FLESH) {
		ad_newmis.touch = ad_Touch_Projectile;
		ad_newmis.nextthink = time + ad_LIFE_PROJECTILE;
		ad_newmis.think = ad_SUB_Remove;
		ad_newmis.ad_bodyfadeaway = ad_TRUE;
	}
	
	// Standard projectile setup (origin, size and velocity)
	//----------------------------------------------------------------------
	ad_newmis.mangle = ad_dir;	// Save for later
	ad_newmis.velocity = ad_newmis.mangle;
	ad_newmis.avelocity = ad_avel;
	ad_newmis.angles = vectoangles(ad_newmis.velocity);
	setsize (ad_newmis, ad_newmis.ad_bbmins, ad_newmis.ad_bbmaxs);
	setorigin (ad_newmis, ad_org);
};

//======================================================================
// Generic functions for firing grenades from monsters
// MonsterGrenadeSound = play generic load grenade sound
// MonsterGrenadeSpeed = return generic attack speed
// MonsterFireGrenade = fire grenade at enemy origin
//
//----------------------------------------------------------------------
void() ad_MonsterGrenadeSound =
{ sound (self, ad_CHAN_WEAPON, "weapons/gl_loadshort.wav", 0.1+random()*0.5, ad_ATTN_LOW); };
float() ad_MonsterGrenadeSpeed =
{ return ad_SPEED_MONGRENADE + (ad_skill * ad_SPEED_MONGLSKILL); };

//----------------------------------------------------------------------
void(vector ad_grenade_org, vector ad_grenade_enemyorg) ad_MonsterFireGrenade =
{
	local vector ad_ang, ad_dir, ad_avel;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "weapons/grenade.wav", 1, ad_ATTN_NORM);

	// Is Z aware disabled?
	if ( ad_query_configflag(ad_SVR_ZAWARE) || self.ad_no_zaware ) {
		makevectors (self.angles);
		ad_dir = normalize(ad_grenade_enemyorg - ad_grenade_org);
		// Default grenade speed (player = 600)
		ad_dir = ad_dir * ad_SPEED_PLAYGRENADE;
		ad_dir_z = ad_ELEV_ZAXIS;
	}
	else {
		// Z Aware tracking is ENABLED (AI track player much better)
		// One final angle adjustment (based on actual projectile origin)
		self.ad_attack_speed = ad_MonsterGrenadeSpeed();
		self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, ad_grenade_org, ad_grenade_enemyorg, self.ad_attack_speed);
		ad_ang = vectoangles(ad_grenade_enemyorg - ad_grenade_org);
		ad_ang_x = -self.ad_attack_elev;
		makevectors (ad_ang);
 		ad_dir = v_forward * self.ad_attack_speed;
	}

	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_grenade_org, ad_dir, ad_avel, ad_CT_PROJ_GLMON);
};

/*======================================================================
 Ejecting Shell Casing for SG/SSG/Upgrade
======================================================================*/
void() ad_Touch_ShellCasing =
{
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other == self.owner) return;			// Touching self, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing

	self.touch = ad_SUB_Null;
	if (random() < 0.5)  
		sound(self, ad_CHAN_VOICE, "weapons/shellc.wav", random()*0.25, ad_ATTN_LOW);		
};

//----------------------------------------------------------------------
void(float ad_shell_qty) ad_Launch_ShellCasing =
{
	local vector ad_org, ad_dir, ad_avel;
	
	if ( self.health < 1 ) return;
	if (ad_query_configflag(ad_SVR_SHOTGCASE)) return;

	if (self.flags & ad_FL_CLIENT) makevectors (self.v_angle);
	else makevectors (self.angles);
	ad_org = self.origin + v_up*10;
	
	while (ad_shell_qty > 0) {
		ad_dir = -v_right*75 + v_forward*(random()*50) + v_up*(100 + random()*100);
		ad_avel = ad_vecrand(0,300,ad_TRUE);
		ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_SHELLC);
		ad_shell_qty = ad_shell_qty - 1;
	}
};
