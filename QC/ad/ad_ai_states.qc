// AD's readme and docs/vr-port/CREDITS.md), my_progs/ai_states.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 Three basic types of behaviour is Quake, stand, walk and run
======================================================================*/

//----------------------------------------------------------------------
// ai_stand
//----------------------------------------------------------------------
void() ad_ai_stand =
{
	self.ad_lastorigin = self.origin;		// Save for cinematic interpolation
	if (self.health < 1) return;		// Health < 0, no more standing
	ad_monster_liquid_check();				// Check for liquid damage
	ad_check_tethertimer();				// Check for tethering system
	if (ad_FindTarget ()) return;			// Found a player?
	// Double check there is a goalentity, no pause and no turret
	if (self.goalentity && time > self.ad_pausetime && self.ad_movespeed >= 0) {
		// Make sure AI is turning towards new path corner direction
		self.ideal_yaw = vectoyaw(self.goalentity.origin - self.origin);
		ChangeYaw ();
		self.ad_th_walk ();
	}
	else {
		// Only test ground walking monsters (no fly/swim/static)
		// Check global map variable first (default = off)
		if (ad_map_bodyflrcheck == ad_TRUE && self.ad_classmove == ad_MON_MOVEWALK) 
			ad_ent_floorcheck(self, ad_FLOOR_TRACE_MONSTER);
	}
};

//----------------------------------------------------------------------
// ai_walk
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_walk =
{
	local vector ad_vertdiff;
	
	if (self.health < 1) return;		// Health < 0, no more walking
	// Turret monsters don't walk, they stand around
	if (self.ad_movespeed < 0) { self.ad_th_stand(); return; }
	ad_monster_liquid_check();				// Check for liquid damage
	ad_movedist = ad_dist;
	if (ad_FindTarget ()) return;			// Found a player?
	
	// Allow for flying units to move up/down between path corners
	if (self.ad_classmove == ad_MON_MOVEFLY) {
		// Allow for some Z axis tolerance
		if (fabs(self.origin_z - self.goalentity.origin_z) > ad_MON_ZTOL) {
			if (self.ad_move_elev == 0) self.ad_move_elev = ad_MON_ZMOVEMENT;
			if (self.origin_z < self.goalentity.origin_z) 
				self.origin_z = self.origin_z + self.ad_move_elev;
			else self.origin_z = self.origin_z - self.ad_move_elev;

			ad_vertdiff = '0 0 0';
			ad_vertdiff_x = fabs(self.goalentity.origin_x - self.origin_x);
			ad_vertdiff_y = fabs(self.goalentity.origin_y - self.origin_y);
			// Are the path corners stacked on top of each other?
			if (ad_vertdiff_x < ad_MON_ZTOL && ad_vertdiff_y < ad_MON_ZTOL) ad_dist = 0;
		}
	}
	
	// Move to goal (code function)
	ad_movetogoal (ad_dist);
};

//----------------------------------------------------------------------
// ai_run
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_run =
{
	if (self.health < 1) return;	// Health < 0, no more running
	ad_monster_liquid_check();			// Check for liquid damage
	ad_movedist = ad_dist;

	// Is the enemy dead or no longer taking damage?
	if (ad_SUB_healthEnemyTarget() < 1 || ad_SUB_takedEnemyTarget() == ad_DAMAGE_NO || self.ad_enemyexit) {
		// Reset any exit conditions
		self.ad_enemyexit = ad_FALSE;
		// Remove any enemy target entity tracking
		ad_SUB_switchEnemyTarget();
		// Reset enemy and target system
		self.enemy = self.goalentity = self.ad_movetarget = world;
			
		// Is the old enemy still alive and can it be damaged?
		if (self.ad_oldenemy.health > 0 && self.ad_oldenemy.takedamage > 0) {
			self.enemy = self.ad_oldenemy;
			ad_HuntTarget ();
		}
		else {
			// Was this a passive monster before combat?
			if (self.ad_passive_mode == ad_TRUE) {
				// Return to passive monster state (reset)
				self.ad_passive_state = ad_MON_PASSIVESTATE_RESET;
				ad_check_passivestate_system(self);
			}
			else {
				// Monster busy with something else?
				if (self.target != "") 
					self.ad_movetarget = find(world, targetname, self.target);
				// Check for path corners (patrols) and return to stand/walk
				if (self.ad_movetarget.ad_classtype == ad_CT_PATHCORNER) {
					self.goalentity = self.ad_movetarget;
					self.think = self.ad_th_walk;
				}
				else self.think = self.ad_th_stand;
			}
			// Exit run function
			return;
		}
	}
	
	// Wake up any monsters in visual range
	self.ad_show_hostile = time + 1;

	// check visibility of enemy
	ad_enemy_vis = ad_visible(ad_SUB_entEnemyTarget());
	if (ad_enemy_vis) {
		// Used to wake up other enemies
		self.ad_search_time = time + 5;
		// The last time the enemy was in sight
		self.ad_enemylastseen = time;
	}

	//----------------------------------------------------------------------
	// look for other coop players
	if (coop && self.ad_search_time < time) {
		if (ad_FindTarget ()) return;
	}

	// Calculate if goal/enemy is infront, the range and direction
	ad_enemy_infront = ad_infront(ad_SUB_entEnemyTarget());
	ad_enemy_range = ad_range(ad_SUB_entEnemyTarget());
	ad_enemy_yaw = vectoyaw(ad_SUB_orgEnemyTarget() - self.origin);
	self.ad_enemydist = ad_range_distance(ad_SUB_entEnemyTarget(), ad_FALSE);

	//----------------------------------------------------------------------
	// Check for temporary turret mode via trigger_monsterturret
	//----------------------------------------------------------------------
	if (self.ad_turretactive.ad_classtype == ad_CT_TRIGMONTURRET && ad_enemy_vis && self.ad_th_missile) {
		if (self.ad_turrettimer < time) {
			// Is there a chance to pause?
			if (random() < self.ad_turretactive.count) 
				self.ad_turrettimer = time + 1 + random()*2;

			self.ad_attack_state = ad_AS_TURRET;
			ad_ai_run_missile ();
			return;
		}
	}
	
	//----------------------------------------------------------------------
	// Check if tether system is active
	//----------------------------------------------------------------------
	if (ad_check_tethersystem() && self.health > 0) {
		self.ad_tetherlock = ad_TRUE;
		if (self.ad_th_tether) self.think = self.ad_th_tether;
		return;
	}

	//----------------------------------------------------------------------
	// Check for the passive state system (reset/timer etc)
	//----------------------------------------------------------------------
	if (ad_check_passivestate_system(self)) return;
	
	//----------------------------------------------------------------------
	// Check if blocked by breakables
	ad_CheckBlockedBreakable();
	
	//----------------------------------------------------------------------
	if (self.ad_attack_state == ad_AS_MISSILE) {
		ad_ai_run_missile (); return;
	}
	else if (self.ad_attack_state == ad_AS_JUMP) {
		ad_ai_run_jump (); return;
	}
	else if (self.ad_attack_state == ad_AS_MELEE) {
		ad_ai_run_melee (); return;
	}
	//----------------------------------------------------------------------
	// This has to go after range/melee attack state checks
	// otherwise the AI will not do anything
	// These checks are for the next frame, not this one
	// Exception : wizards need to strafe quickly
	//----------------------------------------------------------------------
	// Some monsters don't have distance checks, like wizards
	// All monsters have checkattack defined, no need for ifs and buts!
	if (self.ad_enemymaxdist || self.ad_enemydist < ad_MON_MAX_RANGE) 
		self.ad_th_checkattack ();

	//----------------------------------------------------------------------
	if (self.ad_attack_state == ad_AS_SLIDING) {
		ad_ai_run_slide (ad_dist); return;
	}
	else if (self.ad_attack_state == ad_AS_SIDESTEP) {
		ad_ai_run_sidestep (ad_dist); return;
	}
	else if (self.ad_attack_state == ad_AS_BACKWARD) {
		ad_ai_run_backward (ad_dist); return;
	}

	// head straight towards the enemy
	// unless of course I am a turret!
	ad_movetogoal (ad_dist);
};
