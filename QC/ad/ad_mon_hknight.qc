//===========================================================================
void() ad_CheckForCharge =
{
	// There are 4 conditions to keep charging
	// Can see player, no attack timer, similar Z axis and outside melee range
	// Nightmare skill level can lock HK in constant charging (no attack timer)
	ad_enemy_vis = ad_visible(self.enemy);
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	if (self.ad_movespeed < 0) return;
	if (self.ad_tetherlock) return;
	// Only charge at player if ground height < 20
	if ( fabs(self.origin_z - self.enemy.origin_z) > ad_MONAI_CHARGEZAXIS) return;
	if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) return;

	ad_SUB_AttackFinished (2);
	
	// Used a pre-defined charge routine (th_charge) so that
	// hell and death knights can share the same function
	if (self.ad_th_charge) self.ad_th_charge();
	else self.ad_th_run();
};

