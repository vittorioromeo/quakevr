//============================================================================
// Cycle between 3 melee attacks
// Attack 1 - Slice (one hand slashing run attack)
// Attack 2 - Smash (chop overhead to ground)
// Attack 3 - W_Attack (two handed slashing attack)

//----------------------------------------------------------------------
void() ad_hknight_melee =
{
	self.ad_meleeattack = self.ad_meleeattack + 1;

	if (self.ad_meleeattack == 1) ad_hknight_slice1 ();
	else if (self.ad_meleeattack == 2) ad_hknight_smash1 ();
	else {
		ad_hknight_watk1 ();
		self.ad_meleeattack = 0;
	}
};

//============================================================================
void(float ad_offset) ad_hknight_shot =
{
	local	vector	ad_offang;
	local	vector	ad_org, ad_dir;
	
	if (!self.enemy) return;
	if (self.health < 1) return;

	sound (self, ad_CHAN_WEAPON, "hknight/attack1.wav", 1, ad_ATTN_NORM);

	self.ad_attack_speed = ad_SPEED_HKSPIKE + ( ad_skill * ad_SPEED_HKSKILL);
	ad_offang = vectoangles (self.enemy.origin - self.origin);
	ad_offang_y = ad_offang_y + ad_offset * 6;
	makevectors (ad_offang);

	ad_org = self.origin + self.mins + self.size*0.5 + v_forward * 20;
	ad_dir = normalize (v_forward);
	ad_dir_z = 0 - ad_dir_z + (random() - 0.5)*0.1;
	
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_HKN, self.ad_attack_speed);
};
