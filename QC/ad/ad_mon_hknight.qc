// Never used, only called from hknight_char_b
//----------------------------------------------------------------------
void() ad_CheckContinueCharge =
{
	if (time > self.ad_attack_finished) {
		ad_SUB_AttackFinished (3);
		self.ad_th_run();
		return;		// done charging
	}
};

