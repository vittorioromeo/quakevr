void()	ad_hknight_magicc7 =[	$magicc7,	ad_hknight_magicc8	] {ad_hknight_shot(-1);};
void()	ad_hknight_magicc8 =[	$magicc8,	ad_hknight_magicc9	] {ad_hknight_shot(0);};
void()	ad_hknight_magicc9 =[	$magicc9,	ad_hknight_magicc10] {ad_hknight_shot(1);};
void()	ad_hknight_magicc10 =[	$magicc10,	ad_hknight_magicc11] {ad_hknight_shot(2);};
void()	ad_hknight_magicc11 =[	$magicc11,	ad_hknight_run1] {ad_hknight_shot(3);};

//============================================================================
// Special setup - Hell Knight firing electricity at target
//----------------------------------------------------------------------
void() ad_hknight_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.mdl = self.ad_weaponglow;
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
	}
};

//----------------------------------------------------------------------
void() ad_hknight_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
}

//----------------------------------------------------------------------
void() ad_hknight_pointfire =
{
	local vector ad_hkp_start, ad_hkp_rand, ad_hkp_end;
	
	// Make sure the knight is alive
	if (self.health < 1) return;

	// Time for a new LG hit sound?
	if (self.t_width < time) {
		// Lower volume and attenuation just in case of several together
		sound (self, ad_CHAN_WEAPON, "weapons/lhit.wav", 0.75, ad_ATTN_IDLE);
		self.t_width = time + 0.6;
	}

	// Update animation frames (default = MagicB6-11)
	self.frame = self.frame + self.ad_pos3_z;
	if (self.frame < self.ad_pos3_x) self.frame = self.ad_pos3_y;
	if (self.frame > self.ad_pos3_y) self.frame = self.ad_pos3_x;
	
	// Turn the Knight towards lightning target
	self.ideal_yaw = vectoyaw(self.ad_movetarget.origin - self.origin);
	ChangeYaw ();
	// Work out start point of lightning bolt
	makevectors(self.angles);
	
	// Work out starting point for lightning on sword
	ad_hkp_start = v_forward*self.pos1_x + v_right*self.pos1_y + v_up*self.pos1_z;
	ad_hkp_rand = v_forward * (self.pos2_x * random());
	ad_hkp_rand = ad_hkp_rand + v_right * (self.pos2_y * random());
	ad_hkp_rand = ad_hkp_rand + v_up * (self.pos2_z * random());
	ad_hkp_start = ad_hkp_start + self.origin + ad_hkp_rand;
	
	// Check for any random target origin variance
	if (self.t_length > 0) {
		ad_hkp_end = ad_vecrand(0,self.t_length,1);
		ad_hkp_end = ad_hkp_end + self.ad_movetarget.origin;
	}
	// Default (0) = exact target position
	else ad_hkp_end = self.ad_movetarget.origin;

	// Update sword with lightning visuals
	if (self.ad_attachment) {
		setorigin(self.ad_attachment, self.origin);
		self.ad_attachment.frame = self.frame;
		self.ad_attachment.angles = self.angles;
		// Allow for no sword effect by going over max and reset
		self.ad_attachment.alpha = self.ad_attachment.alpha + random();
		if (self.ad_attachment.alpha > 1) self.ad_attachment.alpha = 0.01;
		// The four skins are randomly setup already
		self.lip = self.ad_attachment.skin + 1;
		if (self.lip > 3) self.lip = 0;
		self.ad_attachment.skin = self.lip;
		// Draw paticles on sword where lightning starts
		ad_particle_explode(ad_hkp_start, 2, 1, ad_PARTICLE_BURST_BLUE, ad_PARTICLE_BURST_LOSTUP);
	}
	
	// Create lightning bolt
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
	WriteEntity (ad_MSG_BROADCAST, self); WriteByte (ad_MSG_BROADCAST, 0);
	WriteCoord (ad_MSG_BROADCAST, ad_hkp_start_x);
	WriteCoord (ad_MSG_BROADCAST, ad_hkp_start_y);
	WriteCoord (ad_MSG_BROADCAST, ad_hkp_start_z);
	WriteCoord (ad_MSG_BROADCAST, ad_hkp_end_x);
	WriteCoord (ad_MSG_BROADCAST, ad_hkp_end_y);
	WriteCoord (ad_MSG_BROADCAST, ad_hkp_end_z);

	// Can the lightning damage things?
	if (self.dmg > 0) 
		ad_LightningDamage (ad_hkp_start, ad_hkp_end, self, self.dmg);
	
	// Keep Looping
	self.think = self.ad_th_run;
	self.nextthink = time + 0.1;
	
};

//----------------------------------------------------------------------
void() ad_hknight_pointsetup = 
{
	// Find Lightning bolt target
	self.ad_movetarget = find(world, targetname, self.target);
	if (!self.ad_movetarget) {
		dprint("\b[HKNIGHT]\b Pointing knight invalid target!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	// Start pointing lightning sword!
	else {
		// Save pain threshold and timeout for later
		self.ad_finaldest_x = self.ad_pain_flinch;
		self.ad_finaldest_y = self.ad_pain_timeout;
		// Reset all pain parameters so it always happens
		self.ad_pain_flinch = self.ad_pain_timeout = 0;
		self.ad_pain_finished = self.ad_pain_ignore = 0;
		self.ad_infightextra = self.ad_noinfighting = 0;
		// Stop other monsters attacking pointy knights
		self.flags = self.flags - (self.flags & ad_FL_MONSTER);
		self.enemy = world;
		// Create glowing sword and start pointing
		ad_hknight_create_attachment();
		self.ad_th_run();
	}
};

//============================================================================
void()	ad_hknight_pain1	=[	$pain1,		ad_hknight_pain2	] {};
void()	ad_hknight_pain2	=[	$pain2,		ad_hknight_pain3	] {};
void()	ad_hknight_pain3	=[	$pain3,		ad_hknight_pain4	] {};
void()	ad_hknight_pain4	=[	$pain4,		ad_hknight_pain5	] {};
void()	ad_hknight_pain5	=[	$pain5,		ad_hknight_run1	] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_hknight_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_hknight_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.5;
			self.ad_axhitme = 0;
			ad_hknight_pain1 ();
		}
	}
};

//============================================================================
void()	ad_hknight_die1	=[	$death1,	ad_hknight_die2	] {ad_ai_forward(10);};
void()	ad_hknight_die2	=[	$death2,	ad_hknight_die3	] {ad_monster_check_gib();ad_ai_forward(8);};
void()	ad_hknight_die3	=[	$death3,	ad_hknight_die4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT; ad_ai_forward(7);};
void()	ad_hknight_die4	=[	$death4,	ad_hknight_die5	] {};
void()	ad_hknight_die5	=[	$death5,	ad_hknight_die6	] {};
void()	ad_hknight_die6	=[	$death6,	ad_hknight_die7	] {};
void()	ad_hknight_die7	=[	$death7,	ad_hknight_die8	] {};
void()	ad_hknight_die8	=[	$death8,	ad_hknight_die9	] {ad_ai_forward(10);};
void()	ad_hknight_die9	=[	$death9,	ad_hknight_die10	] {ad_ai_forward(11);};
void()	ad_hknight_die10	=[	$death10,	ad_hknight_die11	] {};
void()	ad_hknight_die11	=[	$death11,	ad_hknight_die12	] {ad_monster_death_postcheck();};
void()	ad_hknight_die12	=[	$death12,	ad_hknight_die12	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void()	ad_hknight_dieb1	=[	$deathb1,	ad_hknight_dieb2	] {};
void()	ad_hknight_dieb2	=[	$deathb2,	ad_hknight_dieb3	] {ad_monster_check_gib();};
void()	ad_hknight_dieb3	=[	$deathb3,	ad_hknight_dieb4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void()	ad_hknight_dieb4	=[	$deathb4,	ad_hknight_dieb5	] {};
void()	ad_hknight_dieb5	=[	$deathb5,	ad_hknight_dieb6	] {};
void()	ad_hknight_dieb6	=[	$deathb6,	ad_hknight_dieb7	] {};
void()	ad_hknight_dieb7	=[	$deathb7,	ad_hknight_dieb8	] {};
void()	ad_hknight_dieb8	=[	$deathb8,	ad_hknight_dieb9	] {ad_monster_death_postcheck();};
void()	ad_hknight_dieb9	=[	$deathb9,	ad_hknight_dieb9	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_hknight_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	// Make sure attachments are removed
	ad_hknight_remove_attachment();
	
	// regular death
	if (!self.ad_gibbed) {
	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_hknight_die1 ();	// Forward - standard
		else ad_hknight_dieb1 ();					// Backward - standard
	}
};

//============================================================================
void() ad_hknight_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

//============================================================================
// Used by stone knights to wakup and attack the player
//----------------------------------------------------------------------
void() ad_hknight_aistates =
{
	self.ad_th_stand = ad_hknight_stand1;		// Idling on feet
	self.ad_th_walk = ad_hknight_walk1;		// Walking
	self.ad_th_run = ad_hknight_run1;			// Running
	self.ad_th_melee = ad_hknight_melee;		// Sword attack
	self.ad_th_missile = ad_hknight_magicc1;	// Fire spikes
	self.ad_th_charge = ad_hknight_char_a1;	// Run + melee
	self.ad_th_pain = ad_hknight_pain;		// Stumble and pain
	self.ad_th_die = ad_hknight_die;			// Face meets floor
};

//----------------------------------------------------------------------
void() ad_hknight_wakeup =
{
	if (self.health < 0) return;		// Check for sudden death!
	
	self.use = ad_SUB_Null;				// no re-trigger
	self.takedamage = ad_DAMAGE_AIM;		// Can receive damage
	self.ad_spawnstatue = ad_FALSE;			// No longer stationary

	ad_hknight_aistates();					// Restore AI state functions
	ad_monster_targets();					// Check for targets
};

//----------------------------------------------------------------------
// Restore pointy lightning knights to normal hell knights
//----------------------------------------------------------------------
void() ad_hknight_pointwakeup =
{
	// Check for sudden death!
	if (self.health < 0) return;
	// Always reset health+max back to default
	self.health = self.max_health = self.ad_reset_health;
	// Fire any trigger event when breaking pointy pose
	if (self.ad_target2 != "") {
		ad_trigger_strs(self.ad_target2, self.enemy);
		self.ad_target2 = "";		// Trigger once
	}

	// Restore pain threshold and timeout
	self.ad_pain_flinch = self.ad_finaldest_x;
	self.ad_pain_timeout = self.ad_finaldest_y;
	self.ad_pain_finished = time + 2;
	self.flags = self.flags | ad_FL_MONSTER;

	// Restore the nail resistance if setup to be a statue skin
	if (self.spawnflags & ad_MON_STATUE) self.ad_resist_nails = 0.2;
	
	ad_hknight_remove_attachment();		// Remove glowing sword
	ad_hknight_aistates();					// Restore AI state functions
	// Check for any enemy target?
	if (self.enemy) {
		ad_monster_sightsound();			// Sword sounds!
		ad_FoundHuntTarget(ad_TRUE);			// Setup goals and targets
		self.think = self.ad_th_run;		// Move to running
	}
	else self.think = self.ad_th_stand;	// Stand around
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// Special pain function for pointy lightning knights
//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_hknight_pointpain =
{
	self.ad_pain_finished = 0;
	if (!(ad_attacker.flags & ad_FL_CLIENT)) return;
	self.enemy = ad_attacker;
	ad_hknight_pointwakeup();
};

//----------------------------------------------------------------------
// Special use/trigger function for pointy lightning knights
//----------------------------------------------------------------------
void() ad_hknight_pointuse = 
{
	// Check for enemy/health/player exceptions
	if (self.enemy) return;
	if (self.health < 1) return;
	if (ad_activator.items & ad_IT_INVISIBILITY) return;
	if (ad_activator.flags & ad_FL_NOTARGET) return;

	// Trigger once
	self.use = ad_SUB_Null;
	// Is the trigger the player?
	if (ad_activator.flags & ad_FL_CLIENT) self.enemy = ad_activator;
	else self.enemy = world;
	ad_hknight_pointwakeup();
};

/*======================================================================
 QUAKED monster_hell_knight (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_hell_knight =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_hknight.mdl";			// Original ID Knight + extra skins
	self.ad_headmdl = "progs/h_hellkn.mdl";
	self.ad_gib1mdl = "progs/w_hknightsword.mdl";	// Unique sword
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";	// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";	// right foot
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_HKN);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib2mdl = ad_string_null;
	if (random() < 0.5) self.ad_gib3mdl = ad_string_null;

	// Firing of magic spikes (first 0.1s must loop)
	precache_sound ("hknight/attack1.wav");

	// TE_KNIGHTSPIKE = Magic spike hitting the wall
	// Has got to be in this location because the 
	// filename is hardcoded (engine.exe)
	precache_sound ("hknight/hit.wav");				

	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_STATUE) {
		self.ad_idle_sound = "statue/idle1.wav";
		self.ad_idle_sound2 = "statue/idle2.wav";
		self.ad_idle_soundcom = "statue/comidle.wav";
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);
		precache_sound (self.ad_idle_soundcom);

		self.ad_sight_sound = "statue/sight.wav";
		self.ad_pain_sound = "statue/hurt.wav";
		self.ad_death_sound = "statue/death.wav";
		self.ad_gib1skin = 1;					// Stoney sword
		ad_precache_stonegibs();				// Cache gib models
		self.ad_gibtype = ad_GIBTYPE_STONE;		// Stoney gibs!
		self.ad_gib2mdl = self.ad_gib3mdl = ad_string_null;
	}
	else {
		self.ad_idle_sound = "hknight/idle.wav";
		precache_sound (self.ad_idle_sound);

		self.ad_sight_sound = "hknight/sight1.wav";
		self.ad_pain_sound = "hknight/pain1.wav";
		self.ad_death_sound = "hknight/death1.wav";

		// Check for poisonous entity flag
		if (self.ad_poisonous) {
			ad_precache_poisongibs();			// precache gibs
			self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
			precache_model (ad_MODEL_PROJ_HKNGRN);
		}
	}
	// precache sight, pain and death (changes on type)
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_death_sound);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");
	
	self.solid = ad_SOLID_NOT;					// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;			// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = ad_HP_MONHELLK;
	self.ad_gibhealth = -40;					// Not easy to gib
	self.ad_gibbed = ad_FALSE;					// Still in one piece
	self.ad_pain_flinch = 40;					// Medium pain threshold
	self.ad_pain_timeout = 1.5;				// Higher than a knight
	self.ad_steptype = ad_FS_TYPEHEAVY;			// Heavy player
	self.ad_meleeattack = rint(random()*3);	// randomize last melee attack
	self.ad_th_die = ad_hknight_die;				// Face meets floor
	self.ad_deathstring = " was slain by a Hell Knight\n";
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	//----------------------------------------------------------------------
	// Special lightning point knight (metal/stone skins)
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_POINT_KNIGHT) {
		self.ad_weaponglow = "progs/mon_hknight_glow.mdl";
		precache_model (self.ad_weaponglow);	// Glowing magical swords
		if (self.spawnflags & ad_MON_STATUE) {
			self.ad_classgroup = ad_CG_STONE;		// Stone hates metal!
			self.skin = self.ad_exactskin = 1;	// Stone skin
			self.ad_pain_flinch = 60;			// Higher resistance
			self.ad_pain_longanim = ad_FALSE;		// resistant to shadow axe
			self.ad_pain_timeout = 2;			// high pain threshold
			self.ad_no_liquiddmg = ad_TRUE;		// Immune to slime/lava
		}
		self.ad_th_stand = ad_hknight_pointsetup;	// Find target before shoot
		self.ad_th_run = ad_hknight_pointfire;	// Keep Looping
		self.ad_th_pain = ad_hknight_pointpain;	// Release from pointing
		self.ad_think1 = ad_hknight_pointuse;		// Special trigger event
		self.ad_reset_health = self.health;	// Save for later
		self.health = ad_MEGADEATH;			// Should be impossible to kill
		if (self.t_length < 0) self.t_length = 5;	// Random target factor
		if (self.dmg < 0) self.dmg = 5;				// Contact damage
		
		// Setup default pose start pos + random modifier
		if (ad_CheckZeroVector(self.pos1)) self.pos1 = '20 0 24';
		if (ad_CheckZeroVector(self.pos2)) self.pos2 = '30 0 2';
		// Setup default animation pose (magicB6 - magicB11)
		if (ad_CheckZeroVector(self.ad_pos3)) self.ad_pos3 = '98 103 1';
	}
	//----------------------------------------------------------------------
	// Detect statues and setup different parameters
	// Tougher skin, less pain, heavy feet etc	
	//----------------------------------------------------------------------
	else if (self.spawnflags & ad_MON_STATUE) {
		self.ad_classgroup = ad_CG_STONE;		// Stone hates metal!
		self.ad_poisonous = ad_FALSE;			// Cannot be poisonous and stone!
		self.ad_resist_nails = 0.5;		// Tough skin for nails
		self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
		self.skin = self.ad_exactskin = 1;	// Stone skin
		self.ad_pain_flinch = 60;			// Higher resistance
		self.ad_pain_longanim = ad_FALSE;		// resistant to shadow axe
		self.ad_pain_timeout = 2;			// high pain threshold
		self.ad_no_liquiddmg = ad_TRUE;		// Immune to slime/lava
		self.ad_deathstring = " was smashed by a Stone Hell Knight\n";

		// Allow knights to start with a stone skin, but not be frozen!
		if (self.spawnflags & ad_MON_NOTFROZEN) {
			self.spawnflags = self.spawnflags - ad_MON_STATUE;
			ad_hknight_aistates();			// setup AI state functions
		}
		else {
			self.ad_spawnstatue = ad_TRUE;		// Start as a statue
			self.ad_th_stand = ad_knight_statue;	// Stone idle sound
			self.ad_think1 = ad_hknight_wakeup;	// Wakeup function when triggered
			
			// statues can change position when the player is not looking
			// Specify a start/finish frame using pos1 or use frame
			if (!self.pos1_x) {
				self.pos1_x = $w_attack1;		// Default pose (attacking)
				self.pos1_y = $w_attack15;
			}
			// A frame has been specified, create a small range from that
			if (self.frame > 0) {
				self.pos1_x = self.pos1_y = self.frame;
			}
			// Work out range, make sure no negative values
			self.pos1_z = fabs(self.pos1_y - self.pos1_x);
			self.frame = self.pos1_x;		// Setup frame / pose
		}
	}
	else {
		// Default Hell knight (like a death knight really)
		self.ad_pain_longanim = ad_TRUE;		// can be chopped with shadow axe
		self.ad_classgroup = ad_CG_DKNIGHT;	// Classic tincan!
		ad_hknight_aistates();				// setup AI state functions
	}
	
	self.ad_classtype = ad_CT_MONHELLK;
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();
};

//======================================================================
/*ad:QUAKED monster_hell_pointknight (0.75 0.5 0) (-16 -16 -24) (16 16 40) AMBUSH STATUE x NOSIGHT NOIDLE NOGFX STARTOFF x Not_Easy Not_Normal Not_Hard Not_DM
{ model(":progs/mon_hknight.mdl"); }
Special Electricity Pointing Hell Knight
-------- KEYS --------
targetname : monster/trigger name
target : target for electricity
target2 : trigger to fire when electricity stopped
pos1 : XYZ offset to start lightning (uses v_forward/v_right/v_up)
pos2 : XYZ random offset to start lightning (uses v_forward/v_right/v_up)
pos3 : Animation lightning frame set (Start/Finish/Direction)
t_length : random wobble to electricity target origin (0=def 5)
dmg : amount of contact damage with electricity (0=def 5)
deathtarget : entity to trigger upon death (useful if target field already in use)
health : Override default health settings
upgrade_ssg : 1 = will only spawn if shotgun upgrade active on server
upgrade_axe : 1 = will only spawn if axe upgrade active on server
upgrade_lg : 1 = will only spawn if lightning gun upgrade active on server
nomonstercount : will not be included in any monster count functionality
no_zaware : All Z Aware projectiles will be disabled
bboxtype : Change bbox 1=Tiny,4=Short,5=Tall,7=Wide,8=Giant,10=Massive
gibondeath : 1 = always explode in a shower of gibs on death
bodyfadeaway : Time (secs) before body/head will fade away (default=0)
-------- SPAWNFLAGS --------
AMBUSH : the monster will only wake up on seeing the player, not by another monster
STATUE : Stone statue skin
NOSIGHT : No sight sound
NOIDLE : No idle sound
NOGFX : No spawn effect or sound when triggered
STARTOFF : Trigger Spawn
-------- NOTES --------
Special Electricity Pointing Hell Knight*/
//======================================================================
void() ad_monster_hell_pointknight =
{
	// Setup with new special spawnflag (not mapper controlled)
	self.spawnflags = self.spawnflags | ad_MON_POINT_KNIGHT;
	// remove notfrozen and angry, always start/spawn firing lightning
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_NOTFROZEN);
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_SPAWN_ANGRY);
	
	// Override early to prevent unnecesaary cache of assets
	self.ad_poisonous = ad_FALSE;			// Never poisonous
	
	// If not target setup then stop!
	if (self.target == "") {
		dprint("\b[HKNIGHT]\b Pointing knight needs target!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	// Loop back through existing hell knight function
	else ad_monster_hell_knight();
};