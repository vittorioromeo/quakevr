QUAKED monster_gaunt (1 0.2 0) (-16 -16 -24) (16 16 24)
======================================================================*/
void() ad_setup_gaunt;
void() ad_monster_gaunt =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_gaunt.mdl";
	self.ad_headmdl = "progs/h_gaunt.mdl";
	self.ad_weaponglow = "progs/mon_gaunt_elec.mdl";

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_weaponglow);		// Lightning effect (2 colour)
	precache_model (ad_MODEL_PROJ_GAPLASMA);	// Plasma spike/bolt

	self.ad_idle_sound = "gaunt/idle1.wav";
	self.ad_idle_sound2 = "gaunt/idle3.wav";
	self.ad_idle_soundcom = "gaunt/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);

	precache_sound ("gaunt/wings1.wav");
	precache_sound ("gaunt/plasma_start.wav");
	precache_sound ("gaunt/plasma_fire.wav");
	
	self.ad_pain_sound = "gaunt/pain.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "gaunt/death.wav";
	precache_sound (self.ad_death_sound);

	self.ad_sight_sound = "gaunt/sight.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_GAPLASMAGRN);
	}
	
	// Cache gaunt is a special class used for precache only
	if (self.ad_classtype != ad_CT_CACHEGAUNT) ad_setup_gaunt();
};

//----------------------------------------------------------------------------
void() ad_monster_judgeminion = { 
	self.ad_classtype = ad_CT_CACHEGAUNT; 
	self.ad_poisonous = ad_TRUE;	// Cache poison stuff (just in case)
	ad_monster_gaunt();
};

//----------------------------------------------------------------------------
void() ad_setup_gaunt =
{
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 120;
	self.ad_gibhealth = -70;				// Need a powerful weapon to GIB
	self.ad_gibbed = ad_FALSE;				// no falling apart
	self.ad_pain_flinch = 70;				// High pain threshold
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	self.ad_attack_offset = '8 0 -4';		// Plasma start location
	self.ad_deathstring = " was blasted by a Gaunt\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_GauntCheckAttack;
	self.ad_th_pain = ad_gaunt_pain; 
	self.ad_th_die = ad_gaunt_die;
	
	//----------------------------------------------------------------------
	// Perched Gaunt have special idle animation + idle sounds
	if (self.spawnflags & ad_MON_GAUNT_PERCH) {
		self.ad_th_stand = self.ad_th_walk = ad_gaunt_perch1;
		self.ad_th_run = self.ad_th_missile = ad_gaunt_wakeup;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_MINIONGAUNT) {
		self.ad_th_stand = self.ad_th_walk = ad_gaunt_minwake;
		self.ad_th_run = self.ad_th_missile = ad_gaunt_minwake;
	}
	//----------------------------------------------------------------------
	else {
		// Default gaunt setup
		self.ad_th_stand = ad_gaunt_idle1;
		self.ad_th_walk = ad_gaunt_walk1;
		self.ad_th_run = ad_gaunt_run1;
		self.ad_th_missile = ad_gaunt_fire1;
	}

	if(!self.ad_classtype) self.ad_classtype = ad_CT_MONGAUNT;
	if (!self.ad_classgroup) self.ad_classgroup = ad_CG_WIZARD;
	self.ad_classmove = ad_MON_MOVEFLY;

	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn gaunts (requires monster_judgeminion entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ, float ad_minion_sflag) ad_minion_gaunt =
{
	local entity ad_minion;

	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	ad_update_minioncount(self, 1);			// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_gaunt";		// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self;					// Spawner Parent Link
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_gibondeath = 1;					// Always gib on death
	ad_minion.ad_classtype = ad_CT_MINIONGAUNT;		// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.spawnflags = ad_minion_sflag;		// Spawnflags
	ad_minion.ad_classgroup = ad_CG_DCAPTAIN;		// Don't turn on master
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	// Check for poison gibs being cached first
	if (ad_gibpoison && self.ad_poisonous == ad_TRUE) {
		ad_minion.ad_poisonous = self.ad_poisonous;	// carry over from host spawner 
		ad_minion.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}

	ad_minion.mdl = "progs/mon_gaunt.mdl";
	ad_minion.ad_headmdl = "progs/h_gaunt.mdl";
	ad_minion.ad_weaponglow = "progs/mon_gaunt_elec.mdl";

	ad_minion.ad_idle_sound = "gaunt/idle1.wav";
	ad_minion.ad_idle_sound2 = "gaunt/idle2.wav";
	ad_minion.ad_idle_soundcom = "gaunt/idle2.wav";
	ad_minion.ad_sight_sound = "gaunt/sight.wav";
	ad_minion.ad_pain_sound = "gaunt/pain.wav";
	ad_minion.ad_death_sound = "gaunt/death.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_gaunt;
};

//----------------------------------------------------------------------
// Re-direct all Quoth requests to Gaunt!
void() ad_monster_polyp = { 
	if (self.health <= 0) self.health = 200;
	self.ad_poisonous = ad_TRUE;			// Green elec/projectile
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	ad_monster_gaunt();
}
