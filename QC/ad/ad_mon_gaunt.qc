void() 	ad_gaunt_painB3 =[ $painB3, ad_gaunt_painB4 ] {};
void() 	ad_gaunt_painB4 =[ $painB4, ad_gaunt_painB5 ] {};
void() 	ad_gaunt_painB5 =[ $painB5, ad_gaunt_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_gaunt_pain =
{
	// Check for perching gaunt, need special wakeup
	if (self.spawnflags & ad_MON_GARGOYLE_PERCH) ad_gaunt_wakeup();
	else {
		// Check all pain conditions and set up what to do next
		ad_monster_pain_check(ad_attacker, ad_damage);

		// make sure any electricity is hidden
		if (self.ad_attachment) ad_gaunt_finish_attachment();

		// Any pain animation/sound required?
		if (self.ad_pain_check > 0) {
			sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
			if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
				if (self.lip < 0.4) ad_gaunt_painB1();	// Long
				else ad_gaunt_painA1();				// Short
			}
		}
	}
};

