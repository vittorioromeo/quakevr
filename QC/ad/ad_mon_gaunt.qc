//============================================================================
// RANGE - Plasma from arc infront
//============================================================================
void() ad_gaunt_plasma =
{
	local vector ad_org, ad_dir;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "gaunt/plasma_fire.wav", 1, ad_ATTN_NORM);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = normalize(ad_SUB_orgEnemyTarget() - self.origin);
	self.ad_attack_speed = ad_SPEED_GAUNTBOLT + (ad_skill * ad_SPEED_GAUNTSKILL);

	ad_launch_plasma(ad_org, ad_dir, ad_CT_MONGAUNT, self.ad_attack_speed);
};

