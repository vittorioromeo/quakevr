	ad_FoundHuntTarget(ad_TRUE);			// Setup goals and warn other monsters
};

//----------------------------------------------------------------------
void() ad_gaunt_wakeup =
{
	// Dead already?
	if (self.health < 1) return;

	// No longer need perch spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_GAUNT_PERCH);
	self.ad_spawnstatue = ad_FALSE;		// No longer stationary

	self.takedamage = ad_DAMAGE_AIM;		// Can receive damage
	self.use = ad_SUB_Null;				// no re-trigger
	
	// Restore all think state functions
	self.ad_th_stand = ad_gaunt_idle1;
	self.ad_th_walk = ad_gaunt_walk1;
	self.ad_th_run = ad_gaunt_run1;
	self.ad_th_missile = ad_gaunt_fire1;

	// Allow gaunt to fly up, no more ground checks
	self.flags = self.flags | ad_FL_FLY;
	self.movetype = ad_MOVETYPE_STEP;
	self.ad_pain_finished = time + 1.5;		// No pain
	self.ad_attack_finished = 1.5 + random();	// No skill adjustment
	ad_gaunt_wakeup1();
};

//============================================================================
// Minion Wakeup
//============================================================================
void()	ad_gaunt_minwake =[ $hover1, ad_gaunt_run1 ] {
	// Is the gaunt stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		ad_monster_sightsound();
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);
		// Restore all think state functions
		self.ad_th_stand = ad_gaunt_idle1;
		self.ad_th_walk = ad_gaunt_walk1;
		self.ad_th_run = ad_gaunt_run1;
		self.ad_th_missile = ad_gaunt_fire1;
	}
};

