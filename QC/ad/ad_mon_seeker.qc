/*==============================================================================
Seeker (Heavily inspired by Hunter from RRP - ijed)
==============================================================================*/
// Slow moving run/walk animation
$frame run1 run2 run3 run4 run5 run6 run7 run8
$frame run9 run10 run11 run12 run13 run14 run15 run16 run17 run18 run19

// stationary fire range attack (Not used)
$frame fire1 fire2 fire3 fire4 fire5 fire6 fire7 fire8
$frame fire9 fire10 fire11 fire12 fire13 fire14 fire15 fire16
$frame fire17 fire18 fire19 fire20 fire21 fire22 fire23 fire24
$frame fire25 fire26 fire27 fire28 fire29 fire30

// right arm punch
$frame punch1 punch2 punch3 punch4 punch5 punch6 punch7 punch8
$frame punch9 punch10

// fall backwards and die
$frame death1 death2 death3 death4 death5 death6 death7 death8
$frame death9 death10 death11 death12

// Stationary classic idle
$frame stand1 stand2 stand3 stand4 stand5 stand6 stand7 stand8
$frame stand9 stand10 stand11 stand12 stand13 stand14 stand15 stand16
$frame stand17 stand18 stand19

// Run with LEFT arm missing
$frame runL1 runL2 runL3 runL4 runL5 runL6 runL7 runL8
$frame runL9 runL10 runL11 runL12 runL13 runL14 runL15 runL16
$frame runL17 runL18 runL19

// Run with RIGHT arm missing
$frame runR1 runR2 runR3 runR4 runR5 runR6 runR7 runR8
$frame runR9 runR10 runR11 runR12 runR13 runR14 runR15 runR16
$frame runR17 runR18 runR19

// Attack with LEFT arm missing
$frame fireL1 fireL2 fireL3 fireL4 fireL5 fireL6 fireL7 fireL8
$frame fireL9 fireL10 fireL11

// Attack with RIGHT arm missing
$frame fireR1 fireR2 fireR3 fireR4 fireR5 fireR6 fireR7 fireR8
$frame fireR9 fireR10 fireR11

// Attack with BOTH arms active (NEW)
$frame fireB1 fireB2 fireB3 fireB4 fireB5 fireB6 fireB7 fireB8
$frame fireB9 fireB10 fireB11

// Death with LEFT arm missing
$frame deathL1 deathL2 deathL3 deathL4 deathL5 deathL6 deathL7 deathL8
$frame deathL9 deathL10 deathL11 deathL12

// Death with RIGHT arm missing
$frame deathR1 deathR2 deathR3 deathR4 deathR5 deathR6 deathR7 deathR8
$frame deathR9 deathR10 deathR11 deathR12

// Death with BOTH arm missing (special event)
$frame deathB1 deathB2 deathB3 deathB4 deathB5 deathB6 deathB7 deathB8
$frame deathB9 deathB10 deathB11 deathB12

// Death with HEAD missing (special event)
$frame deathH1 deathH2 deathH3 deathH4 deathH5 deathH6 deathH7 deathH8
$frame deathH9 deathH10 deathH11 deathH12

// Idle with LEFT arm missing
$frame standL1 standL2 standL3 standL4 standL5 standL6 standL7 standL8
$frame standL9 standL10 standL11 standL12 standL13 standL14 standL15 standL16
$frame standL17 standL18 standL19

// Idle with RIGHT arm missing
$frame standR1 standR2 standR3 standR4 standR5 standR6 standR7 standR8
$frame standR9 standR10 standR11 standR12 standR13 standR14 standR15 standR16
$frame standR17 standR18 standR19

float ad_SEEKER_ARMS_BOTH = 0;
float ad_SEEKER_ARMS_LEFT = 1;
float ad_SEEKER_ARMS_RIGHT = 2;
float ad_SEEKER_ARMSLESS = 3;
float ad_SEEKER_HEADLESS = 4;

float ad_SEEKER_IDLE = 0;
float ad_SEEKER_WALK = 1;
float ad_SEEKER_FIRE = 2;
float ad_SEEKER_DIE = 3;

//============================================================================
// Spark effect from missing arm joint
// Low chance out of combat (idle state)
//============================================================================
void()	ad_seek_sparks_fade1 = [0, ad_seek_sparks_fade2] {self.alpha = 0.8; self.nextthink = time + 0.05;};
void()	ad_seek_sparks_fade2 = [0, ad_seek_sparks_fade3] {self.alpha = 0.6; self.nextthink = time + 0.05;};
void()	ad_seek_sparks_fade3 = [0, ad_seek_sparks_fade4] {self.alpha = 0.4; self.nextthink = time + 0.05;};
void()	ad_seek_sparks_fade4 = [0, ad_SUB_Remove] {self.alpha = 0.2; self.nextthink = time + 0.05;};

void() ad_seek_spark =
{
	local float ad_loopvar;
	local entity ad_spark;
	
	if (self.state == ad_SEEKER_ARMS_BOTH) return;
	// Less chance of sparks when not in combat
	if (random() > 0.1 && !self.enemy) return;
	if (random() > 0.4 && self.enemy) return;
	
	// Light flash and sparky sound
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_BODY, self.noise3, 1, ad_ATTN_STATIC);
	makevectors (self.angles);
	
	// Change origin and spark direction for each arm
	if (self.state == ad_SEEKER_ARMS_LEFT) {
		self.pos1 = self.origin + ad_attack_vector('-4 -30 48');
		self.pos2 = -v_right*25;
	}
	else {
		self.pos1 = self.origin + ad_attack_vector('-4 30 48');
		self.pos2 = v_right*25;
	}

	// Work out how many sparks to spawn
	ad_loopvar = rint(5 + random()*5);
	while (ad_loopvar > 0) {
		ad_spark = spawn();
		ad_spark.ad_classtype = ad_CT_TEMPSPARK;
		ad_spark.ad_classgroup = ad_CG_TEMPENT;
		ad_spark.owner = self;
		ad_spark.movetype = ad_MOVETYPE_BOUNCE;
		ad_spark.solid = ad_SOLID_TRIGGER;
		setmodel (ad_spark, self.noise2);
		setorigin (ad_spark, self.pos1);
		setsize (ad_spark, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_spark.skin = rint(random()*3);
		ad_spark.gravity = 0.3;
		ad_spark.velocity = ad_vecrand(0,25,ad_TRUE);
		ad_spark.velocity = ad_spark.velocity + self.pos2;
		ad_spark.avelocity = '300 300 300';
		ad_spark.nextthink = time + 0.5 + 1.5*random();
		ad_spark.think = ad_seek_sparks_fade1;
		
		// If DP engine active remove particle shadow
		if (ad_engine == ad_ENG_DPEXT) ad_spark.effects = ad_spark.effects + ad_EF_NOSHADOW;

		// Keep looping for more sparks
		ad_loopvar = ad_loopvar - 1;
	}
};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_seek_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
	}
};

//----------------------------------------------------------------------
void() ad_seek_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_seek_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
}

//----------------------------------------------------------------------
void() ad_seek_setup_attachment = 
{
	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_seek_create_attachment();
	self.ad_attachment.state = ad_STATE_ON;
	setmodel(self.ad_attachment, self.ad_weaponglow);
	self.ad_attachment.skin = 0;
}

//----------------------------------------------------------------------
void() ad_seek_update_attachment =
{
	setorigin(self.ad_attachment, self.origin);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = self.frame;
	self.ad_attachment.alpha = 0.3 + random()*0.7;
};

//============================================================================
void() ad_seek_standframe =
{
	// type of animation state
	self.ad_attack_timer = ad_SEEKER_IDLE;

	// Check for arm status
	if (self.state == ad_SEEKER_ARMS_LEFT) self.frame = $standL1 + self.ad_walkframe;
	else if (self.state == ad_SEEKER_ARMS_RIGHT) self.frame = $standR1 + self.ad_walkframe;
	else self.frame = $stand1 + self.ad_walkframe;

	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	else if (self.ad_walkframe == 4) ad_seek_spark();
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 18) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_seek_standframe;

	if (self.spawnflags & ad_MON_SEEK_SHIELD) ad_seek_update_attachment();
	else ad_ai_stand();	
};

//----------------------------------------------------------------------
void() ad_seek_stand = { 
	self.ad_walkframe = 0; 
	if (self.spawnflags & ad_MON_SEEK_SHIELD) ad_seek_setup_attachment(); 
	ad_seek_standframe();
};

//============================================================================
void() ad_seek_walkframe =
{
	// If dead, no more updates
	if (self.health < 1) return;

	// type of animation state
	self.ad_attack_timer = ad_SEEKER_WALK;

	// Check for arm status
	if (self.state == ad_SEEKER_ARMS_LEFT) self.frame = $runL1 + self.ad_walkframe;
	else if (self.state == ad_SEEKER_ARMS_RIGHT) self.frame = $runR1 + self.ad_walkframe;
	else self.frame = $run1 + self.ad_walkframe;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	if (self.ad_walkframe == 2 || self.ad_walkframe == 12) ad_monster_footstep(ad_FALSE);
	if (self.ad_walkframe == 4) ad_seek_spark();
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 18) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_seek_walkframe;

	if (self.ad_walkframe == 1) self.distance = 0;
	else if (self.ad_walkframe == 2) self.distance = 5;
	else if (self.ad_walkframe == 3) self.distance = 5;
	else if (self.ad_walkframe == 4) self.distance = 15;
	else if (self.ad_walkframe == 5) self.distance = 5;
	
	else if (self.ad_walkframe == 6) self.distance = 7;
	else if (self.ad_walkframe == 7) self.distance = 12;
	else if (self.ad_walkframe == 8) self.distance = 7;
	else if (self.ad_walkframe == 9) self.distance = 5;
	else if (self.ad_walkframe == 10) self.distance = 3;
	
	else if (self.ad_walkframe == 11) self.distance = 0;
	else if (self.ad_walkframe == 12) self.distance = 5;
	else if (self.ad_walkframe == 13) self.distance = 5;
	else if (self.ad_walkframe == 14) self.distance = 15;
	else if (self.ad_walkframe == 15) self.distance = 3;
	
	else if (self.ad_walkframe == 16) self.distance = 7;
	else if (self.ad_walkframe == 17) self.distance = 12;
	else if (self.ad_walkframe == 18) self.distance = 7;
	else if (self.ad_walkframe == 0) self.distance = 8;
	
	if (self.lefty == ad_FALSE) ad_ai_walk(self.distance);
	else ad_ai_run(self.distance*2);
};

//----------------------------------------------------------------------
void() ad_seek_walk = { self.ad_walkframe = 0; self.lefty = ad_FALSE; ad_seek_walkframe(); };
void() ad_seek_run = { self.ad_walkframe = 0; self.lefty = ad_TRUE; ad_seek_walkframe(); };

//============================================================================
// Melee attack
//============================================================================
void() ad_seek_punch =
{
	local float ad_ldmg;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	VR_MeleeArc_TurnBegin(); ad_ai_face (); VR_MeleeArc_TurnEnd(); // AD support: melee arc: the swing's turn held (fight.qc)						// Turn towards enemy target
	ad_ai_damagebreakable(50);			// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEESEEKER, ad_MONAI_MELEEZTALL) && VR_MeleeArc_Hits(FALSE))) return;// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Melee hit sound
	sound (self, ad_CHAN_WEAPON, "seeker/punch1.wav", 1, ad_ATTN_NORM);
	// Damage 1-60
	ad_ldmg = (random() + random() + random()) * 20;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	ad_SpawnMeatSpray (self, self.enemy, -150);
	ad_SpawnMeatSpray (self, self.enemy, -150);
};

//----------------------------------------------------------------------
void() ad_seek_melee1 = [ $punch1, ad_seek_melee2 ] {ad_ai_face();
	self.ad_pain_finished = time + 1;	// Block pain animation
	sound (self, ad_CHAN_VOICE, "seeker/melee1.wav", 1, ad_ATTN_NORM);};
void() ad_seek_melee2 = [ $punch2, ad_seek_melee3 ] {ad_ai_charge(15);};
void() ad_seek_melee3 = [ $punch3, ad_seek_melee4 ] {ad_ai_charge(20);};
void() ad_seek_melee4 = [ $punch4, ad_seek_melee5 ] {ad_ai_charge(25);};
void() ad_seek_melee5 = [ $punch5, ad_seek_melee6 ] {ad_ai_charge(30);};
void() ad_seek_melee6 = [ $punch6, ad_seek_melee7 ] {ad_ai_charge(30);};
void() ad_seek_melee7 = [ $punch7, ad_seek_melee8 ] {ad_ai_charge(30);ad_seek_punch();};
void() ad_seek_melee8 = [ $punch8, ad_seek_melee9 ] {};
void() ad_seek_melee9 = [ $punch9, ad_seek_melee10 ] {};
void() ad_seek_melee10 = [ $punch10, ad_seek_run ] {};

//============================================================================
// Range attack - 3 rockets from each arm
//============================================================================
void(vector ad_leftofs, vector ad_rightofs) ad_seek_attack =
{
	local vector ad_org, ad_dir, ad_vec;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	// Setup different speeds for projectiles (rockets/laz0rs)
	if (self.ad_weaponstate == ad_TRUE)
		self.ad_attack_speed = ad_SPEED_SEEKLAZ + (ad_skill * ad_SPEED_SEEKLAZSKILL);
	else
		self.ad_attack_speed = ad_SPEED_SEEKROCK + (ad_skill * ad_SPEED_SEEKROCKSKILL);
	
	// turn and face your enemy!
	ad_ai_face();
	makevectors (self.angles);

	// Does the LEFT arm exist?
	if (self.state == ad_SEEKER_ARMS_BOTH || self.state == ad_SEEKER_ARMS_LEFT) { 
		// Fire left arm rocket
		ad_org = self.origin + ad_attack_vector(ad_leftofs);
		// Fire rocket slightly to the LEFT of player
		ad_vec = v_right*(10+random()*10);
		ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
		// Double check nothing (world/monsters) is blocking the rocket
		if (ad_visxray(self.enemy, ad_leftofs, '0 0 0', ad_FALSE)) {
			if (self.ad_weaponstate == ad_TRUE) {
				if (ad_skill > ad_SKILL_NORMAL) {
					sound (self, ad_CHAN_WEAPON, ad_SOUND_PLASMA_FIRE, 1, ad_ATTN_NORM);
					ad_launch_plasma(ad_org, ad_dir, ad_CT_MONSEEKER, self.ad_attack_speed);
				}
				else {
					sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);	
					ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_LASER, self.ad_attack_speed);
				}
			}
			else {
				sound (self, ad_CHAN_WEAPON, "seeker/rocket_fire.wav", 1, ad_ATTN_NORM);	
				ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_SEEKER, self.ad_attack_speed);
			}
		}
	}

	// Does the RIGHT arm exist?
	if (self.state == ad_SEEKER_ARMS_BOTH || self.state == ad_SEEKER_ARMS_RIGHT) { 
		ad_org = self.origin + ad_attack_vector(ad_rightofs);
		// Fire rocket slightly to the RIGHT of player
		ad_vec = v_right*(10+random()*10);
		ad_dir = normalize((self.enemy.origin - ad_vec) - ad_org);
		// Double check nothing (world/monsters) is blocking the rocket
		if (ad_visxray(self.enemy, ad_rightofs, '0 0 0', ad_FALSE)) {
			if (self.ad_weaponstate == ad_TRUE) {
				if (ad_skill > ad_SKILL_NORMAL) {
					sound (self, ad_CHAN_WEAPON, ad_SOUND_PLASMA_FIRE, 1, ad_ATTN_NORM);
					ad_launch_plasma(ad_org, ad_dir, ad_CT_PROJ_PLASMA, self.ad_attack_speed);
				}
				else {
					sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);	
					ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_LASER, self.ad_attack_speed);
				}
			}
			else {
				sound (self, ad_CHAN_WEAPON, "seeker/rocket_fire.wav", 1, ad_ATTN_NORM);	
				ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_SEEKER, self.ad_attack_speed);
			}
		}
	}
};

//----------------------------------------------------------------------
void() ad_seek_fireframe =
{
	// If dead, no more updates
	if (self.health < 1) return;

	// type of animation state
	self.ad_attack_timer = ad_SEEKER_FIRE;

	// Check for arm status
	if (self.state == ad_SEEKER_ARMS_LEFT) self.frame = $fireL1 + self.ad_walkframe;
	else if (self.state == ad_SEEKER_ARMS_RIGHT) self.frame = $fireR1 + self.ad_walkframe;
	else self.frame = $fireB1 + self.ad_walkframe;

	// Animation trigger events
	if (self.ad_walkframe == 0) {
		// Work out which attack to do? lasers or rockets
		self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
		if (self.ad_enemydist < ad_MONAI_RANGESWSEEKER) {
			// Upgrade lasers to plasma with hard skill+
			if (ad_skill > ad_SKILL_NORMAL) 
				sound (self, ad_CHAN_VOICE, "seeker/range_plasma.wav", 1, ad_ATTN_NORM);
			// Lasers at close range ONLY
			else sound (self, ad_CHAN_VOICE, "seeker/range_laser.wav", 1, ad_ATTN_NORM);
			self.ad_weaponstate = ad_TRUE;
		}
		else {
			sound (self, ad_CHAN_VOICE, "seeker/range_rocket.wav", 1, ad_ATTN_NORM);
			self.ad_weaponstate = ad_FALSE;
		}
	}
	else if (self.ad_walkframe == 5) ad_seek_attack('40 33 30','25 -23 25');
	else if (self.ad_walkframe == 7) ad_seek_attack('33 30 28','23 -30 25');
	else if (self.ad_walkframe == 9) ad_seek_attack('33 36 27','35 -26 26');
	else ad_ai_face();

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	self.nextthink = time + 0.1;
	if (self.ad_walkframe > 10) self.think = ad_seek_run;
	else self.think = ad_seek_fireframe;
};

//----------------------------------------------------------------------
void() ad_seek_fire = { self.ad_walkframe = 0; ad_seek_fireframe(); };

//============================================================================
// This robot does not feel pain, just exploding debris
//============================================================================
void() ad_seek_arm_explode =
{
	ad_particle_dust(self.pos2, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.pos2, "seeker/explode_major.wav");
	ad_SpawnProjectileSmoke(self.pos2, 150, 50, 150);
	ad_SpawnProjectileSmoke(self.pos2, 150, 50, 150);
	ad_SpawnProjectileSmoke(self.pos2, 150, 50, 150);
	// Throw 2 small metal blob + arm
	self.ad_gib1origin = self.ad_gib2origin = self.pos2;
	ad_ThrowGib(11, 2);
	ad_ThrowGib(12, 1);
	
	// Make sure previous function is restored so correct
	// arm animation is setup after one has been destroyed
	if (self.ad_attack_timer == ad_SEEKER_WALK) self.think = ad_seek_walkframe;
	else if (self.ad_attack_timer == ad_SEEKER_FIRE) self.think = ad_seek_fireframe;
	else self.think = self.ad_th_run;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_seek_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);

		// There are no checks for shadow axe damage (pain_check = 1/2)
		if (self.state == ad_SEEKER_ARMS_BOTH) {
			// Check for the chance to blow one of the arms off
			self.pos1_x = self.health / self.max_health;
			self.pos1_y = ad_skill / 10;
			self.pos1_z = self.pos1_x + self.pos1_y;
//			dprint("Damage ("); dprint(ftos(damage));
//			dprint(") Chance ("); dprint(ftos(self.pos1_z));
//			dprint(")\n");

			// Check for body damage and total damage done
			// Is there a chance one of the arms will fall off?
			if (ad_damage > 25 && random() > self.pos1_z) {
				if (random() > 0.5) {
					self.state = ad_SEEKER_ARMS_LEFT;
					makevectors (self.angles);
					self.pos2 = self.origin + ad_attack_vector('0 -35 44');
					ad_seek_arm_explode();
				}
				else {
					self.state = ad_SEEKER_ARMS_RIGHT;
					makevectors (self.angles);
					self.pos2 = self.origin + ad_attack_vector('0 35 44');
					ad_seek_arm_explode();
				}
			}
			else {
				// Spawn dust and sprite explosion
				ad_particle_dust(ad_inflictor.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
				ad_SpawnProjectileSmoke(ad_inflictor.origin, 150, 50, 150);
				ad_SpawnProjectileSmoke(ad_inflictor.origin, 150, 50, 150);
				ad_SpawnProjectileSmoke(ad_inflictor.origin, 150, 50, 150);
			}
		}
		else {
			// Once down to one arm, just sparks and dust
			ad_particle_dust(ad_inflictor.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
			ad_SpawnProjectileSmoke(ad_inflictor.origin, 150, 50, 150);
			ad_SpawnProjectileSmoke(ad_inflictor.origin, 150, 50, 150);
			ad_SpawnProjectileSmoke(ad_inflictor.origin, 150, 50, 150);
		}
	}
};

//============================================================================
void() ad_seek_explode =
{
	// Hide and Seek
	ad_entity_hide(self);
	
	// Regular ID particle explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	
	// Classic sprite/DP explosion
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, "seeker/explode_major.wav");
	ad_SpawnProjectileSmoke(self.origin, 150, 150, 150);
	ad_SpawnProjectileSmoke(self.origin, 150, 150, 150);
	ad_SpawnProjectileSmoke(self.origin, 150, 150, 150);

	// Throw a couple of random body pieces
	if (random() < 0.5) ad_ThrowGib(11, 1);
	else ad_ThrowGib(11, 2);
	// Lets throw our arms in the air like we don't care!
	if (self.state != ad_SEEKER_ARMSLESS) ad_ThrowGib(12, 1);
	// Spew random metal1_2 rubble up
	ad_ThrowGib(13, 5 + rint(random()*5));
	ad_ThrowGib(14, 5 + rint(random()*5));
	// If head still on shoulders, throw that as well!
	if (self.state != ad_SEEKER_HEADLESS) ad_ThrowGib(25, 1);
};

//----------------------------------------------------------------------
void() ad_seek_dieframe =
{
	// type of animation state
	self.ad_attack_timer = ad_SEEKER_DIE;

	if (self.ad_walkframe == 2) self.solid = ad_SOLID_NOT;

	// Check for arm status
	if (self.state == ad_SEEKER_ARMS_LEFT) self.frame = $deathL1 + self.ad_walkframe;
	else if (self.state == ad_SEEKER_ARMS_RIGHT) self.frame = $deathR1 + self.ad_walkframe;
	else if (self.state == ad_SEEKER_ARMSLESS) self.frame = $deathB1 + self.ad_walkframe;
	else if (self.state == ad_SEEKER_HEADLESS) self.frame = $deathH1 + self.ad_walkframe;
	else self.frame = $death1 + self.ad_walkframe;
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe < 12) {
		self.nextthink = time + 0.1;
		self.think = ad_seek_dieframe;
	}
	else {
		// Explode after a while
		self.nextthink = time + 3 + random()*2;
		self.think = ad_seek_explode;
	}

	// Spawn some extra smoke trails
	if (self.ad_walkframe > 1 && random() < 0.5) {
		// make sure the origin is coming out of the mech body
		self.pos1 = self.origin + (ad_crandom()*'16 16 0') + (random()*'0 0 24');
		ad_SpawnProjectileSmoke(self.pos1, 200, 250, 100);
		ad_SpawnProjectileSmoke(self.pos1, 200, 250, 100);
		if (random() < 0.5)
			ad_SpawnExplosion(ad_EXPLODE_MED, self.pos1, "seeker/explode_minor.wav");
	}
};

//----------------------------------------------------------------------
void() ad_seek_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Long death sound with comedy bing at the end!
	sound (self, ad_CHAN_VOICE, "seeker/death1.wav", 1, ad_ATTN_NORM);
	// reset custom origins for body/arm gib parts
	self.ad_gib1origin = self.ad_gib2origin = '0 0 0';
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;
	
	// Spawn dust and sprite explosion from chest area
	makevectors(self.angles);
	self.pos1 = self.origin + ad_attack_vector('8 0 24');
	ad_particle_dust(self.pos1, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.pos1, "seeker/explode_major.wav");
	ad_SpawnProjectileSmoke(self.pos1, 200, 250, 100);
	
	// Random chance of head flying off body with both arms!
	if (self.state == ad_SEEKER_ARMS_BOTH && random() > 0.6) {
		self.state = ad_SEEKER_HEADLESS;
		ad_ThrowGib(25, 1);
	}
	// Random chance that remaining left/right arm falls off
	else if (self.state < ad_SEEKER_ARMSLESS && random() > 0.9) {
		self.state = ad_SEEKER_ARMSLESS;
		ad_ThrowGib(12, 1);
	}	
	
	// Start death sequence
	self.ad_walkframe = 0;
	ad_seek_dieframe ();
};

//============================================================================
void() ad_seek_shield = 
{
	// Setup particle emitter for shield effect
	self.ad_part_active = ad_PARTICLE_STYLE_FFIELD;
	self.ad_spr_frame = ad_PARTICLE_BURST_BLUE;
	self.ad_part_vol = '24 24 32';		// Bounding box volume
	self.ad_part_limit = 100;			// Large amount of particles
	self.ad_part_life = 4;				// Longer lifetime
	self.ad_part_ofs = '0 0 32';		// Move up from monster origin
	self.ad_part_vel = '0 0 4';		// Move up from monster origin
	self.ad_part_emitter = ad_spawn_pemitter(self, self, self.ad_part_active, ad_PARTICLE_START_ON);
	ad_seek_stand();
};

//----------------------------------------------------------------------
void() ad_seek_wakeup =
{
	// Check for sudden death!
	if (self.health < 0) return;
	
	self.use = ad_SUB_Null;				// no re-trigger
	ad_seek_finish_attachment();			// Remove shield + spawnflag
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_SEEK_SHIELD);
	
	// Switch off shield sound
	sound (self, ad_CHAN_WEAPON, "ambience/power_off.wav", 1, ad_ATTN_NORM);
	// Switch OFF any particle emitter
	if (self.ad_part_emitter) ad_misc_particle_off(self.ad_part_emitter);
	
	// Check for any trigger off events (trigger_once)
	if (self.ad_target2 != "") ad_trigger_strs(self.ad_target2, self);
	self.ad_target2 = "";
	
	// Restore all think functions
	self.ad_th_stand = ad_seek_stand;
	self.ad_th_walk = ad_seek_walk;
	self.ad_th_run = ad_seek_run;
	self.ad_th_melee = ad_seek_melee1;		// Punch attack
	self.ad_th_missile = ad_seek_fire;		// Rockets incoming!
	self.ad_th_pain = ad_seek_pain;
	self.ad_th_die = ad_seek_die;
	self.takedamage = ad_DAMAGE_AIM;		// Can receive damage
	self.ad_reflectaxe = ad_FALSE;			// Allow axe damage
	ad_monster_targets();					// Check for targets
};

/*======================================================================
QUAKED monster_seeker (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_seeker =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_seeker.mdl";
	self.ad_headmdl = "progs/h_seeker.mdl";
	self.ad_weaponglow = "progs/mon_seeker_glow.mdl";
	// 4 poses 0=generic blob, 1=generic square, 2=generic blob2, 3=arm
	self.ad_gib1mdl = "progs/gib_seekchunk.mdl";	// types 0-2
	self.ad_gib2mdl = "progs/gib_seekarm.mdl";		// arm only
	self.ad_gib3mdl = "progs/gib_metal1.mdl";		// Breakable metal
	self.ad_gib4mdl = "progs/gib_metal3.mdl";		// Breakable metal

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_weaponglow);	// Glowing blue shield
	precache_model (self.ad_gib1mdl);		// gib chunks
	precache_model (self.ad_gib2mdl);		// Arms
	precache_model (self.ad_gib3mdl);		// Generic metal1_2
	precache_model (self.ad_gib4mdl);		// Generic metal1_2
	self.ad_gib1frame = 2;					// 3 frames choose from
	self.ad_gibtype = ad_GIBTYPE_METAL;		// Metal impact sounds
	
	self.ad_idle_sound = "seeker/idle1.wav";
	self.ad_idle_sound2 = "seeker/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	self.ad_pain_sound = "seeker/pain1.wav";
	self.ad_pain_sound2 = "seeker/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	precache_sound ("seeker/death1.wav");
	precache_sound ("seeker/explode_minor.wav");
	precache_sound ("seeker/explode_major.wav");
	// Power off sound for shield setup
	precache_sound ("ambience/power_off.wav");
	
	// Range attack 1 - rockets
	precache_sound("seeker/range_rocket.wav");
	precache_sound("seeker/rocket_fire.wav");
	precache_sound("seeker/rocket_hit.wav");
	// Range attack 2 - lasers
	precache_model (ad_MODEL_PROJ_LASER);
	precache_sound("seeker/range_laser.wav");
	precache_sound (ad_SOUND_LASER_FIRE);
	precache_sound (ad_SOUND_LASER_HIT);
	// Range attack 3 - plasma
	precache_model (ad_MODEL_PROJ_PLASMA);
	precache_sound ("seeker/range_plasma.wav");
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);

	// Melee attack - giant punch
	precache_sound ("seeker/melee1.wav");
	precache_sound ("seeker/punch1.wav");
	
	// Sparking from broken arm
	self.noise2 = "progs/misc_spark.mdl";
	self.noise3 = "misc/spark.wav";
	precache_model (self.noise2);
	precache_sound (self.noise3);
	
	self.ad_sight_sound = "seeker/sight1.wav";
	precache_sound (self.ad_sight_sound);

	// Check for any custom arm setups
	if (self.state < ad_SEEKER_ARMS_LEFT || self.state > ad_SEEKER_ARMS_RIGHT)
		self.state = ad_SEEKER_ARMS_BOTH;	// Both arms are active

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_GIANT;
	if (self.health < 1) {
		// if spawns with one arm, start with less HP
		if (self.state == ad_SEEKER_ARMS_BOTH) self.health = 500;
		else self.health = 400;
	}
	
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;				// Starts in one piece
	self.ad_pain_flinch = 400;				// takes alot to pain
	self.ad_pain_timeout = 2;				// High pain threshold
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_pain_longanim = ad_FALSE;			// cannot be chopped with shadow axe
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_SEEKER;
	self.ad_bouncegrenade = ad_TRUE;			// Grenades bounce
	self.ad_bleedcolour = ad_MON_BCOLOR_WHITE;	// Grey dust
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous
	self.ad_deathstring = " was destroyed by a Seeker\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = 0.5; self.ad_resist_cells = 0;
	
	// Custom feet sounds (specific order)
	self.ad_stepc1 = "seeker/footstep1.wav";
	self.ad_stepc2 = "seeker/footstep2.wav";
	self.ad_stepc3 = "seeker/footstep1.wav";
	self.ad_stepc4 = "seeker/footstep2.wav";
	self.ad_stepc5 = "seeker/footstep3.wav";
	precache_sound (self.ad_stepc1);
	precache_sound (self.ad_stepc2);
	precache_sound (self.ad_stepc3);
	precache_sound (self.ad_stepc4);
	precache_sound (self.ad_stepc5);
	self.ad_steptype = ad_FS_TYPECUSTOM;

	if (self.spawnflags & ad_MON_SEEK_SHIELD) {
		self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage
		self.ad_th_stand = ad_seek_shield;	// Setup Shield
		self.ad_think1 = ad_seek_wakeup;		// Wakeup function when triggered
	}
	else {
		self.ad_th_stand = ad_seek_stand;
		self.ad_th_walk = ad_seek_walk;
		self.ad_th_run = ad_seek_run;
		self.ad_th_melee = ad_seek_melee1;	// Punch attack
		self.ad_th_missile = ad_seek_fire;	// Rockets incoming!
		self.ad_th_pain = ad_seek_pain;
		self.ad_th_die = ad_seek_die;
	}

	self.ad_th_checkattack = ad_SeekerCheckAttack;
	self.ad_classtype = ad_CT_MONSEEKER;
	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};

//======================================================================
// Monster replacement for Travil MOD juggernaut
//======================================================================
void() ad_monster_juggernaut = { ad_monster_seeker(); };
