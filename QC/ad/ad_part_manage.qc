// Particle management
float ad_PARTICLE_MAXENTS = 1024;	// Maximum amount of particles active (default)
float ad_PARTICLE_BANK = 64;		// How many particle in each setup bank
float ad_PARTICLE_BUFFER = 128;	// How many particle to create before unlock
float		ad_part_message;		// Timer for particle message (every 3s)
entity		ad_part_control;		// Particle setup entity (drives nextthink)
entity		ad_part_start;			// Pointers to start/end particle chain
entity		ad_part_end;
entity		ad_part_free;			// Current particle entity
float		ad_part_total;			// Currently active particles
float		ad_part_max;			// Maximum active particles
float		ad_part_multiplier;	// Advanced / Standard engine multiplier
entity		ad_part;				// Spawning particle emitters and particles

