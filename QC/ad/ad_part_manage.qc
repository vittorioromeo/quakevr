void() ad_setup_particleprecache =
{
	precache_model (ad_PART_TORCH1);			// Embers - Red/Yellow
	precache_model (ad_PART_TORCH2);			// Embers - Red/Yellow
	precache_model (ad_PART_BOOKRUNE1);		// Celtic Book Runes
	precache_model (ad_PART_BOOKRUNE2);		// Celtic Book Runes
	
	precache_model (ad_PART_BUBBLE_BLUE);		// Bubbles - Blue
	precache_model (ad_PART_DOTMED_BLUE);		// Dots - Medium Blue
	precache_model (ad_PART_DOTSML_BLUE);		// Dots - Small Blue
	precache_model (ad_PART_DOTMED_DBLUE);		// Dots - Medium Dark Blue
	precache_model (ad_PART_DOTSML_DBLUE);		// Dots - Small Dark Blue
	precache_model (ad_PART_BUBBLE_YELLOW);	// Bubbles - Yellow
	precache_model (ad_PART_DOTMED_YELLOW);	// Dots - Medium Yellow
	precache_model (ad_PART_DOTSML_YELLOW);	// Dots - Small Yellow
	precache_model (ad_PART_DOTSML_GOLD);		// Dots - Small Gold
	precache_model (ad_PART_BUBBLE_RED);		// Bubbles - Red
	precache_model (ad_PART_DOTMED_RED);		// Dots - Medium Red
	precache_model (ad_PART_DOTSML_RED);		// Dots - Small Red
	precache_model (ad_PART_DOTMED_GREEN);		// Dots - Medium Green
	precache_model (ad_PART_DOTSML_GREEN);		// Dots - Small Green
	precache_model (ad_PART_DOTMED_LGREEN);	// Dots - Medium Light Green
	precache_model (ad_PART_DOTSML_LGREEN);	// Dots - Small Light Green
	precache_model (ad_PART_DOTSML_PURP);		// Dots - Purple/Pink
	precache_model (ad_PART_DOTMED_PURP);		// Dots - Purple/Pink
	precache_model (ad_PART_BUBBLE_WHITE);		// Bubbles - White
	precache_model (ad_PART_DOTSML_WHITE);		// Dots - Small White
	precache_model (ad_PART_DOTMED_GREY);		// Dots - Medium Grey
	precache_model (ad_PART_DOTSML_GREY);		// Dots - Small Grey
