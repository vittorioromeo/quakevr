.float		ad_target_valid;		// Test condition for valid target entity (not self or world)
.float		ad_part_style;			// Pre-defined particle styles
.float		ad_pemit_tcount;		// Particle emitter, total active particles 
.float		ad_part_active;		// Is the particle emitter active? or not
.float		ad_start_delay;		// Particle emitter start delay
