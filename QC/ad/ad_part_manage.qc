// Compiler forward links
void() ad_setup_particleprecache;

//----------------------------------------------------------------------
// The particle is finished with, update emitter particle counter
//----------------------------------------------------------------------
void() ad_finish_particle =
{
	if (self.ad_classtype != ad_CT_PARTICLE) {
		dprint("\b[PARTICLE_RETURN]\b This is not a particle!?!\n");
	}
	else {
		if (self.owner.ad_pemit_tcount > 0)
			self.owner.ad_pemit_tcount = self.owner.ad_pemit_tcount - 1;
		
		self.velocity = ad_VEC_ORIGIN;		// no more movement
		self.avelocity = ad_VEC_ORIGIN;
		self.origin = ad_VEC_ORIGIN;
		self.ad_part_active = ad_FALSE;		// Finished with particle
		setmodel(self, "");				// Remove from world
		self.owner = world;				// No owner anymore
		self.skin = self.frame = self.flags = ad_FALSE;
		self.gravity = 1;
		
		// Update active particle total
		if (ad_part_total > 1) ad_part_total = ad_part_total - 1;

		if (ad_part_free.ad_classtype != ad_CT_PARTICLE) {
			dprint("\b[PARTICLE_RETURN]\b Current free particle is wrong classtype!!\n");
		}
		else {
			// Add particle back into central particle list
			self.ad_entchain = ad_part_free.ad_entchain;		// link new particle forward in chain
			ad_part_free.ad_entchain = self;				// link free particle to new particle
	
			if (ad_part_debug == 2) {
				dprint("Return Free ("); dprint(ftos(ad_part_free.cnt));
				dprint(") Next ("); dprint(ftos(ad_part_free.ad_entchain.cnt));
				dprint(")\n");			
			}
		}
	}
};

//----------------------------------------------------------------------
// All requests for particles must go through one function
//----------------------------------------------------------------------
entity() ad_fetch_particle =
{
	local entity ad_tpart_ret;
	ad_tpart_ret = world;		// Default - no particle returned

	// Make sure the system has 2 banks of particles setup first!
	if (ad_part_control.count < ad_PARTICLE_BUFFER) return ad_tpart_ret;

	// Display particle limits if skill set to a debug number
	if (ad_part_debug == 1) {
		sprint(ad_client_ent, "CREATE Particle ("); sprint(ad_client_ent, ftos(ad_part_total));
		sprint(ad_client_ent, "/"); sprint(ad_client_ent, ftos(ad_part_max));
		sprint(ad_client_ent, ")\n");
	}
	
	// Are there any free particles?
	if (ad_part_total >= ad_part_max - 1) {
		if (ad_part_message < time) {
			dprint("\b[PARTICLE]\b current limit ("); dprint(ftos(ad_part_max));
			dprint(") too low!\n");
			ad_part_message = time + 5;	// interval console spam
		}
	}
	else {
		if (ad_part_free.ad_classtype != ad_CT_PARTICLE) {
			dprint("\b[PARTICLE_FETCH]\b Current free particle is wrong classtype!!\n");
		}
		else if (ad_part_free.ad_entchain.ad_classtype != ad_CT_PARTICLE) {
			dprint("\b[PARTICLE_FETCH]\b Next free particle is wrong classtype!!\n");
			dprint("Free ("); dprint(ftos(ad_part_free.cnt));
			dprint(") Ctype ("); dprint(ftos(ad_part_free.ad_classtype));
			dprint(") Next ("); dprint(ftos(ad_part_free.ad_entchain.cnt));
			dprint(") Ctype ("); dprint(ftos(ad_part_free.ad_entchain.ad_classtype));
			dprint(")\n");
		}
		else {
			ad_tpart_ret = ad_part_free.ad_entchain;				// return next free particle
			ad_part_free.ad_entchain = ad_tpart_ret.ad_entchain;	// Skip forward in the chain
			
			// Update currently active particle total
			ad_part_total = ad_part_total + 1;
			ad_tpart_ret.ad_part_active = ad_TRUE;

			if (ad_part_debug == 2) {
				dprint("Fetch Free ("); dprint(ftos(ad_part_free.cnt));
				dprint(") return ("); dprint(ftos(ad_tpart_ret.cnt));
				dprint(")\n");
			}
		}
	}

	return (ad_tpart_ret);
};

//----------------------------------------------------------------------
// Generate a chain of entities (one block at a time)
//----------------------------------------------------------------------
void() ad_generate_particlechain =
{
	local entity ad_part_prev, ad_part_first;
	local float ad_pcount;

	// Reset all variables
	ad_part_first = ad_part_prev = ad_part = world;
	ad_pcount = 0;
	
	// Is there anymore particles need to be created?
	if (self.count + 1 < ad_part_max) {
		dprint("\b[PCHAIN]\b Part bank (");
		dprint(ftos(self.count)); dprint(" / ");
		dprint(ftos(ad_part_max)); dprint(")\n");
		
		while (ad_pcount < ad_PARTICLE_BANK) {
			// Create a new particle entity
			ad_part = spawn();
			ad_part.solid = ad_SOLID_NOT;
			ad_part.owner = world;
			ad_part.ad_part_active = ad_FALSE;
			ad_part.classname = "particle";
			ad_part.ad_classtype = ad_CT_PARTICLE;
			// If DP engine active remove particle shadow
			if (ad_engine == ad_ENG_DPEXT) ad_part.effects = ad_part.effects + ad_EF_NOSHADOW;
			ad_part.cnt = self.count + ad_pcount;
			
			ad_pcount = ad_pcount + 1;		// Increase loop

			//----------------------------------------------------------------------
			// Link particle chains together
			if (ad_part_prev.ad_classtype != ad_CT_PARTICLE)
				ad_part_first = ad_part;			// NEW CHAIN - setup all entity pointers
			else ad_part_prev.ad_entchain = ad_part;	// EXISTING CHAIN - Link particles together

			ad_part_prev = ad_part;				// Setup previous particle in chain
			//----------------------------------------------------------------------
		}
		
		// Update total particles generated
		self.count = self.count + ad_PARTICLE_BANK;

		//----------------------------------------------------------------------
		// Are there any previous banks of particles?
		if (ad_part_start.ad_classtype != ad_CT_PARTICLE) {
			// NEW BANK - Setup start/end particle and close chain
			ad_part_start = ad_part.ad_entchain = ad_part_first;
			ad_part_free = ad_part_first.ad_entchain;		// Move forward 1
			ad_part_end = ad_part;
		}
		else {
			// EXISTING BANK - Link new bank to existing banks
			ad_part_end.ad_entchain = ad_part_first;			// Link end and first of new bank together
			ad_part.ad_entchain = ad_part_start;				// Link current and start together
			ad_part_end = ad_part;						// Move end of bank forward
		}
		//----------------------------------------------------------------------
	}
	
	//----------------------------------------------------------------------
	// Is there anymore particles need to be created?
	if (self.count + 1 < ad_part_max) {
		self.think = ad_generate_particlechain;
		self.nextthink = time + 0.2;
	}
	// Finished generating particle banks
	else self.waitmin = ad_FALSE;
};

//----------------------------------------------------------------------
//  Setup particle chain in small banks
//----------------------------------------------------------------------
void() ad_setup_particlechain =
{
	// Pre-cache all sprites
	ad_setup_particleprecache();
	
	if (ad_part_control.ad_classtype != ad_CT_PARTICLECONT) {
		ad_part_control = spawn();
		ad_part_control.solid = ad_SOLID_NOT;
		ad_part_control.ad_classtype = ad_CT_PARTICLECONT;
		
		dprint("\b[PCHAIN]\b Creating controller\n");
		ad_part_free = ad_part_end = ad_part_start = world;
		ad_part_total = ad_part_control.count = 0;
		ad_part_control.waitmin = ad_TRUE;
	}
	// Setup next think
	ad_part_control.think = ad_generate_particlechain;
	ad_part_control.nextthink = time + 0.3;
};

//----------------------------------------------------------------------
//  Extend particle chain (used by quickload issues)
//----------------------------------------------------------------------
void() ad_extend_particlechain =
{
	local float ad_new_part_max;
	
	// Check for particle chain controller FIRST!
	if (ad_part_control.ad_classtype != ad_CT_PARTICLECONT) return;
	// Check if particle bank setup is running already
	if (ad_part_control.waitmin) return;
	
	// Make sure particle banks are reset to default if low
	if (ad_part_max < ad_PARTICLE_MAXENTS) ad_new_part_max = ad_PARTICLE_MAXENTS;
	
	// Check for any worldspawn override value
	if (world.ad_particlemax > 0) {
		if (ad_new_part_max < world.ad_particlemax) 
			ad_new_part_max = world.ad_particlemax;
	}

	// Does the particle bank max need to change?
	if (ad_part_max > ad_new_part_max) return;
	else ad_part_max = ad_new_part_max;
	
	dprint("\b[WORLD]\b New max particles (");
	dprint(ftos(ad_part_max)); dprint(")\n");

	// Setup next think
	ad_part_control.think = ad_generate_particlechain;
	ad_part_control.nextthink = time + 0.3;
	ad_part_control.waitmin = ad_TRUE;
};

