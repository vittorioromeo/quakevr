//======================================================================
// swampling 2 - POISON SPIT FUNCTIONS (range)
//======================================================================
void(float ad_sideang) ad_swampling_spitacid =
{
	local vector ad_org, ad_dir, ad_ang, ad_avel;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
		
	// Flash effect to show where bolt is coming from	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	if (ad_sideang < 0) sound (self, ad_CHAN_WEAPON, "swampling/spit4.wav", 1, ad_ATTN_NORM);

	makevectors (self.angles);	
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	// Create elevation angle and use makevectors to create projectile direction
	ad_ang = vectoangles(self.enemy.origin - ad_org);
	ad_ang_x = -self.ad_attack_elev;	// Negative = upwards angle 
	makevectors (ad_ang);
	// fire spit in arc pattern (sideang)
	ad_dir = (v_forward + (v_right * ad_sideang)) * ad_SPEED_SWAMPLING;	

	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_SWAMP);
};

//----------------------------------------------------------------------
void()	ad_swampling_spit1 = [ $pain1, ad_swampling_spit2 ] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.enemy.origin, ad_SPEED_SWAMPLING); };
void()	ad_swampling_spit2 = [ $pain2, ad_swampling_spit3 ] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, ad_SPEED_SWAMPLING); };
void()	ad_swampling_spit3 = [ $bite1, ad_swampling_spit4 ] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, ad_SPEED_SWAMPLING); };
void()	ad_swampling_spit4 = [ $bite2, ad_swampling_spit5 ] {ad_swampling_spitacid(-0.1);};
void()	ad_swampling_spit5 = [ $bite3, ad_swampling_spit6 ] {ad_swampling_spitacid(0);};
void()	ad_swampling_spit6 = [ $bite4, ad_swampling_spit7 ] {ad_swampling_spitacid(0.1);};
void()	ad_swampling_spit7 = [ $bite5, ad_swampling_spit8 ] {};
void()	ad_swampling_spit8 = [ $bite6, ad_swampling_spit9 ] {};
void()	ad_swampling_spit9 = [ $bite7, ad_swampling_run1 ] {};

//======================================================================
// BITE
//======================================================================
void() ad_swampling_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);										// Get closer for extra bite
	ad_ai_damagebreakable(10);								// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEESWAMPLING,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	if (random() < 0.5) sound(self, ad_CHAN_VOICE, "swampling/attackmunch.wav", ad_TRUE, ad_TRUE);
	else sound(self, ad_CHAN_VOICE, "swampling/attacktear.wav", ad_TRUE, ad_TRUE);

	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// swampling bite (damage 1-9) is very weak
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	
	// Spawn some touch blood
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

//----------------------------------------------------------------------
void()	ad_swampling_bite1	=[	$bite1, ad_swampling_bite2	] {ad_ai_face();};
// Start bite attack loop
void()	ad_swampling_bite2	=[	$bite2, ad_swampling_bite3 ] {ad_ai_face();};
void()	ad_swampling_bite3	=[	$bite3, ad_swampling_bite4 ] {ad_ai_face();};
void()	ad_swampling_bite4 = [	$bite4, ad_swampling_bite5 ] {ad_swampling_melee();};
void()	ad_swampling_bite5 = [	$bite5, ad_swampling_bite6 ] {};
void()	ad_swampling_bite6 =[	$bite6, ad_swampling_bite7 ] {
	if (ad_ai_checkmelee(ad_MONAI_MELEESWAMPLING,ad_FALSE) && self.enemy.health > 0) self.think = ad_swampling_bite2;};
// Exit bite attack loop
void()	ad_swampling_bite7	=[	$bite7, ad_swampling_run1	] {};

//============================================================================
// JUMP FUNCTION (range)
//============================================================================
void()	ad_swampling_JumpTouch =
{
	local float ad_ldmg;

	if (self.health <= 0) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	// Do not damage other swamplings with jump attacks
	// Prevents packs from killing themselves
	if (self.ad_classgroup != other.ad_classgroup && other.takedamage) {
		if ( vlen(self.velocity) > 300 ) {
			ad_ldmg = 5 + 5*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			// Spawn some touch blood (no explicit direction)
			ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
		}
	}

	// Is the swampling floating in the air?
	if (!checkbottom(self)) {
		// Is the swampling standing on something?
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_swampling_leap1	=[	$jump1, ad_swampling_leap2	] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	ad_monster_idle_sound();
};
void() ad_swampling_leap2	=[	$jump2, ad_swampling_leap3	] {ad_ai_face();};
void() ad_swampling_leap3	=[	$jump3, ad_swampling_leap4	] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	self.touch = ad_swampling_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.origin_z = self.origin_z + 4;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

// Flying through the air waiting to touch something!
void() ad_swampling_leap4	=[	$jump4, ad_swampling_leap5	] {};
void() ad_swampling_leap5	=[	$jump5, ad_swampling_leap6 ] {};	
void() ad_swampling_leap6	=[	$jump6, ad_swampling_leap7	] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_swampling_leap3;
	}
	self.oldorigin = self.origin;
};
//----------------------------------------------------------------------
void() ad_swampling_leap7 =[ $jump3, ad_swampling_leap8 ] {ad_monster_footstep(ad_FALSE);};
void() ad_swampling_leap8 =[ $jump2, ad_swampling_leap9 ] {ad_monster_footstep(ad_FALSE);};
void() ad_swampling_leap9 =[ $jump1, ad_swampling_run1	] {ad_ai_resetangles();};

//======================================================================
// CEILING swamplingS - Idle/Drop/Touch/Land functions
//======================================================================
void()	ad_swampling_idleup1 =[ $idleup1, ad_swampling_idleup2] {ad_monster_idle_sound();ad_ai_stand();};
void()	ad_swampling_idleup2 =[ $idleup2, ad_swampling_idleup3] {ad_ai_stand();};
void()	ad_swampling_idleup3 =[ $idleup3, ad_swampling_idleup4] {ad_ai_stand();};
void()	ad_swampling_idleup4 =[ $idleup4, ad_swampling_idleup5] {ad_ai_stand();};
void()	ad_swampling_idleup5 =[ $idleup5, ad_swampling_idleup6] {ad_ai_stand();};
void()	ad_swampling_idleup6 =[ $idleup6, ad_swampling_idleup1] {ad_ai_stand();};

//----------------------------------------------------------------------
void() ad_swampling_droptouch =
{
	// Check if landed on something that is not the ground?
	if (!checkbottom(self)) {
		// Is the swampling standing on something?
		if (self.flags & ad_FL_ONGROUND) {
			self.flags = self.flags - ad_FL_ONGROUND;
			self.origin_z = self.origin_z + 8;
			setorigin(self, self.origin);	// raise up
			self.ad_attack_timer = time + 1;	// reset timer
			
			makevectors (self.angles);
			self.velocity = v_forward * 100 + '0 0 200';
		}
		return;
	}

	// No more flying, back to running
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setsize(self, self.ad_bbmins, self.ad_bbmaxs);
	
	// Reset view offset (based on bbox height)
	self.view_ofs = '0 0 0';
	self.view_ofs_z = self.maxs_z*0.5;

	self.touch = ad_SUB_Null;			// No more jump touching
	ad_FoundHuntTarget(ad_TRUE);			// Setup goals and warn other monsters
	if (self.enemy.flags & ad_FL_CLIENT) ad_monster_sightsound();

	// Restore all think state functions (swampling is off the ceiling)
	self.ad_th_stand = ad_swampling_idle1;
	self.ad_th_walk = ad_swampling_walk1;
	self.ad_th_run = ad_swampling_run1; 
	self.ad_th_slide = ad_swampling_slide1;
	self.ad_th_melee = ad_swampling_bite1;

	// swampling 1 and 2 have different range attacks
	if (self.spawnflags & ad_MON_SWAMPLING_LARGE) self.ad_th_missile = ad_swampling_spit1;
	else self.ad_th_jump = ad_swampling_leap1;

	// Back to running or standing around!
	if (!self.enemy) self.think = self.ad_th_stand;
	else self.think = self.ad_th_run;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void()	ad_swampling_drop1	=[	$drop1,	ad_swampling_drop2	] {};
void()	ad_swampling_drop2	=[	$drop2,	ad_swampling_drop3	] {};
void()	ad_swampling_drop3	=[	$drop3,	ad_swampling_drop4	] {};
void()	ad_swampling_drop4	=[	$drop4,	ad_swampling_drop5	] {};
void()	ad_swampling_drop5	=[	$drop5,	ad_swampling_drop5	] {
	if (self.ad_attack_timer < time || self.velocity_z == 0) ad_swampling_droptouch();
};

//----------------------------------------------------------------------------
void() ad_swampling_wakeup =
{
	// Dead already?
	if (self.health < 1) return;
		
	// Only call wakeup function once
	self.ad_th_walk = self.ad_th_run = self.ad_th_slide = ad_SUB_Null;

	// No longer need cling to ceiling spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_SWAMPLING_CEILING);

	self.flags = ad_FL_MONSTER;			// reset flags
	
	if (ad_engine == ad_ENG_FITZ) self.origin_z = self.origin_z - 8;
	else self.origin_z = self.origin_z - 32;	// Unstick from ceiling
	setorigin(self, self.origin);		// Move down slightly
	
	self.movetype = ad_MOVETYPE_TOSS;		// Affected by gravity
	self.solid = ad_SOLID_SLIDEBOX;
	self.ad_attack_timer = time + 1;		// Stuck timer

	self.ad_classmove = ad_MON_MOVEWALK;		// Back to walking/running 
	self.ad_pain_finished = time + 1.5;	// No pain
	ad_SUB_AttackFinished(2 + random());	// No attacking
		
	makevectors (self.angles);			// Move towards face direction
	self.velocity = v_forward * 50;		// Slight nudge forward

	self.touch = ad_swampling_droptouch;	// Touch something?
	if (!self.jump_flag) 
	self.jump_flag = time + 1 + random()*2;	// Don't jump straight away
	ad_swampling_drop1();						// Turn around, cat tricks!
};

//======================================================================
// MINION - Grow and spin up from nothing
//======================================================================
void() ad_swampling_growangle = {self.angles_y = self.angles_y + self.lefty;};
void() ad_swampling_grow1 = [ $grow1, ad_swampling_grow2 ] {};
void() ad_swampling_grow2 = [ $grow2, ad_swampling_grow3 ] {ad_swampling_growangle();};
void() ad_swampling_grow3 = [ $grow3, ad_swampling_grow4 ] {ad_swampling_growangle();};
void() ad_swampling_grow4 = [ $grow4, ad_swampling_grow5 ] {ad_swampling_growangle();};
void() ad_swampling_grow5 = [ $grow5, ad_swampling_grow6 ] {ad_swampling_growangle();};
void() ad_swampling_grow6 = [ $grow6, ad_swampling_grow7 ] {ad_swampling_growangle();};
void() ad_swampling_grow7 = [ $grow7, ad_swampling_grow8 ] {ad_swampling_growangle();};
void() ad_swampling_grow8 = [ $grow8, ad_swampling_grow9 ] {ad_swampling_growangle();};
void() ad_swampling_grow9 = [ $grow9, ad_swampling_grow10] {ad_swampling_growangle();};
void() ad_swampling_grow10= [ $grow10, ad_swampling_run1 ] {
	// Is the swampling stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		// Finally spin back to original position
		self.angles_y = self.angles_y + self.lefty;
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);

		// Restore all think state functions
		self.ad_th_stand = ad_swampling_idle1;
		self.ad_th_walk = ad_swampling_walk1;
		self.ad_th_run = ad_swampling_run1; 
		self.ad_th_slide = ad_swampling_slide1;
		self.ad_th_melee = ad_swampling_bite1;
		// swampling 1 and 2 have different range attacks
		if (self.spawnflags & ad_MON_SWAMPLING_LARGE) self.ad_th_missile = ad_swampling_spit1;
		else {
			self.ad_th_jump = ad_swampling_leap1;
			self.ad_th_jumpexit = ad_swampling_leap7;
		}
	}
};
//----------------------------------------------------------------------------
void() ad_swampling_grow =
{
	// Only call wakeup function once
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run  = ad_SUB_Null;
	if (random() < 0.5) self.lefty = 36;
	else self.lefty = -36;
	ad_monster_sightsound();
	ad_swampling_grow1();
};

//============================================================================
void() ad_swampling_pain1	=[	$pain1,	ad_swampling_pain2	] {};
void() ad_swampling_pain2	=[	$pain2,	ad_swampling_run1	] {};

//----------------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_swampling_pain = 
{
	// Has the swampling been hit while on the ceiling?
	if (self.spawnflags & ad_MON_SWAMPLING_CEILING) {
		self.ad_pain_finished = time + 1;
		ad_swampling_wakeup();
		return;
	}
		
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		self.ad_pain_finished = time + 1;

		if (self.ad_pain_check == 1) ad_swampling_pain1();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.2;
			self.ad_axhitme = 0;
			ad_swampling_pain1();
		}
	}
};

//============================================================================
void() ad_swampling_die1 =[	$death1, ad_swampling_die2	] {};
void() ad_swampling_die2 =[	$death2, ad_swampling_die3	] {ad_monster_check_gib();};
void() ad_swampling_die3 =[	$death3, ad_swampling_die4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_swampling_die4 =[	$death4, ad_swampling_die5	] {};
void() ad_swampling_die5 =[	$death5, ad_swampling_die6	] {ad_monster_death_postcheck();};
void() ad_swampling_die6 =[	$death6, ad_swampling_die6	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------------
void() ad_swampling_dieB1 =[	$deathB1, ad_swampling_dieB2	] {};
void() ad_swampling_dieB2 =[	$deathB2, ad_swampling_dieB3	] {ad_monster_check_gib();};
void() ad_swampling_dieB3 =[	$deathB3, ad_swampling_dieB4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_swampling_dieB4 =[	$deathB4, ad_swampling_dieB5	] {};
void() ad_swampling_dieB5 =[	$deathB5, ad_swampling_dieB6	] {};
void() ad_swampling_dieB6 =[	$deathB6, ad_swampling_dieB7	] {ad_monster_death_postcheck();};
void() ad_swampling_dieB7 =[	$deathB7, ad_swampling_dieB7	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------------
void() ad_swampling_die = 
{
	// swamplings are small, gibs don't bounce far
	self.max_health = ad_MON_NOGIBVELOCITY;

	// Has the swampling died while on the ceiling?
	if (self.spawnflags & ad_MON_SWAMPLING_CEILING)
		self.ad_gibondeath = ad_TRUE;

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "swampling/death.wav", 1, ad_ATTN_NORM);
		if (random() < 0.6) ad_swampling_die1();
		else ad_swampling_dieB1();
	}
};

//======================================================================
/*ad:QUAKED monster_swampling (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_monster_swampling =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	if (self.spawnflags & ad_MON_SWAMPLING_LARGE) {
		self.mdl = "progs/mon_swamplingp.mdl";
		self.ad_gib1mdl = "progs/gib_swamplegp.mdl";	// Single Leg
	}
	else {
		self.mdl = "progs/mon_swampling.mdl";
		self.ad_gib1mdl = "progs/gib_swampleg.mdl";	// Single Leg
	}

	precache_model (self.mdl);
	precache_model (self.ad_gib1mdl);
	precache_model (ad_MODEL_PROJ_SWAMP);			// Spit Projectile

	// IDLE/COMBAT and SIGHT sounds
	self.ad_idle_sound = "swampling/idle1.wav";
	self.ad_idle_sound2 = "swampling/idle3.wav";
	self.ad_idle_soundcom = "swampling/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);

	// death/pain/attack sounds
	precache_sound("swampling/death.wav");
	self.ad_pain_sound = "swampling/pain3.wav";
	precache_sound(self.ad_pain_sound);

	precache_sound("swampling/miss.wav");	// Spit misses
	precache_sound("swampling/spit4.wav");	// Spit attack
	precache_sound("swampling/attackmunch.wav");
	precache_sound("swampling/attacktear.wav");
	precache_sound("swampling/jumpland.wav");

	self.ad_sight_sound = "swampling/sight2.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 10;				// Always flinch
	self.ad_steptype = ad_FS_TYPELIGHT;
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '20 0 0';		// Bite attack offset
	self.ad_attack_offset = '14 0 8';		// Used by large swampling, at jaws
	self.ad_movespeed = 1;					// Can never be a turret
	self.ad_poisonous = ad_TRUE;				// Always poisonous
	self.ad_deathstring = " was bitten by a Swampling\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_SwamplingCheckAttack;
	self.ad_th_pain = ad_swampling_pain;
	self.ad_th_die = ad_swampling_die;

	self.ad_classtype = ad_CT_MONSWAMPLING;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEWALK;

	// Setup light/dark green swampling difference
	if (self.spawnflags & ad_MON_SWAMPLING_LARGE) {
		if (self.health < 1) self.health = 60;
		self.ad_gibhealth = -25;
		self.ad_th_missile = ad_swampling_spit1;
	}
	else {
		if (self.health < 1) self.health = 30;
		self.ad_gibhealth = -20;
		self.ad_th_jump = ad_swampling_leap1;
		self.ad_th_jumpexit = ad_swampling_leap7;
		// Default jump forward/up distance
		if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '500 0 200';
		if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPSWAMPLINGNEAR;
		if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPSWAMPLINGFAR;
	}

	//----------------------------------------------------------------------
	// Check for quoth on ceiling entity flag
	//----------------------------------------------------------------------
	if (self.ad_dangle) {
		self.spawnflags = self.spawnflags | ad_MON_SWAMPLING_CEILING;
	}

	//----------------------------------------------------------------------
	// Ceiling swamplings have special idle animation
	// and need to let go of the ceiling before resuming any
	// normal behaviour (most think functions are intercepted)
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_SWAMPLING_CEILING) {
		self.ad_th_stand = self.ad_th_walk = ad_swampling_idleup1;
		self.ad_th_run = self.ad_th_slide = ad_swampling_wakeup;
		self.ad_th_melee = self.ad_th_missile = self.ad_th_jump = ad_swampling_wakeup;
		// th_pain and th_die functions understand ceiling swamplings
	}
	// Default swampling behaviour functions
	else {
		self.ad_th_stand = ad_swampling_idle1;
		self.ad_th_walk = ad_swampling_walk1;
		self.ad_th_run = ad_swampling_run1;
		self.ad_th_melee = ad_swampling_bite1;
		self.ad_th_slide = ad_swampling_slide1;
	}
	
	ad_monster_start();
};
