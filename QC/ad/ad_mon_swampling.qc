void()	ad_swampling_runp12	=[	$idle12,ad_swampling_runp13	] {ad_swampling_runpause();};
void()	ad_swampling_runp13	=[	$idle13,ad_swampling_runp1	] {ad_swampling_runpause();};

//----------------------------------------------------------------------
void(float ad_dist) ad_swampling_checkpause =
{
	// Do nothing is not to fight or dead
	if (!self.enemy) return;
	if (self.health < 1) return;

	// make swamplings run in bursts of speed (reset every run animation cycle)
	self.ad_movespeed = self.ad_movespeed + 1;
	// Do run code to check for enemies
	ad_ai_run(ad_dist + self.ad_movespeed);
	if (self.ad_enemydist < ad_MONAI_RUNPAUSE) return; // Too close

	// Random chance to stop and pause running
	if (self.ad_movespeed > 7 && random() < 0.2) {
		self.jump_flag = time + random();
		self.think = ad_swampling_runp1;
	}
};

//----------------------------------------------------------------------
void()	ad_swampling_run1 =[ $run1, ad_swampling_run2 ] {self.ad_movespeed = 0;
	ad_monster_idle_sound();
	ad_swampling_checkpause(8);
	// swamplings have constant problems with weird angles (X/Z)
	// Just keep resetting them so they move normally
	ad_ai_resetangles();
};
void()	ad_swampling_run2 =[ $run2, ad_swampling_run3 ] {ad_monster_footstep(ad_FALSE); ad_swampling_checkpause(6);};
void()	ad_swampling_run3 =[ $run3, ad_swampling_run4 ] {ad_swampling_checkpause(8);};
void()	ad_swampling_run4 =[ $run4, ad_swampling_run5 ] {ad_swampling_checkpause(10);};
void()	ad_swampling_run5 =[ $run1, ad_swampling_run6 ] {ad_swampling_checkpause(8);};
void()	ad_swampling_run6 =[ $run2, ad_swampling_run7 ] {ad_monster_footstep(ad_FALSE); ad_swampling_checkpause(6);};
void()	ad_swampling_run7 =[ $run3, ad_swampling_run8 ] {ad_swampling_checkpause(8);};
void()	ad_swampling_run8 =[ $run4, ad_swampling_run1 ] {ad_swampling_checkpause(10);};

//======================================================================
void()	ad_swampling_slide1	=[	$walk1,		ad_swampling_slide2	] {ad_ai_run_slide(6); ad_monster_idle_sound();};
void()	ad_swampling_slide2	=[	$walk2,		ad_swampling_slide3	] {ad_ai_run_slide(4);};
void()	ad_swampling_slide3	=[	$walk3,		ad_swampling_slide4	] {ad_ai_run_slide(6);};
