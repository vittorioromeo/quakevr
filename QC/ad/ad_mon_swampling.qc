//======================================================================
void() ad_swampling_runpause =
{
	// Do nothing is not to fight or dead
	if (!self.enemy) return;
	if (self.health < 1) return;

	if (self.jump_flag < time) self.ad_th_run();
	// Is the enemy too close? no more pausing, fight!
	self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
	if (self.ad_enemydist < ad_MONAI_RUNPAUSE) self.ad_th_run();
};

//----------------------------------------------------------------------
void()	ad_swampling_runp1	=[	$idle1,	ad_swampling_runp2	] {ad_swampling_runpause();};
void()	ad_swampling_runp2	=[	$idle2,	ad_swampling_runp3	] {ad_swampling_runpause();};
void()	ad_swampling_runp3	=[	$idle3,	ad_swampling_runp4	] {ad_swampling_runpause();};
void()	ad_swampling_runp4	=[	$idle4,	ad_swampling_runp5	] {ad_swampling_runpause();};
void()	ad_swampling_runp5	=[	$idle5,	ad_swampling_runp6	] {ad_swampling_runpause();};
void()	ad_swampling_runp6	=[	$idle6,	ad_swampling_runp7	] {ad_swampling_runpause();};
void()	ad_swampling_runp7	=[	$idle7,	ad_swampling_runp8	] {ad_swampling_runpause();};
void()	ad_swampling_runp8	=[	$idle8,	ad_swampling_runp9	] {ad_swampling_runpause();};
