void()	ad_dfury_standR1	=[	$standR1,	ad_dfury_standR2	] {ad_monster_idle_sound();
	if (random() < ad_MON_IDLE_ANIMATION && self.ad_weaponswitch < time) 
		self.think = ad_dfury_standRL1;	// Switch weapon stance
	ad_ai_stand();
};
