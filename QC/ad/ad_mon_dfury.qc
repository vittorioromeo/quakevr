//----------------------------------------------------------------------
void()	ad_dfury_standL1	=[	$standL1,	ad_dfury_standL2	] {ad_monster_idle_sound();
	self.ad_idlebusy = ad_FALSE;
	if (random() < ad_MON_IDLE_ANIMATION && self.ad_weaponswitch < time) {
		// Slow down the repeating of idle animations
		self.ad_weaponswitch = time + 1 + random()*3;
		self.ad_idlebusy = ad_TRUE;

		// Make sure the idle animations don't repeat in a row
		self.lefty = self.lip;
		while (self.lefty == self.lip) { self.lefty = rint(random()*4);}
		self.lip = self.lefty;

		if (self.lip < 2) self.think = ad_dfury_standC1;		// Look at weapon
		else if (self.lip == 2) self.think = ad_dfury_standB1;	// Look around
		else self.think = ad_dfury_standLR1;					// Switch weapon stance
	}
	ad_ai_stand();
};
