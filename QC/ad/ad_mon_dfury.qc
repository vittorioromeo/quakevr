// Identical frame set (Hell Knight / Death Knight)
// Speed boost (+16 charge) to all frames, fast charging attack!

void()	ad_dfury_watk1	=[	$w_attack2,	ad_dfury_watk3	] {ad_ai_charge(18);ad_monster_footstep(ad_FALSE);};
void()	ad_dfury_watk3	=[	$w_attack3,	ad_dfury_watk4	] {ad_ai_charge(18);};
void()	ad_dfury_watk4	=[	$w_attack4,	ad_dfury_watk5	] {ad_ai_charge(18);};
void()	ad_dfury_watk5	=[	$w_attack5,	ad_dfury_watk6	] {ad_ai_charge(18);ad_dfury_grunt_sound(ad_DFURY_SOUND_RUNSWING);};
void()	ad_dfury_watk6	=[	$w_attack6,	ad_dfury_watk7	] {ad_ai_charge(18);};
void()	ad_dfury_watk7	=[	$w_attack7,	ad_dfury_watk8	] {ad_ai_charge(19);ad_monster_footstep(ad_FALSE);};
void()	ad_dfury_watk8	=[	$w_attack8,	ad_dfury_watk9	] {ad_ai_charge(22);ad_dfury_sword_sound();ad_ai_melee();};
void()	ad_dfury_watk9	=[	$w_attack9,	ad_dfury_watk10] {ad_ai_charge(23);ad_ai_melee(); };
void()	ad_dfury_watk10=[	$w_attack10,ad_dfury_watk11] {ad_ai_charge(21); ad_ai_melee();};
void()	ad_dfury_watk11=[	$w_attack11,ad_dfury_watk12] {ad_ai_charge(19);};
void()	ad_dfury_watk12=[	$w_attack12,ad_dfury_watk13] {ad_ai_charge(19);};
void()	ad_dfury_watk13=[	$w_attack13,ad_dfury_watk14] {ad_ai_charge(18);};
void()	ad_dfury_watk14=[	$w_attack14,ad_dfury_watk15] {ad_ai_charge(18);ad_dfury_grunt_sound(ad_DFURY_SOUND_OPTIONAL);};
void()	ad_dfury_watk15=[	$w_attack15,ad_dfury_watk16] {ad_ai_charge(18);};
void()	ad_dfury_watk16=[	$w_attack16,ad_dfury_watk17] {ad_ai_charge(19);ad_dfury_sword_sound();ad_ai_melee();};
void()	ad_dfury_watk17=[	$w_attack17,ad_dfury_watk18] {ad_ai_charge(19); ad_monster_footstep(ad_FALSE); ad_ai_melee();};
void()	ad_dfury_watk18=[	$w_attack18,ad_dfury_watk19] {ad_ai_charge(21); ad_ai_melee();};
void()	ad_dfury_watk19=[	$w_attack19,ad_dfury_watk20] {ad_ai_charge(22);};
void()	ad_dfury_watk20=[	$w_attack20,ad_dfury_watk21] {ad_ai_charge(24);};
void()	ad_dfury_watk21=[	$w_attack21,ad_dfury_watk22] {ad_ai_charge(25);};
void()	ad_dfury_watk22=[	$w_attack22,ad_dfury_run1	] {ad_ai_charge(21);
	// this is a long animations set for chasing the player
	// Quick check if within melee range, close melee range or random magic attack!
	if (self.enemy.health > 0) {
		if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) self.think = ad_dfury_rswing3;
		else if (ad_ai_checkmelee(ad_MONAI_JUMPFURYNEAR,ad_FALSE)) self.think = ad_dfury_slice1;
		else if (random() < 0.3) self.think = ad_dfury_magic;
	}
};

//----------------------------------------------------------------------
void() ad_dfury_melee =
{
	// Use heavy overhead smash for monsters
	if (self.enemy.flags & ad_FL_MONSTER) ad_dfury_smash1();
	else {
		// Make sure next attack is different to previous (randomly while loop)
		self.lip = self.ad_meleeattack;
		while (self.lip == self.ad_meleeattack) { self.lip = rint(random()*2);	}
		self.ad_meleeattack = self.lip;
		if (self.ad_meleeattack == 0) ad_dfury_lswing1();			// Quick left
		else if (self.ad_meleeattack == 1) ad_dfury_rswing1();	// Quick right
		else ad_dfury_smash1();								// Overhead smash
	}
};

//===========================================================================
// Magic attacks (glowing swords)
//===========================================================================
// Magic Attack A - Spray of spikes from raised up swords
//----------------------------------------------------------------------
void(float ad_offset) ad_dfury_magica_shot =
{
	local float ad_shotcount;
	local vector ad_soffset, ad_dir, ad_offang;

	if (!self.enemy) return;
	if (self.health < 1) return;

	// Single sound per volley of bullets
	sound (self, ad_CHAN_WEAPON, "hknight/attack1.wav", 1, ad_ATTN_NORM);

	// Randomize quantity each time called
	if (random() < 0.5) ad_shotcount = 2;
	else ad_shotcount = 3;

	// based angle of projectiles on straight line between source and target
	ad_offang = vectoangles (self.enemy.origin - self.origin);
	ad_offang_y = ad_offang_y + ad_offset * 6;		// Arc offset
	makevectors (ad_offang);

	while (ad_shotcount > 0) {
		// Randomly spawn projectiles up and down sword length
		ad_soffset = v_forward * 20 + v_up * random() * 20;

		// Double check that missile is not blocked by any world geo
		if (!ad_visxray(self.enemy, ad_soffset, '0 0 0', ad_TRUE)) ad_soffset = ad_soffset + '0 0 24';
		ad_soffset = self.origin + ad_soffset;

		// Straight line velocity from source to target
		ad_dir = normalize (v_forward);
		ad_dir_z = 0 - ad_dir_z + (random() - 0.5)*0.1;	// Slight wiggle up/down
		
		// Variable speed based on skill level with extra random spice
		self.ad_attack_speed = ad_SPEED_DFURYSPIKE + (ad_skill * ad_SPEED_DFURYSKILL) + random()*10;
		ad_launch_projectile (ad_soffset, ad_dir, ad_CT_PROJ_FURY2, self.ad_attack_speed);
		ad_shotcount = ad_shotcount - 1;
	}
};

//----------------------------------------------------------------------
// Magic Attack B - 3 x rockets launched in an arc
//----------------------------------------------------------------------
void() ad_dfury_magicb_shot =
{
	local float ad_offset, ad_shotcount;
	local vector ad_soffset, ad_dir, ad_offang, ad_avel;

	if (!self.enemy) return;
	if (self.health < 1) return;

	// Single sound for all rockets fired
	sound (self, ad_CHAN_WEAPON, "hknight/attack1.wav", 1, ad_ATTN_NORM);

	// create an arc of rockets fanning outwards from source
	ad_offset = -4; ad_shotcount = 3;
	while (ad_shotcount > 0) {
	// based angle of projectiles on straight line between source and target
		ad_offang = vectoangles (self.enemy.origin - self.origin);
		ad_offang_y = ad_offang_y + ad_offset;
		makevectors (ad_offang);
	
		// Randomly spawn projectiles around central point
		ad_soffset = v_forward * 20 + v_up * (5 + random() * 10);
		
		// Double check that missile is not blocked by any world geo
		if (!ad_visxray(self.enemy, ad_soffset, '0 0 0', ad_TRUE)) ad_soffset = ad_soffset + '0 0 24';
		ad_soffset = self.origin + ad_soffset;
	
		// Straight line velocity from source to target
		ad_dir = normalize (v_forward);
		ad_dir_z = 0 - ad_dir_z + (random() - 0.5)*0.1;	// Slight wiggle up/down
		ad_avel = ad_vecrand(100,200,ad_FALSE);
		
		// Variable speed based on skill level with extra random spice
		self.ad_attack_speed = ad_SPEED_DFURYSPIKE + (ad_skill * ad_SPEED_DFURYSKILL) + random()*10;
		ad_Launch_Missile (ad_soffset, ad_dir, ad_avel, ad_CT_PROJ_FURY1, self.ad_attack_speed );
		ad_offset = ad_offset + 4;
		ad_shotcount = ad_shotcount - 1;
	}
};

//----------------------------------------------------------------------
void() ad_dfury_attachment_finish =
{
	if (self.state) {
		self.state = ad_FALSE;
		self.alpha = 0.1;
		setmodel(self, "");
	}
};

//----------------------------------------------------------------------
void(float ad_skincolor) ad_dfury_attachment_setup =
{
	if (self.ad_attachment && !self.ad_attachment.state) {
		self.ad_attachment.state = ad_TRUE;
		setmodel(self.ad_attachment, self.ad_weaponglow);
		self.ad_attachment.alpha = 0.1;
		self.ad_attachment.skin = ad_skincolor;
		setorigin(self.ad_attachment, self.origin);
		self.ad_attachment.angles = self.angles;
		self.ad_attachment.nextthink = time + 0.15;
		self.ad_attachment.think = ad_dfury_attachment_finish;
	}
};

//----------------------------------------------------------------------
void() ad_dfury_attachment_update =
{		
	if (self.ad_attachment && self.ad_attachment.state) {
		setorigin(self.ad_attachment, self.origin);
		self.ad_attachment.angles = self.angles;
		self.ad_attachment.frame = self.frame;
		self.ad_attachment.alpha = 0.3 + random()*0.7;
		self.ad_attachment.nextthink = time + 0.15;
		self.ad_attachment.think = ad_dfury_attachment_finish;
	}
};

