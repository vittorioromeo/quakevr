//----------------------------------------------------------------------
void() ad_dfury_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "hknight/death1.wav", 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dfury_die1 ();
		else ad_dfury_dieb1 ();
	}
};

//============================================================================
void() ad_dfury_sword_sound =
{
	self.ad_weaponstate = random();
	if (self.ad_weaponstate < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.ad_weaponstate < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.ad_weaponstate < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

//============================================================================
void(float ad_soundtype) ad_dfury_grunt_sound =
{
	if (ad_soundtype == ad_DFURY_SOUND_PULLAPART)
		sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt3.wav", 1, ad_ATTN_NORM);
	else if (ad_soundtype == ad_DFURY_SOUND_OVERSMASH)
		sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt4.wav", 1, ad_ATTN_NORM);
	else if (ad_soundtype == ad_DFURY_SOUND_JUMP)
		sound (self, ad_CHAN_WEAPON, "dknight/dfury_leap.wav", 1, ad_ATTN_NORM);
	else {
		if (ad_soundtype == ad_DFURY_SOUND_OPTIONAL && random() < 0.8) return;
		self.ad_weaponstate = random();
		self.ad_weaponswitch = 0.6 + random()*0.4;
		if (self.ad_weaponstate < 0.25) sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt1.wav", self.ad_weaponswitch, ad_ATTN_NORM);
		else if (self.ad_weaponstate < 0.5) sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt2.wav", self.ad_weaponswitch, ad_ATTN_NORM);
		else if (self.ad_weaponstate < 0.75) sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt3.wav", self.ad_weaponswitch, ad_ATTN_NORM);
		else sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt4.wav", self.ad_weaponswitch, ad_ATTN_NORM);
	}
};

/*======================================================================
QUAKED monster_dfury (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_dfury =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dfury.mdl";				// New death knight model
	self.ad_headmdl = "progs/h_dfury.mdl";				// Matching head
	self.ad_weaponglow = "progs/mon_dfury_glow.mdl";	// Weapon glow effect
	self.ad_gib1mdl = "progs/w_dfurysword1.mdl";		// Unique sword L
	self.ad_gib2mdl = "progs/w_dfurysword2.mdl";		// Unique sword R
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";		// right foot
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_weaponglow);		// Glowing magical swords
	precache_model (ad_MODEL_PROJ_FURY1);	// Vore spike ball with smoke trail
	precache_model (ad_MODEL_PROJ_FURY2);	// Wizard spit with smoke trail
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_gib3skin = 2;
	self.ad_gib1sound = self.ad_gib2sound = ad_GIB_IMPACT_METALA;

	self.ad_idle_sound = "hknight/idle.wav";
	precache_sound (self.ad_idle_sound);

	// Firing of magic spikes (first 0.1s must loop)
	precache_sound ("hknight/attack1.wav");
	precache_sound ("hknight/death1.wav");
	self.ad_pain_sound = "hknight/pain1.wav";
	precache_sound (self.ad_pain_sound);

	// TE_KNIGHTSPIKE = Magic spike hitting the wall
	// Has got to be in this location because the filename is hardcoded (engine.exe)
	precache_sound ("hknight/hit.wav");				

	// Double sword swipe (like death knight++)
	self.ad_sight_sound = "dknight/dfury_sight.wav";
	precache_sound (self.ad_sight_sound);
	
	// Heavy thud sound	
	self.ad_meleehitsound = ad_GIB_SOUND_HEAVY2;
	precache_sound (self.ad_meleehitsound);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");

	// New grunt sounds during combat
	precache_sound ("dknight/dfury_grunt1.wav");
	precache_sound ("dknight/dfury_grunt2.wav");
	precache_sound ("dknight/dfury_grunt3.wav");
	precache_sound ("dknight/dfury_grunt4.wav");
	precache_sound ("dknight/dfury_leap.wav");

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_SHALGRN);	// Green voreball
	}

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 400;
	self.ad_gibhealth = -50;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 80;
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_pain_timeout = 2;				// High pain level
	if (self.ad_infightextra <= 0) self.ad_infightextra = 2; // 2x infighting dmg
	self.ad_steptype = ad_FS_TYPEMEDIUM;
	self.ad_meleecontact = ad_FALSE;			// Smash contact
	self.ad_meleerange = ad_MONAI_MELEEFRONT;	// Smash attack
	self.ad_meleeoffset = '24 0 16';		// Jump attack offset
	self.ad_attack_offset = '20 0 10';		// Average of both attacks
	self.ad_deathstring = " was sliced by a Fury Knight\n";

	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '500 0 250';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPFURYNEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPFURYFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_DFuryCheckAttack;
	self.ad_th_stand = ad_dfury_standL1;
	self.ad_th_walk = ad_dfury_walk1;
	self.ad_th_run = ad_dfury_run1;
	self.ad_th_melee = ad_dfury_melee;
	self.ad_th_missile = ad_dfury_magic;
	self.ad_th_pain = ad_dfury_pain;
	self.ad_th_die = ad_dfury_die;
	self.ad_th_jump = ad_dfury_lunge1;
	self.ad_th_jumpexit = ad_dfury_lunge9;
	self.ad_th_charge = ad_dfury_watk1;
	self.ad_th_slide = ad_dfury_slice1;
	
	self.ad_meleeattack = rint(random()*5);
	self.ad_weaponswitch = time + 5;
	
	self.ad_classtype = ad_CT_MONDFURY;
	self.ad_classgroup = ad_CG_DCAPTAIN;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	// Setup magic glowing sword effect
	self.ad_attachment = spawn();
	self.ad_attachment.owner = self;
	self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
	setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	self.ad_attachment.solid = ad_SOLID_NOT;
	setorigin(self.ad_attachment, self.origin);
	
	ad_monster_start();
};
