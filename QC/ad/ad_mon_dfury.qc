	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE) && self.enemy.health > 0) self.think = ad_dfury_rswing3;
};

//----------------------------------------------------------------------
// Melee Attack 3 - Lunge forward (leaving ground) and do heavy damage
void() ad_dfury_JumpTouch =
{
	local float ad_ldmg;
	
	if (self.health < 1) return;
	ad_ai_jumpbreakable(30);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	if ( ad_CanDamage(other, self) ) {
		if ( vlen(self.velocity) > 300 ) {
		  ad_ldmg = 20 + 10*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
		}
	}

	// Is the fury knight floating in the air?
	if (!checkbottom(self)) {
		// Is the fury knight standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void()	ad_dfury_lunge1	=[	$lunge1,	ad_dfury_lunge2	] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPFURYTIME;
	ad_dfury_grunt_sound(ad_DFURY_SOUND_JUMP);
};
void()	ad_dfury_lunge2	=[	$lunge2,	ad_dfury_lunge3	] {ad_ai_face();};
void()	ad_dfury_lunge3	=[	$lunge3,	ad_dfury_lunge4	] {ad_ai_face();};
void()	ad_dfury_lunge4	=[	$lunge4,	ad_dfury_lunge5	] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPFURYTIME;
	self.touch = ad_dfury_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

void()	ad_dfury_lunge5	=[	$lunge5,	ad_dfury_lunge6	] {};
void()	ad_dfury_lunge6	=[	$lunge6,	ad_dfury_lunge7	] {};
void()	ad_dfury_lunge7	=[	$lunge7,	ad_dfury_lunge8	] {};
void()	ad_dfury_lunge8	=[	$lunge8,	ad_dfury_lunge8	] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; 	//random jump angle
		self.think = ad_dfury_lunge4;			// Keep jumping
	}
	self.oldorigin = self.origin;
};

//----------------------------------------------------------------------
// Landed with thrush attack
void()	ad_dfury_lunge9	=[	$lunge9,	ad_dfury_lunge10	] {ad_ai_melee();};
void()	ad_dfury_lunge10	=[	$lunge10,	ad_dfury_lunge11	] {ad_ai_charge(5);ad_ai_melee();};
void()	ad_dfury_lunge11	=[	$lunge11,	ad_dfury_lunge12	] {ad_ai_charge(4);ad_ai_melee();ad_dfury_sword_sound();};
void()	ad_dfury_lunge12	=[	$lunge12,	ad_dfury_lunge13	] {ad_ai_charge(1);ad_ai_melee();};
void()	ad_dfury_lunge13	=[	$lunge13,	ad_dfury_lunge14	] {ad_ai_charge(1);ad_ai_melee();ad_monster_footstep(ad_FALSE);};
void()	ad_dfury_lunge14	=[	$lunge14,	ad_dfury_lunge15	] {ad_ai_charge(1);};
void()	ad_dfury_lunge15	=[	$lunge15,	ad_dfury_run1	] {ad_ai_resetangles();
	// If close enough starting swinging left+right ELSE return to run cycle
	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE) && self.enemy.health > 0) self.think = ad_dfury_rswing3;
};

//----------------------------------------------------------------------
