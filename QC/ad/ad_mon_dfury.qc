void()	ad_dfury_magicb13 =[	$magica13,	ad_dfury_run1] {};

//----------------------------------------------------------------------
// MagicB is explosive so only use if there is range available
// Otherwise randomly pick between the two types (spikes/rockets)
//----------------------------------------------------------------------
void() ad_dfury_magic =
{
	ad_SUB_AttackFinished (2 + random());
	self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
	if (self.ad_enemydist < ad_MONAI_JUMPFURYNEAR) ad_dfury_magica1();
	else {
		if (random() < 0.2) ad_dfury_magica1();
		else ad_dfury_magicb1();
	}
};

