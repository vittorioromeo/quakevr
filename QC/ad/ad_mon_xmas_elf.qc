//----------------------------------------------------------------------
void() ad_elf_die =
{
	// Sync cane to elf skin
	self.ad_gib1skin = self.ad_exactskin;

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		// Pick a random death sound
		if (random() > 0.5)
			sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		else 
			sound (self, ad_CHAN_VOICE, self.ad_death_sound2, 1, ad_ATTN_NORM);

		// Pick a random fall direction
		if (random() > 0.5) ad_elf_die1 ();
		else ad_elf_dieb1 ();
	}
};

/*======================================================================
QUAKED monster_xmas_elf (1 0 0) (-16 -16 -24) (16 16 16) Ambush
======================================================================*/
void() ad_monster_xmas_elf =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/xmas/mon_elf.mdl";		// Crazy Grinning Fool
	self.ad_headmdl = "progs/xmas/h_elf.mdl";		// Shrunken Head
	self.ad_gib1mdl = "progs/xmas/gib_elfcane.mdl";// Candy Cane
	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);				// Grinning Pointy Hat
	precache_model (self.ad_gib1mdl);				// Sugar Cane
	precache_model (ad_MODEL_PROJ_ELF);			// Magic ice
	
	// Idle calm/angry
	self.ad_idle_sound = "xmas/elf/idle.wav";		// Lots of giggling
	precache_sound (self.ad_idle_sound);

	// Many different sight sounds (2 is very annoying)
	self.ad_sight_sound = "xmas/elf/sight1.wav";	// Snarling sound
	self.ad_sight_sound2 = "xmas/elf/sight2.wav";	// DIE HUMAN!?!
	self.ad_sight_sound3 = "xmas/elf/sight3.wav";	// Screams
	self.ad_sight_sound4 = "xmas/elf/sight4.wav";	// Screams
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_sight_sound2);
	precache_sound (self.ad_sight_sound3);
	precache_sound (self.ad_sight_sound4);
	self.ad_sight_count = 4;

	// Elf 1 - Melee/Jump attacks - cane impacts
	precache_sound ("xmas/elf/cane_swipe1.wav");
	precache_sound ("xmas/elf/cane_swipe2.wav");
	precache_sound ("xmas/elf/cane_hit1.wav");
	precache_sound ("xmas/elf/cane_hit2.wav");
	precache_sound ("xmas/elf/jump1.wav");
	precache_sound ("xmas/elf/jump2.wav");
	
	// Elf 2 - Magic attacks
	precache_sound ("xmas/elf/magic.wav");
	precache_sound ("xmas/elf/attack1.wav");
	precache_sound ("xmas/elf/miss.wav");
	
	// precache sight, pain and death (changes on type)
	self.ad_pain_sound = "xmas/elf/pain.wav";
	self.ad_death_sound = "xmas/elf/death1.wav";
	self.ad_death_sound2 = "xmas/elf/death2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);
	
	if (self.spawnflags & ad_MON_ELF_MAGIC) {
		if (self.health < 1) self.health = 75;
		self.ad_gibhealth = -25;
		self.ad_th_missile = ad_elf_magic1;
		self.ad_exactskin = 2;
	}
	else {
		if (self.health < 1) self.health = 30;
		self.ad_gibhealth = -20;
		self.ad_th_jump = ad_elf_leap1;
		self.ad_th_jumpexit = ad_elf_leap7;
		// pick a random one instead
		if (self.ad_exactskin < 0 || self.ad_exactskin > 1) self.ad_exactskin = 0;
		if (self.ad_exactskin == 0 && random() < 0.5) self.ad_exactskin = 1;
	}
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	self.ad_gibbed = ad_FALSE;				// Still in one peice
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_pain_flinch = 10;				// Light pain threshold
	self.ad_steptype = ad_FS_TYPELIGHT;		// Very light feet
	self.ad_meleeoffset = '20 0 20';		// Cane attack offset
	self.ad_attack_offset = '10 0 4';		// Magic attack offset
	self.ad_poisonous = ad_FALSE;				// Not Supported
	self.ad_deathstring = " was torn to pieces by a Elf\n";

	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '400 0 200';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPELFNEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPELFFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_ElfCheckAttack;
	self.ad_th_stand = ad_elf_stand1;
	self.ad_th_walk = ad_elf_walk1;
	self.ad_th_run = ad_elf_run1;
	self.ad_th_melee = ad_elf_cane1;
	self.ad_th_slide = ad_elf_slide1;
	self.ad_th_pain = ad_elf_pain;
	self.ad_th_die = ad_elf_die;

	self.ad_classtype = ad_CT_MONELF;
	self.ad_classgroup = ad_CG_XMAS;
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
};