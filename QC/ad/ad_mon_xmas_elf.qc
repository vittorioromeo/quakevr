//======================================================================
// ELF 2 - SPRAY MAGIC (Range)
//======================================================================
void(float ad_sideang) ad_elf_shot =
{
	local	vector ad_org, ad_ang, ad_dir, ad_avel;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
		
	// Flash effect to show where projectile is coming from	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	if (ad_sideang < 0) sound (self, ad_CHAN_WEAPON, "xmas/elf/attack1.wav", 1, ad_ATTN_NORM);

	makevectors (self.angles);	
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	// Create elevation angle and use makevectors to create projectile direction
	ad_ang = vectoangles(self.enemy.origin - ad_org);
	ad_ang_x = -self.ad_attack_elev;	// Negative = upwards angle 
	makevectors (ad_ang);
	// fire magic in arc pattern (sideang)
	ad_dir = (v_forward + v_right * ad_sideang) * ad_SPEED_ELF;	

	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_ELF);
};

