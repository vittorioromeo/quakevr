//======================================================================
// ELF 1 - SWING CANE - Both elf types can swing cane if within range
//======================================================================
void() ad_elf_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);
	ad_ai_damagebreakable(10);
	if (!(ad_ai_checkmelee(ad_MONAI_MELEEELF,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return; // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	if (random() < 0.5) sound(self, ad_CHAN_VOICE, "xmas/elf/cane_hit1.wav", 1, ad_ATTN_NORM);
	else sound(self, ad_CHAN_VOICE, "xmas/elf/cane_hit2.wav", 1, ad_ATTN_NORM);

	// Cane Impact (damage 1-9) is very weak
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Spawn blood at cane of elf
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
}

//----------------------------------------------------------------------
void() ad_elf_cane1 = [ $attack1, ad_elf_cane2 ] {ad_ai_charge(5);
	if (random() < 0.5) sound(self, ad_CHAN_WEAPON, "xmas/elf/cane_swipe1.wav", 1, ad_ATTN_NORM);
	else sound(self, ad_CHAN_WEAPON, "xmas/elf/cane_swipe2.wav", 1, ad_ATTN_NORM);	
};
void() ad_elf_cane2 = [ $attack2, ad_elf_cane3 ] {ad_ai_charge(5);};
void() ad_elf_cane3 = [ $attack3, ad_elf_cane4 ] {ad_elf_melee();};
void() ad_elf_cane4 = [ $attack4, ad_elf_cane5 ] {};
void() ad_elf_cane5 = [ $attack5, ad_elf_run1 ] {
	if (ad_ai_checkmelee(ad_MONAI_MELEEELF,ad_FALSE) && self.enemy.health > 0) {
		if (self.health > 0) self.think = ad_elf_cane1;
	}
};

//======================================================================
// ELF 1 - JUMP FUNCTION (range)
//======================================================================
void()	ad_Elf_JumpTouch =
{
	local	float	ad_ldmg;

	if (self.health <= 0) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	// Do not damage other elves with jump attacks
	// Prevents packs from killing themselves
	if (self.ad_classtype != other.ad_classtype && other.takedamage) {
		if ( vlen(self.velocity) > 300 ) {
			ad_ldmg = 5 + 5*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			// Spawn some touch blood (no explicit direction)
			ad_spawn_touchblood (self.enemy, self.enemy, ad_ldmg*3);
		}
	}

	// Is the elf floating in the air?
	if (!checkbottom(self)) {
		// Is the elf standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_elf_leap1 =[ $jump1, ad_elf_leap2 ] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	if (random() < 0.5) sound(self, ad_CHAN_WEAPON, "xmas/elf/jump1.wav", 1, ad_ATTN_NORM);
	else sound(self, ad_CHAN_WEAPON, "xmas/elf/jump2.wav", 1, ad_ATTN_NORM);
};
void() ad_elf_leap2 =[ $jump2, ad_elf_leap3 ] {ad_ai_face();};
void() ad_elf_leap3 =[ $jump3, ad_elf_leap4 ] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	self.touch = ad_Elf_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.origin_z = self.origin_z + 4;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};
void() ad_elf_leap4 =[ $jump4, ad_elf_leap5 ] {};
void() ad_elf_leap5 =[ $jump5, ad_elf_leap6 ] {};
void() ad_elf_leap6 =[ $jump6, ad_elf_leap7 ] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_elf_leap3;
	}
	self.oldorigin = self.origin;
};

//----------------------------------------------------------------------
void() ad_elf_leap7 =[ $jump7, ad_elf_leap8] {ad_monster_footstep(ad_FALSE);};
void() ad_elf_leap8 =[ $jump8, ad_elf_run1] {ad_ai_resetangles();};

//======================================================================
// Elven Pain!
//======================================================================
void() ad_elf_pain1 = [ $pain1, ad_elf_pain2 ] {};
void() ad_elf_pain2 = [ $pain2, ad_elf_pain3 ] {};
void() ad_elf_pain3 = [ $pain3, ad_elf_pain4 ] {};
void() ad_elf_pain4 = [ $pain4, ad_elf_pain5 ] {};
void() ad_elf_pain5 = [ $pain5, ad_elf_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_elf_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_elf_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_axhitme = 0;
			self.ad_pain_finished = time + 1;
			ad_elf_pain1 ();
		}
	}
};

