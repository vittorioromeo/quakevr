//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_deflect_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		self.lip = random ();
		if (self.lip < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);

		// Turn off shield
		ad_deflect_shieldoff();
		ad_deflect_shieldsound_off();
		
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			if (self.lip < 0.2) ad_deflect_paina1 ();
			else if (self.lip < 0.4) ad_deflect_painb1 ();
			else if (self.lip < 0.7) ad_deflect_painc1 ();
			else {
				self.ad_pain_finished = time + 2;
				ad_deflect_paind1 ();
			}
		}
		// The new axe forces monsters into long pain animations
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 1.9;
			self.ad_axhitme = 0;
			ad_deflect_paind1 ();
		}
	}
};

//============================================================================
void() ad_deflect_die1=[ $death1, ad_deflect_die2] {};
void() ad_deflect_die2=[ $death2, ad_deflect_die3] {ad_monster_check_gib();};
void() ad_deflect_die3=[ $death3, ad_deflect_die4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT; if (!self.ad_gibbed) ad_DropBackpack();};
void() ad_deflect_die4=[ $death4, ad_deflect_die5] {ad_ai_forward(14);};
void() ad_deflect_die5=[ $death5, ad_deflect_die6] {ad_ai_forward(2);};
