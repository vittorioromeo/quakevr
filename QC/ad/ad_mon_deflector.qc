// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
 The Deflector (Original from Zerstorer MOD)
 * I Added Yellow skin and modified blue skin to match better
 
 Originally had 150 HP, fired a plasma bolt and 'drunk' rockets
 The shield was a 100% no damage setup and only down when attacking.
 Personally I found the shield confusing at first because it
 never had any visual feedback that nothing was doing damage.
 
==============================================================================*/

// 000-007 (No Shield)
$frame stand1 stand2 stand3 stand4 stand5 stand6 stand7

// 008-022 (Shield active)
$frame walk1 walk2 walk3 walk4 walk5 walk6 walk7 walk8
$frame walk9 walk10 walk11 walk12 walk13 walk14 walk15 walk16

// 023-030 (Shield active)
$frame run1 run2 run3 run4 run5 run6 run7 run8

// 031-050 (Plasma Cannon)
$frame attack1 attack2 attack3 attack4 attack5 attack6 attack7 attack8
$frame attack9 attack10 attack11 attack12 attack13 attack14 attack15 attack16
$frame attack17 attack18 attack19 attack20

// 051-064 (No Shield)
$frame death1 death2 death3 death4 death5 death6 death7 death8
$frame death9 death10 death11 death12 death13 death14

// 065-075 (No Shield)
$frame fdeath1 fdeath2 fdeath3 fdeath4 fdeath5 fdeath6 fdeath7 fdeath8
$frame fdeath9 fdeath10 fdeath11

// A=076-079 B=080-084 C=085-092 D=093-111
$frame paina1 paina2 paina3 paina4
$frame painb1 painb2 painb3 painb4 painb5
$frame painc1 painc2 painc3 painc4 painc5 painc6 painc7 painc8
// Stumble forward
$frame paind1 paind2 paind3 paind4 paind5 paind6 paind7 paind8
$frame paind9 paind10 paind11 paind12 paind13 paind14 paind15 paind16
$frame paind17 paind18 paind19

// 112-118 (Rocket Attack)
$frame attackp1 attackp2 attackp3 attackp4 attackp5 attackp6 attackp7

// 119-125 (Shield turns on/off)
$frame fieldon1 fieldon2 fieldon3 fieldon4 fieldon5 fieldon6 fieldon7

//----------------------------------------------------------------------
// Shield status (IDLE=OFF, WALK=ON, RUN=ON)
//----------------------------------------------------------------------
float ad_DEFLECT_IDLE = 0;
float ad_DEFLECT_WALK = 1;
float ad_DEFLECT_RUN = 2;

//===========================================================================
void() ad_deflect_shieldon =
{
	self.takedamage = ad_DAMAGE_YES;	// Grenades bounce off
	self.ad_bouncegrenade = ad_TRUE;		// Warning to other monsters
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage
	// Visually show resistance and reduce damage taken
	self.ad_resist_shells = self.ad_resist_nails = 0.25;
	self.ad_resist_rockets = 0.25; self.ad_resist_cells = 0.75;
};

//----------------------------------------------------------------------
void() ad_deflect_shieldoff =
{
	self.takedamage = ad_DAMAGE_AIM;	// Grenades can make contact
	self.ad_bouncegrenade = ad_FALSE;		// Reset to default
	self.ad_reflectnails = ad_FALSE;		// Allow nail projectiles
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectaxe = ad_FALSE;		// Allow axe damage
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = 0; self.ad_resist_cells = 0.5;
};

//----------------------------------------------------------------------
void() ad_deflect_shieldsound_on = {
	sound (self, ad_CHAN_ITEM, "deflector/shield_on.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
void() ad_deflect_shieldsound_off = {
	sound (self, ad_CHAN_ITEM, "deflector/shield_off.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
void() ad_deflect_shieldparticle = {
	self.pos1 = self.origin;
	// Randomize position from middle to feet (particles float up)
	self.pos1_z = self.pos1_z - (random()*20);
	self.cnt = rint(5 + random()*10);
	if (self.spawnflags & ad_MON_DEFLECTOR_PLASMA)
		ad_particle_explode(self.pos1, self.cnt, 1, ad_PARTICLE_BURST_BLUE, ad_PARTICLE_BURST_UPWARD); 
	else
		ad_particle_explode(self.pos1, self.cnt, 1, ad_PARTICLE_BURST_YELLOW, ad_PARTICLE_BURST_UPWARD); 
};

//===========================================================================
void() ad_deflect_stands7;	// Forward compiler reference
void() ad_deflect_stand1=[ $stand1, ad_deflect_stand2] {ad_ai_stand();

	// Work out if shield was on before this state
	if (self.ad_weaponstate == ad_DEFLECT_WALK && self.health > 0) {
		self.ad_weaponstate = ad_DEFLECT_IDLE;
		ad_deflect_stands7();
	}
	// No idle sound at same time as shield sound
	else ad_monster_idle_sound();
};
// Switch off shield (reverse animation)
void() ad_deflect_stands7=[ $fieldon7, ad_deflect_stands6] {ad_ai_stand();
	ad_deflect_shieldoff();ad_deflect_shieldsound_off();};
void() ad_deflect_stands6=[ $fieldon6, ad_deflect_stands5] {ad_ai_stand();};
void() ad_deflect_stands5=[ $fieldon5, ad_deflect_stand2] {ad_ai_stand();};

