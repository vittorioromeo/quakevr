//----------------------------------------------------------------------
void() ad_deflect_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		// Turn off shield
		ad_deflect_shieldsound_off();

		// Typical forward/backward death + unique sound
		if (random() > 0.5) {
			ad_deflect_die1 ();
			sound (self, ad_CHAN_VOICE, self.ad_death_sound2, 1, ad_ATTN_NORM);
		}
		else {
			ad_deflect_fdie1 ();
			sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		}
	}
};

/*======================================================================
 QUAKED monster_deflector (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_deflector =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_deflector.mdl";
	self.ad_headmdl = "progs/h_deflector.mdl";
	self.ad_gib1mdl = "progs/w_enforcergun.mdl";	// Unique weapon
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;	// Gib sound for gun

	// Melee attack (Fire/plasma)
	precache_sound ("deflector/melee_attack.wav");

	// Alternative spawnflag, lasers instead of mines
	if (self.spawnflags & ad_MON_DEFLECTOR_PLASMA) {
		// Original BLUE version (plasma/rocket)
		self.ad_exactskin = 1;		// Blue armour
		self.ad_gib1skin = 3;		// Blue weapon
		self.ad_part_trstyle = ad_PARTICLE_TRAIL_BLUE;
		self.ad_dpp_name = ad_DPP_TRAILPARTB;			// Projectile particles
		// Range attack (Blue laser model)
		precache_model (ad_MODEL_PROJ_LASERBLUE);
		precache_sound (ad_SOUND_LASER_FIRE);
		precache_sound (ad_SOUND_LASER_HIT);
		precache_sound (ad_SOUND_LASER_RIC);
	}
	else {
		// New YELLOW version (flame/rocket)
		// Melee attack (Projectile Flames)
		ad_PreCache_Flame();
		precache_sound ("deflector/flame_fire.wav");
		precache_sound ("deflector/flame_explode.wav");
		// Range attack (rocket model)
		precache_model (ad_MODEL_PROJ_ROCKET);
	}
	
	self.ad_idle_sound = "deflector/idle1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_count = 3;
	self.ad_sight_sound = "deflector/sight1.wav";
	self.ad_sight_sound2 = "deflector/sight2.wav";
	self.ad_sight_sound3 = "deflector/sight3.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_sight_sound2);
	precache_sound (self.ad_sight_sound3);
	
	// Shield off, shield on!
	precache_sound ("deflector/shield_off.wav");
	precache_sound ("deflector/shield_on.wav");

	// Projectile fire and impact (used in projectiles)
	precache_sound ("deflector/rocket_load.wav");
	precache_sound ("deflector/rocket_fire.wav");
	precache_sound ("deflector/rocket_hit.wav");

	// Extra load/fire sounds
	precache_sound (ad_SOUND_PLASMA_LOAD);
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);

	// Plenty of death and pain sounds
	self.ad_pain_sound = "deflector/pain1.wav";
	self.ad_pain_sound2 = "deflector/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	self.ad_death_sound = "deflector/death1.wav";
	self.ad_death_sound2 = "deflector/death2.wav";
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 250;
	// The Deflector is really just a monster with lots of attacks and HP++
	// It don't need bossflag protection, the combat is standard stuff
	//self.bossflag = TRUE;				// Boss flag (like FL_MONSTER)

	self.ad_gibhealth = -50;
	self.ad_gibbed = ad_FALSE;				// Starts complete
	self.ad_pain_flinch = 400;				// High pain threshold
	self.ad_pain_longanim = ad_FALSE;			// cannot be chopped with shadow axe
	self.ad_pain_timeout = 2;				// High pain threshold
	self.ad_infightextra = 4;				// High infighting damage
	self.ad_steptype = ad_FS_TYPEHEAVY;		// heavy player
	self.ad_poisonous = ad_FALSE;				// No Poison version
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	self.ad_weaponstate = ad_DEFLECT_IDLE;	// No Shield active
	self.ad_meleeoffset = '8 8 28';		// Shoulder gun
	self.ad_attack_offset = '28 8.5 16';	// End of Gun
	self.ad_deathstring = " was crushed by the Deflector\n";
	// Setup default timer/counters
	self.ad_attack_count = self.ad_attack_timer = 0;
	self.ad_part_exitpuff = self.ad_part_exitsound = ad_TRUE;
	
	// Setup default burst mode (=-1 to disable, def=TRUE)
	if (self.ad_attack_rage < 0) self.ad_attack_rage = ad_FALSE;
	else if (self.ad_attack_rage >= 0) self.ad_attack_rage = ad_TRUE;
	// Default is half flame limit for burst mode
	if (self.ad_attack_rage == ad_TRUE && self.ad_proj_limit == 0)
		self.ad_proj_limit = ad_PROJ_MAXLIMIT * 0.5;
	
	// Plasma and flame have different projectile limits
	if (self.spawnflags & ad_MON_DEFLECTOR_PLASMA) {
		if (self.ad_proj_attqty_z <= 0) self.ad_proj_attqty_z = ad_MONAI_DEFLECTMAX; }
	else {
		// Setup default Proj Count = Base (X) * (Skill * Y) Maximum = Z
		if (ad_CheckZeroVector(self.ad_proj_attqty)) self.ad_proj_attqty = '3 2 7'; }

	// ALL ammo resistances done in shield functions
	ad_deflect_shieldoff();
	
	self.ad_th_checkattack = ad_DeflectorCheckAttack;
	self.ad_th_stand = ad_deflect_stand1;
	self.ad_th_walk = ad_deflect_walk1;
	self.ad_th_run = ad_deflect_slow1;
	self.ad_th_melee = ad_deflect_melee;
	self.ad_th_missile = ad_deflector_range;
	self.ad_th_pain = ad_deflect_pain;
	self.ad_th_die = ad_deflect_die;

	self.ad_classtype = ad_CT_MONDEFLECTOR;
	self.ad_classgroup = ad_CG_DCAPTAIN;
	self.ad_classmove = ad_MON_MOVEWALK;

	// Start monster (default)
	ad_monster_start();
};