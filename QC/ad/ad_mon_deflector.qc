void() ad_deflect_walks5;	// Forward compiler reference
void() ad_deflect_walk1=[ $walk1, ad_deflect_walk2] {ad_ai_walk(2);
	// Work out if shield was on before this state
	if (self.ad_weaponstate == ad_DEFLECT_IDLE && self.health > 0) {
		self.ad_weaponstate = ad_DEFLECT_WALK;
		ad_deflect_walks5();
	}
	// No idle sound at same time as shield sound
	else ad_monster_idle_sound();
};
// Switch on shield (forward animation)
void() ad_deflect_walks5=[ $fieldon5, ad_deflect_walks6] {ad_ai_walk(0);
	ad_deflect_shieldon();ad_deflect_shieldsound_on();};
void() ad_deflect_walks6=[ $fieldon6, ad_deflect_walks7] {ad_ai_walk(0);};
void() ad_deflect_walks7=[ $fieldon7, ad_deflect_walk2] {ad_ai_walk(0);};

