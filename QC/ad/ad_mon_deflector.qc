void() ad_deflect_walk6=[ $walk6, ad_deflect_walk7] {ad_ai_walk(2);};
void() ad_deflect_walk7=[ $walk7, ad_deflect_walk8] {ad_ai_walk(2);};
void() ad_deflect_walk8=[ $walk8, ad_deflect_walk9] {ad_ai_walk(1);};
void() ad_deflect_walk9=[ $walk9, ad_deflect_walk10] {ad_ai_walk(2);};
void() ad_deflect_walk10=[ $walk10, ad_deflect_walk11] {
	ad_deflect_shieldparticle(); ad_monster_footstep(ad_FALSE); ad_ai_walk(4);};
void() ad_deflect_walk11=[ $walk11, ad_deflect_walk12] {ad_ai_walk(4);};
void() ad_deflect_walk12=[ $walk12, ad_deflect_walk13] {ad_ai_walk(1);};
void() ad_deflect_walk13=[ $walk13, ad_deflect_walk14] {ad_ai_walk(2);};
void() ad_deflect_walk14=[ $walk14, ad_deflect_walk15] {ad_ai_walk(3);};
void() ad_deflect_walk15=[ $walk15, ad_deflect_walk16] {ad_ai_walk(4);};
void() ad_deflect_walk16=[ $walk16, ad_deflect_walk1] {ad_ai_walk(2);};

//===========================================================================
// Two speed run animation based on enemy visibility
//===========================================================================
void()	ad_deflect_slow1;
void()	ad_deflect_fast1;

// run state has two animation speeds (single function required)
void(float ad_movespd) ad_deflect_run =
{
	// Block all checks if dead
	if (self.health < 1) return;
	// idle functions work for both animation sets
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	
	// Work out if shield was on/off before this state
	if (self.ad_weaponstate == ad_DEFLECT_IDLE) {
		self.ad_weaponstate = ad_DEFLECT_RUN;
		ad_deflect_shieldsound_on();
	}
	// Both walk/run animations have shield on!
	ad_deflect_shieldon();
		
	// Change animation set based on enemy visibilty
	// Ignore frame 0 for checks (endless loop)
	// Make sure animations don't switch too rapid (timer)
	if (self.enemy) {
		if (self.ad_walkframe > 0 && self.ad_attack_switch < time) {
			// Prevent rapid switching (attack_switch)
			self.ad_attack_switch = time + 1 + random();
			ad_enemy_vis = ad_visible(self.enemy);
			if (!ad_enemy_vis) self.think = ad_deflect_fast1;
			else self.think = ad_deflect_slow1;
		}
	}
	
	// Check run/attack functions
	ad_ai_run(ad_movespd);
	// Walk through animation sets (reset on frame 0)
	self.ad_walkframe = self.ad_walkframe + 1;
};

// Walk animation with 150% movement speed
//----------------------------------------------------------------------
void()	ad_deflect_slow1=[ $walk1,	ad_deflect_slow2 ] {self.ad_walkframe=0;ad_deflect_run(3);};
void()	ad_deflect_slow2=[ $walk2,	ad_deflect_slow3 ] {
	ad_deflect_shieldparticle(); ad_monster_footstep(ad_FALSE); ad_deflect_run(6);
};
void()	ad_deflect_slow3=[ $walk3, ad_deflect_slow4 ] {ad_deflect_run(6);};
void()	ad_deflect_slow4=[ $walk4, ad_deflect_slow5 ] {ad_deflect_run(4.5);};
void()	ad_deflect_slow5=[ $walk5, ad_deflect_slow6 ] {ad_deflect_run(1.5);};
void()	ad_deflect_slow6=[ $walk6, ad_deflect_slow7 ] {ad_deflect_run(3);};
void()	ad_deflect_slow7=[ $walk7, ad_deflect_slow8 ] {ad_deflect_run(3);};
void()	ad_deflect_slow8=[ $walk8, ad_deflect_slow9 ] {ad_deflect_run(1.5);};
void()	ad_deflect_slow9=[ $walk9, ad_deflect_slow10] {ad_deflect_run(3);};
void()	ad_deflect_slow10=[ $walk10, ad_deflect_slow11] {
	ad_deflect_shieldparticle(); ad_monster_footstep(ad_FALSE); ad_deflect_run(6);
};
void()	ad_deflect_slow11=[ $walk11, ad_deflect_slow12] {ad_deflect_run(6);};
void()	ad_deflect_slow12=[ $walk12, ad_deflect_slow13] {ad_deflect_run(1.5);};
void()	ad_deflect_slow13=[ $walk13, ad_deflect_slow14] {ad_deflect_run(3);};
void()	ad_deflect_slow14=[ $walk14, ad_deflect_slow15] {ad_deflect_run(4.5);};
void()	ad_deflect_slow15=[ $walk15, ad_deflect_slow16] {ad_deflect_run(6);};
void()	ad_deflect_slow16=[ $walk16, ad_deflect_slow1] {ad_deflect_run(3);};

// Typical run animation (used when enemy out of sight)
//----------------------------------------------------------------------
void()	ad_deflect_fast1=[ $run1, ad_deflect_fast2] {self.ad_walkframe=0;ad_deflect_run(18); };
void()	ad_deflect_fast2=[ $run2, ad_deflect_fast3] {ad_deflect_run(14);};
void()	ad_deflect_fast3=[ $run3, ad_deflect_fast4] {
	ad_deflect_shieldparticle(); ad_monster_footstep(ad_FALSE); ad_deflect_run(7);
};
void()	ad_deflect_fast4=[ $run4, ad_deflect_fast5] {ad_deflect_run(12);};
void()	ad_deflect_fast5=[ $run5, ad_deflect_fast6] {ad_deflect_run(14);};
void()	ad_deflect_fast6=[ $run6, ad_deflect_fast7] {ad_deflect_run(14);};
void()	ad_deflect_fast7=[ $run7, ad_deflect_fast8] {
	ad_deflect_shieldparticle(); ad_monster_footstep(ad_FALSE); ad_deflect_run(7);
};
void()	ad_deflect_fast8=[ $run8, ad_deflect_fast1] {ad_deflect_run(11);};

//======================================================================
// MELEE Range (Flames)
//----------------------------------------------------------------------
void(float ad_fire_explode) ad_deflect_fireflame =
{
	local vector ad_org, ad_eorg, ad_torg, ad_dir, ad_ang;
	local float ad_expl_type, ad_targetang;

	if (!self.enemy) return;
	if (self.health < 1) return;

	// Whooshing attack sound
	sound (self, ad_CHAN_WEAPON, "deflector/flame_fire.wav", 1, ad_ATTN_NORM);
	
	// Facing angle
	ad_ai_face();
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	
	// Setup explosion origin (infront)
	ad_eorg = ad_org + ad_attack_vector('16 0 16');
	// Explosion infront and above impact point
	if (ad_fire_explode == ad_TRUE) {
		// Wall of flame, left > right (maximum arc)
		self.ad_proj_attarc = 1 + ad_skill;
		// Within range? Easy = 3(-1/1), Normal = 5(-2/2), Hard/NM = 7(-3/3)
		if (self.ad_proj_attarc > 3) self.ad_proj_attarc = 3;
		// Invert maximum arc to create beginning/current
		self.ad_proj_attarc = -self.ad_proj_attarc;
		// Randomize explosion type
		if (random() < 0.5) ad_expl_type = ad_EXPLODE_MED;
		else ad_expl_type = ad_EXPLODE_SMALL;
		ad_SpawnExplosion(ad_expl_type, ad_eorg, "deflector/flame_explode.wav");
	}
	// Small particle
	else {
		if (random() > 0.5) ad_SpawnProjectileSmoke(ad_eorg, 200, 50, 250);
	}

	// Start with facing angle
	makevectors (self.angles);	
	// Work out offset (24 unit) from left to right (- to +)
	ad_torg = self.enemy.origin + (v_right * (self.ad_proj_attarc*24));
	ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, ad_torg, ad_SPEED_FLAME);
	// Work out angle
	ad_ang = vectoangles(ad_torg - ad_org);
	ad_ang_x = -ad_targetang;	// Negative = upwards angle 
	makevectors (ad_ang);
	// fire flames forward with slight Z wobble
	ad_dir = (v_forward + (v_up * (random()*0.1)) ) * ad_SPEED_FLAME;

	// Fire that flame!
	// target, origin, v_forward, colour, size, lifetime, speed
	ad_Launch_Flame (self, ad_org, ad_dir, ad_FLAME_RED, -1, -1, ad_SPEED_FLAME);
	// Next arc position
	self.ad_proj_attarc = self.ad_proj_attarc + 1;
};

//----------------------------------------------------------------------
void() ad_deflect_flameframe =
{
	// Dead Deflectors don't reflect back
	if (self.health < 1) return;

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_deflect_flameframe;
	// Check for last frame (exit) first!
	if (self.ad_walkframe < 0) {
		self.frame = $attack20;
		// last frame needs shield coming on
		ad_deflect_shieldon(); ad_deflect_shieldsound_on();
		// Slow down flame attacks with attack timer/blocker
		self.ad_attack_timer = time + 1 + random();
		// Back to regular movement
		self.ad_attack_state = ad_AS_STRAIGHT;
		self.think = self.ad_th_run;
	}
	else if (self.ad_walkframe == 0) { self.frame = $attack1; 
		self.ad_attack_switch = self.ad_attack_timer = 0;
		sound (self, ad_CHAN_WEAPON, "deflector/melee_attack.wav", 1, ad_ATTN_NORM);
	}
	else if (self.ad_walkframe == 1) { self.frame = $attack2;ad_ai_face();
		ad_deflect_shieldoff(); ad_deflect_shieldsound_off();
	}
	else if (self.ad_walkframe == 2) { self.frame = $attack3; ad_ai_face();}
	// MAIN ATTACK LOOP ---------------------------------------------------
	else if (self.ad_walkframe == 3) { self.frame = $attack14; ad_ai_face();
		// Sprite Count = Base (X) * (Skill * Y) Maximum = Z
		self.ad_attack_count = ad_SpriteCount_Flame(self.ad_proj_attqty);
	}
	else if (self.ad_walkframe == 4) { self.frame = $attack15; ad_ai_face();}
	else if (self.ad_walkframe == 5) { self.frame = $attack16; ad_deflect_fireflame(ad_TRUE);}
	else if (self.ad_walkframe >= 6) {
		// Keep counting down flame attacks (3/5/7 sets)
		self.ad_attack_count = self.ad_attack_count - 1;
		if (self.ad_attack_count > 0) {
			self.frame = $attack17; 
			ad_deflect_fireflame(ad_FALSE);
			self.nextthink = time + 0.05;
		}
		else {
			// End of flame attack checks
			self.frame = $attack19; 
			self.ad_walkframe = -10;
			// Extra flame attacks?
			if (self.ad_attack_rage == ad_TRUE) {
				// Sprite Count = Base (X) * (Skill * Y) Maximum = Z
				self.ad_attack_count = ad_SpriteCount_Flame(self.ad_proj_attqty);
				// Any sprite space left for flame burst attack?
				if (ad_HazardProjectile_CheckLimit(self, self.ad_attack_count)) {
					// Can see player and within range?
					if (ad_ai_checkmelee(ad_MONAI_RANGEDEFLECT,ad_FALSE) && 
						ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) {
						// Back around animation loop
						self.frame = $attack3; 
						self.ad_walkframe = 1;
					}
				}
			}
		}
	}

	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
};

//======================================================================
// MELEE Range (Plasma)
//----------------------------------------------------------------------
void(float ad_sideang) ad_deflect_fireplasma =
{
	local vector ad_org, ad_targ_org, ad_dir;

	if (!self.enemy) return;

	// Keep adding up projectile counter
	self.ad_attack_count = self.ad_attack_count + 1;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_PLASMA_FIRE, 1, ad_ATTN_NORM);
	self.ad_attack_speed = ad_SPEED_DEFLECTBOLT + (ad_skill * ad_SPEED_DEFLECTBSKILL);

	ad_ai_trackenemy();
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_targ_org = self.ad_attack_track + '0 0 -16' + (v_right * (ad_sideang * 24));
	ad_dir = normalize(ad_targ_org - self.origin);

	ad_launch_plasma(ad_org, ad_dir, ad_CT_MONDEFLECTOR, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_deflect_plasmaframe =
{
	// Dead Deflectors don't reflect back
	if (self.health < 1) return;

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_deflect_plasmaframe;
	
	// Do specific stuff on certain animation frames
	if (self.ad_walkframe == 0) { self.frame = $attack1; ad_ai_face();
		self.ad_attack_count = self.ad_attack_switch = self.ad_attack_timer = 0;
		sound (self, ad_CHAN_WEAPON, "deflector/melee_attack.wav", 1, ad_ATTN_NORM);
	}
	else if (self.ad_walkframe == 1) { self.frame = $attack2; ad_ai_face();
		self.ad_attack_track = ad_SUB_orgEnemyTarget();
		ad_deflect_shieldoff(); ad_deflect_shieldsound_off();
	}
	else if (self.ad_walkframe == 2) { self.frame = $attack3; ad_ai_trackenemy();}
	// MAIN ATTACK LOOP ---------------------------------------------------
	else if (self.ad_walkframe == 3) { self.frame = $attack14; ad_ai_trackenemy();}
	else if (self.ad_walkframe == 4) { self.frame = $attack15; ad_deflect_fireplasma(0);}
	else if (self.ad_walkframe == 5) { self.frame = $attack16; ad_ai_trackenemy();}
	else if (self.ad_walkframe == 6) { self.frame = $attack17; ad_deflect_fireplasma(-1);}
	else if (self.ad_walkframe == 7) { self.frame = $attack18; ad_ai_trackenemy();}
	else if (self.ad_walkframe == 8) { self.frame = $attack19; ad_deflect_fireplasma(1);}
	else if (self.ad_walkframe >= 9) {
		// Has burst mode been switched off?
		if (self.ad_attack_rage == ad_FALSE) self.ad_attack_count = self.ad_proj_attqty_z+1;
		
		// Burst mode still active? Can see player?
		if (self.ad_attack_count <= self.ad_proj_attqty_z &&
			ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE) ) {
			// Keep looping
			self.ad_walkframe = 3; self.frame = $attack14; ad_ai_trackenemy();
		}
		else {
			self.frame = $attack20;
			// last frame needs shield coming on
			ad_deflect_shieldon(); ad_deflect_shieldsound_on();
			// Slow down plasma attacks with attack timer/blocker
			self.ad_attack_timer = time + 1 + random();
			self.ad_attack_state = ad_AS_STRAIGHT;
			self.think = self.ad_th_run;
		}
	}

	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
};

//----------------------------------------------------------------------
void() ad_deflect_melee = { 
	self.ad_walkframe = 0;		// Frame counter
	self.ad_attack_count = 0;	// Plasma/Flame counter
	self.ad_attack_switch = 0;	// switching run modes
	// Switch melee attack types - Flame/Plasma
	if (self.spawnflags & ad_MON_DEFLECTOR_PLASMA) ad_deflect_plasmaframe();
	else ad_deflect_flameframe();
};

//======================================================================
// LONG Range (Rocket Launcher)
//----------------------------------------------------------------------
void(float ad_sideang) ad_deflect_fire_rocket =
{
	local vector ad_org, ad_torg, ad_dir;
	
	if (!self.enemy) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "deflector/rocket_fire.wav", 1, ad_ATTN_NORM);	

	// Maximum speed, initial speed set in Launch_Missile
	self.ad_attack_speed = ad_SPEED_DEFLECTROCKET + (ad_skill * ad_SPEED_DEFLECTRSKILL);

	// check for enemy origin (based on sight test)
	// if cannot see enemy fire at last known location
	ad_ai_trackenemy();

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_meleeoffset);
	ad_torg = self.ad_attack_track + (v_right * (ad_sideang * 24));
	ad_dir = normalize(ad_torg - ad_org);

	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_DEFLECT1, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_deflect_rocketframe =
{
	// Dead deflectors don't fight anymore
	if (self.health < 1) return;

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_deflect_rocketframe;
	
	// Do specific stuff on certain animation frames
	if (self.ad_walkframe == 0) { ad_ai_face();
		self.frame = $attackp1;
		self.ad_pain_finished = time + 1;
		self.ad_attack_track = ad_SUB_orgEnemyTarget();
		sound (self, ad_CHAN_WEAPON, "deflector/rocket_load.wav", 1, ad_ATTN_NORM);
	}
	else if (self.ad_walkframe == 1) { 
		ad_ai_trackenemy(); self.frame = $attackp2;
		ad_deflect_shieldoff(); ad_deflect_shieldsound_off();
	}
	else if (self.ad_walkframe == 2) { ad_ai_trackenemy(); self.frame = $attackp3; }
	else if (self.ad_walkframe == 3) { ad_ai_trackenemy(); self.frame = $attackp4; }
	else if (self.ad_walkframe == 4) { self.frame = $attackp5; ad_deflect_fire_rocket(0); }
	else if (self.ad_walkframe == 5) { self.frame = $attackp4; 
	if (ad_skill >= ad_SKILL_NORMAL) ad_deflect_fire_rocket(-1); }
	else if (self.ad_walkframe == 6) { self.frame = $attackp5; 
	if (ad_skill >= ad_SKILL_HARD) ad_deflect_fire_rocket(1); }
	else if (self.ad_walkframe == 7) { self.frame = $attackp4; }
	else if (self.ad_walkframe == 8) { self.frame = $attackp3; }
	else if (self.ad_walkframe == 9) { self.frame = $attackp2; }
	else if (self.ad_walkframe >= 10) { 
		self.frame = $attackp1;
		// last frame has shield coming on
		ad_deflect_shieldon(); ad_deflect_shieldsound_on();
		self.ad_attack_state = ad_AS_STRAIGHT;
		self.think = self.ad_th_run;
	}
	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
};

//----------------------------------------------------------------------
void() ad_deflector_range = { self.ad_walkframe = 0; ad_deflect_rocketframe(); };

