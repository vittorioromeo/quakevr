void() ad_deflect_stand2=[ $stand2, ad_deflect_stand3] {ad_ai_stand();};
void() ad_deflect_stand3=[ $stand3, ad_deflect_stand4] {ad_ai_stand();};
void() ad_deflect_stand4=[ $stand4, ad_deflect_stand5] {ad_ai_stand();};
void() ad_deflect_stand5=[ $stand5, ad_deflect_stand6] {ad_ai_stand();};
void() ad_deflect_stand6=[ $stand6, ad_deflect_stand7] {ad_ai_stand();};
void() ad_deflect_stand7=[ $stand7, ad_deflect_stand1] {ad_ai_stand();};

