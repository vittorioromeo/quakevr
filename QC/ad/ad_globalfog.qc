// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 GLOBAL FADING FOG SYSTEM

 * Original idea from Honey mod by CZG
 * Written from scratch as Honey implementation is weird
 * Created special long float function for better accuracy
 * Fog functionality has to be active before controller can be setup
 * Creates a special entity (controller) to work in background
 * Controller is setup from client.qc / PlayerPostThink function
 * Added r_skyfog version as well (supported in most engines)
 
======================================================================*/

//----------------------------------------------------------------------
// (Long Float TO String) Format and print a number to the console
// - str_player : needs to be a client for various buffer commands
// - buffer : BUFFER_STUFFCMD, BUFFER_SPRINT, BUFFER_DPRINT
void(entity ad_str_player, float ad_str_num, float ad_topbit, float ad_botbit, float ad_buffer) ad_lftos =
{
	local float ad_str_counter, ad_str_pow, ad_str_result, ad_str_remain, ad_str_first;
	
	ad_str_counter = ad_topbit;		// Upper number length
	ad_str_pow = ad_mathlib_powbit(ad_topbit,10);// Setup initial base 10 power for checking
	ad_str_remain = ad_FALSE;			// Decimal point been done yet
	ad_str_first = ad_FALSE;			// First non-zero digit printed

	// Deal with negative state first
	if (ad_str_num < 0) {
		if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, "-");
		else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, "-");
		else if (ad_buffer & ad_BUFFER_DPRINT) dprint("-");
	}
	// Get rid of negative state
	ad_str_num = fabs(ad_str_num);
	
	// If number larger than fixed length?
	if (ad_str_num > ad_str_pow)
		ad_str_num = ad_str_num - (floor(ad_str_num / ad_str_pow) * ad_str_pow);
		// New system, not used for this function
		// str_num = mathlib_truncate(str_num, topbit, botbit);

	// Loop through upper part of number
	while(ad_str_counter > 0) {
		// Move down one pow digit
		ad_str_pow = ad_str_pow / 10;

		// Divide number by pow to get divider
		// Floor can produce rounding errors (fix it with 0.01)
		ad_str_result = floor((ad_str_num / ad_str_pow)+0.01);
		// New system, not used for this function
		// str_result = mathlib_divisible(str_num, str_pow);
		
		// Result must be 0-9 digits
		if (ad_str_result > 9) ad_str_result = 9;
		if (ad_str_result < 1) ad_str_result = 0;
		
		// Fill front of number with spaces
		if (ad_str_counter > 1 && ad_str_result == 0 && ad_str_first == ad_FALSE) {
			// Print space to buffer type
			if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, " ");
			else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, " ");
			else if (ad_buffer & ad_BUFFER_DPRINT) dprint(" ");
		}
		// Display a number
		else if (ad_str_result > 0 || ad_str_first) {
			ad_str_first = ad_TRUE;
			// Print digit to buffer type
			if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, ftos(ad_str_result));
			else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, ftos(ad_str_result));
			else if (ad_buffer & ad_BUFFER_DPRINT) dprint(ftos(ad_str_result));
		}
		
		// remove top part of number, decrease str length counter
		ad_str_num = ad_str_num - (ad_str_result * ad_str_pow);
		ad_str_counter = ad_str_counter - 1;
	}
	
	// Any decimal place?
	if (ad_botbit <= 0) {
		// Check for zero value
		if (!ad_str_first) {
			if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, "0");
			else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, "0");
			else if (ad_buffer & ad_BUFFER_DPRINT) dprint("0");
		}
		return;
	}
	
	// Is there any remainder?
	if (ad_str_counter < 1) {
		// Print decimal point to buffer type
		if (!ad_str_first) {
			ad_str_first = ad_TRUE;
			if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, "0.");
			else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, "0.");
			else if (ad_buffer & ad_BUFFER_DPRINT) dprint("0.");
		}
		else {
			if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, ".");
			else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, ".");
			else if (ad_buffer & ad_BUFFER_DPRINT) dprint(".");
		}
		if (ad_botbit <1) ad_botbit=1;
		ad_str_counter = ad_botbit;
		while (ad_botbit > 0) { 
			ad_str_num = ad_str_num * 10; 
			ad_botbit = ad_botbit -1;
		}
		ad_str_pow = ad_mathlib_powbit(ad_str_counter,10);
	}

	// Loop through lower part of number
	while(ad_str_counter > 0) {
		// Move down one pow digit
		ad_str_pow = ad_str_pow / 10;

		// Divide number by pow to get divider
		// Floor can produce rounding errors (fix it with 0.01)
		ad_str_result = floor((ad_str_num / ad_str_pow)+0.01);
		// New system, not used for this function
		// str_result = mathlib_divisible(str_num, str_pow);

		// Result must be 0-9 digits
		if (ad_str_result > 9) ad_str_result = 9;
		if (ad_str_result < 1) ad_str_result = 0;

		if (ad_str_result > 0 || ad_str_first) {
			ad_str_first = ad_TRUE;
			// Print digit to buffer type
			if (ad_buffer & ad_BUFFER_STUFFCMD) stuffcmd(ad_str_player, ftos(ad_str_result));
			else if (ad_buffer & ad_BUFFER_SPRINT) sprint(ad_str_player, ftos(ad_str_result));
			else if (ad_buffer & ad_BUFFER_DPRINT) dprint(ftos(ad_str_result));
		}
		
		// remove top part of number, decrease str length counter
		ad_str_num = ad_str_num - (ad_str_result * ad_str_pow);
		ad_str_counter = ad_str_counter - 1;
	}
};

//----------------------------------------------------------------------
// Make value is not below or above limits and or negative!
//----------------------------------------------------------------------
float(float ad_fogrange) ad_fog_check_range =
{
	if (ad_fogrange < 0.01) return 0.01;
	if (ad_fogrange > 1) return 1;
	return fabs(ad_fogrange);
};

//======================================================================
// Main fog functions
//======================================================================
void(entity ad_client) ad_change_fog  =
{
	if (!ad_fog_control) return;
	
	// Update fog parameters to console buffer
	if (VR_AD_Fog(ad_client, ad_fog_control.ad_fog_currden, ad_fog_control.ad_fog_currcol)) return;
	stuffcmd(ad_client, "\n\n\nfog ");
	// Fog density can be in the range of 0-99
	ad_lftos(ad_client, ad_fog_control.ad_fog_currden, 2,3, ad_BUFFER_STUFFCMD);

	// I use to have a direct fix for DP/FTE engines with fog density
	// being wrong, but it seems DP (latest build) is completely broken
	// with AD and it feels pointless to keep trying to fix engine visuals.
	// So this QC hack is now removed and the fog setup is as the mapper
	// intended with no QC modification.
	// if (ext_dpfog) lftos(client, fog_control.fog_currden+0.05, 1,3, BUFFER_STUFFCMD); 
	// else lftos(client, fog_control.fog_currden, 1,3, BUFFER_STUFFCMD);
	
	stuffcmd(ad_client, " "); 
	ad_lftos(ad_client, ad_fog_control.ad_fog_currcol_x, 1,3, ad_BUFFER_STUFFCMD); 
	stuffcmd(ad_client, " "); 
	ad_lftos(ad_client, ad_fog_control.ad_fog_currcol_y, 1,3, ad_BUFFER_STUFFCMD); 
	stuffcmd(ad_client, " "); 
	ad_lftos(ad_client, ad_fog_control.ad_fog_currcol_z, 1,3, ad_BUFFER_STUFFCMD); 
	// Extra fog parameters for DarkPlaces extended engines
	if (ad_ext_dpfog) {
		stuffcmd(ad_client, " ");
		stuffcmd(ad_client, ad_fog_control.ad_fog_dpextra);
	}
	stuffcmd(ad_client, "\n");
};

//----------------------------------------------------------------------
// Main fog controller loop
//----------------------------------------------------------------------
void() ad_fog_controller_think =
{
	// Has there been a change detected?
	if (self.state == ad_STATE_SETUP) {
		// If fog fade time too low, instantly switch
		if (self.ad_fog_difftime <= ad_FADEFOG_TIME) {
			self.state = ad_STATE_OFF;
			self.ad_fog_currden = self.ad_fog_targden;
			self.ad_fog_currcol = self.ad_fog_targcol;
			ad_change_fog(self.owner);
		}
		else {
			// Setup gradual fade of fog over time
			self.state = ad_STATE_ON;
			// divide the fade time into segments (minimum 0.05)
			// Multiple the time by segments so diff is correct
			// Time segements less than 0.05 does not work v well
			self.ad_fog_steptime = self.ad_fog_difftime / ad_FADEFOG_TIME;
			self.ad_fog_difftime = self.ad_fog_steptime * ad_FADEFOG_TIME;
			
			// Work out fade directions for density/colour
			self.ad_fog_diffden = self.ad_fog_targden - self.ad_fog_currden;
			self.ad_fog_diffcol = self.ad_fog_targcol - self.ad_fog_currcol;

			// Debug info only
			/*----------------------------------------------------------------------
			dprint("Curr ("); 
			lftos(self.owner, self.fog_currden, 1,3, BUFFER_DPRINT); dprint(")(");
			lftos(self.owner, self.fog_currcol_x, 1,3, BUFFER_DPRINT); dprint(" ");
			lftos(self.owner, self.fog_currcol_y, 1,3, BUFFER_DPRINT); dprint(" ");
			lftos(self.owner, self.fog_currcol_z, 1,3, BUFFER_DPRINT); dprint(")\n");
			dprint("Targ ("); 
			lftos(self.owner, self.fog_targden, 1,3, BUFFER_DPRINT); dprint(")(");
			lftos(self.owner, self.fog_targcol_x, 1,3, BUFFER_DPRINT); dprint(" ");
			lftos(self.owner, self.fog_targcol_y, 1,3, BUFFER_DPRINT); dprint(" ");
			lftos(self.owner, self.fog_targcol_z, 1,3, BUFFER_DPRINT); dprint(")\n");
			dprint("Diff ("); 
			lftos(self.owner, self.fog_diffden, 1,3, BUFFER_DPRINT); dprint(")(");
			lftos(self.owner, self.fog_diffcol_x, 1,3, BUFFER_DPRINT); dprint(" ");
			lftos(self.owner, self.fog_diffcol_y, 1,3, BUFFER_DPRINT); dprint(" ");
			lftos(self.owner, self.fog_diffcol_z, 1,3, BUFFER_DPRINT); dprint(")\n");
			//----------------------------------------------------------------------*/

			// Work out step ammount to fade smoothly over time
			self.ad_fog_diffden = self.ad_fog_diffden / self.ad_fog_steptime;
			self.ad_fog_diffcol_x = self.ad_fog_diffcol_x / self.ad_fog_steptime;
			self.ad_fog_diffcol_y = self.ad_fog_diffcol_y / self.ad_fog_steptime;
			self.ad_fog_diffcol_z = self.ad_fog_diffcol_z / self.ad_fog_steptime;
		}
	}
	// Is the fog fade over? Finite amount of steps
	else if (self.ad_fog_steptime < 0 && self.state != ad_STATE_OFF) {
		self.state = ad_STATE_OFF;
		self.ad_fog_currden = self.ad_fog_targden;
		self.ad_fog_currcol = self.ad_fog_targcol;

		// Density and colour should be capped at 1, but it seems
		// density can go much higher and is needed to make it solid
		// Removed the upper cap check - AD 1.7 Patch 2
		//self.fog_currden = fog_check_range(self.fog_currden);
		if (self.ad_fog_currden < 0) self.ad_fog_currden = 0;
		if (self.ad_fog_currden > 99) self.ad_fog_currden = 99;
		// Check density and colour values are within range
		self.ad_fog_currcol_x = ad_fog_check_range(self.ad_fog_currcol_x);
		self.ad_fog_currcol_y = ad_fog_check_range(self.ad_fog_currcol_y);
		self.ad_fog_currcol_z = ad_fog_check_range(self.ad_fog_currcol_z);
		
		ad_change_fog(self.owner);
	}
	// If the fade is active, keep adding steps
	else if (self.state == ad_STATE_ON) {
		self.ad_fog_steptime = self.ad_fog_steptime - 1;
		self.ad_fog_currden = self.ad_fog_currden + self.ad_fog_diffden;
		self.ad_fog_currcol = self.ad_fog_currcol + self.ad_fog_diffcol;
		ad_change_fog(self.owner);
	}

	// Keep on looping around using min time step
	self.think = ad_fog_controller_think;
	self.nextthink = time + ad_FADEFOG_TIME;
};

//----------------------------------------------------------------------
void(float ad_gf_den, vector ad_gf_col, float ad_gf_time) ad_fade_fog =
{
	// No controller active?
	if (!ad_fog_control) return;

	// Fog density can be higher than 1, check larger range
	if (ad_gf_den < 0) ad_gf_den = 0;
	if (ad_gf_den > 99) ad_gf_den = 99;
	//gf_den = fog_check_range(gf_den);
	// Check colour values are within range
	ad_gf_col_x = ad_fog_check_range(ad_gf_col_x);
	ad_gf_col_y = ad_fog_check_range(ad_gf_col_y);
	ad_gf_col_z = ad_fog_check_range(ad_gf_col_z);
		
	// Setup fog controller with new fog values
	ad_fog_control.ad_fog_targden = ad_gf_den;
	ad_fog_control.ad_fog_targcol = ad_gf_col;
	ad_fog_control.ad_fog_difftime = ad_gf_time;

	// Force fog controller to calculate difference
	ad_fog_control.state = ad_STATE_SETUP;
};

//----------------------------------------------------------------------
// Setup the fog controller entity (called from client if defined)
//----------------------------------------------------------------------
void() ad_setup_fog_controller =
{
	if (!ad_fog_control) {
		// Start off with the fog controller disabled
		// if the worldspawn setup correctly then enable
		// the controller and allow fog changes
		ad_fog_active = ad_FALSE;
		
		ad_fog_control = spawn();
		ad_fog_control.owner = self;				// Link back to client
		ad_fog_control.ad_classtype = ad_CT_CONTROL;
		ad_fog_control.solid = ad_SOLID_NOT;			// No world interaction
		ad_fog_control.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
		setorigin(ad_fog_control, '0 0 0');
		setsize(ad_fog_control, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		
		if (world.fog_density <= 0) {
			ad_fog_active = ad_FALSE;						// out of sync
			ad_fog_control.ad_fog_currden = ad_DEF_FOGDEN;	// Bad default
			ad_fog_control.ad_fog_targden = ad_DEF_FOGDEN;	// Target
		}
		else {
			ad_fog_active = ad_TRUE;					// engine and QC insync
			ad_fog_control.ad_fog_currden = world.fog_density;
			ad_fog_control.ad_fog_targden = world.fog_density;
		}
		ad_fog_control.ad_fog_diffden = 0;			// Difference

		if (ad_CheckZeroVector(world.ad_fog_colour)) {
			ad_fog_active = ad_FALSE;						// out of sync
			ad_fog_control.ad_fog_currcol = ad_DEF_FOGCOL;	// Bad Default
			ad_fog_control.ad_fog_targcol = ad_DEF_FOGCOL;	// Target
		}
		else {
			ad_fog_active = ad_TRUE;					// engine and QC insync
			ad_fog_control.ad_fog_currcol = world.ad_fog_colour;
			ad_fog_control.ad_fog_targcol = world.ad_fog_colour;
		}
		ad_fog_control.ad_fog_diffcol = '0 0 0';		// Difference

		// Bat shit crazy DP extra fog parameters that no other engine uses
		// dpextra = alpha mindist maxdist top fadedepth (def=1 0 8192 1024 32)
		if (world.ad_fog_dpextra == "") ad_fog_control.ad_fog_dpextra = ad_DEF_FOGEXT;
		else ad_fog_control.ad_fog_dpextra = world.ad_fog_dpextra;

		// This is a horrible hack, it should not be here
		// This parameter should be in the map file worldspawn
		//if (world.model == "maps/ad_end.bsp") 
		//	fog_control.fog_dpextra = "1 0 2048 8192 32";
		
		ad_fog_control.state = ad_STATE_OFF;	// Not fading atm
		ad_fog_control.ad_fog_difftime = 0;	// fading fog time (seconds)
		ad_fog_control.ad_fog_steptime = 0;	// How many steps to fade

		// Setup think process to monitor for fog changes
		// If this entity already exists, then its thinking!
		ad_fog_control.think = ad_fog_controller_think;
		ad_fog_control.nextthink = time + ad_FADEFOG_TIME;
		
		if (ad_fog_active) ad_change_fog(self);
	}
};

//======================================================================
// Main sky fog functions
//======================================================================
void(entity ad_client) ad_change_skyfog  =
{
	if (!ad_skyfog_control) return;
	
	// Update fog parameters to console buffer
	stuffcmd(ad_client, "\n\n\nr_skyfog ");
	// Fog density should be in the range of 0-1
	ad_lftos(ad_client, ad_skyfog_control.ad_skyfog_currden, 1,3, ad_BUFFER_STUFFCMD);
	stuffcmd(ad_client, "\n");
};

//----------------------------------------------------------------------
// Main sky fog controller loop
//----------------------------------------------------------------------
void() ad_skyfog_controller_think =
{
	// Has there been a change detected?
	if (self.state == ad_STATE_SETUP) {
		// If sky fog fade time too low, instantly switch
		if (self.ad_skyfog_difftime <= ad_FADEFOG_TIME) {
			self.state = ad_STATE_OFF;
			self.ad_skyfog_currden = self.ad_skyfog_targden;
			ad_change_skyfog(self.owner);
		}
		else {
			// Setup gradual fade of sky fog over time
			self.state = ad_STATE_ON;
			// divide the fade time into segments (minimum 0.05)
			// Multiple the time by segments so diff is correct
			// Time segements less than 0.05 does not work v well
			self.ad_skyfog_steptime = self.ad_skyfog_difftime / ad_FADEFOG_TIME;
			self.ad_skyfog_difftime = self.ad_skyfog_steptime * ad_FADEFOG_TIME;
			
			// Work out fade directions for density
			self.ad_skyfog_diffden = self.ad_skyfog_targden - self.ad_skyfog_currden;

			// Work out step ammount to fade smoothly over time
			self.ad_skyfog_diffden = self.ad_skyfog_diffden / self.ad_skyfog_steptime;
		}
	}
	// Is the fog fade over? Finite amount of steps
	else if (self.ad_skyfog_steptime < 0 && self.state != ad_STATE_OFF) {
		self.state = ad_STATE_OFF;
		self.ad_skyfog_currden = self.ad_skyfog_targden;

		// Density should be capped at 1
		self.ad_skyfog_currden = ad_fog_check_range(self.ad_skyfog_currden);
		
		ad_change_skyfog(self.owner);
	}
	// If the fade is active, keep adding steps
	else if (self.state == ad_STATE_ON) {
		self.ad_skyfog_steptime = self.ad_skyfog_steptime - 1;
		self.ad_skyfog_currden = self.ad_skyfog_currden + self.ad_skyfog_diffden;
		ad_change_skyfog(self.owner);
	}

	// Keep on looping around using min time step
	self.think = ad_skyfog_controller_think;
	self.nextthink = time + ad_FADEFOG_TIME;
};

//----------------------------------------------------------------------
void(float ad_gf_den, float ad_gf_time) ad_fade_skyfog =
{
	// No controller active?
	if (!ad_skyfog_control) return;

	// Check Sky Fog density is range 0 - 1
	ad_gf_den = ad_fog_check_range(ad_gf_den);
		
	// Setup sky fog controller with new fog values
	ad_skyfog_control.ad_skyfog_targden = ad_gf_den;
	ad_skyfog_control.ad_skyfog_difftime = ad_gf_time;

	// Force sky fog controller to calculate difference
	ad_skyfog_control.state = ad_STATE_SETUP;
};

//----------------------------------------------------------------------
// Setup the sky fog controller entity
//----------------------------------------------------------------------
void() ad_setup_skyfog_controller =
{
	if (!ad_skyfog_control) {
		// Start off with the sky fog controller disabled
		// if the worldspawn setup correctly then enable
		// the controller and allow fog changes
		ad_skyfog_active = ad_FALSE;
		
		ad_skyfog_control = spawn();
		ad_skyfog_control.owner = self;				// Link back to client
		ad_skyfog_control.ad_classtype = ad_CT_CONTROL;
		ad_skyfog_control.solid = ad_SOLID_NOT;			// No world interaction
		ad_skyfog_control.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
		setorigin(ad_skyfog_control, '0 0 0');
		setsize(ad_skyfog_control, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		
		if (world.ad_skyfog_density <= 0) {
			ad_skyfog_active = ad_FALSE;						// out of sync
			ad_skyfog_control.ad_skyfog_currden = ad_DEF_SKYFOGDEN;	// Bad default
			ad_skyfog_control.ad_skyfog_targden = ad_DEF_SKYFOGDEN;	// Target
		}
		else {
			ad_skyfog_active = ad_TRUE;					// engine and QC insync
			ad_skyfog_control.ad_skyfog_currden = world.ad_skyfog_density;
			ad_skyfog_control.ad_skyfog_targden = world.ad_skyfog_density;
		}
		ad_skyfog_control.ad_skyfog_diffden = 0;			// Difference

		ad_skyfog_control.state = ad_STATE_OFF;	// Not fading atm
		ad_skyfog_control.ad_skyfog_difftime = 0;	// fading sky fog time (seconds)
		ad_skyfog_control.ad_skyfog_steptime = 0;	// How many steps to fade

		// Setup think process to monitor for sky fog changes
		// If this entity already exists, then its thinking!
		ad_skyfog_control.think = ad_skyfog_controller_think;
		ad_skyfog_control.nextthink = time + ad_FADEFOG_TIME;
		
		if (ad_skyfog_active) ad_change_skyfog(self);
	}
};
