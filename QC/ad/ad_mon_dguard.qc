void()	ad_dguard_stand10	=[	$stand10,	ad_dguard_stand11	] {ad_ai_stand();};
void()	ad_dguard_stand11	=[	$stand11,	ad_dguard_stand12	] {ad_ai_stand();};
void()	ad_dguard_stand12	=[	$stand12,	ad_dguard_stand1	] {
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.lip = random();
		if (self.lip < 0.2) self.think = ad_dguard_standD1;			// Poke the ground
		else if (self.lip < 0.4) self.think = ad_dguard_standC1;	// Look at weapon
		else if (self.lip < 0.7) self.think = ad_dguard_standA1;	// Shoulder hunch
		else self.think = ad_dguard_standB1;											// Look around
	}
	ad_ai_stand();
};

