// 6 frames instead of 8 frames (16, 20, 7, 16, 20, 6) Missing 13+14
// Added timing of 3rd/7th back to other frames

void()	ad_dguard_run1	=[	$run1,	ad_dguard_run2	] {
	self.ad_idlebusy = ad_FALSE; ad_monster_idle_sound(); ad_ai_run (20); };
void()	ad_dguard_run2	=[	$run2,	ad_dguard_run3	] {ad_monster_footstep(ad_FALSE); ad_ai_run(24);};
