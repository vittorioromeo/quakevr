void()	ad_dguard_stand1	=[	$stand1,	ad_dguard_stand2	] {ad_monster_idle_sound(); 
	self.ad_idlebusy = ad_FALSE; ad_ai_stand();};
void()	ad_dguard_stand2	=[	$stand2,	ad_dguard_stand3	] {ad_ai_stand();};
