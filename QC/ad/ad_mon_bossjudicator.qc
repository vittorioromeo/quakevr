// Model state
float ad_JUDGE_STAND = 1;
float ad_JUDGE_TAUNT = 3;	// IdleB
float ad_JUDGE_IDLEC = 5;	// IdleC
float ad_JUDGE_IDLED = 7;	// IdleD
float ad_JUDGE_WALK = 10;
float ad_JUDGE_RUN = 15;
float ad_JUDGE_MELEE = 20;
float ad_JUDGE_JUMP = 25;
float ad_JUDGE_MAGICA = 30;
float ad_JUDGE_MAGICB = 32;
float ad_JUDGE_FLAME = 34;
float ad_JUDGE_LINE = 36;
float ad_JUDGE_SUMMON = 38;
float ad_JUDGE_PAIN = 40;
float ad_JUDGE_DEAD = 42;

// Sword location (Back/Shoulder/Hand)
float ad_JUDGE_SWBACK = 1;
float ad_JUDGE_SWSHOULDER = 2;
float ad_JUDGE_SWHAND = 3;
float ad_JUDGE_SWFLOOR = 4;

// Sword changing sound fx
float ad_JUDGE_SFXDEF = 0;
float ad_JUDGE_SFXDRAW = 1;
float ad_JUDGE_SFXSHEATH = 2;
float ad_JUDGE_SFXSWOOSH = 3;
float ad_JUDGE_SFXSILENT = 4;

float ad_JUDGE_PHASE0 = -1;	// No boss wave/setup
float ad_JUDGE_PHASE1 = 1;		// Intro
float ad_JUDGE_PHASE2 = 2;		// Fighting
float ad_JUDGE_PHASE3 = 3;		// Summon mode
float ad_JUDGE_PHASE4 = 4;		// Death

// Different model animation speeds
float ad_JUDGESPD_WALK = 7.4;
float ad_JUSTICESPD_WALK = 5.8;
float ad_JUDGESPD_SWING = 31.4;
float ad_JUSTICESPD_SWING = 24.5;
float ad_JUDGESPD_SMASH = 29.3;
float ad_JUSTICESPD_SMASH = 22.9;

// Forward compiler refeence
void(float ad_finalstate, float ad_soundtype) ad_judge_checksword;

//============================================================================
void() ad_judge_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
// Setup wave HP and trigger boundaries
//----------------------------------------------------------------------
void() ad_judge_WaveSetupHP =
{
	// Is there anymore boss waves left?
	if (self.ad_bosswave >= self.ad_bosswavetotal) {
		// Only one wave left (death is final trigger)
		self.health = self.ad_bosswaveqty;
		self.ad_bosswavetrig = -1000;
	}
	else {
		// Multiple waves are still left (reset hp+trigger)
		// Always reset HP to stop high DPS weapons trashing waves boundaries
		self.health = ((self.ad_bosswavetotal - self.ad_bosswave) + 1) * self.ad_bosswaveqty;
		// The wave trigger is always one wave lower
		self.ad_bosswavetrig = self.health - self.ad_bosswaveqty;
	}
	// Debug messages for wave and health
	dprint("\b[BOSS]\b Wave ("); dprint(ftos(self.ad_bosswave));
	dprint(" / "); dprint(ftos(self.ad_bosswavetotal));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//----------------------------------------------------------------------
// Check if HP has reached next boss wave trigger event
//----------------------------------------------------------------------
float() ad_judge_WaveCheck =
{
	// Should be in summon code, double check
	if (self.style == ad_JUDGE_PHASE3) return ad_TRUE;
	// Check for boss wave boundary event
	if (self.health > 1 && self.health < self.ad_bosswavetrig) {
		// Check for wave boundary triggers
		self.noise = "";
		if (self.ad_bosswave == 1) self.noise = self.noise1;
		else if(self.ad_bosswave == 2) self.noise = self.noise2;
		else if(self.ad_bosswave == 3) self.noise = self.noise3;
		else if(self.ad_bosswave == 4) self.noise = self.noise4;
		
		// Is there any trigger for the wave boundary?
		if (self.noise != "") ad_trigger_strs(self.noise, self);

		// Update Boss wave parameters (next wave!)
		self.ad_bosswave = self.ad_bosswave + 1;
		ad_judge_WaveSetupHP();
		self.style = ad_JUDGE_PHASE3;	// Summon mode
		return ad_TRUE;
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Check the tether system
//----------------------------------------------------------------------
float() ad_judge_CheckTether =
{
	local float ad_currentdist;
	
	// Check for boss mode
	if (self.ad_classtype == ad_CT_MONJUSTICE) return ad_FALSE;
	ad_currentdist = vlen(self.origin - self.ad_movelast.origin);
	// Check the most obvious first, inside tether range?
	if (ad_currentdist < self.ad_tetherrange) return ad_FALSE;
	else {
		// If player or tether close to each other?
		if (ad_infront(self.ad_movelast) && ad_infront(ad_SUB_entEnemyTarget()) )
			return ad_FALSE;
		// Stop moving around
		else return ad_TRUE;
	}
};
	
/*======================================================================
 JudgeCheckAttack
======================================================================*/
void() ad_JudgeCheckAttack =
{
	//----------------------------------------------------------------------
	// Special melee attack for monster infighting
	//----------------------------------------------------------------------
	if (self.enemy.flags & ad_FL_MONSTER) {
		// If monster outside of melee range, blast them with range
		if (self.ad_enemydist > self.ad_meleerange) self.ad_attack_state = ad_AS_MISSILE;
		else self.ad_attack_state = ad_AS_MELEE;
		return;
	}

	//----------------------------------------------------------------------
	// Check for Blast Belt and create random chance of detecting it
	//----------------------------------------------------------------------
	if (self.enemy.flags & ad_FL_CLIENT && self.enemy.ad_moditems & ad_IT_ARTBLASTBELT)
		self.ad_attack_chance = random();
	else self.ad_attack_chance = 0;
	
	//----------------------------------------------------------------------
	// Melee attack (Special fist ground smash)
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_MELEEJUDGE && self.ad_attack_chance < 0.5) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack conditions
	//----------------------------------------------------------------------
	// Can see the enemy?
	if (!ad_enemy_vis) return;
	// Does the monster have a clear shot to the player?
	if (ad_visblocked(self.enemy)) return;
	
	//----------------------------------------------------------------------
	// Mid Range attack (JUMP)
	//----------------------------------------------------------------------
	// Jumped recently, facing right direction and not blocked?
	if ( self.jump_flag < time && ad_infront(self.enemy) ) {
		// Check for enemy above? (z axis)
		if (self.enemy.origin_z <= self.origin_z) {
			// Is the judge within the right range?
			if (self.ad_enemydist > self.ad_jumprange_x &&
				self.ad_enemydist < self.ad_jumprange_y) {
				// Block any range attacks for a while
				ad_SUB_AttackFinished (random());
				self.ad_jumptouch = world;		// Reset last object touched
				self.count = 0;				// Number of times jumped
				self.ad_th_jump ();
				return;
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Spikes or Flames)
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (2 + random());
};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_justice_create_attachment =
{
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
	}
};

//----------------------------------------------------------------------
void() ad_justice_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_justice_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
void(float ad_att_frame) ad_justice_update_attachment =
{
	makevectors(self.angles);
	self.ad_attachment.origin = self.origin + ad_attack_vector(self.ad_meleeoffset);
	setorigin(self.ad_attachment, self.ad_attachment.origin);
	// Different frame count set to main model
	self.ad_attachment.frame = ad_att_frame;
};

//----------------------------------------------------------------------
void() ad_justice_setup_attachment = 
{
	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_justice_create_attachment();
	self.ad_attachment.state = ad_STATE_ON;
	setmodel(self.ad_attachment, self.ad_weaponglow);
	self.ad_attachment.skin = 0;
	// Display/sync with main model
	ad_justice_update_attachment(0);
};

//======================================================================
// Standing around
//----------------------------------------------------------------------
void() ad_judge_standframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_standframe;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	
	// Update frame and move forward
	self.frame = $stand1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	
	// Finished animation set? (0-15 = 16 frames)
	if (self.ad_walkframe > 15) {
		self.ad_walkframe = 0;
		// Is there a walk timer active? Enough time for an idea?
		if (self.goalentity && time > (self.ad_pausetime+0.5)) self.lip = 0;
		else self.lip = random();
		// Any chance for an idle
		if (self.lip < ad_MON_IDLE_ANIMATION) {
			// Let blend animation happen before any walking
			if (self.ad_pausetime > 0) 
				self.ad_pausetime = self.ad_pausetime + 0.5;
			// Make sure the idle animations don't repeat
			self.lip = self.lefty;
			while (self.lefty == self.lip) { 
				self.lefty = rint(random()*3); }
			if (self.lefty <= 1) {
				// IdleB = Point sword forward
				self.state = ad_JUDGE_TAUNT;
				ad_judge_checksword(ad_JUDGE_SWSHOULDER,ad_JUDGE_SFXSWOOSH);
			}
			else if (self.lefty <= 2) {
				// IdleC = Inspect the sword (for+back)
				self.state = ad_JUDGE_IDLEC;
				ad_judge_checksword(ad_JUDGE_SWSHOULDER,ad_JUDGE_SFXSWOOSH);
			}
			else {
				// Don't go into this idle animation if patrolling
				// This can last too long and be awkward to reset
				if (self.ad_attack_switch == ad_FALSE) {
					// IdleD = Place sword on floor
					self.state = ad_JUDGE_IDLED;
					self.cnt = 0;
					ad_judge_checksword(ad_JUDGE_SWFLOOR,ad_JUDGE_SFXSWOOSH);
				}
			}
		}
	}
	// Check for combat
	else ad_ai_stand();	
};

//----------------------------------------------------------------------
void() ad_judge_tauntframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_tauntframe;
	// Keep judge at path_corner idling
	if (self.ad_pausetime > 0) self.ad_pausetime = self.ad_pausetime + 0.1;

	// Sword swoosh/whoosh noises
	if (self.ad_walkframe == 3 || self.ad_walkframe == 12) ad_judge_sword_sound();
	
	// Update frame and move forward
	// 00 01 02 03 04 05 06 07 -- (forward)
	//                      08    (pause)
	// 16 15 14 13 12 11 10 09    (backward)
	if (self.ad_walkframe <= 7) self.frame = $taunt1 + self.ad_walkframe;
	else if (self.ad_walkframe == 8) self.frame = $taunt8;
	else self.frame = $taunt1 + (16-self.ad_walkframe);
	
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 16 ) self.ad_th_stand();
	else ad_ai_stand();	
};

//----------------------------------------------------------------------
void() ad_judge_idleCframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_idleCframe;
	// Keep judge at path_corner idling
	if (self.ad_pausetime > 0) self.ad_pausetime = self.ad_pausetime + 0.1;

	// Sword swoosh/whoosh noises
	if (self.ad_walkframe == 1 || self.ad_walkframe == 22) ad_judge_sword_sound();
	
	// Update frame and move forward
	// 00 01 02 03 04 05 06 07 08 09 10 11 12 (forward)
	// 24 23 22 21 20 19 18 17 16 15 14 13    (backward)
	if (self.ad_walkframe <= 12) self.frame = $idleC1 + self.ad_walkframe;
	else self.frame = $idleC1 + (24-self.ad_walkframe);
	
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 24 ) self.ad_th_stand();
	else ad_ai_stand();	
};

//----------------------------------------------------------------------
void() ad_judge_idleDframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_idleDframe;
	// Keep judge at path_corner idling
	if (self.ad_pausetime > 0) self.ad_pausetime = self.ad_pausetime + 0.1;

	// Update frame and move forward
	self.frame = $idleD1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 13 ) {
		// Chance to keep this animation active?
		if (random() < self.ad_attack_chance) {
			// Animation does not end with shoulder position
			self.state = ad_JUDGE_STAND;
			ad_judge_checksword(ad_JUDGE_SWSHOULDER,ad_JUDGE_SFXSWOOSH);
		}
		// Keep looping
		else self.ad_walkframe = 0;
		// Keep adding loop chance
		self.ad_attack_chance = self.ad_attack_chance + 0.2;
	}
	else ad_ai_stand();	
};

//----------------------------------------------------------------------
void() ad_judge_walkframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_walkframe;
	// Avoid idleD (its too long for walk patrols)
	self.ad_attack_switch = ad_TRUE;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Beginning of animation block
	if (self.ad_walkframe == 0 || self.ad_walkframe == 7) ad_monster_footstep(ad_FALSE);
	if (self.ad_walkframe == 3) ad_monster_idle_sound();

	// Update frame and move forward
	if (self.ad_move_altwalk > 0) self.frame = $walkB1 + self.ad_walkframe;
	else self.frame = $walk1 + self.ad_walkframe;

	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 11) self.ad_walkframe = 0;
	// Jude/Justice different scales = different walks
	if (self.ad_classtype == ad_CT_MONJUDGE) ad_ai_walk(ad_JUDGESPD_WALK);
	else ad_ai_walk(ad_JUSTICESPD_WALK);
};

//----------------------------------------------------------------------
void() ad_judge_runframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	
	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_runframe;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Beginning of animation block
	if (self.ad_walkframe == 0 || self.ad_walkframe == 4) ad_monster_footstep(ad_FALSE);
	if (self.ad_walkframe == 2) ad_monster_idle_sound();

	// Update frame and move forward
	self.frame = $run1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 5) self.ad_walkframe = 0;

	// Check for less than half health for drole rampage speed
	if (self.ad_classtype == ad_CT_MONJUSTICE) {
		if (self.health < (self.max_health*0.5)) ad_ai_run(28);
		else ad_ai_run(24);
	}
	else {
		// Check the BOSS tether system
		if (ad_judge_CheckTether()) ad_ai_run(0);
		else ad_ai_run(24);
	}
};

//======================================================================
// MELEE ATTACKS
//======================================================================
void() ad_judge_fistframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	// Judge ONLY attack, make sure no Justice
	if (self.ad_classtype == ad_CT_MONJUSTICE) return;
	
	// Check for summoning condition?
	if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_fistframe;

	// Keep turning towards enemy
	if (self.ad_walkframe >= 0  && self.ad_walkframe <= 7) ad_ai_face();
	// Update frame before so weapon glow can sync
	self.frame = $fist1 + self.ad_walkframe;

	// Do specific stuff on certain animation frames
	if (self.ad_walkframe == 0) {
		// Warn the player of impact
		sound (self, ad_CHAN_WEAPON, "judge/smash_roar.wav", 1, ad_ATTN_NORM);
	}
	// Sneaky distance check before floor smash (must have enemy as well)
	else if (self.ad_walkframe == 6 && self.enemy) {
		// Check if player outside of slam attack range
		self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
		// Cancel melee attack (fist smash ground)
		if (self.ad_enemydist > ad_MONAI_MELEEJUDGE) 
			self.ad_attack_sidestep = ad_TRUE;
	}
	// Time for fist meets ground?
	else if (self.ad_walkframe == 7) {
		// Move toward enemy
		ad_ai_chargenoturn(4); 
		self.ad_meleehitsound = "judge/smash_ground.wav";
		// Pre-defined variables in defscustom.qc
		ad_ai_shockwave(ad_MONAI_JUDGEIMPACT, ad_MONAI_JUDGESMASHDMG, ad_MONAI_JUDGERADIUS, ad_MONAI_JUDGEFORWARD, ad_MONAI_JUDGEUP);
	}
	
	// Enemy has moved too far away for stomp attack to be useful
	// Switch to the jump attack to get closer to the enemy
	// Jump attack is instant so it can blend easily with exit point
	if (self.ad_attack_sidestep) {
		self.ad_walkframe = 0;
		if (random() < 0.7) self.ad_th_jump();
		else self.ad_th_missile();
	}
	else {
		// Update frame and move forward
		self.ad_walkframe = self.ad_walkframe + 1;
		// Finished animation set? (1-12)
		if (self.ad_walkframe > 11) self.ad_th_run();
	}
};

//----------------------------------------------------------------------
void() ad_judge_chargeframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	// Frames don't exist for judge model anymore
	if (self.ad_classtype == ad_CT_MONJUDGE) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_chargeframe;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Beginning of animation block
	// Sword swoosh/whoosh noises
	if (self.ad_walkframe == 2 || self.ad_walkframe == 8) ad_judge_sword_sound();
	// Stompy feet sounds
	else if (self.ad_walkframe == 0 || self.ad_walkframe == 3 ||
		self.ad_walkframe == 6 || self.ad_walkframe == 9) ad_monster_footstep(ad_FALSE);
	// Check for charging damage
	if (self.ad_walkframe == 1 || self.ad_walkframe == 2) ad_ai_melee();
	else if (self.ad_walkframe >= 5 && self.frame <= 9) ad_ai_melee();

	// Update frame and move forward
	self.frame = $charge1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 11) self.ad_th_run();
	// Turn towards enemy and push forward (walkmove)
	else {
		// Check for less than half health for drole rampage speed
		if (self.health < (self.max_health*0.5)) ad_ai_faceforward(28);
		else ad_ai_faceforward(20);
	}
};

//----------------------------------------------------------------------
void() ad_judge_swingframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;

	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_swingframe;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Keep turning towards enemy
	ad_ai_face();
	
	// Put left foot forward first!
	if (self.ad_walkframe >= 1 && self.ad_walkframe <= 4) {
		if (self.ad_classtype == ad_CT_MONJUDGE) ad_ai_forward(ad_JUDGESPD_SWING/4);
		else ad_ai_forward(ad_JUSTICESPD_SWING/4);
	}

	// Sword swoosh/whoosh noises
	if (self.ad_walkframe == 2 || self.ad_walkframe == 7) ad_judge_sword_sound();
	// sword meets flesh! or air ...
	else if (self.ad_walkframe == 3 || self.ad_walkframe == 8) {
		if (self.ad_classtype == ad_CT_MONJUDGE)
			self.ad_meleehitsound = "judge/smash_hit.wav";
		else self.ad_meleehitsound = "justice/smash_hit.wav";
		self.ad_meleecontact = ad_TRUE;
		ad_ai_meleesmash(ad_MONAI_JUDGESWINGDMG);
	}
	
	// Update frame and move forward
	self.frame = $swing1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set? (1-12)
	if (self.ad_walkframe > 11) self.ad_th_run();
};

//----------------------------------------------------------------------
void() ad_judge_smashframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;

	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_smashframe;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Face enemy
	ad_ai_face();
	
	// Put left foot forward first!
	if (self.ad_walkframe >= 1 && self.ad_walkframe <= 5) {
		if (self.ad_classtype == ad_CT_MONJUDGE) ad_ai_forward(ad_JUDGESPD_SMASH/5);
		else ad_ai_forward(ad_JUSTICESPD_SMASH/5);
	}

	// Sword swoosh/whoosh noises
	if (self.ad_walkframe == 3) ad_judge_sword_sound();
	// sword meets flesh! or ground ...
	else if (self.ad_walkframe == 5) {
		if (self.ad_classtype == ad_CT_MONJUDGE)
			self.ad_meleehitsound = "judge/smash_hitheavy.wav";
		else self.ad_meleehitsound = "justice/smash_hitheavy.wav";
		self.ad_meleecontact = ad_TRUE;
		ad_ai_meleesmash(ad_MONAI_JUDGESMASHDMG);
	}
	
	// Update frame and move forward
	self.frame = $smash1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set? (1-10)
	if (self.ad_walkframe > 9) self.ad_th_run();
};

//======================================================================
// (JUSTICE only) MAGIC PATTERN A - Giant arrow heads in diamond
//======================================================================
void(float ad_offset) ad_judge_firemagicA =
{
	local vector ad_org, ad_dir;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "justice/magic_fire.wav", 1, ad_ATTN_NORM);	

	// check for enemy origin (based on sight test)
	// if cannot see enemy fire at last known location
	ad_ai_trackenemy();
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_meleeoffset);
	
	// Create perfect shot (no longer use offset)
	ad_dir = normalize(self.enemy.origin - ad_org);

	// Variable speed based on skill level with extra random spice
	self.ad_attack_speed = ad_SPEED_JUSTICEMISSILE + (ad_skill * ad_SPEED_JUSTICESKILL) + random()*10;
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_JUSTICER, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_judge_magicAframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	// Justice ONLY attack, make sure no Judge (Boss)
	if (self.ad_classtype == ad_CT_MONJUDGE) return;

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_magicAframe;
	
	ad_ai_face();
	// Do specific stuff on certain animation frames
	if (self.ad_walkframe == 0) {
		// Warn the player of firing magic spikes
		sound (self, ad_CHAN_WEAPON, "justice/magic_attack.wav", 1, ad_ATTN_NORM);
		self.frame = $magicA1;
		// Glow ball of magic infront of sword
		ad_justice_setup_attachment();
		self.ad_attack_track = self.enemy.origin;
	}
	else if (self.ad_walkframe >= 1 && self.ad_walkframe <= 3) {
		self.frame = $magicA2;
		ad_justice_update_attachment(self.ad_walkframe);
		ad_particle_implode(self.ad_attachment.origin, 20+random()*20, 100, 100, ad_PARTICLE_BURST_YELLOW);
		ad_ai_trackenemy();
	}
	else if (self.ad_walkframe >= 4 && self.ad_walkframe <= 7) { 
		self.frame = $magicA3 + (self.ad_walkframe-4);
		ad_justice_update_attachment(self.ad_walkframe);
		ad_judge_firemagicA(self.ad_walkframe-4);
	}
	else if (self.ad_walkframe == 8) {
		self.frame = $magicA7;
		ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, self.ad_attachment.origin, ad_SOUND_RESIST_ROCKET);
		ad_justice_finish_attachment();
	}
	else self.ad_th_run();

	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
};

//======================================================================
// (JUSTICE only) FLAMES PATTERN 1 - wall arc infront (at players feet)
//======================================================================
void(float ad_fire_explode) ad_judge_fireflamewall =
{
	local vector ad_org, ad_eorg, ad_torg, ad_dir, ad_ang;
	local float ad_expl_type, ad_targetang, ad_fire_life;

	// Judge cannot find target!
	if (!self.enemy) return;

	// Facing angle
	ad_ai_face();
	makevectors (self.angles);	
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	
	// Setup explosion origin (infront)
	ad_eorg = ad_org + ad_attack_vector('16 0 16');
	
	// BIG EXPLOSION - infront and above impact point
	if (ad_fire_explode == ad_TRUE) {
		// Setup wall parameters
		self.ad_proj_attarc = 1 + ad_skill;
		// Within range? Easy = 3(-1/1), Normal = 5(-2/2), Hard/NM = 7(-3/3)
		if (self.ad_proj_attarc > 3) self.ad_proj_attarc = 3;
		// Invert maximum arc to create beginning/current
		self.ad_proj_attarc = -self.ad_proj_attarc;
		
		if (random() < 0.5) ad_expl_type = ad_EXPLODE_MED;
		else ad_expl_type = ad_EXPLODE_BIG;

		ad_SpawnExplosion(ad_expl_type, ad_eorg, "justice/flame_explode.wav");
	}
	// SMALL EFFECTS
	else {
		// Quiet sfx + dust/smoke
		sound (self, ad_CHAN_WEAPON, "justice/flame_fire.wav", 1, ad_ATTN_NORM);	
		if (random() > 0.5) ad_SpawnProjectileSmoke(ad_eorg, 200, 50, 250);
	}

	// Start with facing angle
	makevectors (self.angles);	
	// Work out offset (24 unit) from left to right (- to +)
	ad_torg = self.enemy.origin + (v_right * (self.ad_proj_attarc*24));
	ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, ad_torg, ad_SPEED_FLAME);
	// Work out angle
	ad_ang = vectoangles(ad_torg - ad_org);
	ad_ang_x = -ad_targetang;	// Negative = upwards angle 
	makevectors (ad_ang);
	// fire flames forward with slight Z wobble
	ad_dir = (v_forward + (v_up * (random()*0.2)) ) * ad_SPEED_FLAME;

	// Fire that flame!
	ad_fire_life = (ad_LIFE_FLAME/2) + random() + random();
	if (random() < 0.5) self.ad_part_exitpuff = ad_FALSE;
	else self.ad_part_exitpuff = ad_TRUE;
	// target, origin, v_forward, colour, size, lifetime, speed
	ad_Launch_Flame (self, ad_org, ad_dir, ad_FLAME_RED, -1, ad_fire_life, ad_SPEED_FLAME);
	// Next arc position
	self.ad_proj_attarc = self.ad_proj_attarc + 1;
};

//----------------------------------------------------------------------
void() ad_judge_flamewall =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	// Justice ONLY attack, make sure no Judge (Boss)
	if (self.ad_classtype == ad_CT_MONJUDGE) return;

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_flamewall;
	
	self.frame = $flame1 + self.ad_walkframe;
	if (self.ad_walkframe >= 0 && self.ad_walkframe <=6) ad_ai_face();
	
	// Do specific stuff on certain animation frames
	if (self.ad_walkframe == 0) {
		// Reset rage counter
		self.ad_attack_rage = 1;
		sound (self, ad_CHAN_WEAPON, "justice/flame_attack.wav", 1, ad_ATTN_NORM);
	}
	// BUILD up of attack ----------------------------------------
	// STRIKE into ground ----------------------------------------
	else if (self.ad_walkframe == 6) { 
		// Sprite Count = Base (X) * (Skill * Y) Maximum = Z
		self.ad_attack_count = ad_SpriteCount_Flame(self.ad_proj_attqty);
		ad_judge_fireflamewall(ad_TRUE);
	}
	// EXIT from attack ------------------------------------------
	else if (self.ad_walkframe >= 12) {
		ad_ai_face();
		// Slow down flame attacks with attack timer/blocker
		self.ad_attack_timer = time + 1 + random();
		// Back to regular movement
		self.ad_attack_state = ad_AS_STRAIGHT;
		self.think = self.ad_th_run;
	}
	// LOOP with sword in ground ---------------------------------
	else if (self.ad_walkframe >= 7 && self.ad_walkframe <= 10) { 
		// Check if the attack is blocked (extra wide for wall/monsters)
		if (ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0')) {
			// Attack is blocked, just exit wasting time
			self.ad_walkframe = 11;  
			self.frame = $flame1 + self.ad_walkframe;
		}
		else {
			// Keep counting down flame attacks (3/5/7 sets)
			self.ad_attack_count = self.ad_attack_count - 1;
			if (self.ad_attack_count > 0) {
				// Keep looping around sword in ground cycle
				if (self.ad_walkframe == 10) self.ad_walkframe = 6;
				ad_judge_fireflamewall(ad_FALSE);
				self.nextthink = time + 0.05;
			}
			else { 
				// Sword out of ground, about to exit loop
				self.ad_walkframe = 11;  
				self.frame = $flame1 + self.ad_walkframe;
				// Anymore rage left? (Burst mode)
				self.ad_attack_rage = self.ad_attack_rage + 1;
				if (self.ad_attack_rage <= 3-ad_skill) {
					// Sprite Count = Base (X) * (Skill * Y) Maximum = Z
					self.ad_attack_count = ad_SpriteCount_Flame(self.ad_proj_attqty);
					// Any sprite space left for flame burst attack?
					if (ad_HazardProjectile_CheckLimit(self, self.ad_attack_count)) {
						// Back around animation loop
						self.ad_walkframe = 1;
					}
				}
			}
		}
	}

	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
};

//======================================================================
// (JUDGE only) MAGIC PATTERN B - Giant arrow heads in sweeping arc
//======================================================================
void(float ad_offset) ad_judge_firemagicB =
{
	local float ad_projcol, ad_fire_col;
	local vector ad_org, ad_dir, ad_fire_pat;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "judge/magic_fire.wav", 1, ad_ATTN_NORM);	

	// Maximum speed, initial speed set in Launch_Missile
	self.ad_attack_speed = ad_SPEED_JUDGEMISSILE + (ad_skill * ad_SPEED_JUDGESKILL);
	
	// check for enemy origin (based on sight test)
	// if cannot see enemy fire at last known location
	ad_ai_trackenemy();

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_meleeoffset);
	
	// Create an arc pattern based on skill level
	ad_fire_pat = '0 0 0';
	ad_fire_pat_y = -2 + ad_offset;
	ad_org = ad_org + ad_attack_vector(ad_fire_pat*16);
	
	// Initially travels outward using sweep/arc pattern
	ad_dir = v_forward + (v_right * (ad_fire_pat_y*0.2));
	// Setup colour scheme (was original red/blue flames)
	ad_projcol = ad_CT_PROJ_JUDGER;
	ad_fire_col = ad_FLAME_RED;
	
	// Skill based projectile fire 0=easy, 1=normal, 2=hard, 3=nm
	if (ad_offset <= ad_skill)
		ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_projcol, self.ad_attack_speed);
	
	// Chance of flame off first (offset=0) swing of sword
	if (ad_offset == 0) {
		// Any sprite space left for flame burst attack?
		if (random() < 0.1 && ad_HazardProjectile_CheckLimit(self, 1)) {
			// Fire that flame!
			ad_dir = v_forward * (100 + (100 * random()));
			// target, origin, v_forward, colour, size, lifetime, speed
			ad_Launch_Flame (self, ad_org, ad_dir, ad_fire_col, ad_FLAME_TINY, -1, ad_SPEED_FLAME);		
		}
		// Majority of the time, spawn projectile dust
		else ad_SpawnVelocitySmoke(ad_org, ad_dir+v_up, 200, 50);
	}
	// Spawn some projectile dust instead
	else ad_SpawnVelocitySmoke(ad_org, ad_dir+v_up, 200, 50);
};

//----------------------------------------------------------------------
void() ad_judge_magicBframe =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	// Boss ONLY attack, make sure no Justice
	if (self.ad_classtype == ad_CT_MONJUSTICE) return;

	if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_magicBframe;
	
	ad_ai_face();
	self.frame = $magicB1 + self.ad_walkframe;

	// Do specific stuff on certain animation frames
	if (self.ad_walkframe == 0) {
		// Warn the player of firing magic
		sound (self, ad_CHAN_WEAPON, "judge/magic_attack.wav", 1, ad_ATTN_NORM);
		self.ad_attack_track = self.enemy.origin;
	}
	// Swinging arm backward
	else if (self.ad_walkframe >= 1 && self.ad_walkframe <= 4) {
		ad_ai_trackenemy();
	}
	// Fire projectiles 1-4 based on skill level
	else if (self.ad_walkframe >= 5 && self.ad_walkframe <= 8) {
		ad_judge_firemagicB(self.ad_walkframe-5);
	}
	
	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 13) self.ad_th_run();
};

//======================================================================
// (JUDGE only) FLAMES PATTERN 2 - straight line towards player
//======================================================================
void() ad_judge_fireflameline =
{
	local vector ad_org, ad_dir;
	local float ad_fire_col;

	// Judge cannot find target!
	if (!self.enemy) return;

	// Turn toward enemy
	ad_ai_face();
	makevectors (self.angles);	
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset2);
	ad_dir = v_forward;
	
	// Setup colour scheme (was original red/blue flames)
	ad_fire_col = ad_FLAME_RED;
	// Fire that flame!
	// Origin, v_forward, colour, sfx
	ad_Launch_Trail (ad_org, ad_dir, ad_fire_col, "");
};

//----------------------------------------------------------------------
void() ad_judge_flameline =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;
	// Boss ONLY attack, make sure no Justice
	if (self.ad_classtype == ad_CT_MONJUSTICE) return;

	// Check for boss wave trigger events
	if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_flameline;
	
	if (self.ad_walkframe <= 6) ad_ai_face();
	self.frame = $flameT1 + self.ad_walkframe;
	// Do specific stuff on certain animation frames
	// Check for last frame (exit) first!
	if (self.ad_walkframe == 0) { 

		sound (self, ad_CHAN_WEAPON, "judge/flame_attack.wav", 1, ad_ATTN_NORM);
	}

	else if (self.ad_walkframe == 6) {
		ad_judge_fireflameline();
	}
	else if (self.ad_walkframe > 11) {
		// Slow down flame attacks with attack timer/blocker
		self.ad_attack_timer = time + 1 + random();
		// Back to regular movement
		self.ad_attack_state = ad_AS_STRAIGHT;
		self.think = self.ad_th_run;
	}

	// Update frame and move forward
	self.ad_walkframe = self.ad_walkframe + 1;
};

//======================================================================
// Lunge forward (leaving ground) and do heavy damage on touch
//----------------------------------------------------------------------
void() ad_judge_JumpTouch =
{
	local float ad_ldmg;
	
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;

	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	ad_ai_jumpbreakable(30);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.nextthink = time + 0.1;
		
	// Keep track of how many times touched the same object
	if (self.ad_jumptouch == other) self.jump_flag = time + ad_MONAI_JUMPTIMEOUT;
	self.ad_jumptouch = other;			// Keep track of touch target

	// Do not damage other demons with jump attacks
	if (self.ad_classtype != other.ad_classtype && other.takedamage) {
		if ( vlen(self.velocity) > 300 ) {
		  ad_ldmg = 20 + 10*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			ad_SpawnMeatSpray(self, other, ad_FALSE);
			ad_SpawnMeatSpray(self, other, ad_FALSE);
			ad_SpawnMeatSpray(self, other, ad_FALSE);
		}
	}

	// Is the Judge floating in the air?
	if (!checkbottom(self)) {
		// Is the Judge standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2) self.think = self.ad_th_jump;
		}
	}
	// Go straight into landing animation
	else self.ad_th_jumpexit();
};

//----------------------------------------------------------------------
void() ad_judge_jump1 = [ $jump1, ad_judge_jump2 ] {ad_ai_face();};
void() ad_judge_jump2 = [ $jump2, ad_judge_jump3 ] {
	ad_ai_face();
	// Same for Judge and Justice
	self.touch = ad_judge_JumpTouch;

	if (self.ad_classtype == ad_CT_MONJUDGE) {
		self.jump_flag = time + ad_MONAI_JUMPJUDGETIME;
		sound (self, ad_CHAN_WEAPON, "judge/leap1.wav", 1, ad_ATTN_NORM);
	}
	else {
		self.jump_flag = time + ad_MONAI_JUMPJUSTICETIME;
		sound (self, ad_CHAN_WEAPON, "justice/leap1.wav", 1, ad_ATTN_NORM);
	}
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

void() ad_judge_jump3 = [ $jump3, ad_judge_jump4 ] {};
void() ad_judge_jump4 = [ $jump4, ad_judge_jump5 ] {};
void() ad_judge_jump5 = [ $jump5, ad_judge_jump5 ] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; 	//random jump angle
		self.think = self.ad_th_jumpexit;
	}
	self.oldorigin = self.origin;
};

//----------------------------------------------------------------------
// Landed with a thud
void()	ad_judge_jump6 = [ $jump6, ad_judge_jump7 ] {ad_monster_footstep(ad_FALSE);};
void()	ad_judge_jump7 = [ $jump7, ad_judge_run ] {
	// Make sure attack state is reset (can then decide melee or range)
	self.ad_attack_state = ad_AS_STRAIGHT; ad_ai_resetangles(); ad_ai_face(); };

//----------------------------------------------------------------------
void() ad_judge_jump = {
	// Entered combat once
	self.ad_attack_active = ad_TRUE;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();
	
	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	self.state = ad_JUDGE_JUMP;
	// No pain + make sword in correct position
	self.ad_pain_finished = time + 1;
	ad_judge_checksword(ad_JUDGE_SWHAND, ad_JUDGE_SFXDEF);
};

//======================================================================
// Entry point for Stand, Walk and Run monster states
// All have to cope with sword out/on back blend animations
//----------------------------------------------------------------------
void() ad_judge_stand = { 
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Let blend animation happen before any walking
	if (self.ad_pausetime > 0 && self.ad_weaponstate != ad_JUDGE_SWSHOULDER) 
		self.ad_pausetime = self.ad_pausetime + 0.5;
	// Standing around, check sword status first
	self.state = ad_JUDGE_STAND;
	ad_judge_checksword(ad_JUDGE_SWSHOULDER, ad_JUDGE_SFXDEF);
};

//----------------------------------------------------------------------
void() ad_judge_walk =  {
	// Start walking
	self.state = ad_JUDGE_WALK;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Which walk animation to use?
	if (self.ad_move_altwalk > 0) ad_judge_checksword(ad_JUDGE_SWHAND, ad_JUDGE_SFXDEF);
	else ad_judge_checksword(ad_JUDGE_SWBACK, ad_JUDGE_SFXDEF);
};

//----------------------------------------------------------------------
void() ad_judge_run =
{
	// Don't start combat with a jump!
	if (!self.ad_attack_active) self.jump_flag = time + 2;
	// Entered combat once
	self.ad_attack_active = ad_TRUE;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	self.state = ad_JUDGE_RUN; 
	ad_judge_checksword(ad_JUDGE_SWHAND, ad_JUDGE_SFXDEF);
};

//----------------------------------------------------------------------
void() ad_judge_melee =
{
	// Entered combat once
	self.ad_attack_active = ad_TRUE;
	// Reset jump attack decision branch
	self.ad_attack_sidestep = ad_FALSE;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	self.state = ad_JUDGE_MELEE; 
	// No pain + make sword in correct position
	self.ad_pain_finished = time + 1;
	ad_judge_checksword(ad_JUDGE_SWHAND, ad_JUDGE_SFXDEF);
};

//----------------------------------------------------------------------
void() ad_judge_range =
{
	// Entered combat once
	self.ad_attack_active = ad_TRUE;
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	//------------------------------------------------------------------
	// Flame LINE and MagicB = JUDGE (boss) only
	//------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		// Magic range will always reach a monster
		if (self.enemy.flags & ad_FL_MONSTER) self.state = ad_JUDGE_MAGICB;
		else {
			// re-check enemy distance
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			// Flame line limited distance
			if (self.ad_enemydist < ad_MONAI_FLAMELINEJUDGE) self.state = ad_JUDGE_LINE;
			else self.state = ad_JUDGE_MAGICB;
			
			// Forced pause between FLAME attacks
			if (self.ad_attack_timer < time) {
				// Any sprite space left for hazard projectiles?
				if ( !(ad_HazardProjectile_CheckLimit(self, ad_FLAME_TRCOUNT)) )
					self.state = ad_JUDGE_MAGICB;
			}
			// Do magic attack instead
			else self.state = ad_JUDGE_MAGICB;
		}
	}
	//------------------------------------------------------------------
	// Flame BURST and MagicA = JUSTICE only
	//------------------------------------------------------------------
	else {
		// Magic range will always reach a monster
		if (self.enemy.flags & ad_FL_MONSTER) self.state = ad_JUDGE_MAGICA;
		else {
			// Easy/Normal = get more spikes Hard/NM = get more flames
			// Easy=0.6, Normal=0.5, Hard=0.4, NM=0.3
			self.ad_attack_chance = 0.6 - (ad_skill * 0.1);
			if (random() > self.ad_attack_chance) self.state = ad_JUDGE_FLAME;
			else self.state = ad_JUDGE_MAGICA;
			// Flame attack does not go up stairs or ledges very well
			if (self.enemy.origin_z > (self.origin_z+ad_MONAI_STEPLARGE)) 
				self.state = ad_JUDGE_MAGICA;
			
			// Forced pause between FLAME attacks
			if (self.ad_attack_timer < time) {
				// Sprite Count = Base (X) * (Skill * Y) Maximum = Z
				self.ad_attack_count = ad_SpriteCount_Flame(self.ad_proj_attqty);
				// Any sprite space left for hazard projectiles? (min = 1 wave)
				if ( !(ad_HazardProjectile_CheckLimit(self, self.ad_attack_count)) )
					self.state = ad_JUDGE_MAGICA;
			}
			// Do magic attack instead
			else self.state = ad_JUDGE_MAGICA;
		}
	}
	
	// No pain + make sure sword in correct position
	self.ad_pain_finished = time + 1;
	ad_judge_checksword(ad_JUDGE_SWHAND, ad_JUDGE_SFXDEF);
};

//======================================================================
// Sword position blending, checked by all functions
// Blend animations ( Back / Shoulder / Hand )
//----------------------------------------------------------------------
void() ad_judge_finishsword =
{
	self.ad_walkframe = self.ad_attack_chance = 0;
	// Where to go next?
	if (self.state == ad_JUDGE_STAND) ad_judge_standframe();
	else if (self.state == ad_JUDGE_TAUNT) ad_judge_tauntframe();
	else if (self.state == ad_JUDGE_IDLEC) ad_judge_idleCframe();
	else if (self.state == ad_JUDGE_IDLED) ad_judge_idleDframe();
	else if (self.state == ad_JUDGE_WALK) ad_judge_walkframe();
	else if (self.state == ad_JUDGE_MELEE) {
		if (self.ad_classtype == ad_CT_MONJUDGE) {
			// Special setup for monster infighting
			if (self.enemy.flags & ad_FL_MONSTER) ad_judge_smashframe();
			// Close enough for classic swing left/right
			else if (ad_ai_checkmelee(self.ad_meleerange, ad_MONAI_MELEEZTALL)) 
				ad_judge_swingframe();
			// Fist smash ground (Boss ONLY)
			else ad_judge_fistframe();
		}
		else {
			// Simple flat (2d) range check
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			// Overhead smash or charging (swing + run)
			if (self.ad_enemydist < ad_MONAI_CLOSEJUSTICE) ad_judge_smashframe();
			else ad_judge_chargeframe();
		}
	}
	else if (self.state == ad_JUDGE_JUMP) ad_judge_jump1();
	else if (self.state == ad_JUDGE_MAGICA) ad_judge_magicAframe();
	else if (self.state == ad_JUDGE_MAGICB) ad_judge_magicBframe();
	else if (self.state == ad_JUDGE_LINE) ad_judge_flameline();
	else if (self.state == ad_JUDGE_FLAME) ad_judge_flamewall();
	// Default = in combat and running
	else ad_judge_runframe();
};

//----------------------------------------------------------------------
void() ad_judge_movesword =
{
	// Check for boss wave trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_movesword;
	// Sword sound (defined beforehand)
	if (self.ad_walkframe == 2) {
		// Allow for sound override
		if (self.ad_blendsfx == ad_JUDGE_SFXDRAW) {
			if (self.ad_classtype == ad_CT_MONJUDGE)
				self.ad_customsound = "judge/sword_draw.wav";
			else self.ad_customsound = "justice/sword_draw.wav";
			sound (self, ad_CHAN_WEAPON, self.ad_customsound, 1, ad_ATTN_NORM);
		}
		else if (self.ad_blendsfx == ad_JUDGE_SFXSHEATH) {
			if (self.ad_classtype == ad_CT_MONJUDGE)
				self.ad_customsound = "judge/sword_sheath.wav";
			else self.ad_customsound = "justice/sword_sheath.wav";
			sound (self, ad_CHAN_WEAPON, self.ad_customsound, 1, ad_ATTN_NORM);
		}
		else if (self.ad_blendsfx == ad_JUDGE_SFXSWOOSH) ad_judge_sword_sound();
	}
	// Step through animation (check direction)
	if (self.ad_blenddir == 1) self.frame = self.ad_blendstart + self.ad_walkframe;
	else self.frame = self.ad_blendstart + (4-self.ad_walkframe);
	self.ad_walkframe = self.ad_walkframe + 1;
	
	// Check if finished animation
	if (self.ad_walkframe > 4) ad_judge_finishsword();
};

//----------------------------------------------------------------------
void(float ad_finalstate, float ad_soundtype) ad_judge_checksword =
{
	// Judge Dead stops here!
	if (self.health < 1) return;
	if (self.state == ad_JUDGE_DEAD) return;

	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	self.ad_walkframe = 0;
	// Is sword in right position? - Move on to next animation
	if (ad_finalstate == self.ad_weaponstate) ad_judge_finishsword();
	else {
		// Setup defaults
		self.ad_blendstart = $drawA1; self.ad_blenddir = 1;
		self.ad_blendsfx = ad_soundtype;

		// drawA1 = Move sword from BACK to hand
		// drawB1 = Move sword from HAND to shoulder
		// drawC1 = Move sword from SHOULDER to back
		// drawD1 = Move sword from SHOULDER to floor
		// drawE1 = Move sword from FLOOR to hand
		if (self.ad_weaponstate == ad_JUDGE_SWBACK) {
			if (ad_finalstate == ad_JUDGE_SWSHOULDER) {
				//dprint("BACK --> SHOULDER\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXDRAW;
				self.ad_blendstart = $drawC1; self.ad_blenddir = -1; }
			else if (ad_finalstate == ad_JUDGE_SWHAND) {
				//dprint("BACK --> HAND\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXDRAW;
				self.ad_blendstart = $drawA1; self.ad_blenddir = 1; }
			else if (ad_finalstate == ad_JUDGE_SWFLOOR) {
				//dprint("BACK --> FLOOR\n");
				// blend does not exist, use shoulder -> floor
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawD1; self.ad_blenddir = 1;
			}
		}
		else if (self.ad_weaponstate == ad_JUDGE_SWSHOULDER) {
			if (ad_finalstate == ad_JUDGE_SWBACK) {
				//dprint("SHOULDER --> BACK\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawC1; self.ad_blenddir = 1; }
			else if (ad_finalstate == ad_JUDGE_SWHAND) {
				//dprint("SHOULDER --> HAND\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawB1; self.ad_blenddir = -1; }
			else if (ad_finalstate == ad_JUDGE_SWFLOOR) {
				//dprint("SHOULDER --> FLOOR\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawD1; self.ad_blenddir = 1;
			}
		}
		else if (self.ad_weaponstate == ad_JUDGE_SWHAND) {
			if (ad_finalstate == ad_JUDGE_SWBACK) {
				//dprint("HAND --> BACK\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXDRAW;
				self.ad_blendstart = $drawA1; self.ad_blenddir = -1; }
			else if (ad_finalstate == ad_JUDGE_SWSHOULDER) {
				//dprint("HAND --> SHOULDER\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawB1; self.ad_blenddir = 1; }
			else if (ad_finalstate == ad_JUDGE_SWFLOOR) {
				//dprint("HAND --> FLOOR\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawE1; self.ad_blenddir = -1;
			}
		}
		else if (self.ad_weaponstate == ad_JUDGE_SWFLOOR) {
			if (ad_finalstate == ad_JUDGE_SWBACK) {
				//dprint("FLOOR --> BACK\n");
				// blend does not exist, use floor -> shoulder
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXDRAW;
				self.ad_blendstart = $drawD1; self.ad_blenddir = -1; }
			else if (ad_finalstate == ad_JUDGE_SWSHOULDER) {
				//dprint("FLOOR --> SHOULDER\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawD1; self.ad_blenddir = -1; }
			else if (ad_finalstate == ad_JUDGE_SWHAND) {
				//dprint("FLOOR --> HAND\n");
				if (ad_soundtype == 0) self.ad_blendsfx = ad_JUDGE_SFXSHEATH;
				self.ad_blendstart = $drawE1; self.ad_blenddir = -1; }
		}
	
		// Setup counter and update state
		self.ad_weaponstate = ad_finalstate;
		// Start blend animation
		ad_judge_movesword();
	}
};

//======================================================================
// BOSS ONLY - summon a bunch of gaunts
//----------------------------------------------------------------------
void() ad_Spawn_judgeMinFX =
{
	// Randomly pick from teleport sounds
	self.lip = random() * 5;
	if (self.lip < 1) self.noise = "misc/r_tele1.wav";
	else if (self.lip < 2) self.noise = "misc/r_tele2.wav";
	else if (self.lip < 3) self.noise = "misc/r_tele3.wav";
	else if (self.lip < 4) self.noise = "misc/r_tele4.wav";
	else self.noise = "misc/r_tele5.wav";
	sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);
	
	// Show ID teleport particle effect
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_TELEPORT);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
};

//----------------------------------------------------------------------
// Fire random plasma spikes while summoning gaunt minions
//----------------------------------------------------------------------
void() ad_Fire_judgePlasma =
{
	local vector ad_org, ad_ovec, ad_rndvec, ad_destvec;

	makevectors(self.angles);
	ad_ovec = self.ad_attack_offset3 + (random() * self.ad_attack_offset4);
	ad_org = self.origin + ad_attack_vector(ad_ovec);
	ad_rndvec = ad_vecrand(0,50,ad_TRUE);
	ad_destvec = normalize(ad_rndvec);
	ad_launch_plasma(ad_org, ad_destvec, ad_CT_SUMMONLIGHT, ad_SPEED_REFLECTION);
};

//----------------------------------------------------------------------
void() ad_Spawn_judgeMin =
{
	// Fire off some random plasma/lightning
	ad_Fire_judgePlasma();
	
	// Cycle through spawn targets and spawn Tfog + Gaunt
	self.lip = self.ad_attack_summon;
	while(self.lip > 0) {
		self.ad_bossminchain.think = ad_Spawn_judgeMinFX;
		self.ad_bossminchain.nextthink = time + 0.01 + random()*0.3;

		// If the spawn locaiton all clear, spawn something!
		self.pos1 = self.ad_bossminchain.origin;
		self.aflag = ad_find_minionspace(self.pos1);			
		if (self.aflag == ad_TRUE) 
			ad_minion_gaunt(self.pos1, self.enemy, 0);
		
		// Next spawn point
		self.ad_bossminchain = self.ad_bossminchain.ad_entchain;
		self.lip = self.lip - 1;
	}
};

//----------------------------------------------------------------------
void() ad_Setup_judgeMin =
{
	local vector ad_org, ad_ovec;
	
	// Work out random position along length of sword
	// Hilt = 20 0 112  Middle = 16 0 128  Top = 12 0 144
	makevectors(self.angles);
	ad_ovec = self.ad_attack_offset3 + (random() * self.ad_attack_offset4);
	ad_org = self.origin + ad_attack_vector(ad_ovec);

	// Slowly suck in particles to sword
	ad_particle_implode(ad_org, 20+random()*20, 75, 75, ad_PARTICLE_BURST_BLUE);
	
	// Generate a random bolt of electricity
	ad_Fire_judgePlasma();

	// Cycle through spawn targets and fire Lightning per frame
	self.lip = self.ad_attack_summon;
	while(self.lip > 0) {
		// Traceline from spawn point to random direction
		self.pos1 = self.ad_bossminchain.origin - ad_org;
		self.pos2 = ad_vecrand(0,50,ad_TRUE);
		self.ad_pos3 = normalize(self.pos1 + self.pos2);
		traceline(ad_org, ad_org + self.ad_pos3 * 600, ad_FALSE, self);
		
		// Create lightning bolt from source to target
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
		WriteEntity (ad_MSG_BROADCAST, self.ad_bossminchain);
		WriteCoord (ad_MSG_BROADCAST, ad_org_x);
		WriteCoord (ad_MSG_BROADCAST, ad_org_y);
		WriteCoord (ad_MSG_BROADCAST, ad_org_z);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);
		
		// Play some arching lightning sounds
		if (random() < 0.5) {
			if (random() < 0.5) sound (self.ad_bossminchain, ad_CHAN_BODY, "judge/elec_arch1.wav", 1, ad_ATTN_NORM);
			else sound (self.ad_bossminchain, ad_CHAN_BODY, "judge/elec_arch2.wav", 1, ad_ATTN_NORM);
		}

		// Next spawn point
		self.ad_bossminchain = self.ad_bossminchain.ad_entchain;
		self.lip = self.lip - 1;
	}
};

//----------------------------------------------------------------------
void() ad_judge_summonframe =
{
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_judge_summonframe;
	self.ad_part_exitbusy = ad_TRUE;

	// Only turn towards player on intro/outro
	if (self.ad_walkframe < 4 || self.ad_walkframe > 9) ad_ai_face();
	
	// Beginning of animation block
	// INTRO sequence --------------------------------------
	if (self.ad_walkframe >= 0 && self.ad_walkframe <= 3) {
		self.frame = $summon1 + self.ad_walkframe;
		// Setup animation sound/loop counter
		if (self.ad_walkframe == 0)
			sound (self, ad_CHAN_WEAPON, "judge/summon.wav", 1, ad_ATTN_NORM);
	}
	// MAIN loop -------------------------------------------
	else if (self.ad_walkframe >= 4 && self.ad_walkframe <= 9) {
		self.frame = $summon1 + self.ad_walkframe;
		if (self.ad_walkframe == 9 && self.ad_attack_count == 1) ad_Spawn_judgeMin();
		else ad_Setup_judgeMin();
	}
	// OUTRO sequence --------------------------------------
	if (self.ad_walkframe > 8) {
		// Keep counting down loop (6 frames)
		self.ad_attack_count = self.ad_attack_count - 1;
		if (self.ad_attack_count > 0) self.ad_walkframe = 3;
		// Setup outro (0-3 backward)
		else self.frame = $summon1 + (13-self.ad_walkframe);		
	}
	
	// Next frame / loop
	self.ad_walkframe = self.ad_walkframe + 1;
	
	// End of sequence? ------------------------------------
	if (self.ad_walkframe > 13) {
		self.ad_walkframe = 0;
		// Restore ammo resistance to default
		ad_Resist_ChangeType(self, ad_FALSE);
		self.style = ad_JUDGE_PHASE2;	// Fight mode
		self.ad_part_exitbusy = ad_FALSE;
		self.ad_th_run();
	}
};

//----------------------------------------------------------------------
void() ad_judge_summon =
{
	// Make sure boss ONLY active for this attack
	if (self.ad_classtype == ad_CT_MONJUSTICE) { 
		self.think = self.ad_th_run; return;
	}

	// Always reset the think
	self.nextthink = time + 0.1;
	self.think = ad_judge_summonframe;
	
	// Block all damage while summoning stuff
	ad_Resist_ChangeType(self, ad_TRUE);
	
	// Reset attack state so it does not keep spawning
	self.ad_attack_state = ad_AS_STRAIGHT;
	self.lip = self.ad_attack_summon;
	while (self.lip > 0) {
		self.cnt = 4;	// Try 4 times, no infinite loops
		while (self.cnt > 0) {
			// Work out 2 empty spaces around Judicator for minions
			self.pos2 = ad_vecrand(self.ad_bossminbase, self.ad_bossminrnd, ad_TRUE);
			// Always spawn higher than boss
			if (self.pos2_z < self.maxs_z) self.pos2_z = self.maxs_z;
			self.pos1 = self.origin + self.pos2;
			// Check for available space for mininon
			self.aflag = ad_find_minionspace(self.pos1);
			self.cnt = self.cnt - 1;
			// Space is right, save origin
			if (self.aflag == ad_TRUE) self.cnt = -10;
		}
		// Found space, store origin for later
		if (self.cnt == -10) self.ad_bossminchain.origin = self.pos1;
		else self.ad_bossminchain.origin = self.origin;
		
		// Next spawn point
		self.ad_bossminchain = self.ad_bossminchain.ad_entchain;
		self.lip = self.lip - 1;
	}
	
	// Start spawning stuff!
	self.ad_walkframe = 0; self.ad_attack_count = 2;
	ad_judge_summonframe();
};

//======================================================================
// Pain, Death and Taxes!
//----------------------------------------------------------------------
void()	ad_judge_painA1 =[ $painA1, ad_judge_painA2 ] {};
void()	ad_judge_painA2 =[ $painA2, ad_judge_painA3 ] {};
void()	ad_judge_painA3 =[ $painA3, ad_judge_painA4 ] {};
void()	ad_judge_painA4 =[ $painA4, ad_judge_run ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_judge_pain =
{
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) ad_justice_finish_attachment();

	if (self.ad_classtype == ad_CT_MONJUDGE) {
		// Check for boss wave trigger events
		if (ad_judge_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	// No pain animations if jumping
	//if (self.touch == judge_JumpTouch) return;

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		self.ad_pain_finished = time + 2;
		// Only do pain animation if required
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2)
			ad_judge_painA1 ();
	}
};

//======================================================================
void() ad_judge_dieA1 =[ $deathA1, ad_judge_dieA2 ] {};
void() ad_judge_dieA2 =[ $deathA2, ad_judge_dieA3 ] {ad_monster_check_gib();};
void() ad_judge_dieA3 =[ $deathA3, ad_judge_dieA4 ] {ad_monster_check_gib();self.solid = ad_SOLID_NOT;};
void() ad_judge_dieA4 =[ $deathA4, ad_judge_dieA5 ] {};
void() ad_judge_dieA5 =[ $deathA5, ad_judge_dieA6 ] {};
void() ad_judge_dieA6 =[ $deathA6, ad_judge_dieA7 ] {
	sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_METALA, 1, ad_ATTN_NORM);};
void() ad_judge_dieA7 =[ $deathA7, ad_judge_dieA8 ] {};
void() ad_judge_dieA8 =[ $deathA8, ad_judge_dieA9 ] {};
void() ad_judge_dieA9 =[ $deathA9, ad_judge_dieA10 ] {ad_monster_death_postcheck();};
void() ad_judge_dieA10 =[ $deathA10, ad_judge_dieA10 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_judge_dieB1 =[ $deathB1, ad_judge_dieB2 ] {};
void() ad_judge_dieB2 =[ $deathB2, ad_judge_dieB3 ] {ad_monster_check_gib();};
void() ad_judge_dieB3 =[ $deathB3, ad_judge_dieB4 ] {ad_monster_check_gib();self.solid = ad_SOLID_NOT;};
void() ad_judge_dieB4 =[ $deathB4, ad_judge_dieB5 ] {};
void() ad_judge_dieB5 =[ $deathB5, ad_judge_dieB6 ] {};
void() ad_judge_dieB6 =[ $deathB6, ad_judge_dieB7 ] {};
void() ad_judge_dieB7 =[ $deathB7, ad_judge_dieB8 ] {
	sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_METALA, 1, ad_ATTN_NORM);};
void() ad_judge_dieB8 =[ $deathB8, ad_judge_dieB9 ] {ad_monster_death_postcheck();};
void() ad_judge_dieB9 =[ $deathB9, ad_judge_dieB9 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_judge_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	
	self.state = ad_JUDGE_DEAD;	// Finally Judge Dead!
	self.effects = 0;			// Remove effects on death
	// Hide any glowing/sprite attachments
	if (self.ad_classtype == ad_CT_MONJUSTICE) {
		ad_justice_finish_attachment();
		ad_justice_remove_attachment();
	}
	
	// Check for any final trigger events
	if (self.ad_classtype == ad_CT_MONJUDGE) {
		if (self.ad_message2 != "") ad_trigger_strs(self.ad_message2,self);
	}
	
	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_judge_dieA1 ();
		else ad_judge_dieB1 ();
	}
};

//======================================================================
// Create gaunt minion entity chain
// Entities are created so that the spawning space can be tested
// before spawning the minions for possible collisions
//======================================================================
float() ad_judge_minionsetup =
{
	local entity ad_min_prev, ad_min_first;
	
	self.lip = self.ad_attack_summon;
	ad_min_prev = ad_min_first = world;
	
	// Cycle through minion list
	while(self.lip > 0) {
		ad_newmis = spawn();
		ad_newmis.origin = self.origin;
		ad_newmis.owner = self;
		// Is this the first pass through loop?
		if (!ad_min_first) ad_min_first = ad_newmis;
		// Any previous entities created?
		if (!ad_min_prev) ad_min_prev = ad_newmis;
		else {
			// Link previous to current entity
			// and move previous forward in chain
			ad_min_prev.ad_entchain = ad_newmis;
			ad_min_prev = ad_newmis;
		}
		// Keep on looping
		self.lip = self.lip - 1;
	}
	// Close loop
	if (ad_min_first) {
		ad_newmis.ad_entchain = ad_min_first;
		self.ad_bossminchain = ad_min_first;
		return ad_FALSE;
	}
	else return ad_TRUE;
};

//----------------------------------------------------------------------
void() ad_judge_spawntether =
{
	// temporary tether point
	self.ad_movelast = spawn();
	self.ad_movelast.owner = self;
	self.ad_movelast.ad_classtype = ad_CT_TETHERENT;
	self.ad_movelast.movetype = ad_MOVETYPE_NONE;
	self.ad_movelast.solid = ad_SOLID_NOT;
	self.ad_movelast.origin = self.origin;
	setsize (self.ad_movelast, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
};

//======================================================================
// INTRO PHASE (??)
//======================================================================
void() ad_judge_readyframe =
{
	self.takedamage = ad_DAMAGE_AIM;	// Can take damage
	self.style = ad_JUDGE_PHASE2;		// Time to fight!
	ad_Resist_ChangeType(self,ad_FALSE);	// restore resistance
	
	// Let the judicator get angry and find targets
	// or stand or walk or run ...
	ad_monster_targets();
	
	//if (self.enemy) self.th_run();	// Hunt the player
	//else self.th_stand();			// Wait for the player
};

//======================================================================
// Setup BOSS Judicator after trigger event
//======================================================================
void() ad_judge_awake =
{
	// make sure boss mode selected
	if (self.ad_classtype == ad_CT_MONJUSTICE) return;

	self.use = ad_SUB_Null;			// No more triggers
	self.style = ad_JUDGE_PHASE1;		// Bursting intro sequence
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.frame = $stand1; self.skin = self.ad_exactskin;
	ad_monster_bbox();					// Setup bounding box

	self.takedamage = ad_DAMAGE_NO;	// Still immune to damage
	self.yaw_speed = 20;			// Average Speed
	self.velocity = '0 0 0';		// Make sure stationary
	self.ad_walkframe = 0;				// reset for animation
	self.ad_attack_summon = ad_skill + 1;	// Total amount of minions

	if (self.ad_tetherrange < 32) self.ad_tetherrange = ad_MONAI_MAXJUDGE;
	if (self.ad_bossminbase <= 64) self.ad_bossminbase = ad_MONAI_BOSS_SUMDIST;
	if (self.ad_bossminrnd <= 64) self.ad_bossminrnd = ad_MONAI_BOSS_SUMRND;

		// skill modifier : Easy = 1, Normal = 2, Hard/NM = 3
	if (self.ad_attack_summon > 3) self.ad_attack_summon = 3;
	// Setup minion chain entity system
	if (ad_judge_minionsetup()) {
		dprint("\b[JUDGE]\b Cannot create minion chain!\n");
		ad_spawn_marker(self.origin+'0 0 32', ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}
		
	// Check for tether system (special target field)
	if (self.ad_tethertarget == "") {
		dprint("\b[JUDGE]\b Generated tetherpoint!\n");
		ad_judge_spawntether();
	}
	// Find the defined tether marker
	else self.ad_movelast = find(world,targetname,self.ad_tethertarget);
	
	// Does the tether entity exist?
	if (!self.ad_movelast) {
		dprint("\b[JUDGE]\b Tether target not found!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}

	// Show BOSS tetherpoint
	ad_spawn_marker(self.ad_movelast.origin+'0 0 8', ad_SPNMARK_RED);
	
	// Zap (50K damage) anything in its place!
	if (self.ad_nospawndamage == 0) 
		ad_spawn_tdeath(self.origin, self);
	// Don't show spawning effect if nogfx
	if (!(self.spawnflags & ad_MON_SPAWN_NOGFX)) 
		ad_spawn_tfog(self.origin);

	// Start spawning BOSS
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size

	// Check for delay spawn monster count
	if (self.ad_delaymonstercount) {
		// Reset both monster count conditions
		self.ad_nomonstercount = self.ad_delaymonstercount = 0;
		total_monsters = total_monsters + 1;
		ad_update_hud_totals(ad_HUD_MONSTERS);
	}

	//Resist_CheckRange(self);		// Double check values
	ad_Resist_Save(self);				// Save for Later
	ad_Resist_ChangeType(self,ad_TRUE);	// resist everything

	// Reset all combat flags and counters
	self.deadflag = ad_DEAD_NO;
	self.ad_liquidbase = self.ad_liquidcheck = 0;
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;

	// Setup boss waves and overall health
	if (self.ad_bosswave < 1) self.ad_bosswavetotal = 4;
	else self.ad_bosswavetotal = self.ad_bosswave;
	
	// Setup boss waves and overall health
	self.ad_bosswave = 1;
	if (self.ad_bosswaveqty < 1) self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_judge_WaveSetupHP();

	self.ad_pain_finished = time + 3;		// Make pain go away
	self.ad_attack_finished = time + 2;	// Reset attack system
	
	// Reset all combat entities
	self.enemy = self.goalentity = self.ad_movetarget = world;

	// Trigger all spawning events (optional)
	if (self.message != "") {
		ad_trigger_strs(self.message, self);
		self.message = "";
	}
	
	// Make sure all death triggers are setup ready
	self.ad_message2 = self.target;
	self.target = self.ad_target2 = self.ad_deathtarget = "";

	// Time for an intro?
	ad_judge_readyframe();
};

//======================================================================
/*ad:QUAKED monster_judicator (1 0 0) (-32 -32 -24) (32 32 80) Ambush
======================================================================*/
void() ad_monster_judicator =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_judge.mdl";			// Judicator Knight
	self.ad_headmdl = "progs/h_judge.mdl";			// Bloody head
	self.ad_gib1mdl = "progs/w_judgesword.mdl";	// Broken sword
	self.ad_gib2mdl = "progs/gib_judgeboot.mdl";	// Boot lying down
	self.ad_gib3mdl = "progs/gib_judgeshould.mdl";	// Shoulder pad

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	self.ad_gib1sound = ad_GIB_IMPACT_METALA;

	self.ad_idle_sound = "judge/idle1.wav";
	precache_sound (self.ad_idle_sound);
	
	// Smash the floor with fist
	precache_model (ad_MODEL_PROJ_RINGSHOCK);
	precache_sound ("judge/smash_roar.wav");
	precache_sound ("judge/smash_ground.wav");
	precache_sound ("judge/smash_hit.wav");
	precache_sound ("judge/smash_hitheavy.wav");
	
	// Skin/Projectile/Flanes coloured differences (RED or BLUE)
	// Ran out of time trying to create good blue flames
	// Might add later in a patch, atm its just a skin change
	if (self.spawnflags & ad_MON_JUDGE_BLUE) self.skin = 1;
	else self.skin = 0;
	
	// Flames + explosions
	ad_PreCache_Flame();
	// Projectile model
	precache_model (ad_MODEL_PROJ_JUDGER);

	// Arrow attack
	precache_sound ("judge/magic_attack.wav");
	precache_sound ("judge/magic_fire.wav");
	precache_sound ("judge/magic_hit.wav");
	
	// Flame (LINE) attack
	precache_sound ("judge/flame_attack.wav");
	
	// Crazy leapin! (re-used from player)
	precache_sound ("judge/leap1.wav");
	
	// Strange roar of monks!
	self.ad_sight_sound = "judge/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.ad_pain_sound = "judge/pain1.wav";
	self.ad_death_sound = "judge/death1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_death_sound);
	precache_sound ("judge/elec_arch1.wav");
	precache_sound ("judge/elec_arch2.wav");
	precache_sound ("judge/summon.wav");

	// New sword sweep/slash sounds
	precache_sound ("judge/sword_draw.wav");
	precache_sound ("judge/sword_sheath.wav");
	
	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_XMASSIVE;

	self.ad_gibhealth = -60;
	self.ad_gibbed = ad_FALSE;				// Starts complete
	self.ad_pain_flinch = 400;				// Really low chance of pain
	self.ad_pain_longanim = ad_FALSE;			// No axe advantage
	self.ad_pain_timeout = 2;				// High pain level
	if (self.ad_infightextra <= 0) self.ad_infightextra = 4; // High infighting damage
	self.ad_steptype = ad_FS_TYPELARGE;		// Giant feet
	self.ad_poisonous = ad_FALSE;				// No Poison version
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	
	self.style = ad_JUDGE_PHASE0;			// No waves setup
	self.state = ad_JUDGE_STAND;			// Default state
	self.ad_weaponstate = ad_JUDGE_SWSHOULDER;// Default sword position
	self.ad_attack_switch = ad_FALSE;			// Avoid idleD if patrolling
	self.ad_move_altwalk = ad_FALSE;			// No alternative walk
	self.ad_attack_active = ad_FALSE;			// Not started combat yet
	
	self.ad_meleerange = ad_MONAI_CLOSEJUDGE;	// swing/smash range
	self.ad_meleecontact = ad_FALSE;			// Smash contact sound
	self.ad_meleeoffset = '24 0 32';		// Arrow spawn height
	self.ad_attack_offset = '32 0 -16';	// Firewall ground explosion
	self.ad_attack_offset2 = '48 0 0';		// Fireline starting point
	self.ad_attack_offset3 = '24 8 112';	// Hilt of summon sword
	self.ad_attack_offset4 = '-16 -12 32';	// Movement vector along sword
	
	self.ad_deathstring = " was judged unworthy by The Judicator\n";
	// Setup default timer/counters for flame attacks
	self.ad_attack_count = self.ad_attack_timer = 0;
	self.ad_part_exitpuff = self.ad_part_exitsound = ad_TRUE;
	self.ad_part_exitfade = self.ad_part_exitbusy = ad_FALSE;
	if (self.ad_proj_trqty <= 1) self.ad_proj_trqty = 32;
	if (self.ad_proj_trdist <= 1) self.ad_proj_trdist = 32;
	// Default skill speed = 0=0.10, 1=0.08, 2=0.06, 3=0.04
	if (self.ad_proj_limit > ad_PROJ_MAXLIMIT) self.ad_proj_limit = ad_PROJ_MAXLIMIT;
	
	// Setup default Proj Count = Base (X) * (Skill * Y) Maximum = Z
	if (ad_CheckZeroVector(self.ad_proj_attqty)) self.ad_proj_attqty = '3 2 7';
	
	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '450 0 225';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPJUDGENEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPJUDGEFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0.75;
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles

	self.ad_th_checkattack = ad_JudgeCheckAttack;
	self.ad_th_stand = ad_judge_stand;
	self.ad_th_walk = ad_judge_walk;
	self.ad_th_run = ad_judge_run;
	self.ad_th_melee = ad_judge_melee;
	self.ad_th_charge = ad_SUB_Null;
	self.ad_th_missile = ad_judge_range;
	self.ad_th_jump = ad_judge_jump;
	self.ad_th_jumpexit = ad_judge_jump6;
	self.ad_th_summon = ad_judge_summon;
	self.ad_th_pain = ad_judge_pain;
	self.ad_th_die = ad_judge_die;

	self.ad_classtype = ad_CT_MONJUDGE;
	self.ad_classgroup = ad_CG_DCAPTAIN;
	self.ad_classmove = ad_MON_MOVEWALK;

	self.health = self.max_health = ad_MEGADEATH;
	self.ad_pain_finished = ad_LARGE_TIMER;		
	self.takedamage = ad_DAMAGE_NO;	// Immune to damage
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)		
	self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage

	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);

	// No targetname = no trigger!
	if (self.targetname == "") {
		dprint("\b[JUDGE]\b Missing targetname name!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}
	// No tether target defined!
	if (self.ad_tethertarget == "") {
		dprint("\b[JUDGE]\b Missing tether target!\n");
	}
	// Monster count exceptions
	if (self.ad_nomonstercount > 0 || self.ad_delaymonstercount > 0) {
		// Some maps have way too many no monster counts
		if (world.ad_no_moncountdevmsg <= 0) {
			dprint("\b[JUDGE]\b ("); dprint(self.targetname);
			dprint(") - no monster count\n");
		}
	}
	// Update count before client spawn
	else total_monsters = total_monsters + 1;
	
	// Devmarker function changes skins, save for later
	self.frame = 0; self.ad_exactskin = self.skin;
	// Display debug diamonds
	ad_monster_devmarker(self);
	// Wait for trigger event
	self.use = ad_judge_awake;
};

