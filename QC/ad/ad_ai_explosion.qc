/*======================================================================
 PROJECTILE Explosion and Blood functions
 
======================================================================*/
// Classic ID rocket/grenade explosion
// Not used anymore, left for map hackers!
void() ad_s_explode1 = [0,	ad_s_explode2] {};
void() ad_s_explode2 = [1,	ad_s_explode3] {};
void() ad_s_explode3 = [2,	ad_s_explode4] {};
void() ad_s_explode4 = [3,	ad_s_explode5] {};
void() ad_s_explode5 = [4,	ad_s_explode6] {};
void() ad_s_explode6 = [5,	ad_SUB_Remove] {};

//----------------------------------------------------------------------
// General purpose animated spite function
// Types: Small, medium, big, plasma, puffpuff!
//----------------------------------------------------------------------
void() ad_SpawnExplosion_think =
{
	self.frame = self.frame + 1;
	if (self.frame > self.count) ad_SUB_Remove();
	else self.nextthink = time + self.speed;
};

//----------------------------------------------------------------------
void(float ad_sprite_type, vector ad_org, string ad_expl_sound) ad_SpawnExplosion =
{
	local string ad_spr_name;
	local float ad_spr_count, ad_spr_speed;
	
	ad_spr_count = -1;
	if (ad_sprite_type == ad_EXPLODE_SMALL) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEEXPLODE), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_SMALL;
			ad_spr_count = 5;
			ad_spr_speed = 0.1;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_MED) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEEXPLODE), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_MED;
			ad_spr_count = 13;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_BIG) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEEXPLODE), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_BIG;
			ad_spr_count = 16;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_PLASMA_SMALL) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEPLASMA), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_PLASMA_SMALL;
			ad_spr_count = 12;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_PLASMA_MED || ad_sprite_type == ad_EXPLODE_PLASMA_BIG) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEPLASMABIG), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_PLASMA_BIG;
			ad_spr_count = 12;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_POISON_SMALL) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEPOISON), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_POISON_SMALL;
			ad_spr_count = 12;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_POISON_MED || ad_sprite_type == ad_EXPLODE_POISON_BIG) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEPOISONMED), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_POISON_MED;
			ad_spr_count = 12;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_ELECT_SMALL || ad_sprite_type == ad_EXPLODE_ELECT_MED
		|| ad_sprite_type == ad_EXPLODE_ELECT_BIG) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEPLASMA), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_ELECTRIC;
			ad_spr_count = 4;
			ad_spr_speed = 0.1;
		}
	}
	// This must be pre-cached by entity using it!
	// This is not cached in worldspawn as its rarely used
	else if (ad_sprite_type == ad_EXPLODE_ICE_BIG) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEPLASMA), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SEXP_ICE_BIG;
			ad_spr_count = 9;
			ad_spr_speed = 0.1;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_BURST_SMOKE) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEBSMOKE), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SBURST_SMOKE;
			ad_spr_count = 6;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_BURST_FLAME) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEBFLAME), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SBURST_FLAME;
			ad_spr_count = 6;
			ad_spr_speed = 0.05;
		}
	}
	else if (ad_sprite_type == ad_EXPLODE_BURST_POISON) {
		if (ad_ext_dppart)
			pointparticles(particleeffectnum(ad_DPP_TEBPOISON), ad_org, '0 0 0', 1);
		else {
			ad_spr_name = ad_SBURST_POISON;
			ad_spr_count = 6;
			ad_spr_speed = 0.05;
		}
	}
	else return;

	// Always spawn a temporary entity
	// Need one for sprite and/or explosion sound
	ad_newmis = spawn();
	ad_newmis.ad_classgroup = ad_CG_TEMPENT;
	ad_newmis.movetype = ad_MOVETYPE_NONE;
	ad_newmis.solid = ad_SOLID_NOT;
	setorigin(ad_newmis, ad_org);

	// Any sprite requirements? (Fitz engine)
	if (ad_spr_count > 0) {
		setmodel(ad_newmis, ad_spr_name);	// Setup sprite
		setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_newmis.alpha = 0.85;		// Slightly transparent
		ad_newmis.effects = 32;		// Additive blending
		ad_newmis.count = ad_spr_count;	// Total frames
		ad_newmis.speed = ad_spr_speed;	// Frame speed

		ad_newmis.think = ad_SpawnExplosion_think;
		ad_newmis.nextthink = time + ad_newmis.speed;
	}
	else {
		// No sprite required but need entity for sound to play
		// Allow for sound to finish and just remove
		setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_newmis.think = ad_SUB_Remove;
		ad_newmis.nextthink = time + 4;
	}

	// Play any explosion sounds on temporary entity
	if (ad_expl_sound != "") {
		sound(ad_newmis, ad_CHAN_WEAPON, ad_expl_sound, 1, ad_ATTN_NORM);
	}
};

//----------------------------------------------------------------------
// Should not be used anymore, this is the old ID system
// Use SpawnExplosion instead, copes with DP effects better
//----------------------------------------------------------------------
void() ad_BecomeExplosion =
{
	self.touch = ad_SUB_Null;
	self.velocity = '0 0 0';
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel(self, "");
	ad_SpawnExplosion(ad_EXPLODE_SMALL, self.origin, "");
	self.nextthink = time + 0.6;
	self.think = ad_SUB_Remove;
};

//----------------------------------------------------------------------
void(vector ad_org, float ad_velrnd, float ad_upbase, float ad_uprnd) ad_SpawnProjectileSmoke =
{
	ad_newmis = spawn();
	ad_newmis.ad_classgroup = ad_CG_TEMPENT;
	ad_newmis.movetype = ad_MOVETYPE_TOSS;
	ad_newmis.solid = ad_SOLID_NOT;
	setmodel(ad_newmis, ad_MODEL_PROJ_SMOKE);
	setorigin(ad_newmis, ad_org);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	if (ad_velrnd > 0) ad_newmis.velocity = ad_vecrand(0,ad_velrnd,ad_TRUE);
	else ad_newmis.velocity = '0 0 0';
	ad_newmis.velocity_z = ad_upbase + random()*ad_uprnd;
	ad_newmis.nextthink = time + 1 + random()*3;
	ad_newmis.think = ad_SUB_Remove;
};

//----------------------------------------------------------------------
void(vector ad_org, vector ad_veldir, float ad_velbase, float ad_velrnd) ad_SpawnVelocitySmoke =
{
	ad_newmis = spawn();
	ad_newmis.ad_classgroup = ad_CG_TEMPENT;
	ad_newmis.movetype = ad_MOVETYPE_TOSS;
	ad_newmis.solid = ad_SOLID_NOT;
	setmodel(ad_newmis, ad_MODEL_PROJ_SMOKE);
	setorigin(ad_newmis, ad_org);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_newmis.velocity = ad_veldir * (ad_velbase + (random()*ad_velrnd));
	ad_newmis.nextthink = time + 1 + random()*3;
	ad_newmis.think = ad_SUB_Remove;
};

//----------------------------------------------------------------------
void(entity ad_source, entity ad_targ) ad_ProjectileType =
{
	// Projectile types (Poison/Robot/Stone/Blood)
	if (ad_source.ad_poisonous) {
		setmodel (ad_targ, ad_MODEL_PROJ_FLESHP);
		ad_targ.ad_gibtype = ad_GIBTYPE_POISON;
	}
	else if (ad_source.ad_classgroup == ad_CG_ROBOT || ad_source.ad_classgroup == ad_CG_STONE) {
		setmodel (ad_targ, ad_MODEL_PROJ_SMOKE);
		ad_targ.ad_gibtype = ad_GIBTYPE_STONE;
	}
	else {
		setmodel (ad_targ, ad_MODEL_PROJ_FLESH);
		ad_targ.ad_gibtype = ad_GIBTYPE_BLOOD;
	}
	// Finally add DP particle trails
	if (ad_ext_dppart) ad_DPP_blood_trail(ad_targ);
};

//----------------------------------------------------------------------
// Mainly used to show resistance to an ammo type
// Also used by boils for their idle gibs
//----------------------------------------------------------------------
void(entity ad_source, vector ad_org, float ad_velrnd, float ad_upbase, float ad_uprnd) ad_SpawnProjectileMeat =
{
	ad_newmis = spawn ();
	ad_newmis.ad_classtype = ad_CT_TEMPGIB;
	ad_newmis.ad_classgroup = ad_CG_TEMPENT;
	ad_newmis.movetype = ad_MOVETYPE_BOUNCE;
	ad_newmis.solid = ad_SOLID_NOT;
	// Projectile types (Poison/Robot/Stone/Blood)
	ad_ProjectileType(ad_source, ad_newmis);
	setorigin (ad_newmis, ad_org);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		
	ad_newmis.velocity = ad_vecrand(0,ad_velrnd,ad_TRUE);
	ad_newmis.velocity_z = ad_upbase, random()*ad_uprnd;
	ad_newmis.avelocity = ad_vecrand(100,ad_velrnd,ad_FALSE);
	ad_newmis.nextthink = time + 1 + random()*3;
	ad_newmis.think = ad_SUB_Remove;
};

//----------------------------------------------------------------------
// SpawnBlood (All blood particles through this function)
//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org, vector ad_vel, float ad_part_qty) ad_SpawnBlood =
{
	local float ad_loop_count, ad_part_col;
	ad_loop_count = 0;
	ad_vel = ad_vel * 0.1;
	
	// monsters show 2 x blood particles (default), it seems pointless
	// to reduce that back down here. When a monster has a high ammo
	// resistance it needs to be obviously less, the default needs to
	// be higher to make a greater visual impact.
	// part_qty = part_qty / 2;

	// Exception - breakables don't really bleed red blood
	if (ad_targ.ad_classgroup == ad_CG_BREAKABLE) ad_part_col = ad_targ.ad_bleedcolour;
	else {
		if (ad_targ.ad_poisonous) ad_part_col = ad_MON_BCOLOR_GREEN;
		else if (ad_targ.ad_classgroup == ad_CG_ROBOT) ad_part_col = ad_MON_BCOLOR_YELLOW;
		// New Exception - does the target defined blood colour?
		// Can be used to override the func object bleeding blood problem
		else if (ad_targ.ad_bleedcolour > 0) ad_part_col = ad_targ.ad_bleedcolour;
		else ad_part_col = ad_MON_BCOLOR_RED;
	}
	
	// Loop through particle count creating bursts of particles
	while(ad_loop_count < 4) {
		if (ad_loop_count == 2 && ad_targ.ad_bleedcolour > 0) ad_part_col = ad_targ.ad_bleedcolour;
		particle (ad_org, ad_vel, ad_part_col + rint(random()*7), ad_part_qty);
		ad_loop_count = ad_loop_count + 1;
	}
};

//----------------------------------------------------------------------
// spawn_touchblood
// Triggered by Touch_Bullet, Touch_PlasmaProjectile, Touch_Projectile
// Used by monsters - DFURY, DOG, FISH, SCORPION, SPIDER, VORELING, ZOMBIEK
//----------------------------------------------------------------------
void(entity ad_source, entity ad_targ, float ad_damage) ad_spawn_touchblood =
{
	local vector ad_org, ad_vel;

	// The vel calculation uses v_up/right, make sure vectors is setup
	makevectors(ad_source.angles);
	ad_vel = normalize (ad_source.velocity);
	ad_vel = normalize(ad_vel + v_up*(random()- 0.5) + v_right*(random()- 0.5));
	ad_vel = ad_vel + 2*trace_plane_normal;
	// Originally vel = ((vel * 200) * 0.2) * 0.01
	ad_vel = ad_vel * 0.4;
	
	// Check for an origin blood offset (monsters)
	if (ad_CheckZeroVector(ad_source.ad_meleeoffset)) ad_org = '0 0 0';
	else ad_org = ad_attack_vector(ad_source.ad_meleeoffset);
	
	ad_SpawnBlood (ad_targ, ad_source.origin + ad_org, ad_vel, ad_damage);
};

//======================================================================
// SpawnMeatSpray
// Changed to remove dependance on 'self' for missile origin
// Changed parameters to add source and destination of attack
// Changed velocity to side so it is calculated correctly from angles
//======================================================================
void(entity ad_source, entity ad_targ, float ad_side) ad_SpawnMeatSpray =
{
	local vector ad_org;

	makevectors(ad_source.angles);

	// Check for a melee offset? - Special vector offset
	if (ad_CheckZeroVector(ad_source.ad_meleeoffset)) ad_org = v_forward * 16;
	else ad_org = ad_attack_vector(ad_source.ad_meleeoffset);
	
	// Create starting point to spawn
	ad_org = ad_org + ad_source.origin;

	if (ad_targ.ad_bleedcolour) ad_SpawnBlood(ad_targ, ad_org, v_up*2, 100);
	else {
		ad_newmis = spawn ();
		ad_newmis.ad_classtype = ad_CT_TEMPGIB;
		ad_newmis.ad_classgroup = ad_CG_TEMPENT;
		ad_newmis.owner = ad_source;
		ad_newmis.movetype = ad_MOVETYPE_BOUNCE;
		ad_newmis.solid = ad_SOLID_NOT;
		
		// Projectile types (Poison/Robot/Stone/Blood)
		ad_ProjectileType(ad_targ, ad_newmis);
		setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		
		setorigin (ad_newmis, ad_org);
	
		// Use side velocity to determine which direction to throw
		ad_newmis.velocity = ((ad_crandom()*16) * v_forward) + (ad_side * v_right);
		ad_newmis.velocity_z = ad_newmis.velocity_z + 150 + 50*random();
		
		ad_newmis.avelocity = ad_vecrand(100,200,ad_FALSE);
		// set newmis duration
		ad_newmis.nextthink = time + 1 + random()*3;
		ad_newmis.think = ad_SUB_Remove;
	}
};
