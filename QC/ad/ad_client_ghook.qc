// AD's readme and docs/vr-port/CREDITS.md), my_progs/client_ghook.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 Player/client Grapple Hook
 
 Rogue Grapple Implementation - Jan'97 by ZOID
  * Only given to player with teamplay 4+ and deathmatch 1 game modes
  * Has a proper hook (animated) and v_weapon model for the player
  * Special beam code (TE_BEAM) for chain between player and hook
  * Slow firing speed of grapple (800 velocity, less than nail/rockets)
  * When grapple hits a surface, is pulled towards hook at 1000 velocity
  * HUD is updated (extra icons) when grapple gun is selected
  * Press/fire to launch the grapple forward for 2s (limits range)
  * Hold fire to push the player forward, only once grapple hooked
  * Can hang from any surface (including sky) for indefinite time
  * Should not work on sky surfaces, uses old pointcontents check
  * Once attached to wall can switch and fire weapons without falling
  * No extra player movement when attached to wall, perfectly still
  * Will do 10dmg when hitting an object/surface (player/button)
  
 Speed runner Implementation - Jul '97 by Perecli Manole AKA Bort
  * This is HEAVILY based on the rogue version, its not 100% original
  * No special mode required to access the hook, available all the time
  * Uses voreball model for hook and NO v_weapon model for the player
  * Generates the chain via a series of models (can stretch with frames)
  * When the grapple hits a surface, the player is dragged in an arc
  * Designed to be a swinging mechanic rather than direct movement
  * Has no extra HUD support or v_model to show item is available
  * Designed to work with other weapons out at the same time (Alt mode)
  * Once at the grapple point, the player is bounced around a lot
  * Press/fire to launch the grapple forward for 2s (limits range)
  * Hold fire to push the player forward, only once grapple hooked
  * Can hang from any surface (including sky) for indefinite time
  * Should not work on sky surfaces, uses old pointcontents check
  * Allows for double tap to fire/release of the grapple point
 
 AD Implementation - Jul 2020 Mostly based on Rogue version
 
======================================================================*/

float ad_GH_PROJOPEN = 0;			// Projectile Hook claws pulled back
float ad_GH_PROJFLYING = 1;		// Projectile Hook claws midway
float ad_GH_PROJCLOSED = 2;		// Projectile Hook claws in deep

float ad_GHC_MAXSPEED = 2000;		// Maximum projectile travel speed
string ad_GHC_SEARCHSTR = "MAGNET";// Special string to find func_grapple hooks
float ad_GH_FUNCBLOCK = 1;			// Grapple hook has been blocked
float ad_GH_FUNCUSED = 2;			// Func_grapplehook has been used

float ad_GHC_TIMEOUT = 0.7;		// Weapon timeout from hitting player/monster
float ad_GHC_TIMERESET = 0.2;		// Minimum amount of time before can use again
float ad_GHC_TIMEMISFIRE = 0.3;	// Misfire sound re-play timer

float ad_GHC_DEBUGMARKS = 40;		// Total amount of debug info markers
float ad_GHC_DEBUGAFTER = 8;		// Ammount to show after releasing grapple hook
float ad_GHC_DEBUGSTART = ad_SPNMARK_WHITE;	// Start of debug marker chain
float ad_GHC_DEBUGCHAIN = ad_SPNMARK_GREEN;	// On chain movement towards grapple
float ad_GHC_DEBUGCLOSE = ad_SPNMARK_BLUE;	// Really close to grapple point
float ad_GHC_DEBUGLETGO = ad_SPNMARK_PURPLE;	// After release from grapple chain
float ad_GHC_DEBUGTIMER = 0.05;	// Timer to slowdown displaying markers

float ad_GHC_HOOKSTYLE = 0;		// Default grapple hook style
float ad_GHC_HOOKEARLY = 0;		// Minimum distance to start pulling player
float ad_GHC_MAXDIST = 1200;		// Max distance to travel before attachment
float ad_GHC_HOOKSPEED = 2000;		// Forward momentum of hook (rocket spd+)
float ad_GHC_PULLSPEED = 600;		// Forward momentum on chain (pulling forward)
float ad_GHC_MINDIST = 100;		// Minimum distance to slowdown velocity
float ad_GHC_MINBEAM = 50;			// Minimum distance to stop drawing beam
float ad_GHC_SIDEANGLE = 20;		// Minimum side angle to check for

float ad_GHC_DMGPLAYER = 4;		// Impact damage against other players
float ad_GHC_DMGMONSTER = 8;		// Impack damage to ALL monsters
float ad_GHC_DMGWORLD = 8;			// Impact damage to world/func entities

vector ad_GHC_LINECHAIN = '16 0 32';		// Forward/Right/Up movement on chain
vector ad_GHC_JUMPCHAIN = '200 0 200';		// Forward/Right/Up jump off chain
vector ad_GHC_BOOSTCHAIN = '300 300 200';	// Forward/Right/Up movement boost
vector ad_GNC_MOVEMONS = '150 0 200';		// Forward/Right/Up monster PUSH

float ad_FUNC_GHOOKBLOCK = 2;		// bmodel blocks grapple hook
float ad_FUNC_GHOOKSOLID = 4;		// bmodel blocks player/projectiles
float ad_FUNC_GHOOKDISPLAY = 16;	// bmodel is visible when enabled
float ad_FUNC_GHOOKALPHA = 32;		// bmodel surface is alpha flickering

// Forward compiler references
void() ad_GrappleHook_Touch;
void(vector ad_org, vector ad_dir, float ad_part_qty) ad_func_ghook_impact;
void(entity ad_targ, entity ad_cltarg, float ad_trigtype) ad_func_ghook_trigger;
void(float ad_switchbbox) ad_func_ghook_bbox;
float() ad_func_ghook_count;

//====================================================================
void() ad_GrappleHook_Distance = 
{
	if (!self.ad_hookent) return;
	self.ad_gh_hookdist = vlen(self.ad_hookent.origin - self.origin);
};

//--------------------------------------------------------------------
void() ad_GrappleHook_MisFire =
{
	// Misfire of weapon
	if (self.ad_gh_misfire < time) {
		sound (self, ad_CHAN_WEAPON, ad_SOUND_MISFIRE, 1, ad_ATTN_NORM);
		self.ad_gh_misfire = time + ad_GHC_TIMEMISFIRE;
	}
};

//====================================================================
// Draw chain using the TE_BEAM system from rogue
//====================================================================
void(entity ad_beamhook, entity ad_targ) ad_GrappleHook_Beam =
{
	// Draw a line (beam.mdl) from hook to player
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_BEAM);
	WriteEntity (ad_MSG_BROADCAST, ad_beamhook);
	WriteCoord (ad_MSG_BROADCAST, ad_beamhook.origin_x);
	WriteCoord (ad_MSG_BROADCAST, ad_beamhook.origin_y);
	WriteCoord (ad_MSG_BROADCAST, ad_beamhook.origin_z);
	// Offset from player origin (firing position)
	WriteCoord (ad_MSG_BROADCAST, ad_targ.origin_x + ad_beamhook.ad_meleeoffset_x);
	WriteCoord (ad_MSG_BROADCAST, ad_targ.origin_y + ad_beamhook.ad_meleeoffset_y);
	WriteCoord (ad_MSG_BROADCAST, ad_targ.origin_z + ad_beamhook.ad_meleeoffset_z);
};

//====================================================================
// Hide Captain Hook! ( Expecting TARG = HOOK )
//====================================================================
void(entity ad_targ) ad_GrappleHook_Reset = 
{
	// Double check this is a hook entity
	if (ad_targ.ad_classtype != ad_CT_GHOOKPROJ) return;
	
	// Updates to CLIENT only
	ad_targ.owner.ad_gh_onhook = ad_FALSE;
	ad_targ.owner.ad_gh_hookout = ad_FALSE;
	ad_targ.owner.ad_gh_pullchain = ad_FALSE;
	if (ad_targ.owner.ad_gh_blockhook < time)
		ad_targ.owner.ad_gh_blockhook = time + ad_GHC_TIMERESET;
	ad_targ.owner.ad_gh_debugafter = ad_GHC_DEBUGAFTER;

	// Updates to HOOK only
	setmodel(ad_targ, "");
	setsize(ad_targ, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	setorigin(ad_targ, ad_targ.owner.origin);
	ad_targ.movetype = ad_MOVETYPE_NONE;
	ad_targ.solid = ad_SOLID_NOT;
	ad_targ.frame = ad_GH_PROJOPEN; ad_targ.skin = 0;
	ad_targ.velocity = ad_targ.avelocity = 0;
	// Always reset flags, otherwise grapple might have onfloor set
	ad_targ.flags = 0; ad_targ.effects = 0;
	ad_targ.ad_attack_finished = 0;
};

//--------------------------------------------------------------------
void() ad_GrappleHook_ResetNoParm = { ad_GrappleHook_Reset(self); };

//====================================================================
// Generate debug diamond chain
// SPNMARK_YELLOW, SPNMARK_BLUE, SPNMARK_GREEN,
// SPNMARK_RED, SPNMARK_PURPLE, SPNMARK_WHITE
//====================================================================
void() ad_GrappleHook_DebugCreate =
{
	local entity ad_hook_prev, ad_hook_first, ad_hookdiam;
	local float ad_debugloop;
	
	// Exceptions
	if (ad_query_configflag(ad_SVR_DEVHELPER)) return;
	if (ad_developer == 0) return;
	if (self.ad_gh_debugmove < 1) return;
	if (self.ad_hookchain) return;
	
	ad_debugloop = 0;
	ad_hookdiam = ad_hook_first = ad_hook_prev = world;
	
	while (ad_debugloop < self.ad_gh_debugmove) {
		// Create debug diamond (based on spawn_marker function)
		ad_hookdiam = spawn();
		ad_hookdiam.ad_classtype = ad_CT_DEVMARKER;
		ad_hookdiam.movetype = ad_MOVETYPE_NONE;
		ad_hookdiam.solid = ad_SOLID_NOT;
		setmodel(ad_hookdiam, ad_MODEL_BROKEN);
		// Initally setup the diamonds around the player origin
		setorigin(ad_hookdiam, self.origin + ad_vecrand(8,8,ad_TRUE));
		setsize (ad_hookdiam, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_hookdiam.skin = ad_SPNMARK_RED;	// Just setup
		ad_hookdiam.frame = 0;
		ad_hookdiam.count = ad_debugloop;		// Sanity check for debug
		// If DP engine active remove particle shadow
		if (ad_engine == ad_ENG_DPEXT) ad_hookdiam.effects = ad_hookdiam.effects + ad_EF_NOSHADOW;

		// Save first entity for later (closing loop)
		if (ad_hook_first == world) ad_hook_first = ad_hookdiam;
		// First time setup of previous entity (points to self)
		if (ad_hook_prev == world) ad_hook_prev = ad_hookdiam;
		// Setup previous entity (first time = self)
		ad_hook_prev.ad_hookchain = ad_hookdiam;
		// Advance the previous entity forward  to current
		ad_hook_prev = ad_hookdiam;
		
		// Keep on looping
		ad_debugloop = ad_debugloop + 1;
	}
	// Close the loop and setup pointer for client
	ad_hookdiam.ad_hookchain = ad_hook_first;
	self.ad_hookchain = ad_hook_first;
};

//--------------------------------------------------------------------
void(float ad_markskin) ad_GrappleHook_DebugUpdate =
{
	// Exceptions
	if (ad_query_configflag(ad_SVR_DEVHELPER)) return;
	if (ad_developer == 0) return;
	if (!self.ad_hookchain) return;
	
	// Check skin range first and then update skin number
	if (ad_markskin < ad_SPNMARK_YELLOW) ad_markskin = ad_SPNMARK_YELLOW;
	if (ad_markskin > ad_SPNMARK_WHITE) ad_markskin = ad_SPNMARK_WHITE;
	self.ad_hookchain.skin = ad_markskin;
	// Place diamond ( self = client )
	setorigin(self.ad_hookchain, self.origin);
	// Move along entity chain to next diamond
	self.ad_hookchain = self.ad_hookchain.ad_hookchain;
};

//====================================================================
// DISPLAY hook parameters in developer console table
//====================================================================
void() ad_GrappleHook_Display =
{
	local float ad_trigtotal;
	// Has the hook been setup yet?
	if (!self.ad_hookent) return;

	// Read override paramters from world FIRST, constants second
	dprint("\n\b  [-- Grapple Hook Statistics --]\b\n"); 
	dprint(    "-----------------------------------\n");
	dprint(  "\bT Description   Value   Def  Time\b\n");
	//          x xxxxxxxxxxxxx xxxxx xxxxx xx.xx
	//             Description   Value
	//-------------------------------------------------------------------------
	if (self.ad_gh_hookstyle == ad_GHC_HOOKSTYLE) dprint("D Move Style    ");
	else dprint("W Move Style    ");
	if (self.ad_gh_hookstyle == ad_GNC_HOOKLINE) dprint(" LINE");
	else if (self.ad_gh_hookstyle == ad_GNC_HOOKBOOST) dprint("BOOST");
	else if (self.ad_gh_hookstyle == ad_GNC_HOOKTRICK) dprint("TRICK");
	if (ad_GHC_HOOKSTYLE == ad_GNC_HOOKLINE) dprint("  LINE\n");
	else if (ad_GHC_HOOKSTYLE == ad_GNC_HOOKBOOST) dprint(" BOOST\n");
	else if (ad_GHC_HOOKSTYLE == ad_GNC_HOOKTRICK) dprint(" TRICK\n");

	// This is an important change, needs to be high up in table
	if (self.ad_gh_funchookonly == ad_TRUE) dprint("W Func GH Only    YES    --\n");	
	//-------------------------------------------------------------------------
	if (self.ad_gh_hookearly == ad_GHC_HOOKEARLY) dprint("D Early Pull    ");
	else dprint("W Early Pull    ");
	ad_lftos(self, self.ad_gh_hookearly, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_HOOKEARLY, 5, 0, ad_BUFFER_DPRINT); dprint("\n");

	//-------------------------------------------------------------------------
	// Time (secs) limit = max distance (map units) / max speed (velocity)
	if (self.ad_hookent.ad_gh_maxdist == ad_GHC_MAXDIST) dprint("D Max Distance  ");
	else dprint("W Max Distance  ");
	ad_lftos(self, self.ad_hookent.ad_gh_maxdist, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_MAXDIST, 5, 0, ad_BUFFER_DPRINT); dprint("\n");

	//-------------------------------------------------------------------------
	if (self.ad_hookent.ad_gh_hookspeed == ad_GHC_HOOKSPEED) dprint("D Hook Speed    ");
	else dprint("W Hook Speed    ");
	ad_lftos(self, self.ad_hookent.ad_gh_hookspeed, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_HOOKSPEED, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 

	self.ad_hookent.ad_gh_timetravel = self.ad_hookent.ad_gh_maxdist / self.ad_hookent.ad_gh_hookspeed;
	ad_lftos(self, self.ad_hookent.ad_gh_timetravel, 2, 2, ad_BUFFER_DPRINT); dprint("\n");

	if (self.ad_hookent.ad_gh_pullspeed == ad_GHC_PULLSPEED) dprint("D Pull Speed    ");
	else dprint("W Pull Speed    ");
	ad_lftos(self, self.ad_hookent.ad_gh_pullspeed, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_PULLSPEED, 5, 0, ad_BUFFER_DPRINT); dprint("\n");

	//-------------------------------------------------------------------------
	if (self.ad_hookent.ad_gh_mindist == ad_GHC_MINDIST) dprint("D Min Distance  ");
	else dprint("W Min Distance  ");
	ad_lftos(self, self.ad_hookent.ad_gh_mindist, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_MINDIST, 5, 0, ad_BUFFER_DPRINT); dprint("\n");

	// Minimum distance to stop drawing beam
	if (self.ad_hookent.ad_gh_minbeam == ad_GHC_MINBEAM) dprint("D Min Beam      ");
	else dprint("W Min Beam      ");
	ad_lftos(self, self.ad_hookent.ad_gh_minbeam, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_MINBEAM, 5, 0, ad_BUFFER_DPRINT); dprint("\n");

	//-------------------------------------------------------------------------
	// Player/Monster/World entity damage
	if (self.ad_hookent.ad_gh_dmg_x == ad_GHC_DMGPLAYER) dprint("D Player Dmg    ");
	else dprint("W Player Dmg    ");
	ad_lftos(self, self.ad_hookent.ad_gh_dmg_x, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_DMGPLAYER, 5, 0, ad_BUFFER_DPRINT); dprint("\n");
	
	if (self.ad_hookent.ad_gh_dmg_y == ad_GHC_DMGMONSTER) dprint("D Monster Dmg   ");
	else dprint("W Monster Dmg   ");
	ad_lftos(self, self.ad_hookent.ad_gh_dmg_y, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_DMGMONSTER, 5, 0, ad_BUFFER_DPRINT); dprint("\n");
	
	if (self.ad_hookent.ad_gh_dmg_z == ad_GHC_DMGWORLD) dprint("D World Dmg     ");
	else dprint("W World Dmg     ");
	ad_lftos(self, self.ad_hookent.ad_gh_dmg_z, 5, 0, ad_BUFFER_DPRINT); dprint(" "); 
	ad_lftos(self, ad_GHC_DMGWORLD, 5, 0, ad_BUFFER_DPRINT); dprint("\n");

	//-------------------------------------------------------------------------
	dprint("- Func Hooks    "); ad_trigtotal = ad_func_ghook_count();
	ad_lftos(self, ad_trigtotal, 5, 0, ad_BUFFER_DPRINT); dprint("     -\n"); 
	dprint("- Debug Markers ");
	ad_lftos(self, self.ad_gh_debugmove, 5, 0, ad_BUFFER_DPRINT); dprint("     -\n"); 

	//-------------------------------------------------------------------------
	// Speed of movement on the chain (forward/right/up)
	if (self.ad_hookent.ad_gh_linechain == ad_GHC_LINECHAIN) dprint("D Linear chain  ");
	else dprint("W Linear chain  ");
	dprint(vtos(self.ad_hookent.ad_gh_linechain));dprint("\n");
	
	// Speed of movement jumping off the chain (forward/right/up)
	if (self.ad_hookent.ad_gh_jumpchain == ad_GHC_JUMPCHAIN) dprint("D Jump chain    ");
	else dprint("W Jump chain    ");
	dprint(vtos(self.ad_hookent.ad_gh_jumpchain)); dprint("\n");
	
	// Boost to movement during pulling of the chain (forward/right/up)
	if (self.ad_hookent.ad_gh_boostchain == ad_GHC_BOOSTCHAIN) dprint("D Boost chain   ");
	else dprint("W Boost chain   ");
	dprint(vtos(self.ad_hookent.ad_gh_boostchain)); dprint("\n");
	
	// Knockback of hook against monsters
	if (self.ad_hookent.ad_gh_movemonster == ad_GNC_MOVEMONS) dprint("D Move monster  ");
	else dprint("W Move monster  ");
	dprint(vtos(self.ad_hookent.ad_gh_movemonster)); dprint("\n");

	dprint("-----------------------------------\n");
};

//====================================================================
// Setup client hoot entity and world/constant defaults
//====================================================================
void() ad_GrappleHook_Setup =
{
	self.ad_hookent = spawn();
	// make sure connected back to owner
	self.ad_hookent.owner = self;
	self.ad_hookent.classname = "ghookproj";
	self.ad_hookent.ad_classtype = ad_CT_GHOOKPROJ;
	self.ad_hookent.mdl = ad_MODEL_PROJ_GHOOK;
	// End point of beam on player
	self.ad_hookent.ad_meleeoffset = '0 0 8';

	//-------------------------------------------------------------------------
	if (world.ad_gh_hookstyle == ad_GNC_HOOKBOOST) self.ad_gh_hookstyle = ad_GNC_HOOKBOOST;
	else if (world.ad_gh_hookstyle == ad_GNC_HOOKTRICK) self.ad_gh_hookstyle = ad_GNC_HOOKTRICK;
	else self.ad_gh_hookstyle = ad_GHC_HOOKSTYLE;

	if (world.ad_gh_hookearly > 0) self.ad_gh_hookearly = world.ad_gh_hookearly;
	else self.ad_gh_hookearly = ad_GHC_HOOKEARLY;
	// Check for range errors
	if (self.ad_gh_hookearly < 0) self.ad_gh_hookearly = 0;
	else if (self.ad_gh_hookearly > ad_GHC_MAXSPEED) self.ad_gh_hookearly = ad_GHC_MAXSPEED;

	if (world.ad_gh_funchookonly > 0) self.ad_gh_funchookonly = ad_TRUE;
	else self.ad_gh_funchookonly = ad_FALSE;
	
	//-------------------------------------------------------------------------
	if (world.ad_gh_maxdist > 0) self.ad_hookent.ad_gh_maxdist = world.ad_gh_maxdist;
	else self.ad_hookent.ad_gh_maxdist = ad_GHC_MAXDIST;

	if (world.ad_gh_hookspeed > 0) self.ad_hookent.ad_gh_hookspeed = world.ad_gh_hookspeed;
	else self.ad_hookent.ad_gh_hookspeed = ad_GHC_HOOKSPEED;
	// Check for range errors
	if (self.ad_hookent.ad_gh_hookspeed < 0) self.ad_hookent.ad_gh_hookspeed = 0;
	else if (self.ad_hookent.ad_gh_hookspeed > ad_GHC_MAXSPEED) self.ad_hookent.ad_gh_hookspeed = ad_GHC_MAXSPEED;

	// Time (secs) limit = max distance (map units) / max speed (velocity)
	self.ad_hookent.ad_gh_timetravel = self.ad_hookent.ad_gh_maxdist / self.ad_hookent.ad_gh_hookspeed;

	//-------------------------------------------------------------------------
	if (world.ad_gh_pullspeed > 0) self.ad_hookent.ad_gh_pullspeed = world.ad_gh_pullspeed;
	else self.ad_hookent.ad_gh_pullspeed = ad_GHC_PULLSPEED;
	// Check for range errors
	if (self.ad_hookent.ad_gh_pullspeed < 0) self.ad_hookent.ad_gh_pullspeed = 0;
	else if (self.ad_hookent.ad_gh_pullspeed > ad_GHC_MAXSPEED) self.ad_hookent.ad_gh_pullspeed = ad_GHC_MAXSPEED;

	//-------------------------------------------------------------------------
	if (world.ad_gh_mindist > 0) self.ad_hookent.ad_gh_mindist = world.ad_gh_mindist;
	else self.ad_hookent.ad_gh_mindist = ad_GHC_MINDIST;
	// Check for range errors
	if (self.ad_hookent.ad_gh_mindist > self.ad_hookent.ad_gh_pullspeed) 
		self.ad_hookent.ad_gh_mindist = self.ad_hookent.ad_gh_pullspeed;

	// Minimum distance to stop drawing beam
	if (world.ad_gh_minbeam > 0) self.ad_hookent.ad_gh_minbeam = world.ad_gh_minbeam;
	else self.ad_hookent.ad_gh_minbeam = ad_GHC_MINBEAM;
	// Check for range errors
	if (self.ad_hookent.ad_gh_minbeam < 20) self.ad_hookent.ad_gh_minbeam = 20;

	//-------------------------------------------------------------------------
	// Player/Monster/World entity damage
	if (world.ad_gh_dmg_x > 0) self.ad_hookent.ad_gh_dmg_x = world.ad_gh_dmg_x;
	else self.ad_hookent.ad_gh_dmg_x = ad_GHC_DMGPLAYER;
	if (self.ad_hookent.ad_gh_dmg_x < 0) self.ad_hookent.ad_gh_dmg_x = 0;

	if (world.ad_gh_dmg_y > 0) self.ad_hookent.ad_gh_dmg_y = world.ad_gh_dmg_y;
	else self.ad_hookent.ad_gh_dmg_y = ad_GHC_DMGMONSTER;
	if (self.ad_hookent.ad_gh_dmg_y < 0) self.ad_hookent.ad_gh_dmg_y = 0;
	
	if (world.ad_gh_dmg_z > 0) self.ad_hookent.ad_gh_dmg_z = world.ad_gh_dmg_z;
	else self.ad_hookent.ad_gh_dmg_z = ad_GHC_DMGWORLD;
	if (self.ad_hookent.ad_gh_dmg_z < 0) self.ad_hookent.ad_gh_dmg_z = 0;

	//-------------------------------------------------------------------------
	if (world.ad_gh_debugmove > 0) self.ad_gh_debugmove = world.ad_gh_debugmove;
	else if (world.ad_gh_debugmove < 0) self.ad_gh_debugmove = ad_GHC_DEBUGMARKS;
	else self.ad_gh_debugmove = 0;		// Default = OFF
	// Check for range errors
	if (self.ad_gh_debugmove > ad_GHC_DEBUGMARKS) self.ad_gh_debugmove = ad_GHC_DEBUGMARKS;
	
	//-------------------------------------------------------------------------
	// Speed of movement on the chain (forward/right/up)
	if (!ad_CheckZeroVector(world.ad_hookent.ad_gh_linechain)) 
		self.ad_hookent.ad_gh_linechain = world.ad_hookent.ad_gh_linechain;
	else self.ad_hookent.ad_gh_linechain = ad_GHC_LINECHAIN;
	
	// Speed of movement jumping off the chain (forward/right/up)
	if (!ad_CheckZeroVector(world.ad_hookent.ad_gh_jumpchain)) 
		self.ad_hookent.ad_gh_jumpchain = world.ad_hookent.ad_gh_jumpchain;
	else self.ad_hookent.ad_gh_jumpchain = ad_GHC_JUMPCHAIN;
	
	// Boost to movement during pulling of the chain (forward/right/up)
	if (!ad_CheckZeroVector(world.ad_hookent.ad_gh_boostchain)) 
		self.ad_hookent.ad_gh_boostchain = world.ad_hookent.ad_gh_boostchain;
	else self.ad_hookent.ad_gh_boostchain = ad_GHC_BOOSTCHAIN;
	
	// Knockback of hook against monsters
	if (!ad_CheckZeroVector(world.ad_hookent.ad_gh_movemonster)) 
		self.ad_hookent.ad_gh_movemonster = world.ad_hookent.ad_gh_movemonster;
	else self.ad_hookent.ad_gh_movemonster = ad_GNC_MOVEMONS;
};

//====================================================================
// Maintain/Update Hook when attached to something
//====================================================================
void() ad_GrappleHook_Thinking = 
{
	// Attached surface has been disabled or switched off?
	if (self.enemy != world && self.enemy.ad_estate & ad_ESTATE_BLOCK) {
		ad_GrappleHook_Reset(self); return; }
	
	// Atached to something that can moving?
	if (self.enemy.solid == ad_SOLID_SLIDEBOX) {
		self.velocity = '0 0 0';
		setorigin(self, self.enemy.origin + self.enemy.mins +
			self.enemy.size * 0.5);
	}
	// Match the velocity of the moving object
	else self.velocity = self.enemy.velocity;

	// Think faster to keep up with moving entities
	self.think = ad_GrappleHook_Thinking;
	self.nextthink = time + 0.05;
};

//====================================================================
// (SELF = HOOKENT) Surface tests for Hook touching
//====================================================================
void() ad_GrappleHook_Touch =
{
	local vector ad_pushmonster;
	
	if (ad_check_skycontent(self.origin)) { ad_GrappleHook_Reset(self); return; }
	if (other == self.owner) return;			// Touching self, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	// Attach to something valid, stop touching
	if (self.ad_attack_finished > time) return;
	
	// Stop touching me, I have touched something!
	self.ad_attack_finished = time + ad_LARGE_TIMER;
	self.touch = ad_SUB_Null;
	// no world interaction
	self.solid = ad_SOLID_NOT;
	// Stop grapple hook moving anymore
	self.velocity = self.avelocity = '0 0 0';

	// Hit anything that bleeds?
	//----------------------------------------------------------------
	if (other.ad_classtype == ad_CT_PLAYER) {
		// Block grapple hook from firing again
		self.owner.ad_gh_blockhook = time + ad_GHC_TIMEOUT;
		
		// Coop exceptions to damage
		if (coop == ad_FALSE) {
			// sound of axe hitting flesh (player)
			sound (self.owner, ad_CHAN_WEAPON, ad_SOUND_AXE_FLESH, 1, ad_ATTN_NORM);
			// Unique damage from grapple hook to PLAYER
			ad_T_Damage (other, self, self.owner, self.ad_gh_dmg_x, ad_DAMARMOR);
			ad_spawn_touchblood (self, other, self.ad_gh_dmg_x);
		}
		// No attachment to players
		ad_GrappleHook_Reset(self); return;
	}
	//----------------------------------------------------------------
	else if (other.flags & ad_FL_MONSTER) {
		// Block grapple hook from firing again
		self.owner.ad_gh_blockhook = time + ad_GHC_TIMEOUT;

		// Ignore BOSS or dead enemies or things immune to damage
		if (other.ad_bossflag == ad_TRUE || other.health < 1 || !other.takedamage) { 
			ad_GrappleHook_Reset(self); return;
		}
		
		// Spawn some particle effects on impact
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);

		// Monster made of Stone?
		if (other.ad_classgroup == ad_CG_STONE) {
			// sound of axe hitting stone
			sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_STONE, 1, ad_ATTN_NORM);
			// Stone too heavy to do damage or move
			ad_GrappleHook_Reset(self); return;
		}
		
		// sound of axe hitting flesh (monster)
		sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_FLESH, 1, ad_ATTN_NORM);
		// Unique damage from grapple hook to MONSTERS
		ad_T_Damage (other, self, self.owner, self.ad_gh_dmg_y, ad_DAMARMOR);
		ad_spawn_touchblood (self, other, self.ad_gh_dmg_x*2);
		
		// Check if monster can be moved?
		if (other.ad_attack_state == ad_AS_TURRET || other.ad_movespeed < 0
			|| other.ad_tetherlock == ad_TRUE) {
			ad_GrappleHook_Reset(self); return;
		}

		// Can only MOVE monsters that walk on the ground
		if (other.ad_classmove == ad_MON_MOVEWALK) {
			// Create facing angles of grapple hook
			makevectors(self.angles);
			// Debug arrow to show impact direction
			//spawn_arrow(self.origin, self.angles,0);
			
			// MOVE monster based on grapple facing angle (+randomness)
			ad_pushmonster = self.ad_gh_movemonster * (1 + (random()*0.2));
			other.velocity = ad_attack_vector(ad_pushmonster);
			// Need to remove ground flag, otherwise no velocity movement
			other.flags = other.flags - (other.flags & ad_FL_ONGROUND);
		}
		// No attachment to monsters
		ad_GrappleHook_Reset(self); return;	
	}
	//----------------------------------------------------------------
	// WORLD or FUNC bmodels (majority of impacts)
	//----------------------------------------------------------------
	else {
		// sound of axe hitting stone
		sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_STONE, 1, ad_ATTN_NORM);
		// Can impact surface be damaged?
		if (other.takedamage) {
			// func bmodels (doors/breakables etc)
			ad_T_Damage (other, self, self.owner, self.ad_gh_dmg_z, ad_DAMARMOR);
		}
		// Spawn some particle effects on impact
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	}
	
	//----------------------------------------------------------------
	// Time for owner (client) to start flying
	self.owner.ad_gh_onhook = ad_TRUE;
	self.owner.flags = self.owner.flags - (self.owner.flags & ad_FL_ONGROUND);
	
	// Keep track of start/finish locations of chain
	// Used to work out Boost % for movement arc
	self.dest1 = self.owner.origin;
	self.dest2 = self.origin;
	
	// Remember attachment (for movement tracking)
	self.enemy = other;
	// switch grapple to anchored position
	self.frame = ad_GH_PROJCLOSED;
	// Keep tracking the attachment (velocity/position)
	self.think = ad_GrappleHook_Thinking;
	self.nextthink = time + 0.05;
};

//====================================================================
// (SELF = CLIENT) Generate hook entity and setup default parameters
//====================================================================
void() ad_W_FireGrapple = 
{
	local vector ad_org, ad_dest, ad_dir, ad_dirangles;
	local float ad_dist;
	
	// Double check client only and alive!
	if (!(self.flags & ad_FL_CLIENT)) return;
	if (self.health < 1) return;
	if (self.ad_gh_hookout == ad_TRUE) return;
	if (self.ad_gh_blockhook > time) return;
	
	// Does the hook entity exist? (should be a once only thing)
	if (!self.ad_hookent) { 
		// Create hook entity and show stats
		ad_GrappleHook_Setup();
		ad_GrappleHook_Display();
		// Create debug diamond chain
		ad_GrappleHook_DebugCreate();
	}
	
	//----------------------------------------------------------------
	// Double check final destination is something solid
	// Use facing camera direction of client as trace vector
	makevectors(self.v_angle);
	ad_org = self.origin + ad_attack_vector(self.ad_hookent.ad_meleeoffset);
	// Use maximum travel distance + a little extra over limit
	ad_dest = ad_org + (v_forward * (self.ad_hookent.ad_gh_maxdist+128));
	// Switch ON bounding boxes of ALL func grapple points in the map!?!
	// * func_grapplehook should work infront of sky brushes
	// * Switching on/off bbox is probably going to have some weird affect
	//   during combat or when there are tons of entities around. :(
	// * Ideally the traceline should find trigger brushes, but it does not!
	//   Traceline really works with bounding boxes and they cannot be on
	//   all the time because they would block everything.
	// * The perfect solution would be triggers because they are ignored
	//   by so many systems, but they are reactive and use touch systems.
	// * The grapple points need to work instantly so that the destination
	//   point can be adjusted before firing the grapple.
	ad_func_ghook_bbox(ad_TRUE);	
	// Trace can be blocked by any bbox entity (nomonsters=FALSE)
	traceline(ad_org, ad_dest, ad_FALSE, self);
	// Switch OFF bounding box of ALL func grapple points
	// only needed them enabled for the traceline function
	ad_func_ghook_bbox(ad_FALSE);
	
	// Work out distance of traceline (first entity contact)
	ad_dist = vlen(trace_endpos - ad_org);
	// Hit any sky textures OR gone beyond maximum distance?
	if (ad_check_skycontent(trace_endpos) || ad_dist > self.ad_hookent.ad_gh_maxdist) {
		// Misfire of weapon and return
		ad_GrappleHook_MisFire();
		return;
	}

	//----------------------------------------------------------------
	// Check for any func grapple hooks (were switched on for collision)
	// Will setup correct (dest) destination for next trace function
	if (trace_ent.ad_classtype == ad_CT_FUNCHOOK) {
		// Is the func ghook blocking?
		if (trace_ent.spawnflags & ad_FUNC_GHOOKBLOCK) {
			// Spawn impact particles on surface back towards client
			ad_func_ghook_impact(trace_endpos, -v_forward, 1);
			// Check for any BLOCKED sound/message
			ad_func_ghook_trigger(trace_ent, self, ad_GH_FUNCBLOCK);
			// Misfire of weapon and return
			ad_GrappleHook_MisFire();
			return;
		}

		// Check for any USED sound/message
		ad_func_ghook_trigger(trace_ent, self, ad_GH_FUNCUSED);
		// Using a grapple hook point
		self.ad_gh_funchook = ad_TRUE;
		// Override origin (setup by func_grapplehook)
		ad_dest = trace_ent.oldorigin;
		ad_dirangles = vectoangles(ad_dest - self.origin);
		// vectoangles has reversed X axis, correct it
		ad_dirangles_x = -ad_dirangles_x;
		makevectors(ad_dirangles);
		// Finally worked out new direction to fire grapple
		ad_dir = v_forward * self.ad_hookent.ad_gh_hookspeed;
	}
	else {
		if (self.ad_gh_funchookonly == ad_TRUE) {
			// Spawn impact particles on surface back towards client
			ad_func_ghook_impact(trace_endpos, -v_forward, 1);
			// Check for any BLOCKED sound/message
			ad_func_ghook_trigger(trace_ent, self, ad_GH_FUNCBLOCK);
			// Misfire of weapon and return
			ad_GrappleHook_MisFire();
			return;
		}
		
		// Default = fire in camera facing direction of client
		self.ad_gh_funchook = ad_FALSE;
		makevectors(self.v_angle);
		ad_dest = ad_org + (v_forward * self.ad_hookent.ad_gh_maxdist);
		ad_dir = v_forward * self.ad_hookent.ad_gh_hookspeed;
		ad_dirangles = vectoangles(v_forward);
	}
		
	//----------------------------------------------------------------
	// dest1 and dest2 are used to work out inverse percentages of
	// distance travelled along grapple hook final path.
	// Will be properly updated once the grapple hook hits something!
	// Don't be blocked by anything (nomonsters=TRUE)
	traceline(ad_org, ad_dest, ad_TRUE, self);
	self.ad_hookent.dest1 = self.origin;
	self.ad_hookent.dest2 = trace_endpos;

	//----------------------------------------------------------------
	// Grapple hit any monsters? Don't pull towards them
	if (trace_ent.flags & ad_FL_MONSTER) self.ad_gh_hookearly = ad_FALSE;
	
	//----------------------------------------------------------------
	// Setup client defaults
	self.ad_gh_hookout = ad_TRUE;				// Grapple is firing
	self.ad_gh_onhook = ad_FALSE;				// Still firing forward
	self.ad_gh_pullchain = ad_TRUE;			// Pull on client system
	self.ad_hookent.ad_pain_finished = -1;	// First marker active
	
	// Player vmodel kickback
	self.punchangle_x = -2;
	// Fire sound of weapon (grapple hook) with variable volume
	self.ad_hookent.volume = 0.5 + (random() * 0.5);
	sound (self, ad_CHAN_WEAPON, ad_SOUND_GHOOKFIRE, self.ad_hookent.volume, ad_ATTN_NORM);
	
	// Small impact against monsters. This type of movetype makes it very
	// hard to hit monsters with the grapple hook.
	//self.hookent.movetype = MOVETYPE_FLY;
	
	// Large projectile impact against monsters (easier to hit)
	self.ad_hookent.movetype = ad_MOVETYPE_FLYMISSILE;
	self.ad_hookent.solid = ad_SOLID_BBOX;
	// Restore model/bbox
	setmodel(self.ad_hookent, self.ad_hookent.mdl);
	setsize (self.ad_hookent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	self.ad_hookent.frame = ad_GH_PROJFLYING;
	
	// Move the hook into initial position
	// velocity/angles defined earlier with sky test
	setorigin(self.ad_hookent, ad_org);
	self.ad_hookent.velocity = ad_dir;
	self.ad_hookent.angles = ad_dirangles;
	self.ad_hookent.flags = 0;
	
	// Setup touch functionality (impact)
	self.ad_hookent.touch = ad_GrappleHook_Touch;
	// Limit grapple hook range by time travelled
	self.ad_hookent.nextthink = time + self.ad_hookent.ad_gh_timetravel;
	self.ad_hookent.think = ad_GrappleHook_ResetNoParm;
};

//====================================================================
// (SELF = CLIENT) Constantly run from client.qc (PlayerPreThink)
// Most conditions run through this function because its run so
// fast/often and will be the most responsive
//====================================================================
void() ad_GrappleHook_Client = 
{
	local vector ad_playervec, ad_chainvec, ad_chainnorm, ad_newvel;
	local vector ad_boostforvec, ad_boostupvec, ad_boostsidevec;
	local float ad_chainlen, ad_boostlen, ad_fixedlen, ad_boostperc, ad_rightang;
	local float ad_f1, ad_f2;
	
	// Have grapple hook?
	if (!(self.ad_moditems & ad_IT_UPGRADE_GHOOK)) return;
	// No hook has been setup yet?
	if (self.ad_hookent.ad_classtype != ad_CT_GHOOKPROJ) return;
	// Dead? Hook should be defined at this point
	if (self.health < 1) { ad_GrappleHook_Reset(self.ad_hookent); return;}
	// Switching away from grapple hook resets hook
	if (self.weapon != ad_IT_AXE) { ad_GrappleHook_Reset(self.ad_hookent); return; }

	// Always calculate distance
	ad_GrappleHook_Distance();

	// Draw debug markers showing movement style
	if(self.ad_gh_debugmove > 0 && self.ad_hookent.ad_pain_finished < time) {
		// Is hook active OR after release/jump markers active?
		if (self.ad_gh_hookout == ad_TRUE || self.ad_gh_debugafter > 0) {
			// pain_finished needs to be tested here because of -1 reset
			// Display the different marker colours (start/main/finish)
			if (self.ad_hookent.ad_pain_finished < 0) ad_GrappleHook_DebugUpdate(ad_GHC_DEBUGSTART);
			else if (self.ad_gh_debugafter > 0) ad_GrappleHook_DebugUpdate(ad_GHC_DEBUGLETGO);
			else if (self.ad_gh_hookdist <= self.ad_hookent.ad_gh_mindist) ad_GrappleHook_DebugUpdate(ad_GHC_DEBUGCLOSE);
			else ad_GrappleHook_DebugUpdate(ad_GHC_DEBUGCHAIN);
			// Slow down updates (this function is PlayerPreThink timing)
			self.ad_hookent.ad_pain_finished = time + ad_GHC_DEBUGTIMER;
			// Count down the after release markers
			if (self.ad_gh_debugafter > 0) self.ad_gh_debugafter = self.ad_gh_debugafter - 1;
		}
	}

	//----------------------------------------------------------------
	// Jump off grapple hook while attached
	if ( (self.ad_gh_onhook == ad_TRUE && self.button2) ||
		 (self.ad_gh_onhook == ad_FALSE && self.ad_gh_hookearly > 0 && self.button2) ) {
		makevectors(self.angles);
		self.velocity = self.velocity + ad_attack_vector(self.ad_hookent.ad_gh_jumpchain);
		// Clear button as jump is happening
		self.button2 = 0;
		// Make sure jump sound happens (can repeat)
		sound (self, ad_CHAN_BODY, ad_SOUND_PLAYER_JUMP, 1, ad_ATTN_NORM);
		// Block grapple hook for a small time
		self.ad_gh_blockhook = time + ad_GHC_TIMEOUT;
		// Make sure jumpboot cycle is reset correctly
		if (self.ad_moditems & ad_IT_ARTJUMPBOOTS) self.ad_jumpboots_onground = ad_TRUE;
		ad_GrappleHook_Reset(self.ad_hookent); return;
	}
	
	// Beyond here requires hook to be out!
	if (self.ad_gh_hookout == ad_FALSE) return; 
	
	//----------------------------------------------------------------
	// Grapple hook still travelling? Client is not on chain at this point
	if ( (self.ad_gh_onhook == ad_FALSE && self.ad_gh_hookearly == ad_FALSE) ||
		 (self.ad_gh_onhook == ad_FALSE && self.ad_gh_hookearly > 0 && self.ad_gh_hookdist < self.ad_gh_hookearly) ) {
		// Draw beam (models) to the hook
		ad_GrappleHook_Beam(self.ad_hookent, self);
		return;
	}
	
	//----------------------------------------------------------------
	// Hook is attached to something and client pulling?
	if (self.ad_gh_onhook == ad_TRUE) {
		// Trick mode stops pulling once left button released
		if (!self.button0 && self.ad_gh_hookstyle == ad_GNC_HOOKTRICK) {
			// Trick version not setup correctly yet
			ad_GrappleHook_Reset(self.ad_hookent);
			return;
			//self.gh_pullchain = FALSE;
			//self.gh_hookfixed = self.gh_hookdist;
		}
		// Drop the hook if the player has lets go of the FIRE button
		// OR used a teleporter OR just jumped out of water
		else if (!self.button0 || self.teleport_time > time) {
			ad_GrappleHook_Reset(self.ad_hookent);
			return;
		}
	}

	//----------------------------------------------------------------
	// Pull client towards HOOK point
	//----------------------------------------------------------------
	if (self.ad_gh_pullchain == ad_TRUE) {
		//----------------------------------------------------------------
		// LINE mode active?
		if (self.ad_gh_hookstyle == ad_GNC_HOOKLINE) {
			// Setup directional vectors
			makevectors(self.v_angle);
			// Player origin + small up/forward LINEAR adjustment
			ad_playervec = self.origin + ad_attack_vector(self.ad_hookent.ad_gh_linechain);
			// Create straight line vector from player(+boost) to hook
			ad_chainvec = self.ad_hookent.origin - ad_playervec;
			// Find out vector length
			ad_chainlen = vlen(ad_chainvec);
			// Normalize for speed multiplier
			ad_chainnorm = normalize(ad_chainvec);

			// Too close to hook?
			if (ad_chainlen <= self.ad_hookent.ad_gh_mindist) {
				// If using a func_grapplehook let client swing around
				if (self.ad_gh_funchook == ad_TRUE) ad_newvel = self.velocity;
				// DEFAULT = slow down client velocity
				else ad_newvel = ad_chainnorm * (ad_chainlen * (self.ad_hookent.ad_gh_mindist*0.1));
			}
			// DEFAULT = full LINEAR speed
			else ad_newvel = ad_chainnorm * self.ad_hookent.ad_gh_pullspeed;

			// Update player velocity/speed
			self.velocity = ad_newvel;
		}
		//----------------------------------------------------------------
		// BOOST mode active?
		else if (self.ad_gh_hookstyle == ad_GNC_HOOKBOOST) {
			// Find out how far through the path the client is
			// Total length, cient progress and % through boost
			ad_chainlen = vlen(self.ad_hookent.dest1 - self.ad_hookent.dest2);
			ad_boostlen = vlen(self.ad_hookent.dest1 - self.origin);
			ad_chainnorm = normalize(self.ad_hookent.origin - self.origin);
			ad_boostperc = ad_boostlen / ad_chainlen;
			
			// Use model angles instead of camera (v_angle) angles!
			// If the camera is looking up it will be included into the
			// directional vector, model angles always faces forward.
			// ** Need to detect if player is looking up/down
			makevectors(self.angles);
			// Calc forward/up movement adjustment using vector length %
			// Vector adjustment is Forward : 1>-0 and UP : 0->1
			// This pushes the player forward at first and then eventually
			// boosts the player upward closer to the hook
			ad_boostforvec = v_forward * ( (1-ad_boostperc) * self.ad_hookent.ad_gh_boostchain_x);
			ad_boostupvec = v_up * (ad_boostperc * self.ad_hookent.ad_gh_boostchain_z);
			// If the player is looking down, then reverse the UP boost
			if (self.v_angle_x > 0) ad_boostupvec = -ad_boostupvec;
			// Create velocity boast (looking forward only)
			ad_newvel = ad_chainnorm * self.ad_hookent.ad_gh_pullspeed;

			// Find out which way the player is facing
			ad_rightang = ad_targangle(self, self.ad_hookent, 180, ad_FALSE);
			// 20 degree turn left or right?
			if (ad_rightang < (180-ad_GHC_SIDEANGLE) || ad_rightang > (180+ad_GHC_SIDEANGLE) ) {
				ad_boostsidevec = v_right * ((1-ad_boostperc) * self.ad_hookent.ad_gh_boostchain_y);
				// 0-180 =right side, 180-360 = left side
				if (ad_rightang > 180) ad_boostsidevec = -ad_boostsidevec;	// reversed
				// slow down forward momentum (* 0.5 - 1.0)
				ad_newvel = ad_chainnorm * (self.ad_hookent.ad_gh_pullspeed * (0.25 + (ad_boostperc*0.75)));
			}
			// No sideway movement
			else ad_boostsidevec = '0 0 0';

			// Too close to hook?
			if (self.ad_gh_hookdist <= self.ad_hookent.ad_gh_mindist) {
				// If using a func_grapplehook let client swing around
				if (self.ad_gh_funchook == ad_TRUE) ad_newvel = self.velocity;
				// DEFAULT = slow down client velocity
				else ad_newvel = ad_newvel + ad_boostupvec*0.5;
			}
			// DEFAULT = extra forward/up boost
			else ad_newvel = ad_newvel + ad_boostforvec + ad_boostupvec + ad_boostsidevec;

			// Update player velocity/speed
			self.velocity = ad_newvel;
		}
		//----------------------------------------------------------------
		// TRICK mode active?
		else if (self.ad_gh_hookstyle == ad_GNC_HOOKTRICK) {
			ad_chainvec = self.ad_hookent.origin - self.origin;
			ad_chainlen = vlen(ad_chainvec);
			ad_chainnorm = normalize(ad_chainvec);
			ad_fixedlen = ad_chainlen;
			
			// if player's location is beyond the chain's reach
			if (ad_chainlen == ad_fixedlen) {		
				// determine player's velocity component of chain vector
				ad_playervec = ad_chainvec * ((self.velocity * ad_chainvec) / (ad_chainvec * ad_chainvec));
				// restrainment default force 
				ad_f2 = (ad_chainlen - ad_fixedlen) * 5;
				// if player's velocity heading is away from the hook
				if ((self.velocity * ad_chainvec) < 0) {
					// if chain has streched for 25 units
					if (ad_chainlen > ad_fixedlen + 25) {
						// remove player's velocity component moving away from hook
						self.velocity = self.velocity - ad_playervec; 
					}
					ad_f1 = ad_f2;
				}
				else { // if player's velocity heading is towards the hook
					if (vlen(ad_playervec) < ad_f2) ad_f1 = ad_f2 - vlen(ad_playervec);
					else ad_f1 = 0;
				}
			}
			else ad_f1 = 0;

			// No distance changes
			self.velocity = self.velocity + normalize(ad_chainvec) * ad_f1;
		}
	}
	
	//----------------------------------------------------------------
	// Draw beam (models) to the hook
	if (self.ad_gh_hookdist > self.ad_hookent.ad_gh_minbeam)
		ad_GrappleHook_Beam(self.ad_hookent, self);
};

//======================================================================
/*ad:QUAKED func_grapplehook (0.5 0 0.5) ? x BLOCK SOLID x DISPLAY ALPHA STARTOFF x Not_Easy Not_Normal Not_Hard Not_DM
Variable sized bmodel that interacts with grapple gun
------- KEYS --------
targetname  : trigger entity (works with entity state system)
target      : target(s) to fire when grapple hook touches
target2     : override bmodel origin for hook point
alpha       : alpha value will vary +/- 20% (def=0.5, req=alpha spnflag)
sounds      : 1=Secret,2=talk,3=switch,4=silent,5=custom,6=secret2
noise       : custom sound to play when USED by grapple hook
message     : message to display when USED by grapple hook
dmg         : damage done when TOUCHED every 0.1s (def=0, add=solid spnflag)
noise1      : custom sound to play when TOUCHED for damaged
waitmin     : >0 = custom TOUCH sound repeat delay (def=1)
noise2      : custom sound to play when BLOCKED by grapple hook
message2    : message to display when BLOCKED by grapple hook
wait        : -1 = sound / msg once, >0 = sound / msg repeat delay (def=1)
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
-------- SPAWNFLAGS --------
BLOCK    : Blocks grapple hook from starting to pull player
SOLID    : Blocks player/projectiles (like a func_wall)
DISPLAY  : Show bmodel surface when active
ALPHA    : bmodel surface is alpha flickering
STARTOFF : Requires trigger to activate
------- NOTES --------
Variable sized bmodel that interacts with grapple gun

======================================================================*/
void(vector ad_org, vector ad_dir, float ad_part_qty) ad_func_ghook_impact =
{
	local float ad_loop_count, ad_part_col;
	ad_loop_count = 0; ad_part_col = 4;
	// Loop through particle count creating bursts of particles
	while(ad_loop_count < 4) {
		particle (ad_org, ad_dir, ad_part_col + rint(random()*7), ad_part_qty);
		ad_loop_count = ad_loop_count + 1;
	}	
};

//----------------------------------------------------------------------
float() ad_func_ghook_count = 
{
	local float ad_hookcount;
	local entity ad_funcent;
	ad_hookcount = 0;
	// Search for any func grapple hook magnets
	ad_funcent = find(world, ad_gh_searchstr, ad_GHC_SEARCHSTR);
	// Found any?
	while (ad_funcent) {
		// Make sure its the right entity type
		if (ad_funcent.ad_classtype == ad_CT_FUNCHOOK)
			ad_hookcount = ad_hookcount + 1;
		// Keep searching through smaller list
		ad_funcent = find(ad_funcent, ad_gh_searchstr, ad_GHC_SEARCHSTR);
	}
	return ad_hookcount;
};

//----------------------------------------------------------------------
void(float ad_switchbbox) ad_func_ghook_bbox =
{
	local entity ad_funcent;
	// Search for any func grapple hook magnets
	ad_funcent = find(world, ad_gh_searchstr, ad_GHC_SEARCHSTR);
	// Found any?
	while (ad_funcent) {
		// Make sure its the right entity type
		if (ad_funcent.ad_classtype == ad_CT_FUNCHOOK) {
			// Is the entity enabled?
			if (ad_funcent.ad_estate & ad_ESTATE_ON) {
				// Is the func entity solid already?
				if (!(ad_funcent.spawnflags & ad_FUNC_GHOOKSOLID)) {
					// Switch on or off the bbox
					if (ad_switchbbox) {
						ad_funcent.solid = ad_SOLID_BBOX;
						setsize (ad_funcent, ad_funcent.ad_bbmins, ad_funcent.ad_bbmaxs);
					}
					else {
						ad_funcent.solid = ad_SOLID_NOT;
						if (!(ad_funcent.spawnflags & ad_FUNC_GHOOKDISPLAY))
							setsize (ad_funcent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
					}
				}
			}
		}
		// Keep searching through smaller list
		ad_funcent = find(ad_funcent, ad_gh_searchstr, ad_GHC_SEARCHSTR);
	}
};

//----------------------------------------------------------------------
void(entity ad_targ, entity ad_cltarg, float ad_trigtype) ad_func_ghook_trigger =
{
	// Double check target entity type
	if (ad_targ.ad_classtype != ad_CT_FUNCHOOK) return;
	// Check for wait/delay timer on sound/msg
	if (ad_targ.ad_attack_finished > time) return;
	// messages need a client
	if (!(ad_cltarg.flags & ad_FL_CLIENT)) return;
	
	// USE condition?
	if (ad_trigtype == ad_GH_FUNCUSED) {
		if (ad_targ.noise != "" && ad_targ.ad_sound_emitter)
			sound(ad_targ.ad_sound_emitter, ad_CHAN_VOICE, ad_targ.noise, ad_targ.volume, ad_ATTN_NORM);
		if (ad_targ.message != "") ad_centerprint(ad_cltarg, ad_targ.message);
	}
	// BLOCKED condition?
	else if (ad_trigtype == ad_GH_FUNCBLOCK) {
		if (ad_targ.noise2 != "" && ad_targ.ad_sound_emitter)
			sound(ad_targ.ad_sound_emitter, ad_CHAN_VOICE, ad_targ.noise2, ad_targ.volume, ad_ATTN_NORM);
		if (ad_targ.ad_message2 != "") ad_centerprint(ad_cltarg, ad_targ.ad_message2);
	}
	// No condition found
	else return;
	
	// Check for any repeat functionality (single timer)
	if (ad_targ.wait < 0) ad_targ.ad_attack_finished = ad_LARGE_TIMER;
	else ad_targ.ad_attack_finished = time + ad_targ.wait;
};

//----------------------------------------------------------------------
void() ad_func_ghook_touch =
{
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	if (other.takedamage == ad_DAMAGE_NO) return;
	if (self.ad_pain_finished < time) {
		// Play sound, do damage and setup timers!
		if (self.noise1 != "" && self.ad_invincible_finished < time && self.ad_sound_emitter) {
			sound(self.ad_sound_emitter, ad_CHAN_VOICE, self.noise1, self.volume, ad_ATTN_NORM);
			self.ad_invincible_finished = time + self.waitmin;
		}
		ad_T_Damage (other, self, self, self.dmg, ad_DAMARMOR);
		self.ad_pain_finished = time + 0.1;
	}
};

//----------------------------------------------------------------------
void() ad_func_ghook_think =
{
	if (self.ad_estate == ad_ESTATE_BLOCK) return;
	// Change the density of the alpha to make bmodel surface flicker
	self.alpha = self.height*0.8 + (self.alpha * (random()*0.4));
	// Solid type SOLID_BSP has to use local timer (ltime)
	if (self.spawnflags & ad_FUNC_GHOOKSOLID) self.nextthink = self.ltime + 0.05;
	else self.nextthink = time + 0.05;
};

//----------------------------------------------------------------------
void() ad_func_ghook_setup = 
{
	// Check for spawning conditions (nightmare, coop)
	// Needs to exist after entity has been added to work for BSPorigin
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;

	// Find any targets
	if (self.ad_target2 != "") 
		self.ad_movetarget = find(world, targetname, self.ad_target2);
	// Use self if could not find any target
	if (!self.ad_movetarget) self.ad_movetarget = self;
	// Ignore (self) func hook entity, already know origin
	if (self.ad_movetarget.ad_classtype != ad_CT_FUNCHOOK) {
		// Find origin (check for bmodel/mdl entity)
		if (self.ad_movetarget.ad_bsporigin)
			self.oldorigin = ad_bmodel_origin(self.ad_movetarget);
		else self.oldorigin = self.ad_movetarget.origin;
	}
	// bmodel surface is alpha flickering
	if (self.spawnflags & ad_FUNC_GHOOKALPHA) {
		self.think = ad_func_ghook_think;
		self.nextthink = time + 0.1;
	}
}

//----------------------------------------------------------------------
void() ad_func_ghook_on =
{
	// No longer need this spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_ENT_STARTOFF);
	// Switch ON
	self.ad_estate = ad_ESTATE_ON;
	
	// Is the bmodel solid? - reqs unique move/solid type
	// push/bsp lets the player stand on it without sliding
	if (self.spawnflags & ad_FUNC_GHOOKSOLID) {
		self.movetype = ad_MOVETYPE_PUSH;
		self.solid = ad_SOLID_BSP;
	}
	else {
		// DEFAULT = not solid to anything but grapple
		self.movetype = ad_MOVETYPE_NONE;
		self.solid = ad_SOLID_NOT;
	}
	// Is the bmodel visable? Show model etc
	if (self.spawnflags & ad_FUNC_GHOOKDISPLAY) {
		// Show bmodel
		setmodel (self, self.mdl);
		// Define bounding box for solid
		if (self.spawnflags & ad_FUNC_GHOOKSOLID) 
			setsize (self, self.ad_bbmins, self.ad_bbmaxs);
		
		// Alpha flickering automatically adds display
		// Can't have alpha without display!
		if (self.spawnflags & ad_FUNC_GHOOKALPHA) {
			self.think = ad_func_ghook_think;
			self.nextthink = time + 0.1;
			// setup local time for solid types
			self.ltime = time;
		}
	}
};

//----------------------------------------------------------------------
void() ad_func_ghook_off =
{
	// Switch OFF
	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel (self, "");
};

//----------------------------------------------------------------------
void() ad_func_grapplehook =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	self.ad_classtype = ad_CT_FUNCHOOK;
	self.ad_gh_searchstr = ad_GHC_SEARCHSTR;
	self.ad_bsporigin = ad_TRUE;		// bmodel origin 0,0,0

	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	self.mdl = self.model;		// Save model for later
	setmodel (self, self.mdl);	// set size and link into world
	self.ad_bbmins = self.mins;	// Save bmodel bounds for later
	self.ad_bbmaxs = self.maxs;
	self.modelindex = 0;
	self.model = "";			// hide bmodel surface

	// Find out the bmodel origin
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	self.oldorigin = ad_bmodel_origin(self);

	self.takedamage = ad_DAMAGE_NO;
	if (self.wait == 0) self.wait = 1;
	if (self.waitmin <= 0) self.waitmin = 1;
	
	// Precache sounds/noise setup
	ad_trigger_bmodel_sounds();
	ad_trigger_bmodel_volume(1);
	// Double check ALL sounds need caching (Use/Touch/Block)
	if (self.noise != "") precache_sound(self.noise);
	if (self.noise1 != "") precache_sound(self.noise1);
	if (self.noise2 != "") precache_sound(self.noise2);
	
	if (self.noise != "" || self.noise1 != "" || self.noise2 != "") {
		// Setup sound emitter where bmodel is correctly located
		self.ad_sound_emitter = spawn();
		setorigin(self.ad_sound_emitter, self.oldorigin);
		self.ad_sound_emitter.ad_classtype = ad_CT_SOUNDEMITTER;
	}

	// bmodel surface is alpha flickering
	if (self.spawnflags & ad_FUNC_GHOOKALPHA) {
		if (!self.alpha) self.alpha = 0.5;	// Default transparent
		self.height = self.alpha;			// Used for think function
		// The surface has to be visible for alpha to work
		self.spawnflags = self.spawnflags | ad_FUNC_GHOOKDISPLAY;
	}
	if (self.dmg > 0) {
		self.touch = ad_func_ghook_touch;
		// The surface has to be solid for touch to work
		self.spawnflags = self.spawnflags | ad_FUNC_GHOOKSOLID;
	}

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_func_ghook_on;
	self.ad_estate_off = ad_func_ghook_off;

	if (self.spawnflags & ad_ENT_STARTOFF) ad_entity_state_off();
	else ad_entity_state_on();	

	// Setup any targets
	self.think = ad_func_ghook_setup;
	self.nextthink = time + 0.2 + (random()*0.3);
};

