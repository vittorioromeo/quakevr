// AD's readme and docs/vr-port/CREDITS.md), my_progs/switchshad.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
Switchable Shadow (lightmaps)

======================================================================*/
float ad_SWITCH_ARRAY_OFF = 0;		// Off value for shadow (light off)
float ad_SWITCH_ARRAY_ON = 9;		// On value for shadow (light on)
float ad_SWITCH_ARRAY_MAX = 10;	// Maximum amount of shadow steps
float ad_SWITCH_SHADOW_DOWN = -1;	// Direction for shadow fading controller
float ad_SWITCH_SHADOW_UP = 1;

float ad_FUNC_SHADOW_FADING = 1;	// Does the shadow fade in/out (trigger)

// Eric Compiler - Switchable Style Shadows
.float		ad_switchshadstyle;	// Switchable style for bmodels (shadows)
.entity		ad_switchfader;		// Controller for fading shadows on bmodels

//----------------------------------------------------------------------
// The array is setup from world.qc before anything loads
//----------------------------------------------------------------------
string ad_shad_str[10];

// The light/shadow lightscale is from A -> M (13 steps)
// The full range is A -> Z, but M -> Z is overbright
// Dividing fading times by 13 is just an awkward result
// It will be much easier if times are divided by 10
// especially as the game/mod tick timer is 0.1s
//
void() ad_switch_shadow_setuparray =
{
	ad_shad_str[0] = "a";  ad_shad_str[1] = "c"; // Missing B
	ad_shad_str[2] = "d";  ad_shad_str[3] = "e";
	
	ad_shad_str[4] = "f";  ad_shad_str[5] = "h"; // Missing G
	
	ad_shad_str[6] = "i"; 	ad_shad_str[7] = "j";
	ad_shad_str[8] = "k";  ad_shad_str[9] = "m"; // Missing L
};

//----------------------------------------------------------------------
void() ad_switch_shadow_on =
{
	// Check there is a shadow lightstyle first?
	// This usually 1-31 (QC defined) and 32-64 (Map defined)
	if (self.ad_switchshadstyle < 1) return;
	lightstyle(self.ad_switchshadstyle, ad_shad_str[ad_SWITCH_ARRAY_OFF]);
};

//----------------------------------------------------------------------
void() ad_switch_shadow_off =
{
	// Check there is a shadow lightstyle first?
	// This usually 1-31 (QC defined) and 32-64 (Map defined)
	if (self.ad_switchshadstyle < 1) return;
	lightstyle(self.ad_switchshadstyle, ad_shad_str[ad_SWITCH_ARRAY_ON]);
};

//======================================================================
/*ad:QUAKED func_shadow (0 .5 .8) ? x FADING x x x x STARTOFF x Not_Easy Not_Normal Not_Hard Not_DM
An Invisible bmodel that casts shadows
-------- KEYS --------
targetname  : trigger entity (works with entity state system)
target      : Func bmodel entity to operate in sync with
state       : Intended state to operate with (0=CLOSED, 1=OPEN)
speed       : Fade in/out timer for the shadow (def=1s)
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
_switchableshadow : 1 = Required parameter
-------- SPAWNFLAGS --------
FADING   : Will gradually fade over time (speed)
STARTOFF : Starts off and waits for trigger
-------- NOTES --------
An Invisible bmodel that casts shadows. It is recommended to paint
these with a special unique texture so they can be filtered or hidden
from view in the editor. This function will not work if brushwork is
painted with clip or skip textures. Recommend to use trigger.

======================================================================*/
void() ad_func_shadow_controller =
{
	local entity ad_tself;
	
	// There are 3 different states of the controller
	// 1. Doing nothing, waiting for changes
	// 2. Detecting changes, start fade process
	// 3. Busy Fading, keep track of direction
	// 
	self.think = ad_func_shadow_controller;
	self.nextthink = time + 0.1;
	// Has the func_shadow entity state changed
	if (self.ad_estate != self.owner.ad_estate) {
		self.ad_estate = self.owner.ad_estate;
	}
	if (self.state != 0) {
		self.owner.count = self.owner.count + self.lip;
		if (self.owner.count <= ad_SWITCH_ARRAY_OFF) { 
			self.owner.count = ad_SWITCH_ARRAY_OFF;
			self.state = 0;
		}
		else if (self.owner.count >= ad_SWITCH_ARRAY_ON) {
			self.owner.count = ad_SWITCH_ARRAY_ON;
			self.state = 0;
		}
		// Switch around self because lightstyle function
		ad_tself = self;
		self = self.owner;
		lightstyle(self.ad_switchshadstyle, ad_shad_str[self.count]);
		self = ad_tself;
	}
};

//----------------------------------------------------------------------
void() ad_func_shadow_setup_controller =
{
	self.ad_switchfader = spawn();
	self.ad_switchfader.ad_classtype = ad_CT_CONTROL;
	// Make sure link back to source entity
	self.ad_switchfader.owner = self;
	self.ad_switchfader.movetype = ad_MOVETYPE_NONE;
	self.ad_switchfader.solid = ad_SOLID_NOT;
	// Move controller entity close to shadow entity
	setorigin(self.ad_switchfader, self.oldorigin);
	setsize (self.ad_switchfader, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	// Setup default state and keep monitoring for changes
	self.ad_switchfader.state = 0;
	self.ad_switchfader.think = ad_func_shadow_controller;
	self.ad_switchfader.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_func_shadow_on =
{
	// No longer need this spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_ENT_STARTOFF);

	// Setup final shadow style
	self.ad_estate = ad_ESTATE_ON;
	// if there is no fade timer, set absolute value
	if (self.speed == ad_FALSE) ad_switch_shadow_on();
};

//----------------------------------------------------------------------
void() ad_func_shadow_off =
{
	// Setup final shadow style
	self.ad_estate = ad_ESTATE_OFF;
	// if there is no fade timer, set absolute value
	if (self.speed == ad_FALSE) ad_switch_shadow_off();
};

//----------------------------------------------------------------------
void() ad_func_shadow =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	self.ad_classtype = ad_CT_FUNCSHADOW;
	self.ad_bsporigin = ad_TRUE;
	self.angles = '0 0 0';
	self.mdl = self.model;
	
	// Add bmodel to world and find origin location
	setmodel (self, self.mdl);
	self.oldorigin = ad_bmodel_origin(self);
	
	// Check if switchable shadow (lightmap) has been defined
	// The entity key points to a light map (32-64) if its active
	if (self.ad_switchshadstyle == 0) {
		dprint("\b[FUNC_SHADOW]\b Missing _switchableshadow entity key!!!\n");
		ad_spawn_marker(self.oldorigin, ad_SPNMARK_YELLOW);
		setmodel (self, "");
		return;
	}

	// The Shadow bmodels need to be invisible
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel (self, "");

	// Check for fading function
	if (self.spawnflags & ad_FUNC_SHADOW_FADING) {
		if (self.speed <= 0) self.speed = 1;
		ad_func_shadow_setup_controller();
	}
	else self.speed = 0;
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_func_shadow_on;
	self.ad_estate_off = ad_func_shadow_off;
	if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
	else self.ad_estate_on();
};
