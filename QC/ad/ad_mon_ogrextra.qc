// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// From the crazy mind of Madfox, comes fishing ogre!?!
//======================================================================
float ad_OGREFISH_FISHY = 0;
float ad_OGREFISH_FISHING = 19;
float ad_OGREFISH_CATCH = 79;
float ad_ANIMATION_OGREFLAP = 18;
float ad_ANIMATION_OGREFISH = 59;
float ad_ANIMATION_OGRECATCH = 25;

//----------------------------------------------------------------------
// Special idle animation - Flappy the fish waggles tail
//----------------------------------------------------------------------
void() ad_ogre_flappyfish =
{
	// If dead, no more updates
	if (self.health < 1) return;

	self.nextthink = time + 0.1;
	self.frame = ad_OGREFISH_FISHY + self.ad_walkframe;

	// Check for special frame conditions
	if (self.ad_walkframe == 0)
		sound (self, ad_CHAN_VOICE, "ogre/ogrefish_flappy.wav", 1, ad_ATTN_NORM);
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > ad_ANIMATION_OGREFLAP) {
		self.ad_walkframe = 0;
		self.think = self.ad_th_altstand;
	}
	else self.think = ad_ogre_flappyfish;
};

//----------------------------------------------------------------------
// Special idle animation - Ogre finally catches something!
//----------------------------------------------------------------------
void() ad_ogre_catchfish =
{
	// If dead, no more updates
	if (self.health < 1) return;

	self.nextthink = time + 0.1;
	self.frame = ad_OGREFISH_CATCH + self.ad_walkframe;

	// Check for special frame conditions
	if (self.ad_walkframe == 6)
		sound (self, ad_CHAN_VOICE, "ogre/ogrefish_out.wav", 1, ad_ATTN_NORM);
	if (self.ad_walkframe == 24)
		sound (self, ad_CHAN_VOICE, "ogre/ogrefish_in.wav", 1, ad_ATTN_NORM);
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > ad_ANIMATION_OGRECATCH) {
		self.ad_walkframe = 0;
		self.think = self.ad_th_altstand;
	}
	else self.think = ad_ogre_catchfish;
};

//----------------------------------------------------------------------
void() ad_ogre_fishing =
{
	// If dead, no more updates
	if (self.health < 1) return;

	self.ad_idlebusy = ad_FALSE;
	self.nextthink = time + 0.1;
	self.frame = ad_OGREFISH_FISHING + self.ad_walkframe;

	// Check for fishing idle animations
	if (self.ad_walkframe == 0) {
		self.lip = random();
		// Finally caught a fish?
		if (self.lip < 0.1) {
			self.think = ad_ogre_catchfish;
			self.ad_idlebusy = ad_TRUE;
		}
		// Flappy the fish gasping for air
		else if (self.lip < 0.2) {
			self.think = ad_ogre_flappyfish;
			self.ad_idlebusy = ad_TRUE;
		}
		// Classic ogre idle + water
		else if (self.lip < 0.3) 
			sound (self, ad_CHAN_VOICE, "ogre/ogrefish_idle.wav", 1, ad_ATTN_NORM);
	}
	
	// Ghost version updates alpha and spawns particles
	if (self.spawnflags & ad_MON_GHOST_ONLY) {
		// Is ogre setup invisible?
		if (self.alpha < 1) {
			// Wait for the ogre to get into position
			if (self.ad_respawn_time < time) {
				// exponential fade in model alpha 
				self.alpha = self.alpha + self.lefty;
				self.lefty = self.lefty + self.lefty;
				if (self.alpha >= 1) self.alpha = 1;
			}
		}
		else {
			// Model is all screwed up, with loads of extra surfaces
			// cannot do alpha sparkle because of back surface problem
			//self.alpha = 0.5 + (0.1*random());
			self.pos1 = '0 0 0';
			self.pos1_x = ad_crandom()*16;
			self.pos1_y = ad_crandom()*16;
			self.pos1_z = ad_crandom()*24;
			if (random() < 0.5) 
				ad_particle_explode(self.origin+self.pos1, 2, 1, ad_PARTICLE_BURST_WHITE, ad_PARTICLE_BURST_LOSTUP);
		}
	}

	if (self.ad_idlebusy == ad_FALSE) {
		// Move frame forward, check for conditions
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe > ad_ANIMATION_OGREFISH) self.ad_walkframe = 0;
		self.think = ad_ogre_fishing;
	}
};

//----------------------------------------------------------------------
void(entity ad_inf, entity ad_att, float ad_dam) ad_ogre_fishpain = {ad_ogre_fishwakeup();};
void() ad_ogre_fishdie = {};

//----------------------------------------------------------------------
void() ad_ogre_fishsetup =
{
	// Setup ghost version (no pain or death)
	if (self.spawnflags & ad_MON_GHOST_ONLY) {
		self.ad_respawn_time = time + 0.3;	// Wait to get into position
		self.lefty = 0.01;				// Exponential increase
		self.solid = ad_SOLID_NOT;			// No interaction with world
		self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
		self.takedamage = ad_DAMAGE_NO;
		self.ad_noradiusdmg = ad_TRUE;
		self.ad_gibhealth = ad_MON_NEVERGIB;
		self.health = ad_LARGE_TIMER;
		self.use = ad_SUB_Null;
	}
	else {
		// Take direct damage only and grenades bounce!
		self.takedamage = ad_DAMAGE_YES;
		self.ad_noradiusdmg = ad_TRUE;
		self.health = ad_MEGADEATH;
		self.use = ad_ogre_fishwakeup;
		
		// Create a temporary entity to fill up space behind ogre
		// Prevent anthing getting in the way when ogre wakes up
		if (!self.ad_attachment) {
			self.ad_attachment = spawn();
			setmodel(self.ad_attachment, ad_MODEL_EMPTY);
			setorigin(self.ad_attachment, self.origin);
			setsize (self.ad_attachment, self.ad_bbmins, self.ad_bbmaxs);
			self.ad_attachment.solid = ad_SOLID_BBOX;
			self.ad_attachment.movetype = ad_MOVETYPE_STEP;
		}
	}
	
	setmodel(self, self.ad_weaponglow);	// Setup fishing model pose
	self.pos1 = self.origin;			// Save current origin for later
	if (self.spawnflags & ad_MON_GHOST_ONLY) self.skin = 2;
	
	// Move ogre into fishing animation position
	makevectors(self.angles);
	self.pos2 = self.origin + ad_attack_vector('36 0 -24');
	setorigin(self, self.pos2);
	// Got to reset bounding box after model change
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	self.ad_walkframe = 0;
	ad_ogre_fishing();
};

//----------------------------------------------------------------------
void() ad_monster_ogre_fishing =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
		
	// Precache basic ogre models and sounds
	ad_monster_ogre_precache();

	// Extra fishing ogre precache stuff
	self.ad_weaponglow = "progs/mon_ogrefish.mdl";
	precache_model (self.ad_weaponglow);
	precache_sound ("ogre/ogrefish_out.wav");
	precache_sound ("ogre/ogrefish_in.wav");
	precache_sound ("ogre/ogrefish_idle.wav");
	precache_sound ("ogre/ogrefish_flappy.wav");

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	self.ad_gibhealth = -80;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 1;			// Pain is the wakeup trigger
	self.ad_pain_longanim = ad_FALSE;		// Cannot be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPESLOW;	// Small sounding feet
	self.ad_no_zaware = ad_FALSE;			// Fishing ogre has perfect aim!
	self.ad_bouncegrenade = ad_TRUE;		// Grenades bounce off!
	self.ad_meleerange = ad_MONAI_MELEEOGRE;	// Chainsaw range
	self.ad_exactskin = 0;				// Skin defined by spawnflag
	self.ad_noinfighting = ad_TRUE;		// No infighting
	self.ad_pain_ignore = ad_TRUE;		// Will not wake up from monsters
	self.ad_movespeed = 0;				// This is not a turret
	self.frame = ad_OGREFISH_FISHING;	// Start in fishing frame
	self.ad_deathstring = " was reeled in by a Fishing Ogre\n";

	// Remove spawnflag options not needed for this monster
	self.lip = 0;
	// Ghost version has unique skin, cannot have green version as well
	if (self.spawnflags & ad_MON_GHOST_ONLY) self.lip = self.lip | ad_MON_GHOST_ONLY;
	else if (self.spawnflags & ad_MON_OGRE_GREEN) self.lip = self.lip | ad_MON_OGRE_GREEN;
	// Classic check for fx/spawn options
	if (self.spawnflags & ad_MON_SPAWN_NOGFX) self.lip = self.lip | ad_MON_SPAWN_NOGFX;
	if (self.spawnflags & ad_MON_SPAWN_DELAY) self.lip = self.lip | ad_MON_SPAWN_DELAY;
	self.spawnflags = self.lip;
	
	// Special event monster has unique HP setup
	if (self.spawnflags & ad_MON_OGRE_GREEN) {
		// Tons of rockets
		if (self.ammo_rockets < 0) self.ammo_rockets = 0;
		else if (self.ammo_rockets == 0) self.ammo_rockets = 6;
		self.health = 350;		// Much stronger
		self.skin = 1;			// Green (Rogue) skin
	}
	else {
		// More rockets than fish!
		if (self.ammo_rockets < 0) self.ammo_rockets = 0;
		else if (self.ammo_rockets == 0) self.ammo_rockets = 4;
		self.health = 150;		// Lower HP than regular
	}

	// Fishing ogre can never uses nails, grenades only
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_OGRE_NAIL);
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = 1;	// Rocket resistance
	self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_OgreCheckAttack;
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_ogre_fishsetup;
	self.ad_th_altstand = ad_ogre_fishing;
	// Setup ghost version (no pain or death)
	if (self.spawnflags & ad_MON_GHOST_ONLY) {
		self.ad_th_pain = ad_SUB_Null_pain;
		self.ad_th_die = ad_SUB_Null;
		self.ad_headmdl = "";
	}
	else {
		self.ad_th_pain = ad_ogre_fishpain;
		self.ad_th_die = ad_ogre_fishdie;
	}

	self.ad_classtype = ad_CT_MONOGREFISH;
	self.ad_classgroup = ad_CG_OGRE;			// One big happy ogre family!
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
}

//----------------------------------------------------------------------
void() ad_monster_ogre_fishing_ghost =
{
	// Special spawnflag (code only)
	self.spawnflags = self.spawnflags | ad_MON_GHOST_ONLY;
	// Always no monster count
	self.ad_nomonstercount = ad_TRUE;
	// Start model invisible (to prevent snapping)
	self.alpha = 0.01;
	ad_monster_ogre_fishing();
};
