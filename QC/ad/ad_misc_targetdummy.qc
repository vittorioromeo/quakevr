//======================================================================
/*ad:QUAKED misc_targetdummy (0 .5 .5) (-32 -32 -24) (32 32 64) KNIGHT WIZARD OGRE HELL_KNIGHT ZOMBIE DEMON SHALRATH SHAMBLER
Target practice dummy
------- KEYS --------
noise1 : Targetnumber tracking weapon used
noise2 : Targetnumber tracking enemy distance
noise3 : Targetnumber tracking damage
noise4 : Targetnumber tracking % efficency
wait   : Impact marker removal time (def=2)
-------- SPAWNFLAGS --------
KNIGHT      : Knight model
WIZARD      : Wizard model
OGRE        : Ogre model
HELL_KNIGHT : Hell Knight model
ZOMBIE      : Zombie model
DEMON       : Demon model
SHALRATH    : Shalrath model
SHAMBLER    : Shambler model
------- NOTES --------
Target practice dummy

======================================================================*/
float ad_MISC_TARGKNIGHT = 1;
float ad_MISC_TARGWIZARD = 2;
float ad_MISC_TARGOGRE = 4;
float ad_MISC_TARGHELLKNIGHT = 8;
float ad_MISC_TARGZOMBIE = 16;
float ad_MISC_TARGDEMON = 32;
float ad_MISC_TARGSHALRATH = 64;
float ad_MISC_TARGSHAMBLER = 128;

//----------------------------------------------------------------------
void(float ad_tvalue, string ad_tdstr) ad_misc_targetdummy_trigger =
{
	local entity ad_tdfind, ad_tself, ad_tother;
	if (ad_tdstr == "") return;
	
	self.ad_targetnumber = ad_tvalue;
	ad_tdfind = find(world, targetname, ad_tdstr);
	if (ad_tdfind.ad_classtype == ad_CT_TARGETNUMBER) {
		ad_tself = self; ad_tother = other;
		self = ad_tdfind; other = ad_tself;
		self.use();
		self = ad_tself; other = ad_tother;
	}
};

//----------------------------------------------------------------------
void() ad_misc_targetdummy_stand =
{
	// Cycle around standing animation
	self.frame = self.frame + 1;
	if (self.frame == self.pos1_y) self.frame = self.pos1_x;
	self.nextthink = time + 0.1;
	
	// Check for any accumulating damage totals
	if (self.ad_attack_finished < time) {
		dprint("Wpn (");
		if (self.weapon & ad_IT_SHOTGUN) dprint("Shotgun");
		else if (self.weapon & ad_IT_SUPER_SHOTGUN && self.ad_moditems & ad_IT_UPGRADE_SSG)
				dprint("Shotgun Upgrade");
		else if (self.weapon & ad_IT_SUPER_SHOTGUN) dprint("Super Shotgun");
		else if (self.weapon & ad_IT_NAILGUN) dprint("Nail Gun");
		else if (self.weapon & ad_IT_SUPER_NAILGUN) dprint("Super Nail Gun");
		else if (self.weapon & ad_IT_GRENADE_LAUNCHER) dprint("Grenade Launcher");
		else if (self.weapon & ad_IT_ROCKET_LAUNCHER) dprint("Rocket Launcher");
		else if (self.weapon & ad_IT_LIGHTNING && self.ad_moditems & ad_IT_UPGRADE_LG)
			dprint("Lightning Upgrade");
		else if (self.weapon & ad_IT_LIGHTNING) dprint("Lightning Gun");
		else dprint("Unknown");
		dprint(") Dist ("); ad_lftos(self, self.ad_enemydist, 3, 2, ad_BUFFER_DPRINT);
		//dprint(ftos(self.enemydist));
		dprint(") Dmg ("); dprint(ftos(self.dmg)); 
		dprint(") % (");
		if (self.weapon & ad_IT_SHOTGUN || self.weapon & ad_IT_SUPER_SHOTGUN) {
			if (self.weapon & ad_IT_SHOTGUN) self.cnt = self.dmg / 28;
			else if (self.ad_moditems & ad_IT_UPGRADE_SSG) self.cnt = self.dmg / 84;
			else self.cnt = self.dmg / 56;
			self.cnt = self.cnt * 100;
		}
		else self.cnt = 100;
		ad_lftos(self, self.cnt, 3, 2, ad_BUFFER_DPRINT);
		//dprint(ftos(self.cnt));
		dprint(")\n");
		
		ad_misc_targetdummy_trigger(self.weapon, self.noise1);
		ad_misc_targetdummy_trigger(self.ad_enemydist, self.noise2);
		ad_misc_targetdummy_trigger(self.dmg, self.noise3);
		ad_misc_targetdummy_trigger(self.cnt, self.noise4);
		
		// Reset health, damage timer and total
		self.health = self.max_health;
		self.ad_attack_finished = ad_LARGE_TIMER;
		self.dmg = 0;
	}
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_misc_targetdummy_pain =
{
	// want all damage to go through pain function, reset timer
	self.ad_pain_finished = 0;

	// Play a pain sound every second
	if (self.ad_pain_check < time) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		self.ad_pain_check = time + 1;
	}
	
	// If the attacker is a player, record details
	if (ad_attacker.flags & ad_FL_CLIENT) {
		self.weapon = ad_attacker.weapon;
		self.items = ad_attacker.items;
		self.ad_moditems = ad_attacker.ad_moditems;
		self.ad_enemydist = ad_range_distance(ad_attacker, ad_TRUE);
	}
	else self.weapon = self.ad_enemydist = 0;

	// The damage value is different depending on projectile type
	if (ad_inflictor.ad_classgroup == ad_CG_PROJSHELLS) self.dmg = ad_damage;
	else self.dmg = self.dmg + ad_damage;
	// reset timer for accumulating damage over time
	self.ad_attack_finished = time + 0.5;
	
	// Spawn a marker to show impact location
	// Will remove self after certain amount of time
	ad_newmis = spawn();
	ad_newmis.ad_classtype = ad_CT_DEVMARKER;
	ad_newmis.movetype = ad_MOVETYPE_NONE;
	ad_newmis.solid = ad_SOLID_NOT;
	setmodel(ad_newmis, ad_MODEL_IMPACT);
	// Randomize between 8 yellow skins
	ad_newmis.skin = rint(random()*7);
	// Take projectile impact location
	setorigin(ad_newmis, ad_inflictor.origin);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_newmis.think = ad_SUB_Remove;
	ad_newmis.nextthink = time + self.wait;
};

//----------------------------------------------------------------------
void() ad_misc_targetdummy =
{
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	if (self.spawnflags & ad_MISC_TARGKNIGHT) {
		self.mdl = "progs/mon_knight.mdl";
		self.ad_headmdl = "progs/targd_short.mdl";
		self.ad_pain_sound = "knight/khurt.wav";
		self.t_width = ad_FALSE;
		self.ad_bboxtype = ad_BBOX_SHORT;
		self.pos1 = '0 9 0';	// stand1-9
	}
	else if (self.spawnflags & ad_MISC_TARGWIZARD) {
		self.mdl = "progs/mon_wizard.mdl";
		self.ad_headmdl = "progs/targd_tall.mdl";
		self.ad_pain_sound = "wizard/wpain.wav";
		self.t_width = ad_FALSE;
		self.ad_bboxtype = ad_BBOX_TALL;
		self.pos1 = '0 8 0';	// hover1-8
	}
	else if (self.spawnflags & ad_MISC_TARGOGRE) {
		self.mdl = "progs/ogre.mdl";
		self.ad_headmdl = "progs/targd_wide.mdl";
		self.ad_pain_sound = "ogre/ogpain1.wav";
		self.t_width = ad_TRUE;
		self.ad_bboxtype = ad_BBOX_WIDE;
		self.pos1 = '0 9 0';	// stand1-9
	}
	else if (self.spawnflags & ad_MISC_TARGHELLKNIGHT) {
		self.mdl = "progs/mon_hknight.mdl";
		self.ad_headmdl = "progs/targd_tall.mdl";
		self.ad_pain_sound = "hknight/pain1.wav";
		self.t_width = ad_FALSE;
		self.ad_bboxtype = ad_BBOX_TALL;
		self.pos1 = '0 9 0';	// stand1-9
	}
	else if (self.spawnflags & ad_MISC_TARGZOMBIE) {
		self.mdl = "progs/mon_zombie.mdl";
		self.ad_headmdl = "progs/targd_short.mdl";
		self.ad_pain_sound = "zombie/z_pain.wav";
		self.t_width = ad_FALSE;
		self.ad_bboxtype = ad_BBOX_SHORT;
		self.pos1 = '0 15 0';	// stand 1-15
	}
	else if (self.spawnflags & ad_MISC_TARGDEMON) {
		self.mdl = "progs/demon.mdl";
		self.ad_headmdl = "progs/targd_wide.mdl";
		self.ad_pain_sound = "demon/dpain1.wav";
		self.t_width = ad_TRUE;
		self.ad_bboxtype = ad_BBOX_WIDE;
		self.pos1 = '0 13 0';	// stand 1-13
	}
	else if (self.spawnflags & ad_MISC_TARGSHALRATH) {
		self.mdl = "progs/mon_shalrath.mdl";
		self.ad_headmdl = "progs/targd_wide.mdl";
		self.ad_pain_sound = "shalrath/pain.wav";
		self.t_width = ad_TRUE;
		self.ad_bboxtype = ad_BBOX_WIDE;
		self.pos1 = '0 1 0';	// stand 1
	}
	else if (self.spawnflags & ad_MISC_TARGSHAMBLER) {
		self.mdl = "progs/shambler.mdl";
		self.ad_headmdl = "progs/targd_massive.mdl";
		self.ad_pain_sound = "shambler/shurt2.wav";
		self.t_width = ad_FALSE;
		self.ad_bboxtype = ad_BBOX_MASSIVE;
		self.pos1 = '0 17 0';	// stand1-17
		self.ad_resist_rockets = 0.5;
	}
	else { remove(self); return; }
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_sound (self.ad_pain_sound);
	precache_model (ad_MODEL_IMPACT);			// Impact model marker

	self.ad_classtype = ad_CT_TARGETDUMMY;
	self.ad_classgroup = ad_CG_MONSTERS;
	self.health = self.max_health = 100000;
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_NONE;
	self.ad_movespeed = 0;					// Never move monster
	if (self.wait < 1) self.wait = 2;	// impact marker removal time
	self.ad_pain_finished = 0;				// Always reset this
	self.ad_pain_flinch = 1;				// Always pass flinch test
	self.dmg = 0;						// Accumulated damage per frame
	self.ad_attack_finished = ad_LARGE_TIMER;	// Reset timer for checks
	self.view_ofs = '0 0 24';			// Default monster offset
	self.takedamage = ad_DAMAGE_AIM;		// Always take damage
	
	ad_monster_bbox();						// Setup bounding box
	setmodel(self, self.mdl);			// Display model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Update bbox
	
	// Spawn projectile bounding box visual marker
	self.ad_attachment = spawn();
	self.ad_attachment.solid = ad_SOLID_NOT;
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	setmodel(self.ad_attachment, self.ad_headmdl);
	setorigin(self.ad_attachment, self.origin-self.view_ofs);
	self.ad_attachment.alpha = 0.3;

	// Spawn Hull2 bounding box visual marker
	if (self.t_width) {
		self.noise = "progs/targd_hull2.mdl";
		precache_model(self.noise);
		self.ad_attachment2 = spawn();
		self.ad_attachment2.solid = ad_SOLID_NOT;
		self.ad_attachment2.movetype = ad_MOVETYPE_NONE;
		setmodel(self.ad_attachment2, self.noise);
		setorigin(self.ad_attachment2, self.origin-self.view_ofs);
		self.ad_attachment2.alpha = 0.15;
	}
	
	// Intercept all AI states
	self.ad_th_pain = ad_misc_targetdummy_pain;
	self.ad_th_stand = ad_misc_targetdummy_stand;
	self.ad_th_walk = ad_misc_targetdummy_stand;
	self.ad_th_run = ad_misc_targetdummy_stand;
	self.ad_th_melee = ad_misc_targetdummy_stand;

	// Stand around and wait for the pain!
	self.think = self.ad_th_stand;
	self.nextthink = time + 0.5 + random();
};

//======================================================================
/*ad:QUAKED misc_targetnumber (.5 .5 0) (-4 -4 -8) (4 4 8) x
target number to display ingame
------- KEYS --------
targetname : required for numbers to updated
mdl        : Numbers 0-9,dot,blank (def=progs/misc_digit.mdl)
waitmin    : Spacing of the model numbers (def=8)
cnt        : Initial display value on spawn (must be >0)
pos1       : X= top digit quantity, Y=Lower digit quantity
-------- SPAWNFLAGS --------
------- NOTES --------
target number to display ingame

======================================================================*/
void() ad_misc_targetnumber_dispno =
{
	local float ad_str_counter, ad_str_pow, ad_str_result, ad_str_low;
	
	ad_str_counter = self.pos1_x;		// Upper number length
	ad_str_pow = ad_mathlib_powbit(self.pos1_x,10);// Setup initial base 10 power for checking

	// Get rid of negative state
	self.count = fabs(self.count);

	// If number larger than fixed length? - truncate number
	if (self.count > ad_str_pow)
		self.count = ad_mathlib_truncate(self.count, self.pos1_x, self.pos1_y);
	
	// Loop through lower part of number
	while(ad_str_counter > 0) {
		// Move down one pow digit
		ad_str_pow = ad_str_pow / 10;

		// Divide number by pow to get divider
		ad_str_result = ad_mathlib_divisible(self.count, ad_str_pow);
		
		// Result must be 0-9 digits
		if (ad_str_result > 9) ad_str_result = 9;
		if (ad_str_result < 1) ad_str_result = 0;
		
		if (ad_str_counter == 4) self.ad_tno8.skin = ad_str_result;
		else if (ad_str_counter == 3) self.ad_tno7.skin = ad_str_result;
		else if (ad_str_counter == 2) self.ad_tno6.skin = ad_str_result;
		else if (ad_str_counter == 1) self.ad_tno5.skin = ad_str_result;
		
		// remove top part of number, decrease str length counter
		self.count = self.count - (ad_str_result * ad_str_pow);
		ad_str_counter = ad_str_counter - 1;
	}
	
	// Shift the lower part of the number upwards
	ad_str_low = ad_str_counter = self.pos1_y;
	ad_str_pow = ad_mathlib_powbit(self.pos1_y,10);
	while (ad_str_low > 0) {
		self.count = self.count * 10;
		ad_str_low = ad_str_low - 1;
	}
	
	// Loop through lower part of number
	while(ad_str_counter > 0) {
		// Move down one pow digit
		ad_str_pow = ad_str_pow / 10;

		// Divide number by pow to get divider
		ad_str_result = ad_mathlib_divisible(self.count, ad_str_pow);

		// Result must be 0-9 digits
		if (ad_str_result > 9) ad_str_result = 9;
		if (ad_str_result < 1) ad_str_result = 0;
		
		if (ad_str_counter == 3) self.ad_tno3.skin = ad_str_result;
		else if (ad_str_counter == 2) self.ad_tno2.skin = ad_str_result;
		else if (ad_str_counter == 1) self.ad_tno1.skin = ad_str_result;
		
		// remove top part of number, decrease str length counter
		self.count = self.count - (ad_str_result * ad_str_pow);
		ad_str_counter = ad_str_counter - 1;
	}
};

//----------------------------------------------------------------------
void() ad_misc_targetnumber_use =
{
	// No negative numbers
	self.count = fabs(other.ad_targetnumber);
	ad_misc_targetnumber_dispno();
};

//----------------------------------------------------------------------
entity(float ad_offset, float ad_startno) ad_misc_targetnumber_spawn =
{
	local entity ad_tnoent;
	ad_tnoent = spawn();
	ad_tnoent.ad_classtype = ad_CT_TARGETNUMBER;
	ad_tnoent.solid = ad_SOLID_NOT;
	ad_tnoent.movetype = ad_MOVETYPE_NONE;
	makevectors(self.angles);
	setmodel(ad_tnoent, self.mdl);
	setorigin(ad_tnoent, self.origin + (v_right * (self.waitmin * ad_offset)) );
	setsize(ad_tnoent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_tnoent.skin = ad_startno;
	ad_tnoent.angles = self.angles;
	return ad_tnoent;
};

//----------------------------------------------------------------------
void() ad_misc_targetnumber =
{
	if (self.mdl == "") self.mdl = "progs/misc_digit.mdl";
	precache_model (self.mdl);
	
	self.ad_classtype = ad_CT_TARGETNUMBER;
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	
	if (self.waitmin <= 0) self.waitmin = 8;
	if (self.cnt > 0) self.count = self.cnt;
	
	// Double check digit quantities are within range
	if (self.pos1_x > 4 || self.pos1_y > 3) {
		dprint("\b[MISCNUM]\b pos1 limited to '4 3 0'\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
	}
	
	// Setup lower part of number (1-3 decimal places, 4=dot always)
	if (self.pos1_y > 0) {
		if (self.pos1_y == 1) 
			self.ad_tno1 = ad_misc_targetnumber_spawn(0, 0);
		else if (self.pos1_y == 2) {
			self.ad_tno1 = ad_misc_targetnumber_spawn(0, 0);
			self.ad_tno2 = ad_misc_targetnumber_spawn(1, 0);
		}
		else {
			self.pos1_y = 3;
			self.ad_tno1 = ad_misc_targetnumber_spawn(0, 0);
			self.ad_tno2 = ad_misc_targetnumber_spawn(1, 0);
			self.ad_tno3 = ad_misc_targetnumber_spawn(2, 0);
		}
		// Decimal place is always tno4
		self.ad_tno4 = ad_misc_targetnumber_spawn(self.pos1_y, 10);
		self.pos1_z = self.pos1_y +1;
	}
	else self.pos1_z = 0;
	
	// Setup upper part of number (1-4 digits only, min 1 digit)
	if (self.pos1_x < 1) self.pos1_x = 1;
	if (self.pos1_x == 1) 
		self.ad_tno5 = ad_misc_targetnumber_spawn(self.pos1_z, 0);
	else if (self.pos1_x == 2) {
		self.ad_tno5 = ad_misc_targetnumber_spawn(self.pos1_z, 0);
		self.ad_tno6 = ad_misc_targetnumber_spawn(self.pos1_z+1, 0);
	}
	else if (self.pos1_x == 3) {
		self.ad_tno5 = ad_misc_targetnumber_spawn(self.pos1_z, 0);
		self.ad_tno6 = ad_misc_targetnumber_spawn(self.pos1_z+1, 0);
		self.ad_tno7 = ad_misc_targetnumber_spawn(self.pos1_z+2, 0);
	}
	else {
		self.pos1_x = 4;
		self.ad_tno5 = ad_misc_targetnumber_spawn(self.pos1_z, 0);
		self.ad_tno6 = ad_misc_targetnumber_spawn(self.pos1_z+1, 0);
		self.ad_tno7 = ad_misc_targetnumber_spawn(self.pos1_z+2, 0);
		self.ad_tno8 = ad_misc_targetnumber_spawn(self.pos1_z+3, 0);
	}

	// Setup trigger function for number update
	if (self.targetname != "") self.use = ad_misc_targetnumber_use;
	// Update initial value (no external source)
	if (self.cnt > 0) ad_misc_targetnumber_dispno();
};