//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_floyd_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);

		// Rolling around on floor?
		if (self.spawnflags & ad_MON_FLOYDROLL) return;
		
		// No pain animation for first hit
		if (self.ad_meleeattack) { 
			self.ad_meleeattack = ad_FALSE;
			self.ad_pain_finished = time + 1;
		}
		else {
			// Only do pain animation if required
			if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
				// Find out facing direction
				self.lip = ad_anglemod(self.angles_y - self.ideal_yaw);
				//lurch forward if hit in the back
				if (self.lip > 90 && self.lip < 270) {
					ad_floyd_painc1 ();
					self.ad_pain_finished = time + 2;
				}
				else if (random() < 0.4) {
					ad_floyd_paina1 ();
					self.ad_pain_finished = time + 1;
				}
				else {
					ad_floyd_painb1 ();
					self.ad_pain_finished = time + 2;
				}
			}
		}
	}
};

//======================================================================
void() ad_floyd_explode =
{
	// no more FLOYD!
	ad_entity_hide (self);
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// ID style explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	
	// Sprite + Dust
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound2);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);

	// Only throw head if a quick gib death
	if (self.ad_gibbed) ad_ThrowGib(25, 1);
	
	// Metal and custom body parts
	self.ad_gibtype = ad_GIBTYPE_METAL;
	ad_ThrowGib(11, 2 + rint(random()*2));
	ad_ThrowGib(12, 4 + rint(random()*2));
	ad_ThrowGib(13, 4 + rint(random()*2));
};

