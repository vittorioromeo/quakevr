// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_floyd.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
FLOYD (from Rubicon 2 MOD - john fitzgibbons)
==============================================================================*/

// (000-000) Used to create skin
$frame base1

// (001-001) Idle : Single frame
$frame idle1

// (002-017) Walk : Slow plond
$frame walk1 walk2 walk3 walk4 walk5 walk6 walk7 walk8
$frame walk9 walk10 walk11 walk12 walk13 walk14 walk15 walk16

// (018-025) Run : Faster
$frame run1 run2 run3 run4 run5 run6 run7 run8

// (026-034) Attack : 3 fast lazers
$frame attack1 attack2 attack3 attack4 attack5 attack6 attack7 attack8
$frame attack9

// (035-040) Pain : Short reflex
$frame paina1 paina2 paina3 paina4 paina5 paina6
// (041-050) Pain : Long reflex
$frame painb1 painb2 painb3 painb4 painb5 painb6 painb7 painb8
$frame painb9 painb10
// (051-064) Pain : Backward Stumble
$frame painc1 painc2 painc3 painc4 painc5 painc6 painc7 painc8
$frame painc9 painc10 painc11 painc12 painc13 painc14

// (065-080) Death : Fall on floor
$frame death1 death2 death3 death4 death5 death6 death7 death8
$frame death9 death10 death11 death12 death13 death14 death15 death16

//======================================================================
void () ad_floyd_sleep = [$idle1, ad_floyd_sleep] {};

//======================================================================
void() ad_floyd_standframe =
{
	// Make sure alive
	if (self.health < 0) return;
	
	// Single IDLE frame unfortunately
	self.frame = $idle1;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 9) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_floyd_standframe;

	ad_ai_stand();
};

//----------------------------------------------------------------------
void()	ad_floyd_stand1 =[ $idle1, ad_floyd_stand1 ] {
	self.ad_walkframe = 0; ad_floyd_standframe();
};

//======================================================================
void() ad_floyd_walkframe =
{
	// Make sure alive
	if (self.health < 0) return;
	
	// Move animation forward
	self.frame = $walk1 + self.ad_walkframe;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	else if (self.ad_walkframe == 3) ad_monster_footstep(ad_FALSE);
	else if (self.ad_walkframe == 11) ad_monster_footstep(ad_FALSE);

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 15) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_floyd_walkframe;

	ad_ai_walk(1.875);
};

//----------------------------------------------------------------------
void()	ad_floyd_walk1 =[ $walk1, ad_floyd_walk1 ] {
	self.ad_walkframe = 0; ad_floyd_walkframe();
};

//======================================================================
void() ad_floyd_runframe =
{
	// Make sure alive
	if (self.health < 0) return;
	
	// Move animation forward
	self.frame = $run1 + self.ad_walkframe;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	else if (self.ad_walkframe == 1) ad_monster_footstep(ad_FALSE);
	else if (self.ad_walkframe == 5) ad_monster_footstep(ad_FALSE);

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 7) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_floyd_runframe;

	ad_ai_run(3.75);
};

//----------------------------------------------------------------------
void()	ad_floyd_run1 =[ $run1, ad_floyd_run1 ] {
	self.ad_walkframe = 0; ad_floyd_runframe();
};
void()	ad_floyd_run5 =[ $run5, ad_floyd_run5 ] {
	self.ad_walkframe = 4; ad_floyd_runframe();
};

//======================================================================
void(float ad_muzzle) ad_floyd_fire =
{
	local vector ad_org, ad_targ_org, ad_dir, ad_muzoff;

	if (!self.enemy) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_FLOYDBOLT + (ad_skill * ad_SPEED_FLOYDSKILL);
	sound (self, ad_CHAN_WEAPON, "floyd/fire.wav", 1, ad_ATTN_NORM);

	// Create left/right laser vector
	ad_muzoff = '0 0 0'; ad_muzoff_y = ad_muzzle;

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset + ad_muzoff);
	
	// Aim plasma bolt towards the enemy feet (using view_ofs)
	if (self.enemy.flags & ad_FL_CLIENT) ad_targ_org = self.enemy.origin - '0 0 20';
	else ad_targ_org = self.enemy.origin - self.enemy.view_ofs;
	ad_dir = normalize(ad_targ_org - self.origin);

	ad_launch_plasma(ad_org, ad_dir, ad_CT_MONFLOYD, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void()	ad_floyd_ready1 =[$run1, ad_floyd_ready2] {ad_ai_face();};
void()	ad_floyd_ready2 =[$run2, ad_floyd_ready3] {ad_ai_face();};
void()	ad_floyd_ready3 =[$run3, ad_floyd_ready4] {ad_ai_face();};
void()	ad_floyd_ready4 =[$run4, ad_floyd_attack1] {
	ad_ai_face();
	// Check if sightline is broken by monster/world
	if (ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0'))
		self.think = ad_floyd_run5;
};
void()	ad_floyd_attack1 =[$attack1, ad_floyd_attack2] {ad_floyd_fire(6);};
void()	ad_floyd_attack2 =[$attack2, ad_floyd_attack3] {ad_ai_face();};
void()	ad_floyd_attack3 =[$attack3, ad_floyd_attack4] {ad_ai_face();};
void()	ad_floyd_attack4 =[$attack4, ad_floyd_attack5] {ad_floyd_fire(0);};
void()	ad_floyd_attack5 =[$attack5, ad_floyd_attack6] {ad_ai_face();};
void()	ad_floyd_attack6 =[$attack6, ad_floyd_attack7] {ad_ai_face();};
void()	ad_floyd_attack7 =[$attack7, ad_floyd_attack8] {ad_floyd_fire(-6);};
void()	ad_floyd_attack8 =[$attack8, ad_floyd_attack9] {ad_ai_face();};
void()	ad_floyd_attack9 =[$attack9, ad_floyd_run1] {ad_ai_face();
	// Special double fire mode (used by soliders/enforcers)
	ad_SUB_CheckRefire (ad_floyd_attack1);
};

