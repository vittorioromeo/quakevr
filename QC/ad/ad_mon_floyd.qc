//----------------------------------------------------------------------
void() ad_floyd_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Check for rolling on floor first
	if (self.spawnflags & ad_MON_FLOYDROLL) ad_floyd_explode();
	else {
		// Check for a quick gib death
		if ( self.health < -35 || self.ad_gibondeath) self.ad_gibbed = ad_TRUE;
		
		// regular death (no head model)
		if (!self.ad_gibbed) {
			sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
			ad_floyd_death2 ();
		}
		// Quick explosion with head model
		else ad_floyd_explode();
	}
};

//======================================================================
// Floyd ASLEEP functions
//======================================================================
void() ad_floyd_default_state =
{
	// Setup default pain parameters
	self.ad_pain_timeout = 1.5;
	self.ad_pain_flinch = 150;

	// Default AI function/states
	self.ad_th_stand = ad_floyd_stand1;
	self.ad_th_walk = ad_floyd_walk1;
	self.ad_th_run = ad_floyd_run1;
	self.ad_th_missile = ad_floyd_ready1;
	self.ad_th_pain = ad_floyd_pain;
};

//----------------------------------------------------------------------
void() ad_floyd_awake =
{
	// Cannot be woken up if dead
	if (self.health < 1) return;
	
	ad_floyd_default_state();	// Restore default monster states
	self.skin = 0;			// Default (light on) skin
	self.think = self.ad_th_stand;		// Default is idle/stand
	self.nextthink = time + 0.1;	// Next frame
	ad_monster_targets();		// Find target (angry/path_corner)
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_floyd_painawake =
{
	// Cannot be attacked by other robots or woken up if dead
	if (ad_attacker.ad_classgroup == ad_CG_ROBOT) return;
	if (self.health < 1) return;
	
	ad_floyd_default_state();	// Restore default monster states
	self.skin = 0;			// Default (light on) skin
	self.enemy = ad_attacker;	// Attack the inflictor of pain
	self.think = ad_FoundTarget;		// Find the pain attacker
	self.nextthink = time + 0.1;	// Next frame
	self.ad_pain_finished = time + 2;	// no more pain for a while
};

//======================================================================
// Floyd ROLLING functions
//======================================================================
void () ad_floyd_roll = {
	self.frame = self.frame + 1;
	
	if (self.frame > $death15 || self.frame < $death10) {
		self.frame = $death10;
		ad_monster_idle_sound();
	}
	
	self.think = ad_floyd_roll;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// This chunk of code is straight from rubicon2 MOD (unchanged)
// Personally I would have created a maximum bbox radius of the floyd model
// but this system is much better and unfortunately more complex (maths)
//----------------------------------------------------------------------
vector (vector ad_testmoos, float ad_testang, float ad_testradius, float ad_minmax) ad_test_moos_angle =
{
	local vector ad_testangs, ad_floyd_moos;
	ad_floyd_moos = ad_testmoos;
	ad_testangs = '0 0 0';
	ad_testangs_y = ad_testang;
	makevectors(ad_testangs); 
	v_forward_y = v_forward_y * ad_testradius;
	v_forward_x = v_forward_x * ad_testradius;
	if (ad_minmax == 1) //1 for maxes, 0 for mins
	{
		if (v_forward_y > ad_floyd_moos_y) ad_floyd_moos_y = v_forward_y;
		if (v_forward_x > ad_floyd_moos_x) ad_floyd_moos_x = v_forward_x;
	} else {
		if (v_forward_y < ad_floyd_moos_y) ad_floyd_moos_y = v_forward_y;
		if (v_forward_x < ad_floyd_moos_x) ad_floyd_moos_x = v_forward_x;
	}
	return ad_floyd_moos;
};

//----------------------------------------------------------------------
vector (entity ad_floyd) ad_get_floyd_mins =
{
	local float ad_feetyaw;
	local vector ad_floyd_mins;
	
	ad_floyd_mins = '0 0 -24';
	ad_feetyaw = ad_anglemod(ad_floyd.angles_y);

	// Foot / Shoulder / Head / Shoulder / Foot
	ad_floyd_mins = ad_test_moos_angle(ad_floyd_mins, ad_feetyaw + 17.4, 38, 0);		//foot
	ad_floyd_mins = ad_test_moos_angle(ad_floyd_mins, ad_feetyaw + 180 - 17.4, 38, 0);	//shoulder
	ad_floyd_mins = ad_test_moos_angle(ad_floyd_mins, ad_feetyaw + 180, 40, 0);			//head
	ad_floyd_mins = ad_test_moos_angle(ad_floyd_mins, ad_feetyaw + 180 + 17.4, 38, 0);	//shoulder
	ad_floyd_mins = ad_test_moos_angle(ad_floyd_mins, ad_feetyaw + 360 - 17.4, 38, 0);	//foot

	return ad_floyd_mins;
};

//----------------------------------------------------------------------
vector (entity ad_floyd) ad_get_floyd_maxs =
{
	local float ad_feetyaw;
	local vector ad_floyd_maxs;
	
	ad_floyd_maxs = '0 0 12';
	ad_feetyaw = ad_anglemod(ad_floyd.angles_y);

	// Foot / Shoulder / Head / Shoulder / Foot
	ad_floyd_maxs = ad_test_moos_angle(ad_floyd_maxs, ad_feetyaw + 17.4, 38, 1); 		//foot
	ad_floyd_maxs = ad_test_moos_angle(ad_floyd_maxs, ad_feetyaw + 180 - 17.4, 38, 1);	//shoulder
	ad_floyd_maxs = ad_test_moos_angle(ad_floyd_maxs, ad_feetyaw + 180, 40, 1); 		//head
	ad_floyd_maxs = ad_test_moos_angle(ad_floyd_maxs, ad_feetyaw + 180 + 17.4, 38, 1);	//shoulder
	ad_floyd_maxs = ad_test_moos_angle(ad_floyd_maxs, ad_feetyaw + 360 - 17.4, 38, 1);	//foot
	
	return ad_floyd_maxs;
};

/*======================================================================
QUAKED monster_floyd (1 0 0) (-24 -24 -24) (24 24 64) Ambush
======================================================================*/
void() ad_monster_floyd =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	// Let the mapper override the mdl keys so that they can
	// create different skin versions, a rusty floyd anyone?
	if (self.mdl == "") self.mdl = "progs/mon_floyd.mdl";			// Dusty the bin
	if (self.ad_headmdl == "") self.ad_headmdl = "progs/h_floyd.mdl";		// Top part
	if (self.ad_gib1mdl == "") self.ad_gib1mdl = "progs/gib_floyd1.mdl";	// wreckage.mdl
	if (self.ad_gib2mdl == "") self.ad_gib2mdl = "progs/gib_metal1.mdl";	// Breakable metal
	if (self.ad_gib3mdl == "") self.ad_gib3mdl = "progs/gib_metal3.mdl";	// Breakable metal

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);		// Large chunk of floyd metal
	precache_model (self.ad_gib2mdl);		// Generic metal1_2
	precache_model (self.ad_gib3mdl);		// Generic metal1_2
	
	self.ad_idle_sound = "floyd/idle.wav";
	precache_sound (self.ad_idle_sound);

	// Extra load/fire sounds
	precache_model (ad_MODEL_PROJ_LASERBLUE);
	precache_sound("floyd/fire.wav");
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);

	self.ad_death_sound = "floyd/death.wav";
	self.ad_death_sound2 = "seeker/explode_major.wav";
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);
	self.ad_pain_sound = "floyd/pain.wav";
	precache_sound (self.ad_pain_sound);
	
	self.ad_sight_sound = "floyd/sight.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_XTALL;
	// Half health for rolling floyd
	if (self.health < 1) {
		if (self.spawnflags & ad_MON_FLOYDROLL) self.health = 75;
		else self.health = 175;
	}
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Special explosion death
	self.ad_gibbed = ad_FALSE;
	self.ad_steptype = ad_FS_TYPELARGE;		// Heavy robot feet
	self.ad_pain_longanim = ad_FALSE;			// cannot be chopped with shadow axe
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_FLOYD;
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous
	self.ad_deathstring = " was made obsolete by an Automaton\n";
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	self.ad_meleeattack = ad_TRUE;			// Always short pain first
	self.ad_attack_offset = '24 0 30';		// Laser offset
	self.frame = 1;						// Frame 0 is special skin version

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_FloydCheckAttack;
	self.ad_th_die = ad_floyd_die;

	self.ad_classtype = ad_CT_MONFLOYD;
	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	// Rolling mode (lower HP) waiting for pain/death
	if (self.spawnflags & ad_MON_FLOYDROLL) {
		// Setting the angle key in the editor to UP/DOWN = random rotation	
		if (self.angles_y < 0) self.angles_y = rint(random()*359);
		// Work out bounding box based on rotation angle
		setsize(self, ad_get_floyd_mins(self), ad_get_floyd_maxs(self));
		// Save bounding box for later
		self.ad_bbmins = self.mins; self.ad_bbmaxs = self.maxs;
		self.ad_bboxtype = ad_BBOX_CUSTOM;	// bbox override
		self.ad_classmove = ad_MON_MOVEFLY;	// No drop to floor
		// Setup AI state functions (rolling)
		self.ad_th_stand = ad_floyd_roll;
		self.ad_th_walk = ad_floyd_roll;
		self.ad_th_run = ad_floyd_roll;
		self.ad_th_pain = ad_floyd_pain;
		self.ad_think1 = ad_floyd_roll;
	}
	// Standby/Sleep mode (light off) waiting for trigger/pain
	else if (self.spawnflags & ad_MON_FLOYDASLEEP) {
		self.ad_th_stand = ad_floyd_sleep;
		self.ad_th_walk = ad_floyd_sleep;
		self.ad_th_run = ad_floyd_sleep;
		self.ad_th_missile = ad_floyd_sleep;
		self.ad_th_pain = ad_floyd_painawake;
		self.ad_think1 = ad_floyd_awake;
		self.ad_pain_finished = 0;		// Always wakeup on any pain
		self.ad_pain_timeout = -1;		// Pain finished is never set
		self.ad_pain_flinch = -100;	// Projectile shotguns are tricky
		self.ad_exactskin = 1;			// Lights off Skin
	}
	else ad_floyd_default_state();
	
	ad_monster_start();
};
