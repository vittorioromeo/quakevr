// Standing upright to attention (special pose)
void()	ad_knight_attn1	=[	$attn1,		ad_knight_attn2	] {
	self.ad_startingpose = ad_KNIGHT_STANDING;
	self.ad_idlebusy = ad_KNIGHT_ATTENTION; ad_ai_stand(); ad_monster_idle_sound();};
void()	ad_knight_attn2	=[	$attn2,		ad_knight_attn3	] {ad_ai_stand();};
void()	ad_knight_attn3	=[	$attn3,		ad_knight_attn4	] {ad_ai_stand();};
void()	ad_knight_attn4	=[	$attn4,		ad_knight_attn1	] {ad_ai_stand();};

//----------------------------------------------------------------------
void()	ad_knight_stand1	=[	$stand1,	ad_knight_stand2	] {
	// Check for custom onspawn poses
	if (self.ad_startingpose == ad_KNIGHT_KNEELING) ad_knight_kneel1();
	else if (self.ad_startingpose == ad_KNIGHT_ATTENTION) ad_knight_attn1();
	else if (self.ad_startingpose == ad_KNIGHT_LOOKLEFT) ad_knight_idlea1();
	else if (self.ad_startingpose == ad_KNIGHT_LOOKRIGHT) ad_knight_idleb1();
	else {
		self.ad_startingpose = self.ad_idlebusy = ad_KNIGHT_STANDING; 
		ad_ai_stand(); ad_monster_idle_sound();
	}
};
void()	ad_knight_stand2	=[	$stand2,	ad_knight_stand3	] {ad_ai_stand();};
void()	ad_knight_stand3	=[	$stand3,	ad_knight_stand4	] {ad_ai_stand();};
void()	ad_knight_stand4	=[	$stand4,	ad_knight_stand5	] {ad_ai_stand();};
void()	ad_knight_stand5	=[	$stand5,	ad_knight_stand6	] {ad_ai_stand();};
void()	ad_knight_stand6	=[	$stand6,	ad_knight_stand7	] {ad_ai_stand();};
void()	ad_knight_stand7	=[	$stand7,	ad_knight_stand8	] {ad_ai_stand();};
void()	ad_knight_stand8	=[	$stand8,	ad_knight_stand9	] {ad_ai_stand();};
void()	ad_knight_stand9	=[	$stand9,	ad_knight_stand1	] {
	self.ad_idlebusy = ad_KNIGHT_STANDING; 
	if (random() < ad_MON_IDLE_ANIMATION && self.ad_weaponswitch < time) {
		// Slow down the repeating of idle animations
		self.ad_weaponswitch = time + 1 + random()*3;
		// Will be set properly once in idle
		self.ad_idlebusy = ad_TRUE;

		self.lefty = 1 - self.lefty;
		if (self.lefty == 1) self.think = ad_knight_idlea1;	// Look left
		else self.think = ad_knight_idleb1;					// Look right
	}
};

