//=============================================================================
void() ad_knight_melee =
{
	if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) ad_knight_atk1 ();
	else ad_knight_runatk1 ();
};

//===========================================================================
void()	ad_knight_pain1	=[	$pain1,		ad_knight_pain2	] {};
void()	ad_knight_pain2	=[	$pain2,		ad_knight_pain3	] {};
void()	ad_knight_pain3	=[	$pain3,		ad_knight_run1	] {};

void()	ad_knight_painb1	=[	$painb1,	ad_knight_painb2	] {ad_ai_painforward(0);};
void()	ad_knight_painb2	=[	$painb2,	ad_knight_painb3	] {ad_ai_painforward(3);};
void()	ad_knight_painb3	=[	$painb3,	ad_knight_painb4	] {};
