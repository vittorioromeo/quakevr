void()	ad_knight_painb7	=[	$painb7,	ad_knight_painb8	] {ad_ai_painforward(2);};
void()	ad_knight_painb8	=[	$painb8,	ad_knight_painb9	] {ad_ai_painforward(5);ad_monster_footstep(ad_FALSE);};
void()	ad_knight_painb9	=[	$painb9,	ad_knight_painb10	] {ad_ai_painforward(5);};
void()	ad_knight_painb10	=[	$painb10,	ad_knight_painb11	] {ad_ai_painforward(0);};
void()	ad_knight_painb11	=[	$painb11,	ad_knight_run1	] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_knight_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			if (random() < 0.85) ad_knight_pain1 ();	// classic, body recoil
			else {
				self.ad_pain_finished = time + 2;		// long animation
				ad_knight_painb1 ();					// Cool stumble, hand over mouth
			}
		}
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_axhitme = 0;
			self.ad_pain_finished = time + 1.1;
			ad_knight_painb1 ();
		}
	}
};

//============================================================================
void() ad_knight_die1 =[ $death1, ad_knight_die2] {};
void() ad_knight_die2 =[ $death2, ad_knight_die3] {ad_monster_check_gib();};
void() ad_knight_die3 =[ $death3, ad_knight_die4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_knight_die4 =[ $death4, ad_knight_die5] {};
void() ad_knight_die5 =[ $death5, ad_knight_die6] {};
void() ad_knight_die6 =[ $death6, ad_knight_die7] {};
void() ad_knight_die7 =[ $death7, ad_knight_die8] {};
void() ad_knight_die8 =[ $death8, ad_knight_die9] {};
void() ad_knight_die9 =[ $death9, ad_knight_die10] {ad_monster_death_postcheck();};
void() ad_knight_die10 =[ $death10, ad_knight_die10] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_knight_dieb1 =[ $deathb1, ad_knight_dieb2] {};
void() ad_knight_dieb2 =[ $deathb2, ad_knight_dieb3] {ad_monster_check_gib();};
void() ad_knight_dieb3 =[ $deathb3, ad_knight_dieb4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_knight_dieb4 =[ $deathb4, ad_knight_dieb5] {};
void() ad_knight_dieb5 =[ $deathb5, ad_knight_dieb6] {};
void() ad_knight_dieb6 =[ $deathb6, ad_knight_dieb7] {};
void() ad_knight_dieb7 =[ $deathb7, ad_knight_dieb8] {};
void() ad_knight_dieb8 =[ $deathb8, ad_knight_dieb9] {};
void() ad_knight_dieb9 =[ $deathb9, ad_knight_dieb10] {};
void() ad_knight_dieb10 =[ $deathb10, ad_knight_dieb11] {ad_monster_death_postcheck();};
void() ad_knight_dieb11 =[ $deathb11, ad_knight_dieb11] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_knight_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_knight_die1 ();		// Forward
		else ad_knight_dieb1 ();					// Backward
	}
};

//============================================================================
void() ad_knight_sword_sound =
{
	if (random() > 0.5) sound (self, ad_CHAN_WEAPON, "knight/sword2.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "knight/sword1.wav", 1, ad_ATTN_NORM);
};

//============================================================================
void() ad_knight_aistates =
{
	self.ad_th_stand = ad_knight_stand1;		// Idling on feet
	self.ad_th_walk = ad_knight_walk1;		// Walking
	self.ad_th_run = ad_knight_run1;			// Running
	self.ad_th_melee = ad_knight_melee;		// Sword attack
	self.ad_th_pain = ad_knight_pain;			// Stumble and pain
	self.ad_th_die = ad_knight_die;			// Face meets floor
};

//----------------------------------------------------------------------
void() ad_knight_wakeup =
{
	// Check for sudden death!
	if (self.health < 0) return;
	
	self.use = ad_SUB_Null;				// no re-trigger
	self.takedamage = ad_DAMAGE_AIM;		// Can receive damage
	self.ad_spawnstatue = ad_FALSE;			// No longer stationary

	ad_knight_aistates();					// Restore AI state functions
	ad_monster_targets();					// Check for targets
};

//----------------------------------------------------------------------
void() ad_knight_statue =
{
	local float ad_targ_angle, ad_new_frame;

	// Check for sudden death!
	if (self.health < 0) return;
	
	if (random() < ad_MON_IDLE_SOUND && self.pos1_z > 1) {
		ad_new_frame = ad_TRUE;
		self.ad_oldenemy = checkclient();
		if (self.ad_oldenemy.flags & ad_FL_CLIENT) {
			ad_targ_angle  = ad_viewangle(self.origin, self.ad_oldenemy.origin, 0, ad_TRUE, self.ad_oldenemy.v_angle_y);
			if (ad_targ_angle < 135 || ad_targ_angle > 225) ad_new_frame = ad_FALSE;
		}
		self.lip = self.pos1_x + rint(random()*self.pos1_z);
		if (ad_new_frame) {
			sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
			self.frame = self.lip;
		}
	}
	
 	self.think = ad_knight_statue;
 	self.nextthink = time + 5 + random()*5;
};

/*======================================================================
 QUAKED monster_knight (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_knight =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_knight.mdl";
	self.ad_headmdl = "progs/h_knight.mdl";		// Large head
	self.ad_gib1mdl = "progs/w_knightsword.mdl";	// Unique sword
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";	// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";	// right foot

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	
	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib2mdl = "";
	if (random() < 0.5) self.ad_gib3mdl = "";

	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_STATUE) {
		self.ad_idle_sound = "statue/idle1.wav";
		self.ad_idle_sound2 = "statue/idle2.wav";
		self.ad_idle_soundcom = "statue/comidle.wav";
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);
		precache_sound (self.ad_idle_soundcom);
		
		self.ad_sight_sound = "statue/sight.wav";
		self.ad_pain_sound = "statue/hurt.wav";
		self.ad_death_sound = "statue/death.wav";
		self.ad_gib1skin = 1;					// Stoney sword		
		ad_precache_stonegibs();				// Cache gib models
		self.ad_gibtype = ad_GIBTYPE_STONE;		// Stoney gibs!
		self.ad_gib2mdl = self.ad_gib3mdl = ad_string_null;
	}
	else {
		self.ad_idle_sound = "knight/idle.wav";
		precache_sound (self.ad_idle_sound);
		
		self.ad_sight_sound = "knight/ksight.wav";
		self.ad_pain_sound = "knight/khurt.wav";
		self.ad_death_sound = "knight/kdeath.wav";
		
		// Check for poisonous entity flag
		if (self.ad_poisonous) {
			ad_precache_poisongibs();			// precache gibs
			self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
			if (!self.ad_exactskin) self.ad_exactskin = 3;	// Swampy skin
		}
	}

	// precache sight, pain and death (changes on type)
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_death_sound);
	
	precache_sound ("knight/sword1.wav");
	precache_sound ("knight/sword2.wav");

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = ad_HP_MONKNIGHT;
	self.ad_gibhealth = -40;				// Not easy to gib
	self.ad_gibbed = ad_FALSE;				// Still in one peice
	self.ad_pain_flinch = 20;				// Light pain threshold
	self.ad_pain_longanim = ad_TRUE;			// Can do long stagger animation
	self.ad_steptype = ad_FS_TYPEMEDIUM;		// Light soldier feet
	self.skin = 0;						// Always reset (use exactskin)
	self.ad_th_die = ad_knight_die;			// Face meets floor
	self.ad_deathstring = " was slashed by a Knight\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	//----------------------------------------------------------------------
	// Detect statues and setup different parameters
	// Tougher skin, less pain, heavy feet etc	
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_STATUE) {
		self.ad_classgroup = ad_CG_STONE;		// Stone hates metal!
		self.ad_poisonous = ad_FALSE;			// Cannot be poisonous and stone!
		self.ad_resist_nails = 0.5;		// Tough skin for nails
		self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
		if (!self.ad_exactskin) self.ad_exactskin = 4;	// Stone skin
		self.ad_pain_flinch = 40;			// Doubled
		self.ad_pain_longanim = ad_FALSE;		// resistant to shadow axe
		self.ad_pain_timeout = 2;			// HK pain threshold
		self.ad_steptype = ad_FS_TYPEHEAVY;	// heavy stone feet!
		self.ad_no_liquiddmg = ad_TRUE;		// Immune to slime/lava
		self.ad_deathstring = " was smashed by a Stone Knight\n";
		
		// Allow knights to start with a stone skin, but not be frozen!
		if (self.spawnflags & ad_MON_NOTFROZEN) {
			self.spawnflags = self.spawnflags - ad_MON_STATUE;
			ad_knight_aistates();			// setup AI state functions
		}
		else {
			self.ad_spawnstatue = ad_TRUE;		// Start as a statue
			self.ad_th_stand = ad_knight_statue;	// Stone idle sound
			self.ad_think1 = ad_knight_wakeup;	// Wakeup function when triggered

			// statues can change position when the player is not looking
			// Specify a start/finish frame using pos1 or use frame
			if (!self.pos1_x) {
				self.pos1_x = $attackb1;	// Default pose (attacking)
				self.pos1_y = $attackb10;
			}
			// A frame has been specified, create a small range from that
			if (self.frame > 0) {
				self.pos1_x = self.pos1_y = self.frame;
			}
			// Work out range, make sure no negative values
			self.pos1_z = fabs(self.pos1_y - self.pos1_x);
			self.frame = self.pos1_x;		// Setup frame / pose		
		}
	}
	else {
		// The new knight model by Lunaran has 4 available skins to
		// choose from. The local option will always override the
		// worldspawn option.
		// Added -1 option which will randomly pick a skin
		if (self.ad_exactskin < 0) self.ad_randomskin = 4;
		if (!self.ad_exactskin && world.ad_knight_defskin > 0)
			self.ad_exactskin = world.ad_knight_defskin;

		self.ad_pain_longanim = ad_TRUE;		// can be chopped with shadow axe
		self.ad_classgroup = ad_CG_KNIGHT;	// Classic tincan!
		ad_knight_aistates();				// setup AI state functions
	}

	self.ad_classtype = ad_CT_MONKNIGHT;
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();	
};
