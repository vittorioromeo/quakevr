void()	ad_knight_idlea1	=[	$idlea1,	ad_knight_idlea2	] {
	self.ad_startingpose = ad_KNIGHT_STANDING;
	self.ad_idlebusy = ad_KNIGHT_LOOKLEFT; ad_ai_stand();};
void()	ad_knight_idlea2	=[	$idlea2,	ad_knight_idlea3	] {ad_ai_stand();};
