//======================================================================
void() ad_army_fire_rocket =
{
	if (VR_AimCone_Wait(ad_army_fire_rocket, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_org, ad_dir;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "soldier/rocket_fire.wav", 1, ad_ATTN_NORM);	

	// Maximum speed, initial speed set in Launch_Missile
	self.ad_attack_speed = ad_SPEED_ARMYROCKPROJ + (ad_skill * ad_SPEED_ARMYROCKPROJSKILL);

	// check for enemy origin (based on sight test)
	// if cannot see enemy fire at last known location
	ad_ai_trackenemy();

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = normalize(self.ad_attack_track - ad_org);
	
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_ARMY, self.ad_attack_speed);
};

