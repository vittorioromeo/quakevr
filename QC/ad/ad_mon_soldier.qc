void()	ad_army_cdie5	=[	$deathc5,	ad_army_cdie6	] {ad_ai_back(3);};
void()	ad_army_cdie6	=[	$deathc6,	ad_army_cdie7	] {ad_ai_back(4);};
void()	ad_army_cdie7	=[	$deathc7,	ad_army_cdie8	] {};
void()	ad_army_cdie8	=[	$deathc8,	ad_army_cdie9	] {};
void()	ad_army_cdie9	=[	$deathc9,	ad_army_cdie10	] {};
void()	ad_army_cdie10	=[	$deathc10,	ad_army_cdie11	] {ad_monster_death_postcheck();};
void()	ad_army_cdie11	=[	$deathc11,	ad_army_cdie11	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_army_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "soldier/death1.wav", 1, ad_ATTN_NORM);
		if (random() < 0.5) ad_army_die1 ();		// Forward
		else ad_army_cdie1 ();									// Backward/side
	}
};

//======================================================================
/*ad:QUAKED monster_army (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_army =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_soldier.mdl";
	self.ad_headmdl = "progs/h_soldier.mdl";
	self.ad_gib1mdl = "progs/w_soldiergun.mdl";	// Unique weapon
	self.ad_gib2mdl = "progs/gib_soldfoot1.mdl";	// Upright foot
	self.ad_gib3mdl = "progs/gib_soldfoot2.mdl";	// Fallen down foot

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	if (random() < 0.5) self.ad_gib1skin = 1;		// Bloody weapon
	if (random() < 0.5) self.ad_gib2mdl = ad_string_null;
	if (random() < 0.5) self.ad_gib3mdl = ad_string_null;

	self.ad_idle_sound = "soldier/idle.wav";
	precache_sound (self.ad_idle_sound);

	precache_sound ("soldier/death1.wav");
	self.ad_pain_sound = "soldier/pain1.wav";
	self.ad_pain_sound2 = "soldier/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	precache_sound ("player/udeath.wav");	// gib death
	precache_sound ("soldier/sattck1.wav");	// Shotgun sound

	self.ad_sight_sound = "soldier/sight1.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	// This is just a gib/blood update, the SG is not poisonous
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = ad_HP_MONARMY;
	self.ad_gibhealth = -35;				// Easy to gib
	self.ad_gibbed = ad_FALSE;				// Still together
	self.ad_pain_flinch = 20;				// Easy to pain
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPEMEDIUM;		// Average feet
	self.ad_attack_offset = '12 8 12';		// End of Gun
	if (self.ad_deathstring == "")
		self.ad_deathstring = " was shot by a Grunt\n";
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_SoldierCheckAttack;
	self.ad_th_stand = ad_army_stand1;
	self.ad_th_walk = ad_army_walk1;
	self.ad_th_run = ad_army_run1;
	if (!self.ad_th_missile) self.ad_th_missile = ad_army_atk1;
	self.ad_th_pain = ad_army_pain;
	self.ad_th_die = ad_army_die;

	if (!self.ad_classtype) {
		self.ad_classtype = ad_CT_MONARMY;
		if (self.ammo_shells < 0) self.ammo_shells = 0;
		else if (self.ammo_shells == 0) self.ammo_shells = 5;
		// If no skin override is defined, pick a random one instead
		if (!self.ad_exactskin) self.ad_randomskin = 4;
	}
	self.ad_classgroup = ad_CG_ARMY;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};

//----------------------------------------------------------------------
void() ad_monster_army_rocket =
{	
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.ad_classtype = ad_CT_MONARMYROCKET;
	precache_model (ad_MODEL_PROJ_ROCKET);
	if (self.ad_poisonous) precache_model (ad_MODEL_PROJ_ROCKETGRN);

	if (self.health < 1) self.health = 45;
	// There are two red jacket skins to pick from
	if (random() < 0.5) self.ad_exactskin = 4;
	else self.ad_exactskin = 5;
	if (self.ammo_rockets < 0) self.ammo_rockets = 0;
	else if (self.ammo_rockets == 0) self.ammo_rockets = 1;
	self.ad_attack_explosive = ad_TRUE;			// Has explosive attack

	// Extra load/fire sounds (from Quoth MOD)
	precache_sound ("soldier/rocket_load.wav");
	precache_sound ("soldier/rocket_fire.wav");
	precache_sound ("soldier/rocket_hit.wav");
	
	self.ad_th_missile = ad_army_rocket_atk1;
	self.ad_th_melee = ad_army_runback1;
	self.ad_deathstring = " was blown up by a Rocketeer\n";
	
	ad_monster_army();
};

//----------------------------------------------------------------------
void() ad_monster_army_grenade =
{	
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.ad_classtype = ad_CT_MONARMYGRENADE;
	precache_model (ad_MODEL_PROJ_GRENADE);
	if (self.ad_poisonous) precache_model (ad_MODEL_PROJ_GRENADEGRN);
	
	if (self.health < 1) self.health = 60;
	// There are two green jacket skins to pick from
	if (random() < 0.5) self.ad_exactskin = 6;
	else self.ad_exactskin = 7;
	if (self.ammo_rockets < 0) self.ammo_rockets = 0;
	else if (self.ammo_rockets == 0) self.ammo_rockets = 1;
	self.ad_attack_explosive = ad_TRUE;			// Has explosive attack

	self.ad_th_missile = ad_army_grenade_atk1;
	self.ad_th_melee = ad_army_runback1;
	// Grenade bounce off body
	self.ad_bouncegrenade = ad_TRUE;
	self.ad_deathstring = " was pineappled by a Grenader\n";
	
	ad_monster_army();
};

//----------------------------------------------------------------------
void() ad_monster_army_plasma =
{	
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.ad_classtype = ad_CT_MONARMYPLASMA;
	precache_model (ad_MODEL_PROJ_PLASMA);
	if (self.ad_poisonous) precache_model (ad_MODEL_PROJ_PLASMAGRN);

	if (self.health < 1) self.health = 75;
	// There are two blue jacket skins to pick from
	if (random() < 0.5) self.ad_exactskin = 8;
	else self.ad_exactskin = 9;
	if (self.ammo_cells < 0) self.ammo_cells = 0;
	else if (self.ammo_cells == 0) self.ammo_cells = 2;

	// Extra load/fire sounds (from Quoth MOD)
	precache_sound ("enforcer/elim_pg_load.wav");
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);
	
	self.ad_th_missile = ad_army_plasma_atk1;
	self.ad_deathstring = " was fried by an Electrocutioner\n";
	
	ad_monster_army();
};
