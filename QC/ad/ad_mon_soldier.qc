//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_army_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			self.lip = random();
			if (self.lip < 0.2) {
				self.ad_pain_finished = time + 0.6;
				sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
				ad_army_pain1();
			}
			else if (self.lip < 0.6) {
				self.ad_pain_finished = time + 1.1;
				sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
				ad_army_painb1();
			}
			else {
				self.ad_pain_finished = time + 1.1;
				sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
				ad_army_painc1();
			}
		}
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 1.3;
			self.ad_axhitme = 0;
			// Pick a random pain sound
			if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
			// Pick a random long pain animation
			if (random() < 0.5) ad_army_painb1();
			else ad_army_painc1();
		}
	}
};

