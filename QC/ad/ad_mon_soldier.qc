//======================================================================
void() ad_army_fire =
{
	if (VR_AimCone_Wait(ad_army_fire, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	if (!self.enemy) return;
	if (self.health < 1) return;

	ad_ai_face();
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "soldier/sattck1.wav", 1, ad_ATTN_NORM);	
	
	// Choose between a projectile or hit-scan system
	if (ad_query_configflag(ad_SVR_SHOTGPROJ))
		ad_FireBullets (ad_QUANTITY_GRUNT, ad_SPREAD_GRUNT);
	else {
		ad_Launch_Shells(ad_QUANTITY_GRUNT, ad_SPREAD_GRUNT, ad_CT_PROJ_SG);
		ad_Launch_ShellCasing(1);
	}
};

