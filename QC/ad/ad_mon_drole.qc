ad_drole_claw(-250);};
void() ad_drole_clawR12 = [ $clawR12, ad_drole_clawR13 ] {ad_drole_charge(28);};
void() ad_drole_clawR13 = [ $clawR13, ad_drole_clawR14 ] {ad_drole_charge(27);};
void() ad_drole_clawR14 = [ $clawR14, ad_drole_clawR15 ] {ad_drole_charge(26);
sound (self, ad_CHAN_WEAPON, "drole/swipe.wav", 1, ad_ATTN_NORM);};
void() ad_drole_clawR15 = [ $clawR15, ad_drole_clawR16 ] {ad_monster_footstep(ad_FALSE);ad_drole_charge(30);};
void() ad_drole_clawR16 = [ $clawR16, ad_drole_run ] {ad_drole_charge(28);
	if (random() < 0.5 && ad_ai_checkmelee(ad_MONAI_MELEEDROLE2, ad_MONAI_MELEEZTALL) && 
		self.enemy.health > 0 && ad_visible(self.enemy)) ad_drole_clawL1();
};

