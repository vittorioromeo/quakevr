//----------------------------------------------------------------------
void() ad_drole_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "drole/death.wav", 1, ad_ATTN_NORM);
		ad_drole_death1 ();
	}
};

/*======================================================================
QUAKED monster_drole (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_drole =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_drole.mdl";
	self.ad_headmdl = "progs/h_drole.mdl";
	self.ad_gib1mdl = "progs/gib_drolearm1.mdl";	// Top arm (pose 1)
	self.ad_gib2mdl = "progs/gib_drolearm2.mdl";	// Top arm (pose 2)
	self.ad_gib3mdl = "progs/gib_droleleg1.mdl";	// stretched out leg

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (ad_MODEL_PROJ_DROLE);		// growing fireball
	
	self.ad_idle_sound = "drole/idle.wav";
	precache_sound (self.ad_idle_sound);

	precache_sound ("drole/enrage.wav");	// sight2.wav
	precache_sound ("drole/death.wav");
	self.ad_pain_sound = "drole/pain.wav";
	precache_sound (self.ad_pain_sound);
	
	precache_sound ("drole/fire.wav");		// Launch rockets
	precache_sound ("drole/r_explode.wav");	// unique explosion sound
	precache_sound ("drole/strike1.wav");	// melee impacts
	precache_sound ("drole/strike2.wav");
	precache_sound ("drole/swipe.wav");		// Missed melee

	self.ad_sight_sound = "drole/sight.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_DROLEGRN);	// growing poisonball
	}

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_GIANT;
	if (self.health < 1) self.health = 500;
	self.ad_gibhealth = -60;				// Hard to gib
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 200;				// takes alot to pain
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_pain_timeout = 2;				// High pain threshold
	self.ad_steptype = ad_FS_TYPEHEAVY;		// heavy feet
	self.ad_attack_explosive = ad_TRUE;			// Has explosive attack
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_attack_offset = '0 0 34';		// Middle of chest
	self.ad_deathstring = " was decimated by a Drole\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_DroleCheckAttack;
	self.ad_th_stand = ad_drole_standC1;
	self.ad_th_walk = ad_drole_walk1;
	self.ad_th_run = ad_drole_run;
	self.ad_th_melee = ad_drole_melee;		// Claw attack
	self.ad_th_missile = ad_drole_magic1;		// Fireball incoming!
	self.ad_th_updmissile = ad_drole_rocket1;	// Update flying rocket
	self.ad_th_pain = ad_drole_pain;
	self.ad_th_die = ad_drole_die;

	self.ad_classtype = ad_CT_MONDROLE;
	self.ad_classgroup = ad_CG_DEMON;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
