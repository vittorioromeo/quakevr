void() ad_drole_run7 = [ $walk7, ad_drole_run8 ] {ad_ai_run(13);};
void() ad_drole_run8 = [ $walk8, ad_drole_run ] {ad_ai_run(8);};

//----------------------------------------------------------------------
void() ad_drole_run =
{
	if (self.ad_attack_rage) ad_drole_rage1();
	else ad_drole_run1();
};

//===========================================================================
// MELEE ATTACK - Double claws
//===========================================================================
void(float ad_side) ad_drole_claw =
{
	local float ad_ldmg;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	ad_ai_face ();						// Turn towards enemy target
	ad_ai_damagebreakable(50);			// Damage any breakables

	if (!ad_ai_checkmelee(ad_MONAI_MELEEDROLE1,ad_MONAI_MELEEZTALL) 
		|| !self.enemy.takedamage) {
		// Melee claw miss sound
		sound (self, ad_CHAN_WEAPON, "drole/swipe.wav", 1, ad_ATTN_NORM);
	}
	else {
		// Melee claw hit sound
		if (random() < 0.5) sound (self, ad_CHAN_WEAPON, "drole/strike1.wav", 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_WEAPON, "drole/strike2.wav", 1, ad_ATTN_NORM);
		ad_ldmg = 12 + 6*random();
		ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);		
		ad_SpawnMeatSpray (self, self.enemy, ad_side);

		// Check for poisonous attribute (new poison version)
		if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);
	}
};

//----------------------------------------------------------------------
void(float ad_ragespd) ad_drole_charge =
{
	if (self.ad_attack_rage) ad_ai_charge(ad_ragespd);
	else ad_ai_charge(rint(ad_ragespd*0.7));
}

