void() ad_drole_clawL11 = [ $clawL11, ad_drole_clawL12 ] {ad_monster_footstep(ad_FALSE);ad_drole_charge(30);
ad_drole_claw(250);};
void() ad_drole_clawL12 = [ $clawL12, ad_drole_clawL13 ] {ad_drole_charge(28);};
void() ad_drole_clawL13 = [ $clawL13, ad_drole_clawL14 ] {ad_drole_charge(27);};
void() ad_drole_clawL14 = [ $clawL14, ad_drole_clawL15 ] {ad_drole_charge(26);
sound (self, ad_CHAN_WEAPON, "drole/swipe.wav", 1, ad_ATTN_NORM);};
void() ad_drole_clawL15 = [ $clawL15, ad_drole_clawL16 ] {ad_monster_footstep(ad_FALSE);ad_drole_charge(30);};
void() ad_drole_clawL16 = [ $clawL16, ad_drole_run ] {ad_drole_charge(28);
	if (random() < 0.5 && ad_ai_checkmelee(ad_MONAI_MELEEDROLE2, ad_MONAI_MELEEZTALL) && 
		self.enemy.health > 0 && ad_visible(self.enemy)) ad_drole_clawR1();
};

//----------------------------------------------------------------------
void() ad_drole_melee =
{
	if (random() < 0.5) ad_drole_clawR1();
	else ad_drole_clawL1();
};

//============================================================================
// RANGE ATTACK - Fireball (rocket)
// * The trick to drole rockets is that they start really slow
// * Over time (4 frames) the rocket speeds up (linked to animation)
// * requires special projectile and new th_updmissile function
// * Has a different explosion sound (does not play rocket default)
//
//============================================================================
void() ad_drole_rocket1 = [ 1, ad_drole_rocket2 ] {self.nextthink = time + 0.2;};
void() ad_drole_rocket2 = [ 2, ad_drole_rocket3 ] {self.velocity = self.velocity * 1.5;};
void() ad_drole_rocket3 = [ 3, ad_drole_rocket4 ] {self.velocity = self.velocity * 1.5;};
void() ad_drole_rocket4 = [ 3, ad_SUB_Remove ] {
	self.nextthink = time + 5;
	if (ad_skill == ad_SKILL_EASY) self.velocity = self.velocity * 3.5;
	else self.velocity = self.velocity * 4.5;
};

//----------------------------------------------------------------------
void() ad_drole_fire =
{
	local vector ad_org, ad_dir, ad_avel;
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.ad_attack_speed = 80;
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = normalize((self.ad_attack_track + '0 0 -8') - ad_org);
	ad_avel = ad_avel = ad_vecrand(100,200,ad_FALSE);
	
	ad_Launch_Missile (ad_org, ad_dir, ad_avel, ad_CT_PROJ_DROLE, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_drole_magic1 = [ $magic1, ad_drole_magic2 ] {
	self.ad_attack_track = self.enemy.origin;
	sound(self, ad_CHAN_WEAPON, "drole/fire.wav", 1, ad_ATTN_NORM);
};
void() ad_drole_magic2 = [ $magic2, ad_drole_magic3 ] {ad_ai_trackenemy();};
void() ad_drole_magic3 = [ $magic3, ad_drole_magic4 ] {ad_ai_trackenemy();};
void() ad_drole_magic4 = [ $magic4, ad_drole_magic5 ] {ad_ai_trackenemy();ad_drole_fire();};
void() ad_drole_magic5 = [ $magic5, ad_drole_magic6 ] {ad_ai_face();};
void() ad_drole_magic6 = [ $magic6, ad_drole_magic7 ] {ad_ai_face();};
void() ad_drole_magic7 = [ $magic7, ad_drole_magic8 ] {ad_ai_face();};
void() ad_drole_magic8 = [ $magic8, ad_drole_magic9 ] {ad_ai_face();};
void() ad_drole_magic9 = [ $magic9, ad_drole_run ] {ad_ai_face();};

//============================================================================
void() ad_drole_pain1 = [ $pain1, ad_drole_pain2 ] {ad_ai_back(8);};
void() ad_drole_pain2 = [ $pain2, ad_drole_pain3 ] {ad_ai_back(10);};
void() ad_drole_pain3 = [ $pain3, ad_drole_pain4 ] {ad_ai_back(10);};
void() ad_drole_pain4 = [ $pain4, ad_drole_pain5 ] {ad_ai_back(8);};
void() ad_drole_pain5 = [ $pain5, ad_drole_pain6 ] {ad_ai_back(6);};
void() ad_drole_pain6 = [ $pain6, ad_drole_run ] {ad_ai_back(4);};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_drole_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (self.ad_attack_rage) sound (self, ad_CHAN_VOICE, "drole/enrage.wav", 0.5, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);

		if (self.ad_pain_check == 1) ad_drole_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.6;
			self.ad_axhitme = 0;
			ad_drole_pain1 ();
		}
	}
};

