//============================================================================
// Drole's have two run speeds, regular and rage
// * each run type uses different animation sets
// * once the drole is enraged there is no going back
// * moved the health trigger to a percentage (custom HP)
//============================================================================
void() ad_drole_run;

void() ad_drole_rage1 = [ $run1, ad_drole_rage2 ] {ad_monster_idle_sound();ad_ai_run(27);};
void() ad_drole_rage2 = [ $run2, ad_drole_rage3 ] {ad_ai_run(26);};
void() ad_drole_rage3 = [ $run3, ad_drole_rage4 ] {ad_ai_run(30);};
void() ad_drole_rage4 = [ $run4, ad_drole_rage5 ] {ad_monster_footstep(ad_FALSE); ad_ai_run(28);};
void() ad_drole_rage5 = [ $run5, ad_drole_rage6 ] {ad_ai_run(27);};
void() ad_drole_rage6 = [ $run6, ad_drole_rage7 ] {ad_ai_run(26);};
void() ad_drole_rage7 = [ $run7, ad_drole_rage8 ] {ad_ai_run(30);};
void() ad_drole_rage8 = [ $run8, ad_drole_run ] {ad_monster_footstep(ad_FALSE); ad_ai_run(28);};

