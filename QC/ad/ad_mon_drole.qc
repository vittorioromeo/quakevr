void()	ad_drole_standC30	=[	$standC30,	ad_drole_standC1	] {
	self.ad_idlebusy = ad_FALSE; 
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.ad_idlebusy = ad_TRUE;
		self.lefty = random();
		if (self.lefty < 0.3) self.think = ad_drole_standA1;
		else if (self.lefty < 0.6) self.think = ad_drole_standB1;
		else self.think = ad_drole_standC1;
	}
	ad_ai_stand();
};

