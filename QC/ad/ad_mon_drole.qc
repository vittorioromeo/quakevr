void() ad_drole_run1 = [ $walk1, ad_drole_run2 ] {ad_monster_footstep(ad_FALSE); ad_ai_run(15);};
void() ad_drole_run2 = [ $walk2, ad_drole_run3 ] {ad_monster_idle_sound();ad_ai_run(14);};
void() ad_drole_run3 = [ $walk3, ad_drole_run4 ] {ad_ai_run(14);};
