// AD's readme and docs/vr-port/CREDITS.md), my_progs/ai_hazards.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 HAZARD PROJECTILE Systems
 ------------------------

 * Flame (SPRITES)
 * Blobs (MODELS)

 * Hazard projectiles are about denying movement space to players
   and creating a temporary hazard to naviagate around
   
 * Players who jump a lot and have greater DM focused movement skills,
   will find hazard damage projectiles easier to deal with.
 
 * Hazard projectiles often have particle emitters or effects
   which can quickly drag down engine FPS. All hazard projectiles
   need to maintain counters to help performance.

 * Kill triggers can be dangerous on monsters that use hazard
   projectiles because the counters are not zero'd correctly
   
 * Void triggers do cope with hazard projectile counters
 
======================================================================*/	
float ad_PROJ_MAXLIMIT = 32;		// Fire sprite limit per monster

.float		ad_proj_count;			// Floor model/sprite active counter
.float		ad_proj_limit;			// Maximum amount of floor model/sprite active
.vector		ad_proj_attqty;		// Proj Count = Base (X) * (Skill * Y) Maximum = Z
.float		ad_proj_attarc;		// Proj Arc Easy=-1/1, Normal=-2/2, Hard=-3/3
.entity		ad_proj_source;		// Source entity for the floor projectiles

float ad_FLAME_RED = 0;				// Default colour
float ad_FLAME_GREEN = 1;				// Not implemented (Add later)
float ad_FLAME_BLUE = 2;				// Extra blue version
float ad_LIFE_HAZARD = 5;				// Bouncing hazard models
float ad_LIFE_FLAME = 5;				// Long burning flame + 2 x random()
float ad_FRAME_FLAME = 14;				// Maximum amount of frames
float ad_FLAME_TINY = 1;				// 50% chance
float ad_FLAME_SML = 2;				// 30% chance
float ad_FLAME_MED = 5;				// 20% chance
float ad_FLAME_VLRG = 10;				// Not implemented (Add later)

.entity		ad_proj_trcont;		// Controller entity for flame lines
.float		ad_proj_trqty;			// Fire trail quantity of flames to create
.float		ad_proj_trdist;		// Fire trail distance for each flame segment
.float		ad_proj_trstep;		// Fire trail step up/down height restrictions
.float		ad_proj_trwobble;		// Fire trail wobble on X/Y axis going forward
.float		ad_proj_trlife;		// Fire trail life time of flame sprites
.float		ad_proj_trdmg;			// Fire trail explosive damage at end of line
.float		ad_proj_trspeed;		// Fire trail tick timing speed

float ad_FLAME_TRCOUNT = 12;			// Trail flame count
float ad_FLAME_TRDIST = 32;			// Trail distance between flames
float ad_FLAME_TRSTEP = 64;			// Trail flame ledge height
float ad_FLAME_TRWOBBLE = 8;			// Trail flame random XY wobble
float ad_FLAME_TREXPLODE = 40;			// Trail flame xxplosive damage
float ad_FLAME_TRLIFE = 8;				// Trail flame life time
float ad_FLAME_TRSPEED = 0.02;			// Trail flame standard speed

string ad_MODEL_PROJ_FLAMETINY = "progs/s_flametiny.spr";
string ad_MODEL_PROJ_FLAMESML = "progs/s_flamesml.spr";
string ad_MODEL_PROJ_FLAMEMED = "progs/s_flamemed.spr";
string ad_MODEL_PROJ_FLAMEVLRG = "progs/s_flamevlrg.spr";

// FIXME : Need to create good blue flames, easier said than done!
// Using the red flames for the moment, until new assets available
string ad_MODEL_PROJ_BFLAMETINY = "progs/s_flametiny.spr";
string ad_MODEL_PROJ_BFLAMESML = "progs/s_flamesml.spr";
string ad_MODEL_PROJ_BFLAMEMED = "progs/s_flamemed.spr";
string ad_MODEL_PROJ_BFLAMEVLRG = "progs/s_flamevlrg.spr";

//----------------------------------------------------------------------
void() ad_PreCache_Flame = 
{
	precache_model (ad_MODEL_PROJ_FLAMETINY);		// 16 (wide) x  48 (high)
	precache_model (ad_MODEL_PROJ_FLAMESML);		// 24 (wide) x  64 (high)
	precache_model (ad_MODEL_PROJ_FLAMEMED);		// 32 (wide) x  96 (high)
	//precache_model (MODEL_PROJ_FLAMEVLRG);		// 48 (wide) x 128 (high)
	precache_sound ("ambience/flames1.wav");
	precache_sound ("ambience/flames2.wav");
	precache_sound ("ambience/flames3.wav");
	precache_sound ("ambience/flames4.wav");
};

//----------------------------------------------------------------------
void() ad_PreCache_BlueFlame = 
{
	precache_model (ad_MODEL_PROJ_BFLAMETINY);		// 16 (wide) x  48 (high)
	precache_model (ad_MODEL_PROJ_BFLAMESML);		// 24 (wide) x  64 (high)
	precache_model (ad_MODEL_PROJ_BFLAMEMED);		// 32 (wide) x  96 (high)
	//precache_model (MODEL_PROJ_BFLAMEVLRG);		// 48 (wide) x 128 (high)
	precache_sound ("ambience/flames1.wav");
	precache_sound ("ambience/flames2.wav");
	precache_sound ("ambience/flames3.wav");
	precache_sound ("ambience/flames4.wav");
};

//----------------------------------------------------------------------
// Is there any space left to spawn a hazard projectile?
// return TRUE if counter is lower than limit
//----------------------------------------------------------------------
float(entity ad_targ, float ad_maxextra) ad_HazardProjectile_CheckLimit =
{
	// Can't do a limit check if no limit (proj_limit) is set!
	// This allows for an override to be defined on attacker
	if (ad_targ.ad_proj_limit <= 0) {
		// Use global particle max to create limit
		// This is a good idea on paper, but this is trashing fps
		//targ.proj_limit = (part_max / (1024*part_multiplier)) * PROJ_MAXLIMIT;
		// Max limit = better default, anything higher will trash memory
		ad_targ.ad_proj_limit = ad_PROJ_MAXLIMIT;
		dprint("\b[HAZARD]\b Monster ("); dprint(ad_targ.classname);
		dprint(") Setup Max ("); dprint(ftos(ad_targ.ad_proj_limit));
		dprint(")\n");
	}
	// Really low chance of DP effects (def=0.02, -1=disabled)
	if (ad_targ.ad_dpp_flame == 0) ad_targ.ad_dpp_flame = 0.02;
	
	// has the hazard damage projectile limit been reached?
	// 'maxextra' used to check for complete projectile attack quantity
	if (ad_targ.ad_proj_count < (ad_targ.ad_proj_limit - ad_maxextra)) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// Single function for any increase in the projectile counter
// Double check the source entity exists first
//----------------------------------------------------------------------
void(entity ad_targ) ad_HazardProjectile_AddCounter =
{
	// Does the source exist?
	if (ad_targ.ad_proj_source != world) {
		// Update counters on source entity
		if (ad_targ.ad_proj_source.ad_proj_count >= 0) {
			ad_targ.ad_proj_source.ad_proj_count = ad_targ.ad_proj_source.ad_proj_count + 1;
		}
	}
};

//----------------------------------------------------------------------
// Final function to decrease counters and remove entity
//----------------------------------------------------------------------
void(entity ad_targ) ad_HazardProjectile_Finished =
{
	// Does the source exist?
	if (ad_targ.ad_proj_source != world) {
		// Update counters on source entity
		if (ad_targ.ad_proj_source.ad_proj_count > 0) {
			ad_targ.ad_proj_source.ad_proj_count = ad_targ.ad_proj_source.ad_proj_count - 1;
		}
	}
	// Only do this once
	ad_targ.ad_proj_source = world;

	// Puff of smoke
	if (ad_targ.ad_part_exitpuff)
		ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, ad_targ.origin+ad_targ.view_ofs, "");
	
	// Stop any ambient sounds
	if (ad_targ.ad_part_exitsound) {
		sound(ad_targ, ad_CHAN_WEAPON, ad_SOUND_EMPTY, 1, 1);
		sound(ad_targ, ad_CHAN_VOICE, ad_SOUND_EMPTY, 1, 1);
		sound(ad_targ, ad_CHAN_ITEM, ad_SOUND_EMPTY, 1, 1);
		sound(ad_targ, ad_CHAN_BODY, ad_SOUND_EMPTY, 1, 1);
	}

	// Fade entity?
	if (ad_targ.ad_part_exitfade) {
		// Stop world interaction
		ad_entity_stop(ad_targ);
		ad_targ.nextthink = time + 0.02;
		ad_targ.think = ad_model_fade;
	}
	// Remove entity
	else ad_entity_remove(ad_targ, 0.1);
};

//----------------------------------------------------------------------
void() ad_HazardProjectile_Exit = { ad_HazardProjectile_Finished(self); };

//----------------------------------------------------------------------
void() ad_Animate_HazardProjectile =
{
	// Check if owner of flame is busy and needs flame to stop!
	if (self.owner.ad_part_exitbusy > 0 && self.ad_part_exitbusy == ad_FALSE) {
		// Kill the entity this frame (0) or the next (+0.05)
		if (random() < 0.5) self.ad_attack_finished = 0;
		else self.ad_attack_finished = time + 0.05;
		// Randomly get rid of half of all smoke puffs
		if (self.ad_part_exitpuff && random() < 0.5)
			self.ad_part_exitpuff = ad_FALSE;
		// Block this feature, its finished
		self.ad_part_exitbusy = ad_TRUE;
	}
	// Projectile has run out of time (cope with hazard counters)
	if (self.ad_attack_finished < time) {ad_HazardProjectile_Finished(self); return;}
	
	// Animate sprite
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe >= ad_FRAME_FLAME) self.ad_walkframe = 0;
	self.frame = self.ad_walkframe;
	
	// Keep playing ambient sound
	if (self.noise != "" && self.volume < time) {
		sound(self, ad_CHAN_AUTO, self.noise, 0.3, ad_ATTN_IDLE);
		self.volume = time + 1;
	}

	// Advanced engines?
	if (ad_ext_dppart) {
		// Way to disable DP/FTE/QSS particle effects
		if (self.owner.ad_dpp_flame > 0) {
			// Really need low particle rate (can trash frame rate)
			if (ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && random() < self.owner.ad_dpp_flame) {
				// Only use this for the red flames
				if (self.ad_part_style == ad_PARTICLE_BURST_RED)
					// Use the small flame particle effect (dots+smoke)
					pointparticles(particleeffectnum(ad_DPP_FLAMES), self.origin, '0 0 0', 1);
			}
		}
	}
	else {
		// Random particle spark
		if (random() < 0.05) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
		// Random particle burst, expects defaults have been setup
		if (random() < self.ad_part_chance)
			ad_particle_explode(self.origin+self.ad_part_ofs, self.ad_part_base+random()*self.ad_part_rand, self.ad_part_life+random(), self.ad_part_style, 0);
	}
	
	// Keep looping
	self.think = ad_Animate_HazardProjectile;
	self.nextthink = time + 0.1;	
};

//----------------------------------------------------------------------
void() ad_Touch_HazardProjectile =
{
	if (self.ad_touchedvoid) return;				// Marked for removal
	if (ad_check_skycontent(self.origin)) { ad_HazardProjectile_Finished(self); return;}
	if (other == self.owner) return;			// Touching attacker, do nothing
	if (other.solid == ad_SOLID_TRIGGER) return;	// trigger field, do nothing
	if (other.ad_classgroup == ad_CG_PROJHAZARD) return;	// Touching other hazards
	if (self.ad_attack_finished < time) return;	// Hazard finished, no more touch
	if (self.ad_pain_finished > time) return;		// Slow down touch damage

	self.velocity = self.velocity * 0.5;	// Slow down velocity bounce
	self.ad_pain_finished = time + 0.1;		// Slow down touch/pain cycle
	self.ad_part_qctrail = ad_FALSE;				// No more particle trail effect

	// Switch to trigger type so that monsters can interact with them
	// Need to reset size, so the solid type can be changed to trigger
	if (self.solid != ad_SOLID_TRIGGER) {
		self.solid = ad_SOLID_TRIGGER;
		setsize(self, self.ad_bbmins, self.ad_bbmaxs);
	}
	
	// Check if can damage target
	if (other.takedamage) {
		// Check target is the same group type as owner of projectile
		// This is to prevent groups of the same enemy type killing each other!
		if (other.ad_classgroup == self.owner.ad_classgroup) self.dmg = 0;
		else {
			// DMG easy=1-2, normal=1-3, hard=1-4, nm=1-5, evil=1-6
			self.dmg = 1;
			self.cnt = 1 + ad_skill;
			// Loop through base + random damage
			while (self.cnt > 0) { 
				self.dmg = self.dmg + random(); 
				self.cnt = self.cnt - 1;
			}
		}

		//----------------------------------------------------------------------
		// LAVA SHIELD
		// Resistance = 50% fire/lava attacks
		if (other.flags & ad_FL_CLIENT && other.ad_moditems & ad_IT_ARTLAVASHIELD) {
			ad_PlayLavaShieldSound(other);
			if (self.dmg > 0) self.dmg = floor(self.dmg * 0.5);
		}
	
		//----------------------------------------------------------------------
		// Add any monster infighting modifiers (no negative or zero)
		// Round down the damage to integers (can cause logic issues)
		if (self.ad_infightextra <= 0) self.ad_infightextra = 1;
		if (self.dmg > 0) self.dmg = floor(self.ad_infightextra * self.dmg);
		
		//----------------------------------------------------------------------
		// FINALLY any damage?
		if (self.dmg > 0) {
			// Spawn some blood, cause harm and play a sound!
			ad_spawn_touchblood (self, other, self.dmg);
			ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);
			// Play touch sound if defined? (limit replay)
			if (self.ad_part_soundtouch != "" && self.ad_part_soundtimer < time) {
				self.ad_part_soundtimer = time + 0.3;
				self.volume = 0.5 + (random() * 0.5);
				sound (self, ad_CHAN_WEAPON, self.ad_part_soundtouch, self.volume, ad_ATTN_FEET);
			}
		}
	}
	else {
		// Any impact/miss sound defined?
		if (self.ad_part_soundmiss != "") {
			sound (self, ad_CHAN_WEAPON, self.ad_part_soundmiss, 1, ad_ATTN_FEET);
			// trigger sound once
			self.ad_part_soundmiss = "";
		}
	}
};

/*======================================================================
 FLAME WALL PROJECTILE ATTACK
 * Uses sprites for animation/flame effect
 * Has radius and impact touch damage
======================================================================*/
// Wall of flame, left > right
// Easy = 3(-1/1), Normal = 5(-2/2), Hard/NM = 7(-3/3)
float(vector ad_waveqty) ad_SpriteCount_Flame =
{
	float ad_wave_count;
	ad_wave_count = ad_waveqty_x + (ad_skill * ad_waveqty_y);
	if (ad_wave_count > ad_waveqty_z) ad_wave_count = ad_waveqty_z;
	return ad_wave_count;
};

//----------------------------------------------------------------------
// target entity, origin, v_forward, colour, size, lifetime, speed
void(entity ad_targ, vector ad_org, vector ad_dir, float ad_proj_color, float ad_proj_size, float ad_proj_life, float ad_proj_speed) ad_Launch_Flame =
{
	// Check if the hazard projectile limit exists and has been reached?
	if ( !(ad_HazardProjectile_CheckLimit(ad_targ,1)) ) return;
	
	ad_newmis = spawn ();
	ad_newmis.owner = ad_targ;
	ad_newmis.classname = "proj_flame";	// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_CT_PROJ_FLAME;	// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJHAZARD;	// Special Hazard Projectile Type

	ad_newmis.ad_attack_speed = ad_proj_speed;		// Projectile Speed (velocity)
	ad_newmis.view_ofs = '0 0 16';				// Offset for particle effects
	ad_newmis.oldorigin = ad_newmis.origin = ad_org;	// Save starting origin
	setorigin (ad_newmis, ad_newmis.origin);		// Move to start point

	// Allow for stationary fire hazards to exist
	if (ad_newmis.ad_attack_speed <= 0) ad_newmis.movetype = ad_MOVETYPE_NONE;
	else ad_newmis.movetype = ad_MOVETYPE_BOUNCE;
	// Need trigger type for monster/player interaction
	ad_newmis.solid = ad_SOLID_TRIGGER;

	// Monsters do extra (quad) damage to other monsters
	if (ad_targ.flags & ad_FL_MONSTER && ad_targ.enemy.flags & ad_FL_MONSTER) {
		// Take value from source monster so it can be changed
		ad_newmis.ad_infightextra = ad_targ.ad_infightextra;
	}
	
	// Setup Touch function and lifetime timer
	ad_newmis.touch = ad_Touch_HazardProjectile;
	if (ad_proj_life <= 0) 
		ad_newmis.ad_attack_finished = time + ad_LIFE_FLAME + random() + random();
	else ad_newmis.ad_attack_finished = time + ad_proj_life;
	// On death, show puff of smoke and clear sounds
	ad_newmis.ad_part_exitpuff = ad_targ.ad_part_exitpuff;
	ad_newmis.ad_part_exitsound = ad_targ.ad_part_exitsound;
	ad_newmis.ad_part_exitfade = ad_targ.ad_part_exitfade;

	// Update hazard projectile counters
	ad_newmis.ad_proj_source = ad_targ;
	ad_HazardProjectile_AddCounter(ad_newmis);
	
	//----------------------------------------------------------------------
	// Allow for random selection of sprite size
	if (ad_proj_size <= 0) {
		ad_newmis.lip = random();
		// 20% Medium, 30% Small, 50% Tiny
		if (ad_newmis.lip < 0.2) ad_proj_size = ad_FLAME_MED;
		else if (ad_newmis.lip < 0.5) ad_proj_size = ad_FLAME_SML;
		else ad_proj_size = ad_FLAME_TINY;
	}

	// Default = Tiny flame
	if (ad_proj_size == ad_FLAME_SML) {
		ad_newmis.ad_bbmins = '-6 -6 0'; ad_newmis.ad_bbmaxs = '6 6 24';
		if (ad_proj_color == ad_FLAME_BLUE) setmodel (ad_newmis, ad_MODEL_PROJ_BFLAMESML);
		else setmodel (ad_newmis, ad_MODEL_PROJ_FLAMESML);		// 24x64 BB=12x24
	}
	else if (ad_proj_size == ad_FLAME_MED) {
		ad_newmis.ad_bbmins = '-8 -8 0'; ad_newmis.ad_bbmaxs = '8 8 32';
		if (ad_proj_color == ad_FLAME_BLUE) setmodel (ad_newmis, ad_MODEL_PROJ_BFLAMEMED);
		else setmodel (ad_newmis, ad_MODEL_PROJ_FLAMEMED);		// 32x96 BB=16x32
	}
	/* Maybe add it later
	else if (proj_size == FLAME_VLRG) {
		newmis.bbmins = '-12 -12 0'; newmis.bbmaxs = '12 12 48';
		if (proj_color == FLAME_BLUE) setmodel (newmis, MODEL_PROJ_BFLAMEVLRG);
		else setmodel (newmis, MODEL_PROJ_FLAMEVLRG);	// 48x128 BB=24x48
	} */
	else {
		ad_newmis.ad_bbmins = '-4 -4 0'; ad_newmis.ad_bbmaxs = '4 4 16';
		if (ad_proj_color == ad_FLAME_BLUE) setmodel (ad_newmis, ad_MODEL_PROJ_BFLAMETINY);
		else setmodel (ad_newmis, ad_MODEL_PROJ_FLAMETINY);	// 16x48 BB=8x16
	}
	
	// override sprite default bounding box
	setsize (ad_newmis, ad_newmis.ad_bbmins, ad_newmis.ad_bbmaxs);
	// Setup starting (randomize) frame
	ad_newmis.ad_walkframe = rint(random() * ad_FRAME_FLAME);
	if (ad_newmis.ad_walkframe >= ad_FRAME_FLAME) ad_newmis.ad_walkframe = 0;
	ad_newmis.frame = ad_newmis.ad_walkframe;

	// Movement done in projectile tick function
	ad_newmis.velocity = ad_dir;
	ad_newmis.avelocity = '0 0 0';

	ad_newmis.lip = random();
	if (ad_newmis.lip < 0.25) ad_newmis.noise = "ambience/flames1.wav";
	else if (ad_newmis.lip < 0.5) ad_newmis.noise = "ambience/flames2.wav";
	else if (ad_newmis.lip < 0.75) ad_newmis.noise = "ambience/flames3.wav";
	else ad_newmis.noise = "ambience/flames4.wav";
	sound(ad_newmis, ad_CHAN_VOICE, ad_newmis.noise, 0.3, ad_ATTN_IDLE);
	ad_newmis.volume = time + 1;
	
	// Setup particle defaults for hazard emitter
	if (ad_proj_color == ad_FLAME_BLUE) ad_newmis.ad_part_trstyle = ad_PARTICLE_TRAIL_PLASMA;
	ad_newmis.ad_part_trstyle = ad_PARTICLE_TRAIL_YELLOW;
	ad_Default_ParticleTrail(ad_newmis);
	// Manually animate the sprite flames
	ad_newmis.nextthink = time + 0.1;
	ad_newmis.think = ad_Animate_HazardProjectile;
};

/*======================================================================
 FLAME TRAIL PROJECTILE ATTACK
 * Uses sprites for animation/flame effect
 * Has radius and impact touch damage
======================================================================*/
void() ad_Fire_Trail =
{
	local float ad_trblocked, ad_trstepup;
	
	// Is the flame trail active?
	if (self.count < 0) return;
	
	// Check if the hazard projectile limit exists and has been reached?
	if ( !(ad_HazardProjectile_CheckLimit(self.owner,1)) ) ad_trblocked = ad_TRUE;
	else {
		// default condition
		ad_trblocked = ad_trstepup = ad_FALSE;
		// Move forward along the line (movedir)
		self.pos2 = self.pos1 + (self.movedir * self.owner.ad_proj_trdist);
		// Is next position is solid world/geo?
		if (pointcontents(self.pos2) == ad_CONTENT_SOLID) {
			// Check maximum step height is available?
			if (pointcontents(self.pos2 + self.ad_finaldest) == ad_CONTENT_EMPTY) {
				// Trace down from maximum step height to find new pos
				traceline(self.pos2 + self.ad_finaldest, self.pos2, ad_TRUE, self);
				self.pos2 = trace_endpos + '0 0 8';
				ad_trstepup = ad_TRUE;
			}
			// Max step height is solid geo/world
			else ad_trblocked = ad_TRUE;
		}
		// Is next position solid, liquid or sky?
		if (pointcontents(self.pos2) != ad_CONTENT_EMPTY) ad_trblocked = ad_TRUE;
		else {
			// Can previous position see next position? nothing blocking
			traceline(self.pos1, self.pos2, ad_TRUE, self);
			// 'STEP UP' will often block line of sight to next point
			if (trace_fraction < 1 && ad_trstepup == ad_FALSE) ad_trblocked = ad_TRUE;
			else {
				// Find ground below next step point
				traceline(self.pos2, self.pos2 - (self.ad_finaldest*2), ad_TRUE, self);
				// Check distance between step points
				self.t_length = fabs(self.pos1_z - trace_endpos_z);
				// Can only step up or down a certain distance
				if ( self.t_length > (self.owner.ad_proj_trstep+8)) ad_trblocked = ad_TRUE;
				// Check final position is not solid,liquid or sky
				if (pointcontents(trace_endpos) != ad_CONTENT_EMPTY) ad_trblocked = ad_TRUE;
			}
		}
		
		// Is the next sprite blocked?
		if (ad_trblocked == ad_FALSE) {
			// Update line position (next point)
			self.pos1 = trace_endpos;
			// Random lifetime
			self.height = self.owner.ad_proj_trlife + random() + random();
			// Setup random wobble to origin for new flame
			self.ad_pos3 = ad_vecrand(0, self.owner.ad_proj_trwobble, ad_TRUE);
			// Flatten any z changes first
			self.ad_pos3_z = 0; self.ad_pos3 = self.ad_pos3 + self.pos1;
			// target, origin, v_forward, colour, size, lifetime, speed
			ad_Launch_Flame (self.owner, self.ad_pos3, '0 0 0', self.lip, -1, self.height, 0);
		}
	}

	// Keep counting down
	self.count = self.count - 1;
	// reach end of the line?
	if (self.count <= 0 || ad_trblocked == ad_TRUE) {
		self.count = 0;
		self.origin = self.pos1 + '0 0 24';
		// Move to explosion for t_radiusdamage
		setorigin(self, self.origin);
		ad_SpawnExplosion(self.ad_attack_expflame, self.origin, self.noise);
		// Any explosive damage?
		if (self.owner.ad_proj_trdmg > 0) 
			ad_T_RadiusDamage (self, self.owner, self.owner.ad_proj_trdmg, world, ad_DAMAGEALL);
	}
	else {
		// Keep looping
		self.think = ad_Fire_Trail;
		self.nextthink = time + self.speed;
	}
};

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir, float ad_proj_color, string ad_proj_sfx) ad_Launch_Trail =
{
	// Check if the hazard projectile limit exists and has been reached?
	if ( !(ad_HazardProjectile_CheckLimit(self,1)) ) return;
	
	// Is the flame trail controller setup?
	if (!self.ad_proj_trcont) self.ad_proj_trcont = spawn ();
	// Is the flame trail currently active?
	if (self.ad_proj_trcont.count > 0) return;
	
	self.ad_proj_trcont.owner = self;
	self.ad_proj_trcont.classname = "proj_trail";
	self.ad_proj_trcont.ad_classtype = ad_CT_CONTROL;
	self.ad_proj_trcont.ad_classgroup = ad_CG_PROJHAZARD;

	self.ad_proj_trcont.solid = ad_SOLID_NOT;
	self.ad_proj_trcont.movetype = ad_MOVETYPE_NONE;
	self.ad_proj_trcont.origin = self.origin + '0 0 64';
	setorigin(self.ad_proj_trcont, self.ad_proj_trcont.origin);
	setsize(self.ad_proj_trcont, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	self.ad_proj_trcont.movedir = ad_dir;
	
	// Quantity of sprites per line
	if (self.ad_proj_trqty <= 0) self.ad_proj_trqty = ad_FLAME_TRCOUNT;
	// Always reset count to new value (loop variable)
	self.ad_proj_trcont.count = self.ad_proj_trqty;

	// Sprite flame colour (def=red)
	if (ad_proj_color <= 0) self.ad_proj_trcont.lip = ad_FLAME_RED;
	else self.ad_proj_trcont.lip = ad_proj_color;
	// Setup explosion sprite to match projectile
	if (self.ad_proj_trcont.lip == ad_FLAME_BLUE)
		self.ad_proj_trcont.ad_attack_expflame = ad_EXPLODE_PLASMA_BIG;
	else self.ad_proj_trcont.ad_attack_expflame = ad_EXPLODE_BIG;
	// Final explosion sound FX
	if (ad_proj_sfx == "") self.ad_proj_trcont.noise = ad_SOUND_REXP3;
	else self.ad_proj_trcont.noise = ad_proj_sfx;
	
	// Setup trail segment distance, random wobble and max step height
	if (self.ad_proj_trdist <= 0) self.ad_proj_trdist = ad_FLAME_TRDIST;
	if (self.ad_proj_trwobble <= 0) self.ad_proj_trwobble = ad_FLAME_TRWOBBLE;
	if (self.ad_proj_trstep <= 0) self.ad_proj_trstep = ad_FLAME_TRSTEP;

	// Final explosive damage at end of line/trail (-1 = no damage)
	if (self.ad_proj_trdmg == 0) self.ad_proj_trdmg = ad_FLAME_TREXPLODE;
	// Life time for flames to remain on floor (x + rnd + rnd)
	if (self.ad_proj_trlife <= 0) self.ad_proj_trlife = ad_FLAME_TRLIFE;
	
	// Speed at which flame line is created (tick speed)
	// Skill based speed 0=0.10, 1=0.08, 2=0.06, 3=0.04
	if (self.ad_proj_trspeed > 0.04) self.ad_proj_trcont.speed = self.ad_proj_trspeed;
	else self.ad_proj_trcont.speed = 0.1 - (ad_skill * ad_FLAME_TRSPEED);
	// Always have lower limit for speed tick value
	if (self.ad_proj_trcont.speed < 0.04) self.ad_proj_trcont.speed = 0.04;
	
	// Setup STEP height as a vector
	self.ad_proj_trcont.ad_finaldest = '0 0 0'; 
	self.ad_proj_trcont.ad_finaldest_z = self.ad_proj_trstep + 8;

	// Find out start position
	traceline(ad_org, ad_org - self.ad_proj_trcont.ad_finaldest, ad_TRUE, self);
	self.ad_proj_trcont.pos1 = trace_endpos;
	
	// Start with initial flame
	// target, origin, v_forward, colour, size, lifetime, speed
	ad_Launch_Flame (self, self.ad_proj_trcont.pos1, '0 0 0', self.ad_proj_trcont.lip, -1, -1, 0);

	// Keep the conga line going ...
	self.ad_proj_trcont.think = ad_Fire_Trail;
	self.ad_proj_trcont.nextthink = time + self.ad_proj_trcont.speed;
};

/*======================================================================
 HAZARD PROJECTILES 
 * Uses models and particle/trails for effects
 * Has radius and impact touch damage
======================================================================*/
void(vector ad_org, vector ad_dir, vector ad_avel, float ad_proj_type) ad_Launch_Hazard =
{
	// Check if the hazard projectile limit exists and has been reached?
	if ( !(ad_HazardProjectile_CheckLimit(self,1)) ) return;
	
	ad_newmis = spawn ();
	ad_newmis.owner = self;
	ad_newmis.classname = "proj_hazard";	// obj name, not really used anymore
	ad_newmis.ad_classtype = ad_proj_type;		// Class type number, quick identity
	ad_newmis.ad_classgroup = ad_CG_PROJHAZARD;	// Special Hazard Projectile Type

	ad_newmis.movetype = ad_MOVETYPE_BOUNCE;	// Bounce like a grenade, classic arc
	ad_newmis.solid = ad_SOLID_BBOX;			// trigger is limited, use bbox until touch
	ad_newmis.ad_bbmins = '-4 -4 0'; 			// Save for touch function
	ad_newmis.ad_bbmaxs = '4 4 0';

	// Setup Touch function and lifetime timer
	ad_newmis.touch = ad_Touch_HazardProjectile;
	ad_newmis.ad_attack_finished = time + ad_LIFE_HAZARD + random() + random();

	// Update hazard projectile counters
	ad_newmis.ad_proj_source = self;
	ad_HazardProjectile_AddCounter(ad_newmis);

	// Monsters do extra (quad) damage to other monsters
	if (self.flags & ad_FL_MONSTER && self.enemy.flags & ad_FL_MONSTER) {
		// Take value from source monster so it can be changed
		ad_newmis.ad_infightextra = self.ad_infightextra;
	}

	// Setup model for each missile type
	//----------------------------------------------------------------------
	if (ad_proj_type == ad_CT_PROJ_DPRINCE2) {
		setmodel(ad_newmis, self.ad_attack_proj2);
		ad_newmis.ad_part_qctrail = ad_TRUE;
		ad_newmis.ad_part_trstyle = self.ad_part_trstyle;
		ad_newmis.frame = rint((random() * 9));
		ad_newmis.ad_part_soundmiss = "dknight/dprince_miss.wav";
	}
	else if (ad_proj_type == ad_CT_PROJ_SWEEPER2) {
		setmodel(ad_newmis, self.ad_attack_proj2);
		ad_newmis.ad_part_qctrail = ad_TRUE;
		ad_newmis.ad_part_trstyle = self.ad_part_trstyle;
		ad_newmis.frame = rint((random() * 9));
		ad_newmis.ad_part_soundmiss = "sweeper/hazard_miss.wav";
	}
	
	// Standard projectile setup (origin, size and velocity)
	//----------------------------------------------------------------------
	ad_newmis.velocity = ad_dir;
	ad_newmis.avelocity = ad_avel;
	ad_newmis.angles = vectoangles(ad_newmis.velocity);
	ad_newmis.oldorigin = ad_newmis.origin = ad_org;	// Save starting origin
	setorigin (ad_newmis, ad_newmis.origin);		// Move to start point
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

	// Burning touch sound (precached in world.qc)
	ad_newmis.ad_part_soundtouch = ad_GIB_SOUND_ACID;
	// Setup particle defaults for hazard emitter
	ad_Default_ParticleTrail(ad_newmis);
	ad_newmis.think = ad_Custom_ParticleTrail;	
	ad_newmis.nextthink = time + 0.1;

	// Special particle trail
	//----------------------------------------------------------------------
	if (ad_newmis.ad_part_qctrail == ad_TRUE ) {
		// Is DP/FTE/QSS engine active for particle trail feature?
		if (ad_ext_dppart && ad_newmis.ad_dpp_name != "") {
			ad_newmis.ad_traileffectnum = particleeffectnum(ad_newmis.ad_dpp_name);
			ad_newmis.effects = 0;
		}
		// Particle trail needs quick update
		ad_newmis.nextthink = time + 0.02;
	}
};

