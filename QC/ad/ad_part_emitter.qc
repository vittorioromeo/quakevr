		ad_pe_ent.ad_part_vol = '4 4 4';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_velrand = '4 4 8';		// Volume wobble
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
