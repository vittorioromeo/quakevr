	//----------------------------------------------------------------------
	// Particles raising up around an altar
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_ALTAR) {
		if (ad_pe_ent.ad_pemit_source.cnt == 1) {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_GREY;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_WHITE;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_dpp_name = ad_DPP_ALTARGREY;	// floating upwards
		}
		else {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_RED;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_RED;
			ad_pe_ent.ad_dpp_name = ad_DPP_ALTARRED;		// floating upwards
		}
		ad_pe_ent.ad_part_limit = 100;			// Maximum particles
		ad_pe_ent.ad_part_life = 5;				// Long life
		ad_pe_ent.ad_part_ofs = '0 0 0';			// center of target object
		if (ad_CheckZeroVector(ad_pe_ent.ad_pemit_source.ad_part_vel)) ad_pe_ent.ad_part_vel = '0 0 12';
		ad_pe_ent.ad_part_velrand = '4 4 12';		// Slight wobble
		ad_pe_ent.ad_part_vol = '64 64 0';		// Volume (X/Y/Z)
		if (ad_pe_ent.ad_pemit_source.t_length > 0) 
			ad_pe_ent.ad_part_vol_x = ad_pe_ent.ad_pemit_source.t_length;
		if (ad_pe_ent.ad_pemit_source.t_width > 0) 
			ad_pe_ent.ad_part_vol_y = ad_pe_ent.ad_pemit_source.t_width;
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		ad_pe_ent.ad_wakeup_dist = 768;			// Close range distance
		ad_pe_ent.ad_wakeup_timer = 4;			// High timer
		ad_pe_ent.ad_spawn_base = 0.1;			// Fast Spawn rate
		ad_pe_ent.ad_spawn_rand = 0.1;			// Spawn rate randomness
	}
	//----------------------------------------------------------------------
	// DP ONLY - velocity directional smoke
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_SMOKE) {
		ad_pe_ent.ad_dpp_only = ad_TRUE;
		if (ad_pe_ent.ad_pemit_source.ad_exactskin == 0) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKEGREY1;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 1) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKEGREY2;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 2) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKEWHITE;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 3) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKETOXIC;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 4) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKEGREEN;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 5) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKEPURPLE;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 6) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKERED;
		else if (ad_pe_ent.ad_pemit_source.ad_exactskin == 7) ad_pe_ent.ad_dpp_name = ad_DPP_VELSMOKEFIRE;
		ad_pe_ent.ad_dpp_rnd = ad_pe_ent.ad_pemit_source.delay;
		ad_pe_ent.ad_dpp_wait = ad_pe_ent.ad_pemit_source.wait;
		ad_pe_ent.ad_dpp_vel = ad_pe_ent.ad_pemit_source.movedir * ad_pe_ent.ad_pemit_source.height;
	}
	//======================================================================
	// Items
	//======================================================================
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_RESPAWN) {
		ad_pe_ent.ad_start_delay = 0.1;			// Particle emitter start delay
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_YELLOW;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GREY;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_part_limit = 25;				// Variable, depends on spawn rate
		ad_pe_ent.ad_part_life = 1;				// Short life time
		ad_pe_ent.ad_part_ofs = '0 0 1';			// Custom for each item
		ad_pe_ent.ad_part_vel = '0 0 10';			// Slowly move upwards
		ad_pe_ent.ad_part_vol = '16 16 0';		// Flat base of model
		// Change the respawn size based on bbmaxs of source item
		if (ad_pe_ent.ad_pemit_source.ad_bbmaxs_x > 0) ad_pe_ent.ad_part_vol_x = ad_pe_ent.ad_pemit_source.ad_bbmaxs_x;
		if (ad_pe_ent.ad_pemit_source.ad_bbmaxs_y > 0) ad_pe_ent.ad_part_vol_y = ad_pe_ent.ad_pemit_source.ad_bbmaxs_y;
		ad_pe_ent.ad_part_velrand = '4 4 6';		// Slight wobble
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		ad_pe_ent.ad_wakeup_dist = 768;			// Mid range distance
		ad_pe_ent.ad_wakeup_timer = 1;			// Medium timer (runs all the time)
		ad_pe_ent.ad_spawn_base = 0.05;			// Fast Spawn rate
		ad_pe_ent.ad_spawn_rand = 0;				// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_RESPAWN;		// Particles floating up, starts slow
		ad_pe_ent.ad_dpp_rnd = 0;					// NO Random time multiplier
	}
	//----------------------------------------------------------------------
