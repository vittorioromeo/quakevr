	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_PSKILL) {
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_PURP;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTMED_PURP;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_PURP;
