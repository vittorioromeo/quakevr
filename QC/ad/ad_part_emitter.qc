// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/part_emitter.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// Particle EMITTER functions
//======================================================================
float(entity ad_pe_ent) ad_misc_particle_style =
{
	ad_pe_ent.ad_start_delay = 1 + (random()*2);	// Particle emitter start delay (default)
	ad_pe_ent.ad_spr_frame = 1;					// Use all sprite frames (Light/Dark)
	ad_pe_ent.ad_dpp_name = "";					// DP particle effect name
	ad_pe_ent.ad_dpp_wait = 0.1;					// Defautlt timer
	ad_pe_ent.ad_dpp_rnd = 1;						// Random time multiplier
	ad_pe_ent.ad_dpp_vel = '0 0 0';				// Velocity direction of particles
	ad_pe_ent.ad_part_movetype = ad_MOVETYPE_NOCLIP;

	//----------------------------------------------------------------------
	// Portal Gate
	//----------------------------------------------------------------------
	if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_PORTAL) {
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_GREY;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_WHITE;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_WHITE;
		ad_pe_ent.ad_spr_frame = 3;					// Dark frames
		ad_pe_ent.ad_part_limit = 100;				// High Amount of particles
		ad_pe_ent.ad_part_life = 3;					// Long life time
		ad_pe_ent.ad_part_ofs = '0 0 0';				// No change
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;

		// If the angle is up or down then it is a special case
		if (ad_pe_ent.angles_y == -1) {
			ad_pe_ent.ad_part_vel = '0 0 20';			// UP direction
			ad_pe_ent.ad_dpp_name = ad_DPP_PORTALUP;		// particles flying up
		}
		else if (ad_pe_ent.angles_y == -2) {
			ad_pe_ent.ad_part_vel = '0 0 -20';		// DOWN direction
			ad_pe_ent.ad_dpp_name = ad_DPP_PORTALDOWN;	// smoke falling down
		}
		else {
			// Setup DP portal effects volume size based on initial emitter angle
			if (ad_pe_ent.angles_y == 90 || ad_pe_ent.angles_y == 270) {
				if (!ad_pe_ent.ad_part_vol) ad_pe_ent.ad_part_vol = '32 0 48';	// Volume (X/Y/Z)
				ad_pe_ent.ad_dpp_name = ad_DPP_PORTALSIDE;
			}
			else {
				if (!ad_pe_ent.ad_part_vol) ad_pe_ent.ad_part_vol = '0 32 48';	// Volume (X/Y/Z)
				ad_pe_ent.ad_dpp_name = ad_DPP_PORTALFRONT;		// default direction
			}

			// The angle of the particle entity is using the ANGLE key
			makevectors(ad_pe_ent.angles);
			ad_pe_ent.ad_part_vel = v_forward * 20;			// Slow speed away from portal
		}

		if (!ad_pe_ent.ad_part_velrand) ad_pe_ent.ad_part_velrand = '10 10 4';	// More X/Y wobble
		if (!ad_pe_ent.ad_wakeup_dist) ad_pe_ent.ad_wakeup_dist = 768;	// Mid range distance
		ad_pe_ent.ad_wakeup_timer = 4;							// High timer (runs all the time)
		if (!ad_pe_ent.ad_spawn_base) ad_pe_ent.ad_spawn_base = 0.1;	// Fast Spawn rate
		if (!ad_pe_ent.ad_spawn_rand) ad_pe_ent.ad_spawn_rand = 0.1;	// Spawn rate randomness
		ad_pe_ent.ad_dpp_vel = normalize(ad_pe_ent.ad_part_vel);		// Particle direction
	}
	//----------------------------------------------------------------------
	// Spiral Jumppad pattern
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_JUMPPAD) {
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_GREY;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_WHITE;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_part_limit = 100;			// High Amount of particles
		ad_pe_ent.ad_part_life = 3;				// Long life time
		ad_pe_ent.ad_part_ofs = '0 0 0';			// Start below emitter origin
		ad_pe_ent.ad_part_velbase = '0 0 12';		// Always go upwards
		ad_pe_ent.ad_part_vel = '0 0 32';			// UP direction
		ad_pe_ent.ad_part_velrand = '8 8 0';		// Slight wobble
		ad_pe_ent.ad_part_vol = '24 24 0';		// Volume around circle pad
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// inside circle volume
		ad_pe_ent.ad_wakeup_dist = 1024;			// Long range distance
		ad_pe_ent.ad_wakeup_timer = 2;			// High timer (runs all the time)
		ad_pe_ent.ad_spawn_base = 0.05;			// Average Spawn rate
		ad_pe_ent.ad_spawn_rand = 0.05;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_JUMPPAD;		// streaming up
	}
	//----------------------------------------------------------------------
	// Circular floor pattern (triggered)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_FCIRCLE) {
		if (ad_pe_ent.ad_pemit_source.ad_spr_color == 2) {
			// Blue colour
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_BLUE;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_WHITE;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_BLUE;
			ad_pe_ent.ad_dpp_name = ad_DPP_BFCIRCLE;		// Circular floor pattern
		}
		else {
			// Default red/yellow colour
			ad_pe_ent.ad_spr_name1 = ad_PART_TORCH1;
			ad_pe_ent.ad_spr_name2 = ad_PART_TORCH2;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_dpp_name = ad_DPP_FCIRCLE;		// Circular floor pattern
		}
		ad_pe_ent.ad_part_limit = 64;				// High Amount of particles
		ad_pe_ent.ad_part_life = 5;				// Long life time
		ad_pe_ent.ad_part_ofs = '0 0 1';			// Slightly off floor
		ad_pe_ent.ad_part_vel = '0 0 12';			// Slowly move upwards
		ad_pe_ent.ad_part_velrand = '4 4 0';		// Slight wobble
		// Circle radius/rotation degrees
		if (ad_CheckZeroVector(ad_pe_ent.ad_pemit_source.ad_part_vol)) ad_pe_ent.ad_part_vol = '56 17 0';
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_RANDCIRCLE;
		ad_pe_ent.ad_wakeup_dist = 768;			// Mid range distance
		ad_pe_ent.ad_wakeup_timer = 0.5;			// 4x timer
		// Fast spawn rate and randomness
		if (!ad_pe_ent.ad_pemit_source.ad_spawn_base) ad_pe_ent.ad_spawn_base = 0.1;			// Fast Spawn rate
		if (!ad_pe_ent.ad_pemit_source.ad_spawn_rand) ad_pe_ent.ad_spawn_rand = 0.2;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_rnd = 0.2;				// Random time multiplier
	}
	//----------------------------------------------------------------------
	// Forcefield
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_FFIELD) {
		if (ad_pe_ent.ad_pemit_source.ad_spr_frame == ad_PARTICLE_BURST_YELLOW) {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_YELLOW;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_YELLOW;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTY;
		}
		else if (ad_pe_ent.ad_pemit_source.ad_spr_frame == ad_PARTICLE_BURST_GREEN) {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_LGREEN;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GREEN;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_GREEN;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTG;
		}
		else if (ad_pe_ent.ad_pemit_source.ad_spr_frame == ad_PARTICLE_BURST_RED) {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_GREY;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_RED;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_RED;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTR;
		}
		else if (ad_pe_ent.ad_pemit_source.ad_spr_frame == ad_PARTICLE_BURST_BLUE) {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_BLUE;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GREY;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_BLUE;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTB;
		}
		else if (ad_pe_ent.ad_pemit_source.ad_spr_frame == ad_PARTICLE_BURST_PURPLE) {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_PURP;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GREY;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_PURP;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTP;
		}
		else if (ad_pe_ent.ad_pemit_source.ad_spr_frame == ad_PARTICLE_BURST_FIRE) {
			ad_pe_ent.ad_spr_name1 = ad_PART_TORCH1;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_GREY;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTY;
		}
		else {
			ad_pe_ent.ad_spr_name1 = ad_PART_DOTSML_WHITE;
			ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GREY;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTMED_GREY;
			ad_pe_ent.ad_dpp_name = ad_DPP_FFIELDPARTW;
		}

		// reset particle sprite frame range to all
		ad_pe_ent.ad_spr_frame = 0;
		
		// Particle quantity should be low, allow customization for volume size
		if (!ad_pe_ent.ad_pemit_source.ad_part_limit) ad_pe_ent.ad_part_limit = 25;
		else ad_pe_ent.ad_part_limit = ad_pe_ent.ad_pemit_source.ad_part_limit;
		if (!ad_pe_ent.ad_pemit_source.ad_part_life) ad_pe_ent.ad_part_life = 2;
		else ad_pe_ent.ad_part_life = ad_pe_ent.ad_pemit_source.ad_part_life;
		if (!ad_pe_ent.ad_pemit_source.ad_part_ofs) ad_pe_ent.ad_part_ofs = '0 0 0';
		else ad_pe_ent.ad_part_ofs = ad_pe_ent.ad_pemit_source.ad_part_ofs;
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;
		if (!ad_pe_ent.ad_part_velrand) ad_pe_ent.ad_part_velrand = '4 4 4';
		// The volume and direction really need to be set before the
		// emitter is setup because the volume maybe switched off
		if (ad_CheckZeroVector(ad_pe_ent.ad_pemit_source.ad_part_vol)) ad_pe_ent.ad_part_vol = '8 8 8';
		else ad_pe_ent.ad_part_vol = ad_pe_ent.ad_pemit_source.ad_part_vol;
		if (ad_CheckZeroVector(ad_pe_ent.ad_pemit_source.ad_part_vel)) ad_pe_ent.ad_part_vel = '0 0 4';
		else ad_pe_ent.ad_part_vel = ad_pe_ent.ad_pemit_source.ad_part_vel;

		if (!ad_pe_ent.ad_pemit_source.ad_wakeup_dist) ad_pe_ent.ad_wakeup_dist = 768;	// Mid range distance
		ad_pe_ent.ad_wakeup_timer = 4;							// High timer (runs all the time)
		if (!ad_pe_ent.ad_pemit_source.ad_spawn_base) ad_pe_ent.ad_spawn_base = 0.05;	// Fast Spawn rate
		if (ad_pe_ent.ad_spawn_base < 0.01) ad_pe_ent.ad_spawn_base = 0.01;			// Need minimum
		if (!ad_pe_ent.ad_pemit_source.ad_spawn_rand) ad_pe_ent.ad_spawn_rand = 0.1;	// Spawn rate randomness
		ad_pe_ent.ad_dpp_vel = ad_pe_ent.ad_part_vel;
		ad_pe_ent.ad_dpp_wait = 0.01;
		ad_pe_ent.ad_dpp_rnd = 0.1;
	}

	//======================================================================
	// Book Phase 1 - closed
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_BOOK) {
		ad_pe_ent.ad_spr_name1 = ad_PART_BOOKRUNE1;
		ad_pe_ent.ad_spr_name2 = ad_PART_BOOKRUNE2;
		if (random()<0.5) ad_pe_ent.ad_spr_name3 = ad_PART_BOOKRUNE1;
		else ad_pe_ent.ad_spr_name3 = ad_PART_BOOKRUNE2;
		ad_pe_ent.ad_part_limit = 3;				// Very Low
		ad_pe_ent.ad_part_life = 7;				// Long Life
		ad_pe_ent.ad_part_ofs = '0 0 10';			// Top of Book
		ad_pe_ent.ad_part_vel = '0 0 10';			// Fly up
		ad_pe_ent.ad_part_velrand = '4 4 0';		// Slight wobble
		ad_pe_ent.ad_part_velrot = 45;			// Velocity rotation - y + random(y)
		ad_pe_ent.ad_part_vol = '1 1 0';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		ad_pe_ent.ad_wakeup_dist = 768;			// Close range distance
		ad_pe_ent.ad_wakeup_timer = 8;			// High timer
		ad_pe_ent.ad_spawn_base = 2;				// Slow (runs all the time)
		ad_pe_ent.ad_spawn_rand = 1;				// Spawn rate randomness
		if (ad_pe_ent.ad_pemit_source.style == ad_MISCBOOK_BLUE) ad_pe_ent.ad_dpp_name = ad_DPP_BOOKBLUE;
		else if (ad_pe_ent.ad_pemit_source.style == ad_MISCBOOK_RED) ad_pe_ent.ad_dpp_name = ad_DPP_BOOKRED;
		else ad_pe_ent.ad_dpp_name = ad_DPP_BOOKGOLD;
		ad_pe_ent.ad_dpp_wait = 1;				// Slow timer
		ad_pe_ent.ad_dpp_rnd = 2;					// Long pause
	}
	//----------------------------------------------------------------------
	// Book Phase 2 - open
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_OPENBOOK) {
		if (random()<0.5) ad_pe_ent.ad_spr_name1 = ad_PART_BOOKRUNE1;
		else ad_pe_ent.ad_spr_name1 = ad_PART_BOOKRUNE2;

		// Setup particle colour based on book type
		if (ad_pe_ent.ad_pemit_source.style == ad_MISCBOOK_BLUE) {
			if (random() < 0.5) ad_pe_ent.ad_spr_name2 = ad_PART_DOTMED_BLUE;
			else ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_BLUE;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_WHITE;
			ad_pe_ent.ad_dpp_name = ad_DPP_OPENBOOKBLUE;
		}
		else if (ad_pe_ent.ad_pemit_source.style == ad_MISCBOOK_RED) {
			if (random() < 0.5) ad_pe_ent.ad_spr_name2 = ad_PART_DOTMED_RED;
			else ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_RED;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_dpp_name = ad_DPP_OPENBOOKRED;
		}
		else {
			if (random() < 0.5) ad_pe_ent.ad_spr_name2 = ad_PART_DOTMED_YELLOW;
			else ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_YELLOW;
			ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GOLD;
			ad_pe_ent.ad_dpp_name = ad_DPP_OPENBOOKGOLD;
		}
		ad_pe_ent.ad_part_limit = 30;				// Average
		ad_pe_ent.ad_part_life = 7;				// Long Life
		ad_pe_ent.ad_part_ofs = '0 0 4';			// Pages of Book
		ad_pe_ent.ad_part_vel = '0 0 10';			// Fly up
		ad_pe_ent.ad_part_velrand = '4 4 0';		// Slight wobble
		ad_pe_ent.ad_part_velrot = 45;			// Velocity rotation - y + random(y)
		ad_pe_ent.ad_part_vol = '8 8 0';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		ad_pe_ent.ad_wakeup_dist = 768;			// Close range distance
		ad_pe_ent.ad_wakeup_timer = 4;			// High timer
		ad_pe_ent.ad_spawn_base = 0.1;			// Fast (particles)
		ad_pe_ent.ad_spawn_rand = 0.3;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_wait = 0.5;				// Fast timer
		ad_pe_ent.ad_dpp_rnd = 2;					// Long pause
	}
	//======================================================================
	// Electric Beam Particle Stream (code triggered)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_ELECTRIC) {
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_BLUE;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_BLUE;
		ad_pe_ent.ad_part_limit = 100;			// Maximum particles
		ad_pe_ent.ad_part_life = 1;				// Short Lifetime
		ad_pe_ent.ad_part_ofs = '0 0 0';			// center of target object
		ad_pe_ent.ad_part_vel = '50 0 0';			// Speed of particles
		ad_pe_ent.ad_part_velrand = '0 0 16';		// Vertical wobble
		ad_pe_ent.ad_part_vol = '8 8 8';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		ad_pe_ent.ad_wakeup_dist = 768;			// Long range distance
		ad_pe_ent.ad_wakeup_timer = 0.2;			// Small change on distance timer
		ad_pe_ent.ad_spawn_base = 0.01;			// Fast Spawn rate
		ad_pe_ent.ad_spawn_rand = 0;				// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_ELECTRIC;		// directional particle stream
		ad_pe_ent.ad_dpp_rnd = 0;					// NO Random time multiplier
	}
	//----------------------------------------------------------------------
	// Torches Flames (slow start)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_FLAMET) {
		ad_pe_ent.ad_start_delay = 3 + (random()*8);
		ad_pe_ent.ad_spr_name1 = ad_PART_TORCH1;		// Embers - Red/Yellow
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GREY;
		ad_pe_ent.ad_part_limit = 8;				// Minimal amount of particles
		ad_pe_ent.ad_part_life = 2;				// Short Life
		ad_pe_ent.ad_part_ofs = '0 0 12';			// Top of wood
		ad_pe_ent.ad_part_vel = '0 0 10';			// Fly up
		ad_pe_ent.ad_part_velrand = '4 4 0';		// Slight wobble
		ad_pe_ent.ad_part_vol = '1 1 0';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		if (ad_pe_ent.ad_pemit_source.ad_wakeup_dist < 1) ad_pe_ent.ad_wakeup_dist = 384;
		else ad_pe_ent.ad_wakeup_dist = ad_pe_ent.ad_pemit_source.ad_wakeup_dist;
		if (ad_pe_ent.ad_pemit_source.ad_wakeup_timer < 1) ad_pe_ent.ad_wakeup_timer = 8;
		else ad_pe_ent.ad_wakeup_timer = ad_pe_ent.ad_pemit_source.ad_wakeup_timer;
		ad_pe_ent.ad_spawn_base = 0.25;			// Spawn rate base (runs all the time)
		ad_pe_ent.ad_spawn_rand = 0.25;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_FLAMET;		// smoke and particles floating up
		ad_pe_ent.ad_dpp_wait = 1;				// Slow timer
	}
	//----------------------------------------------------------------------
	// Small Flames (slow start)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_FLAMES) {
		ad_pe_ent.ad_start_delay = 3 + (random()*8);
		ad_pe_ent.ad_spr_name1 = ad_PART_TORCH1;		// Embers - Red/Yellow
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GREY;
		ad_pe_ent.ad_part_limit = 8;				// Minimal amount of particles
		ad_pe_ent.ad_part_life = 2;				// Short Life
		ad_pe_ent.ad_part_ofs = '0 0 0';			// Bottom of flame
		ad_pe_ent.ad_part_vel = '0 0 10';			// Fly up
		ad_pe_ent.ad_part_velrand = '4 4 0';		// Slight wobble
		ad_pe_ent.ad_part_vol = '1 1 0';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		if (ad_pe_ent.ad_pemit_source.ad_wakeup_dist < 1) ad_pe_ent.ad_wakeup_dist = 384;
		else ad_pe_ent.ad_wakeup_dist = ad_pe_ent.ad_pemit_source.ad_wakeup_dist;
		if (ad_pe_ent.ad_pemit_source.ad_wakeup_timer < 1) ad_pe_ent.ad_wakeup_timer = 6;
		else ad_pe_ent.ad_wakeup_timer = ad_pe_ent.ad_pemit_source.ad_wakeup_timer;
		ad_pe_ent.ad_spawn_base = 0.25;			// Spawn rate base (runs all the time)
		ad_pe_ent.ad_spawn_rand = 0.25;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_FLAMES;		// smoke and particles floating up
		ad_pe_ent.ad_dpp_wait = 1;				// Slow timer
	}
	//----------------------------------------------------------------------
	// Large Flames (high particle count)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_FLAMEL) {
		ad_pe_ent.ad_spr_name1 = ad_PART_TORCH1;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_GREY;
		ad_pe_ent.ad_part_limit = 100;			// Large amount of active particles
		if (ad_pe_ent.ad_pemit_source.ad_part_life < 1) ad_pe_ent.ad_part_life = 8;
		else ad_pe_ent.ad_part_life = ad_pe_ent.ad_pemit_source.ad_part_life;
		ad_pe_ent.ad_part_ofs = '0 0 0';			// Bottom of flame
		ad_pe_ent.ad_part_vel = '0 0 12';			// Fly up
		ad_pe_ent.ad_part_velrand = '4 4 0';		// Slight wobble
		ad_pe_ent.ad_part_vol = '4 4 0';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		if (ad_pe_ent.ad_pemit_source.ad_wakeup_dist < 1) ad_pe_ent.ad_wakeup_dist = 768;
		else ad_pe_ent.ad_wakeup_dist = ad_pe_ent.ad_pemit_source.ad_wakeup_dist;
		if (ad_pe_ent.ad_pemit_source.ad_wakeup_timer < 1) ad_pe_ent.ad_wakeup_timer = 1;
		else ad_pe_ent.ad_wakeup_timer = ad_pe_ent.ad_pemit_source.ad_wakeup_timer;
		ad_pe_ent.ad_spawn_base = 0.05;			// Frequent (runs all the time)
		ad_pe_ent.ad_spawn_rand = 0.1;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_FLAMEL;		// smoke and particles floating up
	}
	//----------------------------------------------------------------------
	// Skill Particle Stream (Designed for 4 sides of pillar)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_SKILL) {
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_RED;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GOLD;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_RED;
		ad_pe_ent.ad_part_limit = 35;				// Maximum particles
		ad_pe_ent.ad_part_life = 2;				// Long life
		ad_pe_ent.ad_part_ofs = '0 0 0';			// center of target object
		// The angle of the particle entity is using the ANGLE key
		makevectors(ad_pe_ent.ad_pemit_source.angles);
		ad_pe_ent.ad_part_vel = v_forward * 10;	// Slow speed away from skill column
		ad_pe_ent.ad_part_vol = '4 4 4';			// Volume (X/Y/Z)
		ad_pe_ent.ad_part_velrand = '4 4 8';		// Volume wobble
		ad_pe_ent.ad_part_veltype = ad_PARTICLE_ORIGIN_VOL;	// Inside volume
		ad_pe_ent.ad_wakeup_dist = 768;			// Long range distance
		ad_pe_ent.ad_wakeup_timer = 1;			// Small change on distance timer
		ad_pe_ent.ad_spawn_base = 0.01;			// Fast Spawn rate
		ad_pe_ent.ad_spawn_rand = 0.2;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_SKILLPILLAR;	// Directional particle stream
		ad_pe_ent.ad_dpp_rnd = 0;					// NO Random time multiplier
		ad_pe_ent.ad_dpp_vel = normalize(v_forward);	// Particle direction
	}
	//----------------------------------------------------------------------
	// Skill Particle Stream (Designed for Silver Key Doors)
	//----------------------------------------------------------------------
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_BSKILL) {
		ad_pe_ent.ad_spr_name1 = ad_PART_DOTMED_BLUE;
		ad_pe_ent.ad_spr_name2 = ad_PART_DOTSML_GREY;
		ad_pe_ent.ad_spr_name3 = ad_PART_DOTSML_BLUE;
		ad_pe_ent.ad_part_limit = 35;				// Maximum particles
