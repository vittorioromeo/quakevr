		ad_pe_ent.ad_wakeup_timer = 1;			// Medium timer (runs all the time)
		ad_pe_ent.ad_spawn_base = 0.1;			// Fast Spawn rate
		ad_pe_ent.ad_spawn_rand = 0.1;			// Spawn rate randomness
		ad_pe_ent.ad_dpp_name = ad_DPP_JBOOTS;		// White/Gold particles from center
	}
	//======================================================================
	// Weather System
	//======================================================================
	else if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_WEATHER) {
		ad_pe_ent.ad_part_limit = ad_pe_ent.ad_pemit_source.count;
		ad_pe_ent.ad_part_vel = '0 0 0';
		ad_pe_ent.ad_part_vel_z = ad_pe_ent.ad_pemit_source.speed;
		ad_pe_ent.ad_part_velrand = ad_pe_ent.ad_pemit_source.v_angle;
		ad_pe_ent.ad_wakeup_dist = ad_pe_ent.ad_pemit_source.ad_wakeup_dist;
		ad_pe_ent.ad_wakeup_timer = ad_pe_ent.ad_pemit_source.ad_wakeup_timer;
		ad_pe_ent.ad_spawn_base = 0.1;			// Default timer
		ad_pe_ent.ad_spawn_rand = 0;				// No spawn rate randomness
	}
	//----------------------------------------------------------------------
	// No style defined - ERROR!!!!!
	//----------------------------------------------------------------------
	else {
		dprint("\b[PEMITTER]\b Style no ("); dprint(ftos(ad_pe_ent.ad_part_style));
		dprint(") not valid!\n");
		ad_pe_ent.ad_part_style = ad_PARTICLE_STYLE_EMPTY;	// empty definition
		ad_spawn_marker(ad_pe_ent.origin, ad_SPNMARK_YELLOW);// Visual problem
	}
	
	// return any error conditions; 0=ERROR
	return ad_pe_ent.ad_part_style;
};

//----------------------------------------------------------------------
void(entity ad_pe_ent) ad_misc_particle_off =
{	
	// Double check dealing with a particle emitter?
	if (ad_pe_ent.ad_classtype != ad_CT_PARTICLEEMIT) return;
	if (ad_pe_ent.state == ad_STATE_OFF) return;
	// The particle emitter is still being setup, remember state for later
	if (ad_pe_ent.state == ad_STATE_SETUP) {
		ad_pe_ent.spawnflags = ad_PARTICLE_START_OFF;
		return;
	}

	ad_pe_ent.state = ad_STATE_OFF;
	ad_pe_ent.ad_estate = ad_ESTATE_OFF;
	// Setup a particle explosion on floor circles when they are triggered off
	if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_FCIRCLE) {
		ad_particle_ring(ad_pe_ent.origin, '0 0 4', '4 4 16', ad_pe_ent.ad_part_vol_x+8, ad_pe_ent.ad_part_limit, ad_pe_ent.ad_part_life, 4 ); 
		ad_particle_ring(ad_pe_ent.origin, '0 0 4', '0 0 12', ad_pe_ent.ad_part_vol_x-4, ad_pe_ent.ad_part_limit, ad_pe_ent.ad_part_life, 1 ); 
	}		
};

//----------------------------------------------------------------------
void() ad_misc_particle_use =
{	
	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;
	// If particle still not setup toggle spawnflags instead
	if (self.state == ad_STATE_SETUP) {
		if (self.spawnflags & ad_PARTICLE_START_ON) self.spawnflags = ad_PARTICLE_START_OFF;
		else self.spawnflags = ad_PARTICLE_START_ON;
		return;
	}
	
	// Double check for particle style setup correctly
	if (self.ad_part_style == ad_PARTICLE_STYLE_EMPTY) return;

	// Toggle shooter on/off
	if (self.state == ad_STATE_OFF) {
		self.state = ad_STATE_ON;
		self.ad_estate = ad_ESTATE_ON;

		// Is DP particles active?
		if ((ad_ext_dppart || self.ad_dpp_only) && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE
			&& world.ad_sprite_particles == ad_FALSE) {
			// decide between particle types
			if (self.ad_part_style == ad_PARTICLE_STYLE_FCIRCLE) ad_emitdpp_fcircle();
			else if (self.ad_part_style == ad_PARTICLE_STYLE_WEATHER) {
				// Check if particle effects are available from the engine
				if (!ad_ext_dpsnow || !ad_ext_dprain) return;
				ad_emitepp_weather();
			}
			else ad_emitdpp_particle();
		}
		// Pixel goodness particles
		else {
			// Weather effects not supported on Fitz/QS engines
			if (self.ad_part_style == ad_PARTICLE_STYLE_WEATHER) return;
			else ad_emit_particle();
		}
	}
	else {
		ad_spawn_arrow(self.origin,'-90 0 0',0);
		ad_misc_particle_off(self);
	}
};

//----------------------------------------------------------------------
void(entity ad_pe_ent) ad_misc_particle_on =
{	
	// Double check dealing with a particle emitter?
	if (ad_pe_ent.ad_classtype != ad_CT_PARTICLEEMIT) return;
	if (ad_pe_ent.state == ad_STATE_ON) return;
	// The particle emitter is still being setup, remember state for later
	if (ad_pe_ent.state == ad_STATE_SETUP) {
		ad_pe_ent.spawnflags = ad_PARTICLE_START_ON;
		return;
	}

	ad_pe_ent.state = ad_STATE_OFF;
	ad_pe_ent.think = ad_misc_particle_use;
	ad_pe_ent.nextthink = time + ad_TIME_MINTICK;
};

//----------------------------------------------------------------------
void(entity ad_pe_ent, float ad_partemit_style) ad_misc_particle_update =
{
	// Double check dealing with a particle emitter?
	if (ad_pe_ent.ad_classtype != ad_CT_PARTICLEEMIT) return;
	if (ad_pe_ent.state == ad_STATE_SETUP) return;
	if (ad_pe_ent.ad_part_style == ad_PARTICLE_STYLE_EMPTY) return;

	ad_pe_ent.ad_part_style = ad_partemit_style;
	if (ad_misc_particle_style(ad_pe_ent) == ad_FALSE) 
		dprint("\b[MISC_PARTICLE]\b Error updating emitter!");
};

//----------------------------------------------------------------------
void() ad_misc_particle_switch_on = { ad_misc_particle_on(self); };
void() ad_misc_particle_switch_off = { ad_misc_particle_off(self); };
void() ad_misc_particle_switch_disable = { self.state = ad_STATE_OFF; };

//----------------------------------------------------------------------
void() ad_misc_particle_finishsetup =
{
	// Was the particle emitter setup correctly?
	if (self.ad_part_style != ad_PARTICLE_STYLE_EMPTY) {
		self.ad_circular_angle = 0;		// Starting circular angle
		self.state = ad_STATE_OFF;			// Initial state
		self.ad_estate = ad_ESTATE_OFF;
		
		// Setup entity state wrapper if targetname exists
		if (self.targetname != "") self.use = ad_entity_state_use;
		else self.use = ad_misc_particle_use;
		self.ad_estate_on = ad_misc_particle_switch_on;
		self.ad_estate_off = ad_misc_particle_switch_off;
		self.ad_estate_disable = ad_misc_particle_switch_disable;
		self.ad_estate_use = ad_misc_particle_use;
		
		// Delay start of particle emitter so if it needs to be switched off
		// other functions can catch it and save switching states quickly
		if (self.spawnflags & ad_PARTICLE_START_ON) ad_misc_particle_use();
	} 
};

//----------------------------------------------------------------------
void() ad_misc_particle_delay =
{
	// If target setup, find it and store entity
	if (self.target != "") self.ad_pemit_target = find(world, targetname, self.target);
	if (!self.ad_pemit_target) self.target = "";
	
	if (!self.ad_start_delay) self.ad_start_delay = 1 + (random()*2);
	self.nextthink = time + self.ad_start_delay;
	self.think = ad_misc_particle_finishsetup;
};

//----------------------------------------------------------------------
void() ad_misc_particletemplate = { 
	self.ad_classtype = ad_CT_PARTICLETEMP; 
	// make sure any sprite assets used are pre-cached ready
	if (self.ad_spr_name1 != "") precache_model(self.ad_spr_name1);
	if (self.ad_spr_name2 != "") precache_model(self.ad_spr_name2);
	if (self.ad_spr_name3 != "") precache_model(self.ad_spr_name3);
};

//----------------------------------------------------------------------
void() ad_misc_particle_copytemplate = 
{
	local entity ad_fdest;

	// Cycle through list for TARGET2 template
	ad_fdest = find (world, targetname, self.ad_target2);
	while(ad_fdest) {
		if (ad_fdest.ad_classtype == ad_CT_PARTICLETEMP) {
			self.owner = ad_fdest;
			ad_fdest = world;
		}
		else ad_fdest = find(ad_fdest, targetname, self.ad_target2);
	}

	// Is the particle template missing?
	if (!self.owner) {
		dprint("\b[MISC_PARTICLE]\b Missing target template!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}
	
	// Custom particle setup defined in map
	self.ad_part_style = ad_PARTICLE_STYLE_CUSTOM;
	
	// Copy over all the DEFINED data from the template
	// Fill in any gaps with default data (based on quad)
	if (self.owner.ad_spr_name1) self.ad_spr_name1 = self.owner.ad_spr_name1;
	else self.ad_spr_name1 = ad_PART_DOTMED_BLUE;
	if (self.owner.ad_spr_name2) self.ad_spr_name2 = self.owner.ad_spr_name2;
	else self.ad_spr_name2 = ad_PART_DOTSML_WHITE;
	if (self.owner.ad_spr_name3) self.ad_spr_name3 = self.owner.ad_spr_name3;
	else self.ad_spr_name3 = ad_PART_DOTSML_BLUE;

	// Particle quantity, life, direction, rotation and volume
	if (self.owner.ad_part_movetype) self.ad_part_movetype = self.owner.ad_part_movetype;
	else self.ad_part_movetype = ad_MOVETYPE_NOCLIP;
	if (self.owner.ad_part_limit) self.ad_part_limit = self.owner.ad_part_limit;
	else self.ad_part_limit = 25;
	if (self.owner.ad_part_life) self.ad_part_life = self.owner.ad_part_life;
	else self.ad_part_life = 1;
	if (self.owner.ad_part_ofs) self.ad_part_ofs = self.owner.ad_part_ofs;
	else self.ad_part_ofs = '0 0 0';
	if (self.owner.ad_part_veltype) self.ad_part_veltype = self.owner.ad_part_veltype;
	else self.ad_part_veltype = ad_PARTICLE_ORIGIN_CENTER;
	if (self.owner.ad_part_vel) self.ad_part_vel = self.owner.ad_part_vel;
	if (self.owner.ad_part_velbase) self.ad_part_velbase = self.owner.ad_part_velbase;
	if (self.owner.ad_part_velrand) self.ad_part_velrand = self.owner.ad_part_velrand;
	if (self.owner.ad_part_velrot) self.ad_part_velrot = self.owner.ad_part_velrot;
	if (self.owner.ad_part_vol) self.ad_part_vol = self.owner.ad_part_vol;

	// Particle spawn timing and wakeup distance
	if (self.owner.ad_wakeup_dist) self.ad_wakeup_dist = self.owner.ad_wakeup_dist;
	else self.ad_wakeup_dist = 1024;
	if (self.owner.ad_wakeup_timer) self.ad_wakeup_timer = self.owner.ad_wakeup_timer;
	else self.ad_wakeup_timer = 1;
	if (self.ad_wakeup_timer < ad_TIME_MINTICK) self.ad_wakeup_timer = ad_TIME_MINTICK;
	if (self.owner.ad_spawn_base) self.ad_spawn_base = self.owner.ad_spawn_base;
	else self.ad_spawn_base = 0.1;
	if (self.ad_spawn_base < ad_TIME_MINTICK) self.ad_spawn_base = ad_TIME_MINTICK;
	if (self.owner.ad_spawn_rand) self.ad_spawn_rand = self.owner.ad_spawn_rand;
	else self.ad_spawn_rand = 0;

	// Particle setup for DarkPlaces
	if (self.owner.ad_dpp_name) self.ad_dpp_name = self.owner.ad_dpp_name;
	else self.ad_dpp_name = "";
	if (self.owner.ad_dpp_wait) self.ad_dpp_wait = self.owner.ad_dpp_wait;
	else self.ad_dpp_wait = 0.1;
	if (self.ad_dpp_wait < ad_TIME_MINTICK) self.ad_dpp_wait = ad_TIME_MINTICK;
	if (self.owner.ad_dpp_rnd) self.ad_dpp_rnd = self.owner.ad_dpp_rnd;
	else self.ad_dpp_rnd = 0;
	if (self.owner.ad_dpp_vel) self.ad_dpp_vel = self.owner.ad_dpp_vel;
	else self.ad_dpp_vel = '0 0 0';

	// Setup particle states
	ad_misc_particle_delay();
};

//----------------------------------------------------------------------
void() ad_misc_particle_setup =
{
	// Setup Particle styles (pre-defined)
	if (ad_misc_particle_style(self) != ad_PARTICLE_STYLE_EMPTY) 
		ad_misc_particle_delay();
};

//----------------------------------------------------------------------
// Entry point for code to spawn particle emitter
// source - starting point for particles
// target - destination (can be self/world to spawn at origin)
// style - type of particle to create (check styles above)
// spawnf - spawnflag values (startoff)
//----------------------------------------------------------------------
entity(entity ad_pe_source, entity ad_pe_target, float ad_pe_style, float ad_pe_spawnf) ad_spawn_pemitter =
{
	local entity ad_new_pe;
	
	ad_new_pe = spawn();
	ad_new_pe.ad_classtype = ad_CT_PARTICLEEMIT;
	ad_new_pe.state = ad_STATE_SETUP;
	ad_new_pe.ad_pemit_source = ad_pe_source;
	
	// source <> target, then take source target
	if (ad_pe_source != ad_pe_target) ad_new_pe.ad_pemit_target = ad_pe_target;
	
	// Setup a random number on source entity for linking
	// If the source entity is deleted this number will change
	ad_gen_unique_no(ad_pe_source);
	ad_new_pe.ad_entno_unique = ad_pe_source.ad_entno_unique;

	// Check for bmodel origin first
	if (ad_pe_source.ad_bsporigin) ad_new_pe.origin = ad_bmodel_origin(ad_pe_source);
	else ad_new_pe.origin = ad_pe_source.origin;
	
	// Copy over any source static flags
	if (ad_pe_source.ad_part_static == ad_TRUE) {
		ad_new_pe.ad_part_static = ad_pe_source.ad_part_static;
		ad_new_pe.ad_pemit_source = ad_new_pe;
		ad_new_pe.ad_pemit_target = world;
	}
	
	// Move Particle emitter to source origin
	setorigin(ad_new_pe, ad_new_pe.origin);
	ad_new_pe.ad_part_style = ad_pe_style;		// must use global defs
	ad_new_pe.spawnflags = ad_pe_spawnf;		// spawnflags are parameters
	ad_new_pe.angles = ad_pe_source.angles;	// Copy over any angle params
	
	// Back through emitter function
	ad_new_pe.think = ad_misc_particle_setup;
	ad_new_pe.nextthink = time + 0.1 + random();
	
	return ad_new_pe;
};

//----------------------------------------------------------------------
void() ad_misc_particle =
{
	if (self.spawnflags & ad_ENT_STARTOFF) self.spawnflags = ad_PARTICLE_START_OFF;
	else self.spawnflags = ad_PARTICLE_START_ON;
	
	// Default setup for any particle emitter
	self.ad_classtype = ad_CT_PARTICLEEMIT;
	self.ad_pemit_source = self;
	ad_gen_unique_no(self);
	self.state = ad_STATE_SETUP;
	// Let state of particle emitter change before finishing setup
	if (self.targetname != "") self.use = ad_misc_particle_use;
	
	// Custom particle setup using template?
	if (self.ad_target2 != "") { 
		self.nextthink = time + 0.1 + random();
		self.think = ad_misc_particle_copytemplate;
		return; 
	}

	// Setup any pre-defined particle types
	if (self.message == "ARMOR1") { self.ad_part_style = ad_PARTICLE_STYLE_ARMOR; self.items = ad_IT_ARMOR1; }
	else if (self.message == "ARMOR2") { self.ad_part_style = ad_PARTICLE_STYLE_ARMOR; self.items = ad_IT_ARMOR2; }
	else if (self.message == "ARMOR3") { self.ad_part_style = ad_PARTICLE_STYLE_ARMOR; self.items = ad_IT_ARMOR3; }

	else if (self.message == "BOOK") self.ad_part_style = ad_PARTICLE_STYLE_BOOK;
	else if (self.message == "ELECTRIC") self.ad_part_style = ad_PARTICLE_STYLE_ELECTRIC;
	else if (self.message == "FCIRCLE") self.ad_part_style = ad_PARTICLE_STYLE_FCIRCLE;
	else if (self.message == "FLAMES") self.ad_part_style = ad_PARTICLE_STYLE_FLAMES;
	else if (self.message == "FLAMEL") self.ad_part_style = ad_PARTICLE_STYLE_FLAMEL;
	
	else if (self.message == "KEYGOLD") self.ad_part_style = ad_PARTICLE_STYLE_KEYGOLD;
	else if (self.message == "KEYSILVER") self.ad_part_style = ad_PARTICLE_STYLE_KEYSILVER;
	else if (self.message == "KEYRED") self.ad_part_style = ad_PARTICLE_STYLE_KEYRED;
	else if (self.message == "KEYGREEN") self.ad_part_style = ad_PARTICLE_STYLE_KEYGREEN;
	else if (self.message == "KEYPURPLE") self.ad_part_style = ad_PARTICLE_STYLE_KEYPURPLE;
	else if (self.message == "KEYWHITE") self.ad_part_style = ad_PARTICLE_STYLE_KEYWHITE;
	else if (self.message == "MEGAH") self.ad_part_style = ad_PARTICLE_STYLE_MEGAH;
	else if (self.message == "PENT") self.ad_part_style = ad_PARTICLE_STYLE_PENT;
	else if (self.message == "PORTAL") self.ad_part_style = ad_PARTICLE_STYLE_PORTAL;

	else if (self.message == "JUMPPAD") self.ad_part_style = ad_PARTICLE_STYLE_JUMPPAD;
	else if (self.message == "QUAD") self.ad_part_style = ad_PARTICLE_STYLE_QUAD;
	
	else if (self.message == "SIGIL") self.ad_part_style = ad_PARTICLE_STYLE_SIGIL;
	else if (self.message == "ALTAR") self.ad_part_style = ad_PARTICLE_STYLE_ALTAR;
	else if (self.message == "SKILL") self.ad_part_style = ad_PARTICLE_STYLE_SKILL;
	else if (self.message == "BSKILL") self.ad_part_style = ad_PARTICLE_STYLE_BSKILL;
	else if (self.message == "GSKILL") self.ad_part_style = ad_PARTICLE_STYLE_GSKILL;
	else if (self.message == "PSKILL") self.ad_part_style = ad_PARTICLE_STYLE_PSKILL;
	else if (self.message == "SRING") self.ad_part_style = ad_PARTICLE_STYLE_SRING;
	else if (self.message == "SUIT") self.ad_part_style = ad_PARTICLE_STYLE_SUIT;
	else {
		dprint("\b[MISC_PARTICLE]\b Missing particle style!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}
	
	// Back through emitter function
	self.nextthink = time + 0.1 + random();
	self.think = ad_misc_particle_setup;
};

//----------------------------------------------------------------------
void() ad_misc_particle_burst_use =
{
	ad_particle_explode(self.origin+self.ad_part_ofs, self.count, self.ad_part_life, self.ad_part_style, self.ad_part_movetype);
	// Check for temporary continuous mode
	if (self.waitmin > 0) {
		if (self.ad_pausetime == 0) {
			if (!self.ad_waitmin2) self.ad_waitmin2 = 0.1;
			self.ad_pausetime = time + self.waitmin;
		}
		if (self.ad_pausetime > time) {
			self.think = ad_misc_particle_burst_use;
			self.nextthink = time + self.ad_waitmin2;
		}
		else self.ad_pausetime = 0;
	}
};

//----------------------------------------------------------------------
// This is also used by item_custom in items.qc
//----------------------------------------------------------------------
void() ad_misc_particle_burst_setup =
{
	// Read tcount from entity, but it cannot be used for constant emitters
	// The finish particle system will decrease the tcount directly!
	if (!self.ad_pemit_tcount) self.count = 20;
	
	if (!self.ad_part_life) self.ad_part_life = 2;
	if (ad_CheckZeroVector(self.ad_part_ofs)) self.ad_part_ofs = '0 0 0';

	if (self.ad_part_style == 1) self.ad_part_style = ad_PARTICLE_BURST_YELLOW;
	else if (self.ad_part_style == 2) self.ad_part_style = ad_PARTICLE_BURST_GREEN;
	else if (self.ad_part_style == 3) self.ad_part_style = ad_PARTICLE_BURST_RED;
	else if (self.ad_part_style == 4) self.ad_part_style = ad_PARTICLE_BURST_BLUE;
	else if (self.ad_part_style == 5) self.ad_part_style = ad_PARTICLE_BURST_PURPLE;
	else if (self.ad_part_style == 6) self.ad_part_style = ad_PARTICLE_BURST_FIRE;
	else self.ad_part_style = ad_PARTICLE_BURST_WHITE;
	
	if (self.ad_part_movetype == 3) self.ad_part_movetype = ad_PARTICLE_BURST_UPWARD;
	else if (self.ad_part_movetype == 4) self.ad_part_movetype = ad_PARTICLE_BURST_SHOCKWAVE;
	else if (self.ad_part_movetype == 5) self.ad_part_movetype = ad_PARTICLE_BURST_SKULLUP;
	else if (self.ad_part_movetype == 6) self.ad_part_movetype = ad_PARTICLE_BURST_LOSTUP;
	else if (self.ad_part_movetype == 7) self.ad_part_movetype = ad_PARTICLE_BURST_MINOTAUR;
	else self.ad_part_movetype = ad_PARTICLE_BURST_CENTER;
};

//----------------------------------------------------------------------
void() ad_misc_particle_burst =
{
	// Default setup for any particle emitter
	self.ad_classtype = ad_CT_PARTICLEEMIT;
	self.ad_pemit_source = self;
	self.health = ad_LARGE_TIMER;
	
	ad_misc_particle_burst_setup();
	self.use = ad_misc_particle_burst_use;
};

//----------------------------------------------------------------------
void() ad_misc_weather =
{
	// Setup particle emitter to start on/off
	if (self.spawnflags & ad_ENT_STARTOFF) 
		self.spawnflags = self.spawnflags | ad_PARTICLE_START_OFF;
	else self.spawnflags = self.spawnflags | ad_PARTICLE_START_ON;
	
	// Default setup for any particle emitter
	self.ad_classtype = ad_CT_PARTICLEEMIT;
	self.ad_part_style = ad_PARTICLE_STYLE_WEATHER;
	self.ad_pemit_source = self;
	ad_gen_unique_no(self);
	self.state = ad_STATE_SETUP;
	
	// Find out size of volume brush
	ad_InitTrigger();
	// Save the brush bounding box for later
	self.ad_bbmins = self.mins;
	self.ad_bbmaxs = self.maxs;
	self.oldorigin = ad_bmodel_origin(self);
	ad_spawn_marker(self.oldorigin,0);
	
	// hide volume, no longer needed
	self.solid = ad_SOLID_NOT;
		
	// Setup default particle count based on volume
	// - 10% of the volume size as particle count
	if (!self.count) 
		self.count = rint((vlen(self.ad_bbmaxs - self.ad_bbmins)*0.1));
	
	// Change for variable wind change
	if (!self.speed) self.speed = 30;
	self.ad_attack_speed = time + self.speed + (random()*self.speed);
	
	// Setup default wind (X/Y) and vertical velocity
	if (self.spawnflags & ad_PARTICLE_WEATHER_SNOW) {
		if (ad_CheckZeroVector(self.pos1)) self.pos1 = '8 15 0'; // Mostly white
		if (ad_CheckZeroVector(self.pos2)) self.pos2 = '100 100 -100';
	}
	else {
		if (ad_CheckZeroVector(self.pos1)) self.pos1 = '1 15 0'; // grey->white
		if (ad_CheckZeroVector(self.pos2)) self.pos2 = '100 100 -500';
	}

	// Particle colour range - Make sure Y > X
	if (self.pos1_x > self.pos1_y) {
		self.pos1_z = self.pos1_x;
		self.pos1_x = self.pos1_y;
		self.pos1_y = self.pos1_z;
	}
	// Work out range of colour
	self.pos1_z = rint(self.pos1_y - self.pos1_x);
	if (self.pos1_z < 1) self.pos1_z = 1;
	
	// Create initial wind direction
	self.ad_pos3_x = ad_crandom() * self.pos2_x;
	self.ad_pos3_y = ad_crandom() * self.pos2_y;
	self.ad_pos3_z = self.pos2_z;
	
	// Back through emitter function
	self.nextthink = time + 0.1 + random();
	self.think = ad_misc_particle_setup;
};

/*======================================================================
 Quake only supports a fixed amount of projectile particle trails
 The Model flag is usually how to set blood/fire/slime/magic colours.
 This function was originally designed for blue plasma effects,
 but like all things, its outgrown that and become general purpose.
 Can have custom colours, timings and secondary functionality
 All the variables for this function are defined in part_manage.qc
======================================================================*/
void(entity ad_targ) ad_HazardProjectile_Finished;

//----------------------------------------------------------------------
void(entity ad_targ) ad_Default_ParticleTrail =
{
	// Setup particle emitter defaults
	if (ad_targ.ad_part_chance <= 0) ad_targ.ad_part_chance = 0.2;
	if (ad_CheckZeroVector(ad_targ.ad_part_ofs)) ad_targ.ad_part_ofs = '0 0 2';
	if (ad_targ.ad_part_base <= 0) ad_targ.ad_part_base = 1;
	if (ad_targ.ad_part_rand <= 0) ad_targ.ad_part_rand = 1;
	if (ad_targ.ad_part_life <= 0) ad_targ.ad_part_life = 2;
	
	// Setup default - Yellow
	if (ad_targ.ad_part_trstyle <= 0) ad_targ.ad_part_trstyle = ad_PARTICLE_TRAIL_YELLOW;
	else if (ad_targ.ad_poisonous) ad_targ.ad_part_trstyle = ad_PARTICLE_TRAIL_POISON;

	if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_YELLOW) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_YELLOW;
		ad_targ.ad_dpp_name = ad_DPP_TRAILPARTY;
		ad_targ.ad_part_qccol1 = 104;	// Skin/Yellow (96+8)
		ad_targ.ad_part_qccol2 = 198; // Bright Yellow (192+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_GREEN) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_GREEN;
		ad_targ.ad_dpp_name = ad_DPP_TRAILPARTG;
		ad_targ.ad_part_qccol1 = 56; // Swampy green (48+8)
		ad_targ.ad_part_qccol2 = 182; // Light green (176+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_RED) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_RED;
		ad_targ.ad_dpp_name = ad_DPP_TRAILPARTR;
		ad_targ.ad_part_qccol1 = 72; // Dark red (64+8)
		ad_targ.ad_part_qccol2 = 230; // Light red (224+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_BLUE) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_BLUE;
		ad_targ.ad_dpp_name = ad_DPP_TRAILPARTB;
		ad_targ.ad_part_qccol1 = 40; // Silver (32+8)
		ad_targ.ad_part_qccol2 = 214;	// Dark blue (208+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_PURPLE) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_PURPLE;
		ad_targ.ad_dpp_name = ad_DPP_TRAILPARTP;
		ad_targ.ad_part_qccol1 = 136; // Mauve (128+8)
		ad_targ.ad_part_qccol2 = 150; // Purple (144+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_FIRE) {
		// Fire trail is not really supported
		ad_targ.ad_part_style = ad_PARTICLE_BURST_RED;
		ad_targ.ad_dpp_name = "TR_ROCKET";
		ad_targ.ad_part_qccol1 = 70; // Light red (64+6)
		ad_targ.ad_part_qccol2 = 104;	// Skin/Yellow (96+8)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_WHITE) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_WHITE;
		ad_targ.ad_dpp_name = ad_DPP_TRAILPARTW;
		ad_targ.ad_part_qccol1 = 2; // Dark Grey (0+2)
		ad_targ.ad_part_qccol2 = 6; // Light Grey (0+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_PLASMA) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_BLUE;
		ad_targ.ad_dpp_name = ad_DPP_TRPLASMA;
		ad_targ.ad_part_qccol1 = 40; // Silver (32+8)
		ad_targ.ad_part_qccol2 = 198; // Bright Yellow (192+6)
	}
	else if (ad_targ.ad_part_trstyle == ad_PARTICLE_TRAIL_POISON) {
		ad_targ.ad_part_style = ad_PARTICLE_BURST_GREEN;
		ad_targ.ad_dpp_name = ad_DPP_TRPOISON;
		ad_targ.ad_part_qccol1 = 56; // Swampy green (48+8)
		ad_targ.ad_part_qccol2 = 182; // Light green (176+6)
	}
};

//----------------------------------------------------------------------
void() ad_Custom_ParticleTrail =
{
	local float ad_part_col;
	
	// Projectile trail been turned off/disabled
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	
	// Projectile Trail has finished/deleted (cope with hazard counters)
	if (self.ad_attack_finished < time) { ad_HazardProjectile_Finished(self);	return;	}

	// Custom Particle Trail Active?
	if (self.ad_part_qctrail == ad_TRUE) {
		// Check if particle colours have been setup (BLUE=default)
		if (self.ad_part_qccol1 <= 0) self.ad_part_qccol1 = 40; // Silver
		if (self.ad_part_qccol2 <= 0) self.ad_part_qccol2 = 198; // Dark blue

		// Generate dot/engine particles? DP/FTE/QSS has trail effect instead
		if (!ad_ext_dppart && random() < 0.5) {
			// Is this the target for the particle trail?
			if (!self.ad_part_qctarget) self.ad_part_qcorigin = self.origin;
			else self.ad_part_qcorigin = self.ad_part_qctarget.origin;
			// Has the particle target moved since last tick frame?
			// No particle trail if the target entity is stationary
			if (self.ad_part_qcorigin != self.oldorigin) {
				// Create random particle direction
				self.ad_part_qcdir = ad_crandom() * '1 1 1';
				// Primary colour has greater palette variety
				ad_part_col = self.ad_part_qccol1 + rint(random()*8);
				// Use builtin quake particle system
				particle (self.ad_part_qcorigin, self.ad_part_qcdir, ad_part_col, 4 + rint(random()*4) );
				ad_part_col = self.ad_part_qccol2 + rint(random()*4);
				particle (self.ad_part_qcorigin, self.ad_part_qcdir, ad_part_col, 2 + rint(random()*2) );
			}
		}

		// Some projectiles grows over time (eg. player plasma)
		if (self.ad_part_qcgrow && self.ad_part_qcgrowtimer < time) {
			self.frame = self.frame + 1;
			if (self.frame < 6) self.ad_part_qcgrowtimer = time + 0.1;
			else self.frame = 6;
		}
		
		// Any secondary functions active? (eg. Projectile Steering)
		if (self.ad_part_sectimer < time) {
			self.ad_part_sectimer = time + 0.2;
			if (self.ad_part_secfunc) self.ad_part_secfunc();
		}
		// Save origin to check if projectile (self) has moved
		self.oldorigin = self.ad_part_qcorigin;
		// Default - Keep creating particles
		self.think = ad_Custom_ParticleTrail;
		self.nextthink = time + 0.02;
	}
	else {
		// Switch over to different particle setup for the ground
		// This expects the particle variables have been setup
		if (random() < self.ad_part_chance)
			ad_particle_explode(self.origin+self.ad_part_ofs, self.ad_part_base+random()*self.ad_part_rand, self.ad_part_life+random(), self.ad_part_style, 0);

		self.think = ad_Custom_ParticleTrail;
		self.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
void() ad_misc_particle_trail_on =
{
	// Stop re-triggering ON state
	if (self.ad_estate == ad_ESTATE_ON) return;

	// Setup particle defaults
	if (self.ad_part_style == 0) ad_Default_ParticleTrail(self);

	// Has the trail entity been defined?
	if (!self.ad_part_qctarget) {
		// Is there a target entity defined? - results in error
		// Can't have a trail effect if the source does not move
		if (self.target == "") {
			dprint("\b[PART_TRAIL]\b target entity is missing!\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			ad_entity_hide(self);
			return;		
		}
		else {
			// Try to find target?
			self.ad_movetarget = find(world, targetname, self.target);
			if (self.ad_movetarget) self.ad_part_qctarget = self.ad_movetarget;
			else {
				// Target entity not valid - results in error
				// Need a (moving) target for trails to be active
				dprint("\b[PART_TRAIL]\b target entity not valid!\n");
				ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
				ad_entity_hide(self);
				return;		
			}
		}
	}
	
	// Trail effect is active
	self.ad_estate = ad_ESTATE_ON;
	
	// Enable trail effect for DP/FTE/QSS engines
	if (ad_ext_dppart && self.ad_dpp_name != "") {
		self.ad_part_qctarget.ad_traileffectnum = particleeffectnum(self.ad_dpp_name);
		self.ad_part_qctarget.effects = 0;
	}
	// Default = sprite based QC version
	else {
		self.think = ad_Custom_ParticleTrail;	
		self.nextthink = time + 0.02;
	}
};

//----------------------------------------------------------------------
void() ad_misc_particle_trail_reset =
{
	// Turn off (reset) engine trail effects
	if (self.ad_part_qctarget) self.ad_part_qctarget.ad_traileffectnum = 0;
	else self.ad_traileffectnum = 0;
};

//----------------------------------------------------------------------
void() ad_misc_particle_trail_off =
{
	self.ad_estate = ad_ESTATE_OFF;
	ad_misc_particle_trail_reset();
};

//----------------------------------------------------------------------
void() ad_misc_particle_trail_disable =
{
	self.ad_estate = ad_ESTATE_DISABLE;
	ad_misc_particle_trail_reset();
};

//----------------------------------------------------------------------
void() ad_misc_particle_trail =
{
	// Default setup for any particle emitter
	self.ad_classtype = ad_CT_PARTICLEEMIT;
	self.ad_pemit_source = self;
	
	// Check if particle style has been defined?
	if (self.ad_part_style < ad_PARTICLE_TRAIL_YELLOW || 
		self.ad_part_style > ad_PARTICLE_TRAIL_WHITE) {
		dprint("\b[PART_TRAIL]\b type and colour missing!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;		
	}

	// Only use the trail part of Custom_ParticleTrail
	self.ad_part_qctrail = ad_TRUE;
	// Move style to trail key ready for setup
	self.ad_part_trstyle = self.ad_part_style;
	self.ad_part_style = 0;
	// Block any poisonous setups
	self.ad_poisonous = ad_FALSE;
	// No secondary functions allowed
	self.ad_part_sectimer = ad_LARGE_TIMER;
	// There is no defined finish point, up to mapper
	self.ad_attack_finished = ad_LARGE_TIMER;
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_misc_particle_trail_on;
	self.ad_estate_off = ad_misc_particle_trail_off;
	self.ad_estate_disable = ad_misc_particle_trail_disable;
	self.ad_estate_use = ad_misc_particle_trail_on;
	
	// Check for starting off or default=on
	if (self.spawnflags & ad_ENT_STARTOFF) ad_entity_state_off();
	else {
		// Need target to be active first
		self.nextthink = time + 0.2;
		self.think = self.ad_estate_on;
	}
};

//======================================================================
/*ad:QUAKED misc_particle (0 0.5 0.75) (-8 -8 -8) (8 8 8) x x x x x x STARTOFF x
A particle emitter which can be turned on/off (use function)
-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
target       : destination of effect (self -> target)
target2      : name of a particle template
message      : Particle style string (upper case) leave blank for custom
               ALTAR, ARMOR1, ARMOR2, ARMOR3, BOOK, ELECTRIC,
			   FCIRCLE, FLAMES, FLAMEL, JUMPPAD, 
			   KEYGOLD, KEYSILVER, KEYRED, KEYGREEN, KEYPURPLE, KEYWHITE,
			   MEGAH, PENT, PORTAL, QUAD, SIGIL, SRING, SUIT,
			   SKILL, BSKILL, GSKILL, PSKILL
-------- SPAWNFLAGS --------
STARTOFF : Always Starts off and waits for trigger
-------- NOTES --------
A particle emitter which can be turned on/off (use function)
*/

//-----------------------------------------------------------------------------
/*ad:QUAKED misc_particletemplate (0 0.5 0.75) (-8 -8 -8) (8 8 8) x
A particle emitter template
-------- KEYS --------
targetname   : target name reference for misc_particle entities
start_delay  : Particle emitter start delay
spr_name1    : sprite name (progs\s_bubble_blue1.spr)
spr_name2    : sprite name (progs\s_bubble_wht.spr)
spr_name3    : sprite name (progs\s_dotmed_grey.spr)
part_movetype: Movetype of particle (def.qc for movetypes)
part_limit   : Maximum amount of particles to emit at once
part_life    : Life time particle is active (seconds)
part_ofs     : Offset from emitter (XYZ)
part_veltype : Velocity type 1=random, 2=circular
part_vel     : Velocity direction (XYZ)
part_velrand : Extra random velocity (need vel type 1)
part_velrot  : Velocity rotation (Y axis only)
part_vol     : Spawning volume around emitter (XYZ)
cirular_angle: Circular rotation angle
wakeup_dist  : Wake up distance for particle emitter
wakeup_timer : How often to check distance check
spawn_base   : Spawn rate - base value (seconds)
spawn_rand   : Spawn rate - random adjustment (seconds)
dpp_name     : DP particle effect name in effectinfo.txt file
dpp_wait     : DP particle re-trigger timer
dpp_rnd      : DP particle random multiplier for time
dpp_vel      : Direction of DP particles to move towards (XYZ)
-------- SPAWNFLAGS --------
-------- NOTES --------
A particle emitter template
*/

//-----------------------------------------------------------------------------
/*ad:QUAKED misc_particle_burst (0 0.5 0.75) (-8 -8 -8) (8 8 8) x
A particle emitter that fires a burst
-------- KEYS --------
targetname    : Trigger Particle Emitter
part_ofs      : Particle Origin Offset (def='0 0 0')
part_tcount   : Particle Quantity (def=20)
part_life     : Particle Life Time (def=2s)
part_style    : 1=yellow, 2=green, 3=red, 4=blue, 5=purple, 6=fire, 7=white
part_movetype : 2=center, 3=up, 4=shockwave, 5=skull, 6=lost, 7=minotaur
-------- SPAWNFLAGS --------
-------- NOTES --------
A particle emitter that fires a burst
*/

//-----------------------------------------------------------------------------
/*ad:QUAKED misc_particle_trail (0 0.5 0.75) (-8 -8 -8) (8 8 8) x
A particle emitter that adds a trail effect to another entity
-------- KEYS --------
targetname    : Trigger Particle Emitter
target        : Name of entity (only one) to add trail effect
part_style    : 1=yellow, 2=green, 3=red, 4=blue, 5=purple, 6=fire, 7=white
-------- SPAWNFLAGS --------
-------- NOTES --------
A particle emitter that adds a trail effect to another entity
*/

//-----------------------------------------------------------------------------
/*ad:QUAKED misc_weather (0 0.5 0.75) ? x x SILENT SNOW BLOOD SLIME STARTOFF x
A particle emitter which produces weather effects
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
count      : Quantity of particles for volume
speed      : Downward velocity (def=300)
v_angle    : Random velocity adjustment (def=8 8 150)
wakeup_dist  : how close the player needs to be for the weather to work
wakeup_timer : time to keep checking when in standby mode
-------- SPAWNFLAGS --------
SILENT   : Don't make any drip sound (good for multiple drips)
SNOW     : White wispy flakes falling
BLOOD    : Blood red rain
SLIME    : Slime green rain
STARTOFF : Always Starts off and waits for trigger
-------- NOTES --------
A particle emitter which produces weather effects
*/

