//======================================================================
/*ad:QUAKED item_keyx (0 .5 .8) (-16 -16 -24) (16 16 32) CKEY1 CKEY2 CKEY3 CKEY4 RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/key_medieval.mdl"); }
Custom key
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
mdl           : model name to load/display (progs/model.mdl)
netname       : XXX Part of pickup string "You got the XXX"
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig  : = 1 Wait for trigger before respawning
message2      : particle emitter types = KEYSILVER, KEYGOLD, KEYRED, KEYGREEN, KEYPURPLE, KEYWHITE
ckeyhint      : 1 = Arcane key Inventory message blocked (no msg to player)
-------- SPAWNFLAGS --------
Ckey1 : Custom Key type 1
Ckey2 : Custom Key type 2
Ckey3 : Custom Key type 3
Ckey4 : Custom Key type 4
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS: No particle or effects active
-------- NOTES --------
Custom key

======================================================================*/
void() ad_item_keyx =
{
	// Check for any self worldtype override
	if (!self.worldtype) self.worldtype = world.worldtype;
	
	// Can't have a custom key without a custom model!?!
	if (self.mdl == "") {
		dprint("\b[CUSTOM KEY]\b Missing model\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	precache_model (self.mdl);	

	// HUD skin priority (ckeyhudskin > exactskin > skin)
	if (self.ad_exactskin > 0) self.skin = self.ad_exactskin;
	if (self.skin <= 0) self.skin = 0;
	if (self.ad_ckeyhudskin == 0) self.ad_ckeyhudskin = self.skin;

	// Setup custom key reference number (must exist)
	if (self.spawnflags & ad_ITEM_CKEY1) {
		self.ad_moditems = ad_IT_CKEY1;
		if (self.netname == "") self.netname = "Arcane Key 1";
		self.ad_ckeyskin1 = self.ad_ckeyhudskin;
	}
	else if (self.spawnflags & ad_ITEM_CKEY2) {
		self.ad_moditems = ad_IT_CKEY2;
		if (self.netname == "") self.netname = "Arcane Key 2";
	}
	else if (self.spawnflags & ad_ITEM_CKEY3) {
		self.ad_moditems = ad_IT_CKEY3;
		if (self.netname == "") self.netname = "Arcane Key 3";
	}
	else if (self.spawnflags & ad_ITEM_CKEY4) {
		self.ad_moditems = ad_IT_CKEY4;
		if (self.netname == "") self.netname = "Arcane Key 4";
	}
	else {
		dprint("\b[CUSTOM KEY]\b Missing spawnflag key number!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
		
	self.ad_classtype = ad_CT_CUSTOMKEY;
	self.items = ad_IT_KEY1 | ad_IT_KEY2;

	// Check for any AD defined particle effects
	if (self.ad_message2 == "KEYGOLD") self.ad_part_active = ad_PARTICLE_STYLE_KEYGOLD;
	else if (self.ad_message2 == "KEYSILVER") self.ad_part_active = ad_PARTICLE_STYLE_KEYSILVER;
	else if (self.ad_message2 == "KEYRED") self.ad_part_active = ad_PARTICLE_STYLE_KEYRED;
	else if (self.ad_message2 == "KEYGREEN") self.ad_part_active = ad_PARTICLE_STYLE_KEYGREEN;
	else if (self.ad_message2 == "KEYPURPLE") self.ad_part_active = ad_PARTICLE_STYLE_KEYPURPLE;
	else if (self.ad_message2 == "KEYWHITE") self.ad_part_active = ad_PARTICLE_STYLE_KEYWHITE;
	else self.ad_part_active = 0;
	
	// Default respawn parameters, clear message2 just in case
	self.ad_respawn_style = ad_PARTICLE_BURST_WHITE + ad_PARTICLE_BURST_CENTER;
	if (!self.ad_respawn_ofs) self.ad_respawn_ofs = '0 0 20';
	self.ad_message2 = "";
	
	ad_key_setup();
};

//======================================================================
/*ad:QUAKED item_custom (0 .5 .8) (-16 -16 -24) (16 16 32) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/key_base.mdl"); }
Custom Pickup Item
-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
mdl          : model name to load/display (progs/model.mdl)
netname      : XXX Part of pickup string "You got the XXX"
noise1       : Custom pickup sound (def=weapons/lock4.wav)
pos1         : Pickup bounding box minimum (def=-16 -16 -24)
pos2         : Pickup bounding box maximum (def=16 16 32)
bodyfadeaway : Model will fade away on pickup
respawn_time : time to wait before respawning (1-x seconds, default varies)
respawn_count: Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
part_active   : = 1 Enable particle burst on pickup
part_ofs      : Particle Origin Offset (def='0 0 0')
part_tcount   : Particle Quantity (def=20)
part_life     : Particle Life Time (def=2s)
part_style    : 1=yellow, 2=green, 3=red, 4=blue, 5=purple, 6=fire, 7=white
part_movetype : 2=center, 3=up, 4=shockwave, 5=skull, 6=lost, 7=minotaur
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Custom Pickup Item

======================================================================*/
void() ad_item_custom_touch =
{
	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other,"\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");
	
	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;

	// Check for a particle pickup burst (can be blocked)
	if (self.ad_part_style > 0 && !(self.spawnflags & ad_ITEM_NOEFFECTS)) 
		ad_misc_particle_burst_use();
	
	// Once only, fade away function
	if (self.ad_bodyfadeaway == ad_TRUE) {
		self.use = self.touch = ad_SUB_Null;
		self.think = ad_model_fade;
		self.nextthink = time + 0.1;
		self.ltime = self.nextthink;
		self.wait = self.delay = 0;
	}
	else {
		// This code is broken and should NOT endlessly respawn for coop
		// 1.8 code removed this option and it is now back to default
		// Do not remove/respawn in co-op
		//if (!coop) {
		ad_item_finished();
		ad_check_item_respawn();
		//}
	}		
};

//----------------------------------------------------------------------
void() ad_item_custom =
{
	if (self.mdl == "") self.mdl = ad_MODEL_BROKEN;
	if (self.noise == "") self.noise = ad_AMMO_PICKUP;
	precache_model (self.mdl);	
	precache_sound (self.noise);

	self.ad_classtype = ad_CT_CUSTOMITEM;
	// Essentially this item is used like a key
	// pickup, collect and trigger an event
	self.ad_classgroup = ad_CG_KEY;
	if (self.netname == "") self.netname = "Custom Item";
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_KEY;

	// Check for a particle burst setup
	if (self.ad_part_active == ad_TRUE) ad_misc_particle_burst_setup();
	self.ad_part_active = 0;	// Must clear this afterward

	// Setup random rotation, will be ignored if spinning model
	if (self.angles_y <= 0) self.angles_y = rint(random()*359);

	// Setup different skin options
	if (self.ad_exactskin > 0) self.skin = self.ad_exactskin;
	else if (self.ad_randomskin > 1) self.skin = rint(random()*(self.ad_randomskin-1));
	if (self.skin < 0) self.skin = 0;	// Double check no negatives
	
	self.ad_touch2 = ad_item_custom_touch;
	if (ad_CheckZeroVector(self.pos1)) self.ad_bbmins = ad_VEC_KEYS_MIN;
	else self.ad_bbmins = self.pos1;
	if (ad_CheckZeroVector(self.pos2)) self.ad_bbmaxs = ad_VEC_KEYS_MAX;
	else self.ad_bbmaxs = self.pos2;
	
	ad_item_start();
};

//======================================================================
/*ad:QUAKED item_sigil (0 0.5 0.8) (-16 -16 -24) (16 16 32) Ep1 Ep2 Ep3 Ep4 RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/key_rune1.mdl"); }
End of episode sigil / rune
-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
EP1 : Episode 1 Rune
EP2 : Episode 2 Rune
EP3 : Episode 3 Rune
EP4 : Episode 4 Rune
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
End of episode sigil.  If the player is in possession of a sigil, then the next time 
the player changes levels, all func_episodegate entities for that episode will appear.  
This is used to block access to slipgates that lead to episodes that the player has 
already completed.  If the player is in possession of the item_sigil for all four 
episodes, then the func_bossgate entity will NOT appear.  This is used to grant 
access to the final boss once the player has completed all episodes.

======================================================================*/
float(entity ad_sigilitem) ad_sigil_pickupcondition =
{
	if (ad_query_configflag(ad_sigilitem.ad_customkey)) return ad_TRUE;
	else return ad_FALSE;
};

// ----------------------------------------------------------------
void() ad_sigil_touch =
{
	if (ad_sigil_pickupcondition(self)) return;
	
	ad_centerprint3( other, "You got ", self.netname, "!");
	//centerprint (other, "You got the rune!");
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");
	
	// Add rune to server! not player
	ad_update_configflag(self.ad_customkey, ad_TRUE);

	// DP has special effect for sigil being picked up
	if (ad_ext_dppart) pointparticles(particleeffectnum(ad_DPP_SIGILPICKUP), self.origin, '0 0 0', 1);
	
	// This odd classname assignment does nothing, old code
	// - It may have been used to hide runes from find commands
	//self.classname = string_null;
	
	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;

	// hide item and check for respawn
	ad_item_finished();
	ad_check_item_respawn();	
};

//----------------------------------------------------------------------
void() ad_item_sigil =
{
	if (!self.spawnflags) {
		dprint("\b[SIGIL]\b No Rune type selected!?!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;		
	}

	// Check for custom model setup?
	ad_item_debugcustomdl();
	// Based on what spawn key is selected, update model/spawnflag
	// This will make sure only one rune is selected at once
	// Also allow for the spawnflags to have other parameters
	if (self.spawnflags & ad_SVR_RUNE_KEY1) {
		if (self.mdl == "") self.mdl = "progs/key_rune1.mdl";
		self.ad_customkey = ad_SVR_RUNE_KEY1;
	}
	else if (self.spawnflags & ad_SVR_RUNE_KEY2) {
		if (self.mdl == "") self.mdl = "progs/key_rune2.mdl";
		self.ad_customkey = ad_SVR_RUNE_KEY2;
	}
	else if (self.spawnflags & ad_SVR_RUNE_KEY3) {
		if (self.mdl == "") self.mdl = "progs/key_rune3.mdl";
		self.ad_customkey = ad_SVR_RUNE_KEY3;
	}
	else if (self.spawnflags & ad_SVR_RUNE_KEY4) {
		if (self.mdl == "") self.mdl = "progs/key_rune4.mdl";
		self.ad_customkey = ad_SVR_RUNE_KEY4;
	}
	
	precache_model (self.mdl);
	if (self.noise == "") self.noise = "misc/runekey.wav";
	precache_sound (self.noise);

	self.ad_touch2 = ad_sigil_touch;
	self.ad_classtype = ad_CT_RUNEKEY;
	self.ad_classgroup = ad_CG_RUNE;
	if (self.netname == "") self.netname = "The Rune";
	self.ad_part_active = ad_PARTICLE_STYLE_SIGIL;
	self.ad_bbmins = ad_VEC_KEYS_MIN;
	self.ad_bbmaxs = ad_VEC_KEYS_MAX;
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_RUNE;
	self.ad_respawn_style = ad_PARTICLE_BURST_PURPLE + ad_PARTICLE_BURST_CENTER;
	self.ad_respawn_ofs = '0 0 16';
	
	// Check for coop errors
	ad_item_coopcheck();	
	ad_item_start();
};

