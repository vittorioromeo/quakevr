void() ad_key_touchbindmsg =
{ 
	sound (self.enemy, ad_CHAN_VOICE, ad_SOUND_TALK, 1, ad_ATTN_NORM);
	ad_centerprint(self.enemy, "Press 'i' Key to open Inventory\nTo see what \bArcane keys\b you have!\n");
};

//----------------------------------------------------------------------
float(entity ad_keyplayer, entity ad_keyitem) ad_key_pickupcondition =
{
	// Check if the player has the custom key already?
	if (ad_keyitem.ad_classtype == ad_CT_CUSTOMKEY) {
		if (ad_keyplayer.ad_moditems & ad_keyitem.ad_moditems) return ad_TRUE;
		else return ad_FALSE;
	}
	// Check if the player has the silver/gold key already?
	if ( ad_keyplayer.items & ad_keyitem.items ) return ad_TRUE;
	else return ad_FALSE;
};

void(float ad_tvalue, string ad_tdstr) ad_trigger_timer_updateno;
//----------------------------------------------------------------------
void() ad_key_touch =
{
	// Check if player has the key already
	if (ad_key_pickupcondition(other, self)) return;
	
	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other,"\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");
	
	// Add key to player inventory (items / customkey)
	if (self.ad_moditems > 0) {
		other.ad_moditems = other.ad_moditems | self.ad_moditems;
		// Store the key netname on the player/client for door ref later
		// Skin number is used by the ClientServerQC AD HUD
		// Sanity range check are done in the HUD, just in case!
		if (self.ad_moditems & ad_IT_CKEY1) {
			other.ad_ckeyname1 = self.netname;
			other.ad_ckeyskin1 = self.ad_ckeyhudskin;
		}
		else if (self.ad_moditems & ad_IT_CKEY2) {
			other.ad_ckeyname2 = self.netname;
			other.ad_ckeyskin2 = self.ad_ckeyhudskin;
		}
		else if (self.ad_moditems & ad_IT_CKEY3) {
			other.ad_ckeyname3 = self.netname;
			other.ad_ckeyskin3 = self.ad_ckeyhudskin;
		}
		else {
			other.ad_ckeyname4 = self.netname;
			other.ad_ckeyskin4 = self.ad_ckeyhudskin;
		}
	}
	// Add silver/gold key to player inventory
	else other.items = other.items | self.items;

	// Setup respawn for co-op
	if (coop > 0 && self.ad_respawn_time > 0) {
		self.ad_respawn_time = ad_RESPAWN_COOP;
		self.spawnflags = self.spawnflags | ad_ITEM_RESPAWN;
	}

	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;
	
	// hide item and check for respawn
	ad_item_finished();
	ad_check_item_respawn();

	// Triggers events work once in co-op
	if (coop > 0) self.target = "";
	
	// Warn player about new key binding for inventory (first time only)
	if (self.ad_moditems > 0 && other.ad_ckeyhint == ad_FALSE) {
		self.enemy = other;		// Store for later
		// Check if custom key message is suppressed?
		if (self.ad_ckeyhint == ad_TRUE) other.ad_ckeyhint = ad_TRUE;
		else {
			other.ad_ckeyhint = ad_TRUE;	// Only works once
			self.think = ad_key_touchbindmsg;
			self.nextthink = time + 3;
		}
	}
};

//----------------------------------------------------------------------
void() ad_key_setup =
{
	if (self.noise == "") {
		if (self.worldtype == 1) self.noise = "misc/runekey.wav";
		else if (self.worldtype == 2) self.noise = "misc/basekey.wav";
		else self.noise = "misc/medkey.wav";
	}
	precache_sound (self.noise);

	self.ad_touch2 = ad_key_touch;
	self.ad_classgroup = ad_CG_KEY;
	self.ad_bbmins = ad_VEC_KEYS_MIN;
	self.ad_bbmaxs = ad_VEC_KEYS_MAX;
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_KEY;

	// Check for coop errors
	ad_item_coopcheck();	
	ad_item_start();
};

//======================================================================
/*ad:QUAKED item_key1 (0 0.5 0.8) (-16 -16 -24) (16 16 32) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/key_silver.mdl"); }
SILVER key, changes based on worldtype on worldspawn
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
message       : centerprint message when item is picked up
worldtype     : Override model type (1=runic, 2=base, 3=medieval)
netname       : Override name of pickup (def=silver runekey/keycard/key)
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
SILVER key, changes based on worldtype on worldspawn

======================================================================*/
void() ad_item_key1 =
{
	// Check for any self worldtype override
	if (!self.worldtype) self.worldtype = world.worldtype;
	
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.worldtype == 1) {
		if (self.mdl == "") self.mdl = "progs/key_runic.mdl";	// progs/m_s_key.mdl
		if (self.netname == "") self.netname = "silver runekey";
	}
	else if (self.worldtype == 2) {
		if (self.mdl == "") self.mdl = "progs/key_base.mdl";	// progs/b_s_key.mdl
		if (self.netname == "") self.netname = "silver keycard";
	}
	else {
		if (self.mdl == "") self.mdl = "progs/key_medieval.mdl";	// progs/w_s_key.mdl
		if (self.netname == "") self.netname = "silver key";
	}
	
	precache_model (self.mdl);
	self.skin = 2;
	self.items = ad_IT_KEY1;
	self.ad_classtype = ad_CT_SILVERKEY;
	self.ad_part_active = ad_PARTICLE_STYLE_KEYSILVER;
	self.ad_respawn_style = ad_PARTICLE_BURST_BLUE + ad_PARTICLE_BURST_CENTER;
	self.ad_respawn_ofs = '0 0 20';
	ad_key_setup();
};

