//======================================================================
// Deathmatch Weapon Rules
//======================================================================
float(float ad_w) ad_DM_RankForWeapon =
{
	if (ad_w == ad_IT_LIGHTNING) return 1;
	if (ad_w == ad_IT_ROCKET_LAUNCHER) return 2;
	if (ad_w == ad_IT_SUPER_NAILGUN) return 3;
	if (ad_w == ad_IT_GRENADE_LAUNCHER) return 4;
	if (ad_w == ad_IT_SUPER_SHOTGUN) return 5;
	if (ad_w == ad_IT_NAILGUN) return 6;
	return 7;	// Axe
};

//----------------------------------------------------------------------
void(float ad_old, float ad_new) ad_DM_Weapon =
{
	local float ad_oldrank, ad_newrank;

// change self.weapon if desired
	ad_oldrank = ad_DM_RankForWeapon (self.weapon);
	ad_newrank = ad_DM_RankForWeapon (ad_new);
	if ( ad_newrank < ad_oldrank ) self.weapon = ad_new;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_bound_other_ammo =
{
	if (ad_targ.ammo_shells > ad_AMMO_MAXSHELLS) ad_targ.ammo_shells = ad_AMMO_MAXSHELLS;
	if (ad_targ.ammo_nails > ad_AMMO_MAXNAILS) ad_targ.ammo_nails = ad_AMMO_MAXNAILS;
	if (ad_targ.ammo_rockets > ad_AMMO_MAXROCKETS) ad_targ.ammo_rockets = ad_AMMO_MAXROCKETS;		
	if (ad_targ.ammo_cells > ad_AMMO_MAXCELLS) ad_targ.ammo_cells = ad_AMMO_MAXCELLS;		
};

//----------------------------------------------------------------------
void() ad_weapon_touch =
{
	local float ad_pickupweapon, ad_pickupmodweapon, ad_pickupammo, ad_moditem;
	if (VR_AD_WeaponTouch()) return;

	// Reset all weapon pickup items
	ad_pickupweapon = ad_pickupmodweapon = ad_IT_NOWEAPON;
	ad_moditem = ad_FALSE;

	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_UPGRADE_AXE) {
		// Cannot have Shadow Axe AND Grapple Hook
		if (other.ad_moditems & ad_IT_UPGRADE_GHOOK) {
			sprint (other, "Removing Grapple Hook!\n");
			other.ad_moditems = other.ad_moditems - (other.ad_moditems & ad_IT_UPGRADE_GHOOK);
		}
		ad_pickupweapon = ad_IT_AXE;
		ad_pickupmodweapon = ad_IT_UPGRADE_AXE;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.ad_moditems & ad_pickupweapon) return;
		// Update serverflag and highlight as MOD weapon
		ad_update_configflag(ad_SVR_UPDAXE, ad_TRUE);
		ad_moditem = ad_TRUE;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_UPGRADE_GHOOK) {
		// Cannot have Shadow Axe AND Grapple Hook
		if (other.ad_moditems & ad_IT_UPGRADE_AXE) {
			sprint (other, "Removing Shadow Axe!\n");
			other.ad_moditems = other.ad_moditems - (other.ad_moditems & ad_IT_UPGRADE_AXE);
			ad_update_configflag(ad_SVR_UPDAXE, ad_FALSE);
		}
		ad_pickupweapon = ad_IT_AXE;
		ad_pickupmodweapon = ad_IT_UPGRADE_GHOOK;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.ad_moditems & ad_pickupweapon) return;
		ad_moditem = ad_TRUE;
		// Check for fall damage override
		if (self.ad_fall_dmg != 0) {
			if (self.ad_fall_dmg < 0) ad_map_falldmg= 0;
			else ad_map_falldmg = self.ad_fall_dmg;
		}
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_AXE) {
		ad_pickupweapon = ad_IT_AXE;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		ad_pickupammo = 0;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_SHOTGUN) {
		ad_pickupweapon = ad_IT_SHOTGUN;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_shells > ad_AMMO_MAXSHELLS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_shells = other.ammo_shells + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_UPGRADE_SSG) {
		ad_pickupweapon = ad_IT_SUPER_SHOTGUN;
		ad_pickupmodweapon = ad_IT_UPGRADE_SSG;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.ad_moditems & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.ad_moditems & ad_pickupweapon) {
			if (other.ammo_shells > ad_AMMO_MAXSHELLS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_shells = other.ammo_shells + ad_pickupammo;
		// Update serverflag and highlight as MOD weapon
		ad_update_configflag(ad_SVR_UPDSSG, ad_TRUE);
		ad_moditem = ad_TRUE;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_SUPER_SHOTGUN) {
		ad_pickupweapon = ad_IT_SUPER_SHOTGUN;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_shells > ad_AMMO_MAXSHELLS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_shells = other.ammo_shells + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_NAILGUN) {
		ad_pickupweapon = ad_IT_NAILGUN;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_nails > ad_AMMO_MAXNAILS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_nails = other.ammo_nails + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_SUPER_NAILGUN) {
		ad_pickupweapon = ad_IT_SUPER_NAILGUN;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_nails > ad_AMMO_MAXNAILS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_nails = other.ammo_nails + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_GRENADE_LAUNCHER) {
		ad_pickupweapon = ad_IT_GRENADE_LAUNCHER;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_rockets > ad_AMMO_MAXROCKETS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_rockets = other.ammo_rockets + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ROCKET_LAUNCHER) {
		ad_pickupweapon = ad_IT_ROCKET_LAUNCHER;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_rockets > ad_AMMO_MAXROCKETS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_rockets = other.ammo_rockets + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_UPGRADE_LG) {
		ad_pickupweapon = ad_IT_LIGHTNING;
		ad_pickupmodweapon = ad_IT_UPGRADE_LG;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.ad_moditems & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.ad_moditems & ad_pickupweapon) {
			if (other.ammo_cells > ad_AMMO_MAXCELLS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_cells = other.ammo_cells + ad_pickupammo;
		// Update serverflag and highlight as MOD weapon
		ad_update_configflag(ad_SVR_UPDLG, ad_TRUE);
		ad_moditem = ad_TRUE;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_LIGHTNING) {
		ad_pickupweapon = ad_IT_LIGHTNING;
		ad_pickupmodweapon = ad_IT_NOWEAPON;
		// Deathmatch players cannot constantly pickup weapons
		if (deathmatch > 0 && other.items & ad_pickupweapon) return;
		// Coop players can use weapon spawns as ammo dispensers
		if (coop > 0 && other.items & ad_pickupweapon) {
			if (other.ammo_cells > ad_AMMO_MAXCELLS*0.5) ad_pickupammo = 0;
			else ad_pickupammo = self.aflag;
		}
		else ad_pickupammo = self.aflag;
		other.ammo_cells = other.ammo_cells + ad_pickupammo;
	}
	//----------------------------------------------------------------------
	else return;
	
	// Keep track of ammo used
	self.ad_aused = self.ad_aused + self.aflag;

	if (self.ad_classtype == ad_CT_UPGRADE_AXE && other.ad_moditems & ad_IT_UPGRADE_AXE)
		sprint (other, "You got another axe to grind\n");
	else if (self.ad_classtype == ad_CT_UPGRADE_GHOOK && other.ad_moditems & ad_IT_UPGRADE_GHOOK)
		sprint (other, "You got a brand new left hook\n");
	else if (self.ad_classtype == ad_CT_SUPER_SHOTGUN && other.ad_moditems & ad_IT_UPGRADE_SSG)
		sprint (other, "You got a handful of Shells\n");
	else if (self.ad_classtype == ad_CT_UPGRADE_SSG && other.ad_moditems & ad_IT_UPGRADE_SSG)
		sprint (other, "You got triple barrel boomstick\n");
	else if (self.ad_classtype == ad_CT_LIGHTNING && other.ad_moditems & ad_IT_UPGRADE_LG)
		sprint (other, "You got some AAA batteries\n");
	else if (self.ad_classtype == ad_CT_UPGRADE_LG && other.ad_moditems & ad_IT_UPGRADE_LG)
		sprint (other, "You got another burst of plasma\n");
	else {
		sprint (other, "You got the ");
		sprint (other, self.netname);
		sprint (other, "\n");
	}
	// weapon touch sound
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");

	// Make sure no ammo is over limits
	ad_bound_other_ammo (other);
	
	// Stop the player switching to weapons already got
	if (deathmatch > 0) {
		// Check for new shadow axe, grapplehook and SG and skip weapon switch
		if (ad_moditem && ad_pickupmodweapon == ad_IT_UPGRADE_AXE && other.ad_moditems & ad_pickupweapon) ad_pickupweapon = ad_FALSE;
		else if (ad_moditem && ad_pickupmodweapon == ad_IT_UPGRADE_GHOOK && other.ad_moditems & ad_pickupweapon) ad_pickupweapon = ad_FALSE;
		else if (ad_pickupweapon == ad_IT_SHOTGUN && other.items & ad_pickupweapon) ad_pickupweapon = ad_FALSE;
		// Stop switching to a lower tier weapon (DM Rules)
		// if (DM_RankForWeapon(other.weapon) < DM_RankForWeapon(new)) new = FALSE;
	}
	
	// Skip any weapon switch if no new weapon
	if (ad_pickupweapon != ad_FALSE) {
		// change to the weapon and add to inventory
		other.items = other.items | ad_pickupweapon;
		if (ad_moditem) other.ad_moditems = other.ad_moditems | ad_pickupmodweapon;
		
		// Check for best weapon (DM only) and switch to it!
		if (deathmatch) ad_DM_Weapon (other.weapon, ad_pickupweapon);
		else other.weapon = ad_pickupweapon;
		ad_W_SetCurrentAmmo(other);
	}

	// Fire any targets and display messages
	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;
	
	// hide item and check for respawn
	ad_item_finished();
	ad_check_item_respawn();
	
	// Triggers events work once in co-op
	if (coop > 0) { self.target = ""; self.ad_target2 = ""; }
};

//======================================================================
//	WEAPONS
//======================================================================
void() ad_weapon_start =
{
	self.ad_classgroup = ad_CG_WEAPON;
	self.ad_touch2 = ad_weapon_touch;
	self.ad_bbmins = ad_VEC_WPNS_MIN;
	self.ad_bbmaxs = ad_VEC_WPNS_MAX;
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_WEAPON;
	self.noise = ad_WEAPON_PICKUP;
	self.ad_aused = 0;
	
	ad_item_start ();
};

//======================================================================
/*ad:QUAKED weapon_upgrade_axe (0 0.5 0.8) (-16 -16 0) (16 16 56) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/g_shadaxe.mdl"); }
Shadow Axe, extra dmg and gib zombies
-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Shadow Axe, extra dmg and gib zombies

======================================================================*/
void() ad_weapon_upgrade_axe =
{
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.mdl == "") { self.mdl = ad_MODEL_GWEAP_UPAXE; self.skin = 4; }
	precache_model (self.mdl);
	self.weapon = ad_IT_UPGRADE_AXE;
	self.ad_classtype = ad_CT_UPGRADE_AXE;
	if (self.netname == "") self.netname = "Shadow Axe";
	if (self.ad_upgrade_axe != 0) self.ad_upgrade_axe = ad_FALSE;
	
	self.aflag = 0;
	ad_weapon_start();
};

