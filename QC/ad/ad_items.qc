{ model(":progs/g_light.mdl"); }
Thunderbolt Cannon
-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
message       : centerprint message when item is picked up
aflag         : Override ammo quantity for pickup (def=15)
netname       : Override name of pickup (def=Thunderbolt)
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig  : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Thunderbolt Cannon

======================================================================*/
void() ad_weapon_lightning =
{
	// Switch out Lightning Gun for Plasma for last ID map
	if (world.model == "maps/end.bsp") {
		self.classname = "weapon_upgrade_lg";
		ad_weapon_upgrade_lg();
		return;
	}
	
	// Query console variable 'temp1' for model upgrade option.
	// Cannot use global vars because they don't exist at this point
	if (ad_query_configflag(ad_SVR_UPDLG)) { ad_weapon_upgrade_lg(); return; }

	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.mdl == "") self.mdl = ad_MODEL_GWEAP_LG;
	precache_model (self.mdl);
	self.weapon = ad_IT_LIGHTNING;
	self.ad_classtype = ad_CT_LIGHTNING;
	if (self.netname == "") self.netname = "Thunderbolt";
	
	// Allow for mapper override on weapon ammo start
	if (self.aflag < 1) self.aflag = ad_AMMO_CELLS_WPN;
	else if (self.aflag < 0) self.aflag = 0;
	ad_weapon_start();
};

//======================================================================
// AMMO
//======================================================================
float(entity ad_ammoplayer, entity ad_ammoitem) ad_ammo_pickupcondition =
{
	// Check if the player can pickup anymore ammo
	if (ad_ammoitem.ad_classtype == ad_CT_AMMOSHELLS) {
		if (ad_ammoplayer.ammo_shells >= ad_AMMO_MAXSHELLS) return ad_TRUE;
		else return ad_FALSE;
	}
	else if (ad_ammoitem.ad_classtype == ad_CT_AMMONAILS) {
		if (ad_ammoplayer.ammo_nails >= ad_AMMO_MAXNAILS) return ad_TRUE;
		else return ad_FALSE;
	}
	else if (ad_ammoitem.ad_classtype == ad_CT_AMMOROCKETS) {
		if (ad_ammoplayer.ammo_rockets >= ad_AMMO_MAXROCKETS) return ad_TRUE;
		else return ad_FALSE;
	}
	else if (ad_ammoitem.ad_classtype == ad_CT_AMMOCELLS) {
		if (ad_ammoplayer.ammo_cells >= ad_AMMO_MAXCELLS) return ad_TRUE;
		else return ad_FALSE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
void() ad_ammo_touch =
{
	local float ad_best;

	// Check ammo limits first
	if (ad_ammo_pickupcondition(other,self)) return;
	
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_AMMOSHELLS)
		other.ammo_shells = other.ammo_shells + self.aflag;
	else if (self.ad_classtype == ad_CT_AMMONAILS)
		other.ammo_nails = other.ammo_nails + self.aflag;
	else if (self.ad_classtype == ad_CT_AMMOROCKETS)
		other.ammo_rockets = other.ammo_rockets + self.aflag;
	else if (self.ad_classtype == ad_CT_AMMOCELLS)
		other.ammo_cells = other.ammo_cells + self.aflag;
	
	// Keep track of ammo used
	self.ad_aused = self.ad_aused + self.aflag;

	// Check/cap ammo limits
	ad_bound_other_ammo (other);
	
	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other, "\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");

	// Check for randomizer pickup conditions
	ad_ammo_touchrandomizer();
	
	// if the player was using his best weapon, 
	// change up to the new one if better		
	ad_best = ad_W_BestWeapon(other);

	// change to a better weapon if appropriate
	if ( other.weapon == ad_best ) {
		other.weapon = ad_W_BestWeapon(other);
		ad_W_SetCurrentAmmo (other);
	}

	// if changed current ammo, update it
	ad_W_SetCurrentAmmo(other);

	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;
	
	// hide item and check for respawn
	ad_item_finished();
	ad_check_item_respawn();	
};

//======================================================================
//	Setup all Ammo with global parameters
//======================================================================
void() ad_item_ammo_setup =
{
	self.frame = 0;
	self.ad_touch2 = ad_ammo_touch;
	self.ad_classgroup = ad_CG_AMMOITEM;
	self.ad_bbmins = ad_VEC_AMMO_MIN;
	self.ad_bbmaxs = ad_VEC_AMMO_MAX;
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_AMMO;
	self.noise = ad_AMMO_PICKUP;
	self.ad_aused = 0;
	
	// Items that spawn from pots with toss velocity
	// should not have any lid options (remove them)
	if (self.ad_item_tossvel > 0) 
		self.spawnflags = self.spawnflags - (self.spawnflags & ad_A_LID);

	// Query console variable 'temp1' for model upgrade option.
	// Cannot use global vars because they don't exist at this point
	// Move the new centered ammo models to match old ammo origin
	// The default is to move all ammo items to suit original id maps
	if (!ad_query_configflag(ad_SVR_ITEMOFFSET)) {
		self.oldorigin = self.origin + '16 16 0';
		setorigin(self, self.oldorigin);
	}

	// Setup the skin parameter for ammo boxes
	self.skin = ad_item_skintype(self);

	// An old worldspawn key (not used anymore)
	// This is backward compatibility with this key
	// Will force all items to have an angle
	if (world.ad_no_item_rotate && self.angles_y == 0) self.angles_y = 360;	
	
	// Setting the angle key in the editor to UP/DOWN = random rotation	
	if (self.angles_y <= 0) self.angles_y = rint(random()*359);

	// Setup lid attachment entity (defined in item setup)
	if (self.spawnflags & ad_A_LID) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		setorigin(self.ad_attachment, self.origin);
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	}
		
	// Check for coop errors
	ad_item_coopcheck();
	ad_item_start ();
};

//======================================================================
// ** Old id version with origin at corner **
//QUAKED item_shells (0 .5 .8) (0 0 0) (32 32 32) BIG

/*ad:QUAKED item_shells (0 .5 .8) (-16 -16 0) (16 16 32) BIG LID x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/ammo_shells0.mdl"); }
20 or 40 Shells
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
frame_box     : special animation frame number for LID (1-7)
skin_override : Override world type 1=Base Green, 2=Medieval Wood
aflag         : Override ammo quantity for pickup (def=20/40)
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
BIG      : Double Ammo and different model
LID      : Extra LID model positioned with box
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
20 or 40 Shells for the Shotgun (SG), SuperShotgun (SSG) and Upgrade

======================================================================*/
void() ad_item_shells =
{
	// Check for any random monster setups
	if (ad_ammo_checkrandomizer() == ad_TRUE) return;
	
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.spawnflags & ad_A_LARGE) {
		if (self.mdl == "") self.mdl = "progs/ammo_shells1.mdl";
		if (self.ad_headmdl == "") self.ad_headmdl = "progs/ammo_lidlarge.mdl";
		if (self.aflag < 1) self.aflag = ad_AMMO_SHELLS_LGR;
	}
	else {
		if (self.mdl == "") self.mdl = "progs/ammo_shells0.mdl";
		if (self.ad_headmdl == "") self.ad_headmdl = "progs/ammo_lidsmall.mdl";
		if (self.aflag < 1) self.aflag = ad_AMMO_SHELLS_SML;
	}
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	self.ad_classtype = ad_CT_AMMOSHELLS;
	if (self.netname == "") self.netname = "box of shells";
	self.ad_respawn_style = ad_PARTICLE_BURST_YELLOW + ad_PARTICLE_BURST_RING;
	self.ad_respawn_ofs = '0 0 24';
	self.ad_respawn_effect = ad_TRUE;
	self.ad_frame_override = ad_FALSE;
	
	// Randomly pick between having a lid or not
	if (self.ad_frame_box == -1) {
		// Add spawnflag so lid is spawned correctly
		if (random() < 0.5) self.spawnflags = self.spawnflags | ad_A_LID;
		self.ad_frame_box = 0;
	}
	// Item progression list ammo cannot have lids!
	if (self.ad_progspawnlist > 0) 
		self.spawnflags = self.spawnflags - (self.spawnflags & ad_A_LID);
	
	ad_item_ammo_setup();
};

