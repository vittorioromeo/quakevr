//======================================================================
// ITEM FUNCTIONS
//======================================================================
/* Moved to defscustom.qc
float ITEM_RESPAWN = 16;	// Item will respawn
float ITEM_FLOATING = 32;	// Spawn floating
float ITEM_NOEFFECTS = 128;	// Disable particles and effects

float H_ROTTEN = 1;			// Rotten
float H_MEGA = 2;			// Mega Health
float A_LARGE = 1;			// Used by ammo boxes
float A_LID = 2;			// Display Lid

float BACKPACK_SHELLS = 1;
float BACKPACK_NAILS = 2;
float BACKPACK_ROCKETS = 4;
float BACKPACK_CELLS = 8;
float BACKPACK_GRNTYPE = 1;
float BACKPACK_YELTYPE = 2;
float BACKPACK_REDTYPE = 4;*/

float ad_AIRTANK_SILENT = 8;	// No sound with airtank

float ad_SKIN_BASE = 0;		// Green ammo boxes and square health packs
float ad_SKIN_MEDIEVAL = 1;	// Wood ammo boxes and red health flasks

float ad_ITEM_CKEY1 = 1;	// Arcane Key 1
float ad_ITEM_CKEY2 = 2;	// Arcane Key 2
float ad_ITEM_CKEY3 = 4;	// Arcane Key 3
float ad_ITEM_CKEY4 = 8;	// Arcane Key 4

// Used for weapons only
string ad_WEAPON_PICKUP = "weapons/pkup.wav";
// Used for ammo, custom items and backpacks
string ad_AMMO_PICKUP = "weapons/lock4.wav";

// Various bounding boxes for items
// vector	VEC_ORID_MIN = '0 0 0';
// vector	VEC_ORID_MAX = '32 32 56';
vector	ad_VEC_HEAL_MIN = '-16 -16 0';
vector	ad_VEC_HEAL_MAX = '16 16 56';
vector	ad_VEC_WPNS_MIN = '-16 -16 0';
vector	ad_VEC_WPNS_MAX = '16 16 56';
vector	ad_VEC_AMMO_MIN = '-16 -16 0';
vector	ad_VEC_AMMO_MAX = '16 16 56';
vector	ad_VEC_KEYS_MIN = '-16 -16 -24';
vector	ad_VEC_KEYS_MAX = '16 16 32';
vector	ad_VEC_POWR_MIN = '-16 -16 -24';
vector	ad_VEC_POWR_MAX = '16 16 32';

// Default respawn timers for items
float ad_RESPAWN_HEALTH = 20;			// 15,25,100+
float ad_RESPAWN_ARMOR = 20;			// Green, Yellow, Red
float ad_RESPAWN_WEAPON = 30;			// SG -> LG
float ad_RESPAWN_AMMO = 30;			// Shells,Nails,Rockets,Cells
float ad_RESPAWN_KEY = 60;				// Gold,Silver,Custom
float ad_RESPAWN_RUNE = 60;			// Sigil/runes
float ad_RESPAWN_ARTIFACT1 = 60;		// Quad + Suit
float ad_RESPAWN_ARTIFACT2 = 300;		// Pent + Invisibilty
float ad_RESPAWN_BACKPACK = 30;		// Random Ammo Drop
float ad_RESPAWN_COOP = 5;				// Default timer for coop

float ad_RESPAWN_PARTICLES = 32;		// Particle burst for ring/center
float ad_RESPAWN_EXPTIME = 1;			// Particles burst lifetime
float ad_RESPAWN_EXPRADIUS = 12;		// Particle ring radius

float ad_MODEL_ANIM_SPEED = 3;
float ad_MODEL_ANIM_RANGE = 3;

//----------------------------------------------------------------------
// Some items have pickup conditions which prevent targets
// from firing when coop mode is active, show console warning
//----------------------------------------------------------------------
void() ad_item_coopcheck =
{
	// coop active?
	if (coop <= 0) return;
	// Coop checks for prog list done elsewhere
	if (self.ad_progspawnlist) return;
	// Check for any target(s) on coop sensitive items?
	if (self.target != "" || self.ad_target2 != "") {
		dprint("\b[Coop]\b (");
		dprint(self.classname);
		dprint(") unreliable target(s) in coop!\n");
	}
};

//----------------------------------------------------------------------
// Setup skin parameter for ammo and health items
//----------------------------------------------------------------------
// world.worldtype			Model style				Skin
// 0 = default (Medieval)	wood / flasks			1
// 1 = runic / metal		wood / flasks			1
// 2 = base					green / square packs	0
//
// skin_override			Model style				Skin
// 0 = default				-						-
// 1 = base					green / square packs	0
// 2 = Medieval				wood / flasks			1
//----------------------------------------------------------------------
float(entity ad_targ) ad_item_skintype =
{
	// Go through medieval exceptions based on table above
	if (world.worldtype == 0 && !ad_targ.ad_skin_override) return ad_SKIN_MEDIEVAL;
	else if (world.worldtype == 1 && !ad_targ.ad_skin_override) return ad_SKIN_MEDIEVAL;
	else if (ad_targ.ad_skin_override == 2) return ad_SKIN_MEDIEVAL;
	else return ad_SKIN_BASE;
};

//----------------------------------------------------------------------
// Check floor under item and animated skin for new BASE health boxes
//----------------------------------------------------------------------
void() ad_item_thinkloop =
{
	// Check for entity states
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	// Has the item been turned off?
	if (self.ad_attack_finished > time) return;
	// Has the item removal timer been reached?
	if (self.ad_item_expired > 0 && self.ad_item_expired < time) remove(self);
	
	if (self.ad_item_skinanim > 0) {
		self.ad_item_skincycle = self.ad_item_skincycle + 1;
		if (self.ad_item_skincycle > ad_MODEL_ANIM_SPEED) {
			self.ad_item_skincycle = 0;
			self.ad_item_skinanim_no = self.ad_item_skinanim_no + 1;
			if (self.ad_item_skinanim_no > ad_MODEL_ANIM_RANGE) {
				self.ad_item_skinanim_no = 0;
			}
		}
		// Update skin
		self.skin = self.ad_item_skinanim_no;
	}

	// Check floor below item (global function)
	if (self.ad_item_flrcheck > 0) {
		ad_ent_floorcheck(self, self.ad_item_flrcheck);
		// Record any movement for respawn function
		self.oldorigin = self.origin;
	}

	// Keep checking
	self.think = ad_item_thinkloop;
	self.nextthink = time + 0.1;
};

void() ad_item_estate_setup;
//----------------------------------------------------------------------
void() ad_item_reset =
{
	// Reset trigger_once conditions
	self.ad_attack_finished = 0;
	if (!self.ad_estate_on) ad_item_estate_setup();
	self.ad_estate_on();
};

//----------------------------------------------------------------------
void() ad_item_debugcustomdl =
{
	if (self.mdl != "") {
		dprint("\b[ITEMS]\b "); dprint(self.classname);
		dprint(" with Custom mdl ("); dprint(self.mdl);
		dprint(")\n");
		ad_spawn_marker(self.origin+'0 0 32', ad_SPNMARK_GREEN);
	}
};

//----------------------------------------------------------------------
void() ad_item_finished =
{
	// Check for coop respawn options
	// This system can easily be abused by switching coop on/off
	// But its better the respawns are added, rather than not
	if (coop > 0) {
		if (self.ad_classgroup == ad_CG_WEAPON) {
			// This is just crazy back to front logic!
			// The id default is respawning weapons for coop
			// Which means coop_weapons is FALSE when TRUE!!!
			if (ad_coop_weapons == ad_FALSE && self.ad_respawn_time > 0) {
				// make sure weapon respawn timer is lower for coop
				if (self.ad_respawn_time > ad_RESPAWN_COOP) self.ad_respawn_time = ad_RESPAWN_COOP;
				self.spawnflags = self.spawnflags | ad_ITEM_RESPAWN;
			}
		}
		else if (self.ad_classgroup == ad_CG_HEALTH) {
			if (ad_coop_health == ad_TRUE && self.ad_respawn_time > 0)
				self.spawnflags = self.spawnflags | ad_ITEM_RESPAWN;
		}
		else if (self.ad_classgroup == ad_CG_AMMOITEM) {
			if (ad_coop_ammoboxes == ad_TRUE && self.ad_respawn_time > 0)
				self.spawnflags = self.spawnflags | ad_ITEM_RESPAWN;
		}
		else if (self.ad_classgroup == ad_CG_ARTIFACT) {
			if (ad_coop_powerups == ad_TRUE && self.ad_respawn_time > 0)
				self.spawnflags = self.spawnflags | ad_ITEM_RESPAWN;
		}
	}

	self.ad_attack_finished = ad_LARGE_TIMER;
	if (!self.ad_estate_off) ad_item_estate_setup();
	self.ad_estate_off();
};

//----------------------------------------------------------------------
void() ad_item_respawn =
{
	// Classic quake re-spawn sound
	sound (self, ad_CHAN_VOICE, ad_SOUND_RESPAWN, 1, ad_ATTN_NORM);

	// Are particles enabled?
	if (ad_query_configflag(ad_SVR_PARTICLES)) {
		// Switch off any respawn emitter
		if (self.ad_respawn_part.ad_classtype == ad_CT_PARTICLEEMIT)
			ad_misc_particle_off(self.ad_respawn_part);

		if (self.ad_respawn_style & ad_PARTICLE_BURST_RING) 
			ad_particle_ring(self.origin + self.ad_respawn_ofs, '0 0 4', '4 4 16', ad_RESPAWN_EXPRADIUS, ad_RESPAWN_PARTICLES, ad_RESPAWN_EXPTIME, self.ad_respawn_style ); 
		else if (self.ad_respawn_style & ad_PARTICLE_BURST_CENTER)
			ad_particle_explode(self.origin + self.ad_respawn_ofs, ad_RESPAWN_PARTICLES*2, ad_RESPAWN_EXPTIME, self.ad_respawn_style, self.ad_respawn_style); 
	}

	self.alpha = 1;
	self.ad_estate_reset();
};

//----------------------------------------------------------------------
// Re-direction for map hacks (not used normally)
//----------------------------------------------------------------------
void() ad_SUB_regen = {
//	self.model = self.mdl;
//	self.solid = SOLID_TRIGGER;
	sound (self, ad_CHAN_VOICE, ad_SOUND_RESPAWN, 1, ad_ATTN_NORM);
//	setorigin (self, self.origin);
	ad_item_reset();
};

//----------------------------------------------------------------------
void() ad_alphafade_item_respawn =
{
	if (self.waitmin > time) {
		self.speed = 1 - ((self.waitmin - time) / self.ad_respawn_time);
		self.alpha = 0.1 + ((self.speed*0.4)*random());

		// If respawn effect active, modify total particles
		if (self.ad_respawn_part.ad_part_style == ad_PARTICLE_STYLE_RESPAWN) {
			self.ad_respawn_part.ad_part_limit = rint(ad_RESPAWN_PARTICLES * self.speed);
		}
		self.think = ad_alphafade_item_respawn;
		self.nextthink = time + 0.1;
	}
	else ad_item_respawn();
};

//----------------------------------------------------------------------
void() ad_start_item_respawn =
{
	// Is the item being respawned at the moment?
	if (self.waitmin > time) return;
	// Is the item setup to instantly respawn?
	if (self.ad_respawn_trig == ad_TRUE && self.spawnflags & ad_ITEM_RESPAWN) {
		// Check for any respawn quantity counts
		if (self.ad_respawn_count > 0) {
			self.ad_respawn_count = self.ad_respawn_count - 1;
			if (self.ad_respawn_count == 0) 
				self.spawnflags = self.spawnflags - (self.spawnflags & ad_ITEM_RESPAWN);
		}
		// Instantly spawn item
		ad_item_respawn();
	}
	else {
		// deathmatch 2 is the silly old rules
		if (deathmatch == 1 || self.spawnflags & ad_ITEM_RESPAWN) {
			setmodel(self,self.mdl);
			setsize (self, self.ad_bbmins, self.ad_bbmaxs);
			self.waitmin = time + self.ad_respawn_time;
			self.alpha = 0.1;

			// Check for any respawn quantity counts
			if (self.ad_respawn_count > 0) {
				self.ad_respawn_count = self.ad_respawn_count - 1;
				if (self.ad_respawn_count == 0) 
					self.spawnflags = self.spawnflags - (self.spawnflags & ad_ITEM_RESPAWN);
			}
			
			// Are particles enabled?
			if (ad_query_configflag(ad_SVR_PARTICLES)) {
				// Switch off any particle emitters
				if (self.ad_part_emitter) ad_misc_particle_off(self.ad_part_emitter);
				// Is there any need for respawn effect?
				if (self.ad_respawn_effect) {
					// If emitter does not exist? create one, else switch on
					if (self.ad_respawn_part.ad_classtype == ad_CT_PARTICLEEMIT)
						ad_misc_particle_on(self.ad_respawn_part);
					else self.ad_respawn_part = ad_spawn_pemitter(self, self, ad_PARTICLE_STYLE_RESPAWN, ad_PARTICLE_START_ON);
				}
			}
			// Switch on gradual alpha fade
			ad_alphafade_item_respawn();
		}
	}
};

//----------------------------------------------------------------------
void() ad_check_item_respawn =
{
	// Respawn feature is waiting for trigger
	if (!self.ad_respawn_trig) ad_start_item_respawn();
};

//----------------------------------------------------------------------
void() ad_item_use =
{
	// Check for any trigger respawn conditions first
	// Respawn spawnflag, trigger condition and not trigger once
	if (self.spawnflags & ad_ITEM_RESPAWN && self.ad_respawn_trig &&
		self.ad_estate == ad_ESTATE_OFF) ad_start_item_respawn();
	else {
		// usual trigger blocks, OFF, DISABLE and trigger_ONCE
		if (self.ad_estate & ad_ESTATE_BLOCK) return;
		if (self.ad_attack_finished > time) return;

		// Was item setup to be floating?
		if(self.spawnflags & ad_ITEM_FLOATING){
			// Removed checkbottom check, it often fails and leaves
			// items floating in midair when they should fall
			// if (!checkbottom(self)) - left for comment only
			// A quick toss of the item
			self.movetype = ad_MOVETYPE_TOSS;	
			self.origin_z = self.origin_z + 4;
			self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
		}
	}
};

//----------------------------------------------------------------------
void() ad_item_touch =
{
	if (self.ad_touchedvoid) {ad_entity_hide(self); return;}
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	
	if ( !(other.flags & ad_FL_CLIENT) ) return;
	if ( other.health < 1 ) return;
	if ( other.flags & ad_FL_NOTARGET && ad_map_notargetblock == 0) return;
	if (self.ad_attack_finished > time) return;
	
	self.ad_touch2();	// defined by item function
};

//----------------------------------------------------------------------
void() ad_item_restore =
{
	// Ammo boxes can have special animation frames or lids!
	if (self.ad_classgroup == ad_CG_AMMOITEM) {
		// Any LID (shells/spikes) defined?
		if (self.spawnflags & ad_A_LID && self.ad_attachment) {
			// Setup LID attachment entity (match angles/origin)
			self.ad_attachment.solid = ad_SOLID_NOT;
			self.ad_attachment.movetype = self.movetype;
			setmodel(self.ad_attachment, self.ad_headmdl);
			// Give the lid the same bbox setup so it can move
			setsize (self.ad_attachment, self.mins, self.maxs);
			// Start lid off the ground and remove ground flag
			// This will let the lid naturally settle on the surface
			setorigin(self.ad_attachment, self.origin + '0 0 1');
			self.ad_attachment.flags = self.ad_attachment.flags - (self.ad_attachment.flags & ad_FL_ONGROUND);
			// Match angle and stored frame setup from ammo box
			self.ad_attachment.angles = self.angles;
			
			// lid frame options -1/0=random, 1-7=exact
			// Always generate a new lid position for respawning items
			if (self.ad_frame_box <= 0) self.ad_attachment.frame = rint(1 + random()*6);
			else if (self.ad_frame_box > 7) self.ad_frame_box = 1;
			if (self.ad_frame_box > 0) self.ad_attachment.frame = self.ad_frame_box;
			
			// LID has different skins for shells and spikes
			if (self.ad_classtype == ad_CT_AMMOSHELLS) self.ad_attachment.skin = self.skin;
			else self.ad_attachment.skin = 2 + self.skin;
		}
		// Any special frames (rockets/plasma) defined?
		else if (self.ad_frame_override) {
			// frame options -1=random 0=nothing, 1-7=exact
			// Always generate a new frame number for respawning items
			if (self.ad_frame_box == -1) self.frame = rint(1 + random()*6);
			else if (self.ad_frame_box > 7) self.ad_frame_box = 1;
			if (self.ad_frame_box > 0) self.frame = self.ad_frame_box;
		}
	}
	
	// Setup animated textures for old style ID health boxes
	// Check floor under item for any changes
	if (self.ad_item_flrcheck > 0 || self.ad_item_skinanim > 0) {
		self.nextthink = time + random()*0.5;
		self.think = ad_item_thinkloop;
	}
};

//----------------------------------------------------------------------
void() ad_item_delay =
{
	if (self.ad_touchedvoid) {ad_entity_hide(self); return;}
	if (self.ad_estate == ad_ESTATE_DISABLE) return;
	
	// Reset use function and any touch/skin triggers
	self.ad_estate_use = ad_item_use;
	self.touch = ad_item_touch;
	self.ad_attack_finished = 0;
	self.ad_estate = ad_ESTATE_ON;
	// Setup enough parameters to test drop to floor
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_TRIGGER;
	setmodel(self,self.mdl);
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	setorigin(self, self.oldorigin);
	self.velocity = '0 0 0';
	
	// Check if item is floating? = does not interact with world
	if(self.spawnflags & ad_ITEM_FLOATING) {
		// Cannot check the floor of an item if its floating!?!
		if (self.ad_item_flrcheck > 0) self.ad_item_flrcheck = 0;
	}
	else {
		// Finalize item location (check drop to floor)
		// Need this movetype for items to move with bmodels
		self.movetype = ad_MOVETYPE_TOSS;	
		self.velocity = '0 0 0';
		self.origin_z = self.origin_z + 6;
		// ID originally used a droptofloor test for space check
		// Tried a pointcontents check but it can allows things
		// to fall through the floor and just keep going
		//if (pointcontents(self.origin) == CONTENT_SOLID) {
		if (!droptofloor()) {
			dprint ("\n\b[Item]\b "); dprint (self.classname);
			dprint (" stuck at ("); dprint (vtos(self.origin)); dprint (")\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			// The item is stuck, might still be useful to the player
			// Originally the item was removed which is not super useful
			// The mapper should see the console warning and yellow marker
			// Changed to check for origin in solid instead
			if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
				remove(self); return;
			}
		} 
	}

	// Toss velocity is designed for breakable objects to spawn items
	// Will add forward/up velocity to an item so it does not get stuck
	// Has to happen after the droptofloor otherwise position is wrong
	if (self.ad_item_tossvel > 0) {
		// Make sure item can fly/move
		self.movetype = ad_MOVETYPE_TOSS;	
		self.velocity = '0 0 0';
		// Must remove onground flag otherwise velocity does nothing
		self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
		// Push the item in the angle direction
		makevectors(self.angles);
		self.velocity = v_forward * self.ad_item_tossvel;
		// Push the item upward to make it travel
		self.velocity_z = self.velocity_z + self.ad_item_tossvel;
	}

	// If check floor under item enabled, workout distance check
	// The bottom of the bounding box + 16 for large step
	if (self.ad_item_flrcheck > 0) {
		self.ad_item_flrcheck = fabs(self.mins_z) + 16;
	}
	
	// Spawn particle emitter if particles active and not blocked
	if (ad_query_configflag(ad_SVR_PARTICLES) == ad_SVR_PARTICLES) {
		if (!(self.spawnflags & ad_ITEM_NOEFFECTS) && self.ad_part_active > 0) {
			self.ad_part_emitter = ad_spawn_pemitter(self, self, self.ad_part_active, ad_PARTICLE_START_ON);
		}
	}
	
	// Finally setup entity ready for use
	self.oldorigin = self.origin;
	
	// Remove the START OFF functionality
	if (self.spawnflags & ad_ENT_STARTOFF) {
		self.spawnflags = self.spawnflags - ad_ENT_STARTOFF;
		// Check for respawn effect?
		if (self.spawnflags & ad_ITEM_RESPAWN) ad_start_item_respawn();
		else ad_item_restore();
	}
	else ad_item_restore();
};

//----------------------------------------------------------------------
void() ad_item_on =
{
	self.ad_estate = ad_ESTATE_ON;
	self.movetype = ad_MOVETYPE_NONE;

	// Restore any effect flags settings (various dlight glows)
	if (self.ad_savedeffects > 0) self.effects = self.ad_savedeffects;
	
	// Check for delayed/trigger_once functionality?
	if (self.spawnflags & ad_ENT_STARTOFF || self.ad_attack_finished > time)
		self.solid = ad_SOLID_NOT;
	else {
		// Restore movement, solid and model parameters
		if(self.spawnflags & ad_ITEM_FLOATING) self.movetype = ad_MOVETYPE_NONE;
		else self.movetype = ad_MOVETYPE_TOSS;
		self.solid = ad_SOLID_TRIGGER;
		setmodel(self,self.mdl);
		setsize (self, self.ad_bbmins, self.ad_bbmaxs);
		self.velocity = '0 0 0';
		// Restore particle emitter
		if (self.ad_part_emitter) ad_misc_particle_on(self.ad_part_emitter);
		// Setup touch/damage/bounding box functionality
		self.think = ad_SUB_Null;
		ad_item_restore();
	}
};

//----------------------------------------------------------------------
void() ad_item_off = 
{
	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel(self,"");
	self.effects = 0;
	setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	// If item was setup to float then it will be trigger item
	// Don't reset origin as it might have fallen somewhere better
	if( !(self.spawnflags & ad_ITEM_FLOATING) ) setorigin(self, self.oldorigin);
	
	if (self.ad_attachment) {
		setmodel(self.ad_attachment,"");
		setsize(self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	}
};

//----------------------------------------------------------------------
void() ad_item_estate_setup =
{
	// check for map hacks (redirects to item_delay)
	if (self.use == ad_SUB_regen) self.use = ad_SUB_regen;
	// Setup Entity State functionality
	else if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_item_on;
	self.ad_estate_off = ad_item_off;
	self.ad_estate_use = ad_item_delay;
	self.ad_estate_reset = ad_item_reset;
};

//----------------------------------------------------------------------
void() ad_item_start =
{
	self.oldorigin = self.origin;		// Save origin
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	self.flags = self.flags | ad_FL_ITEM;

	// Warning if effects flag is active before spawning
	if (self.effects) {
		dprint("\b[ITEM]\b Effects flag active\n");
		self.ad_savedeffects = self.effects;
	}
	// Reset effects flag because some engines will show effects
	// This is especially obvious for delay spawned items
	self.effects = 0;
	
	// If respawn timer negative then wait for a trigger
	if (self.ad_respawn_time < 0) self.ad_respawn_trig = ad_TRUE;
	// Respawn times < 1 break sound and particle spawners
	if (self.ad_respawn_time > 0 && self.ad_respawn_time < 1) self.ad_respawn_time = 1;
	// Cannot start with a negative number for counting down
	if (self.ad_respawn_count < 0) self.ad_respawn_count = 1;

	// Override default item pickup sound with silence?
	// It would have been good to offer the other sounds (1-6)
	// on all items, but there is a good chance that a mapper
	// has left a rogue sounds key on some item somewhere!
	if (self.sounds == 4) self.noise = ad_SOUND_EMPTY;

	// Check if item is part of a progression spawner list
	// Hide all progression items, only required for caching
	if (self.ad_progspawnlist) ad_item_proglist_setup(self);
	else {
		// Check for spawning conditions (nightmare, coop)
		if (ad_check_nightmare() == ad_TRUE) return;
		if (ad_check_coop() == ad_TRUE) return;
	
		// Setup Entity State functionality
		ad_item_estate_setup();

		if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
		else {
			// delay drop to floor to make sure all doors have been spawned
			// spread think times so they don't all happen at same time
			self.nextthink = time + 0.1 + random()*0.5;
			self.think = self.ad_estate_use;
		}
	}
};

//======================================================================
// HEALTH FLASK/BOX
//======================================================================
float(entity ad_hpplayer, entity ad_hpitem) ad_health_pickupcondition =
{
	// Simple test first, player dead?
	if (ad_hpplayer.health <= 0) return ad_TRUE;
	
	// Mega Health pickups are awkward because the player can keep
	// picking them up, unless they are at max HP already!
	if (ad_hpitem.ad_classtype == ad_CT_HEALMEGA) {
		if (ad_hpplayer.health >= ad_hpplayer.ad_mega_health) return ad_TRUE;
	}
	// Regular Health pack can be wasteful with amount
	else if (ad_hpplayer.health >= ad_hpplayer.max_health) return ad_TRUE;
	// Health Pack good to use!
	return ad_FALSE;
};

//----------------------------------------------------------------------
// targ - entity to receive healing
// t_healamount - the quanity to heal entity with
// ignore - whether to ignore max health amount
// returns FALSE if cannot heal entity by healamount
// returns TRUE if healamount applied
//
float (entity ad_targ, float ad_t_healamount, float ad_ignore) ad_T_Heal =
{
	if (ad_targ.health <= 0) return ad_FALSE;
	if ((!ad_ignore) && (ad_targ.health >= other.max_health)) return ad_FALSE;
	ad_t_healamount = ceil(ad_t_healamount);
	
	ad_targ.health = ad_targ.health + ad_t_healamount;
	if ((!ad_ignore) && (ad_targ.health >= other.max_health))
		ad_targ.health = other.max_health;
		
	if (ad_targ.health > ad_targ.ad_mega_health) ad_targ.health = ad_targ.ad_mega_health;
	return ad_TRUE;
};

//----------------------------------------------------------------------
void() ad_health_touch =
{
	local string ad_s;

	// Megahealth?  Ignore max_health...
	if (self.ad_classtype == ad_CT_HEALMEGA) {
		if (other.health >= other.ad_mega_health) return;
		if (!ad_T_Heal(other, self.healamount, 1)) return;
	}
	else { 
		if (!ad_T_Heal(other, self.healamount, 0)) return;
	}
		
	// Check for randomizer megahealth
	ad_health_touchrandomizer();

	// Healing the player negates some debuffs
	ad_ResetDebuffBurning(other);
	ad_ResetDebuffPoisoned(other);

	sprint(other, "You receive ");
	ad_s = ftos(self.healamount);
	sprint(other, ad_s);
	sprint(other, " health\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound(other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");
	
	ad_activator = other;
	ad_SUB_UseTargets();

	// Megahealth = rot down the player's super health
	// Moved functionality to debuff (rotting) system
	// Rotting_Qty is set to zero (default) on item spawn
	if (self.ad_classtype == ad_CT_HEALMEGA) ad_RotDeBuff(other, self.ad_rotting_qty);

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;

	ad_item_finished();
	ad_check_item_respawn();
};	

//----------------------------------------------------------------------
/*ad:QUAKED item_health (0.3 0.3 1) (-16 -16 0) (16 16 32) ROTTEN MEGA x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/health_25.mdl"); }
15, 25 or 100 Health
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
angle         : = -1 Random rotation everytime spawned (default)
skin_override : Override world type 1=Base Green, 2=Medieval Wood
healamount    : Override heal quantity for pickup (def=15/25/100)
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
ROTTEN   : 15 health
MEGA     : MegaHealth +100 health, rot down to 100
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Health box gives 15, 25 or 100 points depending on spawnflags.
*/
//----------------------------------------------------------------------
void() ad_item_health =
{
	// Check for any random monster setups
	if (ad_health_checkrandomizer() == ad_TRUE) return;
	
	if (self.spawnflags & ad_H_ROTTEN) {
		// worldtype 0 = medieval, 1 = metal, 2 = base
		if (ad_item_skintype(self) == ad_SKIN_MEDIEVAL) {
			// New Medieval style red flask
			self.mdl = ad_MODEL_HEAL15;
			self.ad_respawn_style = ad_PARTICLE_BURST_RED + ad_PARTICLE_BURST_RING;
		}
		else {
			// Original ID pickup model
			self.mdl = ad_MODEL_HEAL15B;
			self.ad_respawn_style = ad_PARTICLE_BURST_WHITE + ad_PARTICLE_BURST_RING;
		}
		self.noise = ad_SOUND_HEAL15;
		if (self.healamount < 1) self.healamount = ad_HEAL_ROT;
		self.ad_classtype = ad_CT_HEALROT;
		self.ad_respawn_effect = ad_TRUE;
		self.ad_respawn_ofs = '0 0 16';
	}
	else if (self.spawnflags & ad_H_MEGA) {
		if (ad_item_skintype(self) == ad_SKIN_MEDIEVAL) {
		// New Medieval style red flask
			self.mdl = ad_MODEL_HEAL100;
			self.ad_respawn_style = ad_PARTICLE_BURST_RED + ad_PARTICLE_BURST_RING;
		}
		else {
			// Original ID pickup model
			self.mdl = ad_MODEL_HEAL100B;
			self.ad_respawn_style = ad_PARTICLE_BURST_WHITE + ad_PARTICLE_BURST_RING;
			self.ad_item_skinanim = ad_TRUE;
		}
		self.noise = ad_SOUND_HEAL100;
		if (self.healamount < 1) self.healamount = ad_HEAL_MEGA;
		self.ad_classtype = ad_CT_HEALMEGA;
		self.ad_part_active = ad_PARTICLE_STYLE_MEGAH;
		self.ad_respawn_effect = ad_TRUE;
		self.ad_respawn_ofs = '0 0 28';
		// Use default rotting value
		self.ad_rotting_qty = 0;
	}
	else {
		if (ad_item_skintype(self) == ad_SKIN_MEDIEVAL) {
			// New Medieval style red flask
			self.mdl = ad_MODEL_HEAL25;
			self.ad_respawn_style = ad_PARTICLE_BURST_RED + ad_PARTICLE_BURST_RING;
			self.ad_respawn_ofs = '0 0 24';
		}
		else {
			// Original ID pickup model
			self.mdl = ad_MODEL_HEAL25B;
			self.ad_respawn_style = ad_PARTICLE_BURST_WHITE + ad_PARTICLE_BURST_RING;
			self.ad_respawn_ofs = '0 0 16';
			self.ad_item_skinanim = ad_TRUE;
		}
		self.noise = ad_SOUND_HEAL25;
		if (self.healamount < 1) self.healamount = ad_HEAL_NORM;
		self.ad_classtype = ad_CT_HEALNORM;
		self.ad_respawn_effect = ad_TRUE;
	}

	precache_model(self.mdl);
	precache_sound(self.noise);

	// Query console variable 'temp1' for model upgrade option.
	// Cannot use global vars because they don't exist at this point
	// Move the new centered ammo models to match old ammo origin
	// The default is to move all ammo items to suit original id maps
	if (ad_query_configflag(ad_SVR_ITEMOFFSET) == ad_FALSE) {
		self.oldorigin = self.origin + '16 16 0';
		setorigin(self, self.oldorigin);
	}

	// An old worldspawn key (not used anymore)
	// This is backward compatibility with this key
	// Will force all items to have an angle
	if (world.ad_no_item_rotate && self.angles_y == 0) self.angles_y = 360;	
	
	// Setting the angle key in the editor to UP/DOWN/0 = random rotation	
	if (self.angles_y <= 0) self.angles_y = rint(random()*359);

	self.ad_touch2 = ad_health_touch;
	self.ad_classgroup = ad_CG_HEALTH;
	self.ad_bbmins = ad_VEC_HEAL_MIN;
	self.ad_bbmaxs = ad_VEC_HEAL_MAX;
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_HEALTH;

	// Check for coop errors
	ad_item_coopcheck();
	ad_item_start ();
};

//----------------------------------------------------------------------
/*ad:QUAKED item_healthvial (0.3 0.3 1) (-8 -8 0) (8 8 32) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/health_5.mdl"); }
Health item giving 2-5 points
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
angle         : = -1 Random rotation everytime spawned (default)
healamount    : Override heal quantity for pickup (def=2+random*3)
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
RESPAWN   : Can respawn after being picked up
FLOAT     : No drop to floor test
STARTOFF  : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Health item giving 5 points
*/
//----------------------------------------------------------------------
void() ad_item_healthvial =
{
	self.ad_classtype = ad_CT_HEALVIAL;
	self.ad_respawn_effect = ad_TRUE;
	self.ad_respawn_ofs = '0 0 20';

	self.mdl = ad_MODEL_HEAL5;
	//if (self.healamount < 1) self.healamount = HEAL_GEM;
	if (self.healamount < 1) self.healamount = rint(2 + (random() * 3));
	self.noise = ad_SOUND_HEAL05;

	precache_model(self.mdl);
	precache_sound(self.noise);
	self.ad_respawn_style = ad_PARTICLE_BURST_RED + ad_PARTICLE_BURST_CENTER;

	self.ad_touch2 = ad_health_touch;
	self.ad_classgroup = ad_CG_HEALTH;
	self.ad_bbmins = '-8 -8 0';
	self.ad_bbmaxs = '8 8 32';
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_HEALTH;

	// Check for coop errors
	ad_item_coopcheck();
	ad_item_start ();
};

// Used to be called a gem, renamed to vial
void() ad_item_healthgem = { ad_item_healthvial(); }

//======================================================================
// armor_touch
//======================================================================
float(entity ad_armplayer, entity ad_armitem) ad_armor_pickupcondition =
{
	local float ad_arm1, ad_arm2;
	
	ad_arm1 = ad_armplayer.armortype * ad_armplayer.armorvalue;
	ad_arm2 = ad_armitem.armortype * ad_armitem.armorvalue;
	
	if (ad_arm1 >= ad_arm2) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
void() ad_armor_touch =
{
	// Cannot pickup armour if wearing something better!
	if (ad_armor_pickupcondition(other, self)) return;

	// Check for randomizer pickup conditions
	ad_armour_touchrandomizer();
	
	other.armortype = self.armortype;
	other.armorvalue = self.armorvalue;
	other.items = other.items - (other.items & (ad_IT_ARMOR1 | ad_IT_ARMOR2 | ad_IT_ARMOR3)) + self.items;

	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other, "\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound(other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");
	
	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;
	
	ad_item_finished();
	ad_check_item_respawn();
};

//----------------------------------------------------------------------
void() ad_item_armor_setup =
{
	self.ad_classgroup = ad_CG_ARMOR;
	self.ad_part_active = ad_PARTICLE_STYLE_ARMOR;
	self.ad_touch2 = ad_armor_touch;
	self.ad_bbmins = '-16 -16 0';
	self.ad_bbmaxs = '16 16 56';
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_ARMOR;
	self.noise = "items/armor1.wav";

	// Check for coop errors
	ad_item_coopcheck();
	ad_item_start ();
};

