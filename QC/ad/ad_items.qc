RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS: No particle or effects active
-------- NOTES --------
Primary   : Player takes no HP/armour damage from lava
Secondary : Flame and lava attack damage is reduced (Chthon, Drole, Gargoyle, Quoth Dguard)

======================================================================*/
void() ad_item_artifact_lavashield =
{
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.mdl == "") self.mdl = "progs/artifact_lavashield.mdl";
	precache_model (self.mdl);
	if (self.noise == "") self.noise = ad_SOUND_ARTLSHIELD1;
	precache_sound (self.noise);
	precache_sound ((self.noise1 = ad_SOUND_ARTLSHIELD2));
	precache_sound ((self.noise2 = ad_SOUND_ARTLSHIELD3));
	if (self.netname == "") self.netname = "Aegis of Chthon";
	self.items = 0;
	self.ad_moditems = ad_IT_ARTLAVASHIELD;
	self.ad_classtype = ad_CT_ARTLAVASHIELD;
	self.ad_part_active = ad_PARTICLE_STYLE_LAVASHIELD;
	self.ad_respawn_style = ad_PARTICLE_BURST_RED + ad_PARTICLE_BURST_CENTER;
	self.ad_respawn_ofs = '0 0 16';

	// Default = Infinite vania item
	if (self.cnt <= 0) self.cnt = ad_POWERUP_VANIA;
	// Default volume = 1
	if (self.volume < 0) self.volume = 0;
	else if (self.volume < 0.1) self.volume = 1;

	ad_artifact_setup();
};

//======================================================================
/*ad:QUAKED item_artifact_blastbelt (0 0.5 0.8) (-16 -16 -24) (16 16 32) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/artifact_blastbelt.mdl"); }
Player does not take splash damage, but take direct damage
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
message       : centerprint message when item is picked up
mdl           : Override the model used (def=progs/artifact_blastbelt.mdl)
netname       : Override name of pickup (def=Blast Belt)
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig  : = 1 Wait for trigger before respawning
noise         : Custom pickup sound for powerup
volume        : Maximum range for volume (def=1, no sound=-1)
cnt           : override duration of artifact (def=infinite)
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Primary   : Player does not take splash damage, but take direct damage
Secondary : Immune to floor impact attacks (hammer ogre, golems etc)

======================================================================*/
void() ad_item_artifact_blastbelt =
{
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.mdl == "") self.mdl = "progs/artifact_blastbelt.mdl";
	precache_model (self.mdl);
	if (self.noise == "") self.noise = ad_SOUND_ARTBLASTBELT1;
	precache_sound (self.noise);
	precache_sound ((self.noise1 = ad_SOUND_ARTBLASTBELT2));
	precache_sound ((self.noise2 = ad_SOUND_ARTBLASTBELT3));
	if (self.netname == "") self.netname = "Blast Belt";
	self.items = 0;
	self.ad_moditems = ad_IT_ARTBLASTBELT;
	self.ad_classtype = ad_CT_ARTBLASTBELT;
	
	self.ad_respawn_ofs = '0 0 8';
	self.ad_part_active = ad_PARTICLE_STYLE_BLASTBELT;
	self.ad_respawn_style = ad_PARTICLE_BURST_BLUE + ad_PARTICLE_BURST_CENTER;

	// Default = Infinite vania item
	if (self.cnt <= 0) self.cnt = ad_POWERUP_VANIA;
	// Default volume = 1
	if (self.volume < 0) self.volume = 0;
	else if (self.volume < 0.1) self.volume = 1;
	
	ad_artifact_setup();
};

//======================================================================
/*ad:QUAKED item_artifact_jumpboots (0 0.5 0.8) (-16 -16 -24) (16 16 32) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/artifact_jumpboots.mdl"); }
Player can do (1-4) extra jumps
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
message       : centerprint message when item is picked up
mdl           : Override the model used (def=progs/artifact_jumpboots.mdl)
netname       : Override name of pickup (def=Jump Boots 1+)
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig  : = 1 Wait for trigger before respawning
noise         : Custom pickup sound for powerup
count         : Power level override (0=def, 1-4=exact level, -1=endless)
height        : 2nd+ player jump height upward (def=320)
distance      : Minimum forward momentum (def=0, recommend=320)
volume        : Maximum range for volume (def=1, no sound=-1)
cnt           : override duration of artifact (def=infinite)
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Primary   : Player can do (1-4) extra jumps
Secondary : Can jump while falling off ledges or midair

======================================================================*/
void() ad_item_artifact_jumpboots =
{
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.mdl == "") self.mdl = "progs/artifact_jumpboots.mdl";
	precache_model (self.mdl);
	if (self.noise == "") self.noise  = ad_SOUND_ARTJUMPBOOTS1;
	precache_sound (self.noise);
	// sounds 3a-3c are used in client.qc (lines 915+)
	precache_sound ((self.noise1 = ad_SOUND_ARTJUMPBOOTS2));
	precache_sound ((self.noise2 = ad_SOUND_ARTJUMPBOOTS3A));	// First jump
	precache_sound ((self.noise3 = ad_SOUND_ARTJUMPBOOTS3B));	// Second
	precache_sound ((self.noise4 = ad_SOUND_ARTJUMPBOOTS3C));	// No more
	
	self.items = 0;
	self.ad_moditems = ad_IT_ARTJUMPBOOTS;
	self.ad_classtype = ad_CT_ARTJUMPBOOTS;
	self.ad_part_active = ad_PARTICLE_STYLE_JUMPBOOTS;
	self.ad_respawn_style = ad_PARTICLE_BURST_YELLOW + ad_PARTICLE_BURST_CENTER;
	self.ad_respawn_ofs = '0 0 10';

	// Make sure count is within range 1-4
	if (self.count < -1 || self.count > ad_ART_JUMPBOOTS_AIRMAX) self.count = 1;	
	// Setup more descriptive pickup names
	if (self.count == 2) self.netname = "Jump Boots +2";
	else if (self.count == 3) self.netname = "Jump Boots +3";
	else if (self.count == 4) self.netname = "Jump Boots +4";
	// Default name (count == 1)
	else self.netname = "Jump Boots";

	// Default = Infinite vania item
	if (self.cnt <= 0) self.cnt = ad_POWERUP_VANIA;
	// Default volume = 1
	if (self.volume < 0) self.volume = 0;
	else if (self.volume < 0.1) self.volume = 1;
	
	ad_artifact_setup();
};

//======================================================================
// ITEM BACKPACKS
// * Dropped from monsters and players
// * Can be setup as an item with random ammo/armour
// * Will monitor ground below so can fall further
//
//======================================================================
float(entity ad_backent, string ad_backtext1, string ad_backtext2, float ad_backcomma) ad_BackpackText =
{
	if (ad_backcomma > 0) sprint (ad_backent, ", ");
	if (ad_backtext1 != "") sprint (ad_backent, ad_backtext1);
	if (ad_backtext2 != "") sprint (ad_backent, ad_backtext2);
	return 1;
};

//----------------------------------------------------------------------
void() ad_BackpackTouch =
{
	local string ad_s;
	local float ad_pickupweapon, ad_acount;
	
	ad_acount = 0;
	sprint (other, "You get ");

	//----------------------------------------------------------------------
	// A Coop player can pickup all of the weapons
	// dropped by previous player (go through list)
	//----------------------------------------------------------------------
	if (coop > 0) {
		if (self.ad_moditems & ad_IT_UPGRADE_AXE && !(other.ad_moditems & ad_IT_UPGRADE_AXE)) {
			ad_pickupweapon = ad_IT_UPGRADE_AXE;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "ShadowAxe", "", ad_acount);
			other.ad_moditems = other.ad_moditems | ad_pickupweapon;
			ad_update_configflag(ad_SVR_UPDAXE, ad_TRUE);
		}
		
		if (self.items & ad_IT_SHOTGUN && !(other.items & ad_IT_SHOTGUN)) {
			ad_pickupweapon = ad_IT_SHOTGUN;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "SG", "", ad_acount);
		}
		
		if (self.ad_moditems & ad_IT_UPGRADE_SSG && !(other.ad_moditems & ad_IT_UPGRADE_SSG)) {
			ad_pickupweapon = ad_IT_UPGRADE_SSG;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "WidowMaker", "", ad_acount);
			other.ad_moditems = other.ad_moditems | ad_pickupweapon;
			ad_update_configflag(ad_SVR_UPDSSG, ad_TRUE);
		}
		else if (self.items & ad_IT_SUPER_SHOTGUN && !(other.items & ad_IT_SUPER_SHOTGUN)) {
			ad_pickupweapon = ad_IT_SUPER_SHOTGUN;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "SSG", "", ad_acount);
		}
		
		if (self.items & ad_IT_NAILGUN && !(other.items & ad_IT_NAILGUN)) {
			ad_pickupweapon = ad_IT_NAILGUN;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "NG", "", ad_acount);
		}
		if (self.items & ad_IT_SUPER_NAILGUN && !(other.items & ad_IT_SUPER_NAILGUN)) {
			ad_pickupweapon = ad_IT_SUPER_NAILGUN;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "SNG", "", ad_acount);
		}
		if (self.items & ad_IT_GRENADE_LAUNCHER && !(other.items & ad_IT_GRENADE_LAUNCHER)) {
			ad_pickupweapon = ad_IT_GRENADE_LAUNCHER;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "GL", "", ad_acount);
		}
		if (self.items & ad_IT_ROCKET_LAUNCHER && !(other.items & ad_IT_ROCKET_LAUNCHER)) {
			ad_pickupweapon = ad_IT_ROCKET_LAUNCHER;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "RL", "", ad_acount);
		}
		
		if (self.ad_moditems & ad_IT_UPGRADE_LG && !(other.ad_moditems & ad_IT_UPGRADE_LG)) {
			ad_pickupweapon = ad_IT_UPGRADE_LG;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "PlasmaGun", "", ad_acount);
			other.ad_moditems = other.ad_moditems | ad_pickupweapon;
			ad_update_configflag(ad_SVR_UPDLG, ad_TRUE);
		}
		else if (self.items & ad_IT_LIGHTNING && !(other.items & ad_IT_LIGHTNING)) {
			ad_pickupweapon = ad_IT_LIGHTNING;
			other.items = other.items | ad_pickupweapon;
			ad_acount = ad_BackpackText(other, "LG", "", ad_acount);
		}
	}
	// DM backpacks have only one weapon
	else {
		// Setup name of weapon first
		if (self.items & ad_IT_LIGHTNING && self.ad_moditems & ad_IT_UPGRADE_LG)
			self.netname = "Plasma Gun";
		else if (self.items & ad_IT_LIGHTNING) self.netname = "Thunderbolt";
		else if (self.items & ad_IT_ROCKET_LAUNCHER) self.netname = "Rocket Launcher";
		else if (self.items & ad_IT_GRENADE_LAUNCHER) self.netname = "Grenade Launcher";
		else if (self.items & ad_IT_SUPER_NAILGUN) self.netname = "Super Nailgun";
		else if (self.items & ad_IT_NAILGUN) self.netname = "Nailgun";
		else if (self.items & ad_IT_SUPER_SHOTGUN && self.ad_moditems & ad_IT_UPGRADE_SSG) 
			self.netname = "Widow Maker Shotgun";
		else if (self.items & ad_IT_SUPER_SHOTGUN) self.netname = "Double-barrelled Shotgun";
		else if (self.items & ad_IT_SHOTGUN) self.netname = "Shotgun";
		else if (self.items & ad_IT_AXE && self.ad_moditems & ad_IT_UPGRADE_AXE) 
			self.netname = "Shadow Axe";
		else if (self.items & ad_IT_AXE) self.netname = "Axe";
		else self.netname = "";
		
		// Check if the player has the weapon already?
		if ((other.items & self.items) == 0 && self.netname != "") {
			other.items = other.items | self.items;
			other.ad_moditems = other.ad_moditems | self.ad_moditems;
			ad_acount = ad_BackpackText(other, "the", self.netname, ad_acount);
		}
	}

	//----------------------------------------------------------------------
	// Calculate random amounts of ammo
	//----------------------------------------------------------------------
	if (self.count > 0) {
		if (self.spawnflags & ad_BACKPACK_SHELLS) self.ammo_shells = rint(1 + random()*self.count);
		if (self.spawnflags & ad_BACKPACK_NAILS) self.ammo_nails = rint(1 + random()*self.count);
		if (self.spawnflags & ad_BACKPACK_ROCKETS) self.ammo_rockets = rint(1 + random()*self.count);
		if (self.spawnflags & ad_BACKPACK_CELLS) self.ammo_cells = rint(1 + random()*self.count);
		if (self.armortype == 1) self.armorvalue = rint(1 + random()*self.count);
	}

	//----------------------------------------------------------------------
	// Give ammo to player
	//----------------------------------------------------------------------
	if (self.ammo_shells > 0) {
		other.ammo_shells = other.ammo_shells + self.ammo_shells;
		other.items = other.items | ad_IT_SHELLS;
		ad_s = ftos(self.ammo_shells);
		ad_acount = ad_BackpackText(other, ad_s, " shells", ad_acount);
	}
	if (self.ammo_nails > 0) {
		other.ammo_nails = other.ammo_nails + self.ammo_nails;
		other.items = other.items | ad_IT_NAILS;
		ad_s = ftos(self.ammo_nails);
		ad_acount = ad_BackpackText(other, ad_s, " nails", ad_acount);
	}
	if (self.ammo_rockets > 0) {
		other.ammo_rockets = other.ammo_rockets + self.ammo_rockets;
		other.items = other.items | ad_IT_ROCKETS;
		ad_s = ftos(self.ammo_rockets);
		ad_acount = ad_BackpackText(other, ad_s, " rockets", ad_acount);
	}
	if (self.ammo_cells > 0) {
		other.ammo_cells = other.ammo_cells + self.ammo_cells;
		other.items = other.items | ad_IT_CELLS;
		ad_s = ftos(self.ammo_cells);
		ad_acount = ad_BackpackText(other, ad_s, " cells", ad_acount);
	}
	
	//----------------------------------------------------------------------
	// Check for armor in backpack
	//----------------------------------------------------------------------
	if (self.armorvalue > 0 && deathmatch == 0) {
		// For coop backpacks can be dropped from players
		// These can contain huge amounts of armour and needed
		// to be treated as upgrade/replace, not the shard system
		if (coop > 0 && self.items & ad_IT_ALLARMOR) {
			if (other.armortype*other.armorvalue < self.armortype*self.armorvalue) {
				other.armortype = self.armortype;
				other.armorvalue = self.armorvalue;
				other.items = other.items - (other.items & ad_IT_ALLARMOR);
				other.items = other.items + (self.items & ad_IT_ALLARMOR);
				ad_acount = ad_BackpackText(other, "armor upgraded", "", ad_acount);
			}
		}
		else {
			// For Singleplayer backpack items can contain shards
			// Shards add to the armour value and can go above limit
			// If no armour present (add a green jacket)
			other.armorvalue = other.armorvalue + self.armorvalue;

			// Yellow armour upgrade
			// Only update armour type if green armour present
			if (self.armortype == ad_ARMOR_YEL_TYPE) {
				if (other.items & ad_IT_ARMOR1 || other.armortype == 0) {
					other.items = other.items - (other.items & ad_IT_ARMOR1);
					other.items = other.items | ad_IT_ARMOR2;
					other.armortype = ad_ARMOR_YEL_TYPE;
				}
			}
			// Red armour upgrade
			// Remove previous armour type (hud display flag)
			else if (self.armortype == ad_ARMOR_RED_TYPE) {
				other.items = other.items - (other.items & ad_IT_ARMOR1);
				other.items = other.items - (other.items & ad_IT_ARMOR2);
				other.items = other.items | ad_IT_ARMOR3;
				other.armortype = ad_ARMOR_RED_TYPE;
			}
			// Does the player have any armor already?
			else if (other.armortype == 0 ) {
				// No armor present, give green with armor shards
				other.items = other.items | ad_IT_ARMOR1;
				other.armortype = ad_ARMOR_GRN_TYPE;
			}
			
			if (self.armorvalue > 0) {
				ad_s = ftos(self.armorvalue);
				ad_acount = ad_BackpackText(other, ad_s, " armor shards", ad_acount);
			}
		}
	}
	
	//----------------------------------------------------------------------
	// Check for Silver/Gold/Custom keys if coop active
	//----------------------------------------------------------------------
	if (coop > 0) {
		if (self.items & ad_IT_KEY1) {
			other.items = other.items | ad_IT_KEY1;
			ad_acount = ad_BackpackText(other, "Silver Key", "", ad_acount);
		}
		if (self.items & ad_IT_KEY2) {
			other.items = other.items | ad_IT_KEY2;
			ad_acount = ad_BackpackText(other, "Gold Key", "", ad_acount);
		}
		if (self.ad_moditems & ad_IT_CKEY1) {
			other.ad_moditems = other.ad_moditems | ad_IT_CKEY1;
			other.ad_ckeyname1 = self.ad_ckeyname1;
			ad_acount = ad_BackpackText(other, self.ad_ckeyname1, "", ad_acount);
		}
		if (self.ad_moditems & ad_IT_CKEY2) {
			other.ad_moditems = other.ad_moditems | ad_IT_CKEY2;
			other.ad_ckeyname2 = self.ad_ckeyname2;
			ad_acount = ad_BackpackText(other, self.ad_ckeyname2, "", ad_acount);
		}
		if (self.ad_moditems & ad_IT_CKEY3) {
			other.ad_moditems = other.ad_moditems | ad_IT_CKEY3;
			other.ad_ckeyname3 = self.ad_ckeyname3;
			ad_acount = ad_BackpackText(other, self.ad_ckeyname3, "", ad_acount);
		}
		if (self.ad_moditems & ad_IT_CKEY4) {
			other.ad_moditems = other.ad_moditems | ad_IT_CKEY4;
			other.ad_ckeyname4 = self.ad_ckeyname4;
			ad_acount = ad_BackpackText(other, self.ad_ckeyname4, "", ad_acount);
		}
	}

	//----------------------------------------------------------------------
	// Check for Powerups if coop active
	//----------------------------------------------------------------------
	if (coop > 0) {
		if (self.items & ad_IT_INVISIBILITY) {
			other.items = other.items | ad_IT_INVISIBILITY;
			ad_acount = ad_BackpackText(other, "InvRing", "", ad_acount);
			other.ad_invisible_finished = self.ad_invisible_finished;
			other.ad_invisible_time = self.ad_invisible_time;
			other.ad_invisible_sound = self.ad_invisible_sound;
		}
		if (self.items & ad_IT_SUIT) {
			other.items = other.items | ad_IT_SUIT;
			ad_acount = ad_BackpackText(other, "EnvSuit", "", ad_acount);
			other.ad_radsuit_finished = self.ad_radsuit_finished;
			other.ad_rad_time = self.ad_rad_time;
		}
		if (self.items & ad_IT_QUAD) {
			other.items = other.items | ad_IT_QUAD;
			ad_acount = ad_BackpackText(other, "QuadDam", "", ad_acount);
			other.super_damage_finished = self.super_damage_finished;
			other.super_time = self.super_time;
			other.ad_super_sound = self.ad_super_sound;
		}
		if (self.ad_moditems & ad_IT_ARTSHARP) {
			other.ad_moditems = other.ad_moditems | ad_IT_ARTSHARP;
			ad_acount = ad_BackpackText(other, "ShpShoot", "", ad_acount);
			other.ad_sharpshoot_finished = self.ad_sharpshoot_finished;
			other.ad_sharpshoot_time = self.ad_sharpshoot_time;
			other.ad_sharpshooter_sound = self.ad_sharpshooter_sound;
		}
		if (self.ad_moditems & ad_IT_ARTPIERCE) {
			other.ad_moditems = other.ad_moditems | ad_IT_ARTPIERCE;
			ad_acount = ad_BackpackText(other, "Piercer", "", ad_acount);
			other.ad_nailpiercer_finished = self.ad_nailpiercer_finished;
			other.ad_nailpiercer_time = self.ad_nailpiercer_time;
			other.ad_nailpiercer_sound = self.ad_nailpiercer_sound;
		}		
		if (self.ad_moditems & ad_IT_ARTAIRTANK) {
			other.ad_moditems = other.ad_moditems | ad_IT_ARTAIRTANK;
			ad_acount = ad_BackpackText(other, "AirTank", "", ad_acount);
			other.ad_airtank_finished = self.ad_airtank_finished;
			other.ad_airtank_time = self.ad_airtank_time;
			other.ad_airtank_sound = self.ad_airtank_sound;
		}
		if (self.ad_moditems & ad_IT_ARTJUMPBOOTS) {
			other.ad_moditems = other.ad_moditems | ad_IT_ARTJUMPBOOTS;
			ad_acount = ad_BackpackText(other, "JumpBoots", "", ad_acount);
			other.ad_jumpboots_finished = self.ad_jumpboots_finished;
			other.ad_jumpboots_time = self.ad_jumpboots_time;
			other.ad_jumpboots_airlvl = self.ad_jumpboots_airlvl;
			other.ad_jumpboots_airmax = self.ad_jumpboots_airmax;
		}
	}

	sprint (other, " from a backpack\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");

	// Check ammo limts, change to best weapon and set ammo type
	ad_bound_other_ammo (other);
	if (deathmatch) other.weapon = ad_W_BestWeapon(other);
	ad_W_SetCurrentAmmo (other);
	
	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;

	// Random ammo backpacks are actual items
	if (self.ad_classtype == ad_CT_AMMOITEMPACK) {
		// hide item and check for respawn
		ad_item_finished();
		ad_check_item_respawn();
	}
	// Temporary backpack
	else remove(self);
};

//----------------------------------------------------------------------
void() ad_DropBackpack =
{
	local entity ad_item;

	//----------------------------------------------------------------------
	// Check for player because of other items
	if (self.ad_classtype != ad_CT_PLAYER) {
		if (!(self.ammo_shells + self.ammo_nails + self.ammo_rockets + self.ammo_cells))
			return;	// nothing in it
	}

	ad_item = spawn();
	ad_item.ad_classtype = ad_CT_AMMODROPPACK;
	ad_item.ad_classgroup = ad_CG_AMMOITEM;
	ad_item.classname = "item_backpack";
	ad_item.origin = self.origin - '0 0 20';
	// No way to cache something different without adding to world.qc
	// Default quake sound for backpacks dropped from monsters
	ad_item.noise = ad_AMMO_PICKUP;
	
	//----------------------------------------------------------------------
	// Pyro Enforcers drop armor shards instead!!!
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONPYRO || self.ad_classtype == ad_CT_MONFUMIGATOR) 
		ad_item.armorvalue = floor(1 + (random() * self.ammo_shells));
	else {
		// Everything else drops ammo
		ad_item.ammo_shells = self.ammo_shells;
		ad_item.ammo_nails = self.ammo_nails;
		ad_item.ammo_rockets = self.ammo_rockets;
		ad_item.ammo_cells = self.ammo_cells;
	}

	//----------------------------------------------------------------------
	// Reset backpack inventory before any test
	ad_item.items = ad_item.ad_moditems = ad_item.ad_customkey = 0;

	//----------------------------------------------------------------------
	// If player dropping backpack check for extra stuff
	if (self.ad_classtype == ad_CT_PLAYER) {
		// Copy over items for coop players to pickup
		if (coop > 0) {
			// Copy all items + keys
			ad_item.items = self.items;
			ad_item.ad_moditems = self.ad_moditems;
			ad_item.ad_customkey = self.ad_customkey;
			// Copy current armour type + value
			ad_item.armortype = self.armortype;
			ad_item.armorvalue = self.armorvalue;
			
			// Copy over custom key netnames
			if (self.ad_moditems & ad_IT_CKEY1) ad_item.ad_ckeyname1 = self.ad_ckeyname1;
			if (self.ad_moditems & ad_IT_CKEY2) ad_item.ad_ckeyname2 = self.ad_ckeyname2;
			if (self.ad_moditems & ad_IT_CKEY3) ad_item.ad_ckeyname3 = self.ad_ckeyname3;
			if (self.ad_moditems & ad_IT_CKEY4) ad_item.ad_ckeyname4 = self.ad_ckeyname4;
			
			//----------------------------------------------------------------------
			// Copy over any powerup timers
			// Cannot die with invulnerability so not checked!
			if (ad_coop_artifacts == ad_TRUE) {
				if (self.items & ad_IT_INVISIBILITY) {
					ad_item.ad_invisible_finished = self.ad_invisible_finished;
					ad_item.ad_invisible_time = self.ad_invisible_time;
					ad_item.ad_invisible_sound = self.ad_invisible_sound;
				}
				if (self.items & ad_IT_SUIT) {
					ad_item.ad_radsuit_finished = self.ad_radsuit_finished;
					ad_item.ad_rad_time = self.ad_rad_time;
				}
				if (self.items & ad_IT_QUAD) {
					ad_item.super_damage_finished = self.super_damage_finished;
					ad_item.super_time = self.super_time;
					ad_item.ad_super_sound = self.ad_super_sound;
				}
				if (self.ad_moditems & ad_IT_ARTSHARP) {
					ad_item.ad_sharpshoot_finished = self.ad_sharpshoot_finished;
					ad_item.ad_sharpshoot_time = self.ad_sharpshoot_time;
					ad_item.ad_sharpshooter_sound = self.ad_sharpshooter_sound;
				}
				if (self.ad_moditems & ad_IT_ARTPIERCE) {
					ad_item.ad_nailpiercer_finished = self.ad_nailpiercer_finished;
					ad_item.ad_nailpiercer_time = self.ad_nailpiercer_time;
					ad_item.ad_nailpiercer_sound = self.ad_nailpiercer_sound;
				}
				if (self.ad_moditems & ad_IT_ARTAIRTANK) {
					ad_item.ad_airtank_finished = self.ad_airtank_finished;
					ad_item.ad_airtank_time = self.ad_airtank_time;
					ad_item.ad_airtank_sound = self.ad_airtank_sound;
				}
				if (self.ad_moditems & ad_IT_ARTJUMPBOOTS) {
					ad_item.ad_jumpboots_finished = self.ad_jumpboots_finished;
					ad_item.ad_jumpboots_time = self.ad_jumpboots_time;
					ad_item.ad_jumpboots_airlvl = self.ad_jumpboots_airlvl;
					ad_item.ad_jumpboots_airmax = self.ad_jumpboots_airmax;
				}
			}
		}
		//----------------------------------------------------------------------
		// Default is DM only, current weapon only
		else {
			// Check for any special MOD weapons
			if (self.weapon == ad_IT_AXE && self.ad_moditems & ad_IT_UPGRADE_AXE) 
				ad_item.ad_moditems = ad_IT_UPGRADE_AXE;
			else if (self.weapon == ad_IT_SUPER_SHOTGUN && self.ad_moditems & ad_IT_UPGRADE_SSG) 
				ad_item.ad_moditems = ad_IT_UPGRADE_SSG;
			else if (self.weapon == ad_IT_LIGHTNING && self.ad_moditems & ad_IT_UPGRADE_LG) 
				ad_item.ad_moditems = ad_IT_UPGRADE_LG;
			// Copy over current weapon ONLY to backpack
			ad_item.items = self.weapon;
		}
	}
	
	// Give the backpack some random toss!
	ad_item.velocity_z = 300;
	ad_item.velocity_x = -100 + (random() * 200);
	ad_item.velocity_y = -100 + (random() * 200);
	
	ad_item.flags = ad_FL_ITEM;
	ad_item.solid = ad_SOLID_TRIGGER;
	ad_item.movetype = ad_MOVETYPE_TOSS;
	setmodel (ad_item, ad_MODEL_BACKPACK);
	setsize (ad_item, '-16 -16 0', '16 16 56');
	ad_item.touch = ad_item_touch;
	ad_item.ad_touch2 = ad_BackpackTouch;
	
	//----------------------------------------------------------------------
	// 1=green, 2=blue, 3=red, 4=golden, 5=swampy, 6=white, 7=flesh
	// green=shells, blue=cells, red=rockets
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONDEFENDER) ad_item.skin = 1;
	else if (self.ad_classtype == ad_CT_MONARMYGRENADE) ad_item.skin = 1;
	else if (self.ad_classtype == ad_CT_MONARMYPLASMA) ad_item.skin = 2;
	else if (self.ad_classtype == ad_CT_MONELIMATOR) ad_item.skin = 2;
	else if (self.ad_classtype == ad_CT_MONCENTURION) ad_item.skin = 2;
	else if (self.ad_classtype == ad_CT_MONARMYROCKET) ad_item.skin = 3;
	else if (self.ad_classtype == ad_CT_MONPYRO) ad_item.skin = 4;
	else if (self.ad_classtype == ad_CT_MONFUMIGATOR) ad_item.skin = 5;
	else if (self.ad_classtype == ad_CT_MONENFORCER) ad_item.skin = 7;
	
	// Default = remove after 2 minutes, stay if coop active
	if (coop == 0) ad_item.ad_item_expired = time + 120;
	else ad_item.ad_item_expired = 0;
	
	ad_item.ad_item_flrcheck = fabs(ad_item.mins_z) + 16;
	ad_item.think = ad_item_thinkloop;		// Check floor
	ad_item.nextthink = time + 0.3;		// Let backpack drop first
};

//======================================================================
/*ad:QUAKED item_backpack (0 .5 .8) (-16 -16 0) (16 16 56) SHELLS NAILS ROCKETS CELLS RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/w_backpack.mdl"); }
Backpack with random/exact amount of ammo
-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
count        : random amount of ammo to give (works with spawnflags)
ammo_shells  : exact amount of shells
ammo_nails   : exact amount of spikes
ammo_rockets : exact amount of rockets
ammo_cells   : exact amount of cells
armorvalue   : armor shards (gives green armor if none present)
armortype    : 1 = random amount of armor shards (uses count)
exactskin    : 0=Original, 1=green, 2=blue, 3=red, 4=yellow, 5=swamp, 6=white, 7=pale
noise         : pickup sound (def=items/backpack_ammo.wav)
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig : = 1 Wait for trigger before respawning
-------- SPAWNFLAGS --------
SHELLS  : ammo for SG / SSG / RG
NAILS   : ammo for NG / SNG
ROCKETS : ammo for GL / RL
CELLS   : ammo for LG
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Backpack with random/exact amount of ammo
Cannot be used to drop weapons or armour!

======================================================================*/
void() ad_item_backpack_setup =
{
	// Empty netname for backpack routine
	self.netname = "";
	self.origin = self.origin + '0 0 12';
	
	// reset frame, weapon and armour type, but not value
	self.frame = self.weapon = self.items = 0;
	self.ad_frame_override = self.ad_frame_box = 0;
	
	// Make sure the ammo/armor quantites are NOT negative!
	if (self.ammo_shells < 0) self.ammo_shells = 0;
	if (self.ammo_nails < 0) self.ammo_nails = 0;
	if (self.ammo_rockets < 0) self.ammo_rockets = 0;
	if (self.ammo_cells < 0) self.ammo_cells = 0;
	if (self.armorvalue < 0) self.armorvalue = 0;

	// Check if exact skin is within range
	if(self.ad_exactskin < 0 || self.ad_exactskin > 7) self.ad_exactskin = 0;
	self.skin = self.ad_exactskin;
	
	// Check for random ammo setup (uses spawnflags)
	if (self.spawnflags & ad_BACKPACK_SHELLS) self.ammo_shells = -1;
	if (self.spawnflags & ad_BACKPACK_NAILS) self.ammo_nails = -1;
	if (self.spawnflags & ad_BACKPACK_ROCKETS) self.ammo_rockets = -1;
	if (self.spawnflags & ad_BACKPACK_CELLS) self.ammo_cells = -1;
	if (self.armortype == 1) self.armorvalue = -1;

	// setup random quantity (default = 5)
	if (self.ammo_shells < 0 || self.ammo_nails < 0 ||
		self.ammo_rockets < 0 || self.ammo_cells < 0 ||
		self.armorvalue < 0) {
		if (!self.count) self.count = 5;
	}
	// No random ammo required, reset count
	else self.count = 0;

	// Check backpack has ammo to pickup
	if (self.ammo_shells == 0 && self.ammo_nails == 0 &&
		self.ammo_rockets == 0 && self.ammo_cells == 0 &&
		self.armorvalue == 0) {
		dprint("\b[BACKPACK]\b is empty, removing\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	
	ad_item_start ();
};

//----------------------------------------------------------------------
void() ad_item_backpack =
{
	self.mdl = ad_MODEL_BACKPACK;
	precache_model (self.mdl);
	
	if (self.noise == "") self.noise = "items/backpack_ammo.wav";
	precache_sound(self.noise);

	self.flags = ad_FL_ITEM;
	if (self.ad_classtype <= 0) self.ad_classtype = ad_CT_AMMOITEMPACK;
	self.ad_classgroup = ad_CG_AMMOITEM;
	self.ad_bbmins = '-16 -16 -12';
	self.ad_bbmaxs = '16 16 32';
	self.ad_part_active = ad_PARTICLE_STYLE_BACKPACK;
	if (self.ad_respawn_time == 0) self.ad_respawn_time = ad_RESPAWN_BACKPACK;
	self.ad_respawn_ofs = '0 0 12';
	self.ad_touch2 = ad_BackpackTouch;
	
	// Match particle effect to skin colour
	if (self.ad_exactskin == 1) self.ad_respawn_style = ad_PARTICLE_BURST_GREEN;
	else if (self.ad_exactskin == 2) self.ad_respawn_style = ad_PARTICLE_BURST_BLUE;
	else if (self.ad_exactskin == 3) self.ad_respawn_style = ad_PARTICLE_BURST_RED;
	else if (self.ad_exactskin == 4) self.ad_respawn_style = ad_PARTICLE_BURST_YELLOW;
	else if (self.ad_exactskin == 5) self.ad_respawn_style = ad_PARTICLE_BURST_GREEN;
	else self.ad_respawn_style = ad_PARTICLE_BURST_WHITE;
	self.ad_respawn_style = self.ad_respawn_style | ad_PARTICLE_BURST_CENTER;
	
	// Double checking all the different ammo combinations can be
	// time consuming, delay spawn the backpack instead
	self.think = ad_item_backpack_setup;
	self.nextthink = time + 0.1 + random();
};

//----------------------------------------------------------------------
void() ad_item_backpack_armour =
{
	if (self.noise == "") self.noise = "items/backpack_armour.wav";
	precache_sound(self.noise);
	self.ad_classtype = ad_CT_ARMORITEMPACK;

	// Default armour amount is 15
	// Check for different armour types
	if (self.spawnflags & ad_BACKPACK_GRNTYPE) {
		self.armortype = ad_ARMOR_GRN_TYPE; self.ad_exactskin = 1;
		if (self.armorvalue < 1) self.armorvalue = ad_BACKARMGRN;
	}
	else if (self.spawnflags & ad_BACKPACK_YELTYPE) {
		self.armortype = ad_ARMOR_YEL_TYPE; self.ad_exactskin = 4;
		if (self.armorvalue < 1) self.armorvalue = ad_BACKARMYEL;
	}
	else if (self.spawnflags & ad_BACKPACK_REDTYPE) {
		self.armortype = ad_ARMOR_RED_TYPE; self.ad_exactskin = 3;
		if (self.armorvalue < 1) self.armorvalue = ad_BACKARMRED;
	}
	// default = shards, no armour type
	else {
		self.armortype = 0; self.ad_exactskin = 4;
		if (self.armorvalue < 1) self.armorvalue = ad_BACKARMGRN;
	}
	
	// make sure all ammo is removed from backpack
	if (self.spawnflags & ad_BACKPACK_SHELLS) self.spawnflags = self.spawnflags - ad_BACKPACK_SHELLS;
	if (self.spawnflags & ad_BACKPACK_NAILS) self.spawnflags = self.spawnflags - ad_BACKPACK_NAILS;
	if (self.spawnflags & ad_BACKPACK_ROCKETS) self.spawnflags = self.spawnflags - ad_BACKPACK_ROCKETS;
	if (self.spawnflags & ad_BACKPACK_CELLS) self.spawnflags = self.spawnflags - ad_BACKPACK_CELLS;

	// Feed back into backpack function
	ad_item_backpack();
};

//----------------------------------------------------------------------
void() ad_DropHealthpack =
{
	local entity ad_item;
	// No cache no drops!
	if (ad_healthcache <= 0) return;
	
	ad_item = spawn();
	ad_item.ad_classgroup = ad_CG_HEALTH;
	ad_item.classname = "item_health";
	ad_item.origin = self.origin - '0 0 20';
	ad_item.ad_skin_override = ad_FALSE;

	// Check for regular Health Pack
	if (self.healamount == ad_HEAL_NORM) {
		ad_item.ad_classtype = ad_CT_HEALNORM;
		// Randomize the health pack, defaults are boring!
		ad_item.healamount = floor((ad_HEAL_NORM/2) + (random()* ad_HEAL_NORM/2));
		ad_item.noise = ad_SOUND_HEAL25;
		// Pick new medieval version or original
		if (ad_item_skintype(ad_item) == ad_SKIN_MEDIEVAL)
			ad_item.mdl = "progs/health_25.mdl";
		else ad_item.mdl = "progs/health_25b.mdl";
	}
	/* Check for megahealth! - This is crazy!
	else if (self.healamount == HEAL_MEGA) {
		item.classtype = CT_HEALMEGA;
		item.healamount = HEAL_MEGA;
		item.noise = SOUND_HEAL100;
		// Pick new medieval version or original
		if (item_skintype(item) == SKIN_MEDIEVAL)
			item.mdl = "progs/health_100.mdl";
		else item.mdl = "progs/health_100b.mdl";
	} */
	// Default = rotten Health Pack
	else {
		ad_item.ad_classtype = ad_CT_HEALROT;
		// Randomize the health pack, defaults are boring!
		ad_item.healamount = floor((ad_HEAL_ROT/2) + (random()* ad_HEAL_ROT/2));
		ad_item.noise = ad_SOUND_HEAL15;
		// Pick new medieval version or original
		if (ad_item_skintype(ad_item) == ad_SKIN_MEDIEVAL)
			ad_item.mdl = "progs/health_15.mdl";
		else ad_item.mdl = "progs/health_15b.mdl";
	}
	
	// Give the backpack some random toss!
	ad_item.velocity_z = 300;
	ad_item.velocity_x = -100 + (random() * 200);
	ad_item.velocity_y = -100 + (random() * 200);
	
	// Setup item correctly
	ad_item.flags = ad_FL_ITEM;
	ad_item.solid = ad_SOLID_TRIGGER;
	ad_item.movetype = ad_MOVETYPE_TOSS;
	
	setmodel (ad_item, ad_item.mdl);
	ad_item.ad_bbmins = ad_VEC_HEAL_MIN;
	ad_item.ad_bbmaxs = ad_VEC_HEAL_MAX;
	setsize(ad_item, ad_item.ad_bbmins, ad_item.ad_bbmaxs);
	ad_item.touch = ad_item_touch;
	ad_item.ad_touch2 = ad_health_touch;
	// Once only
	ad_item.ad_respawn_time = 0;
	// Random rotation
	ad_item.angles_y = rint(random()*359);
	
	// Default = remove after 2 minutes, stay if coop active
	if (coop == 0) ad_item.ad_item_expired = time + 120;
	else ad_item.ad_item_expired = 0;
	
	ad_item.ad_item_flrcheck = fabs(ad_item.mins_z) + 16;
	ad_item.think = ad_item_thinkloop;		// Check floor
	ad_item.nextthink = time + 0.3;		// Let item drop first
};

//----------------------------------------------------------------------
void() ad_CacheHealthpacks =
{
	if (ad_healthcache) return;
	ad_healthcache = ad_TRUE;
	// Rotten Health pack
	precache_model(ad_MODEL_HEAL15);
	precache_model(ad_MODEL_HEAL15B);
	precache_sound(ad_SOUND_HEAL15);
	// Regular Health Pack
	precache_model(ad_MODEL_HEAL25);
	precache_model(ad_MODEL_HEAL25B);
	precache_sound(ad_SOUND_HEAL25);
	// Mega Health Pack
	//precache_model(MODEL_HEAL100);
	//precache_model(MODEL_HEAL100B);
	//precache_sound(SOUND_HEAL100);
};

//======================================================================
// Re-direct items from Quoth
// Allows for Quoth maps to be loaded into AD (not 100% compatible)
// 
//======================================================================
// Quoth Hammer requests to Shadow Axe!
void() ad_weapon_hammer = { ad_weapon_upgrade_axe(); };

// Quoth Plasma Gun requests to LG Upgrade!
void() ad_weapon_plasmagun = { ad_weapon_upgrade_lg(); };

// Quoth coop holdable weapon (removed on spawn)
void() ad_weapon_bomb = { remove(self); }

// Trinity (3x nail damage) requests to Nail Piecer!
void() ad_item_artifact_trinity = { ad_item_artifact_nail_piercer(); };

// Cross of Deflection requests to Blast Belt!
void() ad_item_artifact_cross = { ad_item_artifact_blastbelt(); };


