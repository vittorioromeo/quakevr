	if (self.armortype <= 0) self.armortype = ad_ARMOR_GRN_TYPE;
	if (self.armorvalue <= 0) self.armorvalue = ad_ARMOR_GRN_VALUE;
	self.ad_respawn_effect = ad_TRUE;
	self.ad_respawn_style = ad_PARTICLE_BURST_GREEN + ad_PARTICLE_BURST_RING;
	self.ad_respawn_ofs = '0 0 24';
	ad_item_armor_setup();
};

