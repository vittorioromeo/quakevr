-------- KEYS --------
targetname   : toggle state (use trigger ent for exact state)
target       : trigger targets to fire when item touched
mdl           : Override the model used (def=progs/artifact_tome.mdl)
netname       : Override name of pickup (def=Tome of Power)
message      : centerprint message when item is picked up
noise        : Custom pickup sound
-------- SPAWNFLAGS --------
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Custom event trigger

======================================================================*/
void() ad_tomeofpower_touch =
{
	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other,"\n");
	if (self.noise != ad_SOUND_EMPTY) 
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");
	
	ad_activator = other;
	ad_SUB_UseTargets();

	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;

	// This is a trigger once condition (regardless of coop)
	ad_item_finished();
};

//----------------------------------------------------------------------
void() ad_item_artifact_tomeofpower =
{
	// Check for custom model setup?
	ad_item_debugcustomdl();
	if (self.mdl == "") self.mdl = "progs/artifact_tome.mdl";
	precache_model (self.mdl);	
	if (self.noise == "") self.noise = "misc/medkey.wav";
	precache_sound (self.noise);

	self.ad_classtype = ad_CT_ARTTOME;
	self.ad_classgroup = ad_CG_ARTIFACT;
	// Holding this item in an inventory does nothing
	// Re-using the bitflag for something else
	self.ad_moditems = 0;
	if (self.netname == "") self.netname = "Tome of Power";

	self.ad_touch2 = ad_tomeofpower_touch;
	self.ad_bbmins = ad_VEC_POWR_MIN;
	self.ad_bbmaxs = ad_VEC_POWR_MAX;
	self.ad_part_active = ad_PARTICLE_STYLE_TOMEOFP;
	ad_item_start();
};

//======================================================================
// ARTIFACTS
// Environment Suit, Pentagram of Protection, Ring of Shadows, Quad,
// Sharpshooter, Nailpiercer, Air Tank, Jump Boots, Blast Belt.
//======================================================================
void() ad_artifact_touch =
{
	//----------------------------------------------------------------------
	// Existing artifacts
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_ARTINVS) {
		other.ad_invisible_time = 1;
		if (self.cnt < 0) other.ad_invisible_finished = ad_POWERUP_VANIA;
		else other.ad_invisible_finished = time + self.cnt;
		
		other.ad_invisible_sound = time + 1;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTPENT) {
		other.ad_invincible_time = 1;
		if (self.cnt < 0) other.ad_invincible_finished = ad_POWERUP_VANIA;
		else other.ad_invincible_finished = time + self.cnt;
		
		ad_ResetDebuffSystem(other);
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTSUIT) {
		other.ad_rad_time = 1;
		if (self.cnt < 0) other.ad_radsuit_finished = ad_POWERUP_VANIA;
		else other.ad_radsuit_finished = time + self.cnt;
		
		ad_ResetDebuffBurning(other);
		ad_ResetDebuffPoisoned(other);
		// The airtank and envsuit don't share HUD icons and can
		// exist together for different map styles
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTQUAD) {
		// Cannot have QUAD if got Nail Piercer or Sharpshooter
		// They have the Quad effects and share the hud with Quad
		if (other.ad_moditems & ad_IT_ARTPIERCE) return;
		if (other.ad_moditems & ad_IT_ARTSHARP) return;
		
		other.super_time = 1;
		if (self.cnt < 0) other.super_damage_finished = ad_POWERUP_VANIA;
		else other.super_damage_finished = time + self.cnt;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTSHARP) {
		// Cannot have the Nail Piercer if got the Sharpshooter
		// They have the Quad effects and share the hud
		if (other.ad_moditems & ad_IT_ARTPIERCE) return;
		if (other.items & ad_IT_QUAD) return;

		other.ad_sharpshoot_time = 1;
		if (self.cnt < 0) other.ad_sharpshoot_finished = ad_POWERUP_VANIA;
		else other.ad_sharpshoot_finished = time + self.cnt;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTPIERCE) {
		// Cannot have the Sharpshooter if got the Nail Piercer
		// They have the Quad effects and share the hud
		if (other.ad_moditems & ad_IT_ARTSHARP) return;
		if (other.items & ad_IT_QUAD) return;

		other.ad_nailpiercer_time = 1;
		if (self.cnt < 0) other.ad_nailpiercer_finished = ad_POWERUP_VANIA;
		else other.ad_nailpiercer_finished = time + self.cnt;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTAIRTANK) {
		other.ad_airtank_time = 1;
		if (self.cnt < 0) other.ad_airtank_finished = ad_POWERUP_VANIA;
		else other.ad_airtank_finished = time + self.cnt;
		
		other.ad_airtank_sound = time + 2;
		// Check for suit override on breathing sound
		if (self.spawnflags & ad_AIRTANK_SILENT) other.ad_airtank_silent = ad_TRUE;
		else other.ad_airtank_silent = ad_FALSE;
		// Volume range modifier (0-1)
		other.ad_airtank_volume = self.volume;
		other.ad_airtank_outwater = self.distance;

		ad_ResetDebuffPoisoned(other);
		// The airtank and envsuit don't share HUD icons and can
		// exist together for different map styles
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTLAVASHIELD) {
		other.ad_lavashield_time = 1;
		// Volume range modifier (0-1)
		other.ad_lavashield_volume = self.volume;
		if (self.cnt < 0) other.ad_lavashield_finished = ad_POWERUP_VANIA;
		else other.ad_lavashield_finished = time + self.cnt;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTBLASTBELT) {
		other.ad_blastbelt_time = 1;
		// Volume range modifier (0-1)
		other.ad_blastbelt_volume = self.volume;
		if (self.cnt < 0) other.ad_blastbelt_finished = ad_POWERUP_VANIA;
		else other.ad_blastbelt_finished = time + self.cnt;
	}
	//----------------------------------------------------------------------
	else if (self.ad_classtype == ad_CT_ARTJUMPBOOTS) {
		other.ad_jumpboots_time = 1;
		if (self.cnt < 0) other.ad_jumpboots_finished = ad_POWERUP_VANIA;
		else other.ad_jumpboots_finished = time + self.cnt;
		
		other.ad_jumpboots_airlvl = 0;
		// Check if jump max is endless, additive or exact
		if (self.count < 0) other.ad_jumpboots_airmax = -1;
		else if (self.count > 0) other.ad_jumpboots_airmax = self.count;
		else other.ad_jumpboots_airmax = other.ad_jumpboots_airmax + 1;
		// Make sure the max never goes too high
		if (other.ad_jumpboots_airmax > ad_ART_JUMPBOOTS_AIRMAX)
			other.ad_jumpboots_airmax = ad_ART_JUMPBOOTS_AIRMAX;
		if (self.height > 0) other.ad_jumpboots_height = self.height;
		else other.ad_jumpboots_height = ad_ART_JUMPHEIGHT;
		if (self.distance > 0) other.ad_jumpboots_forward = self.distance;
		else other.ad_jumpboots_forward = 0;
	}
	//----------------------------------------------------------------------
	else return;

	//----------------------------------------------------------------------
	// Pickup sound and initial screen flash
	//----------------------------------------------------------------------
	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other,"\n");
	if (self.noise != ad_SOUND_EMPTY) 
		// Originally played on chan_voice, can be overwritten easily
		sound (other, ad_CHAN_ITEM, self.noise, 1, ad_ATTN_NORM);
	stuffcmd (other, "bf\n");

	// Update player item flags (regular + mod)
	other.items = other.items | VR_AD_ArtifactItems(self);
	other.ad_moditems = other.ad_moditems | self.ad_moditems;

	ad_activator = other;
	ad_SUB_UseTargets();

	// Check for randomizer pickup conditions
	ad_artifact_touchrandomizer();
	
	// Quick exit, no need for following stuff
	if (self.ad_progspawnlist) return;

	// hide item and check for respawn
	ad_item_finished();
	ad_check_item_respawn();	
};

//======================================================================
//	setup all artifacts with similiar configurations
//======================================================================
void() ad_artifact_setup =
{
	self.ad_touch2 = ad_artifact_touch;
	self.ad_classgroup = ad_CG_ARTIFACT;
	self.ad_bbmins = ad_VEC_POWR_MIN;
	self.ad_bbmaxs = ad_VEC_POWR_MAX;
	
	// Allow for custom artifact timer
	if (self.cnt < 0) self.cnt = ad_POWERUP_VANIA;
	// Setup minimum/default timer
	else if (self.cnt == 0) self.cnt = ad_POWERUP_TIMER;
	
	// Setup skin override
	if (self.ad_exactskin < 1) self.ad_exactskin = 0;
	self.skin = self.ad_exactskin;

	// Setup artifact default respawn timers
	if (self.ad_respawn_time == 0) {
		if (self.ad_classtype == ad_CT_ARTPENT || self.ad_classtype == ad_CT_ARTINVS)
			self.ad_respawn_time = ad_RESPAWN_ARTIFACT2;
		else self.ad_respawn_time = ad_RESPAWN_ARTIFACT1;
	}	

	ad_item_start ();
};

//======================================================================
/*ad:QUAKED item_artifact_envirosuit (0 0.5 0.8) (-16 -16 -24) (16 16 32) x x x x RESPAWN FLOAT STARTOFF NOEFFECTS NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
{ model(":progs/artifact_envsuit.mdl"); }
Player takes no damage from water or slime for 30 seconds
-------- KEYS --------
targetname    : toggle state (use trigger ent for exact state)
exactskin     : 0=Original, 1=Green, 2=Brown, 3=Aqua, 4=Blue
mdl           : Override the model used (def=progs/artifact_envsuit.mdl)
netname       : Override name of pickup (def=Environment Suit)
message       : centerprint message when item is picked up
respawn_time  : time to wait before respawning (1-x seconds, default varies)
respawn_count : Total amount of times to respawn (counts down to zero)
respawn_trig  : = 1 Wait for trigger before respawning
noise         : Custom pickup sound for powerup
cnt           : Duration override of artifact (default = 30s)
-------- SPAWNFLAGS --------
RESPAWN  : Can respawn after being picked up
FLOAT    : No drop to floor test
STARTOFF : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Player takes no damage from water or slime for 30 seconds
Immume to Fire Attack, but take small damage instead

======================================================================*/
void() ad_item_artifact_envirosuit =
{
	// Check for any random setups
	if (ad_artifact_checkrandomizer() == ad_TRUE) return;

	// Check for custom model setup?
	ad_item_debugcustomdl();
	// cshifts 0,255,0,20
	// Original id model = progs/suit.mdl
	if (self.mdl == "") self.mdl = "progs/artifact_envsuit.mdl";
	precache_model (self.mdl);
	if (self.noise == "") self.noise = ad_SOUND_ARTSUIT1;
	self.noise2 = ad_SOUND_EMPTY;		// not used (activation sound)
	precache_sound (self.noise);
	precache_sound ((self.noise1 = ad_SOUND_ARTSUIT2));
	precache_sound (self.noise2);
	if (self.netname == "") self.netname = "Environment Suit";
	self.items = ad_IT_SUIT;
	self.ad_classtype = ad_CT_ARTSUIT;
	self.ad_part_active = ad_PARTICLE_STYLE_SUIT;
	self.ad_respawn_style = ad_PARTICLE_BURST_GREEN + ad_PARTICLE_BURST_CENTER;
	self.ad_respawn_ofs = '0 0 28';
	ad_artifact_setup();
};

