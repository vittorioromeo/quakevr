//----------------------------------------------------------------------
// Some entities have directional parameters (angles -> movedir)
// This function searches for an angletarget entity (useful for tracking)
// Always finds the first target key (will fail if multiple targets)
//----------------------------------------------------------------------
void(entity ad_targ, float ad_return_target) ad_TargetMovedir =
{
	local entity ad_angle_dest;
	local vector ad_targ_origin, ad_angle_dest_origin;
	
	// Exit if no angletarget defined
	if (ad_targ.ad_angletarget == "") return;
	
	// Find angle target entity
	ad_angle_dest = find(world, targetname, ad_targ.ad_angletarget);
	if (ad_angle_dest) {
		// Check for Bmodel origin for targ/angle_dest
		if (ad_targ.ad_bsporigin) ad_targ_origin = ad_bmodel_origin(ad_targ);
		else ad_targ_origin = ad_targ.origin;
		if (ad_angle_dest.ad_bsporigin) ad_angle_dest_origin = ad_bmodel_origin(ad_angle_dest);
		else ad_angle_dest_origin = ad_angle_dest.origin;
		
		// Calculate facing angle towards target
		self.movedir = normalize(ad_angle_dest_origin - ad_targ_origin);
		
		// Return variables for calling function (def=FALSE)
		if (ad_return_target) {
			self.ad_movetarget = ad_angle_dest;	// Target entity
			self.dest1 = ad_angle_dest_origin;	// Target origin
		}
	}
};

//----------------------------------------------------------------------
void() ad_TargetMovedirReturn = { ad_TargetMovedir(self, ad_TRUE); };

//----------------------------------------------------------------------
// QuakeEd only writes a single float for angles (bad idea), 
// so up and down are just constant angles.
//----------------------------------------------------------------------
void() ad_SetMovedir =
{
	if (self.angles == '0 -1 0') self.movedir = '0 0 1';
	else if (self.angles == '0 -2 0') self.movedir = '0 0 -1';
	else {
		makevectors (self.angles);
		self.movedir = v_forward;
	}
	// Bmodels need angles key reset otherwise twisted on spawn
	self.angles = '0 0 0';
};

/*======================================================================
InitTrigger
======================================================================*/
void() ad_InitTrigger =
{
	// trigger angles are used for one-way touches.  An angle of 0 is assumed
	// to mean no restrictions, so use a yaw of 360 instead.
	if (!ad_CheckZeroVector(self.angles)) ad_SetMovedir();
	self.solid = ad_SOLID_TRIGGER;
	self.movetype = ad_MOVETYPE_NONE;
	self.mdl = self.model;		// Save model for later
	setmodel (self, self.mdl);	// set size and link into world
	self.ad_bbmins = self.mins;	// Save bmodel bounds for later
	self.ad_bbmaxs = self.maxs;
	self.ad_bsporigin = ad_TRUE;		// bmodel origin 0,0,0
	self.modelindex = 0;
	self.model = "";			// hide bmodel surface
};

/*======================================================================
SUB_CalcMove

calculate self.velocity and self.nextthink to reach dest from
self.origin traveling at speed
======================================================================*/
void() ad_SUB_FacingAngle_Tick =
{
	// Decrease move/face time
	self.ad_faceangle_time = self.ad_faceangle_time - self.ad_faceangle_div;
	// Is the movetime over? on to tidy up function
	if (self.ad_faceangle_time <= 0) ad_SUB_CalcMoveDone();
	else {
		// Adjust angles slowly to match final angle
		self.angles = self.angles + self.ad_faceangle_inc;
		// The 'moving time' does not always divide perfectly
		// Allow for final remainder to be last division
		if (self.ad_faceangle_time < self.ad_faceangle_div)
			self.nextthink = time + self.ad_faceangle_time;
		else self.nextthink = time + self.ad_faceangle_div;
		// Keep ticking through this function
		self.think = ad_SUB_FacingAngle_Tick;
	}
};

//----------------------------------------------------------------------
void(float ad_movetime) ad_SUB_FacingAngle_Setup =
{
	local vector ad_facediff;
	local float ad_divtime;
	
	// Convert angle difference to 0-360 scale
	ad_facediff = ad_vectormod(self.finalangle - self.angles);
	// Check for 0/360 boundary and reverse difference
	if (ad_facediff_x > 180) ad_facediff_x = ad_facediff_x - 360;
	if (ad_facediff_y > 180) ad_facediff_y = ad_facediff_y - 360;
	if (ad_facediff_z > 180) ad_facediff_z = ad_facediff_z - 360;
	
	// Tick rate of 0.05 is 20fps, the engine will struggle with <0.02
	if (self.ad_faceangle_div < 0.02) self.ad_faceangle_div = 0.05;
	ad_divtime = ad_movetime / self.ad_faceangle_div;
	self.ad_faceangle_inc = ad_facediff / ad_divtime;
	
	self.ad_faceangle_time = ad_movetime;
	// Nothing has moved yet, so wait a bit
	self.nextthink = time + self.ad_faceangle_div;
	self.think = ad_SUB_FacingAngle_Tick;
};

//----------------------------------------------------------------------
void(vector ad_tdest, float ad_tspeed, void() ad_func) ad_SUB_CalcMove =
{
	local vector ad_vdestdelta;
	local float ad_len, ad_traveltime;

	if (!ad_tspeed) ad_tspeed = 40;			// Create default speed if none specified
	self.ad_think1 = ad_func;					// Finished moving function
	self.ad_finaldest = ad_tdest;				// Final origin (Overwrite existing values)
	self.think = ad_SUB_CalcMoveDone;		// Tidy up function

	ad_vdestdelta = ad_tdest - self.origin;	// set destdelta to the vector needed to move
	ad_len = vlen (ad_vdestdelta);			// calculate length of vector
	ad_traveltime = ad_len / ad_tspeed;			// divide by speed to get time to reach dest

	// Check if faceangle is active on a func bmodel mover?
	if (self.ad_faceangle > 0 && self.ad_bsporigin > 0) self.ad_faceangle = ad_FALSE;
	
	// If move distance or time too small, snap to final location
	if (ad_traveltime < 0.1 || ad_tdest == self.origin) {
		if (self.ad_faceangle > 0) self.angles = self.finalangle;
		self.velocity = '0 0 0';
		if (self.ad_bsporigin > 0) self.nextthink = self.ltime + 0.1;
		else self.nextthink = time + 0.1;
		return;
	}
	
	// scale the destdelta vector by the time spent traveling to get velocity
	self.velocity = ad_vdestdelta * (1/ad_traveltime);	// qcc won't take vec/float
	if (self.ad_bsporigin > 0) self.nextthink = self.ltime + ad_traveltime;
	else self.nextthink = time + ad_traveltime;
	
	// Check for any facing angle functionality
	if (self.ad_faceangle > 0) ad_SUB_FacingAngle_Setup(ad_traveltime);
};

/*======================================================================
After moving, set origin to exact final destination
======================================================================*/
void()  ad_SUB_CalcMoveDone =
{
	self.velocity = '0 0 0';
	setorigin(self, self.ad_finaldest);
	self.nextthink = -1;
	if (self.ad_think1) self.ad_think1();
};

//----------------------------------------------------------------------
// Not used anywhere
//----------------------------------------------------------------------
void(entity ad_ent, vector ad_tdest, float ad_tspeed, void() ad_func) ad_SUB_CalcMoveEnt =
{
	local entity	ad_stemp;
	ad_stemp = self;
	self = ad_ent;

	ad_SUB_CalcMove (ad_tdest, ad_tspeed, ad_func);
	self = ad_stemp;
};

/*======================================================================
SUB_CalcMoveEntity

calculate self.velocity and self.nextthink to reach dest from
self.origin traveling at speed
======================================================================*/
void() ad_SUB_MoveEntityDone =
{
	self.movetype = self.ad_classmove;
	ad_SUB_CalcMoveDone();
};

//----------------------------------------------------------------------
void(vector ad_tdest, float ad_tspeed, void() ad_func) ad_SUB_CalcMoveEntity =
{
	local vector	ad_vdestdelta;
	local float		ad_traveltime;

	if (!ad_tspeed) ad_tspeed = 4;			// Create default travel time if none specified
	self.ad_classmove = self.movetype;		// save previous movetype
	self.movetype = ad_MOVETYPE_FLY;		// Allow entity to move smoothly
	self.ad_think1 = ad_func;					// Store final function
	self.ad_finaldest = ad_tdest;				// Store final destination
	
	ad_vdestdelta = ad_tdest - self.origin;	// set destdelta to the vector needed to move
	ad_traveltime = 1 / ad_tspeed;					// Work out percentage travel velocity
	self.velocity = ad_vdestdelta * ad_traveltime;	// Calc time travel fraction

	self.nextthink = time + ad_tspeed;
	self.think = ad_SUB_MoveEntityDone;
};

/*======================================================================
SUB_CalcAngleMove

calculate self.avelocity and self.nextthink to reach destangle from
self.angles rotating 

The calling function should make sure self.think is valid
======================================================================*/
void(vector ad_destangle, float ad_tspeed, void() ad_func) ad_SUB_CalcAngleMove =
{
local vector	ad_destdelta;
local float		ad_len, ad_traveltime;

	if (!ad_tspeed)  dprint("[SUB_CALC_ANGLE] No speed is defined!");
		
	// set destdelta to the vector needed to move
	ad_destdelta = ad_destangle - self.angles;
	
	// calculate length of vector
	ad_len = vlen (ad_destdelta);
	
	// divide by speed to get time to reach dest
	ad_traveltime = ad_len / ad_tspeed;

	// set nextthink to trigger a think when dest is reached
	self.nextthink = self.ltime + ad_traveltime;

	// scale the destdelta vector by the time spent traveling to get velocity
	self.avelocity = ad_destdelta * (1 / ad_traveltime);
	
	self.ad_think1 = ad_func;
	self.finalangle = ad_destangle;
	self.think = ad_SUB_CalcAngleMoveDone;
};

/*======================================================================
After rotating, set angle to exact final angle
======================================================================*/
void() ad_SUB_CalcAngleMoveDone =
{
	self.angles = self.finalangle;
	self.avelocity = '0 0 0';
	self.nextthink = -1;
	if (self.ad_think1)
		self.ad_think1();
};

//----------------------------------------------------------------------
// Not used anywhere
//----------------------------------------------------------------------
void(entity ad_ent, vector ad_destangle, float ad_tspeed, void() ad_func) ad_SUB_CalcAngleMoveEnt =
{
	local entity		ad_stemp;
	ad_stemp = self;
	self = ad_ent;
	ad_SUB_CalcAngleMove (ad_destangle, ad_tspeed, ad_func);
	self = ad_stemp;
};

//----------------------------------------------------------------------
void() ad_DelayThink =
{
	ad_activator = self.enemy;
	ad_SUB_UseTargets ();
	remove(self);
};

/*======================================================================
SUB_UseTargets

the global "activator" should be set to the entity that initiated the firing.

If self.delay is set, a DelayedUse entity will be created that will actually
do the SUB_UseTargets after that many seconds have passed.

Centerprints any self.message to the activator.

Removes all entities with a targetname that match self.killtarget,
and removes them, so some events can remove other triggers.

Search for (string)targetname in all entities that
match (string)self.target and call their .use function

======================================================================*/
void() ad_SUB_UseTargets =
{
	local entity ad_t, ad_stemp, ad_otemp, ad_act;

	//----------------------------------------------------------------------
	// Check for recursive loops!?!
	//----------------------------------------------------------------------
	if (self.targetname != "") {
		if (self.targetname == self.target || self.targetname == self.ad_target2) {
			dprint("\n----------------------------------------\n");
			dprint("\b[USE_TARGET]\b target == targetname, really bad!!!\n");
			dprint(self.classname);
			dprint(" ("); dprint(self.targetname); dprint(") at "); 
			if (self.ad_bsporigin) dprint(vtos(ad_bmodel_origin(self)));
			else dprint(vtos(self.origin));
			dprint("\ntarg ("); dprint(self.target);
			dprint(") targ2 ("); dprint(self.ad_target2);
			dprint(") kill ("); dprint(self.killtarget);
			dprint(")\n----------------------------------------\n");
			return;
		}
	}
	//----------------------------------------------------------------------
	// check for a delay
	//----------------------------------------------------------------------
	if (self.delay) {
	// create a temp object to fire at a later time
		ad_t = spawn();
		ad_t.classname = "DelayedUse";
		ad_t.ad_classtype = ad_CT_TRIGRELAYDELAY;
		ad_t.owner = self;
		ad_t.nextthink = time + self.delay;
		ad_t.think = ad_DelayThink;
		ad_t.enemy = ad_activator;
		ad_t.message = self.message;
		ad_t.killtarget = self.killtarget;
		ad_t.target = self.target;
		ad_t.ad_target2 = self.ad_target2;
		ad_t.noise = self.noise;
		return;
	}
	
	//----------------------------------------------------------------------
	// Check if previous delay has been disabled
	// Unfortunately start off = OFF state and not easy to check for
	// because some entities use that spawnflag bit for other things!
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_TRIGRELAYDELAY) {
		if (self.owner.ad_estate & ad_ESTATE_DISABLE) return;
	}
	
	//----------------------------------------------------------------------
	// print any messages
	//----------------------------------------------------------------------
	if (ad_activator.flags & ad_FL_CLIENT && self.message != "") {
		if (coop > 0) {
			// Write message to all clients
			msg_entity = self;
			WriteByte (ad_MSG_ALL, ad_SVC_CENTERPRINT);
			WriteString (ad_MSG_ALL, self.message);
		}
		// Write message to single client
		else ad_centerprint (ad_activator, self.message);
		// Default noise = classic beep beep sound
		if (self.noise == "") 
			sound (ad_activator, ad_CHAN_VOICE, ad_SOUND_TALK, 1, ad_ATTN_NORM);
	}

	//----------------------------------------------------------------------
	// kill targets
	// I really do hate this function because there is hardly any checks
	// on entities being removed, added a player check for sanity!
	//----------------------------------------------------------------------
	if (self.killtarget != "") {
		ad_t = find (world, targetname, self.killtarget);
		while(ad_t) {
			// Check for activate monsters? Tidy up kill counter
			if (ad_t.flags & ad_FL_MONSTER && ad_t.health > 0) {
				// If a monster marked with no monster count dies
				// update HUD totals to reflect death properly
				if (ad_t.ad_nomonstercount) {
					total_monsters = total_monsters + 1;
					ad_update_hud_totals(ad_HUD_MONSTERS);
				}	
				// Update global monster death totals
				killed_monsters = killed_monsters + 1;
				WriteByte (ad_MSG_ALL, ad_SVC_KILLEDMONSTER);
			}
			// Added extra check to prevent player client removal!?!
			if (!(ad_t.flags & ad_FL_CLIENT)) {
				// Try to minimize the entity chain damage, check for
				// entity attachments and delete them as well!
				if (ad_t.ad_attachment) remove(ad_t.ad_attachment);
				if (ad_t.ad_attachment2) remove(ad_t.ad_attachment2);
				if (ad_t.ad_attachment3) remove(ad_t.ad_attachment3);
				// Make sure any unique ent number is reset
				if (ad_t.ad_entno_unique > 0) ad_t.ad_entno_unique = 0;
				// Remove entity from chain list
				remove (ad_t);
			}
			// Find the next killtarget
			ad_t = find (ad_t, targetname, self.killtarget);
		} 
	}
	//----------------------------------------------------------------------
	// fire targets
	//----------------------------------------------------------------------
	if (self.target != "") {

		ad_act = ad_activator;	// ID Code - Never switch around, not sure why it is here?
		ad_t = find (world, targetname, self.target);
		ad_stemp = self; ad_otemp = other;		// Store self/other
		while(ad_t) {
			if (ad_t.use != ad_SUB_Null) {
				if (ad_t.use) {
					self = ad_t; other = ad_stemp;		// Switch self/other
					self.ad_activate = ad_stemp;			// used by the breakable system
					self.use ();					// fire trigger
					self = ad_stemp; other = ad_otemp;	// restore self/other
					ad_activator = ad_act;		// ID code - Never changed, why restore it?
				}
			}
			// Are there anymore targets left in the list?
			ad_t = find (ad_t, targetname, self.target);
		} 
	}
	//----------------------------------------------------------------------
	if (self.ad_target2 != "") {
		ad_act = ad_activator;	// ID Code - Never switch around, not sure why it is here?
		ad_t = find (world, targetname, self.ad_target2);
		ad_stemp = self; ad_otemp = other;		// Store self/other
		while(ad_t) {
			if (ad_t.use != ad_SUB_Null) {
				if (ad_t.use) {
					self = ad_t; other = ad_stemp;// Switch self/other
					self.ad_activate = ad_stemp;	// used mostly by the breakable system
					self.use ();			// fire trigger
					self = ad_stemp; other = ad_otemp;	// restore self/other
					ad_activator = ad_act;		// ID code - Never changed, why restore it?
				}
			}
			ad_t = find (ad_t, targetname, self.ad_target2);
		} 
	}
};

/*======================================================================
 SUB_AttackFinished
	in nightmare mode, all attack_finished times become 0
	some monsters refire twice automatically (using .cnt variable)
	Change nightmare to be less range spam and better time scaling
======================================================================*/
void(float ad_normal) ad_SUB_AttackFinished =
{
	local float ad_nightadj;	// Easier to work out percentage
	self.cnt = 0;			// reset checkfire counter
	
	// Nightmare skill attacks are faster (turret like) and with
	// hitscan enemies this can easily overwhelm targets locking
	// them into damage/pain function loops. This can especially be
	// be bad if a large enough enemy group is involved!
	// Changed - NM behaviour for boss fights is default
	//
	if (ad_skill == ad_SKILL_NIGHTMARE && self.enemy.ad_bossflag == ad_FALSE) {
		// Nightmare mode is just endless range attacks!
		// I never thought this was a good way to end skill levels
		// Changed nightmare mode to 50-75% decrease in time
		// Exceptions to nightmare mode (minion spawning) - 75-100% time
		ad_nightadj = 0.5 + (random()*0.25);
		if (self.ad_minion_active) ad_nightadj = ad_nightadj + 0.25;
		// The original ID shamblers were lightning turrets on Nightmare
		// Shamblers don't scale with skill levels in AD because
		// they don't have projectiles, so they need a switch instead
		// On Nightmare skill Shamblers go from 2-4s to 1s!
		// Instead of 2-4s, NM is 0.6-1.2s, Average 1.2s +2 frames
		if (self.ad_classtype == ad_CT_MONSHAM) ad_nightadj = 0.4;
		self.ad_attack_finished = time + (ad_normal*ad_nightadj);
	}
	// Easy, Nornal and Hard skill all pass through, no change
	else self.ad_attack_finished = time + ad_normal;
	//dprint("Time ("); dprint(ftos(time));
	//dprint(") AF ("); dprint(ftos(normal));
	//dprint(") Dif ("); dprint(ftos(self.attack_finished - time));
	//dprint(") Att ("); dprint(ftos(self.attack_finished));
	//dprint(")\n");
};

//----------------------------------------------------------------------
// Used by soliders and enforcers (special double fire mode)
//----------------------------------------------------------------------
void (void() ad_thinkst) ad_SUB_CheckRefire =
{
	if (ad_skill != ad_SKILL_NIGHTMARE) return;
	if (self.cnt == 1) return;
	if (!ad_visible (self.enemy)) return;
	self.cnt = 1;
	self.think = ad_thinkst;
};

