/*======================================================================
 SPAWN_TFOG and SPAWN_TDEATH
 
 These functions were originally in triggers.qc, but are used all
 over the place by monsters, items and players. Subs seems a better
 home for these generic functions.

 ======================================================================*/
void() ad_play_teleport =
{
	self.lip = random() * 5;
	if (self.lip < 1) self.noise = "misc/r_tele1.wav";
	else if (self.lip < 2) self.noise = "misc/r_tele2.wav";
	else if (self.lip < 3) self.noise = "misc/r_tele3.wav";
	else if (self.lip < 4) self.noise = "misc/r_tele4.wav";
	else self.noise = "misc/r_tele5.wav";

	sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);
	self.nextthink = time + 2;	// Allow time for the sound to finish
	self.think = ad_SUB_Remove;	// tidy up function
};

//----------------------------------------------------------------------
void(vector ad_org) ad_spawn_tfog =
{
	local entity ad_spawneffect;
	
	ad_spawneffect = spawn ();
	ad_spawneffect.origin = ad_org;
	ad_spawneffect.nextthink = time + 0.2;
	ad_spawneffect.think = ad_play_teleport;

	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_TELEPORT);
	WriteCoord (ad_MSG_BROADCAST, ad_org_x);
	WriteCoord (ad_MSG_BROADCAST, ad_org_y);
	WriteCoord (ad_MSG_BROADCAST, ad_org_z);
};

//----------------------------------------------------------------------
void() ad_tdeath_touch =
{
	// Cannot telefrag yourself!?!
	if (other == self.owner) return;
	// Touch trigger has expired
	if (self.ad_attack_finished < time) return;
	
	// Check if found a breakable than cannot be broken
	if (ad_ai_foundbreakable(self, other, ad_FALSE)) return;
		
	// A boss cannot be telefragged (except shub)
	// Telefrag entity trying to telefrag boss instead!?!
	if (other.ad_bossflag == ad_TRUE) {
		if (other.ad_classtype == ad_CT_MONIDSHUB) {
			// AD 1.8 for some reason this damage was setup wrong
			// Originally damaging self.owner, which is the spawner!
			// This should match the last T_Damage below
			ad_T_Damage (other, self, self, ad_MEGADEATH, ad_NOARMOR);
			return;
		}
		else {
			// Cannot telefrag a boss!!! kill spawner instead
			dprint("[TELEFRAG] Entity ("); dprint(self.owner.classname);
			dprint(") cannot kill boss!\n");
			ad_T_Damage (self.owner, self, self, ad_MEGADEATH, ad_NOARMOR);
			// Stop this trigger working
			self.ad_attack_finished = 0;
			return;
		}
	}

	// frag anyone who teleports in on top of an invincible player
	if (other.flags & ad_FL_CLIENT) {
		if (other.ad_invincible_finished > time) self.classname = "teledeath2";
		// Force the owner (monster) to explode/die
		if ( !(self.owner.flags & ad_FL_CLIENT) ) {
			ad_T_Damage (self.owner, self, self, ad_MEGADEATH, ad_NOARMOR);
			return;
		}
	}

	// Sudden death incoming ...
	// This is damage/attacking any touching entity
	if (other.health) ad_T_Damage (other, self, self, ad_MEGADEATH, ad_NOARMOR);
};

//----------------------------------------------------------------------
void(vector ad_org, entity ad_death_owner) ad_spawn_tdeath =
{
	local entity ad_death;

	ad_death = spawn();
	ad_death.classname = "teledeath";
	// Spawning monster (used for exceptions)
	ad_death.owner = ad_death_owner;
	ad_death.movetype = ad_MOVETYPE_NONE;
	ad_death.solid = ad_SOLID_TRIGGER;
	ad_death.angles = '0 0 0';
	// Make sure the bbox is outside (+1 size) of the spawners bounding box
	setsize (ad_death, ad_death_owner.mins - '1 1 1', ad_death_owner.maxs + '1 1 1');
	setorigin (ad_death, ad_org);
	ad_death.touch = ad_tdeath_touch;
	// Don't keep the trigger around for long
	ad_death.nextthink = time + 0.2;
	// Block timer on touch function
	ad_death.ad_attack_finished = time + 0.3;
	ad_death.think = ad_SUB_Remove;
	
	// This is extremely costly on the engine because it re-checks
	// every trigger in the map to see if it is touching something
	force_retouch = 2;
};
