void() ad_snowm_walk2 = [ $stand1, ad_snowm_walk3 ] {ad_ai_walk(0);};
void() ad_snowm_walk3 = [ $stand1, ad_snowm_walk4 ] {ad_ai_walk(0);};
void() ad_snowm_walk4 = [ $stand1, ad_snowm_walk5 ] {ad_ai_walk(0);};
void() ad_snowm_walk5 = [ $stand1, ad_snowm_walk6 ] {ad_ai_walk(0);};
void() ad_snowm_walk6 = [ $stand1, ad_snowm_walk7 ] {ad_ai_walk(0);};
void() ad_snowm_walk7 = [ $stand1, ad_snowm_walk8 ] {ad_ai_walk(0);};
void() ad_snowm_walk8 = [ $stand1, ad_snowm_walk1 ] {ad_ai_walk(0);};

