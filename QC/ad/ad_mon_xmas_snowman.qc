/*==============================================================================
XMAS Snowman - From Twisted Christmas Mod by Twisted Matrix
==============================================================================*/

// (000) Standing Still
$frame stand1

// (001 - 005) Fast Claw attack
$frame claw1 claw2 claw3 claw4 claw5

// (006 - 008) Fast Nail Attack
$frame attack1 attack2 attack3

// (009 - 010) Misc modelling stuff
$frame base1 base2

//======================================================================
