void() ad_snowm_stand6 = [ $stand1, ad_snowm_stand7 ] {ad_ai_stand();};
void() ad_snowm_stand7 = [ $stand1, ad_snowm_stand8 ] {ad_ai_stand();};
void() ad_snowm_stand8 = [ $stand1, ad_snowm_stand1 ] {ad_ai_stand();};

