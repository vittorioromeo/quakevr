void() ad_snowm_run1 = [ $stand1, ad_snowm_run2 ] {ad_monster_idle_sound();ad_ai_run(0);}
void() ad_snowm_run2 = [ $stand1, ad_snowm_run3 ] {ad_ai_run(0);};
void() ad_snowm_run3 = [ $stand1, ad_snowm_run4 ] {ad_ai_run(0);};
void() ad_snowm_run4 = [ $stand1, ad_snowm_run5 ] {ad_ai_run(0);};
void() ad_snowm_run5 = [ $stand1, ad_snowm_run6 ] {ad_ai_run(0);};
