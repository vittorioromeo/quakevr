//======================================================================
// MELEE : Crows Claw
//======================================================================
void() ad_SnowmMelee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_damagebreakable(10);							// Damage any breakables
	if (!ad_ai_checkmelee(ad_MONAI_MELEESNOWMAN,ad_FALSE)) return; // Too far away

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	sound(self, ad_CHAN_WEAPON, "xmas/snowman/claw.wav", ad_TRUE, ad_TRUE);

	// Claw attack is good (1-15)
	ad_ldmg = (random() + random() + random()) * 5;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Spawn blood at claw
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

//----------------------------------------------------------------------
void() ad_snowm_claw1 = [ $claw1, ad_snowm_claw2 ] {ad_ai_face();};
void() ad_snowm_claw2 = [ $claw2, ad_snowm_claw3 ] {ad_ai_face();};
void() ad_snowm_claw3 = [ $claw3, ad_snowm_claw4 ] {ad_ai_face();ad_SnowmMelee();};
void() ad_snowm_claw4 = [ $claw4, ad_snowm_claw5 ] {};
void() ad_snowm_claw5 = [ $claw5, ad_snowm_run1 ] {
	// Check if snowman is within range to attack again
	if (ad_ai_checkmelee(ad_MONAI_MELEESNOWMAN,ad_FALSE) && self.enemy.health > 0) {
		if (self.health > 0) self.think = ad_snowm_claw1;
	}
};

//======================================================================
// RANGE : Burst of Nails
//======================================================================
void() ad_SnowmFireNails =
{
	local vector ad_org, ad_dir, ad_vec;
	local float ad_loopvar;
	
	// Check for death?
	if (self.health < 1) return;
	ad_loopvar = 0;

	// Light up face, setup projectile speed and play fire sound
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_NAILSNOWMPROJ + (ad_skill * ad_SPEED_NAILSNOWMSKILL);
	sound(self, ad_CHAN_WEAPON, "xmas/snowman/nail_fire.wav", 1, ad_ATTN_NORM);

	// turn and face your enemy!
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	
	// Loop through the nail burst (all at once)
	while (ad_loopvar < self.ad_attack_count) {
		// Random circle spread pattern
		ad_vec = (ad_crandom()*20)*v_right + (ad_crandom()*20)*v_up;
		ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
		// Generate a red hot nail projectile
		ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_MONNG, self.ad_attack_speed);
		ad_loopvar = ad_loopvar + 1;
	}
};

//----------------------------------------------------------------------
void() ad_snowm_nail1 = [ $attack1, ad_snowm_nail2 ] {ad_ai_face();};
void() ad_snowm_nail2 = [ $attack2, ad_snowm_nail3 ] {ad_ai_face();};
void() ad_snowm_nail3 = [ $attack3, ad_snowm_nail4 ] {ad_ai_face();ad_SnowmFireNails();};
void() ad_snowm_nail4 = [ $attack2, ad_snowm_nail5 ] {};
void() ad_snowm_nail5 = [ $attack1, ad_snowm_run1 ] {ad_ai_face();};

//======================================================================
// PAIN : quick reflection
//======================================================================
void() ad_snowm_pain1 = [ $claw4, ad_snowm_pain2 ] {};
void() ad_snowm_pain2 = [ $claw3, ad_snowm_pain3 ] {};
void() ad_snowm_pain3 = [ $claw2, ad_snowm_pain4 ] {};
void() ad_snowm_pain4 = [ $claw1, ad_snowm_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_snowm_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_snowm_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.6;
			self.ad_axhitme = 0;
			ad_snowm_pain1 ();
		}
	}
};

//======================================================================
// Exploding snowball!
//======================================================================
void() ad_snowm_explode =
{
	// no more raindeer!
	ad_entity_hide (self);
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// ID style explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	if (self.ad_death_dmg > 0)
		ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	
	// Sprite + Dust
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);

	// No blood or guts!
	ad_ThrowGib(25, 1);
	ad_ThrowGib(11, 1);
	ad_ThrowGib(12, 1);
	ad_ThrowGib(13, 8 + rint(random()*8));

	/*-------------------------------------------------------------------
	// The snowball model has a melting animation (6 frames)
	// Unfortunately it does look really old and dated,
	// its better to let model just fade away.
	//
	// The final gib is a snowball which has a melting animation
	// Setup animation start/finish parameters before throwing
	self.gibAnimstart = 1;
	self.gibAnimfinal = 5;
	self.gibAnimTimer = 2;		// timer + (random() * (timer*2))
	ThrowGib(13, 8 + rint(random()*8)); */
};

//----------------------------------------------------------------------
void() ad_snowm_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// There is no death animation
	if (random() < 0.5)
		sound (self, ad_CHAN_BODY, self.ad_death_sound, 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_BODY, self.ad_death_sound2, 1, ad_ATTN_NORM);
	ad_snowm_explode();
};

/*======================================================================
QUAKED monster_snowman (1 0 0) (-16 -16 -24) (16 16 32) Ambush
======================================================================*/
void() ad_monster_xmas_snowman =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/xmas/mon_snowman.mdl";		// Top Hat Snow
	self.ad_headmdl = "progs/xmas/h_snowman.mdl";		// Top Hat
	self.ad_gib1mdl = "progs/xmas/gib_snowclaw.mdl";	// Claw
	self.ad_gib2mdl = "progs/xmas/gib_snowgun.mdl";	// Nail Gun
	self.ad_gib3mdl = "progs/xmas/gib_snowball.mdl";	// Snowballs
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	self.ad_gib2sound = ad_GIB_IMPACT_METALA;

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);				// Top Hat
	precache_model (self.ad_gib1mdl);				// Claw
	precache_model (self.ad_gib2mdl);				// Gun
	precache_model (self.ad_gib3mdl);				// Snow-BALLS!
	precache_model (ad_MODEL_PROJ_NGRED);			// Red Nails (easier to see)

	// Idle calm/angry
	self.ad_idle_sound = "xmas/snowman/idle.wav";	// Rustling sound
	precache_sound (self.ad_idle_sound);

	// Many different sight sounds
	self.ad_sight_sound = "xmas/snowman/sight1.wav";	// Deep voice
	self.ad_sight_sound2 = "xmas/snowman/sight2.wav";	// Growling
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_sight_sound2);
	self.ad_sight_count = 2;

	// Melee/Range Attacks
	// Original version used ice, switched to red nails
	// Ice nails are really difficult to see
	precache_sound ("xmas/snowman/claw.wav");
	precache_sound ("xmas/snowman/nail_fire.wav");
	
	// precache sight, pain and death (changes on type)
	self.ad_pain_sound = "xmas/snowman/pain1.wav";
	self.ad_pain_sound2 = "xmas/snowman/pain2.wav";
	self.ad_death_sound = "xmas/snowman/death1.wav";
	self.ad_death_sound2 = "xmas/snowman/death2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = 125;
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_SNOWMAN;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_gibbed = ad_FALSE;				// Still in one peice
	self.ad_pain_flinch = 30;				// Light pain threshold
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_steptype = ad_FS_TYPESLOW;		// Small sounding feet
	self.ad_poisonous = ad_FALSE;				// Not Supported
	self.ad_meleeoffset = '24 0 20';		// Claw attack offset
	self.ad_attack_offset = '24 0 20';		// Run + Gun vector
	self.ad_bleedcolour = ad_MON_BCOLOR_SILVER;// Red is odd for snow
	self.ad_deathstring = " was smashed on a Snowman\n";

	// Default amount of nails to burst fire (5x9=45dmg)
	if (self.ad_attack_count < 1) self.ad_attack_count = 5;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_SnowmanCheckAttack;
	self.ad_th_stand = ad_snowm_stand1;
	self.ad_th_walk = ad_snowm_walk1;
	self.ad_th_run = ad_snowm_run1;
	self.ad_th_melee = ad_snowm_claw1;
	self.ad_th_missile = ad_snowm_nail1;
	self.ad_th_pain = ad_snowm_pain;
	self.ad_th_die = ad_snowm_die;

	self.ad_classtype = ad_CT_MONSNOWMAN;
	self.ad_classgroup = ad_CG_XMAS;
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();	
};