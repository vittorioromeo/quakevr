//======================================================================
// Story books
//======================================================================
// Closed
$frame closed1 closed2 closed3 closed4 closed5 closed6 closed7 closed8 closed9 closed10

// Idle B - looking around turning left and then right (based on closed)
$frame idleb1 idleb2 idleb3 idleb4 idleb5 idleb6 idleb7 idleb8 idleb9 idleb10
$frame idleb11 idleb12 idleb13 idleb14 idleb15 idleb16 idleb17 idleb18 idleb19 idleb20

// Idle C - spin around 360 degrees (based on closed)
$frame idlec1 idlec2 idlec3 idlec4 idlec5 idlec6 idlec7 idlec8 idlec9 idlec10
$frame idlec11 idlec12 idlec13 idlec14 idlec15 idlec16 idlec17 idlec18 idlec19 idlec20

// Opening (closed -> open)
$frame opening1 opening2 opening3 opening4 opening5 opening6 opening7 opening8 opening9 opening10

// Open
$frame open1 open2 open3 open4 open5 open6 open7 open8 open9 open10

void() ad_book_closed1;
void(float ad_fadedir) ad_info_book_fadesetup;

//----------------------------------------------------------------------
float ad_MISCBOOK_NOMODEL = 1;		// Will not use any model and particles
float ad_MISCBOOK_PLINTH1 = 2;		// setup and spawn on plinth1
float ad_MISCBOOK_PLINTH2 = 4;		// setup and spawn on plinth2
float ad_MISCBOOK_STORY = 8;		// setup book as part of story
float ad_MISCBOOK_COLLISION = 16;	// Use bounding box collision for plinth
float ad_MISCBOOK_ANGLEONLY = 32;  // Will only work when standing infront of entity
float ad_MISCBOOK_NOEFFECTS = 128;	// Disable particles and effects

float ad_MISCBOOK_FADEOUT = 192;	// Background density while reading books
float ad_MISCBOOK_LOOPADVANCE = 0.01;

float ad_MISCBOOK_CLOSED = 1;
float ad_MISCBOOK_OPENING = 2;
float ad_MISCBOOK_CLOSING = 4;
float ad_MISCBOOK_OPEN = 8;
float ad_MISCBOOK_STAYOPEN = 16;

