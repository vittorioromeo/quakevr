void()	ad_book_stayopen10 = [$open10, ad_book_stayopen1 ] {};

//----------------------------------------------------------------------
// Players has walked away, decide what to do with the book
//----------------------------------------------------------------------
void() ad_book_finish =
{
	ad_info_book_fadesetup(-1);
	// Clear client centerprint suppression
	if (self.enemy.flags & ad_FL_CLIENT) {	
		self.enemy.ad_suppressCenterPrint = ad_FALSE;
		ad_centerprint(self.enemy, "");
	}
	if (self.ad_pain_finished > 0) ad_book_stayopen1();
	else ad_book_closing1();
};

//----------------------------------------------------------------------
// Book is open (waiting to close)
//----------------------------------------------------------------------
void()	ad_book_open1 = [$open1, ad_book_open2 ] {self.state = ad_MISCBOOK_OPEN;};
void()	ad_book_open2 = [$open2, ad_book_open3 ] {if (self.wait < time) ad_book_finish();};
void()	ad_book_open3 = [$open3, ad_book_open4 ] {};
void()	ad_book_open4 = [$open4, ad_book_open5 ] {if (self.wait < time) ad_book_finish();};
void()	ad_book_open5 = [$open5, ad_book_open6 ] {};
void()	ad_book_open6 = [$open6, ad_book_open7 ] {if (self.wait < time) ad_book_finish();};
void()	ad_book_open7 = [$open7, ad_book_open8 ] {};
void()	ad_book_open8 = [$open8, ad_book_open9 ] {if (self.wait < time) ad_book_finish();};
void()	ad_book_open9 = [$open9, ad_book_open10 ] {};
void()	ad_book_open10= [$open10, ad_book_open1 ] {if (self.wait < time) ad_book_finish();};

