//----------------------------------------------------------------------
void() ad_info_book_fade = 
{
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Fade direction needs to be -1 or +1 (0.48s fade time)
	self.lip = self.lip + (self.height * 4);
	// Check if fade has reached 0 or max screen fade value
	if (self.lip <= 0) self.lip = 0;
	else if (self.lip >= ad_MISCBOOK_FADEOUT) self.lip = ad_MISCBOOK_FADEOUT;
	else self.nextthink = time + ad_MISCBOOK_LOOPADVANCE;
	
	// Only update the screen if the debuff system is NOT active
	// and the client does NOT have any powerups active
	if (!(self.enemy.ad_cshift_upd && (self.enemy.items & ad_ALL_ITARTIFACTS) == 0)) {	
		// Change screen background density (makes text easier to read)
		stuffcmd(self.enemy, "v_cshift 0 0 0 ");
		stuffcmd(self.enemy, ftos(self.lip));
		stuffcmd(self.enemy, "\n");
	}
};

//----------------------------------------------------------------------
void(float ad_fadedir) ad_info_book_fadesetup =
{
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Is the fade controller setup?
	if (self.ad_attachment) {
		// Double check if screen fade is setup already
		if (ad_fadedir > 0 && self.ad_attachment.lip == ad_MISCBOOK_FADEOUT) return;
		if (ad_fadedir < 0 && self.ad_attachment.lip == 0) return;
		
		// Copy over client and fadedir to controller
		self.ad_attachment.enemy = self.enemy;
		self.ad_attachment.height = ad_fadedir;
		self.ad_attachment.think = ad_info_book_fade;
		self.ad_attachment.nextthink = time + ad_MISCBOOK_LOOPADVANCE;
		self.ad_attachment.ltime = self.ad_attachment.nextthink;
	}
};

//----------------------------------------------------------------------
void() ad_info_book_displaystory =
{
	// is this book part of a storyline?
	// The controller has been setup/validated already
	if (self.spawnflags & ad_MISCBOOK_STORY) {
		// Check controller once!
		self.spawnflags = self.spawnflags - (self.spawnflags & ad_MISCBOOK_STORY);

		if (self.ad_attachment.ad_estate == ad_ESTATE_OFF) {
			self.message = "Story controller broken!\n\n";
		}
		else {
			// Copy over story chapter
			self.message = self.ad_attachment.ad_oldenemy.message;
			self.ad_message2 = self.ad_attachment.ad_oldenemy.ad_message2;
			self.ad_message3 = self.ad_attachment.ad_oldenemy.ad_message3;
			self.ad_message4 = self.ad_attachment.ad_oldenemy.ad_message4;
		}

		// Work out which centerprint to use
		if (self.ad_message3 != "" && self.ad_message4 != "") self.cnt = 2;
		else if (self.ad_message3 != "") self.cnt = 1;
		else self.cnt = 0;

		// Move controller on to next story chapter
		if (self.ad_attachment.height < self.ad_attachment.count) {
			self.ad_attachment.count = self.ad_attachment.count + 1;
			self.ad_attachment.ad_oldenemy = self.ad_attachment.ad_oldenemy.ad_oldenemy;
		}
	}
		
	// Suppress any other centerprint messages and show story
	self.enemy.ad_suppressCenterPrint = ad_TRUE;
	// Check for any additional strings and use correct centerprint
	// The engine function will merge several strings together
	if (self.cnt == 1) ad_centerprint_msg3(self.enemy, self.message, self.ad_message2, self.ad_message3);
	else if (self.cnt == 2) ad_centerprint_msg4(self.enemy, self.message, self.ad_message2, self.ad_message3, self.ad_message4);
	else ad_centerprint_msg(self.enemy, self.message, self.ad_message2);

	// Check for any additional trigger events
	if (self.target != "") {
		ad_trigger_strs(self.target, self.enemy);
		self.target = "";
	}
};

//----------------------------------------------------------------------
void() ad_info_book_touch =
{
	local float ad_book_yaw, ad_book_angle1, ad_book_angle2, ad_play_yaw, ad_play_angle;

	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	if (ad_intermission_running > 0) return;
	if (ad_cinematic_running > 0) return;
	if ( !(other.flags & ad_FL_CLIENT) ) return;
	if (other.health < 1) return;
	if (other.flags & ad_FL_NOTARGET) return;

	// Store player entity for later use	
	self.enemy = other;

	if (self.spawnflags & ad_MISCBOOK_ANGLEONLY) {
		// Check the players facing direction against book angle direction
		// make sure the player angle is never negative, + 360 just in case
		ad_play_angle = ad_anglemod(self.enemy.v_angle_y+360);
		// Work out angle cone based on book angle direction
		// Use previously defined angles for viewing angle of book
		ad_book_yaw = fabs(self.v_angle_y - self.v_angle_x);
		ad_book_angle1 = ad_anglemod(self.angles_y + 180 + (360-ad_book_yaw));
		ad_book_angle2 = ad_anglemod(self.angles_y + 180 + ad_book_yaw);
		// Is the players angle outside the book's viewing range?
		if (ad_play_angle < ad_book_angle1 || ad_play_angle > ad_book_angle2) return;
	}
	
	// The angle at the which the book is facing the player
	// book_yaw = vectoyaw(self.enemy.origin - self.origin);
	// book_angle = anglemod((self.angles_y - book_yaw) + 0);
	// The angle the player is facing towards the book (45 = forward)
	ad_play_yaw = vectoyaw(self.origin - self.enemy.origin);
	ad_play_angle = ad_anglemod((self.enemy.v_angle_y - ad_play_yaw) + 45);

	// Is the player looking at the book?
	if (ad_play_angle > self.v_angle_x && ad_play_angle < self.v_angle_y) {
		// Is the book closed?
		if (self.state == ad_MISCBOOK_CLOSED) {
			self.wait = time + 1.3;
			ad_book_opening1();
		}
		// Is the book currently open and been read before?
		else if (self.state == ad_MISCBOOK_STAYOPEN) {
			ad_info_book_fadesetup(1);
			self.wait = time + 0.3;
			self.ad_attack_finished = time + 0.2;
			ad_book_open1();
		}		
		// Has the book just opened and never been read before?
		else if (self.state == ad_MISCBOOK_OPEN && self.ad_pain_finished == ad_FALSE) {
			self.ad_pain_finished = ad_TRUE;
			ad_info_book_fadesetup(1);
			self.wait = time + 0.3;
			self.ad_attack_finished = time + 0.2;
			if (self.ad_part_emitter) ad_misc_particle_update(self.ad_part_emitter, ad_PARTICLE_STYLE_OPENBOOK);
			ad_info_book_displaystory();
		}
		// Is the book open and ready for a story?
		else if (self.state == ad_MISCBOOK_OPEN) {
			ad_info_book_fadesetup(1);
			self.wait = time + 0.3;
			if (self.ad_attack_finished < time) {
				self.ad_attack_finished = time + 0.2;
				ad_info_book_displaystory();
			}
		}
	}
};

//----------------------------------------------------------------------
void() ad_info_book_on = 
{
	self.ad_estate = ad_ESTATE_ON;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_TRIGGER;
	if ( !(self.spawnflags & ad_MISCBOOK_NOMODEL) ) {
		setmodel (self, self.mdl);
		self.skin = self.ad_exactskin;
	}

	// Make sure particle emitter is turned on
	if (self.ad_part_emitter) ad_misc_particle_on(self.ad_part_emitter);

	// Setup touch trigger and function
	self.touch = ad_info_book_touch;
	setsize (self, self.pos1, self.pos2);
	
	// If no model, don't need book animations + attachment models
	if ( !(self.spawnflags & ad_MISCBOOK_NOMODEL) ) {
		// Check for any plinth models
		if (self.ad_attachment2) {
			// Use bounding box coillsion?
			if (self.spawnflags & ad_MISCBOOK_COLLISION) self.ad_attachment2.solid = ad_SOLID_BBOX;
			else self.ad_attachment2.solid = ad_SOLID_NOT;
			setmodel (self.ad_attachment2, self.noise1);
		}
		
		// Setup book in correct animation state
		self.ad_search_time = time + 5 + (random()*5);	// delay idle animation
		if (self.state == ad_MISCBOOK_CLOSED) ad_book_closed1();
		else ad_book_stayopen1();
	}
};

//----------------------------------------------------------------------
void() ad_info_book_off = 
{
	self.ad_estate = ad_ESTATE_OFF;
	self.solid = ad_SOLID_NOT;
	setmodel (self, "");
	
	// Stop any touch/animations
	self.touch = self.think = ad_SUB_Null;

	// Check if the screen is faded?
	if (self.ad_attachment) {
		if (self.ad_attachment.lip != 0) {
			self.ad_attachment.lip = 0;
			if (!(self.enemy.ad_cshift_upd && (self.enemy.items & ad_ALL_ITARTIFACTS) == 0)) {	
				stuffcmd(self.enemy, "v_cshift 0 0 0 0\n");
			}
		}
	}
	
	// If any plinth exists, turn that off as well
	if (self.ad_attachment2) {
		setmodel(self.ad_attachment2, "");
		self.ad_attachment2.solid = ad_SOLID_NOT;
	}
};

//----------------------------------------------------------------------
void() ad_info_book_setup =
{
	// Setup book fade controller
	self.ad_attachment = spawn();
	self.ad_attachment.owner = self;
	self.ad_attachment.ad_classtype = ad_CT_CONTROL;
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	setorigin(self.ad_attachment,self.origin + '0 0 32');
	setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

	// Check for plinth and spawn/setup
	if (self.mdl != "" && self.noise1 != "") {
		self.ad_attachment2 = spawn();
		self.ad_attachment2.owner = self;
		self.ad_attachment2.ad_classtype = ad_CT_MISCMODEL;
		self.ad_attachment2.movetype = ad_MOVETYPE_NONE;
		
		// Trace downward to find the ground and place plinth
		traceline (self.origin, self.origin + '0 0 -512', ad_TRUE, self);
		self.origin = trace_endpos + '0 0 32';
		setorigin(self.ad_attachment2, self.origin);
		self.ad_attachment2.angles = self.angles;
		
		// Plinth2 has flat surface which conflicts with book angle
		if (self.spawnflags & ad_MISCBOOK_PLINTH2) self.origin = self.origin + '0 0 4';
	}

	// Check for random skin options
	if (self.ad_randomskin > 1) 
		self.ad_exactskin = rint(random()*(self.ad_randomskin-1));
	// The particle colours are based on the book skin
	if (self.ad_exactskin < 1) self.ad_exactskin = 0;
	if (self.ad_exactskin >= 6) self.style = ad_MISCBOOK_RED;
	else if (self.ad_exactskin >= 4) self.style = ad_MISCBOOK_BLUE;
	else self.style = ad_MISCBOOK_GREEN;
	
	// Default viewing angle is min 30 and max 60 looking at origin
	if (ad_CheckZeroVector(self.v_angle)) self.v_angle = '30 60 0';
	if (self.angles_y == 0) self.angles_y = 360;

	// Check for story book setup first
	// Story is supplied from story system when book is opened
	if (self.spawnflags & ad_MISCBOOK_STORY) {
		// Reset all storybook message strings
		self.message = "Waiting for story!"; 
		self.ad_message2 = "";
		self.ad_message3 = ""; self.ad_message4 = "";
		self.cnt = 0;
		self.ad_attachment = find(world, targetname, self.ad_target2);
		// Is this entity a storybook controller?
		if (!self.ad_attachment || self.ad_attachment.ad_classtype != ad_CT_STORYCONTROL)
		{
			dprint("\b[STORYBOOK]\b Missing controller!\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			ad_entity_hide(self);
			return;
		}
	}
	else {
		// setup default message for testing
		if (self.message == "") self.message = "\b--[ Dark Elder Magic ]--\b\n\n";
		if (self.ad_message2 == "") self.ad_message2 = "Despite the awful might of the Elder\nWorld, you have achieved the Rune of\nElder Magic, capstone of all types of\narcane wisdom. Beyond good and evil,\nbeyond life and death, the Rune\npulsates, heavy with import.\n";

		// Check for additional strings to display
		// This is to fix quark editor limit of 128 characters per string
		if (self.ad_message3 != "" && self.ad_message4 != "") self.cnt = 2;
		else if (self.ad_message3 != "") self.cnt = 1;
		else self.cnt = 0;
	}
	
	// Spawn particle emitter if particles active and not blocked
	if ( !(self.spawnflags & ad_MISCBOOK_NOMODEL) ) {
		self.ad_part_active = ad_PARTICLE_STYLE_BOOK;
		if (self.spawnflags & ad_ENT_STARTOFF) self.count = ad_PARTICLE_START_OFF;
		else self.count = ad_PARTICLE_START_ON;
		if (ad_query_configflag(ad_SVR_PARTICLES) == ad_SVR_PARTICLES) {
			if (!(self.spawnflags & ad_MISCBOOK_NOEFFECTS) && self.ad_part_active > 0)
				self.ad_part_emitter = ad_spawn_pemitter(self, self, self.ad_part_active, self.count);
		}
	}
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_info_book_on;
	self.ad_estate_off = ad_info_book_off;
	if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
	else self.ad_estate_on();
};

//======================================================================
/*ad:QUAKED misc_textbook (0 0.5 0.5) (-16 -16 -8) (16 16 8) NOMODEL PLINTH1 PLINTH2 STORY COLLISION ANGLEONLY STARTOFF NOEFFECTS
Display custom text messages
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
target     : trigger event when book is opened (only works once)
target2    : name of story controller (only works with spawnflag)
angle      : facing angle for model or direction player must be standing
v_angle    : The viewing angle the book is active (def=30,60,0)
exactskin  : skin number for book (1-8, Brown1/2,Green1/2,Blue1/2,Red1/2)
pos1       : Touch trigger minimin size (def=-48 -48 -32)
pos2       : Touch trigger maximum size (def=48 48 32)
message    : header message
message2   : Body Text 1 (need to add linefeeds)
message3   : Body Text 2 (displayed after message2)
message4   : Body Text 3 (displayed after message3)
-------- SPAWNFLAGS --------
NOMODEL   : Will not use book model + particles
PLINTH1   : Setup book on top of plinth1 model
PLINTH2   : Setup book on top of plinth2 model
STORY     : Book is part of a story (use target2)
COLLISION : Use bounding box collision for plinth
ANGLEONLY : Will only work when standing infront of entity (angle key)
STARTOFF  : Starts off and waits for trigger
NOEFFECTS : No particle or effects active
-------- NOTES --------
Display custom text messages
Maximum size of message is 1024 characters, 256 is the original limit

======================================================================*/
void() ad_misc_textbook =
{
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	self.ad_classtype = ad_CT_STORYBOOK;

	// Setup large bounding box for touch trigger
	if (ad_CheckZeroVector(self.pos1)) self.pos1 = '-48 -48 -32';
	if (ad_CheckZeroVector(self.pos2)) self.pos2 = '48 48 32';
	self.takedamage = ad_DAMAGE_NO;	// No damage from anything

	if (self.spawnflags & ad_MISCBOOK_NOMODEL) {
		self.mdl = "";
		self.state = ad_MISCBOOK_STAYOPEN;	// no book animation
		self.ad_pain_finished = ad_TRUE;		// No read delay
	}
	else {
		self.state = ad_MISCBOOK_CLOSED;	// Current state
		self.ad_pain_finished = ad_FALSE;		// Book not read yet
		// Default medieval book
		self.mdl = "progs/misc_textbook.mdl";
		precache_model (self.mdl);
		self.noise1 = "";
		// Check for any predefined plinth model setups
		if (self.spawnflags & ad_MISCBOOK_PLINTH1) {
			self.noise1 = "progs/misc_plinth1.mdl";
			precache_model(self.noise1);
		}
		else if (self.spawnflags & ad_MISCBOOK_PLINTH2) {
			self.noise1 = "progs/misc_plinth2.mdl";
			precache_model(self.noise1);
		}
	}
		
	// Don't spawn straight away
	self.nextthink = time + 0.1 + random()*0.4;
	self.think = ad_info_book_setup;
};

//======================================================================
/*ad:QUAKED misc_textstory (0 0.5 1.0) (-16 -16 -8) (16 16 8) x
Text Book Story Chapters
-------- KEYS --------
targetname : name of current chapter
target     : name of next chapter
message    : header message
message2   : Body Text 1 (need to add linefeeds)
message3   : Body Text 2 (displayed after message2)
message4   : Body Text 3 (displayed after message3)
-------- SPAWNFLAGS --------
-------- NOTES --------
Text Book Story Chapters
*/

/*ad:QUAKED misc_textstoryctrl (0 0.1 1.0) (-16 -16 -8) (16 16 8) x
Text Book Story Controller
-------- KEYS --------
targetname : name of controller for story
target : name of first chapter
-------- SPAWNFLAGS --------
-------- NOTES --------
Text Book Story Controller

======================================================================*/
void() ad_info_bookcont_setup = 
{
	local entity ad_storychap, ad_prevchap;
	
	// Is there any story chapters?
	ad_storychap = find(world, targetname, self.target);
	if (!ad_storychap) {
		dprint("\b[STORYCTRL]\b Missing start chapter!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}

	// Can only link to story chapter entities
	if (ad_storychap.ad_classtype != ad_CT_STORYCHAPTER) {
		dprint("\b[STORYCTRL]\b First chapter wrong entity!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}
	
	// Setup controller
	ad_prevchap = self;	// Start controller at chapter 1
	self.count = 0;		// Total chapters in story
	self.height = 1;	// Current chapter in story
	
	// Work through list
	while (ad_storychap) {
		// Visual debug for chapters
		ad_spawn_marker(ad_storychap.origin, ad_SPNMARK_BLUE);

		// Link chapters and move forward
		ad_prevchap.ad_oldenemy = ad_storychap;
		ad_prevchap = ad_storychap;
		self.count = self.count + 1;

		// Check for next target in chain
		if (ad_prevchap.target == "") ad_storychap = world;
		else ad_storychap = find(world, targetname, ad_prevchap.target);
	}
	// Point final chapter at itself
	ad_prevchap.ad_oldenemy = ad_prevchap;
	
	// Controller finally active
	self.ad_estate = ad_ESTATE_ON;
	// Visual debug for controller
	ad_spawn_marker(self.origin, ad_SPNMARK_GREEN);
	// Console message for chapters found
	dprint("\b[STORYCTRL]\b Chapters found (");
	dprint(ftos(self.count));
	dprint(")\n");
};

//----------------------------------------------------------------------
void() ad_misc_textstoryctrl =
{
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	self.ad_classtype = ad_CT_STORYCONTROL;
	// Start in disabled state until chapters setup
	self.ad_estate = ad_ESTATE_OFF;

	if (self.target == "") {
		dprint("\b[STORYCTRL]\b Missing story start!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}
	
	// Wait for chapter and books to spawn first
	self.nextthink = time + 1 + random();
	self.think = ad_info_bookcont_setup;
};

//----------------------------------------------------------------------
void() ad_misc_textstory =
{
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	self.ad_classtype = ad_CT_STORYCHAPTER;
};
