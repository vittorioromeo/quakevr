//----------------------------------------------------------------------
// Book closed
//----------------------------------------------------------------------
void()	ad_book_closed1 =	[$closed1, ad_book_closed2	] {self.state = ad_MISCBOOK_CLOSED;
	if (random() <	0.1 && self.ad_search_time < time) {
		self.ad_search_time = time + 2 + (random()*5);
		self.lefty = 1 - self.lefty;
		if (self.lefty > 0) ad_book_idleb1();	// Turn left and right
		else ad_book_idlec1();					// spin around
	}
};
void()	ad_book_closed2 =	[$closed2, ad_book_closed3 ] {};
void()	ad_book_closed3 =	[$closed3, ad_book_closed4 ] {};
void()	ad_book_closed4 =	[$closed4, ad_book_closed5 ] {};
void()	ad_book_closed5 =	[$closed5, ad_book_closed6 ] {};
void()	ad_book_closed6 =	[$closed6, ad_book_closed7 ] {};
void()	ad_book_closed7 =	[$closed7, ad_book_closed8 ] {};
void()	ad_book_closed8 =	[$closed8, ad_book_closed9 ] {};
void()	ad_book_closed9 =	[$closed9, ad_book_closed10 ] {};
void()	ad_book_closed10 =	[$closed10, ad_book_closed1 ] {};

//----------------------------------------------------------------------
// Book closing (open -> close)
//----------------------------------------------------------------------
void()	ad_book_closing1 =	[$opening10, ad_book_closing2	] {
	self.state = ad_MISCBOOK_CLOSING;
	// make sure book idles don't start straight away
	self.ad_search_time = time + 2 + (random()*5);
};
void()	ad_book_closing2 =	[$opening9, ad_book_closing3	] {};
void()	ad_book_closing3 =	[$opening8, ad_book_closing4	] {};
void()	ad_book_closing4 =	[$opening7, ad_book_closing5	] {};
void()	ad_book_closing5 =	[$opening6, ad_book_closing6	] {};
void()	ad_book_closing6 =	[$opening5, ad_book_closing7	] {};
void()	ad_book_closing7 =	[$opening4, ad_book_closing8	] {};
void()	ad_book_closing8 =	[$opening3, ad_book_closing9	] {};
void()	ad_book_closing9 =	[$opening2, ad_book_closing10	] {};
void()	ad_book_closing10= [$opening1, ad_book_closed1	] {};

//----------------------------------------------------------------------
// Book always open (final stage of book)
//----------------------------------------------------------------------
void()	ad_book_stayopen1 = [$open1, ad_book_stayopen2 ] {self.state = ad_MISCBOOK_STAYOPEN;};
void()	ad_book_stayopen2 = [$open2, ad_book_stayopen3 ] {};
void()	ad_book_stayopen3 = [$open3, ad_book_stayopen4 ] {};
