/*ad:QUAKED trap_rocketshooter (0 0.5 0.8) (-8 -8 -8) (8 8 8) LAVA FIRE JIM x x TOGGLE x TRACK Not_Easy Not_Normal Not_Hard Not_DM
When triggered, fires a ROCKET in the direction determined by angle
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
target : targeting entity used for custom direction
angle  : direction for projectile to follow, use "360" for angle 0
wait   : time between projectiles (def=0s)
delay  : random time between projectile (def=0s)
speed  : Change projectile speed (def=1000, lava=300, fire=500)
-------- SPAWNFLAGS --------
LAVABALL : shoots Chthon lava ball (Player damage)
FIREBALL : shoots Gargoyle fire ball (low damage)
JIM FLYER: shoots Jim rocket (low damage)
TOGGLE : Trigger will toggle the shooter on/off instead
TRACK  : Will update target entity origin before firing
-------- NOTES --------
When triggered, fires a ROCKET in the direction determined by angle
Use TOGGLE spawnflag and trigger to enable continuous mode

======================================================================*/
void() ad_trap_rocketshooter =
{
	if (self.spawnflags & ad_TRAP_LAVAROCKET) {
		self.mdl = ad_MODEL_PROJ_LAVA;
		precache_model (self.mdl);
		self.noise = "boss1/throw.wav";
		precache_sound (self.noise);

		self.ad_classproj = ad_CT_PROJ_LAVA;
		if (!self.speed) self.speed = ad_SPEED_LAVABALL;
	}
	else if (self.spawnflags & ad_TRAP_FIREROCKET) {
		self.mdl = ad_MODEL_PROJ_GARGOYLE;
		precache_model (self.mdl);
		self.noise = "gargoyle/attack1.wav";
		precache_sound (self.noise);

		self.ad_classproj = ad_CT_PROJ_GARG;
		if (!self.speed) self.speed = ad_SPEED_GARGMISSILE;
	}
	else if (self.spawnflags & ad_TRAP_JIMROCKET) {
		self.mdl = ad_MODEL_PROJ_ROCKET;
		precache_model (self.mdl);
		self.noise = "weapons/sgun1.wav";
		precache_sound (self.noise);
		precache_sound ("jim/rocket_hit.wav");

		self.ad_classproj = ad_CT_PROJ_JIM2;
		if (!self.speed) self.speed = ad_SPEED_RLPLAYER;
	}
	else {
		self.mdl = ad_MODEL_PROJ_ROCKET;
		precache_model (self.mdl);
		self.noise = "weapons/sgun1.wav";
		precache_sound (self.noise);

		self.ad_classproj = ad_CT_PROJ_ROCKET;
		if (!self.speed) self.speed = ad_SPEED_RLPLAYER;
	}

	self.ad_classtype = ad_CT_ROCKETSHOOTER;
	if (self.wait <= 0) self.wait = 1;
	if (self.delay < 0) self.delay = 0;
	if (!self.volume) self.volume = 1;
	self.mangle = self.angles;
	ad_SetMovedir ();

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trap_shooter_use;
	self.ad_estate_reset = ad_trap_shooter_reset;
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_OFF;

	// If target is setup, calculate new facing angle
	if (self.target != "") {
		self.ad_angletarget = self.target;
		self.nextthink = time + 1 + random();
		self.think = ad_TargetMovedirReturn;
	}
};

//======================================================================
/*ad:QUAKED trap_lightningshooter (0 0.5 0.8) (-8 -8 -8) (8 8 8) LARGE x x DUST PART TOGGLE x TRACK
When triggered, fires a LIGHTNING at the target entity (can be blocked)
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
target   : targeting entity used for destination (required)
wait     : time between projectiles (def=1s)
delay    : random time between projectile (def=0s)
volume   : Lightning hit sound volume (def=0.75)
dmg      : Damage from lightning strike (def=15, large=30)
pos1     : Random XYZ wobble to source position
pos2     : Random XYZ wobble to target position
-------- SPAWNFLAGS --------
LARGE   : Cthton Boss Lightning
DUST    : Produce dust/smoke at point of impact
PARTICLE: Produce particles at point of impact
TOGGLE  : Trigger will toggle the shooter on/off instead
TRACK   : Will update target entity origin before firing
-------- NOTES --------
When triggered, fires a LIGHTNING at the target entity (can be blocked)
Use TOGGLE spawnflag and trigger to enable continuous mode

======================================================================*/
void() ad_trap_lightningshooter = 
{
	self.noise = "weapons/lhit.wav";
	precache_sound (self.noise);

	self.ad_classtype = ad_CT_LIGHTSHOOTER;
	if (self.wait <= 0) self.wait = 1;
	if (self.delay < 0) self.delay = 0;
	if (!self.volume) self.volume = 0.75;
	self.t_width = 0;		// Light sound timer

	// Sort out lightning damage
	if (self.dmg < 1) {
		self.dmg = 15;
		// Double for large lightning
		if (self.spawnflags & ad_TRAP_LIGHTLARGE) self.dmg = 30;
	}
	
	// Work out which lightning bolt to use
	if (self.spawnflags & ad_TRAP_LIGHTLARGE) self.lip = ad_TE_LIGHTNING3;
	else self.lip = ad_TE_LIGHTNING2;

	// Must have target for destination of lightning
	if (self.target == "") {
		dprint("\b[TRAP]\b Lightning trap missing target!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trap_shooter_use;
	self.ad_estate_reset = ad_trap_shooter_reset;
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_OFF;

	// Find target once everything has spawned
	self.ad_angletarget = self.target;
	self.nextthink = time + 1 + random();
	self.think = ad_TargetMovedirReturn;
};

//======================================================================
/*ad:QUAKED trap_gasshooter (0 .5 .8) (-8 -8 -8) (8 8 8) STEAM FIRE POISON x SILENT TOGGLE x TRACK
When triggered, fires a gas particle in the direction determined by angle
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
target : targeting entity used for custom direction
angle  : direction for stream to follow, use "360" for angle 0
wait   : time between particles (def=0.05s)
speed  : velocity speed (def=200)
waitmin: auto switch off timer (def=0.5s)
dmg    : damage from contact with particles (def=1)
-------- SPAWNFLAGS --------
STEAM  : White hot clouds of steam (default)
FIRE   : Will add burning debuff to player
POISON : Will add poison debuff to player
SILENT : No on/off sound, its silent!
TOGGLE : Trigger will toggle the shooter on/off instead
TRACK  : Will update target entity origin before firing
-------- NOTES --------
When triggered, fires a gas particle in the direction determined by angle
Use TOGGLE spawnflag and trigger to enable continuous mode

======================================================================*/
void() ad_trap_gasshooter_touch =
{
	if (other == self.owner) return;
	if (other.solid == ad_SOLID_TRIGGER) return;
	if (other.health < 1) return;
	if (other.takedamage == ad_DAMAGE_NO) return;
	if (self.ad_attack_finished > time) return;
	if (other.ad_classtype == self.owner.ad_classtype) return;

	self.ad_attack_finished = time + 1;
	
	// Check contact is a player?
	if (other.flags & ad_FL_CLIENT) {
		// Check for debuff particle type first
		if (self.owner.spawnflags & ad_TRAP_GASFIRE)
			ad_ApplyFireDmg(other, self.owner.dmg, self.owner.dmg);
		else if (self.owner.spawnflags & ad_TRAP_GASPOISON)
			ad_PoisonDeBuff(other);
		else ad_T_Damage (other, self, self, self.owner.dmg, ad_NOARMOR);
	}
	// Monsters have special damage to kill them quicker
	else if (other.flags & ad_FL_MONSTER) ad_T_Damage (other, self, self, ad_DAMAGE_MONFLAME, ad_NOARMOR);
	else ad_T_Damage (other, self, self, self.owner.dmg, ad_NOARMOR);
	self.velocity = '0 0 0';
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter_think =
{
	self.cnt = self.cnt + 1;
	if (self.cnt > 6) remove(self);
	else {
		self.frame = self.cnt;
		self.nextthink = time + 0.1 + random() * 0.05;
	}
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter_spawn =
{
	local entity ad_partemit;
	
	// Check if disabled/off first
	if (self.ad_estate & ad_ESTATE_BLOCK) self.state = ad_STATE_OFF;
	if (self.state == ad_STATE_OFF) return;

	// Check for any target entity tracking changes
	if (self.spawnflags & ad_TRAP_TRACKING) ad_TargetMovedir(self, ad_FALSE);
	
	ad_partemit = spawn();
	ad_partemit.ad_classtype = ad_CT_TEMPSTREAM;
	ad_partemit.owner = self;
	ad_partemit.frame = ad_partemit.cnt = 0;

	ad_partemit.movetype = ad_MOVETYPE_FLY;	// Fly, no gravity, but contact
	ad_partemit.solid = ad_SOLID_TRIGGER;		// collision, touch required
	setmodel (ad_partemit, self.mdl);
	setorigin (ad_partemit, self.origin);
	setsize (ad_partemit, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

	ad_partemit.oldorigin = ad_vecrand(0,20,ad_TRUE);
	ad_partemit.velocity = (self.movedir * self.speed) + ad_partemit.oldorigin;
	ad_partemit.angles_z = random() * 360;

	// If DP engine active remove particle shadow
	if (ad_engine == ad_ENG_DPEXT) ad_partemit.effects = ad_partemit.effects + ad_EF_NOSHADOW;

	ad_partemit.nextthink = time + 0.1 + random() * 0.05;
	ad_partemit.think = ad_trap_gasshooter_think;
	ad_partemit.touch = ad_trap_gasshooter_touch;

	// Continuous mode or auto switch off mode still on?
	if (self.spawnflags & ad_TRAP_TOGGLE || self.ad_waitmin2 > time) {
		self.think = ad_trap_gasshooter_spawn;
		self.nextthink = time + self.wait;
	}
	// Time to switch off
	else {
		self.state = ad_STATE_OFF;
		sound (self, ad_CHAN_VOICE, self.noise2, 1, ad_ATTN_NORM);
	}
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter_off =
{ 
	self.ad_estate = ad_ESTATE_OFF;
	// If gas shooter currently on, play switch off sound
	if (self.state == ad_STATE_ON) 
		sound (self, ad_CHAN_VOICE, self.noise2, 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	self.state = ad_STATE_OFF;
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter_reset =
{ 
	self.ad_estate = ad_ESTATE_ON;
	// clear any sounds playing
	sound (self, ad_CHAN_VOICE, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	self.state = ad_STATE_OFF;
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter_on =
{ 
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_ON;
	sound (self, ad_CHAN_VOICE, self.noise1, 1, ad_ATTN_NORM);
	self.ad_waitmin2 = time + self.waitmin;
	ad_trap_gasshooter_spawn();
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter_use =
{
	// Check if disabled/off first
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	
	// Check for firing conditions (nightmare, coop)
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;

	// Toggle shooter on/off
	if (self.state == ad_STATE_ON) {
		self.state = ad_STATE_OFF;
		sound (self, ad_CHAN_VOICE, self.noise2, 1, ad_ATTN_NORM);
	}
	else ad_trap_gasshooter_on();
};

//----------------------------------------------------------------------
void() ad_trap_gasshooter =
{
	if (self.spawnflags & ad_TRAP_GASFIRE) {
		self.mdl = ad_SBURST_FLAME;
		self.noise1 = "traps/flame_loop.wav";
		self.noise2 = "traps/flame_off.wav";
	}
	else if (self.spawnflags & ad_TRAP_GASPOISON) {
		self.mdl = ad_SBURST_POISON;
		self.noise1 = "traps/steam_loop.wav";
		self.noise2 = "traps/steam_off.wav";
	}
	else {
		// Steam particles is the default
		self.spawnflags = self.spawnflags | ad_TRAP_GASSTEAM;
		self.mdl = ad_SBURST_STEAM;
		self.noise1 = "traps/steam_loop.wav";
		self.noise2 = "traps/steam_off.wav";
	}

	if (self.spawnflags & ad_TRAP_GASSILENT) {
		self.noise1 = ad_SOUND_EMPTY;
		self.noise2 = ad_SOUND_EMPTY;
	}
	precache_model (self.mdl);
	precache_sound (self.noise1);
	precache_sound (self.noise2);
	
	self.ad_classtype = ad_CT_GASSHOOTER;
	self.solid = ad_SOLID_NOT;				// No world interaction
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement

	if (!self.dmg) self.dmg = 1;
	if (self.speed < 1) self.speed = 200;
	if (self.wait <0.05) self.wait = 0.05;
	if (self.waitmin <=0) self.waitmin = 0.5;
	
	// Does not auto switch off anymore
	if (self.spawnflags & ad_TRAP_TOGGLE) self.waitmin = ad_LARGE_TIMER;
	
	// setup any angle direction
	if (self.angles_y == 0) self.angles_y = 360;
	self.mangle = self.angles;
	ad_SetMovedir();
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trap_gasshooter_use;
	self.ad_estate_reset = ad_trap_gasshooter_reset;
	self.ad_estate_off = ad_trap_gasshooter_off;
	self.ad_estate_on = ad_trap_gasshooter_on;
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_OFF;

	// If target is setup, calculate new facing angle
	if (self.target != "") {
		self.ad_angletarget = self.target;
		self.nextthink = time + 1 + random();
		self.think = ad_TargetMovedirReturn;
	}
};
