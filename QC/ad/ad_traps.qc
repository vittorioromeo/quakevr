// AD's readme and docs/vr-port/CREDITS.md), my_progs/traps.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// TRAP SHOOTERS
//======================================================================
float ad_TRAP_SNGSPIKE = 1;		// Large SNG spikes (high damage)
float ad_TRAP_LASER = 2;			// Enforcer style lasers
float ad_TRAP_WIZSPIKE = 4;		// Wizard Acid spit spike
float ad_TRAP_HELLSPIKE = 8;		// Hell Knight Fire spikes 
float ad_TRAP_LARGEGRENADE = 1;	// Player grenades (high damage)
float ad_TRAP_LAVAROCKET = 1;		// Slow moving Cthton lava ball
float ad_TRAP_FIREROCKET = 2;		// Fast moving Gargoyle fireball
float ad_TRAP_JIMROCKET = 4;		// Low damage player rocket
float ad_TRAP_LIGHTLARGE = 1;		// Cthton Lightning effect
float ad_TRAP_LIGHTDUST = 8;		// Dust/Smoke effects at impact
float ad_TRAP_LIGHTPART = 16;		// Particle effects at impact

float ad_TRAP_GASSTEAM = 1;		// Gas particle types (default)
float ad_TRAP_GASFIRE = 2;
float ad_TRAP_GASPOISON = 4;
float ad_TRAP_GASSILENT = 16;		// No particle sound effects

float ad_TRAP_TOGGLE = 32;			// Toggle function with triggered
float ad_TRAP_TRACKING = 128;		// Keep updating the target position

//======================================================================
/*ad:QUAKED trap_spikeshooter (0 0.5 0.8) (-8 -8 -8) (8 8 8) SNG LASER WIZARD HELLK x TOGGLE x TRACK
When triggered, fires a SPIKE in the direction determined by angle
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
target : targeting entity used for custom direction
angle  : direction for projectile to follow, use "360" for angle 0
wait   : time between projectiles (def=0s)
delay  : random time between projectile (def=0s)
count  : = 1 Continuous mode (toggle/trigger to switch off)
speed  : Change projectile speed (def/sng=500, laser=600, wiz=500, hell=300)
-------- SPAWNFLAGS --------
SNG    : shoots large spike (SNG damage)
LASER  : shoots laser (Enforcer damage)
WIZARD : shoots acid spike (Wizard damage)
HELLK  : shoots fire spike (Hell Knight damage)
TOGGLE : Trigger will toggle the shooter on/off instead
TRACK  : Will update target entity origin before firing
-------- NOTES --------
When triggered, fires a SPIKE in the direction determined by angle
Use TOGGLE spawnflag and trigger to enable continuous mode

======================================================================*/
void() ad_trap_shooter_fire =
{
	local vector ad_lightn_start, ad_lightn_finish;
	
	// Check if disabled/off first
	if (self.ad_estate & ad_ESTATE_BLOCK) self.state = ad_STATE_OFF;
	if (self.state == ad_STATE_OFF) return;

	// Check for any target entity tracking changes
	if (self.spawnflags & ad_TRAP_TRACKING) ad_TargetMovedir(self, ad_TRUE);

	// Fire projectile sound
	if (self.ad_classtype == ad_CT_LIGHTSHOOTER) {
		// Time for a new LG hit sound?
		if (self.t_width < time) {
			// Lower volume and attenuation just in case of several together
			sound (self, ad_CHAN_VOICE, self.noise, self.volume, ad_ATTN_NORM);
			self.t_width = time + 0.6;
		}
	}
	else if (self.noise != "") 
		sound (self, ad_CHAN_VOICE, self.noise, self.volume, ad_ATTN_NORM);

	// Determine type of projectile shooter
	if (self.ad_classtype == ad_CT_SPIKESHOOTER) {
		ad_launch_projectile (self.origin, self.movedir, self.ad_classproj ,self.speed);
	}
	else if (self.ad_classtype == ad_CT_GRENADESHOOTER) {
		self.ad_finaldest = self.movedir * self.speed;
		self.ad_finaldest_z = ad_ELEV_ZAXIS;
		self.finalangle = ad_vecrand(100,200,ad_FALSE);
		ad_Launch_Grenade(self.origin, self.ad_finaldest, self.finalangle, self.ad_classproj);
	}
	else if (self.ad_classtype == ad_CT_ROCKETSHOOTER) {
		if (self.spawnflags == ad_TRAP_LAVAROCKET) self.finalangle = ad_vecrand(100,200,ad_FALSE);
		else self.finalangle = '0 0 0';
		ad_Launch_Missile (self.origin, self.movedir, self.finalangle, self.ad_classproj, self.speed);
	}
	else if (self.ad_classtype == ad_CT_LIGHTSHOOTER) {
		// Double check a destination origin exists
		if (ad_CheckZeroVector(self.dest1)) return;
		
		self.effects = self.effects | ad_EF_MUZZLEFLASH;
		
		// setup any random X/Y/Z start/end point wobble
		ad_lightn_start = ad_lightn_finish = '0 0 0';
		if (ad_CheckZeroVector(self.pos1) == ad_FALSE) {
			ad_lightn_start_x = self.pos1_x * ad_crandom();
			ad_lightn_start_y = self.pos1_y * ad_crandom();
			ad_lightn_start_z = self.pos1_z * ad_crandom();
		}
		ad_lightn_start = ad_lightn_start + self.origin;
		if (ad_CheckZeroVector(self.pos2) == ad_FALSE) {
			ad_lightn_finish_x = self.pos2_x * ad_crandom();
			ad_lightn_finish_y = self.pos2_y * ad_crandom();
			ad_lightn_finish_z = self.pos2_z * ad_crandom();
		}
		ad_lightn_finish = ad_lightn_finish + self.dest1;

		// trace a line from trap in direction or an exact end point 
		traceline(ad_lightn_start, ad_lightn_finish, ad_TRUE, self);

		// Check for particle effects at impact
		// Designed to spray dust back towards source origin
		if (self.spawnflags & ad_TRAP_LIGHTDUST && random() < 0.7) {
			// Classic temporary entity
			ad_newmis = spawn();
			ad_newmis.ad_classgroup = ad_CG_TEMPENT;
			ad_newmis.movetype = ad_MOVETYPE_TOSS;
			ad_newmis.solid = ad_SOLID_NOT;
			setmodel(ad_newmis, ad_MODEL_PROJ_SMOKE);
			setorigin(ad_newmis, trace_endpos);
			setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
			
			// Work out vector between source and target
			self.ad_pos3 = normalize(ad_lightn_finish - ad_lightn_start);
			// Convert vector to angle so v_forward/v_right correct
			self.ad_pos3 = vectoangles(self.ad_pos3);
			makevectors(self.ad_pos3);
			
			// Randomize the X/Y and push the vector back to source
			ad_newmis.velocity = (ad_crandom()*v_right)*150 + v_forward*(150+random()*300);

			// Temporary ents, quickly remove afterward
			ad_newmis.nextthink = time + 1 + random()*3;
			ad_newmis.think = ad_SUB_Remove;
		}
		if (self.spawnflags & ad_TRAP_LIGHTPART)
			ad_particle_explode(trace_endpos, 5+random()*5, 1, ad_PARTICLE_BURST_BLUE, ad_PARTICLE_BURST_LOSTUP);
		
		// Generate the lightning effect
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, self.lip);
		WriteEntity (ad_MSG_BROADCAST, self); WriteByte (ad_MSG_BROADCAST, 0);
		WriteCoord (ad_MSG_BROADCAST, ad_lightn_start_x);
		WriteCoord (ad_MSG_BROADCAST, ad_lightn_start_y);
		WriteCoord (ad_MSG_BROADCAST, ad_lightn_start_z);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);
		// Check for things to damage in between the two points
		ad_LightningDamage (ad_lightn_start, trace_endpos, self, self.dmg);		
	}

	// Check for temporary continuous mode
	if (self.waitmin > 0 && time < self.ad_pausetime) {
		self.think = ad_trap_shooter_fire;
		self.nextthink = time + self.ad_waitmin2;
	}
	else {
		// Continuous mode?
		if (self.spawnflags & ad_TRAP_TOGGLE) {
			self.think = ad_trap_shooter_fire;
			self.nextthink = time + self.wait + random()*self.delay;
		}
		// Fire once and switch off
		else self.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_trap_shooter_use =
{
	// Check if disabled/off first
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	
	// Check for firing conditions (nightmare, coop)
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;

	// Toggle shooter on/off
	if (self.state == ad_STATE_OFF) {
		self.state = ad_STATE_ON;
		if (self.waitmin > 0) self.ad_pausetime = time + self.waitmin;
		if (!self.ad_waitmin2) self.ad_waitmin2 = 0.1;
	}
	else self.state = ad_STATE_OFF;
	
	ad_trap_shooter_fire();
};

//----------------------------------------------------------------------
// Vanilla ID QC Hack
void() ad_spikeshooter_use = {};

//----------------------------------------------------------------------
void() ad_trap_shooter_reset =
{
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_OFF;
};

//----------------------------------------------------------------------
void() ad_trap_spikeshooter =
{
	if (self.spawnflags & ad_TRAP_SNGSPIKE) {
		self.mdl = ad_MODEL_PROJ_SNG;
		self.noise = "weapons/spike2.wav";
		self.ad_classproj = ad_CT_PROJ_SNG;
		if (!self.speed) self.speed = ad_SPEED_TRAPSPIKE;
	}
	else if (self.spawnflags & ad_TRAP_LASER) {
		self.mdl = ad_MODEL_PROJ_LASER;
		self.noise = ad_SOUND_LASER_FIRE;
		self.ad_classproj = ad_CT_PROJ_LASER;
		if (!self.speed) self.speed = ad_SPEED_LASER;
		// Used for impact sound of laser
		precache_sound (ad_SOUND_LASER_HIT);
	}
	else if (self.spawnflags & ad_TRAP_WIZSPIKE) {
		self.mdl = ad_MODEL_PROJ_WIZ;
		self.noise = "weapons/spike2.wav";
		self.volume = 0.5;
		self.ad_classproj = ad_CT_PROJ_WIZ;
		if (!self.speed) self.speed = ad_SPEED_WIZSPIKE;
	}
	else if (self.spawnflags & ad_TRAP_HELLSPIKE) {
		self.mdl = ad_MODEL_PROJ_HKN;
		self.noise = "weapons/spike2.wav";
		self.volume = 0.5;
		self.ad_classproj = ad_CT_PROJ_HKN;
		if (!self.speed) self.speed = ad_SPEED_HKSPIKE;
	}
	else {
		self.mdl = ad_MODEL_PROJ_NG;
		self.noise = "weapons/spike2.wav";
		self.ad_classproj = ad_CT_PROJ_NG;
		if (!self.speed) self.speed = ad_SPEED_TRAPSPIKE;
	}
	precache_model (self.mdl);
	precache_sound (self.noise);

	self.ad_classtype = ad_CT_SPIKESHOOTER;
	if (self.wait <= 0) self.wait = 1;
	if (self.delay < 0) self.delay = 0;
	if (!self.volume) self.volume = 1;
	self.mangle = self.angles;
	ad_SetMovedir ();

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trap_shooter_use;
	self.ad_estate_reset = ad_trap_shooter_reset;
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_OFF;

	// If target is setup, calculate new facing angle
	if (self.target != "") {
		self.ad_angletarget = self.target;
		self.nextthink = time + 1 + random();
		self.think = ad_TargetMovedirReturn;
	}
};

//======================================================================
/*ad:QUAKED trap_grenadeshooter (0 0.5 0.8) (-8 -8 -8) (8 8 8) LARGE x x x x TOGGLE x TRACK Not_Easy Not_Normal Not_Hard Not_DM
When triggered, fires a GRENADE in the direction determined by angle
-------- KEYS --------
targetname : toggle state (use trigger ent for exact state)
target : targeting entity used for custom direction
angle  : direction for projectile to follow, use "360" for angle 0
wait   : time between projectiles (def=0s)
delay  : random time between projectile (def=0s)
speed  : Change projectile speed (def=500, large=600)
-------- SPAWNFLAGS --------
LARGE  : shoots high damage grenade (Player damage, def=ogre)
TOGGLE : Trigger will toggle the shooter on/off instead
TRACK  : Will update target entity origin before firing
-------- NOTES --------
When triggered, fires a GRENADE in the direction determined by angle
Use TOGGLE spawnflag and trigger to enable continuous mode

======================================================================*/
void() ad_trap_grenadeshooter =
{
	self.mdl = ad_MODEL_PROJ_GRENADE;
	precache_model (self.mdl);
	self.noise = "weapons/grenade.wav";
	precache_sound (self.noise);

	if (self.spawnflags & ad_TRAP_LARGEGRENADE) {
		self.ad_classproj = ad_CT_PROJ_GL;
		if(!self.speed) self.speed = ad_SPEED_PLAYGRENADE;
	}
	else {
		self.ad_classproj = ad_CT_PROJ_GLMON;
		if(!self.speed) self.speed = ad_SPEED_PLAYGRENADE;
	}

	self.ad_classtype = ad_CT_GRENADESHOOTER;
	if (self.wait <= 0) self.wait = 1;
	if (self.delay < 0) self.delay = 0;
	if (!self.volume) self.volume = 1;
	self.mangle = self.angles;
	ad_SetMovedir ();

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trap_shooter_use;
	self.ad_estate_reset = ad_trap_shooter_reset;
	self.ad_estate = ad_ESTATE_ON;
	self.state = ad_STATE_OFF;

	// If target is setup, calculate new facing angle
	if (self.target != "") {
		self.ad_angletarget = self.target;
		self.nextthink = time + 1 + random();
		self.think = ad_TargetMovedirReturn;
	}
};

