//----------------------------------------------------------------------
// Main idle loop (10 frames so idle sounds are less frequent)
void()	ad_turretb_idle1 =[ $wakeup1, ad_turretb_idle2 ] { 
	self.state = ad_TURRETB_OPENED; 
	// Stop velocity drift
	ad_turretb_resetorigin();
	ad_monster_idle_sound(); 
	ad_ai_stand();
};
void()	ad_turretb_idle2 =[ $wakeup1, ad_turretb_idle3 ] { ad_ai_stand(); };
void()	ad_turretb_idle3 =[ $wakeup1, ad_turretb_idle4 ] { ad_ai_stand(); };
void()	ad_turretb_idle4 =[ $wakeup1, ad_turretb_idle5 ] { ad_ai_stand(); };
void()	ad_turretb_idle5 =[ $wakeup1, ad_turretb_idle6 ] { ad_ai_stand(); };
void()	ad_turretb_idle6 =[ $wakeup1, ad_turretb_idle7 ] { ad_ai_stand(); };
void()	ad_turretb_idle7 =[ $wakeup1, ad_turretb_idle8 ] { ad_ai_stand(); };
void()	ad_turretb_idle8 =[ $wakeup1, ad_turretb_idle9 ] { ad_ai_stand(); };
void()	ad_turretb_idle9 =[ $wakeup1, ad_turretb_idle10 ] { ad_ai_stand(); };
void()	ad_turretb_idle10 =[ $wakeup1, ad_turretb_idle1 ] {
	self.ad_idlebusy = ad_FALSE; 
	// make sure no idle animations if about to go into combat
	if (random() < ad_MON_IDLE_ANIMATION && !self.enemy) {
		// Slight random movement of turret barrels
		ad_turretb_rotate(25);
		self.ad_idlebusy = ad_TRUE; 
		// Make sure the idle animations don't repeat in a row
		self.lefty = self.lip;
		while (self.lefty == self.lip) { self.lefty = rint(random()*4);}
		self.lip = self.lefty;
		if (self.lip < 1) self.think = ad_turretb_idleA1;		// Push barrels out/in
		else if (self.lip < 2) self.think = ad_turretb_idleB1;	// Slight rotate
		else if (self.lip < 3) self.think = ad_turretb_idleC1;	// Slight Twist
		else self.think = ad_turretb_idleD1;					// Full rotate
	}
};

//======================================================================
// OPENING : Coming out of wall/ceil/floor
//======================================================================
void() ad_turretb_opening1 = [ $move1, ad_turretb_opening2 ] {
	self.state = ad_TURRETB_OPENING;
	// Gun moving out and twirling barrels
	sound (self, ad_CHAN_VOICE, "turretb/barrel_idle2.wav", 1, ad_ATTN_NORM);
	// Fire any entity trigger(s), can use delay ents if needed
	if (self.ad_turretopening != "") ad_trigger_strs(self.ad_turretopening, self.enemy);
};
void() ad_turretb_opening2 = [ $move2, ad_turretb_opening3 ] {};
void() ad_turretb_opening3 = [ $move3, ad_turretb_opening4 ] {};
void() ad_turretb_opening4 = [ $move4, ad_turretb_opening5 ] {};
void() ad_turretb_opening5 = [ $move5, ad_turretb_opening6 ] {};
void() ad_turretb_opening6 = [ $move6, ad_turretb_opening7 ] {};
void() ad_turretb_opening7 = [ $move7, ad_turretb_opening8 ] {};
void() ad_turretb_opening8 = [ $move9, ad_turretb_wakeup ] {
	self.state = ad_TURRETB_OPENED; 
	// Restore damage ability
	self.takedamage = ad_DAMAGE_AIM; 
	// Restore bounding box and size (were missing)
	self.solid = ad_SOLID_SLIDEBOX;
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	// If no enemy? Back to idling
	if (!self.enemy) self.think = ad_turretb_idle1;
};

//----------------------------------------------------------------------
// WAKEUP : Going into combat (+slowly rotating towards enemy)
//----------------------------------------------------------------------
void() ad_turretb_wakeup =[ $wakeup4, ad_turretb_wakeup2 ] {
	// Reset timer for closing down turret
	self.ad_attack_timer = time + self.waitmin;
	self.state = ad_TURRETB_BARREL;
	// Slowly move the barrels toward the enemy
	self.angles = ad_turretb_ai_face(ad_TRUE);
	// Gun barrels moving towards enemy
	sound (self, ad_CHAN_VOICE, "turretb/barrel_idle1.wav", 1, ad_ATTN_NORM);
};
void() ad_turretb_wakeup2 =[ $wakeup6, ad_turretb_wakeup3 ] {self.angles = ad_turretb_ai_face(ad_TRUE);};
void() ad_turretb_wakeup3 =[ $wakeup8, ad_turretb_wakeup4 ] {self.angles = ad_turretb_ai_face(ad_TRUE);};
void() ad_turretb_wakeup4 =[ $wakeup10, ad_turretb_combat ] {self.angles = ad_turretb_ai_face(ad_FALSE);};

//----------------------------------------------------------------------
// CLOSED : Buried in wall/ceil/floor and cannot take any damage
//----------------------------------------------------------------------
void() ad_turretb_closed = [ $move1, ad_turretb_closed ] { 
	self.state = ad_TURRETB_CLOSED; 
	// Don't want turret damaged when hidden in wall/ceil/floor
	self.takedamage = ad_DAMAGE_NO;
	self.solid = ad_SOLID_NOT;
	// Stop velocity drift
	ad_turretb_resetorigin();
	// Only start checking for enemies once timer ready
	if (self.ad_attack_timer < time) {
		// Return passive turrets back to combat
		if (self.ad_passive_mode) self.ad_passive_mode = ad_FALSE;
		if (self.ad_passive_state) self.ad_passive_state = ad_FALSE;

		// Look for any enemies
		if (ad_FindTarget ()) {
			// Can return world as enemy, block it!
			if (!self.enemy) return;
			
			// Create angle that would be needed to hit enemy
			self.ad_finaldest = ad_turretb_ai_face(ad_FALSE);
			self.ad_finaldest_x = -self.ad_finaldest_x;

			// Check if the turret can hit the new enemy?
			if ( ad_visang(self.enemy, '0 0 0', self.ad_finaldest, ad_FALSE) ) {

				// Check if enemy distance is right?
				self.lip = ad_range_distance(self.enemy, ad_FALSE);
				if (self.lip >= self.distance) {
					// Reset targets and go back to loop
					self.enemy = self.goalentity = self.ad_movetarget = world;
					self.think = ad_turretb_closed;
				}
				// Start opening sequence
				else self.think = ad_turretb_opening1;
			}
			else {
				// Reset targets and go back to loop
				self.enemy = self.goalentity = self.ad_movetarget = world;
				self.think = ad_turretb_closed;
			}
		}
	}
};

//----------------------------------------------------------------------
// RETURN : Preparing barrels to hide (+slowly rotate towards center)
//----------------------------------------------------------------------
void() ad_turretb_return =[ $wakeup8, ad_turretb_return2 ] {
	self.state = ad_TURRETB_BARREL;
	ad_turretb_ai_return();
	// Gun barrels moving towards spawn location
	sound (self, ad_CHAN_VOICE, "turretb/barrel_idle1.wav", 1, ad_ATTN_NORM);
};
void() ad_turretb_return2 =[ $wakeup6, ad_turretb_return3 ] {ad_turretb_ai_return();};
void() ad_turretb_return3 =[ $wakeup4, ad_turretb_return4 ] {ad_turretb_ai_return();};
void() ad_turretb_return4 =[ $wakeup2, ad_turretb_closing1 ] {
	// Force spawn/start angle for hide animation
	self.angles = self.finalangle;
	self.fixangle = ad_TRUE;
};

//----------------------------------------------------------------------
// CLOSING : Going back INTO the wall/ceil/floor (hidden state)
//----------------------------------------------------------------------
void() ad_turretb_closing1 = [ $move8, ad_turretb_closing2 ] {
	self.state = ad_TURRETB_CLOSING;
	// No more damage or collision
	self.takedamage = ad_DAMAGE_NO;
	self.solid = ad_SOLID_NOT;
	// Gun moving in and twirling barrels
	sound (self, ad_CHAN_VOICE, "turretb/barrel_idle2.wav", 1, ad_ATTN_NORM);
};
void() ad_turretb_closing2 = [ $move7, ad_turretb_closing3 ] {};
void() ad_turretb_closing3 = [ $move6, ad_turretb_closing4 ] {};
void() ad_turretb_closing4 = [ $move5, ad_turretb_closing5 ] {};
void() ad_turretb_closing5 = [ $move4, ad_turretb_closing6 ] {};
void() ad_turretb_closing6 = [ $move3, ad_turretb_closing7 ] {
	if (self.ad_turretclosing != "") ad_trigger_strs(self.ad_turretclosing, self.ad_oldenemy);
	self.ad_oldenemy = world;
};
void() ad_turretb_closing7 = [ $move2, ad_turretb_closing8 ] {};
void() ad_turretb_closing8 = [ $move1, ad_turretb_closed ] {
	// Setup timer to wait in closed position
	self.ad_attack_timer = time + self.ad_waitmin2 + (random() * self.ad_waitmin2);
};

//======================================================================
// Entry point for stand/walk function
//======================================================================
void() ad_turretb_stand = {
	// This is the entry point for spawning and re-use of turrets
	// For spawn delay it needs to be active straight away
	// For spawning at the beginning of the map, needs a slight delay
	// For re-entry of this function, it needs to be instant (=0)
	if (self.ad_attack_timer < 0) self.ad_attack_timer = time + self.ad_waitmin3;
	else self.ad_attack_timer = 0;
	// Stop velocity drift
	ad_turretb_resetorigin();
	// Check the state of the turret (closed/open/combat)
	if (self.state == ad_TURRETB_CLOSED) ad_turretb_closed();
	else if (self.state == ad_TURRETB_OPENED) ad_turretb_idle1();
};

//----------------------------------------------------------------------
// Main combat loop for tracking / attacking player
void() ad_turretb_combat =[ $run1, ad_turretb_combat ] {
	// barrels extended and ready for attack
	self.state = ad_TURRETB_COMBAT;
	// Stop velocity drift
	ad_turretb_resetorigin();
	
	// Check if turret is giving up on enemy
	if (self.ad_attack_timer < time && !self.ad_turretlocked) {
		// Save later for triggers
		self.ad_oldenemy = self.enemy;
		// Reset enemy and target system
		self.enemy = self.goalentity = self.ad_movetarget = world;
		// Return to wall/ceil/floor animation
		ad_turretb_return();
	}
	else {
		// Turn barrels to face enemy (axis restriction + full turn speed)
		self.angles = ad_turretb_ai_face(ad_FALSE);
		// typical run function (check for attacks)
		ad_ai_run(0);
	}
};

//----------------------------------------------------------------------
// Entry point for run function
void() ad_turretb_run = {
	// Reset timer for closing down turret
	self.ad_attack_timer = time + self.waitmin;
	// Create backup copy for later
	self.ad_move_state = self.enemy.origin;
	// Stop velocity drift
	ad_turretb_resetorigin();
	// Check the state of the turret (closed/open/combat)
	if (self.state == ad_TURRETB_CLOSED) ad_turretb_opening1();
	else if (self.state == ad_TURRETB_OPENED) ad_turretb_wakeup();
	else if (self.state == ad_TURRETB_COMBAT) ad_turretb_combat();
};
	
//======================================================================
// Range (LASERS or PLASMA)
//======================================================================
void(vector ad_att_offset) ad_turretb_laser =
{
	local vector ad_org, ad_vec;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;

	// Work out attack offset from end of barrel
	ad_turretb_attvector(self.angles, ad_att_offset);
	ad_org = self.origin + self.ad_attack_track;
	// Typically a projectile will fire directly at the enemy
	// This monster/turret has an axis lock and cannot fire any angle
	// The firing vector is taken from the monsters angles field instead
	// This means the projectile will not bend towards the enemy and
	// fire directly from the barrel using axis restrictions
	// This looks better and does not feel like the AI is cheating
	ad_vec = v_forward;

	// Variable speed projectiles
	self.ad_attack_speed = ad_SPEED_TURRETBPROJ + (ad_skill * ad_SPEED_TURRETBPROJSKILL);
	// Laser or plasma? (different damage, same speed)
	if (self.spawnflags & ad_MON_TURRETB_PLASMA) {
		sound (self, ad_CHAN_WEAPON, ad_SOUND_PLASMA_FIRE, 1, ad_ATTN_NORM);
		ad_launch_plasma(ad_org, ad_vec, ad_CT_MONTURRETB, self.ad_attack_speed);
	}
	else {
		sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);
		ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_LASER, self.ad_attack_speed);
	}
};

//----------------------------------------------------------------------
void() ad_turretb_fireframe =
{
	// If dead, no more updates
	if (self.health < 1) return;
	
	// Start animation at 10fps, spin up to 20fps (x 2 speed)
	self.nextthink = time + 0.05 + (0.01*(self.ad_attack_rage-self.ad_attack_chance));
	self.think = ad_turretb_fireframe;

	// Turn towards enemy or use last known position
	// Check angle against axis lock at all times
	self.angles = ad_turretb_ai_face(ad_FALSE);
	
	// Animation trigger events
	if (self.spawnflags & ad_MON_TURRETB_TRIPLE) {
		self.frame = $blast1 + self.ad_walkframe;
		if (self.ad_walkframe == 1) ad_turretb_laser('66 0 5');
		if (self.ad_walkframe == 1) ad_turretb_laser('66 6 -4');
		if (self.ad_walkframe == 1) ad_turretb_laser('66 -6 -4');
		// Play attack barrel rotate sound
		if (self.ad_walkframe == 2) 
			sound (self, ad_CHAN_BODY, "turretb/attack1.wav", 1, ad_ATTN_NORM);
	}
	else {
		self.frame = $fire1 + self.ad_walkframe;		
		if (self.ad_walkframe == 1) ad_turretb_laser('66 0 5');
		else if (self.ad_walkframe == 10) ad_turretb_laser('66 0 5');
		else if (self.ad_walkframe == 18) ad_turretb_laser('66 0 5');
		// Play attack barrel rotate sound
		if (self.ad_walkframe == 2) 
			sound (self, ad_CHAN_BODY, "turretb/attack1.wav", 1, ad_ATTN_NORM);
		if (self.ad_walkframe == 11) 
			sound (self, ad_CHAN_BODY, "turretb/attack1.wav", 1, ad_ATTN_NORM);
		if (self.ad_walkframe == 19) 
			sound (self, ad_CHAN_BODY, "turretb/attack1.wav", 1, ad_ATTN_NORM);
	}
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	
	// End of animation loop?
	if (self.ad_walkframe > self.ad_attack_frame) {
		// Reset animation to fire on first frame
		self.ad_walkframe = 1;

		// Check if enemy distance is too far away?
		self.lip = ad_range_distance(self.enemy, ad_FALSE);
		if (self.lip >= self.distance) {
			self.think = ad_turretb_combat;
			self.ad_attack_timer = 0;
		}
		else {
			// Setup current angles for traceline function
			self.ad_finaldest = self.angles;
			self.ad_finaldest_x = -self.ad_finaldest_x;
			
			// Can the turret HIT the enemy? (new traceline function)
			if ( !ad_visang(self.enemy, '0 0 0', self.ad_finaldest, ad_FALSE) ) {
				sound (self, ad_CHAN_BODY, "turretb/spin_down.wav", 1, ad_ATTN_NORM);
				// Enemy out axis range, stop firing and exit
				self.think = ad_turretb_combat;
				// Can the turret SEE the enemy?
				if ( ad_visxray(self.enemy, '0 0 0',  '0 0 0', ad_FALSE) ) {
					// Enemy is waiting outside lock range, hide immediately
					self.ad_attack_timer = 0;
				}
				else {
					// Enemy hidden, pause a bit to catch strafer's
					self.ad_attack_timer = time + 1 + random();
				}
			}
			// Can HIT the enemy !!!!
			else {
				// Save origin for later
				self.ad_move_state = self.enemy.origin;
			
				// Increase fire rate
				if (self.ad_attack_chance < self.ad_attack_rage) 
					self.ad_attack_chance = self.ad_attack_chance + self.ad_attack_count;
			}
		}
	}
};

//----------------------------------------------------------------------
void() ad_turretb_fire = { 
	self.ad_walkframe = 0; self.ad_attack_chance = 0; ad_turretb_fireframe();
};

//======================================================================
vector() ad_turretb_spawnvec =
{
	// Work out v_* directions
	makevectors(self.finalangle);
	// reverse direction if up/down config active
	if(self.volume) return v_forward;
	else return -v_forward;
}

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_turretb_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Work out spawn angle/v_forward direction
	self.dest1 = ad_turretb_spawnvec();
	// Spawn dust/model particles
	ad_SpawnVelocitySmoke(self.origin, self.dest1+(ad_crandom()*v_up), 200, 200);
	ad_SpawnVelocitySmoke(self.origin, self.dest1+(ad_crandom()*v_up), 200, 200);
	ad_SpawnVelocitySmoke(self.origin, self.dest1+(ad_crandom()*v_up), 200, 200);
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		self.ad_pain_finished = time + 1;
	}
};

//======================================================================
void() ad_turretb_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Work out spawn angle/v_forward direction
	self.dest1 = ad_turretb_spawnvec();
	// Spawn dust/model particles
	ad_SpawnVelocitySmoke(self.origin, self.dest1+(ad_crandom()*v_up), 200, 200);
	ad_SpawnVelocitySmoke(self.origin, self.dest1+(ad_crandom()*v_up), 200, 200);
	ad_SpawnVelocitySmoke(self.origin, self.dest1+(ad_crandom()*v_up), 200, 200);
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	// Sprite explosion
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound);

	// no more turret
	ad_entity_hide (self);
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// Metal and custom body parts
	self.ad_gibtype = ad_GIBTYPE_METAL;
	ad_ThrowGib(11, 1);						// Base of gun barrel
	ad_ThrowGib(12, 1 + rint(random()*2));		// End of barrel (max 3)
	ad_ThrowGib(13, 2 + rint(random()*2));		// Barrel section
	ad_ThrowGib(14, 1 + rint(random()*2));		// Main body chunks
	ad_ThrowGib(15, 2 + rint(random()*3));		// Generic metal
};

/*======================================================================
QUAKED monster_turretbal (1 0 0) (-20 -20 -20) (20 20 20) Ambush
======================================================================*/
void() ad_monster_turretbal =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_turretbal.mdl";		// Turret
//	self.headmdl = "progs/h_turretbal.mdl";		// Not used
	self.ad_gib1mdl = "progs/gib_turretbal1.mdl";	// base of gun barrel
	self.ad_gib2mdl = "progs/gib_turretbal2.mdl";	// end of metal barrel
	self.ad_gib3mdl = "progs/gib_turretbal3.mdl";	// barrel section
	self.ad_gib4mdl = "progs/gib_turretbal4.mdl";	// main body section
	self.ad_gib5mdl = "progs/gib_metal1.mdl";		// generic metal chunk

	precache_model (self.mdl);			// Turret
//	precache_model (self.headmdl);		// Not used
	precache_model (self.ad_gib1mdl);		// frame of gun barrel
	precache_model (self.ad_gib2mdl);		// end of metal barrel
	precache_model (self.ad_gib3mdl);		// barrel section
	precache_model (self.ad_gib4mdl);		// main body section
	precache_model (self.ad_gib5mdl);		// generic metal chunk
	
	// Robot talktalk
	self.ad_idle_sound = "turretb/idle1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_idle_sound2 = "turretb/idle2.wav";
	precache_sound (self.ad_idle_sound2);

	// Idle barrel movements
	precache_sound ("turretb/barrel_idle1.wav");
	precache_sound ("turretb/barrel_idle2.wav");

	// Attack with spinning barrel
	precache_sound ("turretb/attack1.wav");
	precache_sound ("turretb/spin_down.wav");
	
	// Default attack - lasers!
	precache_model (ad_MODEL_PROJ_LASER);			// Copy of enforcer laser
	precache_sound (ad_SOUND_LASER_FIRE);
	precache_sound (ad_SOUND_LASER_HIT);

	// Extra attack - plasma!
	precache_model (ad_MODEL_PROJ_LASERBLUE);		// Blue version of laser
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);
	
	self.ad_pain_sound = "turretb/pain1.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "turretb/explode_major.wav";
	precache_sound (self.ad_death_sound);
	
	self.ad_sight_sound = "turretb/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SQUARE;
	if (self.health < 1) self.health = 180;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Special explosion death
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 1;				// Always flinch
	self.ad_pain_timeout = 1;				// Low pain threshold
	self.ad_steptype = ad_FS_FLYING;			// Silent feet
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	self.ad_deathstring = " was blasted to hell by a Turret\n";
	self.ad_attack_offset = '66 0 0';		// Middle of three barrels
	self.ad_sight_nofront = ad_TRUE;			// Has no front facing
	self.ad_weaponstate = ad_FALSE;			// Open/close barrel state
	self.ad_movespeed = -1;				// Never move model
	if (self.ad_attack_count < 0) self.ad_attack_count = 0;
	else self.ad_attack_count = 1;			// Fire rate Increment
	self.ad_attack_rage = 5;				// Fire rate Maximum
	// Different animation sets for single/blast attacks
	if (self.spawnflags & ad_MON_TURRETB_TRIPLE) self.ad_attack_frame = 10;
	else self.ad_attack_frame = 24;

	// Check state is within range (state types)
	if (self.state < ad_TURRETB_CLOSED) self.state = ad_TURRETB_CLOSED;
	if (self.state > ad_TURRETB_COMBAT) self.state = ad_TURRETB_COMBAT;
	// QC hack to make sure spawn delay starts with correct frame
	if (self.state == ad_TURRETB_CLOSED) self.frame = $move1;

	// Sight check parameters
	if (self.waitmin <= 0) self.waitmin = 2;	// Give up timer
	if (self.ad_waitmin2 <= 0) self.ad_waitmin2 = 2;	// Stay hidden timer
	if (self.ad_waitmin3 <= 0) self.ad_waitmin3 = 2;	// Delay start turrets
	if (self.distance <= 0) self.distance = 600;// Attack distance
	if (!(self.spawnflags & ad_MON_SPAWN_DELAY)) self.ad_attack_timer = -1;
	else self.ad_attack_timer = 0;
	
	//----------------------------------------------------------------------
	// The turret can only be setup in two positions, wall or floor/ceiling.
	// The floor/ceiling are treated the same because its just reversed.
	// The wall version uses the 'angle' key to determine its center point
	// and the floor/ceiling uses the weird -1/-2 'angle' setting instead.
	// If the up/down version is detected then the 'angles' key is reset.
	// 
	if (self.angles == '0 -1 0') self.angles = '90 0 0';		// UP
	else if (self.angles == '0 -2 0') self.angles = '270 0 0';	// Down
	else self.angles_x = 0;		// Yaw movement only (wall setup)

	// Due to the way the model is setup for up/down and yaw axis rotation
	// the up/down setups only need to check one axis (X) range and the
	// wall setup requires multiple (XY) ranges instead
	if (self.angles_x > 0) self.volume = ad_FALSE;
	else self.volume = ad_TRUE;
	
	// Make sure angle values (xyz) are in the range of 0-360 otherwise
	// comparisions for XY range will not work if values are negative
	self.angles = ad_vectormod(self.angles);
	// Create the v_ vectors
	makevectors (self.angles);
	self.movedir = v_forward;
	// Save spawning angle for idle movement adjustment
	self.finalangle = self.angles;
	
	// Need to sortout view ofs because the default is expecting
	// the monster to stand/walk/run and not be angled on surfaces
	if (self.volume) self.view_ofs = v_forward*8;
	else self.view_ofs = (-v_forward)*8;

	// Make sure axis lock ranges are 15-90 degree's
	if (self.t_length <= 15) self.t_length = 75;
	if (self.t_length > 90) self.t_length = 90;
	if (self.t_width <= 15) self.t_width = 75;
	if (self.t_width > 90) self.t_width = 90;
	// Setup angle lock boundary adjustment when turret is closed
	if (self.ad_wakeup_angle <= 0) {
		// Ceiling/floor turrets should have less angle
		// They are difficult to get right with default
		if (!self.volume) self.ad_wakeup_angle = ad_TURRETB_WAKEUPDOWN;
		else self.ad_wakeup_angle = ad_TURRETB_WAKEWALL;
	}
	// Check wakeup angle is less that total rotation angle
	if (self.ad_wakeup_angle > (self.t_length - self.ad_wakeup_angle)) 
		self.ad_wakeup_angle = self.t_length - self.ad_wakeup_angle;
	
	// The problem with QC angle maths is when 0 should wrap around to 360
	// This becomes apparent when looking for certain angle ranges (> && <)
	// because you can end up with a range spanning across the 0/360 boundary.
	// The best solution is to move the 0/360 boundary to an angle location
	// where the crossover has no affect on the target range.
	// 
	// The axis lock feature is centered around the spawning angle, which will
	// always be accessible to the turret and never blocked. This angle is the
	// perfect location for the 0/360 boundary because its never tested.
	//
	// The lock range is setup using the new 0/360 location and the ai_run
	// test function converts 'angles' key to that range first before testing.
	// Once the test has finished, then 'angles' key is converted back using
	// the spawn angle as a way to switch between formats.
	//
	// Setup axis lock cone (+/-) around 0/360 boundary
	// The setup cone cannot be more than 90 degree's, the default is 75
	self.ad_anglockx_x = 0 - self.t_length;
	self.ad_anglockx_y = 0 + self.t_length;
	// Z is the original spawn angle (used to move between formats)
	self.ad_anglockx_z = self.angles_x;
	// make sure all parameters are within range 0-360
	self.ad_anglockx = ad_vectormod(self.ad_anglockx);
	
	// Setup axis lock cone (+/-) around 0/360 boundary
	// This is really a duplicate of the X axis, but it can be different
	// for turrets which are setup on walls as they use two axis instead.
	self.ad_anglocky_x = 0 - self.t_width;
	self.ad_anglocky_y = 0 + self.t_width;
	// Z is the original spawn angle (used to move between formats)
	self.ad_anglocky_z = self.angles_y;
	// make sure all parameters are within range 0-360
	self.ad_anglocky = ad_vectormod(self.ad_anglocky);
	
	// Debug makevector arrow directions
	// v_forward reversed for up/down model angles
/*	
	if (self.volume) spawn_arrow(self.origin, vectoangles(v_forward), 0);
		spawn_arrow(self.origin, vectoangles(-v_forward), 0);
	spawn_arrow(self.origin, vectoangles(v_up), 3);
	spawn_arrow(self.origin, vectoangles(v_right), 4);
*/

	//----------------------------------------------------------------------
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_cells = 0;
	self.ad_resist_rockets = -1;	// Double damage from grenades/rockets
	
	self.ad_th_checkattack = ad_TurretbCheckAttack;
	self.ad_th_stand = ad_turretb_stand;
	self.ad_th_walk = ad_turretb_stand;
	self.ad_th_run = ad_turretb_run;
	self.ad_th_missile = ad_turretb_fire;
	self.ad_th_pain = ad_turretb_pain;
	self.ad_th_die = ad_turretb_die;

	self.ad_classtype = ad_CT_MONTURRETB;
	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVESTATIC;
	
	ad_monster_start();
};
