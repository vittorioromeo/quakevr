// AD's readme and docs/vr-port/CREDITS.md), my_progs/client_debuff.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
  CheckDeBuff - Check for negative buffs affecting the player
======================================================================*/

.float		ad_debuff_sound;		// Heartbeat sound when tick happens
.float		ad_debuff_qty;			// Quantity to do something with (temp)

.float		ad_bleeding;			// Bleeding debuff status
.float		ad_bleeding_time;		// Timer (1s tick) for screen/sound update
.float		ad_bleeding_qty;		// Total amount of health stored (HoT)

.float		ad_rotting;			// Rotting debuff status (DoT)
.float		ad_rotting_time;		// Timer (1s tick) for health update
// Has to be defined early in defscustom.qc because of the randomizer.qc
//.float		rotting_qty;		// Total ammount to rot down (DoT)

.float		ad_burning;			// Burning debuff status
.float		ad_burning_time;		// Timer (1s tick) for screen/sound update
.float		ad_burning_qty;		// Total amount of damage stored (DoT)

.float		ad_poisoned;			// Poison debuff status
.float		ad_poisoned_time;		// Timer (1s tick) for screen/sound update
.float		ad_poisoned_qty;		// Total amount of damage stored (DoT)

// IT_INVISIBILITY + IT_INVULNERABILITY + IT_SUIT + IT_QUAD
// 524288 + 1048576 + 2097152 + 4194304
float ad_ALL_ITARTIFACTS = 7864320;

// Wraith Health drain
vector ad_DEBUFF_BLEED_COL = '50 35 0';		// Dark Orange
float ad_DEBUFF_BLEED_DEN = 80;
float ad_DEBUFF_BLEED_STEP = 10;

vector ad_DEBUFF_START_BLEED_COL = '200 0 0';	// Strong red
float ad_DEBUFF_START_BLEED_DEN = 160;
float ad_DEBUFF_START_BLEED_STEP = 7;

float ad_DEBUFF_BLEED_MIN = 5;				// Minimum health to apply debuff
float ad_DEBUFF_BLEED_DMG = 10;			// Immunity with pent/envsuit

// Pyro flame burn
vector ad_DEBUFF_BURN_COL = '200 100 0';	// Orange
float ad_DEBUFF_BURN_DEN = 120;
float ad_DEBUFF_BURN_STEP = 10;
float ad_DEBUFF_BURN_DMG = 1;				// Damage Over Time
float ad_DEBUFF_BURN_MAX = 10;				// Max amount of burning multiplier

// Mummy poisoned gibs
vector ad_DEBUFF_POISON_COL = '0 200 0';	// Strong Green
float ad_DEBUFF_POISON_DEN = 80;
float ad_DEBUFF_POISON_STEP = 7;
float ad_DEBUFF_POISON_DMG = 1;			// Damage Over Time

//----------------------------------------------------------------------
// Various debuff reset functions, used all over the place
//----------------------------------------------------------------------
void(entity ad_targ) ad_ResetDebuffScreen =
{
	ad_targ.ad_cshift_upd = ad_FALSE;
	ad_targ.ad_cshift_time = ad_LARGE_TIMER;
	stuffcmd(ad_targ, "v_cshift 0 0 0 0\n");
	ad_targ.ad_cshift_col = '0 0 0';
	ad_targ.ad_cshift_den = 0;
};

void(entity ad_targ) ad_ResetDebuffBurning =
{ ad_targ.ad_burning = ad_targ.ad_burning_qty = 0; };

void(entity ad_targ) ad_ResetDebuffRotting = {
	ad_targ.ad_rotting = 0; 
	// Force reset health and remove MH inventory item
	if (ad_targ.health > ad_targ.max_health) ad_targ.health = ad_targ.max_health;
	ad_targ.items = ad_targ.items - (ad_targ.items & ad_IT_SUPERHEALTH);
};

void(entity ad_targ) ad_ResetDebuffPoisoned =
{ ad_targ.ad_poisoned = ad_targ.ad_poisoned_qty = 0; };

void(entity ad_targ) ad_ResetDebuffBleeding =
{ ad_targ.ad_bleeding = ad_targ.ad_bleeding_qty = 0; };

//----------------------------------------------------------------------
void(entity ad_targ) ad_ResetDebuffSystem =
{
	// This only works for player clients
	if (!(ad_targ.flags & ad_FL_CLIENT)) return;
	
	ad_ResetDebuffScreen(ad_targ);
	ad_ResetDebuffBurning(ad_targ);
	ad_ResetDebuffPoisoned(ad_targ);
	ad_ResetDebuffBleeding(ad_targ);
};

//----------------------------------------------------------------------
// Core debuff function, run every frame from client.qc
//----------------------------------------------------------------------
void() ad_ClientDeBuff =
{
	// Check is self is a NOT player (client) FIRST!
	// Bug fix from ericw on func msgboard
	// #655 posted by ericw on 2018/04/10 09:53:36
	if (!(self.flags & ad_FL_CLIENT)) return;
	
	// If player is dead or intermission running, turn everything off
	// Cinematic camera system exception is later on in code
	if (ad_intermission_running > 0 || self.health < 1) {
		ad_ResetDebuffSystem(self);
		return;
	}

	// Check for burning debuff (DoT)
	if (self.ad_burning) {
		// Is it time for a debuff update
		if (self.ad_burning_time < time) {
			if (self.ad_burning_qty > 0) {
				// Reset burning tick timer
				self.ad_burning_time = time + 1;
				
				// Give priority to bleeding(heal) and poisoned
				if (!(self.ad_bleeding && !self.ad_poisoned)) {
					if (self.ad_debuff_sound < time) self.ad_debuff_sound = time + 1;
					self.ad_cshift_upd = ad_TRUE;		// Update screen colour
					self.ad_cshift_time = -1;		// Update striaght away
					self.ad_cshift_col = ad_DEBUFF_BURN_COL;
					self.ad_cshift_den = ad_DEBUFF_BURN_DEN;
					self.ad_cshift_step = ad_DEBUFF_BURN_STEP;
				}
				
				// Setup default burning damage
				self.ad_debuff_qty = ad_DEBUFF_BURN_DMG;
				// Check burning does not exceed stored damage
				if (self.ad_burning_qty < self.ad_debuff_qty) self.ad_debuff_qty = self.ad_burning_qty;
				// Subtract burning damage from counters
				self.ad_burning_qty = self.ad_burning_qty - self.ad_debuff_qty;
				
				// Use global damage function (has death checks)
				ad_T_Damage (self, world, world, self.ad_debuff_qty, ad_NOARMOR);
			}
		}
		// Check if player is in water up to waist?
		// 0 = not in, 1 = feet, 2 = waist, 3 = eyes
		if (self.waterlevel >= 2 || self.ad_burning_qty < 1) {
			ad_ResetDebuffBurning(self);
		}
	}
	
	// Check for poisoned debuff (DoT)
	if (self.ad_poisoned) {
		// Is it time for a debuff update
		if (self.ad_poisoned_time < time) {
			if (self.ad_poisoned_qty > 0) {
				// Reset poisoned tick timer
				self.ad_poisoned_time = time + 1;

				// Give priority to bleeding(heal)
				if (!self.ad_bleeding) {
					if (self.ad_debuff_sound < time) self.ad_debuff_sound = time + 1;
					self.ad_cshift_upd = ad_TRUE;		// Update screen colour
					self.ad_cshift_time = -1;		// Update striaght away
					self.ad_cshift_col = ad_DEBUFF_POISON_COL;
					self.ad_cshift_den = ad_DEBUFF_POISON_DEN;
					self.ad_cshift_step = ad_DEBUFF_POISON_STEP;
				}
				
				// Setup default poison damage
				self.ad_debuff_qty = ad_DEBUFF_POISON_DMG;
				// Check poison does not exceed damage left
				if (self.ad_poisoned_qty < self.ad_debuff_qty) self.ad_debuff_qty = self.ad_poisoned_qty;
				// Subtract poison damage from counters
				self.ad_poisoned_qty = self.ad_poisoned_qty - self.ad_debuff_qty;
				
				// Use global damage function (has death checks)
				ad_T_Damage (self, world, world, self.ad_debuff_qty, ad_NOARMOR);
			}
		}
		// Check if poison has finished?
		if (self.ad_poisoned_qty < 1) ad_ResetDebuffPoisoned(self);
	}

	// Check for bleeding debuff (HoT)
	if (self.ad_bleeding) {
		// Is it time for a debuff update
		if (self.ad_bleeding_time < time) {
			if (self.ad_bleeding_qty > 0) {
				// Reset bleeding(healing) tick timer
				self.ad_bleeding_time = time + 1;
				if (self.ad_debuff_sound < time) self.ad_debuff_sound = time + 1;
				self.ad_cshift_upd = ad_TRUE;		// Update screen colour
				self.ad_cshift_time = -1;		// Update striaght away
				self.ad_cshift_col = ad_DEBUFF_BLEED_COL;
				self.ad_cshift_den = ad_DEBUFF_BLEED_DEN;
				self.ad_cshift_step = ad_DEBUFF_BLEED_STEP;

				// Setup default healing
				// Check healing does not exceed current reserve
				if (self.ad_bleeding_qty < ad_map_bleedingdmg_y) self.ad_debuff_qty = self.ad_bleeding_qty;
				else self.ad_debuff_qty = ad_map_bleedingdmg_y;
				// Subtract bleeding heals from counter
				self.ad_bleeding_qty = self.ad_bleeding_qty - self.ad_debuff_qty;
				
				// Directly add health back to player
				self.health = self.health + self.ad_debuff_qty;
				if (self.health > self.max_health) self.health = self.max_health;
			}
		}
		// Check if player is over max health or run out of healing
		if (self.health >= self.max_health || self.ad_bleeding_qty < 1) {
			ad_ResetDebuffBleeding(self);
		}
	}

	// Check for rotting debuff (DoT)
	if (self.ad_rotting) {
		// Is it time for a debuff update
		if (self.ad_rotting_time < time) {
			if (self.health > self.max_health) {
				// Reset rotting tick timer
				self.ad_rotting_time = time + 1;
				// Directly subject health from player
				self.health = self.health - self.ad_rotting_qty;
			}
		}
		// Reset (if over max) HP and remove inventory item
		if (self.health <= self.max_health) ad_ResetDebuffRotting(self);
	}
	
	// Don't need sound or visual updates for cinematic stuff
	if (ad_cinematic_running) return;
	
	// Check for any debuff screen updates?
	if (self.ad_cshift_upd) {
		// Play different debuff sounds (pressure is on!)
		if (self.ad_debuff_sound > time) {
			self.ad_debuff_sound = -1;		// Reset

			// Sound exception for god/pentagram mode
			if (self.flags & ad_FL_GODMODE || self.ad_invincible_finished >= time) {
				ad_PlayPentagramSound(self);
			}
			else {
				// Play heartbeat only for bleeding/healing
				if (self.ad_bleeding) 
					sound (self, ad_CHAN_VOICE, ad_SOUND_HEARTBEAT, 1, ad_ATTN_IDLE);
				// Re-use player pain sounds
				else if (self.ad_poisoned) {
					if (random() < 0.5) sound (self, ad_CHAN_VOICE, "player/pain2.wav", 1, ad_ATTN_IDLE);
					else sound (self, ad_CHAN_VOICE, "player/pain3.wav", 1, ad_ATTN_IDLE);
				}
				// Play on the same channel as player pain
				else if (self.ad_burning) {
					if (random() < 0.5) sound (self, ad_CHAN_VOICE, "player/pain1.wav", 1, ad_ATTN_IDLE);
					else sound (self, ad_CHAN_VOICE, "player/pain4.wav", 1, ad_ATTN_IDLE);
				}
			}
		}
		// Check for screen update? 0.1s tick interval
		if (self.ad_cshift_time < time) {
			// Generate some particles based on debuff
			// Priority is bleeding > poisoned > burning
			if (self.ad_bleeding) ad_particle_debuff(self.origin, 16, rint(1+random()*4), ad_PARTICLE_BURST_RED);
			else if (self.ad_poisoned) ad_particle_debuff(self.origin, 16, rint(1+random()*4), ad_PARTICLE_BURST_GREEN);
			else if (self.ad_burning) ad_particle_debuff(self.origin, 16, rint(1+random()*4), ad_PARTICLE_BURST_YELLOW);

			// Count down density and check for reset condition
			self.ad_cshift_den = self.ad_cshift_den - self.ad_cshift_step;
			if (self.ad_cshift_den < 1) ad_ResetDebuffScreen(self);
			else {
				// Update screen using stuffcmds!
				self.ad_cshift_time = time + 0.1;

				// Don't update the screen if an artifact is active
				// The engine will be updating at the same time
				if ((self.items & ad_ALL_ITARTIFACTS) == 0) {
					stuffcmd(self, "v_cshift ");
					stuffcmd(self, ftos(rint(self.ad_cshift_col_x)));
					stuffcmd(self, " ");
					stuffcmd(self, ftos(rint(self.ad_cshift_col_y)));
					stuffcmd(self, " ");
					stuffcmd(self, ftos(rint(self.ad_cshift_col_z)));
					stuffcmd(self, " ");
					stuffcmd(self, ftos(rint(self.ad_cshift_den)));
					stuffcmd(self, "\n");
				}
			}
		}
	}
	// Reset cshift if nothing is active (engine does not reset)
	// This is to catch new games or quickload resets
	else if (self.ad_cshift_time < time) ad_ResetDebuffScreen(self);
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_BleedDeBuff =
{
	local float ad_pain_type;
	
	// Sanity check!
	if (!(ad_targ.flags & ad_FL_CLIENT)) return;
	// Check for bleeding and minimum amount of health for debuff
	if (ad_targ.health <= ad_DEBUFF_BLEED_MIN) return;
	if (ad_targ.ad_bleeding == ad_TRUE) {
		// Do minimum damage, checked min does not kill before
		ad_T_Damage (ad_targ, self, self, ad_DEBUFF_BLEED_MIN, ad_DAMARMOR);
		return;
	}
	// Immune to debuff if using Pent of Protection or BioSuit
	if (ad_targ.items & (ad_IT_INVULNERABILITY | ad_IT_SUIT)) {
		ad_T_Damage (ad_targ, self, self, ad_DEBUFF_BLEED_DMG, ad_DAMARMOR);
		return;
	}
	
	// Starting bleeding!
	ad_targ.ad_bleeding = ad_TRUE;
	// Pause before bleeding Healing starts (def=1s)
	ad_targ.ad_bleeding_time = time + ad_map_bleedingdmg_z;

	// Pick a random player sound
	ad_pain_type = rint(random() * 3);
	if (ad_pain_type < 1) sound (ad_targ, ad_CHAN_VOICE, "player/pain4.wav", 1, ad_ATTN_NORM);
	else if (ad_pain_type < 2) sound (ad_targ, ad_CHAN_VOICE, "player/pain5.wav", 1, ad_ATTN_NORM);
	else sound (ad_targ, ad_CHAN_VOICE, "player/pain6.wav", 1, ad_ATTN_NORM);

	// Work out maximum bleed HP (remove MH excess)
	ad_targ.ad_bleeding_qty = ad_targ.health;
	if (ad_targ.ad_bleeding_qty > ad_targ.max_health) ad_targ.ad_bleeding_qty = ad_targ.max_health;
	// Reduce HP down to % (def=0.25) and restore the rest later on
	ad_targ.health = rint(ad_targ.ad_bleeding_qty * ad_map_bleedingdmg_x);
	ad_targ.ad_bleeding_qty = ad_targ.ad_bleeding_qty - ad_targ.health;

	ad_targ.ad_cshift_upd = ad_TRUE;		// Update screen colour
	ad_targ.ad_cshift_time = -1;		// Update striaght away
	ad_targ.ad_cshift_col = ad_DEBUFF_START_BLEED_COL;
	ad_targ.ad_cshift_den = ad_DEBUFF_START_BLEED_DEN;
	ad_targ.ad_cshift_step = ad_DEBUFF_START_BLEED_STEP;
};

//----------------------------------------------------------------------
void(entity ad_targ, float ad_rotoverride) ad_RotDeBuff =
{
	// Only need to check for player/client
	if ((ad_targ.flags & ad_FL_CLIENT) == ad_FALSE) return;

	// Extra Health is added via item pickup
	ad_targ.ad_rotting = ad_TRUE;
	
	// Check for a rotting override value
	if (ad_rotoverride <= 1) ad_targ.ad_rotting_qty = 1;
	else ad_targ.ad_rotting_qty = ad_rotoverride;
	
	// Always give inventory item
	ad_targ.items = ad_targ.items | ad_IT_SUPERHEALTH;
	// 5s second pause to start of HP rot
	ad_targ.ad_rotting_time = time + 5;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_BurnDeBuff =
{
	local float ad_debuffqty;
	if (VR_AD_BurnDebuff(ad_targ)) return;
	
	// Do not stack burning time beyond a certain limit
	// Cannot be burning if knee deep in water
	// Immune to debuff if using Pent of Protection or BioSuit
	if (ad_targ.ad_burning_qty > ad_DEBUFF_BURN_MAX) return;
	if ((ad_targ.flags & ad_FL_CLIENT) == ad_FALSE) return;
	if (ad_targ.waterlevel >= 3) return;
	if (ad_targ.items & (ad_IT_INVULNERABILITY | ad_IT_SUIT)) return;
	
	// if debuff not active, starting burning!
	if (!ad_targ.ad_burning) {
		ad_targ.ad_burning = ad_TRUE;
		ad_targ.ad_burning_time = -1;
	}
		
	// work out time remaining on debuff
	ad_debuffqty = rint(5*ad_skill + 3 + 2*random());
	ad_targ.ad_burning_qty = ad_targ.ad_burning_qty + ad_debuffqty;
	if (ad_targ.ad_burning_qty > ad_DEBUFF_BURN_MAX) ad_targ.ad_burning_qty = ad_DEBUFF_BURN_MAX;

	ad_targ.ad_cshift_upd = ad_TRUE;		// Update screen colour
	ad_targ.ad_cshift_time = -1;		// Update striaght away
	ad_targ.ad_cshift_col = ad_DEBUFF_BURN_COL;
	ad_targ.ad_cshift_den = ad_DEBUFF_BURN_DEN;
	ad_targ.ad_cshift_step = ad_DEBUFF_BURN_STEP;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_PoisonDeBuff =
{
	local float ad_debuffqty;
	
	// Immune to debuff if using Pent of Protection or BioSuit
	if ((ad_targ.flags & ad_FL_CLIENT) == ad_FALSE) return;
	if (ad_targ.items & (ad_IT_INVULNERABILITY | ad_IT_SUIT)) return;
	if (ad_targ.ad_poisoned) return;	// Only poison once
	
	// work out time remaining on debuff
	// poison time Easy=3+2 Normal=4+2, Hard=5+2, NM=6+2, Evil=7+2
	ad_debuffqty = floor(ad_skill + 3 + 2*random());
	// Air tanks help reduce poison debuff duration
	if (ad_targ.ad_moditems & ad_IT_ARTAIRTANK) ad_debuffqty = floor(ad_debuffqty * 0.5);
	// Is there any poison debuff time left?
	if (ad_debuffqty > 0) {
		ad_targ.ad_poisoned = ad_TRUE;
		ad_targ.ad_poisoned_time = -1;
		ad_targ.ad_poisoned_qty = ad_debuffqty;
		ad_targ.ad_cshift_upd = ad_TRUE;		// Update screen colour
		ad_targ.ad_cshift_time = -1;		// Update striaght away
		ad_targ.ad_cshift_col = ad_DEBUFF_POISON_COL;
		ad_targ.ad_cshift_den = ad_DEBUFF_POISON_DEN;
		ad_targ.ad_cshift_step = ad_DEBUFF_POISON_STEP;
	}
};

//----------------------------------------------------------------------
// Used by Pyro and Wraith; consistent damage from both monsters
//----------------------------------------------------------------------
void(entity ad_targ, float ad_playdmg, float ad_mondmg) ad_ApplyFireDmg =
{
	local float ad_reduction, ad_firedamage;
	
	// Bio suit reduction - easy=80%, normal=70%, hard=60%, nm=50%
	ad_reduction = 0.2 + ad_skill * 0.1;
	
	// Damage is different for monsters/players
	if (ad_targ.flags & ad_FL_MONSTER) ad_firedamage = ad_mondmg;
	else if (ad_targ.items & ad_IT_SUIT) ad_firedamage = rint(ad_playdmg * ad_reduction);
	else ad_firedamage = ad_playdmg;
	
	// Final damage (no armour save)
	ad_T_Damage (ad_targ, self, self.owner, ad_firedamage, ad_NOARMOR);
	ad_BurnDeBuff(ad_targ);
};
