/*==============================================================================
SHAL-RATH (VORE)
==============================================================================*/
$cd id1/models/shalrath
$origin 0 0 24
$base base
$skin skin
$scale 0.7

$frame attack1 attack2 attack3 attack4 attack5 attack6 attack7 attack8
$frame attack9 attack10 attack11

$frame pain1 pain2 pain3 pain4 pain5 

$frame death1 death2 death3 death4 death5 death6 death7

$frame	walk1 walk2 walk3 walk4 walk5 walk6 walk7 walk8 walk9 walk10
$frame	walk11 walk12

//============================================================================
// This is no stand idle! just uses frame 1 of walk
//============================================================================
void()	ad_shal_stand	=[	$walk1,	ad_shal_stand	] {ad_ai_stand();};

//============================================================================
void() ad_shal_walk1	=[	$walk2,		ad_shal_walk2	] {ad_monster_idle_sound(); ad_ai_walk(6);};
void() ad_shal_walk2	=[	$walk3,		ad_shal_walk3	] {ad_ai_walk(4);};
void() ad_shal_walk3	=[	$walk4,		ad_shal_walk4	] {ad_monster_footstep(ad_FALSE); ad_ai_walk(0);};
void() ad_shal_walk4	=[	$walk5,		ad_shal_walk5	] {ad_ai_walk(0);};
void() ad_shal_walk5	=[	$walk6,		ad_shal_walk6	] {ad_ai_walk(0);};
void() ad_shal_walk6	=[	$walk7,		ad_shal_walk7	] {ad_monster_footstep(ad_FALSE); ad_ai_walk(0);};
void() ad_shal_walk7	=[	$walk8,		ad_shal_walk8	] {ad_ai_walk(5);};
void() ad_shal_walk8	=[	$walk9,		ad_shal_walk9	] {ad_ai_walk(6);};
void() ad_shal_walk9	=[	$walk10,	ad_shal_walk10	] {ad_ai_walk(5);};
void() ad_shal_walk10	=[	$walk11,	ad_shal_walk11	] {ad_monster_footstep(ad_FALSE); ad_ai_walk(0);};
void() ad_shal_walk11	=[	$walk12,	ad_shal_walk12	] {ad_ai_walk(4);};
void() ad_shal_walk12	=[	$walk1,		ad_shal_walk1	] {ad_ai_walk(5);};

//============================================================================
// run = walk (identical frames and movement speed!)
void() ad_shal_run1	=[	$walk2,		ad_shal_run2	] {ad_monster_idle_sound(); ad_ai_run(6);};	
void() ad_shal_run2	=[	$walk3,		ad_shal_run3	] {ad_ai_run(4);};
void() ad_shal_run3	=[	$walk4,		ad_shal_run4	] {ad_monster_footstep(ad_FALSE); ad_ai_run(0);};
void() ad_shal_run4	=[	$walk5,		ad_shal_run5	] {ad_ai_run(0);};
void() ad_shal_run5	=[	$walk6,		ad_shal_run6	] {ad_ai_run(0);};
void() ad_shal_run6	=[	$walk7,		ad_shal_run7	] {ad_monster_footstep(ad_FALSE); ad_ai_run(0);};
void() ad_shal_run7	=[	$walk8,		ad_shal_run8	] {ad_ai_run(5);};
void() ad_shal_run8	=[	$walk9,		ad_shal_run9	] {ad_ai_run(6);};
void() ad_shal_run9	=[	$walk10,	ad_shal_run10	] {ad_monster_footstep(ad_FALSE); ad_ai_run(5);};
void() ad_shal_run10	=[	$walk11,	ad_shal_run11	] {ad_ai_run(0);};
void() ad_shal_run11	=[	$walk12,	ad_shal_run12	] {ad_ai_run(4);};
void() ad_shal_run12	=[	$walk1,		ad_shal_run1	] {ad_ai_run(5);};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_shalrath_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.alpha = 0.85;
	}
};

//----------------------------------------------------------------------
void() ad_shalrath_setup_attachment = 
{
	// Is monster dead or dying?
	if (self.health < 1) return;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_shalrath_create_attachment();

	// Move attachment into place ready for use
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	self.ad_attachment.solid = ad_SOLID_NOT;
	setmodel(self.ad_attachment, ad_MODEL_EMPTY);
	setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	setorigin(self.ad_attachment, self.origin);
	// Using empty model, so reset angle, frame and skin.
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = self.ad_attachment.skin = 0;
};

//----------------------------------------------------------------------
void() ad_shalrath_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_shalrath_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
};

//======================================================================
// RANGE ATTACK 1 - Homing Missile Attack
//======================================================================
void() ad_ShalMissile =
{
	// Check if there is a clear line of sight
	// The original behaviour is ruined by this final check
	// Baiting shalraths to fire will generate more voreballs flying
	// around and projectiles to dodge, best leave this working
	//if ( !(visxray(self.enemy, '0 8 20', '0 0 10', FALSE)) ) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "shalrath/attack2.wav", 1, ad_ATTN_NORM);
	self.ad_attack_speed = ad_SPEED_SHALMISSILE + (ad_skill * ad_SPEED_SHALSKILL);
	// Original vector location 0 0 10, new 0 8 20
	ad_Launch_HomingMissile ('0 8 20', '0 0 10', ad_CT_PROJ_SHAL, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void(vector ad_hmofs, float ad_hmframe) ad_Setup_ShalHome =
{
	local vector ad_org;
	if (self.health < 1) return;
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_hmframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;

		// Switch models if poisonous
		if (self.ad_poisonous) setmodel(self.ad_attachment, ad_MODEL_PROJ_SHOMEGRN);
		else setmodel(self.ad_attachment, ad_MODEL_PROJ_SHOME);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	}
	// Double check for pain interruption
	else if (self.ad_attachment.state == ad_STATE_OFF) return;

	// Turn towards enemy and update model attachment
	// The offset is based on the shalrath facing forward
	ad_ai_face();
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_hmofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = ad_hmframe;
};

//----------------------------------------------------------------------
// it would have been cool to have the homing missile form slowing in the
// shalrath hand but the animation is just weird, the arm bends backward
// into a really strange position which makes the forming missile look
// terrible, restricted the grow function to later frames only
// 2 24 18, -8 24 18, -18 22 17, -28 18 16 (arm swings round and back)
// -26 12 20, -18 10 30, 12 8 36 ( arms swings up and forward)
//
void() ad_shal_attack1		=[ $attack1,	ad_shal_attack2 ] {ad_ai_face();
	sound (self, ad_CHAN_WEAPON, "shalrath/attack.wav", 1, ad_ATTN_NORM);};
void() ad_shal_attack2		=[ $attack2,	ad_shal_attack3 ] {ad_ai_face();};
void() ad_shal_attack3		=[ $attack3,	ad_shal_attack4 ] {ad_ai_face();};
void() ad_shal_attack4		=[ $attack4,	ad_shal_attack5 ] {ad_ai_face();};
void() ad_shal_attack5		=[ $attack5,	ad_shal_attack6 ] {ad_ai_face();};
void() ad_shal_attack6		=[ $attack6,	ad_shal_attack7 ] {ad_Setup_ShalHome('-26 12 20',0);};
void() ad_shal_attack7		=[ $attack7,	ad_shal_attack8 ] {ad_Setup_ShalHome('-18 10 30',2);};
void() ad_shal_attack8		=[ $attack8,	ad_shal_attack9 ] {ad_Setup_ShalHome('12 8 36',7);};
void() ad_shal_attack9		=[ $attack9,	ad_shal_attack10] {ad_shalrath_finish_attachment();ad_ShalMissile();};
void() ad_shal_attack10	=[ $attack10,	ad_shal_attack11] {};
void() ad_shal_attack11	=[ $attack11,	ad_shal_run1    ] {};

//======================================================================
// RANGE ATTACK 2 - spawn voreling minion (optional)
//
// Creates a ball of green goo and throws it towards the player
// Once the ball has landed, hatch/explode and create baby voreling
//======================================================================
void(vector ad_eggofs, float ad_eggframe) ad_Setup_ShalrathEgg =
{
	local vector ad_org;
	if (self.health < 1) return;
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_eggframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, ad_MODEL_PROJ_SBALL);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;

		self.ad_pain_finished = time + 1;
		sound (self, ad_CHAN_WEAPON, "shalrath/attack3.wav", 1, ad_ATTN_NORM);
	}
	// Double check for pain interruption
	else if (self.ad_attachment.state == ad_STATE_OFF) return;

	// Turn towards enemy and update model attachment
	// The offset is based on the shalrath facing forward
	ad_ai_face();
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_eggofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = ad_eggframe;
};

//----------------------------------------------------------------------
void() ad_shal_minion1		=[ $attack1,	ad_shal_minion2 ] {ad_ai_face();};
void() ad_shal_minion2		=[ $attack2,	ad_shal_minion3 ] {ad_Setup_ShalrathEgg('2 24 18',0);};
void() ad_shal_minion3		=[ $attack3,	ad_shal_minion4 ] {ad_Setup_ShalrathEgg('-8 24 18',1);};
void() ad_shal_minion4		=[ $attack4,	ad_shal_minion5 ] {ad_Setup_ShalrathEgg('-18 22 17',1);};
void() ad_shal_minion5		=[ $attack5,	ad_shal_minion6 ] {ad_Setup_ShalrathEgg('-28 18 16',2);};
void() ad_shal_minion6		=[ $attack6,	ad_shal_minion7 ] {ad_Setup_ShalrathEgg('-26 12 20',3);};
void() ad_shal_minion7		=[ $attack7,	ad_shal_minion8 ] {ad_Setup_ShalrathEgg('-18 10 30',4);};
void() ad_shal_minion8		=[ $attack8,	ad_shal_minion9 ] {ad_Setup_ShalrathEgg('12 8 36',5);};
void() ad_shal_minion9		=[ $attack9,	ad_shal_minion10] {ad_shalrath_finish_attachment();ad_Create_Egg('12 8 36');};
void() ad_shal_minion10	=[ $attack10,	ad_shal_minion11] {};
void() ad_shal_minion11	=[ $attack11,	ad_shal_run1    ] {};

//----------------------------------------------------------------------
void() ad_shal_magic =
{
	local entity ad_miniondef;
	
	// Make sure the attachments are setup ready
	ad_shalrath_create_attachment();

	if (self.spawnflags & ad_MON_SHALRATH_MINIONS && !self.ad_minion_active) {
		// Check for minion template first
		ad_miniondef = find(world,classname,"monster_shalrathminion");
		if (ad_miniondef.ad_classtype == ad_CT_CACHEVORELING) ad_setup_minionsupport();
		else {
			// If template no available, warn and remove feature
			dprint("\b[SHALRATH]\b Cannot find minion template!\n");
			self.spawnflags = self.spawnflags - ad_MON_SHALRATH_MINIONS;
		}
	}
	
	// Is the target the player or monster?
	if (self.enemy.flags & ad_FL_CLIENT) {
		if (self.spawnflags & ad_MON_SHALRATH_MINIONS) {
			// This is an odd location for an melee check but the shalrath has
			// no melee function and any check (ShalCheckAttack) done is for
			// long range and moving backwards if attacking is blocked
			// If the shalrath is a minion spawner and the player is too close
			// then use the old base attack (voreballs) this can be switched off
			//
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			// If the player is too close (melee distance) try old base attack
			if (self.ad_minion_baseattack > 0 && self.ad_enemydist < ad_MON_RANGE_MELEE) ad_shal_attack1();
			else {
				// has the voreling limit been reached?
				if (ad_query_minionactive(self) == ad_TRUE) ad_shal_minion1();
				else self.think = self.ad_th_run;
			}
		}
		// Only has one type of attack, homing missiles
		else ad_shal_attack1();
		
	}
	// Attack monsters with Homing Missiles
	else ad_shal_attack1();
};

//============================================================================
void() ad_shal_pain1 =[ $pain1, ad_shal_pain2 ] {};
void() ad_shal_pain2 =[ $pain2, ad_shal_pain3 ] {ad_shalrath_finish_attachment();};
void() ad_shal_pain3 =[ $pain3, ad_shal_pain4 ] {};
void() ad_shal_pain4 =[ $pain4, ad_shal_pain5 ] {};
void() ad_shal_pain5 =[ $pain5, ad_shal_run1  ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_shal_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Hide any attachments
	ad_shalrath_finish_attachment();
	
	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_shal_pain1();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.5;
			self.ad_axhitme = 0;
			ad_shal_pain1();
		}
	}
};

//============================================================================
void() ad_shal_death1 =[ $death1, ad_shal_death2 ] {};
void() ad_shal_death2 =[ $death2, ad_shal_death3 ] {ad_monster_check_gib();};
void() ad_shal_death3 =[ $death3, ad_shal_death4 ] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_shal_death4 =[ $death4, ad_shal_death5 ] {};
void() ad_shal_death5 =[ $death5, ad_shal_death6 ] {};
void() ad_shal_death6 =[ $death6, ad_shal_death7 ] {ad_monster_death_postcheck();};
void() ad_shal_death7 =[ $death7, ad_shal_death7 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_shal_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Make sure any attachments are removed
	ad_shalrath_remove_attachment();

	// Normal death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "shalrath/death.wav", 1, ad_ATTN_NORM);
		ad_shal_death1();
	}
};

/*======================================================================
 QUAKED monster_shalrath (1 0 0) (-32 -32 -24) (32 32 48) Ambush
======================================================================*/
void() ad_monster_shalrath =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_shalrath.mdl";	// Extra skin
	self.ad_headmdl = "progs/h_shalrath.mdl";	// Matching new skin

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_SHAL);		// Original - progs/v_spike.mdl
	precache_model (ad_MODEL_PROJ_SHOME);		// Homing missile growing 8 frames
	precache_model (ad_MODEL_PROJ_SBALL);		// ball growing 8 frames
	precache_model (ad_MODEL_PROJ_SEGG);		// ball turned into egg
	precache_model (ad_MODEL_PROJ_SSHELL);		// Gibs from Egg

	self.ad_idle_sound = "shalrath/idle.wav";
	precache_sound (self.ad_idle_sound);

	precache_sound ("shalrath/death.wav");
	self.ad_pain_sound = "shalrath/pain.wav";
	precache_sound (self.ad_pain_sound);

	precache_sound ("shalrath/attack.wav");	// Start of attack
	precache_sound ("shalrath/attack2.wav");	// Firing missile
	precache_sound ("shalrath/attack3.wav");	// Minions
	precache_sound ("shalrath/bounce.wav");		// Egg bounce
	
	self.ad_sight_sound = "shalrath/sight.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_SHALGRN);	// Green voreball
		precache_model (ad_MODEL_PROJ_SHOMEGRN);	// Expanding voreball
	}

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_idmins = ad_VEC_HULL2_MIN;	// -32 -32 -24, 32 32 64
	self.ad_idmaxs = ad_VEC_HULL2_MAX;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	if (self.health < 1) self.health = ad_HP_MONSHALRATH;
	self.ad_gibhealth = -90;			// Rarely gib (explosives required)
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_flinch = 70;			// take a lot of damage before pain
	self.ad_pain_longanim = ad_TRUE;		// can be chopped with shadow axe
	self.ad_pain_timeout = 3;			// Really high pain tolerance
	self.ad_steptype = ad_FS_TYPELIGHT;	// Light tap feet
	self.ad_blockudeath = ad_TRUE;		// no humanoid death sound
	self.ad_deathstring = " was exploded by a Vore\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_ShalCheckAttack;
	self.ad_th_stand = ad_shal_stand;
	self.ad_th_walk = ad_shal_walk1;
	self.ad_th_run = ad_shal_run1;
	self.ad_th_missile = ad_shal_magic;
	self.ad_th_pain = ad_shal_pain;
	self.ad_th_die = ad_shal_die;

	// Special green skin for spider wraiths
	if (self.spawnflags & ad_MON_SHALRATH_MINIONS) self.ad_exactskin = 2;
		
	self.ad_classtype = ad_CT_MONSHAL;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
