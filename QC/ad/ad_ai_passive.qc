// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// AI Passive mode functions
// * Ideal for NPC style monsters
//=====================================================================
.float		ad_passive_mode;		// A monster with passive abilities
.float		ad_passive_state;		// Passive monster state 0=OFF, 1=ON, -1=NOT SET
.float		ad_passive_timer;		// When was the last time monster saw enemy?
.float		ad_passive_resettimer;	// Time after not seeing enemy will reset
.float		ad_passive_resethp;	// Reset HP when passive mode activated
.entity		ad_passive_activator;	// The entity which triggered the event
.string		ad_passive_eventon;	// Event trigger to fire when passive on
.string		ad_passive_eventoff;	// Event trigger to fire when passive off

float ad_MON_PASSIVESTATE_NEVER = -1;	// Never use passive system
float ad_MON_PASSIVESTATE_OFF = 0;		// Passive state back to normal
float ad_MON_PASSIVESTATE_ON = 1;		// Passive mode active
float ad_MON_PASSIVESTATE_TOGGLE = 2;	// Toggle states (0>1 1>0)
float ad_MON_PASSIVESTATE_RESET = 5;	// Going back to Passive mode

//----------------------------------------------------------------------
float(entity ad_targ) ad_check_passivestate_exception =
{
	// Check exceptions and return true if found one
	if (!(ad_targ.flags & ad_FL_MONSTER)) return ad_TRUE;
	if (ad_targ.health < 1) return ad_TRUE;
	if (ad_targ.spawnflags & ad_MON_SPAWN_ANGRY) return ad_TRUE;
	if (ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_NEVER) return ad_TRUE;
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Check for passive system exceptions
void(entity ad_targ) ad_setup_passivestate_boss =
{
	// Boss monsters cannot use the passive system
	if (!ad_targ.ad_bossflag) return;
	ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_NEVER;
	ad_targ.ad_passive_mode = ad_MON_PASSIVESTATE_NEVER;
};

//----------------------------------------------------------------------
// Make sure the passive mode flag is active and setup some defaults
void(entity ad_targ) ad_setup_passivestate =
{
	// Check for system exceptions
	if (ad_check_passivestate_exception(ad_targ)) return;
	
	// Check map worldspawn and monster for passive states
	// Setup all default parameters for passive monsters
	if (ad_map_passivestate || ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_ON) {
		ad_targ.ad_passive_mode = ad_TRUE;
		ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_ON;
		if (ad_targ.ad_passive_resettimer < 1) ad_targ.ad_passive_resettimer = ad_LARGE_TIMER;
		if (!ad_targ.ad_passive_resethp) ad_targ.ad_passive_resethp = ad_FALSE;
	}
};

//----------------------------------------------------------------------
// Fire event trigger strings (empty check done in trigger_strs function)
void(entity ad_targ) ad_trigger_passivestate_event =
{
	if (ad_targ.ad_passive_eventon != "" && ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_ON)
		ad_trigger_strs(ad_targ.ad_passive_eventon, world);
	else if (ad_targ.ad_passive_eventoff != "" && ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_OFF)
		ad_trigger_strs(ad_targ.ad_passive_eventoff, world);
};

//----------------------------------------------------------------------
// Decide if the passive monster can switch to aggressive state
// Return TRUE if need to exit, FALSE to carry on with function
float(entity ad_targ) ad_check_passivestate_switch =
{
	// Is the monster in passive mode?
	if (ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_ON) {
		// Check for ambush flag exception
		if (ad_sight_entity_time >= time - 0.1 && !(ad_targ.spawnflags & ad_MON_AMBUSH) )
			ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_OFF;
		else {
			// Only join in combat if attacked directly (enemy active)
			if (!ad_targ.enemy) return ad_TRUE;
			// If passive mode active, turn it off. No longer needed
			else ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_OFF;
		}
	}
	return ad_FALSE;
}

//----------------------------------------------------------------------
// Check if the monster is going back to passive mode
float(entity ad_targ) ad_check_passivestate_system =
{
	// Check for system exceptions
	if (ad_check_passivestate_exception(ad_targ)) return ad_FALSE;

	// Check for enemy sight timer
	if (ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_ON) {
		// Reset timer if monster can see enemy
		if (ad_enemy_vis) ad_targ.ad_passive_timer = time + ad_targ.ad_passive_resettimer;
		// If timer has expired, use reset function
		if (time > ad_targ.ad_passive_timer)
			ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_RESET;
	}

	// Check for monsters going back into passive state
	if (ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_RESET) {
		// Switch back to passive mode
		ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_ON;
		// Check for HP reset
		if (ad_targ.ad_passive_resethp) {
			dprint("\b[MONSTER]\b Passive HP reset!\n");
			ad_targ.health = ad_targ.max_health;
		}
		// Check for any turning on triggers
		ad_trigger_passivestate_event(ad_targ);
		
		// Disable the tether system with the tetherlock key
		// otherwise the monster cannot return to patrols
		ad_targ.ad_tetherlock = ad_FALSE;

		// Remove any enemy target system if active
		ad_SUB_removeEnemyTarget(ad_targ);
		ad_targ.enemy = ad_targ.goalentity = ad_targ.ad_movetarget = world;
		// Check for any targets before combat
		if (ad_targ.target != "") 
			ad_targ.ad_movetarget = find(world, targetname, ad_targ.target);
		// Check for path corners (patrols) and return to stand/walk
		if (ad_targ.ad_movetarget.ad_classtype == ad_CT_PATHCORNER) {
			ad_targ.goalentity = ad_targ.ad_movetarget;
			ad_targ.think = ad_targ.ad_th_walk;
		}
		else ad_targ.think = ad_targ.ad_th_stand;
		return ad_TRUE;
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
void(entity ad_targ, float ad_targstate) ad_change_passivestate =
{
	// Check for system exceptions
	if (ad_check_passivestate_exception(ad_targ)) return;
	
	// Check to see if monster is in combat (got an enemy)
	// - Need special state for this to happen correctly
	// - The exit from combat has to be done elsewhere (ai_run)
	if (ad_targ.enemy) 
		ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_RESET;
	else {
		// check for toggle function first
		if (ad_targstate == ad_MON_PASSIVESTATE_TOGGLE) {
			// Very clumsy way to toggle states
			if (ad_targ.ad_passive_state == ad_MON_PASSIVESTATE_OFF) 
				ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_ON;
			else ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_OFF;
		}
		else if (ad_targstate == ad_MON_PASSIVESTATE_OFF)
			ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_OFF;
		else if (ad_targstate == ad_MON_PASSIVESTATE_ON) 
			ad_targ.ad_passive_state = ad_MON_PASSIVESTATE_ON;
		// State wrong, exit
		else return;

		// Check for any turning on/off triggers
		ad_trigger_passivestate_event(ad_targ);				
	}
};

//======================================================================
/*ad:QUAKED trigger_monsterpassivestate (0.5 0 0.5) (-8 -8 -16) (8 8 16) x
Change the monster passive state
-------- KEYS --------
targetname : trigger entity (works with entity state system)
target  : this points to the monster(s) to affect
state   : 1 = ON, 0 = OFF, -1 = TOGGLE
wait    : -1 = trigger once only
-------- SPAWNFLAGS --------
-------- NOTES --------
Change the monster passive state

======================================================================*/
void() ad_trigger_monsterpassivestate_use =
{
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Loop around target(s) and update move speed
	self.enemy = find (world, targetname, self.target);
	while(self.enemy) {
		// All error checks in function
		ad_change_passivestate(self.enemy, self.state);
		// Are there anymore targets left in the list?
		self.enemy = find (self.enemy, targetname, self.target);
	} 
	
	// Trigger once functionality?
	if (self.wait < 0) self.ad_estate = ad_ESTATE_OFF;
};

//----------------------------------------------------------------------
void() ad_trigger_monsterpassivestate =
{
	self.ad_classtype = ad_CT_TRIGMONATTACK;
	if (self.target == "") {
		dprint("\b[MON_PASSIVESTATE]\b No target set, removing\n");
		remove(self);
	}
	
	// make sure state has the correct values
	if (self.state < -1 || self.state > 1) self.state = 0;

	// Check for firing conditions (nightmare, coop)
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trigger_monsterpassivestate_use;
	self.ad_estate = ad_ESTATE_ON;
};

