void() ad_nour_painb2 = [ $painb2, ad_nour_painb3 ] {};
void() ad_nour_painb3 = [ $painb3, ad_nour_painb4 ] {};
void() ad_nour_painb4 = [ $painb4, ad_nour_painb5 ] {};
