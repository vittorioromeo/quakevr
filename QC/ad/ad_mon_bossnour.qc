//======================================================================
// ATTACK B - Fire one large blob (grenade) of spit
//======================================================================
void(vector ad_bombofs) ad_Fire_NourBomb =
{
	local vector ad_org, ad_torg, ad_ang, ad_dir, ad_avel;

	// Finished with bomb effect
	ad_nour_finish_attachment();
	
	if (!self.enemy) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "nour/attack1.wav", 1, ad_ATTN_NORM);
	
	ad_ai_face();
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_bombofs);
	ad_torg = ad_SUB_orgEnemyTarget();

	self.ad_attack_speed = ad_SPEED_NOURBOMB;
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, ad_org, ad_torg, self.ad_attack_speed);
	ad_ang = vectoangles(ad_torg - ad_org);
	ad_ang_x = -self.ad_attack_elev;
	makevectors (ad_ang);
	ad_dir = v_forward * self.ad_attack_speed;

	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_NOUR2);
};

//----------------------------------------------------------------------
void(vector ad_bombofs, float ad_bombframe) ad_Setup_NourBomb =
{
	local vector ad_org;
	if (self.health < 1) return;
	
	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_nour_create_attachment();
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_bombframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.skin = 0;

		// Start growing bomb sound
		sound (self, ad_CHAN_WEAPON, "nour/attack2.wav", 1, ad_ATTN_NORM);
	}

	// Turn towards enemy and update model attachment
	// The offset is based on the nour facing forward
	ad_ai_face();
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_bombofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.angles_x = random()*360;
	self.ad_attachment.frame = ad_bombframe;
	// Random explosion like particles from ball as it grows
	ad_particle_explode(self.ad_attachment.origin, 10+random()*10, 0.5+random(), ad_PARTICLE_BURST_YELLOW, 0);
};

