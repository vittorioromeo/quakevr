void() ad_nour_attc18	=[ $shotc18, ad_nour_attc19] {};
void() ad_nour_attc19	=[ $shotc19, ad_nour_attc20] {};
void() ad_nour_attc20	=[ $shotc20, ad_nour_attc21] {};
