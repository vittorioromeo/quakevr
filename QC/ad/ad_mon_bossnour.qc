//======================================================================
void() ad_nour_slideframe =
{
	// Check for boss mode (phase and wave check)
	if (self.spawnflags & ad_MON_NOUR_BOSS) {
		if (self.style != ad_NOUR_PHASE2) return;

		// Check for boss wave trigger events
		if (ad_nour_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}
	
	// Dead monster?
	if (self.health < 1) return;
	if (self.ad_walkframe == 0) ad_monster_idle_sound();

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 10) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_nour_slideframe;
	
	// Setup current animation frame
	self.frame = $idle1 + self.ad_walkframe;
	self.ideal_yaw = vectoyaw(ad_SUB_orgEnemyTarget() - self.origin);
	
	// Check the BOSS tether system
	if (ad_nour_CheckTether()) ad_ai_run(0);
	else ad_ai_run(8);
};

//----------------------------------------------------------------------
void() ad_nour_slide1 = {self.ad_walkframe = 0; ad_nour_slideframe();};

//======================================================================
// RUN state - chasing the player
//======================================================================
void() ad_nour_runframe =
{
	// Check for boss mode (phase and wave check)
	if (self.spawnflags & ad_MON_NOUR_BOSS) {
		if (self.style != ad_NOUR_PHASE2) return;

		// Check for boss wave trigger events
		if (ad_nour_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}
	
	if (self.health < 1) return;
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 12) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_nour_runframe;
	
	// Setup current animation frame
	self.frame = $fly1 + self.ad_walkframe;
	self.ideal_yaw = vectoyaw(ad_SUB_orgEnemyTarget() - self.origin);
	
	// Check the BOSS tether system
	if (ad_nour_CheckTether()) ad_ai_run(0);
	else ad_ai_run(16);
};

//----------------------------------------------------------------------
void() ad_nour_run1 = {self.ad_walkframe = 0; ad_nour_runframe();};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_nour_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.mdl = ad_MODEL_PROJ_NOUR2B;
		self.ad_attachment.alpha = 0.85;
	}
};

//----------------------------------------------------------------------
void() ad_nour_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_nour_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
}

//======================================================================
// ATTACK A - Fire multiple spit/spikes
// Block pain function from interrupting magic attack
//======================================================================
void(vector ad_offset) ad_nour_spike = 
{
	local vector ad_dtarget, ad_starget, ad_ftarget, ad_sorg, ad_forg, ad_dir;
	
	if (!self.enemy) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_NOURSPIKE + (ad_skill * ad_SPEED_NOURSKILL);

	ad_ai_face();
	// Work out direction line from self to enemy
	ad_dtarget = ad_SUB_orgEnemyTarget() - self.origin;
	ad_dtarget = vectoangles(ad_dtarget);
	makevectors (ad_dtarget);
	
	// Work out correct source/target origins
	ad_starget = self.origin + v_forward * 16 + v_up * ad_offset_z;
	ad_ftarget = ad_SUB_orgEnemyTarget() + '0 0 16';

	// Add left/right offset
	ad_sorg = ad_starget + v_right * ad_offset_x;
	ad_forg = ad_ftarget + v_right * ad_offset_x;
	ad_dir = normalize(ad_forg - ad_sorg);
	ad_launch_projectile (ad_sorg, ad_dir, ad_CT_PROJ_NOUR1, self.ad_attack_speed);
	
	ad_sorg = ad_starget - v_right * ad_offset_x;
	ad_forg = ad_ftarget - v_right * ad_offset_x;
	ad_dir = normalize(ad_forg - ad_sorg);
	ad_launch_projectile (ad_sorg, ad_dir, ad_CT_PROJ_NOUR1, self.ad_attack_speed);
};

