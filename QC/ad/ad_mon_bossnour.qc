//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_nour_pain =
{
	// Finish with all attachments
	ad_nour_finish_attachment();

	if (self.spawnflags & ad_MON_NOUR_BOSS) {
		// Check for boss wave trigger events
		if (ad_nour_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	}

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
			// Randomly pick which pain animation to play
			if (random() < 0.8) ad_nour_paina1 ();		// Short recoil right
			else {
				ad_nour_painb1 ();						// Long recoil left
				self.ad_pain_finished = time + 2;		// long animation
			}
		}
	}
};

//============================================================================
// Death comes to us all, even Nour!
//============================================================================
void() ad_nour_explode =
{
	// Check for any final trigger events
	if (self.ad_message2 != "") ad_trigger_strs(self.ad_message2,self);
	
	// No more Nour!
	ad_entity_hide(self);
	
	// Blue ID particle explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	WriteByte (ad_MSG_BROADCAST, 35);
	WriteByte (ad_MSG_BROADCAST, 8);
	// Check for any death radius damage
	if (self.ad_death_dmg > 0) 
		ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	
	// Classic sprite/DP explosion
	ad_SpawnExplosion(ad_EXPLODE_PLASMA_BIG, self.origin, "nour/explode_death.wav");

	// Gib explosive fountain!?!
	self.max_health = ad_MON_GIBEXPLOSION;
	ad_ThrowGib(11, 2);	// Left Arm
	ad_ThrowGib(12, 2);	// Right Arm
	ad_ThrowGib(13, 1);	// Tail
	ad_ThrowGib(4, 10 + rint(random()*3));
	ad_ThrowGib(5, 10 + rint(random()*3));
};

//----------------------------------------------------------------------
void() ad_nour_die1 = [ $death1, ad_nour_die2 ] {};
void() ad_nour_die2 = [ $death2, ad_nour_die3 ] {};
void() ad_nour_die3 = [ $death3, ad_nour_die4 ] {self.solid = ad_SOLID_NOT;};
void() ad_nour_die4 = [ $death4, ad_nour_die5 ] {};
void() ad_nour_die5 = [ $death5, ad_nour_die6 ] {};
void() ad_nour_die6 = [ $death6, ad_nour_die7 ] {};
void() ad_nour_die7 = [ $death7, ad_nour_die8 ] {};
void() ad_nour_die8 = [ $death8, ad_nour_die9 ] {self.lip = 0;};
void() ad_nour_die9 = [ $death9, ad_nour_die9 ] {
	// Spawn implosion effect
	if (random() < 0.5)
		ad_particle_implode(self.origin, 20+random()*20, 100, 100, ad_PARTICLE_BURST_BLUE);
	// Spawn particle smoke and explosive smoke
	else {
		ad_SpawnProjectileSmoke(self.origin, 150, 100, 300);
		ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_BLUE);
	}
	
	// Check for any random lightning strikes outward
	if (random() < 0.5) {
		self.pos1 = self.origin - '0 0 16';
		self.pos2 = ad_vecrand(0,50,ad_TRUE);
		self.pos2_z = 25 + random()*25;	// Always up!
		self.ad_pos3 = normalize(self.pos2);
		traceline(self.pos1, self.pos1 + self.ad_pos3 * 600, ad_FALSE, self);
		
		// Create lightning bolt
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
		WriteEntity (ad_MSG_BROADCAST, self);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);

		// Play some arching lightning sounds
		if (random() < 0.5) {
			if (random() < 0.5) sound (self, ad_CHAN_BODY, "nour/elec_arch1.wav", 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_BODY, "nour/elec_arch2.wav", 1, ad_ATTN_NORM);
		}
	}
	// Check for a random bolt of plasma
	if (random() < 0.2) ad_Fire_NourPlasma('0 0 -16');
	
	// Cycle through end phase
	self.lip = self.lip + 1;
	if (self.lip == 26) sound (self, ad_CHAN_AUTO, "nour/implode_death.wav", 1, ad_ATTN_NONE);
	if (self.lip == 40) ad_nour_explode();
};

//----------------------------------------------------------------------
void() ad_nour_die =
{
	dprint("[NOUR] Dying State ("); dprint(ftos(self.style));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(")\n");
	self.deadflag = ad_DEAD_DEAD;	// Nour bites the dust
	self.effects = 0;			// Remove effects on death
	ad_nour_finish_attachment();	// Remove any attachments
	ad_nour_remove_attachment();

	sound (self, ad_CHAN_VOICE, "nour/death.wav", 1, ad_ATTN_NORM);
	self.velocity_x = -200 + 400*random();
	self.velocity_y = -200 + 400*random();
	self.velocity_z = 100 + 100*random();
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	ad_nour_die1 ();
};

//======================================================================
// Create wizard minion entity chain
// Entities are created so that the spawning space can be tested
// before spawning the minions for possible collisions
//======================================================================
float() ad_nour_minionsetup =
{
	local entity ad_min_prev, ad_min_first;
	
	self.lip = self.ad_attack_summon;
	ad_min_prev = ad_min_first = world;
	
	// Cycle through minion list
	while(self.lip > 0) {
		ad_newmis = spawn();
		ad_newmis.origin = self.origin;
		ad_newmis.owner = self;
		// Is this the first pass through loop?
		if (!ad_min_first) ad_min_first = ad_newmis;
		// Any previous entities created?
		if (!ad_min_prev) ad_min_prev = ad_newmis;
		else {
			// Link previous to current entity
			// and move previous forward in chain
			ad_min_prev.ad_entchain = ad_newmis;
			ad_min_prev = ad_newmis;
		}
		// Keep on looping
		self.lip = self.lip - 1;
	}
	// Close loop
	if (ad_min_first) {
		ad_newmis.ad_entchain = ad_min_first;
		self.ad_bossminchain = ad_min_first;
		return ad_FALSE;
	}
	else return ad_TRUE;
};

//----------------------------------------------------------------------
void() ad_nour_spawntether =
{
	// temporary tether point
	self.ad_movelast = spawn();
	self.ad_movelast.owner = self;
	self.ad_movelast.ad_classtype = ad_CT_TETHERENT;
	self.ad_movelast.movetype = ad_MOVETYPE_NONE;
	self.ad_movelast.solid = ad_SOLID_NOT;
	self.ad_movelast.origin = self.origin;
	setsize (self.ad_movelast, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
};

//======================================================================
// REVEAL PHASE (coming out of the ground)
//======================================================================
void() ad_nour_readyframe =
{
	self.ad_walkframe = 0;				// Reset just in case
	self.height = ad_MONAI_ABOVEDIST;	// Enemytarget distance above
	self.movetype = ad_MOVETYPE_STEP;	// back to regular movement
	self.takedamage = ad_DAMAGE_AIM;	// Can take damage
	self.style = ad_NOUR_PHASE2;		// Time to fight!
	ad_Resist_ChangeType(self,ad_FALSE);	// restore resistance
	if (self.enemy) self.ad_th_run();	// Hunt the player
	else self.ad_th_stand();			// Wait for the player
};

//----------------------------------------------------------------------
void() ad_nour_revealframe = 
{
	// Beginning of animation block
	if (self.ad_walkframe == 3) 
		sound (self, ad_CHAN_BODY, "nour/reveal.wav", 1, ad_ATTN_NORM);
	else if (self.ad_walkframe == 23)
		sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
	
	if (self.ad_movetarget2 != world) { 
		// Work out remaining distance to go
		self.movedir = self.ad_movetarget2.origin - self.origin;
		self.t_length = vlen(self.movedir);
		// Calc initial velocity boast (burst action)
		self.lip = (self.ad_pausetime - time) / 3.6;
		self.t_width = 1 + (self.lip/2);

		// If time or distance too small, stop moving
		if (self.lip < 0.1 || self.t_length < 2) {
			self.velocity = '0 0 0';
		}
		// Update velocity every frame
		else self.velocity = self.movedir * self.t_width;
	}
	
	// Turn towards player
	if (self.enemy) ad_ai_face();

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	self.nextthink = time + 0.1;
	// Time to exit reveal?
	if (self.ad_walkframe > 35) ad_nour_readyframe();
	else {
		self.think = ad_nour_revealframe;
		// Setup current animation frame
		self.frame = $reveal1 + self.ad_walkframe;
	}
};

//======================================================================
// Setup BOSS Nour after trigger event
//======================================================================
void() ad_nour_awake =
{
	// make sure boss mode selected
	if (!(self.spawnflags & ad_MON_NOUR_BOSS)) return;

	self.use = ad_SUB_Null;			// No more triggers
	self.style = ad_NOUR_PHASE1;		// Bursting intro sequence
	self.flags = ad_FL_MONSTER | ad_FL_FLY;	// Reset flag (no user settings)
	self.frame = $idle1; self.skin = self.ad_exactskin;
	ad_monster_bbox();					// Setup bounding box

	self.ad_noinfighting = ad_TRUE;		// No infighting
	self.takedamage = ad_DAMAGE_NO;	// Still immune to damage
	self.yaw_speed = 20;			// Average Speed
	self.velocity = '0 0 0';		// Make sure stationary
	self.ad_walkframe = 0;				// reset for animation
	self.ad_attack_summon = ad_skill + 1;	// Total amount of minions

	if (self.ad_tetherrange < 32) self.ad_tetherrange = ad_MONAI_MAXNOUR;
	if (self.ad_bossminbase <= 64) self.ad_bossminbase = ad_MONAI_BOSS_SUMDIST;
	if (self.ad_bossminrnd <= 64) self.ad_bossminrnd = ad_MONAI_BOSS_SUMRND;

	// skill modifier : Easy = 1, Normal = 2, Hard/NM = 3
	if (self.ad_attack_summon > 3) self.ad_attack_summon = 3;
	// Setup minion chain entity system
	if (ad_nour_minionsetup()) {
		dprint("\b[NOUR]\b Cannot create minion chain!\n");
		ad_spawn_marker(self.origin+'0 0 32', ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}
		
	// Check for tether system (special target field)
	if (self.ad_tethertarget == "") {
		dprint("\b[NOUR]\b Generated tetherpoint!\n");
		ad_nour_spawntether();
	}
	// Find the defined tether marker
	else self.ad_movelast = find(world,targetname,self.ad_tethertarget);
	
	// Does the tether entity exist?
	if (!self.ad_movelast) {
		dprint("\b[NOUR]\b Tether target not found!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}

	// Show BOSS tetherpoint
	ad_spawn_marker(self.ad_movelast.origin+'0 0 8', ad_SPNMARK_RED);
	
	// If message2 is not defined?
	if (self.ad_message2 == "") {
		// No movement towards a reveal location
		self.ad_movetarget2 = world;
		// Skip reveal sequence
		self.ad_walkframe = 35;
		// Reset all combat entities
		self.enemy = self.goalentity = self.ad_movetarget = world;
		// Zap (50K damage) anything in its place!
		if (self.ad_nospawndamage == 0) 
			ad_spawn_tdeath(self.origin, self);
		// Don't show spawning effect if nogfx
		if (!(self.spawnflags & ad_MON_SPAWN_NOGFX)) 
			ad_spawn_tfog(self.origin);
	}
	else {
		// Find spawning (move) destination
		self.ad_movetarget2 = find(world,targetname,self.ad_message2);
		if (!self.ad_movetarget2) {
			dprint("\b[NOUR]\b Missing spawn destination!\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			ad_entity_hide(self);
			return;
		}
		else {
			// After reveal, start attacking player
			if (ad_activator.flags & ad_FL_CLIENT) {
				self.goalentity = self.enemy = ad_activator; }
			else self.enemy = world;
		}
	}
	
	// Start spawning BOSS
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_FLY;				// Alway fly
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	
	// Check for delay spawn monster count
	if (self.ad_delaymonstercount) {
		// Reset both monster count conditions
		self.ad_nomonstercount = self.ad_delaymonstercount = 0;
		total_monsters = total_monsters + 1;
		ad_update_hud_totals(ad_HUD_MONSTERS);
	}

	//Resist_CheckRange(self);		// Double check values
	ad_Resist_Save(self);				// Save for Later
	ad_Resist_ChangeType(self,ad_TRUE);	// resist everything

	// Reset all combat flags and counters
	self.deadflag = ad_DEAD_NO;
	self.ad_liquidbase = self.ad_liquidcheck = 0;
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;

	// Setup boss waves and overall health
	if (self.ad_bosswave < 1) self.ad_bosswavetotal = 4;
	else self.ad_bosswavetotal = self.ad_bosswave;
	
	// Setup boss waves and overall health
	self.ad_bosswave = 1;
	if (self.ad_bosswaveqty < 1) self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_nour_WaveSetupHP();

	self.ad_pain_finished = time + 3;		// Make pain go away
	self.ad_attack_finished = time + 2;	// Reset attack system
	
	// Trigger all spawning events (optional)
	if (self.message != "") {
		ad_trigger_strs(self.message, self);
		self.message = "";
	}
	
	// Make sure all death triggers are setup ready
	self.ad_message2 = self.target;
	self.target = self.ad_target2 = self.ad_deathtarget = "";

	// Time to keep pushing velocity upward
	self.ad_pausetime = time + 3.6;
	// Time to rise from the ground or spawn regular
	ad_nour_revealframe();
};

/*======================================================================
 QUAKED monster_nouronihar (1 0 0) (-16 -16 -24) (16 16 40)
======================================================================*/
void() ad_monster_nour =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_bossnour.mdl";
	self.ad_headmdl = "progs/h_wizard.mdl";
	self.ad_gib1mdl = "progs/gib_wzarm1.mdl";	// Left arm/stump
	self.ad_gib2mdl = "progs/gib_wzarm2.mdl";	// Right arm/stump
	self.ad_gib3mdl = "progs/gib_wztail.mdl";	// Tail section
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_WIZ);	// Originally progs/w_spike.mdl
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (ad_MODEL_PROJ_NOUR1);	// Spit
	precache_model (ad_MODEL_PROJ_NOUR2B);	// Growing ball
	precache_model (ad_MODEL_PROJ_NOUR2P);	// Warping projectile
	precache_model (ad_MODEL_PROJ_NOUR2S);	// Explosive pieces
	precache_model (ad_SBURST_POISON);		// Poison Burst

	// sight/pain/death sounds
	self.ad_idle_sound = "nour/idle1.wav";
	self.ad_pain_sound = "nour/pain.wav";
	self.ad_sight_sound = "nour/sight.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_sight_sound);
	precache_sound ("nour/reveal.wav");

	// Final death sequence
	precache_sound ("nour/death.wav");
	precache_sound ("nour/explode_death.wav");
	precache_sound ("nour/elec_arch1.wav");
	precache_sound ("nour/elec_arch2.wav");
	precache_sound ("nour/implode_death.wav");

	// Attack A - Wizard style spit
	// Attack B - Large explosive ball
	precache_sound ("nour/attack1.wav");
	precache_sound ("nour/attack2.wav");
	precache_sound ("nour/explode2.wav");
	precache_sound ("nour/bounce.wav");
	
	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_bboxtype = ad_BBOX_WIDE;		// Wraith Body
	// Regular monster with large HP
	if (self.health < 1) self.health = 1200;

	self.ad_gibhealth = ad_MON_NEVERGIB;	// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;			// Starts complete
	self.ad_pain_flinch = 200;			// Strong Wizard level
	self.ad_pain_timeout = 2;			// Stop constant pain
	if (self.ad_infightextra <= 0) self.ad_infightextra = 8;
	self.ad_steptype = ad_FS_FLYING;		// No foot sound
	self.ad_blockudeath = ad_TRUE;		// No player gib sound
	self.ad_pain_longanim = ad_FALSE;		// No axe advantage
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_NOUR;
	self.ad_poisonous = ad_FALSE;			// Cannot be poisonous
	self.style = ad_NOUR_PHASE0;		// No waves setup
	self.ad_deathstring = " was picked apart by the Scragmother\n";
	
	// Change balance of range (spit/bomb) attacks
	if (self.ad_attack_chance <= 0) self.ad_attack_chance = 0;
	if (self.ad_attack_chance >= 1) self.ad_attack_chance = 1;
	
	// Setup Ammo Resistance
	if (self.classname == "monster_vermis") {
		self.ad_resist_shells = self.ad_resist_nails = 0;
		self.ad_resist_rockets = 0.5; self.ad_resist_cells = 0;
	}
	else {
		if (self.spawnflags & ad_MON_NOUR_BOSS) self.ad_resist_cells = 1;
		// Regular Nour is not 100% resistant
		else self.ad_resist_cells = 0.75;
		self.ad_resist_shells = self.ad_resist_nails = 0;
		self.ad_resist_rockets = 0; 
		self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
		self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	}
	
	// Restore all think functions
	self.ad_th_checkattack = ad_NourCheckAttack;
	self.ad_th_stand = ad_nour_stand1;
	self.ad_th_walk = ad_nour_walk1;
	self.ad_th_run = ad_nour_run1;
	self.ad_th_slide = ad_nour_slide1;
	self.ad_th_melee = ad_nour_atta1;
	self.ad_th_missile = ad_nour_attb1;
	self.ad_th_summon = ad_nour_attc1;
	self.ad_th_pain = ad_nour_pain;
	self.ad_th_die = ad_nour_die;
		
	self.ad_classtype = ad_CT_MONNOUR;
	self.ad_classgroup = ad_CG_WIZARD;
	self.ad_classmove = ad_MON_MOVEFLY;
	
	// Check for boss version of Nouronihar?
	if (self.spawnflags & ad_MON_NOUR_BOSS) {
		// Reset spawnflag, other values not required
		self.health = self.max_health = ad_MEGADEATH;
		self.ad_pain_finished = ad_LARGE_TIMER;		
		self.takedamage = ad_DAMAGE_NO;	// Immune to damage
		self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
		self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)		
		self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage
	
		// Check passive system for exceptions
		ad_setup_passivestate_boss(self);
	
		// No targetname = no trigger!
		if (self.targetname == "") {
			dprint("\b[NOUR]\b Missing targetname name!\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			return;
		}
		// No tether target defined!
		if (self.ad_tethertarget == "") {
			dprint("\b[NOUR]\b Missing tether target!\n");
		}
		// Monster count exceptions
		if (self.ad_nomonstercount > 0 || self.ad_delaymonstercount > 0) {
			// Some maps have way too many no monster counts
			if (world.ad_no_moncountdevmsg <= 0) {
				dprint("\b[NOUR]\b ("); dprint(self.targetname);
				dprint(") - no monster count\n");
			}
		}
		// Update count before client spawn
		else total_monsters = total_monsters + 1;
		
		// Devmarker function changes skins, save for later
		self.frame = 0; self.ad_exactskin = self.skin;
		// Display debug diamonds
		ad_monster_devmarker(self);
		// Wait for trigger event
		self.use = ad_nour_awake;
	}
	// Regular start of monster
	else ad_monster_start();
};

//----------------------------------------------------------------------
// Re-direct all Quoth Vermis requests to Nour!
void() ad_monster_vermis = { 
	// Setup as special BOSS setup
	self.spawnflags = self.spawnflags | ad_MON_NOUR_BOSS;
	// No spawn destinations = no intro setup
	self.message = ""; self.ad_message2 = "";
	// Veris HP is very high
	self.ad_bosswave = 3; self.ad_bosswaveqty = 1000;
	// Remove any quoth skin/frame setup
	self.skin = self.frame = 0;
	// BOSS time!
	ad_monster_nour(); 
}
