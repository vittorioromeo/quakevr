//======================================================================
// ATTACK C - Summon wizards around boss
//======================================================================
void() ad_Spawn_NourFog =
{
	// Randomly pick from teleport sounds
	self.lip = random() * 5;
	if (self.lip < 1) self.noise = "misc/r_tele1.wav";
	else if (self.lip < 2) self.noise = "misc/r_tele2.wav";
	else if (self.lip < 3) self.noise = "misc/r_tele3.wav";
	else if (self.lip < 4) self.noise = "misc/r_tele4.wav";
	else self.noise = "misc/r_tele5.wav";
	sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);
	
	// Show ID teleport particle effect
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_TELEPORT);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
};

//----------------------------------------------------------------------
// Fire random plasma spikes while summoning wizard minions
//----------------------------------------------------------------------
void(vector ad_minofs) ad_Fire_NourPlasma =
{
	local vector ad_org;

	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_minofs);
	self.pos2 = ad_vecrand(0,50,ad_TRUE);
	self.ad_pos3 = normalize(self.pos2);
	ad_launch_plasma(ad_org, self.ad_pos3, ad_CT_SUMMONLIGHT, ad_SPEED_REFLECTION);
};

//----------------------------------------------------------------------
void(vector ad_minofs) ad_Spawn_NourMin =
{
	// Finished with bomb effect
	ad_nour_finish_attachment();
	ad_Fire_NourPlasma(ad_minofs);
	
	// Cycle through spawn targets and spawn Tfog + Wizard
	self.lip = self.ad_attack_summon;
	while(self.lip > 0) {
		self.ad_bossminchain.think = ad_Spawn_NourFog;
		self.ad_bossminchain.nextthink = time + 0.01 + random()*0.3;

		// If the spawn locaiton all clear, spawn something!
		self.pos1 = self.ad_bossminchain.origin;
		self.aflag = ad_find_minionspace(self.pos1);			
		if (self.aflag == ad_TRUE) {
			// Check for any spawnflags on spawn point
			if (random() < 0.5)
				ad_minion_wizard(self.pos1, self.enemy, ad_MON_WIZARD_ABOVE);
			else ad_minion_wizard(self.pos1, self.enemy, 0);
		}
		
		// Next spawn point
		self.ad_bossminchain = self.ad_bossminchain.ad_entchain;
		self.lip = self.lip - 1;
	}
};

//----------------------------------------------------------------------
void(vector ad_minofs, float ad_minframe) ad_Setup_NourMin =
{
	local vector ad_org;
	
	// Re-use the energy ball attachment for spawning lightning from
	if (!self.ad_attachment) ad_nour_create_attachment();
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_minframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.skin = 1;

		// Start Spawning sound
		sound (self, ad_CHAN_WEAPON, "nour/attack2.wav", 1, ad_ATTN_NORM);
	}

	// Move the energy ball into position infront of the nour
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_minofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.angles_x = random()*360;
	self.ad_attachment.frame = ad_minframe;
	// Slowly suck in particles to energy ball
	ad_particle_implode(ad_org, 20+random()*20, 75, 75, ad_PARTICLE_BURST_BLUE);

	// Cycle through spawn targets and fire Lightning per frame
	self.lip = self.ad_attack_summon;
	while(self.lip > 0) {
		// Traceline from spawn point to random direction
		self.pos1 = self.ad_bossminchain.origin - ad_org;
		self.pos2 = ad_vecrand(0,50,ad_TRUE);
		self.ad_pos3 = normalize(self.pos1 + self.pos2);
		traceline(ad_org, ad_org + self.ad_pos3 * 600, ad_FALSE, self);
		
		// Create lightning bolt from source to target
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
		WriteEntity (ad_MSG_BROADCAST, self.ad_bossminchain);
		WriteCoord (ad_MSG_BROADCAST, ad_org_x);
		WriteCoord (ad_MSG_BROADCAST, ad_org_y);
		WriteCoord (ad_MSG_BROADCAST, ad_org_z);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);
		
		// Play some arching lightning sounds
		if (random() < 0.5) {
			if (random() < 0.5) sound (self.ad_bossminchain, ad_CHAN_BODY, "nour/elec_arch1.wav", 1, ad_ATTN_NORM);
			else sound (self.ad_bossminchain, ad_CHAN_BODY, "nour/elec_arch2.wav", 1, ad_ATTN_NORM);
		}

		// Next spawn point
		self.ad_bossminchain = self.ad_bossminchain.ad_entchain;
		self.lip = self.lip - 1;
	}
	
	// Generate a random bolt of electricity
	ad_Fire_NourPlasma(ad_minofs);
};

//----------------------------------------------------------------------
void() ad_nour_attc1	=[ $shotc1, ad_nour_attc2] {ad_ai_face();
	// Make sure boss mode active for this attack
	if (!(self.spawnflags & ad_MON_NOUR_BOSS)) { self.think = self.ad_th_run; return; }

	// Block all damage while summoning stuff
	ad_Resist_ChangeType(self, ad_TRUE);
	
	// Reset attack state so it does not keep spawning
	self.ad_attack_state = ad_AS_STRAIGHT;
	self.lip = self.ad_attack_summon;
	while (self.lip > 0) {
		self.cnt = 4;	// Try 4 times, no infinite loops
		while (self.cnt > 0) {
			// Work out 2 empty spaces around Nour for minions
			self.pos2 = ad_vecrand(self.ad_bossminbase, self.ad_bossminrnd, ad_TRUE);
			// Always spawn higher than boss
			if (self.pos2_z < self.maxs_z) self.pos2_z = self.maxs_z;
			self.pos1 = self.origin + self.pos2;
			// Check for available space for mininon
			self.aflag = ad_find_minionspace(self.pos1);
			self.cnt = self.cnt - 1;
			// Space is right, save origin
			if (self.aflag == ad_TRUE) self.cnt = -10;
		}
		// Found space, store origin for later
		if (self.cnt == -10) self.ad_bossminchain.origin = self.pos1;
		else self.ad_bossminchain.origin = self.origin;
		
		// Next spawn point
		self.ad_bossminchain = self.ad_bossminchain.ad_entchain;
		self.lip = self.lip - 1;
	}
};
void() ad_nour_attc2	=[ $shotc2, ad_nour_attc3] {ad_ai_face();};
void() ad_nour_attc3	=[ $shotc3, ad_nour_attc4] {ad_ai_face();};
void() ad_nour_attc4	=[ $shotc4, ad_nour_attc5] {ad_Setup_NourMin('24 0 -24',0);};
void() ad_nour_attc5	=[ $shotc5, ad_nour_attc6] {ad_Setup_NourMin('24 0 -24',1);};
void() ad_nour_attc6	=[ $shotc6, ad_nour_attc7] {ad_Setup_NourMin('24 0 -22',2);};
void() ad_nour_attc7	=[ $shotc7, ad_nour_attc8] {ad_Setup_NourMin('24 0 -20',3);};
void() ad_nour_attc8	=[ $shotc8, ad_nour_attc9] {ad_Setup_NourMin('24 0 -16',4);};
void() ad_nour_attc9	=[ $shotc9, ad_nour_attc10] {ad_Setup_NourMin('24 0 -16',5);};
void() ad_nour_attc10	=[ $shotc10, ad_nour_attc11] {ad_Setup_NourMin('24 0 -12',6);};
void() ad_nour_attc11	=[ $shotc11, ad_nour_attc12] {ad_Setup_NourMin('24 0 -8',6);};
void() ad_nour_attc12	=[ $shotc12, ad_nour_attc13] {ad_Setup_NourMin('24 0 -4',7);};
void() ad_nour_attc13	=[ $shotc13, ad_nour_attc14] {ad_Setup_NourMin('24 0 -2',7);};
