//============================================================================
// Range attack
//============================================================================
void()	ad_WizardAttackFinished =
{
	ad_SUB_AttackFinished(2);
	if (ad_enemy_range >= ad_RANGE_MID || !ad_enemy_vis) {
		self.ad_attack_state = ad_AS_STRAIGHT;
		self.think = ad_wiz_run1;
	}
	else {
		self.ad_attack_state = ad_AS_SLIDING;
		self.think = ad_wiz_side1;
	}
};

//----------------------------------------------------------------------
// Fire spit missile towards player position
// The missile is setup and defined beforehand
//----------------------------------------------------------------------
void() ad_Wiz_FastFire =
{
	if (VR_AimCone_Wait(ad_Wiz_FastFire, VR_AIM_WIDE)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_vec, ad_dst;
	local entity ad_twizard, ad_tmissile;

	// Is the wizard still alive?
	if (self.owner.health > 0) {
		// Setup correct entities
		ad_tmissile = self;
		ad_twizard = self.owner;
		// Switch to the actual wizard
		self = ad_twizard;
		
		// Add glow effect to wizard while firing	
		self.effects = self.effects | ad_EF_MUZZLEFLASH;

		// Check for any enemytarget setup (above spawnflag)
		makevectors (ad_SUB_angEnemyTarget());
		// Work out origin and offset from missile, not wizard
		ad_dst = ad_SUB_orgEnemyTarget() - 13 * ad_tmissile.movedir;
		ad_vec = normalize(ad_dst - ad_tmissile.origin);
		
		self.ad_attack_speed = ad_SPEED_WIZSPIKE + (ad_skill * ad_SPEED_WIZSKILL);
		// make sure sound is played on the wizard, not the missile
		sound (self, ad_CHAN_WEAPON, "wizard/wattack.wav", 1, ad_ATTN_NORM);
		// Launch projectile expects self = firing monster
		ad_launch_projectile (ad_tmissile.origin, ad_vec, ad_CT_PROJ_WIZ, self.ad_attack_speed);
		// Switch back to missile entity for removal
		self = ad_tmissile;
	}

	remove (self);
};

//----------------------------------------------------------------------
// Create two spit missiles ready for firing later (delay 0.6, 1.0)
// This code is hoping the player will strafe into the second shot
//----------------------------------------------------------------------
void() ad_Wiz_StartFast =
{
	local entity ad_missile;
	
	sound (self, ad_CHAN_WEAPON, "wizard/wattack.wav", 1, ad_ATTN_NORM);
	self.v_angle = self.angles;
	makevectors (self.angles);

	ad_missile = spawn ();
	ad_missile.owner = self;
	ad_missile.nextthink = time + 0.6;
	setsize (ad_missile, '0 0 0', '0 0 0');		
	setorigin (ad_missile, self.origin + self.ad_attack_offset + v_forward*14 + v_right*14);
	ad_missile.enemy = ad_SUB_entEnemyTarget();
	ad_missile.nextthink = time + 0.8;
	ad_missile.think = ad_Wiz_FastFire;
	ad_missile.movedir = v_right;

	ad_missile = spawn ();
	ad_missile.owner = self;
	ad_missile.nextthink = time + 1;
	setsize (ad_missile, '0 0 0', '0 0 0');		
	setorigin (ad_missile, self.origin + self.ad_attack_offset + v_forward*14 + v_right* -14);
	ad_missile.enemy = ad_SUB_entEnemyTarget();
	ad_missile.nextthink = time + 0.3;
	ad_missile.think = ad_Wiz_FastFire;
	ad_missile.movedir = ad_VEC_ORIGIN - v_right;
};

//----------------------------------------------------------------------
void()	ad_wiz_fast1  =[ $magatt1, ad_wiz_fast2 ] {ad_ai_face();ad_Wiz_StartFast();};
void()	ad_wiz_fast2  =[ $magatt2, ad_wiz_fast3 ] {ad_ai_face();};
void()	ad_wiz_fast3  =[ $magatt3, ad_wiz_fast4 ] {ad_ai_face();};
void()	ad_wiz_fast4  =[ $magatt4, ad_wiz_fast5 ] {ad_ai_face();};
void()	ad_wiz_fast5  =[ $magatt5, ad_wiz_fast6 ] {ad_ai_face();};
void()	ad_wiz_fast6  =[ $magatt6, ad_wiz_fast7 ] {ad_ai_face();};
void()	ad_wiz_fast7  =[ $magatt5, ad_wiz_fast8 ] {ad_ai_face();};
void()	ad_wiz_fast8  =[ $magatt4, ad_wiz_fast9 ] {ad_ai_face();};
void()	ad_wiz_fast9  =[ $magatt3, ad_wiz_fast10] {ad_ai_face();};
void()	ad_wiz_fast10 =[ $magatt2, ad_wiz_run1  ] {ad_WizardAttackFinished (); ad_ai_face();};

//============================================================================
void()	ad_wiz_wakeup =[ $hover1, ad_wiz_run1 ] {
	// Is the wizard stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		ad_monster_sightsound();
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);
		// Restore all think state functions
		self.ad_th_stand = ad_wiz_stand1;
		self.ad_th_walk = ad_wiz_walk1;
		self.ad_th_run = ad_wiz_run1;
		self.ad_th_missile = ad_wiz_fast1;
		self.ad_th_slide = ad_wiz_side1;
	}
};

//============================================================================
void() ad_wiz_pain1 =[ $pain1, ad_wiz_pain2] {};
void() ad_wiz_pain2 =[ $pain2, ad_wiz_pain3] {};
void() ad_wiz_pain3 =[ $pain3, ad_wiz_pain4] {};
void() ad_wiz_pain4 =[ $pain4, ad_wiz_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_wiz_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_wiz_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.4;
			self.ad_axhitme = 0;
			ad_wiz_pain1 ();
		}
	}
};

//============================================================================
void() ad_wiz_death1 =[ $death1, ad_wiz_death2 ] {};
void() ad_wiz_death2 =[ $death2, ad_wiz_death3 ] {ad_monster_check_gib();};
void() ad_wiz_death3 =[ $death3, ad_wiz_death4 ] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_wiz_death4 =[ $death4, ad_wiz_death5 ] {};
void() ad_wiz_death5 =[ $death5, ad_wiz_death6 ] {};
void() ad_wiz_death6 =[ $death6, ad_wiz_death7 ] {};
void() ad_wiz_death7 =[ $death7, ad_wiz_death8 ] {ad_monster_death_postcheck();};
void() ad_wiz_death8 =[ $death8, ad_wiz_death8 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_wiz_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	if (!self.ad_gibbed) { 
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		self.velocity_x = -200 + 400*random();
		self.velocity_y = -200 + 400*random();
		self.velocity_z = 100 + 100*random();
		self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
		ad_wiz_death1 ();
	}
};

/*======================================================================
QUAKED monster_wizard (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_setup_wizard;
void() ad_monster_wizard =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_wizard.mdl";
	self.ad_headmdl = "progs/h_wizard.mdl";
	self.ad_gib1mdl = "progs/gib_wzarm1.mdl";	// Left arm/stump
	self.ad_gib2mdl = "progs/gib_wzarm2.mdl";	// Right arm/stump
	self.ad_gib3mdl = "progs/gib_wztail.mdl";	// Tail section
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_WIZ);		// Originally progs/w_spike.mdl
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_idle_sound = "wizard/widle1.wav";
	self.ad_idle_sound2 = "wizard/widle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	// Must exist (hardcoded)
	precache_sound ("wizard/hit.wav");		// used by c code
	precache_sound ("wizard/wattack.wav");

	self.ad_pain_sound = "wizard/wpain.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "wizard/wdeath.wav";
	precache_sound (self.ad_death_sound);

	self.ad_sight_sound = "wizard/wsight.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		self.ad_exactskin = 1;				// Greener version
		self.ad_gib1skin = self.ad_gib2skin = self.ad_gib3skin = 1;
	}

	// Cache wizard is a special class used for precache only
	if (self.ad_classtype != ad_CT_CACHEWIZARD) ad_setup_wizard();
};

//----------------------------------------------------------------------------
void() ad_monster_nourminion = { 
	self.ad_classtype = ad_CT_CACHEWIZARD; 
	self.ad_poisonous = ad_TRUE;	// Cache poison stuff (just in case)
	ad_monster_wizard();
};

//----------------------------------------------------------------------------
void() ad_setup_wizard =
{
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = ad_HP_MONWIZARD;
	self.ad_gibhealth = -30;
	self.ad_gibbed = ad_FALSE;				// Not falling apart
	self.ad_pain_flinch = 70;				// high pain threshold
	self.ad_pain_longanim = ad_TRUE;			// Has long pain animation for Shadow Axe
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_steptype = ad_FS_FLYING;			// Wandering around!
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	self.ad_enemymaxdist = ad_TRUE;			// Really high distance checks
	self.ad_attack_offset = '0 0 30';		// Acid spit start location
	self.ad_deathstring = " was wrecked by a Wizard\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_WizardCheckAttack;
	self.ad_th_pain = ad_wiz_pain;
	self.ad_th_die = ad_wiz_die;
		
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MINIONWIZARD) {
		self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_wiz_wakeup;
		self.ad_th_missile = self.ad_th_slide = ad_wiz_wakeup;
	}
	//----------------------------------------------------------------------
	else {
		// Default wizard setup
		self.ad_th_stand = ad_wiz_stand1;
		self.ad_th_walk = ad_wiz_walk1;
		self.ad_th_run = ad_wiz_run1;
		self.ad_th_missile = ad_wiz_fast1;
		self.ad_th_slide = ad_wiz_side1;
	}

	if (!self.ad_classtype) self.ad_classtype = ad_CT_MONWIZARD;
	if (!self.ad_classgroup) self.ad_classgroup = ad_CG_WIZARD;
	self.ad_classmove = ad_MON_MOVEFLY;
	
	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn wizards (requires monster_nourminion entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ, float ad_minion_sflag) ad_minion_wizard =
{
	local entity ad_minion;

	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	ad_update_minioncount(self, 1);			// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_wizard";	// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self;					// Spawner Parent Link
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_gibondeath = 1;					// Always gib on death
	ad_minion.ad_classtype = ad_CT_MINIONWIZARD;		// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.spawnflags = ad_minion_sflag;		// Spawnflags
	ad_minion.ad_classgroup = ad_CG_WIZARD;			// Don't turn on master
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	// Check for poison gibs being cached first
	if (ad_gibpoison && self.ad_poisonous == ad_TRUE) {
		ad_minion.ad_poisonous = self.ad_poisonous;	// carry over from host spawner 
		ad_minion.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}

	ad_minion.mdl = "progs/mon_wizard.mdl";
	ad_minion.ad_headmdl = "progs/h_wizard.mdl";
	ad_minion.ad_gib1mdl = "progs/gib_wzarm1.mdl";	// Left arm/stump
	ad_minion.ad_gib2mdl = "progs/gib_wzarm2.mdl";	// Right arm/stump
	ad_minion.ad_gib3mdl = "progs/gib_wztail.mdl";	// Tail section

	ad_minion.ad_idle_sound = "wizard/widle1.wav";
	ad_minion.ad_idle_sound2 = "wizard/widle2.wav";
	ad_minion.ad_sight_sound = "wizard/wsight.wav";
	ad_minion.ad_pain_sound = "wizard/wpain.wav";
	ad_minion.ad_death_sound = "wizard/wdeath.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_wizard;
};