// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_fish.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
FISH FISH FISHY! (remade version by ijed)
==============================================================================*/

$frame attack1 attack2 attack3 attack4 attack5 attack6 attack7
$frame attack8 attack9 attack10 attack11 attack12 attack13 attack14
$frame attack15 attack16 attack17 attack18 

$frame death1 death2 death3 death4 death5 death6 death7 death8
$frame death9 death10 death11 death12 death13 death14 death15 death16
$frame death17 death18 death19 death20 death21 

$frame swim1 swim2 swim3 swim4 swim5 swim6 swim7 swim8 
$frame swim9 swim10 swim11 swim12 swim13 swim14 swim15 swim16
$frame swim17 swim18 

$frame pain1 pain2 pain3 pain4 pain5 pain6 pain7 pain8 pain9

// Duplicate set of animations for a smaller scaled down version
$frame attackS1 attackS2 attackS3 attackS4 attackS5 attackS6 attackS7
$frame attackS8 attackS9 attackS10 attackS11 attackS12 attackS13 attackS14
$frame attackS15 attackS16 attackS17 attackS18 

$frame deathS1 deathS2 deathS3 deathS4 deathS5 deathS6 deathS7 deathS8
$frame deathS9 deathS10 deathS11 deathS12 deathS13 deathS14 deathS15 deathS16
$frame deathS17 deathS18 deathS19 deathS20 deathS21 

$frame swimS1 swimS2 swimS3 swimS4 swimS5 swimS6 swimS7 swimS8 
$frame swimS9 swimS10 swimS11 swimS12 swimS13 swimS14 swimS15 swimS16
$frame swimS17 swimS18 

$frame painS1 painS2 painS3 painS4 painS5 painS6 painS7 painS8 painS9

float ad_FISH_STAND = 1;
float ad_FISH_WALK = 2;
float ad_FISH_RUN = 4;

//============================================================================
void() ad_f_swim = {
	// Do nothing if dead
	if (self.health < 1) return;
	
	self.nextthink = time + 0.1;
	if (self.ad_walkframe == 1) ad_monster_idle_sound();

	// Keep moving the animation frame forward
	if (self.state == ad_FISH_RUN) self.ad_walkframe = self.ad_walkframe + 2;
	else self.ad_walkframe = self.ad_walkframe + 1;
	// Setup small/large frames
	if (self.spawnflags & ad_MON_FISH_SMALL)
		self.frame = $swimS1 + self.ad_walkframe;
	else self.frame = $swim1 + self.ad_walkframe;
	// Loop around animation block
	if (self.ad_walkframe > 17) self.ad_walkframe = 0;

	if (self.state == ad_FISH_STAND) ad_ai_stand();
	else if (self.state == ad_FISH_WALK) ad_ai_walk(self.ad_move_state_y);
	else ad_ai_run(self.ad_move_state_z);
};

//----------------------------------------------------------------------
void() ad_f_stand1 = [ $swim1, ad_f_swim ] { ad_ai_stand();};
void() ad_f_standS1 = [ $swimS1, ad_f_swim ] { ad_ai_stand(); };

void() ad_f_stand = { 
	self.ad_walkframe = 0; self.state = ad_FISH_STAND; 
	if (self.spawnflags & ad_MON_FISH_SMALL) ad_f_standS1();
	else ad_f_stand1();
};
	
//----------------------------------------------------------------------
void() ad_f_walk1 = [ $swim1, ad_f_swim ] { ad_ai_walk(self.ad_move_state_y);};
void() ad_f_walkS1 = [ $swimS1, ad_f_swim ] { ad_ai_walk(self.ad_move_state_y);};

void() ad_f_walk = {
	self.ad_walkframe = 0; self.state = ad_FISH_WALK; 
	if (self.spawnflags & ad_MON_FISH_SMALL) ad_f_walkS1();
	else ad_f_walk1();
};

//----------------------------------------------------------------------
void() ad_f_run1 = [ $swim1, ad_f_swim ] { ad_ai_run(self.ad_move_state_z);};
void() ad_f_runS1 = [ $swimS1, ad_f_swim ] { ad_ai_run(self.ad_move_state_z);};

void() ad_f_run = {
	self.ad_walkframe = 0; self.state = ad_FISH_RUN; 
	if (self.spawnflags & ad_MON_FISH_SMALL) ad_f_runS1();
	else ad_f_run1();
};

//============================================================================
void() ad_fish_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;				// removed before stroke
	ad_ai_damagebreakable(5);					// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEEFISH,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)
		
	// Fish bites man! 1-6 Damage
	ad_ldmg = (random() + random() + random()) * 2;
	if (ad_ldmg < 1) ad_ldmg = 1;
	sound (self, ad_CHAN_VOICE, "fish/bite.wav", 1, ad_ATTN_NORM);
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	
	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Spawn some touch blood (no explicit direction)
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

//----------------------------------------------------------------------
void() ad_f_attack2 = {
	// Do nothing if dead
	if (self.health < 1) return;
	self.nextthink = time + 0.1;

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.spawnflags & ad_MON_FISH_SMALL)
		self.frame = $attackS1 + self.ad_walkframe;
	else self.frame = $attack1 + self.ad_walkframe;
	
	// Setup special frame attacks
	if (self.ad_walkframe > 17) self.think = self.ad_th_run;
	if (self.ad_walkframe == 2 || self.ad_walkframe == 8 || self.ad_walkframe == 14) 
		ad_fish_melee();
	else ad_ai_charge(self.ad_move_state_y);
};

//----------------------------------------------------------------------
void() ad_f_attack1 = [ $attack1, ad_f_attack2 ] {};
void() ad_f_attackS1 = [ $attackS1, ad_f_attack2 ] {};

void() ad_f_attack = {
	self.ad_walkframe = 0;
	ad_ai_charge(self.ad_move_state_y);
	if (self.spawnflags & ad_MON_FISH_SMALL) ad_f_attackS1();
	else ad_f_attack1();
};

//============================================================================
void() ad_f_pain2 = {
	self.nextthink = time + 0.1;
	
	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.spawnflags & ad_MON_FISH_SMALL)
		self.frame = $painS1 + self.ad_walkframe;
	else self.frame = $pain1 + self.ad_walkframe;
	
	if (self.ad_walkframe > 8) self.think = self.ad_th_run;
	if (self.ad_walkframe > 1) ad_ai_pain(self.ad_move_state_y/2);	
};

void() ad_f_pain1 = [ $pain1, ad_f_pain2 ] {};
void() ad_f_painS1 = [ $painS1, ad_f_pain2 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_fish_pain =
{
	if (self.health < 1) return;
	self.ad_walkframe = 0; 
	if (self.spawnflags & ad_MON_FISH_SMALL) ad_f_painS1();
	else ad_f_pain1();
};

//============================================================================
void() ad_f_deathend = { ad_monster_deadbody_check(); };

//----------------------------------------------------------------------
void() ad_f_death2 = {
	self.nextthink = time + 0.1;
	
	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.spawnflags & ad_MON_FISH_SMALL)
		self.frame = $deathS1 + self.ad_walkframe;
	else self.frame = $death1 + self.ad_walkframe;
	
	// Keep moving the animation frame forward
	if (self.ad_walkframe < 3) ad_monster_check_gib();
	if (self.ad_walkframe > 2) self.solid = ad_SOLID_NOT;
	if (self.ad_walkframe == 19) ad_monster_death_postcheck();
	if (self.ad_walkframe > 19) ad_f_deathend();
};

void() ad_f_death1 = [ $death1, ad_f_death2 ] {};
void() ad_f_deathS1 = [ $deathS1, ad_f_death2 ] {};

//----------------------------------------------------------------------
void() ad_fish_die =
{
	// If fish in water, reduce self gravity to pretend to slowly sink
	if (pointcontents(self.origin) == ad_CONTENT_WATER) self.gravity = 0.25;

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		self.ad_walkframe = 0;
		sound (self, ad_CHAN_VOICE, "fish/death.wav", 1, ad_ATTN_NORM);
		if (self.spawnflags & ad_MON_FISH_SMALL) ad_f_deathS1();
		else ad_f_death1();
	}
};

/*======================================================================
QUAKED monster_fish (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_monster_fish =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_fish.mdl";	// Using new model
	precache_model (self.mdl);

	self.ad_idle_sound = "fish/idle.wav";
	self.ad_sight_sound = self.ad_idle_sound;
	precache_sound (self.ad_idle_sound);

	precache_sound ("fish/death.wav");
	precache_sound ("fish/bite.wav");

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	self.ad_gibhealth = -10;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 1;				// Always in pain
	self.ad_steptype = ad_FS_FLYING;			// It has fins!?!
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '24 0 -8';		// Bite attack offset
	self.height = 0;					// reset enemytarget tracking
	if (!self.ad_exactskin) self.ad_randomskin = 4;
	self.ad_deathstring = " was fed to the Rotfish\n";

	// Check for water sightline wakeup
	if (self.spawnflags & ad_MON_LIQUIDBLOCK) self.ad_liquidblock = ad_TRUE;
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	// Tiny fish are easier to kill
	if (self.spawnflags & ad_MON_FISH_SMALL) {
		if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_FISHS;
		if (self.health < 1) self.health = ad_HP_MONFISH/2;
		// The small fish moving really fast looks odd
		// reverted speed and movement back to original
		//self.move_state = '0 12 16';
		self.ad_move_state = '0 8 12';
	}
	else {
		if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_FISH;
		if (self.health < 1) self.health = ad_HP_MONFISH;
		self.ad_move_state = '0 8 12';
	}
	
	self.ad_th_checkattack = ad_FishCheckAttack;
	self.ad_th_stand = ad_f_stand;
	self.ad_th_walk = ad_f_walk;
	self.ad_th_run = ad_f_run;
	self.ad_th_die = ad_fish_die;
	self.ad_th_pain = ad_fish_pain;
	self.ad_th_melee = ad_f_attack;
	
	self.ad_classtype = ad_CT_MONFISH;
	self.ad_classgroup = ad_CG_FISH;
	self.ad_classmove = ad_MON_MOVESWIM;
	
	ad_monster_start();
};

