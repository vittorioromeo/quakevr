// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/client_power.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
	CheckPowerups
	- Check for turning off powerups
======================================================================*/
float ad_PWR_FADING = 3;

//----------------------------------------------------------------------
void(entity ad_targ, float ad_powtimer) ad_ResetPowerInvRing =
{
	if (ad_powtimer == 0) {
		ad_targ.items = ad_targ.items - (ad_targ.items & ad_IT_INVISIBILITY);
		ad_targ.ad_invisible_finished = ad_targ.ad_invisible_time = 0;
		// Reset player model
		ad_targ.modelindex = ad_modelindex_player;
		ad_targ.frame = 0;
	}
	else if (ad_targ.items & ad_IT_INVISIBILITY) {
		// Stop powerup constantly being reset once below timer
		if (ad_targ.ad_invisible_finished > (time + ad_powtimer) ) {
			ad_targ.ad_invisible_finished = time + ad_powtimer;
			// Enable fading message
			ad_targ.ad_invisible_time = 1;
		}
	}
};

//----------------------------------------------------------------------
void(entity ad_targ, float ad_powtimer) ad_ResetPowerPent =
{
	if (ad_powtimer == 0) {
		ad_targ.items = ad_targ.items - (ad_targ.items & ad_IT_INVULNERABILITY);
		ad_targ.ad_invincible_finished = ad_targ.ad_invincible_time = 0;
	}
	else if (ad_targ.items & ad_IT_INVULNERABILITY) {
		// Stop powerup constantly being reset once below timer
		if (ad_targ.ad_invincible_finished > (time + ad_powtimer) ) {
			ad_targ.ad_invincible_finished = time + ad_powtimer;
			// Enable fading message
			ad_targ.ad_invincible_time = 1;
		}
	}
};

