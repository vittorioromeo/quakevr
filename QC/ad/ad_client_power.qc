//----------------------------------------------------------------------
void(entity ad_targ, float ad_powtimer) ad_ResetPowerQuad =
{
	if (ad_powtimer == 0) {
		ad_targ.super_damage_finished = ad_targ.super_time = 0;
	}
	else if (ad_targ.items & ad_IT_QUAD) {
		// Stop powerup constantly being reset once below timer
		if (ad_targ.super_damage_finished > (time + ad_powtimer) ) {
			ad_targ.super_damage_finished = time + ad_powtimer;
			// Enable fading message
			ad_targ.super_time = 1;
		}
	}
};
// Quad screen effect is shared by several items
void(entity ad_targ) ad_ResetPowerQuadItem = {
	ad_targ.items = ad_targ.items - (ad_targ.items & ad_IT_QUAD);
};

