		ad_targ.items = ad_targ.items - (ad_targ.items & ad_IT_SUIT);
		ad_targ.ad_radsuit_finished = ad_targ.ad_rad_time = 0;
	}
	else if (ad_targ.items & ad_IT_SUIT) {
		// Stop powerup constantly being reset once below timer
		if (ad_targ.ad_radsuit_finished > (time + ad_powtimer) ) {
			ad_targ.ad_radsuit_finished = time + ad_powtimer;
