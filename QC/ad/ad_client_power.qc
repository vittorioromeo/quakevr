//----------------------------------------------------------------------
void(entity ad_targ, float ad_powtimer, float ad_novania) ad_ResetPowerSystem =
{
	// This only works for player clients
	if (!(ad_targ.flags & ad_FL_CLIENT)) return;
	
	ad_targ.effects = 0;
	ad_ResetPowerInvRing(ad_targ, ad_powtimer);
	ad_ResetPowerPent(ad_targ, ad_powtimer);
	ad_ResetPowerEnvSuit(ad_targ, ad_powtimer);
	ad_ResetPowerQuad(ad_targ, ad_powtimer);
	ad_ResetPowerSharp(ad_targ, ad_powtimer);
	ad_ResetPowerPiercer(ad_targ, ad_powtimer);
	// Don't reset Vania items
	if (ad_novania) {
		ad_ResetPowerLavaShield(ad_targ, ad_powtimer);
		ad_ResetPowerAirTank(ad_targ, ad_powtimer);
		ad_ResetPowerBlastbelt(ad_targ, ad_powtimer);
		ad_ResetPowerJumpBoots(ad_targ, ad_powtimer);
	}
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_PlayLavaShieldSound =
{
	// Only works for the player
	if (!(ad_targ.flags & ad_FL_CLIENT)) return;
	
	// Can still drown from liquid damage!?!
	ad_targ.ad_air_finished = time + ad_WATER_AIR;
	// Time for another sound reminder?
	if (ad_targ.ad_lavashield_sound < time) {
		if (ad_targ.ad_lavashield_volume > 0) {
			ad_targ.volume = (0.5 + random() * 0.5) * ad_targ.ad_lavashield_volume;
			// Make sure volume is within range (will get errors)
			if (ad_targ.volume > 1) ad_targ.volume = 1;
			sound (ad_targ, ad_CHAN_ITEM, ad_SOUND_ARTLSHIELD3, ad_targ.volume, ad_ATTN_NORM);
		}
		ad_targ.ad_lavashield_sound = time + 2;
	}
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_PlayBlastBeltSound =
{
	// Only works for the player
	if (!(ad_targ.flags & ad_FL_CLIENT)) return;
	
	// Time for another sound reminder?
	if (ad_targ.ad_blastbelt_sound < time) {
		if (ad_targ.ad_blastbelt_volume > 0) {
			ad_targ.volume = (0.5 + random() * 0.5) * ad_targ.ad_blastbelt_volume;
			// Make sure volume is within range (will get errors)
			if (ad_targ.volume > 1) ad_targ.volume = 1;
			sound (ad_targ, ad_CHAN_ITEM, ad_SOUND_ARTBLASTBELT3, ad_targ.volume, ad_ATTN_NORM);
		}
		ad_targ.ad_blastbelt_sound = time + 2;
	}
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_PlayPentagramSound =
{
	// Only works for the player
	if (!(ad_targ.flags & ad_FL_CLIENT)) return;
	
	// Time for another sound reminder?
	if (ad_targ.ad_invincible_sound < time) {
		sound (ad_targ, ad_CHAN_ITEM, ad_SOUND_ARTPENT3, 1, ad_ATTN_NORM);
		ad_targ.ad_invincible_sound = time + 2;
	}
};

//============================================================================
void() ad_ClientPowerups =
{
	// Exceptions: Dead, intermission or cinematic cameras
	if (self.health < 1) return;
	if (ad_intermission_running > 0) return;
	if (ad_cinematic_running > 0) return;

	//----------------------------------------------------------------------
	// Invisibility (Gold Ring)
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.ad_invisible_finished > 0) {
		// sound and screen flash when items starts to run out
		if (self.ad_invisible_sound < time) {
			sound (self, ad_CHAN_AUTO, ad_SOUND_ARTINV3, 0.5, ad_ATTN_IDLE);
			self.ad_invisible_sound = time + ((random() * 3) + 1);
		}

		if (self.ad_invisible_finished < time + ad_PWR_FADING) {
			// First part of 3s cooldown
			if (self.ad_invisible_time == 1) {
				sprint (self, "Ring of Shadows magic is fading\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTINV2, 1, ad_ATTN_NORM);
				self.ad_invisible_time = time + 1;
			}
			// 2md/3rd part of cooldown
			if (self.ad_invisible_time < time) {
				self.ad_invisible_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		// Update inventory and timers
		if (self.ad_invisible_finished < time) ad_ResetPowerInvRing(self,0);
		else {
			// keep using the eyes
			self.modelindex = ad_modelindex_eyes;
			self.frame = 0;
		}
	}

	//----------------------------------------------------------------------
	// Env Suit	
	// - Flash screen 3s before running out
	// - Give player 12s of air after suit finishes
	//----------------------------------------------------------------------
	if (self.ad_radsuit_finished > 0) {
		self.ad_air_finished = time + ad_WATER_AIR;	// don't drown

	// sound and screen flash when items starts to run out
		if (self.ad_radsuit_finished < time + ad_PWR_FADING) {
			if (self.ad_rad_time == 1) {
				sprint (self, "Air supply in Biosuit expiring!\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTSUIT2, 1, ad_ATTN_NORM);
				self.ad_rad_time = time + 1;
			}
			if (self.ad_rad_time < time) {
				self.ad_rad_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		// Update inventory and timers
		if (self.ad_radsuit_finished < time) ad_ResetPowerEnvSuit(self,0);
	}
	
	//----------------------------------------------------------------------
	// Invincibility (Pentagram)
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.ad_invincible_finished > 0) {
	// sound and screen flash when items starts to run out
		if (self.ad_invincible_finished < time + ad_PWR_FADING) {
			if (self.ad_invincible_time == 1) {
				sprint (self, "Protection is almost burned out!\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTPENT2, 1, ad_ATTN_NORM);
				self.ad_invincible_time = time + 1;
			}
			if (self.ad_invincible_time < time) {
				self.ad_invincible_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}	
		// Update inventory and timers
		if (self.ad_invincible_finished < time) ad_ResetPowerPent(self,0);
	}

	//----------------------------------------------------------------------
	// Super Damage (Quad)
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.super_damage_finished > 0) {
		// sound and screen flash when items starts to run out
		if (self.super_damage_finished < time + ad_PWR_FADING) {
			if (self.super_time == 1) {
				sprint (self, "Quad Damage is wearing off!\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTQUAD2, 1, ad_ATTN_NORM);
				self.super_time = time + 1;
			}	  
			if (self.super_time < time) {
				self.super_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		// Update inventory and timers
		if (self.super_damage_finished < time) ad_ResetPowerQuad(self,0);
	}	

	//----------------------------------------------------------------------
	// Lava Shield (Aegis of Chthon)
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.ad_lavashield_finished > 0) {
	// sound and screen flash when items starts to run out
		if (self.ad_lavashield_finished < time + ad_PWR_FADING) {
			if (self.ad_lavashield_time == 1) {
				sprint (self, "Aegis is falling apart!\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTLSHIELD2, 1, ad_ATTN_NORM);
				self.ad_lavashield_time = time + 1;
			}
			if (self.ad_lavashield_time < time) {
				self.ad_lavashield_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}	
		// Update inventory and timers
		if (self.ad_lavashield_finished < time) ad_ResetPowerLavaShield(self,0);
	}

	//----------------------------------------------------------------------
	// Air Tank	
	// - Flash screen 3s before running out
	// - Give player 12s of air after suit finishes
	//----------------------------------------------------------------------
	if (self.ad_airtank_finished > 0 || self.ad_airtank_finished == -1) {
		self.ad_air_finished = time + 12;		// don't drown

		// Produce particle bubbles
		if (self.waterlevel == 3) {
			if (self.ad_airtank_bubbles < time) {
				self.ad_airtank_bubbles = time + 0.5 + random();
				ad_particle_debuff(self.origin, 16, rint(10+random()*40), ad_PARTICLE_BURST_BLUE);
			}
		}
		
		// Check to see if the water level has changed
		if (self.ad_airtank_level != self.waterlevel) {
			// Is the player coming out of the water?
			if (self.ad_airtank_level > 2 && self.waterlevel < 3)
				self.ad_airtank_sound = 0;
			// Is the player going into the water? (above head)
			else if (self.ad_airtank_level < 3 && self.waterlevel > 2)
				self.ad_airtank_sound = 0;
			self.ad_airtank_level = self.waterlevel;
		}		
		
		// Play active sound based on water level
		// Check for silent sound option (1.7 Patch 2)
		if (self.ad_airtank_sound < time && self.ad_airtank_silent == ad_FALSE) {
			if (self.waterlevel == 3) {
				// Under water sound with bubbbles
				if (self.ad_airtank_volume > 0) {
					self.volume = (0.5 + random() * 0.5) * self.ad_airtank_volume;
					// Make sure volume is within range (will get errors)
					if (self.volume > 1) self.volume = 1;
					// Play underwater sound (breathing + bubbles)
					sound (self, ad_CHAN_ITEM, ad_SOUND_ARTAIRTANK3, self.volume, ad_ATTN_IDLE);
				}
				self.ad_airtank_sound = time + 4;
			}
			else {
				if (!self.ad_airtank_outwater) {
					// Different sound when not in the water (faster)
					if (self.ad_airtank_volume > 0) {
						self.volume = (0.3 + random() * 0.3) * self.ad_airtank_volume;
						// Make sure volume is within range (will get errors)
						if (self.volume > 1) self.volume = 1;
						// Play out of water sound (heavy breathing)
						sound (self, ad_CHAN_ITEM, ad_SOUND_ARTAIRTANK3B, self.volume, ad_ATTN_IDLE);
					}
					self.ad_airtank_sound = time + 3 + random();
				}
			}
		}
		
		// Don't check expiration if infinite
		if (self.ad_airtank_finished > -1) {
			// sound and screen flash when items starts to run out
			if (self.ad_airtank_finished < time + ad_PWR_FADING) {
				self.ad_airtank_sound = time + 4;	// Stop breathing sound
				self.ad_airtank_silent = ad_FALSE;	// Reset sound suppression
				if (self.ad_airtank_time == 1) {
					sprint (self, "Air supply in Tanks is expiring\n");
					stuffcmd (self, "bf\n");
					sound (self, ad_CHAN_AUTO, ad_SOUND_ARTAIRTANK2, 1, ad_ATTN_NORM);
					self.ad_airtank_time = time + 1;
				}
				if (self.ad_airtank_time < time) {
					self.ad_airtank_time = time + 1;
					stuffcmd (self, "bf\n");
				}
			}
			// Update inventory and timers
			if (self.ad_airtank_finished < time) ad_ResetPowerAirTank(self,0);
		}
	}
	
	//----------------------------------------------------------------------
	// Blast Belt - Splash Damage Immunity
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.ad_blastbelt_finished > 0) {
	// sound and screen flash when items starts to run out
		if (self.ad_blastbelt_finished < time + ad_PWR_FADING) {
			if (self.ad_blastbelt_time == 1) {
				sprint (self, "Blast belt is failing\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTBLASTBELT2, 1, ad_ATTN_NORM);
				self.ad_blastbelt_time = time + 1;
			}
			if (self.ad_blastbelt_time < time) {
				self.ad_blastbelt_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}	
		// Update inventory and timers
		if (self.ad_blastbelt_finished < time) ad_ResetPowerBlastbelt(self,0);
	}

	//----------------------------------------------------------------------
	// Jump Boots - Vertical Height Exploration
	//----------------------------------------------------------------------
	if (self.ad_jumpboots_finished > 0) {
		// sound and screen flash when items starts to run out
		if (self.ad_jumpboots_finished < time + ad_PWR_FADING) {
			if (self.ad_jumpboots_time == 1) {
				sprint (self, "Jump Boots are wearing off\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTJUMPBOOTS2, 1, ad_ATTN_NORM);
				self.ad_jumpboots_time = time + 1;
			}	  
			if (self.ad_jumpboots_time < time) {
				self.ad_jumpboots_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		// Update inventory and timers
		if (self.ad_jumpboots_finished < time) ad_ResetPowerJumpBoots(self,0);
	}
	
	//----------------------------------------------------------------------
	// SharpShooter
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.ad_sharpshoot_finished > 0) {
	// sound and screen flash when items starts to run out
		if (self.ad_sharpshoot_finished < time + ad_PWR_FADING) {
			if (self.ad_sharpshoot_time == 1) {
				sprint (self, "Sharpshooter has almost gone\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTSHARP2, 1, ad_ATTN_NORM);
				self.ad_sharpshoot_time = time + 1;
			}
			if (self.ad_sharpshoot_time < time) {
				self.ad_sharpshoot_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}	
		// Update inventory and timers
		if (self.ad_sharpshoot_finished < time) ad_ResetPowerSharp(self,0);
	}

	//----------------------------------------------------------------------
	// Nail Piercer
	// - Flash screen 3s before running out
	//----------------------------------------------------------------------
	if (self.ad_nailpiercer_finished > 0) {
		// sound and screen flash when items starts to run out
		if (self.ad_nailpiercer_finished < time + ad_PWR_FADING) {
			if (self.ad_nailpiercer_time == 1) {
				sprint (self, "Nail Piercer is wearing off\n");
				stuffcmd (self, "bf\n");
				sound (self, ad_CHAN_AUTO, ad_SOUND_ARTNAILP2, 1, ad_ATTN_NORM);
				self.ad_nailpiercer_time = time + 1;
			}	  
			if (self.ad_nailpiercer_time < time) {
				self.ad_nailpiercer_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		// Update inventory and timers
		if (self.ad_nailpiercer_finished < time) ad_ResetPowerPiercer(self,0);
	}	

	//------------------------------------------------------------------
	// Only remove the quad effect (status bar update)
	// if all extra mod artifacts have expired as well
	//------------------------------------------------------------------
	if (self.super_damage_finished == 0 && self.ad_sharpshoot_finished == 0 
		&& self.ad_nailpiercer_finished == 0)
		ad_ResetPowerQuadItem(self);

	//------------------------------------------------------------------
	// This check for setting the client effect needs to be separate 
	// because its setup by several different artifacts!
	//------------------------------------------------------------------
	if (self.super_damage_finished > 0 || self.ad_invincible_finished > 0 ||
		self.ad_sharpshoot_finished > 0 || self.ad_nailpiercer_finished > 0) {
		self.effects = self.effects | ad_EF_DIMLIGHT;
	}
	else self.effects = self.effects - (self.effects & ad_EF_DIMLIGHT);
};

