{
	// Store family ranges in a vector
	local vector ad_randomrange;
	self.ad_randomindex = 12;
	ad_randomrange = '30 60 70';
	ad_rnd_prevnumber(ad_randomrange,self.ad_randomindex);
	// Backup bounding box is ogre/shambler size
	self.ad_idmins = ad_VEC_HULL2_MIN;
	self.ad_idmaxs = ad_VEC_HULL2_MAX;
	// PICK MONSTER ------------------------------------------------
	if (self.ad_randomized < ad_randomrange_x) {
		self.classname = "monster_boglord";
		self.ad_th_randfunc = ad_monster_boglord;
		// Default (1200) too high for shambler
		if (self.health <= 1) self.health = 900;
	}
	else if (self.ad_randomized < ad_randomrange_y) {
		self.classname = "monster_justice";
		self.ad_th_randfunc = ad_monster_justice;
		self.ad_exactskin = floor(random()*2);
	}
	else if (self.ad_randomized < ad_randomrange_z) {
		self.classname = "monster_nour";
		self.ad_th_randfunc = ad_monster_nour;
		// Default (1200) too high for shambler
		if (self.health <= 1) self.health = 800;
		// Aggressive spit attack
		self.ad_attack_chance = 0.7;
	}
	else {
		self.classname = "monster_shambler";
		self.ad_th_randfunc = ad_monster_shambler;
		if (self.ad_randompoison < ad_RND_LOW)
			self.ad_attack_sniper = ad_TRUE;
	}
};

//==================================================================
// BOUNDING BOX spawning system
//------------------------------------------------------------------
void() ad_rnd_bboxspawns =
{
	// Humanoid Scale bounding box
	//------------------------------------------------------------------
	if (self.classname == "monster_enforcer") {
		self.ad_randombbox = ad_RND_BBOX1;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONENFORCER);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_zombie") {
		self.ad_randombbox = ad_RND_BBOX1;
		// Can't do much with crucified zombies!
		if (self.spawnflags & ad_MON_ZOMCRUCIFIED) return ad_FALSE;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONZOMBIE);
		ad_rnd_resetzombieflags();
	}
	else if (self.classname == "monster_tarbaby") {
		self.ad_randombbox = ad_RND_BBOX1;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONTARBABY);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_knight") {
		self.ad_randombbox = ad_RND_BBOX1;
		// Can't do much with stone knights!
		if (self.spawnflags & ad_MON_STATUE) return ad_FALSE;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONKNIGHT);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_hell_knight") {
		self.ad_randombbox = ad_RND_BBOX1;
		// Can't do much with stone knights!
		if (self.spawnflags & ad_MON_STATUE) return ad_FALSE;
		// Don't touch pointy knights!
		if (self.spawnflags & ad_MON_POINT_KNIGHT) return ad_FALSE;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONHELLK);
		ad_rnd_resetspawnflags();
	}
	// Medium/Large monsters with giant bounding boxes
	//------------------------------------------------------------------
	else if (self.classname == "monster_dog") {
		self.ad_randombbox = ad_RND_BBOX2;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONDOG);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_ogre") {
		self.ad_randombbox = ad_RND_BBOX2;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONOGRE);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_demon1") {
		self.ad_randombbox = ad_RND_BBOX2;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONDEMON1);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_shalrath") {
		self.ad_randombbox = ad_RND_BBOX2;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONSHALRATH);
		ad_rnd_resetspawnflags();
	}
	else if (self.classname == "monster_shambler") {
		self.ad_randombbox = ad_RND_BBOX2;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONSHAMBLER);
		ad_rnd_resetspawnflags();
	}
	// Flying monster(s)
	//------------------------------------------------------------------
	else if (self.classname == "monster_wizard") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONWIZARD);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_wizardfamily();
	}
	// Swimming monster(s)
	//------------------------------------------------------------------
	else if (self.classname == "monster_fish") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONFISH);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_fishfamily();
	}
	// Most starting maps in episodes are full of army grunts
	// Only randomize them within their family group (easier start)
	//------------------------------------------------------------------
	else if (self.classname == "monster_army") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONARMY);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_armyfamily();
	}
	//------------------------------------------------------------------
	// ID1 essentially had 2 bounding box sizes
	// Monsters MINS-------  MAXS---- HULL
	// Army     -16 -16 -24, 16 16 40  1
	// Zombie   -16 -16 -24, 16 16 40  1
	// Knight   -16 -16 -24, 16 16 40  1
	// Enforcer -16 -16 -24, 16 16 40  1
	// Tarbaby  -16 -16 -24, 16 16 40  1
	// H Knight -16 -16 -24, 16 16 40  1
	// Dog      -32 -32 -24, 32 32 40   2
	// Ogre     -32 -32 -24, 32 32 64   2
	// Demon1   -32 -32 -24, 32 32 64   2
	// Shalrath -32 -32 -24, 32 32 64   2
	// Shambler -32 -32 -24, 32 32 64   2
	// Fish     -16 -16 -24, 16 16 24  *SWIM*
	// Wizard   -16 -16 -24, 16 16 40  *FLY*

	// Size 1 = -16 -16 -24, 16 16 40
	//------------------------------------------------------------------
	if (self.ad_randombbox == ad_RND_BBOX1) {
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);

		// 10=Army 20=Enforcer 15=Zombie 20=Tarbaby 20=Knight 15=HKnight
		// 0-10    10-30       30-45     45-65      65-85     85-100
		if (self.ad_randomupg < 10) ad_rnd_armyfamily();
		else if (self.ad_randomupg < 30) ad_rnd_enforcerfamily();
		else if (self.ad_randomupg < 45) ad_rnd_zombiefamily();
		else if (self.ad_randomupg < 65) ad_rnd_tarbabyfamily();
		else if (self.ad_randomupg < 85) ad_rnd_knightfamily();
		else ad_rnd_hknightfamily();
	}
	// Size 2 = -32 -32 -24, 32 32 64
	//------------------------------------------------------------------
	else if (self.ad_randombbox == ad_RND_BBOX2) {
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);

		// 20=Dog 20=Ogre 20=Demon1 15=Shalrath 15=Shambler
		// 0-20   20-40   40-60     70-85       85-100
		if (self.ad_randomupg < 20) ad_rnd_dogfamily();
		else if (self.ad_randomupg < 40) ad_rnd_ogrefamily();
		else if (self.ad_randomupg < 70) ad_rnd_demonfamily();
		else if (self.ad_randomupg < 85) ad_rnd_shalrathfamily();
		else ad_rnd_shamblerfamily();
	}
	// Show console info
	ad_rnd_displaydebug();
};

//==================================================================
// FAMILY spawning system
//------------------------------------------------------------------
void() ad_rnd_familyspawns =
{
	if (self.classname == "monster_dog") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONDOG);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_dogfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_fish") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONFISH);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_fishfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_army") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONARMY);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_armyfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_zombie") {
		// Can't do much with crucified zombies!
		if (self.spawnflags & ad_MON_ZOMCRUCIFIED) return ad_FALSE;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONZOMBIE);
		ad_rnd_resetzombieflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_zombiefamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_knight") {
		// Can't do much with stone knights!
		if (self.spawnflags & ad_MON_STATUE) return ad_FALSE;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONKNIGHT);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_knightfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_enforcer") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONENFORCER);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_enforcerfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_wizard") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONWIZARD);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_wizardfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_tarbaby") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONTARBABY);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_tarbabyfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_ogre") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONOGRE);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_ogrefamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_hell_knight") {
		// Can't do much with stone knights!
		if (self.spawnflags & ad_MON_STATUE) return ad_FALSE;
		// Don't touch pointy knights!
		if (self.spawnflags & ad_MON_POINT_KNIGHT) return ad_FALSE;
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONHELLK);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_hknightfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_demon1") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONDEMON1);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_demonfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_shalrath") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONSHALRATH);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_shalrathfamily();
	}
	//------------------------------------------------------------------
	else if (self.classname == "monster_shambler") {
		// Reset HP and spawnflags
		ad_rnd_resethealth(ad_HP_MONSHAMBLER);
		ad_rnd_resetspawnflags();
		ad_rnd_generateseeds(ad_RND_SEEDMONSTER);
		ad_rnd_shamblerfamily();
	}
	// Show console info
	ad_rnd_displaydebug();
};

//=====================================================================
// IMPORTANT - This function is called only when monsters gib
// Check for shadow axe fragments
// Called from ai_gibs.qc / monster_check_gib
//----------------------------------------------------------------------
void() ad_monster_gibrandomizer =
{
	local float ad_wpnupg;
	// Check for randomizer system
	if (ad_check_randflags() == ad_FALSE) return;
	if (!(self.ad_activate.flags & ad_FL_CLIENT)) return;
	// Got the Shadow Axe already?
	if (self.ad_activate.ad_moditems & ad_IT_UPGRADE_AXE) return;
	
	// Update counter on player (every client has own counter)
	self.ad_activate.ad_randomgibs = self.ad_activate.ad_randomgibs + 1;

	// Default shotgun fragments (5=Easy, 9=Normal, 13=Hard+)
	ad_wpnupg = ad_rnd_upgwpnmax_shadowaxe();		
	// Still collecting?
	if (self.ad_activate.ad_randomgibs < ad_wpnupg)
		sprint(self.ad_activate, "You found an Axe Fragment\n");
	// Finally got to the magic amount!
	else if (self.ad_activate.ad_randomgibs == ad_wpnupg) {
		self.ad_activate.items = self.ad_activate.items | ad_IT_AXE;
		self.ad_activate.ad_moditems = self.ad_activate.ad_moditems | ad_IT_UPGRADE_AXE;
		ad_rnd_playsurprise(self.ad_activate, ad_RND_SURPRISEPOS);
		ad_centerprint(self.ad_activate,"You got the Shadow Axe!!!\n");
		stuffcmd (self.ad_activate, "bf\n");
		self.ad_activate.weapon = ad_IT_AXE;
		ad_W_SetCurrentAmmo(self.ad_activate);
	}
};

//=====================================================================
// IMPORTANT - This function is called only on item pickup
// Check for weapon fragments (shotgun/plasma)
// Called from items.qc / ammo_touch
//----------------------------------------------------------------------
void() ad_ammo_touchrandomizer =
{
	local float ad_wpnupg;
	// Check for randomizer system
	if (ad_check_randflags() == ad_FALSE) return;
	// Check for player
	if (!(other.flags & ad_FL_CLIENT)) return;
	// Check for large ammo box
	if (!(self.spawnflags & ad_A_LARGE)) return;

	// Check for shells for Widowmaker
	if (self.ad_classtype == ad_CT_AMMOSHELLS) {
		// Got the Widowmaker already?
		if (other.ad_moditems & ad_IT_UPGRADE_SSG) return;
		other.ad_randomshells = other.ad_randomshells + 1;
		
		// Default shotgun fragments (3=Easy, 4=Normal, 5=Hard+)
		ad_wpnupg = ad_rnd_upgwpnmax_widowmaker();		
		// Still collecting?
		if (other.ad_randomshells < ad_wpnupg)
			sprint(other, "You found a Shotgun Fragment\n");
		// Finally got to the magic amount!
		else if (other.ad_randomshells == ad_wpnupg) {
			other.items = other.items | ad_IT_SUPER_SHOTGUN;
			other.ad_moditems = other.ad_moditems | ad_IT_UPGRADE_SSG;
			ad_rnd_playsurprise(other, ad_RND_SURPRISEPOS);
			ad_centerprint(other,"You got the Widowmaker Shotgun!!!\n");
			stuffcmd (other, "bf\n");
			other.weapon = ad_IT_SUPER_SHOTGUN;
			ad_W_SetCurrentAmmo(other);
		}
	}
	else if (self.ad_classtype == ad_CT_AMMOCELLS) {
		// Got the Plasma Gun already?
		if (other.ad_moditems & ad_IT_UPGRADE_LG) return;
		other.ad_randomcells = other.ad_randomcells + 1;

		// Default cell fragments (1=Easy, 2=Normal, 3=Hard+)
		ad_wpnupg = ad_rnd_upgwpnmax_plasmagun();
		// Still collecting?
		if (other.ad_randomcells < ad_wpnupg)
			sprint(other, "You found a Plasma Fragment\n");
		// Finally got to the magic amount!
		else if (other.ad_randomcells == ad_wpnupg) {
			other.items = other.items | ad_IT_LIGHTNING;
			other.ad_moditems = other.ad_moditems | ad_IT_UPGRADE_LG;
			ad_rnd_playsurprise(other, ad_RND_SURPRISEPOS);
			ad_centerprint(other,"You got the Plasma Gun!!!\n");
			stuffcmd (other, "bf\n");
			other.weapon = ad_IT_LIGHTNING;
			ad_W_SetCurrentAmmo(other);
		}
	}
};

//=====================================================================
// IMPORTANT - This function is called only on item pickup
// Check for positive/negative buff Megahealth
// Called from items.qc / health_touch
//----------------------------------------------------------------------
void() ad_health_touchrandomizer =
{
	// Check for randomizer system
	if (ad_check_randflags() == ad_FALSE) return;
	// Check for player
	if (!(other.flags & ad_FL_CLIENT)) return;
	
	if (self.ad_classtype == ad_CT_HEALMEGA) {
		self.ad_randomized = random();
		// Check for <33=negative and >66=positive
		if (self.ad_randomized < ad_RND_NEGATIVE) {
			sprint (other, "You got a mouldy MegaHealth!\n");
			// Default is 1 per second
			self.ad_rotting_qty = 5;
			ad_rnd_playsurprise(other, ad_RND_SURPRISENEG);
		}
		else if (self.ad_randomized > ad_RND_POSITIVE) {
			other.ad_rad_time = 1;
			other.ad_radsuit_finished = time + ad_POWERUP_TIMER;
			other.items = other.items | ad_IT_SUIT;
			sprint (other, "You got the Environment Suit\n");
			stuffcmd (other, "bf\n");
			ad_centerprint(other,"You also found the Environment Suit!\n");
			ad_rnd_playsurprise(other, ad_RND_SURPRISEPOS);
		}
	}
};

