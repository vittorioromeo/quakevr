//------------------------------------------------------------------
void() ad_rnd_zombiefamily =
{
	// Store family ranges in a vector
	local vector ad_randomrange;
	self.ad_randomindex = 3;
	ad_randomrange = '10 40 70';
	ad_rnd_prevnumber(ad_randomrange,self.ad_randomindex);
	// PICK MONSTER ------------------------------------------------
	if (self.ad_randomized < ad_randomrange_x) {
		self.classname = "monster_tarbaby";
		self.ad_th_randfunc = ad_monster_tarbaby;
		self.spawnflags = self.spawnflags | ad_MON_TARBYLESSJUMP;
		self.ad_poisonous = ad_TRUE;
		self.ad_exactskin = floor(2+(random()*4));
	}
	else if (self.ad_randomized < ad_randomrange_y) {
		self.classname = "monster_boil";
		self.ad_th_randfunc = ad_monster_boil;
	}
	else if (self.ad_randomized < ad_randomrange_z) {
		self.classname = "monster_zombiek";
		self.ad_th_randfunc = ad_monster_zombiek;
		ad_rnd_addpoison(ad_FALSE);
	}
	else {
		if (self.ad_randompoison < ad_RND_MIDDLE) {
			self.classname = "monster_zombie";
			self.ad_th_randfunc = ad_monster_zombie;
			ad_rnd_resetzombieflags();
		}
		else {
			self.classname = "monster_mummy";
			self.ad_th_randfunc = ad_monster_mummy;
		}
	}
};

//------------------------------------------------------------------
void() ad_rnd_knightfamily =
{
	// Store family ranges in a vector
	local vector ad_randomrange;
	self.ad_randomindex = 4;
	ad_randomrange = '10 40 70';
	ad_rnd_prevnumber(ad_randomrange,self.ad_randomindex);
	// PICK MONSTER ------------------------------------------------
	if (self.ad_randomized < ad_randomrange_x) {
		self.classname = "monster_death_guard";
		self.ad_th_randfunc = ad_monster_death_guard;
	}
	else if (self.ad_randomized < ad_randomrange_y) {
		self.classname = "monster_dcrossbow";
		self.ad_th_randfunc = ad_monster_dcrossbow;
		if (self.ad_randomupg < ad_RND_LOW)
			self.spawnflags = self.spawnflags | ad_MON_DCROSSSNIPER;
		ad_rnd_addpoison(ad_FALSE);
	}
	else if (self.ad_randomized < ad_randomrange_z) {
		self.classname = "monster_dguard";
		self.ad_th_randfunc = ad_monster_dguard;
		ad_rnd_addpoison(ad_FALSE);
	}
	else {
		self.classname = "monster_knight";
		self.ad_th_randfunc = ad_monster_knight;
		// Make sure no trigger events on statue knights
		if (self.ad_randompoison < ad_RND_LOW) {
			// make sure spawnflags are reset
			ad_rnd_resetspawnflags();
			// Make sure the knight is NOT frozen, just stone skin
			self.spawnflags = self.spawnflags | ad_MON_STATUE | ad_MON_NOTFROZEN;
		}
		else {
			ad_rnd_addpoison(ad_FALSE);
			// If not poisonous, randomize skin
			if (!self.ad_poisonous) self.ad_exactskin = -1;
		}
	}
};

