//=====================================================================
// IMPORTANT - This function is called only on item pickup
// Check for positive buff on artifacts (no negative)
// Pent=+lava shield, Quad=+blast belt, EnvSuit=+jump boots
// Called from items.qc / artifact_touch
//----------------------------------------------------------------------
void() ad_artifact_touchrandomizer =
{
	// Check for randomizer system
	if (ad_check_randflags() == ad_FALSE) return;
	// Check for player
	if (!(other.flags & ad_FL_CLIENT)) return;
	
	if (self.ad_classtype == ad_CT_ARTPENT) {
		self.ad_randomized = random();
		// Check for >66=positive only
		if (self.ad_randomized > ad_RND_POSITIVE) {
			other.ad_lavashield_time = 1;
			other.ad_lavashield_volume = 1;
			// Got to match original powerup on time
			other.ad_lavashield_finished = time + self.cnt;
			other.ad_moditems = other.ad_moditems | ad_IT_ARTLAVASHIELD;
			sprint (other, "You got the Aegis of Chthon\n");
			stuffcmd (other, "bf\n");
			ad_centerprint(other,"You also found Aegis of Chthon!\n");
			ad_rnd_playsurprise(other, ad_RND_SURPRISEPOS);
		}
	}
	else if (self.ad_classtype == ad_CT_ARTQUAD) {
		self.ad_randomized = random();
		// Check for >66=positive only
		if (self.ad_randomized > ad_RND_POSITIVE) {
			other.ad_blastbelt_time = 1;
			other.ad_blastbelt_volume = 1;
			// Got to match original powerup on time
			other.ad_blastbelt_finished = time + self.cnt;
			other.ad_moditems = other.ad_moditems | ad_IT_ARTBLASTBELT;
			sprint (other, "You got the Blast Belt\n");
			stuffcmd (other, "bf\n");
			ad_centerprint(other,"You also found the Blast Belt!\n");
			ad_rnd_playsurprise(other, ad_RND_SURPRISEPOS);
		}
	}
	else if (self.ad_classtype == ad_CT_ARTSUIT) {
		self.ad_randomized = random();
		// Check for >66=positive only
		if (self.ad_randomized > ad_RND_POSITIVE) {
			other.ad_jumpboots_time = 1;
			other.ad_jumpboots_airlvl = 0;
			other.ad_jumpboots_airmax = 1;
			other.ad_jumpboots_height = ad_ART_JUMPHEIGHT;
			other.ad_jumpboots_forward = 0;
			// Got to match original powerup on time
			other.ad_jumpboots_finished = time + self.cnt;
			other.ad_moditems = other.ad_moditems | ad_IT_ARTJUMPBOOTS;
			sprint (other, "You got the Jump Boots\n");
			stuffcmd (other, "bf\n");
			ad_centerprint(other,"You also found the Jump Boots!\n");
			ad_rnd_playsurprise(other, ad_RND_SURPRISEPOS);
		}
	}
};

//=====================================================================
// All randomizer functions (minimal checks)
//----------------------------------------------------------------------
float() ad_rnd_upgwpnmax_shadowaxe =
{
	local float ad_ret_val;
	// Default Shadow Axe fragments (5=Easy, 9=Normal, 13=Hard+)
	if (ad_skill == ad_SKILL_EASY) ad_ret_val = ad_RND_FRAGAXE;
	else if (ad_skill == ad_SKILL_NORMAL) ad_ret_val = ad_RND_FRAGAXE+4;
	else ad_ret_val = ad_RND_FRAGAXE+8;
	// Make sure final amount is not negative or zero
	if (ad_ret_val < 1) ad_ret_val = 1;
	return ad_ret_val;
};

//----------------------------------------------------------------------
float() ad_rnd_upgwpnmax_widowmaker =
{
	local float ad_ret_val;
	// Default WidowMaker fragments (3=Easy, 4=Normal, 5=Hard+)
	if (ad_skill == ad_SKILL_EASY) ad_ret_val = ad_RND_FRAGSHELL;
	else if (ad_skill == ad_SKILL_NORMAL) ad_ret_val = ad_RND_FRAGSHELL+1;
	else ad_ret_val = ad_RND_FRAGSHELL+2;
	// Make sure final amount is not negative or zero
	if (ad_ret_val < 1) ad_ret_val = 1;
	return ad_ret_val;
};

//----------------------------------------------------------------------
float() ad_rnd_upgwpnmax_plasmagun =
{
	local float ad_ret_val;
	// Default PlasmaGun fragments (1=Easy, 2=Normal, 3=Hard+)
	if (ad_skill == ad_SKILL_EASY) ad_ret_val = ad_RND_FRAGCELL;
	else if (ad_skill == ad_SKILL_NORMAL) ad_ret_val = ad_RND_FRAGCELL+1;
	else ad_ret_val = ad_RND_FRAGCELL+2;
	// Make sure final amount is not negative or zero
	if (ad_ret_val < 1) ad_ret_val = 1;
	return ad_ret_val;
};

//----------------------------------------------------------------------
void() ad_rnd_displaydebug = 
{
	dprint("\bRnd\b "); 
	ad_lftos(self,self.ad_randomized,2,0,ad_BUFFER_DPRINT);
	dprint(" \bU\b "); 
	ad_lftos(self,self.ad_randomupg,2,0,ad_BUFFER_DPRINT);
	dprint(" \bP\b "); 
	ad_lftos(self,self.ad_randompoison,2,0,ad_BUFFER_DPRINT);
	dprint(" \bIn\b "); 
	ad_lftos(self,ad_randomprev[self.ad_randomindex], 2,0,ad_BUFFER_DPRINT);
	dprint(" \bPo\b "); dprint(ftos(self.ad_poisonous));
	if (self.health > 0) {
		dprint(" \bHP\b "); dprint(ftos(self.health));
	}
	dprint(" -"); dprint(self.ad_randomclass);
	dprint(" ... ");
	if (self.classname == "item_shells" || self.classname == "item_cells" ||
		self.classname == "item_plasma") {
		dprint("box size (");
		if (self.spawnflags & ad_A_LARGE) dprint("LARGE)");
		else dprint("SMALL)");
	}
	else dprint(self.classname);
	dprint("\n");
};

//----------------------------------------------------------------------
float(vector ad_rndvec, float ad_rndno) ad_rnd_fetchrange =
{
	// Find out random number range 
	if (ad_rndno < ad_rndvec_x) return 1;
	else if (ad_rndno < ad_rndvec_y) return 2;
	else if (ad_rndno < ad_rndvec_z) return 3;
	else return 4;
};

//----------------------------------------------------------------------
// Make sure random number is within 1-99 range
// Cannot have a zero value, its used to test setup or not!
//----------------------------------------------------------------------
float(float ad_rndno) ad_rnd_validaterange = 
{
	local float ad_ret_val;
	ad_ret_val = floor(ad_rndno);
	while (ad_ret_val >= ad_RND_RETMAX) { 
		ad_ret_val = ad_ret_val - ad_RND_RETMAX;
	}
	if (ad_ret_val < 1) ad_ret_val = 1;
	return ad_ret_val;
};

//----------------------------------------------------------------------
void(vector ad_rndvec, float ad_prevind) ad_rnd_prevnumber =
{
	local float ad_rndgroup;
	
	// Find out the new random number range 
	ad_rndgroup = ad_rnd_fetchrange(ad_rndvec, self.ad_randomized);
	// Check for range marker from last time
	if (ad_randomprev[ad_prevind] > ad_RND_DUPOFFSET) 
		ad_randomprev[ad_prevind] = ad_randomprev[ad_prevind] - ad_RND_DUPOFFSET;
	
	// Are the current and previous the same range?
	if (ad_randomprev[ad_prevind] == ad_rndgroup) {
		// Reverse random number to get opposite result
		self.ad_randomized = self.ad_randomized + ad_RND_MIDDLE;
		// Make sure number is withing 1-99 range
		self.ad_randomized = ad_rnd_validaterange(self.ad_randomized);
		// Highlight range with marker (+90)
		ad_rndgroup = ad_RND_DUPOFFSET + ad_rnd_fetchrange(ad_rndvec, self.ad_randomized);
	}
	// Save new group range for next time
	ad_randomprev[ad_prevind] = ad_rndgroup;
};

//----------------------------------------------------------------------
void(float ad_hpvalue) ad_rnd_resethealth = {
	// Fix HP to prevent map unbalance! haha :P
	if (ad_randomflags & ad_RND_NORESETHP) return;
	else self.health = ad_hpvalue;
};

//----------------------------------------------------------------------
void() ad_rnd_resetspawnflags = {
	// Remove any specific spawnflags
	self.spawnflags = self.spawnflags - (self.spawnflags & 2);
	self.spawnflags = self.spawnflags - (self.spawnflags & 4);
};
void() ad_rnd_resetzombieflags = {
	// Remove any specific spawnflags
	self.spawnflags = self.spawnflags - (self.spawnflags & 1);
	self.spawnflags = self.spawnflags - (self.spawnflags & 2);
	self.spawnflags = self.spawnflags - (self.spawnflags & 4);
};

//----------------------------------------------------------------------
void(float ad_rndperc) ad_rnd_addpoison =
{
	// Check for any exceptions
	if (ad_randomflags & ad_RND_NOPOISON) return;
	// Default percentage chance
	if (ad_rndperc == 0) ad_rndperc = ad_RND_MIDDLE;
	// Check for poison?
	if (self.ad_randompoison < ad_rndperc) self.ad_poisonous = ad_TRUE;
};

//----------------------------------------------------------------------
// Blocking quickload
//----------------------------------------------------------------------
float() ad_rnd_CheckNoQuickLoad =
{
	dprint("\b[RND_LOAD]\b Checking load exceptions!\n");
	// Is randomizer active in savegame data!?!
	if (ad_check_customflags(ad_savegamechaos) == ad_FALSE) return ad_FALSE;
	// Skill 4 only restricted
	if (ad_skill < ad_SKILL_EVIL) return ad_FALSE;
	// Quickload exception on savegame data!?!
	if (!(ad_savegamechaos & ad_RND_NOQUICKLOAD)) return ad_FALSE;
	// Evil should not live again!
	return ad_TRUE;
};

//----------------------------------------------------------------------
// This function is about trying to detect savegame data and
// correct the current setup (scratch2/3 are not saved)
//----------------------------------------------------------------------
float() ad_rnd_CheckSaveGameReboot =
{
	local float ad_currentseed, ad_cleanflags, ad_cleansavegame;
	// No deathmatch support
	if (deathmatch > 0) return ad_FALSE;

	// Read Chaos console variables
	ad_randomflags = cvar("scratch3");
	ad_currentseed = cvar("scratch2");

	// Remove all internal bitflags
	ad_cleanflags = ad_clean_randflags(ad_randomflags);
	ad_cleansavegame = ad_clean_randflags(ad_savegamechaos);
	
	// DEFAULT = system off or legacy savegame files
	if (ad_cleanflags == 0 && ad_cleansavegame == 0) {
		// Nothing to do, pass through functionality
		dprint("\b[RND_SYNC]\b Chaos Mode Disabled!\n");
		return ad_FALSE;
	}
	// SAVEGAME requires Chaos system and CURRENT is wrong!
	else if (ad_cleanflags == 0 && ad_cleansavegame > 0) {
		// Highlight where Chaos mode enabled
		dprint("\b[RND_SYNC]\b Chaos Mode (");
		dprint(ftos(ad_cleanflags)); dprint(") Save (");
		dprint(ftos(ad_cleansavegame)); dprint(") Wrong!\n");
		// Savegame was using Chaos system
		// Reset current spawn setup and restart!
		cvar_set("scratch3", ftos(ad_cleansavegame));
		cvar_set("scratch2", ftos(ad_savegameseed));
		dprint("\b[RND_SYNC]\b Force Restart command!\n");
		// Do restart in PlayerPreThink function
		return ad_TRUE;
	}
	// CURRENT setup is active and SAVEGAME is wrong!
	else if (ad_cleanflags > 0 && ad_cleansavegame == 0) {
		// Highlight where Chaos mode enabled
		dprint("\b[RND_SYNC]\b Chaos Mode (");
		dprint(ftos(ad_cleanflags)); dprint(") Save (");
		dprint(ftos(ad_cleansavegame)); dprint(") Wrong!\n");
		// Current spawn setup is using Chaos system
		// Make sure savegame is using the same values
		ad_savegamechaos = ad_cleanflags;
		ad_savegameseed = ad_currentseed;
		return ad_FALSE;
	}
	else {
		// SAVEGAME and CURRENT setup are perfect match!
		dprint("\b[RND_SYNC]\b Chaos (");
		dprint(ftos(ad_randomflags)); dprint(") Save (");
		dprint(ftos(ad_savegamechaos)); dprint(")\n");
		dprint("\b[RND_SYNC]\b Seed (");
		dprint(ftos(ad_currentseed)); dprint(") Save (");
		dprint(ftos(ad_savegameseed)); 
		
		// Random seeds are perfect match!
		if (ad_currentseed == ad_savegameseed) {
			dprint(")\n");
			return ad_FALSE;
		}
		else {
			dprint(") Wrong!\n");
			// This is a tricky situation ...
			// Is the CURRENT seed right or the SAVEGAME seed!
			// If SAVEGAME seed right, then restart required
			// Going with SAVEGAME is the priority!
			cvar_set("scratch2", ftos(ad_savegameseed));
			dprint("\b[RND_SYNC]\b Force Restart command!\n");
			// Do restart in PlayerPreThink function
			return ad_TRUE;
		}
	}
};

//----------------------------------------------------------------------
// Simplifed version of mathlib_bitshift
//----------------------------------------------------------------------
float (float ad_number, float ad_exp) ad_simple_bitshift =
{
	local float ad_digit, ad_ret_val;
	
	ad_digit = fabs(ad_exp);
	ad_ret_val = ad_number;
	
	while (ad_digit > 0) {
		if (ad_ret_val <= 0) break;
		if (ad_exp > 0) ad_ret_val = floor(ad_ret_val * 2);
		else ad_ret_val = floor(ad_ret_val / 2);
		ad_digit = ad_digit - 1;
	}
	return ad_ret_val;
};

//----------------------------------------------------------------------
// Random number generator using a seed system
// Originally written by spike, I removed the foo!
//----------------------------------------------------------------------
vector(vector ad_seedvec, float bitshift) ad_magicshift = 
{
	// Shift Left (LOW) bits
	if (bitshift > 0) {
		while (bitshift --> 0) {
			ad_seedvec_y = (ad_seedvec_y*2)&0xfffe;
			//carry the high bit of the low word to the high word
			ad_seedvec_y |= (ad_seedvec_x/0x8000)&1;
			ad_seedvec_x = (ad_seedvec_x*2)&0xfffe;
		}
	}
	// Shift Right (HIGH) bits
	else {
		bitshift *= -1;
		while (bitshift --> 0) {
			ad_seedvec_x = (ad_seedvec_x/2)&0x7fff;
			//carry the lower bit of the high word to the low word
			ad_seedvec_x |= (ad_seedvec_y&1)*0x8000;
			ad_seedvec_y = (ad_seedvec_y/2)&0x7fff;
		}
	}
	return ad_seedvec;
};

//----------------------------------------------------------------------
float(float ad_seedstart) ad_srandom =
{
	local float ad_ret_val;
	local vector ad_seedval;
	
	// Cannot have negative or zero seeds
	if (ad_seedstart <= 0) ad_seedstart = 1;
	// Check within maximum range
	if (ad_seedstart > ad_RND_RANGEMAX) ad_seedstart = ad_RND_RANGEMAX;
	// Convert random seed to two halves (16+8)
	ad_seedval_x = ad_seedstart & ad_RND_LOWMASK;
	// Is there a top half to the original number
	if (ad_seedstart < ad_RND_16BIT) ad_seedval_y = 0;
	// Shift bits downward (top 8 bits only)
	else ad_seedval_y = ad_simple_bitshift(ad_seedstart, -16);
	
	// Setup bitshift magic numbers (default are 13, -17, 5)
	// Algorithm "xor" from p. 4 of Marsaglia, "Xorshift RNGs"
	if (ad_magicseed_x <= 0) ad_magicseed_x = ad_RND_MAGICA;
	if (ad_magicseed_y <= 0) ad_magicseed_y = ad_RND_MAGICB;
	if (ad_magicseed_z <= 0) ad_magicseed_z = ad_RND_MAGICC;
	
	// Do three bitshifts (using magic numbers)
	ad_seedval ^= ad_magicshift(ad_seedval, rint(ad_magicseed_x));
	ad_seedval ^= ad_magicshift(ad_seedval, rint(ad_magicseed_y));
	ad_seedval ^= ad_magicshift(ad_seedval, rint(ad_magicseed_z));
	
	// Convert number down to 0-1 range (huge decimal point)
	ad_ret_val = (ad_seedval_y / ad_RND_16BIT) + (ad_seedval_x / (ad_RND_16BIT*ad_RND_16BIT));
	// Shift the bits upward to get better random number range
	// Only interested in 5/6 digit number, remove less than 0 part
	ad_ret_val = floor(ad_ret_val*100000);
	// Convert number to consistent range of 0-99
	ad_ret_val = ad_rnd_validaterange(ad_ret_val);
	return ad_ret_val;
};

//----------------------------------------------------------------------
// RESET original seed (mapload, ondeath, changelevel)
//----------------------------------------------------------------------
void(float ad_entrypoint) ad_rnd_ResetRandomSeed =
{
	// No deathmatch support
	if (deathmatch > 0) return;	
	// Randomizer flag (options)
	// Also updates randomflags variable
	if (ad_check_randflags() == ad_FALSE) return;
	
	// PRIORITY 1 = Manual Reset
	// settings.qc / reset_randomizer
	if (ad_entrypoint & ad_RND_ACTIVERESET) {
		// Force random seed to generate
		cvar_set("scratch2", "0");
		if (self.flags & ad_FL_CLIENT)
			sprint (self, "\b[RND_RESET]\b Level Seed reset!\n");
		else dprint ("\b[RND_RESET]\b Level Seed reset!\n");
	}
	// PRIORITY 2 = Change level?
	// triggers.qc / trigger_changelevel_fire
	else if (ad_entrypoint & ad_RND_NORESETCHLVL) {
		// Check for ondeath exception?
		if (!(ad_randomflags & ad_RND_NORESETCHLVL)) {
			// Force random seed to generate
			cvar_set("scratch2", "0");
			dprint ("\b[RND_DEATH]\b Level Seed reset!\n");
		}
		else dprint ("\b[RND_CHGLVL]\b Level Seed not changed!\n");
	}
	// PRIORITY 3 = Player Death?
	// client.qc / ClientRespawn
	else if (ad_entrypoint & ad_RND_NORESETDEATH) {
		// Check for ondeath exception?
		if (!(ad_randomflags & ad_RND_NORESETDEATH)) {
			// Force random seed to generate
			cvar_set("scratch2", "0");
			dprint ("\b[RND_DEATH]\b Level Seed reset!\n");
		}
		else dprint ("\b[RND_DEATH]\b Level Seed not changed!\n");
	}
};
