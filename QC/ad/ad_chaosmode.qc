string ad_RND_SURPRISEPOS = "misc/secret.wav";		// Classic ID secret
string ad_RND_SURPRISENEG = "misc/secret3.wav";	// New Mfortress secret

void() ad_rnd_cachesounds = {
	if (ad_randomcache) return;
	ad_randomcache = ad_TRUE;
	// Positive random surprise
	precache_sound(ad_RND_SURPRISEPOS);
	// Negative random surprise
	precache_sound(ad_RND_SURPRISENEG);
};
void(entity ad_targ, string ad_soundtype) ad_rnd_playsurprise = {
	if (ad_randomcache <= 0) return;
	sound(ad_targ, ad_CHAN_AUTO, ad_soundtype, 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
float(float ad_rseed) ad_rnd_checkseedrange = {
	local float ad_ret_val;
	// Cannot have zero or negative
	if (ad_rseed <= 0) ad_ret_val = 1;
	// Wrap around on random seed range
	else if (ad_rseed > ad_RND_RANGEMAX)
		ad_ret_val = ad_rseed - ad_RND_RANGEMAX;
	// Range all good!
	else ad_ret_val = ad_rseed;
	// Always return Integer
	return floor(ad_ret_val);
};

//----------------------------------------------------------------------
// Used INTERNALLY to the randomizer function
//----------------------------------------------------------------------
void(float ad_newval) ad_set_randflags =
{
	cvar_set("scratch3", ftos(ad_newval));
};

//----------------------------------------------------------------------
// Used INTERNALLY to the randomizer function
//----------------------------------------------------------------------
void() ad_disable_randflags =
{
	ad_randomflags = cvar("scratch3");
	// Remove all gameplay mode bits (1-8)
	ad_randomflags = ad_randomflags - (ad_randomflags & ad_RND_DISABLE);
	cvar_set("scratch3", ftos(ad_randomflags));
};

//----------------------------------------------------------------------
// Used INTERNALLY to the randomizer function
//----------------------------------------------------------------------
float() ad_check_randflags =
{
	ad_randomflags = cvar("scratch3");
	if (ad_randomflags & ad_RND_FAMILYSPAWN) return ad_TRUE;
	else if (ad_randomflags & ad_RND_BBOXSPAWN) return ad_TRUE;
	else return ad_FALSE;
};
float(float ad_customflags) ad_check_customflags =
{
	if (ad_customflags & ad_RND_FAMILYSPAWN) return ad_TRUE;
	else if (ad_customflags & ad_RND_BBOXSPAWN) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// Used INTERNALLY to clean chaos flag of internal bit values
//----------------------------------------------------------------------
float(float ad_cleanflags) ad_clean_randflags =
{
	local float ad_ret_val;
	ad_ret_val = ad_cleanflags;
	// Remove internal bitflags
	ad_ret_val = ad_ret_val - (ad_ret_val & ad_RND_ACTIVERESET);
	ad_ret_val = ad_ret_val - (ad_ret_val & ad_RND_ACTIVECHLVL);
	ad_ret_val = ad_ret_val - (ad_ret_val & ad_RND_ACTIVEDEATH);
	ad_ret_val = ad_ret_val - (ad_ret_val & ad_RND_SYNCRESTART);
	return ad_ret_val;
};

//----------------------------------------------------------------------
// Used EXTERNALLY to read the correct value of scratch3
//----------------------------------------------------------------------
float() ad_read_randflags =
{
	local float ad_ret_val;
	ad_ret_val = ad_clean_randflags(cvar("scratch3"));
	return ad_ret_val;
};

//----------------------------------------------------------------------
// Used EXTERNALLY via impulse commands to show current seed
//----------------------------------------------------------------------
void() ad_displaycenter_randomseed =
{
	// Need a client for centerprint messages
	if (!(self.flags & ad_FL_CLIENT)) return;
	// Is the randomizer active?
	if (ad_check_randflags() == ad_TRUE) {
		if (ad_randomorg <= 0) ad_centerprint(self, "Random Seed ( Not Set )");
		else ad_centerprint3(self, "Random Seed (", ftos(ad_randomorg), ")");
	}
	else ad_centerprint(self, "Chaos System not active!\n");
};
void() ad_warning_chaosmode =
{
	// Need a client for sprint messages
	if (!(self.flags & ad_FL_CLIENT)) return;
	// Is the randomizer active?
	if (ad_check_randflags() == ad_TRUE) {
		sprint(self, "\n\bChaos\b mode ("); sprint(self, ftos(ad_randomflags));
		sprint(self, ") is \benabled\b, be warned!\n");
		sprint(self, "Random Seed ("); sprint(self, ftos(ad_randomorg));
		sprint(self, ") is active!\n\n");
	}
};

//----------------------------------------------------------------------
// Used EXTERNALLY via impulse commands to show seed stats
//----------------------------------------------------------------------
void() ad_displaydebug_randflags =
{
	// Need a client for sprint messages
	if (!(self.flags & ad_FL_CLIENT)) return;
	// Is the randomizer active?
	if (ad_check_randflags() == ad_FALSE) {
		ad_centerprint(self, "Chaos System not active!\n");
		return;
	}
	sprint(self, "\n[-- \bChaos\b Mode (");
	sprint(self, ftos(ad_randomflags));
	sprint(self, ") current settings --]\n");
	sprint(self,   "------------------------------------------\n");
	sprint(self, "Origin Seed  (");
	if (ad_randomorg <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(ad_randomorg));
	sprint(self, ") Saved Seed (");
	if (cvar("scratch2") <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(cvar("scratch2")));
	sprint(self, ")\n");
	
	sprint(self, "Monster Seed (");
	if (ad_randomseed[ad_RND_SEEDMONSTER] <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(ad_randomseed[ad_RND_SEEDMONSTER]));
	sprint(self, ") Ammo Seed  ("); 
	if (ad_randomseed[ad_RND_SEEDAMMO] <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(ad_randomseed[ad_RND_SEEDAMMO]));
	sprint(self, ")\nHealth Seed  ("); 
	if (ad_randomseed[ad_RND_SEEDHEALTH] <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(ad_randomseed[ad_RND_SEEDHEALTH]));
	sprint(self, ") Armor Seed (");
	if (ad_randomseed[ad_RND_SEEDARMOUR] <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(ad_randomseed[ad_RND_SEEDARMOUR]));
	sprint(self, ")\nArtifct Seed ("); 
	if (ad_randomseed[ad_RND_SEEDARTIFACT] <= 0) sprint(self, "\bEmpty\b");
	else sprint(self, ftos(ad_randomseed[ad_RND_SEEDARTIFACT]));
	sprint(self, ") Priv Keys (");
	sprint(self, ftos(ad_magicseed_x)); sprint(self, " ");
	sprint(self, ftos(ad_magicseed_y)); sprint(self, " ");
	sprint(self, ftos(ad_magicseed_z));
	sprint(self, ")\n\n");
	
	sprint(self, "Monster Spawn type (");
	if (ad_randomflags & ad_RND_FAMILYSPAWN) sprint(self, "Family Groups");
	else if (ad_randomflags & ad_RND_BBOXSPAWN) sprint(self, "\bBounding Box\b");
	else sprint(self, "\bNothing Set!!\b");
	sprint(self, ")\n");
	
	sprint(self, "Random Seed Reset  (");
	// Level reset overrides change level and death resets
	if (ad_randomflags & ad_RND_NORESETNEWLVL) sprint(self, "\b-NewLvl -ChLvl -Death\b");
	else {
		sprint(self, "+NewLvl");
		if (ad_randomflags & ad_RND_NORESETCHLVL) sprint(self, " \b-ChLvl\b");
		else sprint(self, " +ChLvl");
		if (ad_randomflags & ad_RND_NORESETDEATH) sprint(self, " \b-Death\b");
		else sprint(self, " +Death");
	}
	
	sprint(self, ")\n");
	sprint(self, "Monster HP Reset   (");
	if (ad_randomflags & ad_RND_NORESETHP) sprint(self, "\bDisabled\b");
	else sprint(self, "Enabled");
	sprint(self, ")\n");
	sprint(self, "Monster Health Itm (");
	if (ad_randomflags & ad_RND_NOHEALTHPACK) sprint(self, "\bDisabled\b");
	else sprint(self, "Enabled");
	sprint(self, ")\n");
	sprint(self, "Skill 4 Quickload  (");
	if (ad_randomflags & ad_RND_NOQUICKLOAD) sprint(self, "\bDisabled\b");
	else sprint(self, "Enabled");
	sprint(self, ")\n");
	sprint(self, "Poisonous Monsters (");
	if (ad_randomflags & ad_RND_NOPOISON) sprint(self, "\bDisabled\b");
	else sprint(self, "Enabled");
	sprint(self, ")\n");
	sprint(self,   "------------------------------------------\n");
};

//----------------------------------------------------------------------
// Used EXTERNALLY via impulse commands to show weapon upgrades
//----------------------------------------------------------------------
void() ad_displaydebug_weaponupgrades =
{
	local float ad_wpnupg, ad_shellfound, ad_shellmax, ad_cellfound, ad_cellmax;
	local entity ad_entlist;
	
	// Need a client for sprint messages
	if (!(self.flags & ad_FL_CLIENT)) return;
	// Is the randomizer active?
	if (ad_check_randflags() == ad_FALSE) {
		ad_centerprint(self, "Chaos System not active!\n");
		return;
	}
	
	// Find all Large shells in the map
	ad_shellfound = ad_shellmax = 0;
	ad_entlist = find(world, classname, "item_shells");
	while(ad_entlist) {
		// Found large ammo?
		if (ad_entlist.spawnflags & ad_A_LARGE) {
			ad_shellmax = ad_shellmax + 1;
			// Has the ammo been picked up yet?
			// This will have issues with spawn delay
			if (ad_entlist.ad_estate == ad_ESTATE_OFF)
				ad_shellfound = ad_shellfound + 1;
		}
		// Keep searching within subset list
		ad_entlist = find(ad_entlist, classname, "item_shells");
	}
	// Find all Large cells in the map
	ad_cellfound = ad_cellmax = 0;
	ad_entlist = find(world, classname, "item_cells");
	while(ad_entlist) {
		// Found large ammo?
		if (ad_entlist.spawnflags & ad_A_LARGE) {
			ad_cellmax = ad_cellmax + 1;
			// Has the ammo been picked up yet?
			// This will have issues with spawn delay
			if (ad_entlist.ad_estate == ad_ESTATE_OFF)
				ad_cellfound = ad_cellfound + 1;
		}
		// Keep searching within subset list
		ad_entlist = find(ad_entlist, classname, "item_cells");
	}
	ad_entlist = find(world, classname, "item_plasma");
	while(ad_entlist) {
		// Found large ammo?
		if (ad_entlist.spawnflags & ad_A_LARGE) {
			ad_cellmax = ad_cellmax + 1;
			// Has the ammo been picked up yet?
			// This will have issues with spawn delay
			if (ad_entlist.ad_estate == ad_ESTATE_OFF)
				ad_cellfound = ad_cellfound + 1;
		}
		// Keep searching within subset list
		ad_entlist = find(ad_entlist, classname, "item_cells");
	}
		
	sprint(self, "\n[-- \bChaos\b Mode (");
	sprint(self, ftos(ad_randomflags));
	sprint(self, ") weapon upgrades --]\n");
	sprint(self, "------------------------------------------\n");
	sprint(self, "Weapon     Inv  Found Qty   Map Qty\n");
	//            Shadow Axe  x    xx / xx    -- / --
	//            Widowmaker  x    xx / xx    xx / xx
	//            Plasma Gun  x    xx / xx    xx / xx
	//------------------------------------------------------------------
	sprint(self, "Shadow Axe  ");
	if (self.ad_moditems & ad_IT_UPGRADE_AXE) sprint(self, "Y");
	else sprint(self,"N");
	sprint(self, "    ");
	ad_lftos(self,self.ad_randomgibs,2,0,ad_BUFFER_SPRINT);
	sprint(self, " / ");
	ad_wpnupg = ad_rnd_upgwpnmax_shadowaxe();
	ad_lftos(self,ad_wpnupg,2,0,ad_BUFFER_SPRINT);
	sprint(self, "    -- / --\n");

	//------------------------------------------------------------------
	sprint(self, "Widowmaker  ");
	if (self.ad_moditems & ad_IT_UPGRADE_SSG) sprint(self, "Y");
	else sprint(self,"N");
	sprint(self, "    ");
	ad_lftos(self,self.ad_randomshells,2,0,ad_BUFFER_SPRINT);
	sprint(self, " / ");
	ad_wpnupg = ad_rnd_upgwpnmax_widowmaker();
	ad_lftos(self,ad_wpnupg,2,0,ad_BUFFER_SPRINT);
	sprint(self, "    ");
	ad_lftos(self,ad_shellfound,2,0,ad_BUFFER_SPRINT);
	sprint(self, " / ");
	ad_lftos(self,ad_shellmax,2,0,ad_BUFFER_SPRINT);
	sprint(self, "\n");

	//------------------------------------------------------------------
	sprint(self, "Plasma Gun  ");
	if (self.ad_moditems & ad_IT_UPGRADE_LG) sprint(self, "Y");
	else sprint(self,"N");
	sprint(self, "    ");
	ad_lftos(self,self.ad_randomcells,2,0,ad_BUFFER_SPRINT);
	sprint(self, " / ");
	ad_wpnupg = ad_rnd_upgwpnmax_plasmagun();
	ad_lftos(self,ad_wpnupg,2,0,ad_BUFFER_SPRINT);
	sprint(self, "    ");
	ad_lftos(self,ad_cellfound,2,0,ad_BUFFER_SPRINT);
	sprint(self, " / ");
	ad_lftos(self,ad_cellmax,2,0,ad_BUFFER_SPRINT);
	sprint(self, "\n");

	sprint(self, "------------------------------------------\n");
	sprint(self, "Ammo        Qty L E Location\n");
	//            item_shells  xx x x xxx xxx xxx
	
	// Find all shells (small/large) in map
	ad_entlist = find(world, classname, "item_shells");
	while(ad_entlist) {
		sprint(self, "Item_shells  ");
		ad_lftos(self,ad_entlist.aflag,2,0,ad_BUFFER_SPRINT);
		sprint(self, " ");
		if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self,"Y");
		else sprint(self,"N");
		sprint(self, " ");
		if (ad_entlist.ad_estate == ad_ESTATE_OFF) sprint(self,"Y");
		else sprint(self,"N");
		sprint(self, " ");
		sprint(self,vtos(ad_entlist.origin));
		sprint(self,"\n");
		// Keep searching within subset list
		ad_entlist = find(ad_entlist, classname, "item_shells");
	}
	// Find all cells (small/large) in map
	ad_entlist = find(world, classname, "item_cells");
	while(ad_entlist) {
		sprint(self, "Item_cells   ");
		ad_lftos(self,ad_entlist.aflag,2,0,ad_BUFFER_SPRINT);
		sprint(self, " ");
		if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self,"Y");
		else sprint(self,"N");
		sprint(self, " ");
		if (ad_entlist.ad_estate == ad_ESTATE_OFF) sprint(self,"Y");
		else sprint(self,"N");
		sprint(self, " ");
		sprint(self,vtos(ad_entlist.origin));
		sprint(self,"\n");
		// Keep searching within subset list
		ad_entlist = find(ad_entlist, classname, "item_cells");
	}
	// Find all plasma (small/large) in map
	ad_entlist = find(world, classname, "item_plasma");
	while(ad_entlist) {
		sprint(self, "Item_plasma  ");
		ad_lftos(self,ad_entlist.aflag,2,0,ad_BUFFER_SPRINT);
		sprint(self, " ");
		if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self,"Y");
		else sprint(self,"N");
		sprint(self, " ");
		if (ad_entlist.ad_estate == ad_ESTATE_OFF) sprint(self,"Y");
		else sprint(self,"N");
		sprint(self, " ");
		sprint(self,vtos(ad_entlist.origin));
		sprint(self,"\n");
		// Keep searching within subset list
		ad_entlist = find(ad_entlist, classname, "item_plasma");
	}
};

//----------------------------------------------------------------------
float() ad_generate_randomseed =
{
	local float ad_rndcount, ad_rndloop, ad_flip_val, ad_ret_val;
	// Generate see with 4 random numbers combined
	// The downside is the extreme values (low/high) are very rare
	ad_rndcount = floor(1+ (random() * 3));
	for (ad_rndloop=ad_rndcount, ad_ret_val=0;ad_rndloop > 0;ad_rndloop--) {
		ad_ret_val = floor(ad_ret_val + (random() * (ad_RND_RANGEMAX/ad_rndcount)));
	}
	// Random chance to flip the range
	if (random() < 0.5 ) {
		// Shift seed to opposite range half
		ad_flip_val = ad_RND_RANGEMAX/2;
		if (ad_ret_val < ad_flip_val) ad_ret_val = ad_ret_val + ad_flip_val;
		ad_ret_val = ad_ret_val - ad_flip_val;
	}
	// Check for any range errors
	ad_ret_val = ad_rnd_checkseedrange(ad_ret_val);
	// Final result
	return ad_ret_val;
};

//----------------------------------------------------------------------
void() ad_setup_randomseed =
{
	local float ad_i, ad_rndoffset;
	// Cache random reward sounds
	ad_rnd_cachesounds();
	
	// At this point (framecount=0) ALL QC variables are blank
	// This is even the case with quickload/loading a savegame!
	// Also the parm1-16 variables are blank (do get updated eventually)
	// The only way to remember settings is via console variables
	//
	// Scratch2 stores the last random seed number generated
	// If the seed exists, then it will be used instead of a new one.
	// The problem is once the engine closes down, the seed is gone!
	//
	// To fix the problem of console variables losing their values,
	// they are stored in global variables included with savefiles.
	// When a savefile is loaded, the console variables are reset.
	
	// Make sure randomflags is current
	ad_randomflags = cvar("scratch3");
	// Any seed setup?
	if (ad_randomorg <= 0) {
		// Read current random seed
		ad_randomorg = cvar("scratch2");
		// Cannot have a zero or negative seed
		if (ad_randomorg <= 0) ad_randomorg = ad_generate_randomseed();
		// Save the seed to prevent quick/loadgame issues
		cvar_set("scratch2", ftos(ad_randomorg));

		// Monster seed always starts with the origin seed
		ad_randomseed[ad_RND_SEEDMONSTER] = ad_rnd_checkseedrange(ad_randomorg);
		
		// Loop through all the other random seed numbers
		// Creating them at different offsets within complete range
		for(ad_i=0;ad_i<ad_RND_SEEDMAX;ad_i++) {
			ad_rndoffset = (ad_RND_RANGEMAX/16)*(ad_i+1);
			// Keep secondary seeds in sync with large offset
			if (ad_randomorg > ad_RND_RANGEMAX/2)
				ad_randomseed[ad_i] = ad_randomorg - ad_rndoffset;
			else ad_randomseed[ad_i] = ad_randomorg + ad_rndoffset;
			// Double check that seed within range (++floor command)
			ad_randomseed[ad_i] = ad_rnd_checkseedrange(ad_randomseed[ad_i]);
		}
		
		// Display new Seed to console
		dprint("\b[RND_SETUP]\b New Seed ("); dprint(ftos(ad_randomorg));
		dprint(") Offset ("); dprint(ftos(ad_RND_OFFSET)); dprint(")\n");
	}
	// To keep the savegame files in sync with current settings
	// Save a backup copy of scratch 2 / 3 console variables
	if (ad_savegamechaos == 0) {
		// Sync save game values to current (spawn)
		ad_savegamechaos = ad_randomflags;
		ad_savegameseed = ad_randomorg;
	}
};

//----------------------------------------------------------------------
float(float ad_seedno) ad_fetch_randomnumber = {
	local float ad_ret_val;
	// Randomly pick another type
	ad_ret_val = ad_srandom(ad_randomseed[ad_seedno]);
	// Update randomseed with offset (predictable amount)
	ad_randomseed[ad_seedno] = ad_randomseed[ad_seedno] + ad_RND_OFFSET;
	// Make sure new seed is within range
	ad_randomseed[ad_seedno] = ad_rnd_checkseedrange(ad_randomseed[ad_seedno]);
	// return random number
	return ad_ret_val;
};

//----------------------------------------------------------------------
void(float ad_seedno) ad_rnd_generateseeds = 
{
	// Save original classname for debug stats
	self.ad_randomclass = self.classname;
	// Always create all random numbers
	self.ad_randomized = ad_fetch_randomnumber(ad_seedno);
	self.ad_randomupg = ad_fetch_randomnumber(ad_seedno);
	self.ad_randompoison = ad_fetch_randomnumber(ad_seedno);
};

//=====================================================================
// IMPORTANT - This function is called on FRAME 0!
// Randomizes all ID1 monsters with a full AD line up
// Called from all ID1 monster .qc files
//----------------------------------------------------------------------
float() ad_monster_checkrandomizer = 
{
	// Is the randomizer system active?
	if (ad_check_randflags() == ad_FALSE) return ad_FALSE;
	// Has the entity already been randomized?
	if (self.ad_randomized != 0) return ad_FALSE;
	// This can only happen on frame 0
	if (ad_framecount > 0) return ad_FALSE;
	// No deathmatch support
	if (deathmatch > 0) return ad_FALSE;
	
	// Make sure random seed is setup
	ad_setup_randomseed();
	// Pick which type of randomizer (def=bbox)
	if (ad_randomflags & ad_RND_FAMILYSPAWN) ad_rnd_familyspawns();
	else if (ad_randomflags & ad_RND_BBOXSPAWN) ad_rnd_bboxspawns();
	else {
		// Turn off system and warn on console
		ad_disable_randflags();
		dprint("\b[RND_SETUP]\b System disabled, missing spawn type!\n");
		return ad_FALSE;
	}
	
	//------------------------------------------------------------------
	// Randomizer function setup?
	if (self.ad_randomized > 0 && self.ad_th_randfunc) {
		// Re-direct to random function and finish
		self.ad_th_randfunc();
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//=====================================================================
// IMPORTANT - This function is called on FRAME 0!
// Check for monsters spawning instead of Health Packs
// Called from items.qc / item_health
//----------------------------------------------------------------------
float() ad_health_checkrandomizer =
{
	// Is the randomizer system active?
	if (ad_check_randflags() == ad_FALSE) return ad_FALSE;
	// Has the entity already been randomized?
	if (self.ad_randomized != 0) return ad_FALSE;
	// This can only happen on frame 0
	if (ad_framecount > 0) return ad_FALSE;
	// No deathmatch support
	if (deathmatch > 0) return ad_FALSE;
	
	// Make sure random seed is setup
	ad_setup_randomseed();
	// Monster surprise for rotten HPs
	if (self.spawnflags & ad_H_ROTTEN) {
		// is the feature Blocked?
		if (ad_randomflags & ad_RND_NOHEALTHPACK) return ad_FALSE;
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDHEALTH);
		// Switch HP for monster?
		if (self.ad_randomized < ad_RND_LOW) {
			// Reset spawnflags (wrong type setup)
			self.spawnflags = 1;	// Ambush
			// Items origin is -24 lower than usual
			self.origin = self.origin + '0 0 32';
			// ID health packs are placed by corner not center origin
			// Need to move the origin to middle of item for monster
			// Detect AD config flag just incase is a proper AD map!
			if (ad_query_configflag(ad_SVR_ITEMOFFSET) == ad_FALSE) {
				self.origin = self.origin + '16 16 0';
			}
			// Drop armour shards (created on monster death)
			self.healamount = ad_HEAL_ROT;
			// Random facing direction
			self.angles_y = floor(rint(random()*359));
			// Tarbaby or Boil!
			//if (self.randomupg > 0) {
			if (self.ad_randomupg > ad_RND_LOW) {
				self.classname = "monster_tarbaby";
				self.ad_th_randfunc = ad_monster_tarbaby;
				if (self.ad_randomupg < ad_RND_LOW)
					self.spawnflags = self.spawnflags | ad_MON_TARBYLESSJUMP;
				ad_rnd_addpoison(ad_FALSE);
				if (self.ad_poisonous) self.ad_exactskin = floor(2+(random()*4));
			}
			else {
				self.classname = "monster_boil";
				self.ad_th_randfunc = ad_monster_boil;
			}
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	// Precache extra files for later
	else if (self.spawnflags & ad_H_MEGA) {
		precache_sound ((self.noise1 = ad_SOUND_ARTSUIT1));
		precache_sound ((self.noise2 = ad_SOUND_ARTSUIT2));
	}
	//------------------------------------------------------------------
	// Randomizer function setup?
	if (self.ad_randomized > 0 && self.ad_th_randfunc) {
		// Re-direct to random function and finish
		self.ad_th_randfunc();
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//=====================================================================
// IMPORTANT - This function is called on FRAME 0!
// Convert small ammo packs to large for shotgun/plasma fragments
// Called from items.qc / item_shells, item_cells, item_plasma
//----------------------------------------------------------------------
float() ad_ammo_checkrandomizer =
{
	// Is the randomizer system active?
	if (ad_check_randflags() == ad_FALSE) return ad_FALSE;
	// Has the entity already been randomized?
	if (self.ad_randomized != 0) return ad_FALSE;
	// This can only happen on frame 0
	if (ad_framecount > 0) return ad_FALSE;
	// No deathmatch support
	if (deathmatch > 0) return ad_FALSE;
	// Reached upgrade limit?
	if (ad_randomammo >= ad_RND_MAXAMMOUP) return ad_FALSE;
	
	// Make sure random seed is setup
	ad_setup_randomseed();
	// Find small ammo box for upgrade
	if (self.classname == "item_shells" && !(self.spawnflags & ad_A_LARGE)) {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDAMMO);
		if (self.ad_randomized < ad_RND_LOW) {
			ad_randomammo = ad_randomammo + 1;
			self.spawnflags = self.spawnflags | ad_A_LARGE;
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	// Find small ammo box for upgrade
	else if (self.classname == "item_cells" && !(self.spawnflags & ad_A_LARGE)) {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDAMMO);
		if (self.ad_randomized < ad_RND_HIGH) {
			ad_randomammo = ad_randomammo + 1;
			self.spawnflags = self.spawnflags | ad_A_LARGE;
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	// Find small ammo box for upgrade
	else if (self.classname == "item_plasma" && !(self.spawnflags & ad_A_LARGE)) {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDAMMO);
		if (self.ad_randomized < ad_RND_HIGH) {
			ad_randomammo = ad_randomammo + 1;
			self.spawnflags = self.spawnflags | ad_A_LARGE;
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	//------------------------------------------------------------------
	// Entity does not change classname, no need to block spawn
	return ad_FALSE;
};

//=====================================================================
// IMPORTANT - This function is called on FRAME 0!
// Check for different spawning options for armour
// Called from items.qc / various armour spawn routines
//------------------------------------------------------------------
float() ad_armour_checkrandomizer =
{
	// Is the randomizer system active?
	if (ad_check_randflags() == ad_FALSE) return ad_FALSE;
	// Has the entity already been randomized?
	if (self.ad_randomized != 0) return ad_FALSE;
	// This can only happen on frame 0
	if (ad_framecount > 0) return ad_FALSE;
	// No deathmatch support
	if (deathmatch > 0) return ad_FALSE;

	// Make sure random seed is setup
	ad_setup_randomseed();
	// Random changes to armour
	if (self.classname == "item_armor1") {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDARMOUR);
		ad_rnd_resetspawnflags();
		// Check for <33=negative and >66=positive
		if (self.ad_randomized < ad_RND_LOW) {
			self.classname = "item_backpack_armour";
			self.ad_th_randfunc = ad_item_backpack_armour;
			if (random() < 0.5) self.spawnflags = self.spawnflags | ad_BACKPACK_YELTYPE;
			else self.spawnflags = self.spawnflags | ad_BACKPACK_REDTYPE;
		}
		else if (self.ad_randomized > ad_RND_HIGH) {
			self.classname = "item_armor2";
			self.ad_th_randfunc = ad_item_armor2;
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	else if (self.classname == "item_armor2") {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDARMOUR);
		ad_rnd_resetspawnflags();
		// Check for <33=negative and >66=positive
		if (self.ad_randomized < ad_RND_LOW) {
			self.classname = "item_armor1";
			self.ad_th_randfunc = ad_item_armor1;			
		}
		else if (self.ad_randomized > ad_RND_HIGH) {
			self.classname = "item_armorInv";
			self.ad_th_randfunc = ad_item_armorInv;
		}
		// Show console info
		ad_rnd_displaydebug();
	}	
	// Precache extra files for later
	else if (self.classname == "item_armorInv") {
		precache_sound ((self.noise1 = ad_SOUND_ARTBLASTBELT1));
		precache_sound ((self.noise2 = ad_SOUND_ARTBLASTBELT2));
		precache_sound ((self.noise3 = ad_SOUND_ARTBLASTBELT3));
	}
	//------------------------------------------------------------------
	// Randomizer function setup?
	if (self.ad_randomized > 0 && self.ad_th_randfunc) {
		// Re-direct to random function and finish
		self.ad_th_randfunc();
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//=====================================================================
// IMPORTANT - This function is called on FRAME 0!
// Check for different spawning options for artifact/powerups
// Called from items.qc / various artifact spawn routines
//----------------------------------------------------------------------
float() ad_artifact_checkrandomizer =
{
	// Is the randomizer system active?
	if (ad_check_randflags() == ad_FALSE) return ad_FALSE;
	// Has the entity already been randomized?
	if (self.ad_randomized != 0) return ad_FALSE;
	// This can only happen on frame 0
	if (ad_framecount > 0) return ad_FALSE;
	// No deathmatch support
	if (deathmatch > 0) return ad_FALSE;
	
	// Make sure random seed is setup
	ad_setup_randomseed();
	// Random changes to artifacts
	if (self.classname == "item_artifact_invisibility") {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDARTIFACT);
		ad_rnd_resetspawnflags();
		// Check for <33=negative and >66=positive
		if (self.ad_randomized < ad_RND_LOW) {
			// Its hard to find a more negative item than InvRing!?!
			self.classname = "item_health";
			self.ad_th_randfunc = ad_item_health;			
			self.spawnflags = ad_H_MEGA;
			// Powerup origin is -24 lower than Health Packs
			self.origin = self.origin + '0 0 24';
			// ID health packs are placed by corner not center origin
			// Move origin backward because it was originally a powerup
			if (ad_query_configflag(ad_SVR_ITEMOFFSET) == ad_FALSE) {
				self.origin = self.origin + '-16 -16 0';
			}
		}
		else if (self.ad_randomized > ad_RND_HIGH) {
			self.classname = "item_artifact_super_damage";
			self.ad_th_randfunc = ad_item_artifact_super_damage;
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	else if (self.classname == "item_artifact_envirosuit") {
		// Generate complete set of numbers
		ad_rnd_generateseeds(ad_RND_SEEDARTIFACT);
		ad_rnd_resetspawnflags();
		// Check for <33=negative and >66=positive
		if (self.ad_randomized < ad_RND_LOW) {
			self.classname = "item_health";
			self.ad_th_randfunc = ad_item_health;
			self.spawnflags = ad_H_MEGA;
			// Powerup origin is -24 lower than Health Packs
			self.origin = self.origin + '0 0 24';
			// ID health packs are placed by corner not center origin
			// Move origin backward because it was originally a powerup
			if (ad_query_configflag(ad_SVR_ITEMOFFSET) == ad_FALSE) {
				self.origin = self.origin + '-16 -16 0';
			}
		}
		else if (self.ad_randomized > ad_RND_HIGH) {
			self.classname = "item_artifact_invulnerability";
			self.ad_th_randfunc = ad_item_artifact_invulnerability;
		}
		// DEFAULT = Env Suit
		else {
			// Precache jump boots for combo pickup reward
			precache_sound (ad_SOUND_ARTJUMPBOOTS1);
			// sounds 3a-3c are used in client.qc (lines 915+)
			precache_sound (ad_SOUND_ARTJUMPBOOTS2);
			precache_sound (ad_SOUND_ARTJUMPBOOTS3A);	// First jump
			precache_sound (ad_SOUND_ARTJUMPBOOTS3B);	// Second
			precache_sound (ad_SOUND_ARTJUMPBOOTS3C);	// No more			
		}
		// Show console info
		ad_rnd_displaydebug();
	}
	else if (self.classname == "item_artifact_invulnerability") {
		// Precache lava shield for combo pickup reward
		precache_sound (ad_SOUND_ARTLSHIELD1);
		precache_sound (ad_SOUND_ARTLSHIELD2);
		precache_sound (ad_SOUND_ARTLSHIELD3);
	}
	else if (self.classname == "item_artifact_super_damage") {
		// Precache blast belt for combo pickup reward
		precache_sound (ad_SOUND_ARTBLASTBELT1);
		precache_sound (ad_SOUND_ARTBLASTBELT2);
		precache_sound (ad_SOUND_ARTBLASTBELT3);
	}

	//------------------------------------------------------------------
	// Randomizer function setup?
	if (self.ad_randomized > 0 && self.ad_th_randfunc) {
		// Re-direct to random function and finish
		self.ad_th_randfunc();
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//==================================================================
// Monster group/family setups
//------------------------------------------------------------------
void() ad_rnd_dogfamily =
{
	// Store family ranges in a vector
	local vector ad_randomrange;
	self.ad_randomindex = 0;
	ad_randomrange = '10 30 70';
	ad_rnd_prevnumber(ad_randomrange,self.ad_randomindex);
	// PICK MONSTER ------------------------------------------------
	if (self.ad_randomized < ad_randomrange_x) {
		self.classname = "monster_scorpion";
		self.ad_th_randfunc = ad_monster_scorpion;
		if (self.ad_randompoison < ad_RND_MIDDLE)
			self.spawnflags = self.spawnflags | ad_MON_SCORPION_STINGER;
	}
	else if (self.ad_randomized < ad_randomrange_y) {
		self.classname = "monster_voreling";
		self.ad_th_randfunc = ad_monster_voreling;
		if (self.ad_randompoison < ad_RND_MIDDLE)
			self.spawnflags = self.spawnflags | ad_MON_VORELING_LARGE;
	}
	else if (self.ad_randomized < ad_randomrange_z) {
		self.classname = "monster_spider";
		self.ad_th_randfunc = ad_monster_spider;
		if (self.ad_randompoison < ad_RND_MIDDLE)
			self.spawnflags = self.spawnflags | ad_MON_SPIDER_LARGE;
	}
	else {
		self.classname = "monster_dog";
		self.ad_th_randfunc = ad_monster_dog;
		ad_rnd_addpoison(ad_FALSE);
	}
};

