//======================================================================
// Entity Randomizer or Chaos mode or "Markie Madness Mode" !?!
// * Ideal for twitch playthrough challenges and sharing setups
// * Big thank you to Markie for feedback and suggestions
//=====================================================================

vector		ad_magicseed;		// bitshift formula (default = '13 -17 5')
float		ad_randomorg;		// Origin random seed for level
float		ad_randomseed[6];	// Random seed for monster, items etc
float		ad_randomflags;	// Random flags for options
float		ad_randomprev[16];	// Previous random selection
float		ad_randomammo;		// Quantity of ammo packs upgraded
float		ad_randomcache;	// Have all random sounds been cached
float		ad_savegamechaos;	// Chaos settings for savegame
float		ad_savegameseed;	// Random seed for savegame

float ad_RND_SEEDMONSTER = 0;	// Monster random number seed set
float ad_RND_SEEDAMMO = 1;     // Ammo random number seed set
float ad_RND_SEEDHEALTH = 2;	// Health random number seed set
float ad_RND_SEEDARMOUR = 3;	// Armour random number seed set
float ad_RND_SEEDARTIFACT = 4;	// Artifact random number seed set
float ad_RND_SEEDMAX = 5;		// Maximum amount of seeds maintained
float ad_RND_OFFSET = 35;		// Offset to increase through random range
float ad_RND_FRAMECOUNT = 35;	// Frame count check for Chaos mode
float ad_RND_LOWMASK = 65535;	// 1-15 bits for lower bit mask
float ad_RND_16BIT = 65536;	// 16th bit to chop floats into ints
float ad_RND_RANGEMAX = 8388607; // 23bits = Largest number can be created
float ad_RND_MAGICA = 13;		// Bitshift forumla for generating new seeds
float ad_RND_MAGICB = -17;		// Algorithm "xor" from p. 4 of Marsaglia, "Xorshift RNGs"
float ad_RND_MAGICC = 5;
float ad_RND_RETMAX = 100;		// Returns numbers between 0-99
float ad_RND_DUPOFFSET = 90;	// Offset to show a range selection was duplicated
float ad_RND_MIDDLE = 50;		// Default chance used for testing
float ad_RND_NEGATIVE = 0.33;	// Negative item pickup effect
float ad_RND_POSITIVE = 0.66;	// Positive item pickup effect
float ad_RND_LOW = 33;			// Low chance used of random condition
float ad_RND_HIGH = 66;		// High chance used of random condition
float ad_RND_BBOX1 = 1;		// ID1 bounding box 1 - humanoid
float ad_RND_BBOX2 = 2;		// ID1 bounding box 2 - ogre/sham

.float		ad_randomized;		// Entity has been randomized!?!
.float		ad_randomupg;		// Entity random upgrades chance
.float		ad_randompoison;	// Entity random poison chance
.float		ad_randomindex;	// Entity 'randomprev' array index
.float		ad_randombbox;		// Entity bounding box type
.string		ad_randomclass;	// Original start on spawn classname
.void()		ad_th_randfunc;	// Final random function to call

// Shadowaxe in id1 maps
// Monsters gibbed 5=Easy, 9=Normal, 13=Hard+
float ad_RND_FRAGAXE = 5;		// Quantity to collect to get SA
.float		ad_randomgibs;		// Total monster gibs caused by player
// Widowmaker / Plasmagun in id1 maps (These values start with EASY)
// Large Shells 3=Easy, 4=Normal, 5=Hard+
// Large Cells  1=Easy, 2=Normal, 3=Hard+
float ad_RND_FRAGSHELL = 3;	// Quantity to collect to get WM
float ad_RND_FRAGCELL = 1;		// Quantity to collect to get PG
float ad_RND_MAXAMMOUP = 5;	// Maximum amount to upgrade
.float		ad_randomshells;	// Total large shells picked up
.float		ad_randomcells;	// Total large cells picked up

//----------------------------------------------------------------------
// scratch3 bit values
// 1       Turn ON randonmizer (family selection)
// 2       Turn ON randomizer (bbox selection)

// 16      Turn OFF health reset for spawning monster
// 32      Turn OFF Health Pack Item monster replacement
// 64      Turn OFF posion monster selection process
// 128     Turn OFF ability to quickload/load on skill 4

// 4096    Turn OFF seed reset on NEW level
// 8192    Turn OFF seed reset on CHANGE level
// 16384   Turn OFF seed reset on DEATH

// Level 1 = 1 (family + fixed HP) [1]
// Level 2 = 17 (family + variable HP) [1 + 16]
// Level 3 = 2 (bbox + fixed HP) [2]
// Level 4 = 18 (bbox + variable HP) [2 + 16]
// Level 5 = 666 (Markie mode) [2 + 8 + 16 + 128 + 512]

float ad_RND_FAMILYSPAWN = 1;
float ad_RND_BBOXSPAWN = 2;
float ad_RND_MARKIEMODE = 8;
float ad_RND_DISABLE = 15;

// Additional spawn options
float ad_RND_NORESETHP = 16;
float ad_RND_NOHEALTHPACK = 32;
float ad_RND_NOPOISON = 64;
float ad_RND_NOQUICKLOAD = 128;

// 256, 512, 1024, 2048 (Empty)
float ad_RND_PARTOF666 = 512;

float ad_RND_NORESETNEWLVL = 4096;
float ad_RND_NORESETCHLVL = 8192;
float ad_RND_NORESETDEATH = 16384;
//float RND_xxx = 32768;

// Internal bit values ONLY
float ad_RND_ACTIVERESET = 65536;
float ad_RND_ACTIVECHLVL = 131072;
float ad_RND_ACTIVEDEATH = 262144;
float ad_RND_SYNCRESTART = 524288;

//----------------------------------------------------------------------
float ad_HP_MONDOG = 25;
float ad_HP_MONFISH = 25;
