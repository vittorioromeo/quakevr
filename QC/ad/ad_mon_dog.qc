void() ad_dog_stand9	=[	$stand9,	ad_dog_stand1	] {
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.lip = random();
		if (self.lip < 0.2) self.think = ad_dog_idlec1;			// Howling at moon
		else if (self.lip < 0.4) self.think = ad_dog_idleb1;	// sniff ground
		else self.think = ad_dog_idlea1;											// Growling
	}
	ad_ai_stand();
};

