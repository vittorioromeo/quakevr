//===========================================================================
// melee - dog_bite
// Standardized layout (matching ai_melee (aisubs.qc)
// Added z depth check on attacks +/- 64 units
// Added extra blood (touch version, no arc)
// Changed some explicit values to constant variables
//===========================================================================
void() ad_dog_bite =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	ad_ai_charge(10);								// Get closer for extra bite
	ad_ai_damagebreakable(10);						// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEEDOG,ad_FALSE) && VR_MeleeArc_Hits(FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;
	
	// Dog bite is nasty damage (1-24)
	ad_ldmg = (random() + random() + random()) * 8;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	
	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Spawn some blood from mouth
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

