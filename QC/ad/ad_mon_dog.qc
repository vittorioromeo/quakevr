//----------------------------------------------------------------------
void() ad_dog_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "dog/ddeath.wav", 1, ad_ATTN_NORM);

		if (random() > 0.5) ad_dog_die1 ();
		else ad_dog_dieb1 ();
	}
};

//======================================================================
/*ad:QUAKED monster_dog (1 0 0) (-32 -32 -24) (32 32 40) Ambush
======================================================================*/
void() ad_monster_dog =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dog.mdl";
	self.ad_headmdl = "progs/h_dog.mdl";
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);

	self.ad_idle_sound = "dog/idle.wav";
	precache_sound (self.ad_idle_sound);

	precache_sound ("dog/dattack1.wav");
	precache_sound ("dog/ddeath.wav");
	self.ad_pain_sound = "dog/dpain1.wav";
	precache_sound (self.ad_pain_sound);

	self.ad_sight_sound = "dog/dsight.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	self.ad_idmins = '-32 -32 -24';		// Original mega large bbox
	self.ad_idmaxs = '32 32 40';
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_DOG;
	if (self.health < 1) self.health = ad_HP_MONDOG;
	self.ad_gibhealth = -35;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 10;				// Easy response to pain
	self.ad_steptype = ad_FS_TYPESLOW;		// Tiny feet
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '24 0 10';		// Bite attack offset
	self.ad_deathstring = " was mauled by a Rottweiler\n";

	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '300 0 200';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPDOGNEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPDOGFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_DogCheckAttack;
	self.ad_th_stand = ad_dog_stand1;
	self.ad_th_walk = ad_dog_walk1;
	self.ad_th_run = ad_dog_run1;
	self.ad_th_pain = ad_dog_pain;
	self.ad_th_die = ad_dog_die;
	self.ad_th_melee = ad_dog_atta1;
	self.ad_th_jump = ad_dog_leap1;
	self.ad_th_jumpexit = ad_dog_leap8;

	self.ad_classtype = ad_CT_MONDOG;
	self.ad_classgroup = ad_CG_DOG;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
