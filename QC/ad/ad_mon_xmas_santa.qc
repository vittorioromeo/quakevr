void() ad_santa_stand1 = [ $stand1, ad_santa_stand2 ] {ad_monster_idle_sound();ad_ai_stand();};
void() ad_santa_stand2 = [ $stand2, ad_santa_stand3 ] {ad_ai_stand();};
void() ad_santa_stand3 = [ $stand3, ad_santa_stand4 ] {ad_ai_stand();};
void() ad_santa_stand4 = [ $stand4, ad_santa_stand5 ] {ad_ai_stand();};
void() ad_santa_stand5 = [ $stand5, ad_santa_stand6 ] {ad_ai_stand();};
void() ad_santa_stand6 = [ $stand6, ad_santa_stand1 ] {ad_ai_stand();};

