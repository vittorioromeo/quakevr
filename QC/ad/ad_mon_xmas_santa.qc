//----------------------------------------------------------------------
void() ad_santa_trigger =
{
	// Trigger Once
	if (self.waitmin > time) return;
	self.waitmin = ad_LARGE_TIMER;
	self.use = ad_SUB_Null;
	
	// "My dear boy, you saved me!"
	sound(self, ad_CHAN_WEAPON, self.noise2, 1, ad_ATTN_NORM);
	
	// Fire all triggers/sounds/messages
	ad_SUB_UseTargets();
	
	// Fade out santa (+delete model)
	self.think = ad_model_fade;
	self.nextthink = time + 2 + random();
	self.ltime = self.nextthink;
};

//----------------------------------------------------------------------
void() ad_santa_seated =
{
	// Keep resetting health/touch function
	self.health = self.max_health;
	self.use = ad_santa_trigger;
	if (random() < 0.5) ad_santa_seatA1();
	else ad_santa_seatB1();
};

