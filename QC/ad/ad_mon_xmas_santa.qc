void() ad_santa_seatA2 = [ $sitA2, ad_santa_seatA3 ] {};
void() ad_santa_seatA3 = [ $sitA3, ad_santa_seatA4 ] {};
void() ad_santa_seatA4 = [ $sitA4, ad_santa_seatA5 ] {};
void() ad_santa_seatA5 = [ $sitA5, ad_santa_seatA6 ] {};
void() ad_santa_seatA6 = [ $sitA6, ad_santa_seatA7 ] {};
