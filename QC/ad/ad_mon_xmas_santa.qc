//======================================================================
// MELEE : Sack of Presents
//======================================================================
void() ad_SantaMelee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);	// + ai_face()
	ad_ai_damagebreakable(50);
	if (!(ad_ai_checkmelee(ad_MONAI_MELEESANTA,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return; // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	sound(self, ad_CHAN_WEAPON, "xmas/santa/sack_hit.wav", 1, ad_ATTN_NORM);

	// Sack attack is strong (1-60)
	ad_ldmg = (random() + random() + random()) * 20;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Spawn blood at sack
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
	// Lots of blood and gore
	ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
	ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
};

//----------------------------------------------------------------------
void() ad_santa_sack1 = [ $sack1, ad_santa_sack2 ] {ad_ai_face();};
void() ad_santa_sack2 = [ $sack2, ad_santa_sack3 ] {};
void() ad_santa_sack3 = [ $sack3, ad_santa_sack4 ] {ad_ai_face();};
void() ad_santa_sack4 = [ $sack4, ad_santa_sack5 ] {ad_ai_face();
	// This sound is exactly 0.4s long, with hit to complete
	sound(self, ad_CHAN_WEAPON, "xmas/santa/sack_swing.wav", 1, ad_ATTN_NORM);
};
void() ad_santa_sack5 = [ $sack5, ad_santa_sack6 ] {ad_ai_charge(10);};
void() ad_santa_sack6 = [ $sack6, ad_santa_sack7 ] {ad_ai_charge(10);};
void() ad_santa_sack7 = [ $sack7, ad_santa_sack8 ] {ad_ai_charge(10);};
void() ad_santa_sack8 = [ $sack8, ad_santa_sack9 ] {ad_SantaMelee();};
void() ad_santa_sack9 = [ $sack9, ad_santa_sack10 ] {};
void() ad_santa_sack10 = [ $sack10, ad_santa_run1 ] {
	// Check if snowman is within range to attack again
	if (ad_ai_checkmelee(ad_MONAI_MELEESANTA,ad_FALSE) && self.enemy.health > 0) {
		if (self.health > 0) self.think = ad_santa_sack3;
	}
};

//======================================================================
// RANGE : Rocket Gun
//======================================================================
void() ad_Santa_FireSnow =
{
	local vector ad_org, ad_dir, ad_spot1, ad_spot2;
	
	// Keep adding up projectile counter
	self.ad_attack_chance = self.ad_attack_chance + 1;
	
	// Lit up that barrel
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_SANTAPROJ + (ad_skill * ad_SPEED_SANTASKILL);
	sound (self, ad_CHAN_WEAPON, "xmas/santa/fire.wav", 1, ad_ATTN_NORM);	

	// Keep tracking enemy origin (similar to wizards)
	ad_ai_trackenemy();

	// Calculate the center of the gun
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	// Work out projectil direction
	ad_dir = normalize(self.ad_attack_track - ad_org);
	
	// Barrel 1
	ad_spot1 = ad_org + v_right*6;
	ad_spot2 = normalize((self.ad_attack_track+v_right*6) - ad_spot1);
	ad_launch_projectile (ad_spot1, ad_spot2, ad_CT_PROJ_SANTA, self.ad_attack_speed);
	
	// Barrel 2
	ad_spot1 = ad_org - v_right*6;
	ad_spot2 = normalize((self.ad_attack_track-v_right*6) - ad_spot1);
	ad_launch_projectile (ad_spot1, ad_spot2, ad_CT_PROJ_SANTA, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_santa_snow1 = [ $attack1, ad_santa_snow2 ] {ad_ai_trackenemy();
	// First 0.2s is repeatable to get machine gun sound
	sound(self, ad_CHAN_WEAPON, "xmas/santa/fire.wav", 1, ad_ATTN_NORM);
};
void() ad_santa_snow2 = [ $attack2, ad_santa_snow3 ] {ad_ai_trackenemy();};
void() ad_santa_snow3 = [ $attack3, ad_santa_snow4 ] {ad_Santa_FireSnow();};
void() ad_santa_snow4 = [ $attack4, ad_santa_run1 ] {ad_ai_trackenemy();
	// Anymore projectiles to fire?
	if (self.ad_attack_chance < ad_MONAI_SANTAMAX) {
		// Is the player still visible?
		if ( ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE) ) {
			self.ad_attack_timer = time + 0.8;
		}
		// Is the enemy in view timer still active?
		if (self.ad_attack_timer > time) self.think = ad_santa_snow1;
	}	
};

void() ad_santa_snowstart =
{
	self.ad_attack_track = self.enemy.origin;
	self.ad_attack_chance = self.ad_attack_timer = 0;
	ad_santa_snow1();
};

//======================================================================
// PAIN : quick reflection
//======================================================================
void() ad_santa_painA1 = [ $painA1, ad_santa_painA2 ] {};
void() ad_santa_painA2 = [ $painA2, ad_santa_painA3 ] {};
void() ad_santa_painA3 = [ $painA3, ad_santa_painA4 ] {};
void() ad_santa_painA4 = [ $painA4, ad_santa_painA5 ] {};
void() ad_santa_painA5 = [ $painA5, ad_santa_run1 ] {};

//----------------------------------------------------------------------
void() ad_santa_painB1 = [ $painB1, ad_santa_painB2 ] {};
void() ad_santa_painB2 = [ $painB2, ad_santa_painB3 ] {};
void() ad_santa_painB3 = [ $painB3, ad_santa_painB4 ] {};
void() ad_santa_painB4 = [ $painB4, ad_santa_painB5 ] {};
void() ad_santa_painB5 = [ $painB5, ad_santa_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_santa_pain =
{
	// Good santa cannot feel pain or die
	if (self.spawnflags & ad_MON_SANTA_GOOD) return;
	
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
			// Randomly pick which pain animation to play
			if (random() < 0.8) ad_santa_painA1 ();
			else {
				ad_santa_painB1 ();
				self.ad_pain_finished = time + 2;
			}
		}
	}
};

//======================================================================
// Typical forward/backward death animation
//======================================================================
void() ad_santa_die1 =[ $death1, ad_santa_die2] {};
void() ad_santa_die2 =[ $death2, ad_santa_die3] {ad_monster_check_gib();};
void() ad_santa_die3 =[ $death3, ad_santa_die4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_santa_die4 =[ $death4, ad_santa_die5] {};
void() ad_santa_die5 =[ $death5, ad_santa_die6] {};
void() ad_santa_die6 =[ $death6, ad_santa_die7] {};
void() ad_santa_die7 =[ $death7, ad_santa_die8] {};
void() ad_santa_die8 =[ $death8, ad_santa_die9] {};
void() ad_santa_die9 =[ $death9, ad_santa_die10] {ad_monster_death_postcheck();};
void() ad_santa_die10 =[ $death10, ad_santa_die10] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_santa_dieb1 =[ $bdeath1, ad_santa_dieb2] {};
void() ad_santa_dieb2 =[ $bdeath2, ad_santa_dieb3] {ad_monster_check_gib();};
void() ad_santa_dieb3 =[ $bdeath3, ad_santa_dieb4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_santa_dieb4 =[ $bdeath4, ad_santa_dieb5] {};
void() ad_santa_dieb5 =[ $bdeath5, ad_santa_dieb6] {};
void() ad_santa_dieb6 =[ $bdeath6, ad_santa_dieb7] {};
void() ad_santa_dieb7 =[ $bdeath7, ad_santa_dieb8] {};
void() ad_santa_dieb8 =[ $bdeath8, ad_santa_dieb9] {ad_ai_back(4);ad_monster_death_postcheck();};
void() ad_santa_dieb9 =[ $bdeath9, ad_santa_dieb9] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_santa_die =
{
	// Good santa cannot feel pain or die
	if (self.spawnflags & ad_MON_SANTA_GOOD) return;
	
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);

		// Pick a random fall direction
		if (random() > 0.5) ad_santa_die1 ();
		else ad_santa_dieb1 ();
	}
};

/*======================================================================
QUAKED monster_santa (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_xmas_santa =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/xmas/mon_santa.mdl";		// Big Sack Man!
	self.ad_headmdl = "progs/xmas/h_santa.mdl";	// Pointy Face
	self.ad_gib1mdl = "progs/xmas/gib_santagun.mdl";
	self.ad_gib2mdl = "progs/xmas/gib_santasack.mdl";
	self.ad_gib3mdl = "progs/xmas/gib_snowball.mdl";	// Snowballs
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	self.ad_gib2sound = ad_GIB_IMPACT_WOOD;

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (ad_MODEL_PROJ_SNOWBALL);

	// Idle/Sight sounds for GOOD/EVIL santa
	if (self.spawnflags & ad_MON_SANTA_GOOD) {
		self.ad_idle_sound = "xmas/santa/good_hohoho.wav";
		precache_sound (self.ad_idle_sound);
		self.ad_sight_sound = "xmas/santa/good_hohoho.wav";
		precache_sound (self.ad_sight_sound);	
		// Touch trigger - "My dear boy, you saved me!"
		self.noise2 = "xmas/santa/good_saved.wav";
		precache_sound (self.noise2);
	}
	else {
		// Evil santa has combat idle sounds
		self.ad_idle_sound = "xmas/santa/hohoho.wav";	// Slow ho-ho-ho
		self.ad_idle_sound2 = "xmas/santa/laugh1.wav";	// long laugh
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);
		self.ad_idle_soundcom = "xmas/santa/laugh3_com.wav";
		self.ad_idle_soundcom2 = "xmas/santa/hohoho.wav";
		precache_sound (self.ad_idle_soundcom);
		precache_sound (self.ad_idle_soundcom2);
		// Sight sounds - "Come sit on santa's lap little human!"
		self.ad_sight_sound = "xmas/santa/sight.wav";
		precache_sound (self.ad_sight_sound);
	}
	
	// Attack melee/range
	precache_sound ("xmas/santa/sack_swing.wav");
	precache_sound ("xmas/santa/sack_hit.wav");
	precache_sound ("xmas/santa/fire.wav");
	
	// precache sight, pain and death (changes on type)
	self.ad_pain_sound = "xmas/santa/pain1.wav";
	self.ad_pain_sound2 = "xmas/santa/pain2.wav";
	// Fading out slow ho-ho-ho death sound
	self.ad_death_sound = "xmas/santa/death2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	precache_sound (self.ad_death_sound);

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)		

	if (self.health < 1) self.health = 1200;
	self.ad_gibhealth = -60;			// Difficult to gib
	self.ad_blockudeath = ad_TRUE;		// no humanoid death sound
	self.ad_gibbed = ad_FALSE;			// Still in one peice
	self.ad_pain_flinch = 200;			// Strong pain threshold
	self.ad_pain_timeout = 2;			// Stop constant pain
	self.ad_infightextra = 8;			// Does not like infighting
	self.ad_pain_longanim = ad_FALSE;		// No long pain animation
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	self.ad_steptype = ad_FS_TYPEHEAVY;	// Giant boots!
	self.ad_poisonous = ad_FALSE;			// Not Supported
	self.ad_attack_offset = '28 22 26';// End of gun
	self.ad_attack_rage = ad_TRUE;		// Not in combat yet
	self.ad_deathstring = " was wrapped up by Santa\n";
	
	// Setup Ammo Resistance
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0.5;
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles

	// Pain/Death functions
	self.ad_th_pain = ad_santa_pain;
	self.ad_th_die = ad_santa_die;

	// Check for GOOD Santa setup?
	if (self.spawnflags & ad_MON_SANTA_GOOD) {
		// No targetname = no trigger!
		if (self.targetname == "") {
			dprint("\b[GOOD SANTA]\b Missing targetname name!\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			return;
		}
		// Setup default rescue message
		self.noise = ad_SOUND_EMPTY;
		if (self.message == "")
			 self.message = "You have rescued Santa!\nfrom the claws of hell!\n";
		 // Nobody should be trying to kill good santa, WTF!?!
		self.ad_resist_shells = self.ad_resist_nails = 1.0;
		self.ad_resist_rockets = self.ad_resist_cells = 1.0;
		self.ad_nomonstercount = ad_TRUE;
		self.health = self.max_health = ad_MEGADEATH;
		self.ad_gibhealth = ad_MON_NEVERGIB;
		self.ad_exactskin = 1;
		// Direct every state to the sit function
		self.ad_th_stand = ad_santa_seated;
		self.ad_th_walk = ad_santa_seated;
		self.ad_th_run = ad_santa_seated;
		self.waitmin = 0;
	}
	else {
		// Default EVIL Santa!
		self.ad_th_checkattack = ad_SantaCheckAttack;
		self.ad_th_stand = ad_santa_stand1;
		self.ad_th_walk = ad_santa_walk1;
		self.ad_th_run = ad_santa_run1;
		self.ad_th_melee = ad_santa_sack1;
		self.ad_th_missile = ad_santa_snowstart;
	}
		
	self.ad_classtype = ad_CT_MONSANTA;
	self.ad_classgroup = ad_CG_XMAS;
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();	
};