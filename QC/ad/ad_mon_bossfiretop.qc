/*==============================================================================
Chthon (Firetop Mountain Version)
==============================================================================*/
$frame rise1 rise2 rise3 rise4 rise5 rise6 rise7 rise8 rise9 rise10
$frame rise11 rise12 rise13 rise14 rise15 rise16 rise17 

$frame walk1 walk2 walk3 walk4 walk5 walk6 walk7 walk8
$frame walk9 walk10 walk11 walk12 walk13 walk14 walk15
$frame walk16 walk17 walk18 walk19 walk20 walk21 walk22
$frame walk23 walk24 walk25 walk26 walk27 walk28 walk29 walk30 walk31

$frame death1 death2 death3 death4 death5 death6 death7 death8 death9

$frame attack1 attack2 attack3 attack4 attack5 attack6 attack7 attack8
$frame attack9 attack10 attack11 attack12 attack13 attack14 attack15
$frame attack16 attack17 attack18 attack19 attack20 attack21 attack22
$frame attack23

$frame shocka1 shocka2 shocka3 shocka4 shocka5 shocka6 shocka7 shocka8
$frame shocka9 shocka10 

$frame shockb1 shockb2 shockb3 shockb4 shockb5 shockb6

$frame shockc1 shockc2 shockc3 shockc4 shockc5 shockc6 shockc7 shockc8 
$frame shockc9 shockc10

float ad_FTOP_IDLE = 1;
float ad_FTOP_ATTACK = 2;

void(vector ad_orgofs) ad_ftop_fire;
//===========================================================================
void() ad_ftop_track =
{
	// Find a player
	if (self.enemy == world) {
		self.enemy = find(world, classname, "player");
		// reset enemy if no player found!
		if (!self.enemy) self.enemy = world;
	}
	
	// Check for any no combat conditions
	if (self.enemy.flags & ad_FL_NOTARGET) self.enemy = world;
	else if (ad_intermission_running > 0) self.enemy = world;
	else if (ad_cinematic_running > 0) self.enemy = world;
	else if (self.enemy.health < 1) self.enemy = world;
		
	// Update particle effect around base of Chthon
	makevectors(self.angles);
	ad_particle_debuff(self.origin+v_forward*32, 96, rint(10+random()*40), ad_PARTICLE_BURST_FIRE);

	// Make sure function keeps going
	self.nextthink = time + 0.1;
	// Check for enemy
	if (self.enemy == world) {
		// Check for animation frame reset
		if (self.state == ad_FTOP_ATTACK) self.ad_walkframe = 0;
		self.think = self.ad_th_stand;
	}
	else {
		// Check for animation frame reset
		if (self.state == ad_FTOP_IDLE) self.ad_walkframe = 0;
		self.think = self.ad_th_run;
	}
};

//----------------------------------------------------------------------
void() ad_ftop_idleframe =
{
	// If dead, no more updates
	if (self.deadflag > ad_DEAD_NO) return;
	
	// Always reset HP (super high)
	self.health = self.max_health;
	self.takedamage = ad_DAMAGE_YES;
	self.state = ad_FTOP_IDLE;
	
	// Update frame
	self.frame = $walk1 + self.ad_walkframe;
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 30) self.ad_walkframe = 0;
	
	// Check for enemies
	ad_ftop_track();
};

//----------------------------------------------------------------------
void() ad_ftop_attackframe =
{
	// If dead, no more updates
	if (self.deadflag > ad_DEAD_NO) return;
	
	// Always reset HP (super high)
	self.health = self.max_health;
	// Slow down damage/pain functionality
	if (self.ad_pain_finished < time) self.takedamage = ad_DAMAGE_YES;
	self.state = ad_FTOP_ATTACK;
	
	// Update frame
	self.frame = $attack1 + self.ad_walkframe;
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 22) self.ad_walkframe = 0;
	
	// Check for any frame conditions
	if (self.ad_walkframe == 8) ad_ftop_fire('100 50 250');
	else if (self.ad_walkframe == 19) ad_ftop_fire('100 -50 250');
	
	// Check for enemies
	ad_ftop_track();
	if (self.enemy) ad_ai_face();
};

//===========================================================================
void(vector ad_orgofs) ad_ftop_fire =
{
	local vector ad_offang, ad_org, ad_vec, ad_dir, ad_mdest, ad_avel;
	local float ad_projlen;

	// No enemy or dead?
	if (!self.enemy) return;
	if (self.deadflag > ad_DEAD_NO) return;
	
	sound (self, ad_CHAN_WEAPON, "chthon/attack1.wav", 1, ad_ATTN_NORM);
	ad_offang = vectoangles (self.enemy.origin - self.origin);	
	makevectors (ad_offang);
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	
	// Skill level adjustment (easy=250, normal=300, hard=350, nm=400)
	self.ad_attack_speed = ad_SPEED_LAVABALL + (ad_skill*ad_SPEED_LAVASKILL);
	
	// Lead the missile on hard mode (This formula is not perfect) 
	// There are plenty of missiles that go in strange directions, 
	// especially if the player strafes a lot from side to side.
	if (ad_skill > ad_SKILL_NORMAL) {
		ad_projlen = vlen(self.enemy.origin - ad_org) / self.ad_attack_speed;
		ad_vec = self.enemy.velocity;
		ad_vec_z = 0;
		ad_mdest = self.enemy.origin + ad_projlen * ad_vec;		
	}
	else ad_mdest = self.enemy.origin;
	
	ad_dir = normalize (ad_mdest - ad_org);
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Missile (ad_org, ad_dir, ad_avel, ad_CT_PROJ_FIRETOP, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_ftop_lightning =
{
	if (!self.ad_movetarget2) return;
	if (!self.ad_movetarget3) return;

	self.pos1 = self.ad_movetarget2.origin;
	self.pos2 = self.ad_movetarget3.origin;
	
	// compensate for length of bolt
	self.pos2 = self.pos2 - normalize(self.pos2 - self.pos1) * 100;
	
	// Generate the lightning effect
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING3);
	WriteEntity (ad_MSG_BROADCAST, self);
	WriteCoord (ad_MSG_BROADCAST, self.pos1_x);
	WriteCoord (ad_MSG_BROADCAST, self.pos1_y);
	WriteCoord (ad_MSG_BROADCAST, self.pos1_z);
	WriteCoord (ad_MSG_BROADCAST, self.pos2_x);
	WriteCoord (ad_MSG_BROADCAST, self.pos2_y);
	WriteCoord (ad_MSG_BROADCAST, self.pos2_z);
};

//===========================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_ftop_pain = {
	// Stop pain reaction and prevent damage
	self.ad_pain_finished = time + 3;
	self.takedamage = ad_DAMAGE_NO;
};

//----------------------------------------------------------------------
void() ad_ftop_death1 = [$death1, ad_ftop_death2] {
	ad_ftop_lightning();
	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
	if (self.noise3 != "") ad_trigger_strs(self.noise3, self);
};
void() ad_ftop_death2 = [$death2, ad_ftop_death3] {ad_ftop_lightning();};
void() ad_ftop_death3 = [$death3, ad_ftop_death4] {ad_ftop_lightning();};
void() ad_ftop_death4 = [$death4, ad_ftop_death5] {};
void() ad_ftop_death5 = [$death5, ad_ftop_death6] {};
void() ad_ftop_death6 = [$death6, ad_ftop_death7] {};
void() ad_ftop_death7 = [$death7, ad_ftop_death8] {};
void() ad_ftop_death8 = [$death8, ad_ftop_death9] {};
void() ad_ftop_death9 = [$death9, ad_ftop_death10] {
	sound (self, ad_CHAN_BODY, "chthon/lavasplash.wav", 1, ad_ATTN_NORM);
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LAVASPLASH);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
};
void() ad_ftop_death10 = [$death9, ad_ftop_death11] {
	killed_monsters = killed_monsters + 1;
	WriteByte (ad_MSG_ALL, ad_SVC_KILLEDMONSTER);
	self.health = -1;
	ad_entity_hide(self);
};
void() ad_ftop_death11 = { remove(self); };

