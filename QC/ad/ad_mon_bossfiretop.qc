//----------------------------------------------------------------------
void() ad_ftop_deathsequence =
{
	self.use = ad_SUB_Null;
	self.enemy = world;
	self.takedamage = ad_DAMAGE_NO;
	self.deadflag = ad_DEAD_DEAD;

	// Find electrode start/end points
	if (self.noise1 != "") 
		self.ad_movetarget2 = find(world, targetname, self.noise1);
	if (self.noise2 != "") 
		self.ad_movetarget3 = find(world, targetname, self.noise2);
	
	sound (self, ad_CHAN_WEAPON, "misc/power.wav", 1, ad_ATTN_NORM);
	sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);

	self.ad_attack_finished = time + 1.5;
	self.lip = random();
	if (self.lip < 0.3) ad_ftop_shocka1();
	else if (self.lip < 0.6) ad_ftop_shockb1();
	else ad_ftop_shockc1();
};

//===========================================================================
void() ad_ftop_rise1	=[	$rise1, ad_ftop_rise2 ] {
	sound (self, ad_CHAN_WEAPON, "chthon/lavasplash.wav", 1, ad_ATTN_NORM);};
void() ad_ftop_rise2	=[	$rise2, ad_ftop_rise3 ] {
	sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_NORM);};
void() ad_ftop_rise3	=[	$rise3, ad_ftop_rise4 ] {};
void() ad_ftop_rise4	=[	$rise4, ad_ftop_rise5 ] {};
void() ad_ftop_rise5	=[	$rise5, ad_ftop_rise6 ] {};
void() ad_ftop_rise6	=[	$rise6, ad_ftop_rise7 ] {};
void() ad_ftop_rise7	=[	$rise7, ad_ftop_rise8 ] {};
void() ad_ftop_rise8	=[	$rise8, ad_ftop_rise9 ] {};
void() ad_ftop_rise9	=[	$rise9, ad_ftop_rise10 ] {};
void() ad_ftop_rise10	=[	$rise10, ad_ftop_rise11 ] {};
void() ad_ftop_rise11	=[	$rise11, ad_ftop_rise12 ] {};
void() ad_ftop_rise12	=[	$rise12, ad_ftop_rise13 ] {};
void() ad_ftop_rise13	=[	$rise13, ad_ftop_rise14 ] {};
void() ad_ftop_rise14	=[	$rise14, ad_ftop_rise15 ] {};
void() ad_ftop_rise15	=[	$rise15, ad_ftop_rise16 ] {};
void() ad_ftop_rise16	=[	$rise16, ad_ftop_rise17 ] {};
void() ad_ftop_rise17	=[	$rise17, ad_ftop_idleframe ] {
	self.state = ad_FTOP_IDLE;
	self.takedamage = ad_DAMAGE_YES;
	self.ad_th_stand = ad_ftop_idleframe;
	self.ad_th_run = ad_ftop_attackframe;
	self.ad_th_pain = ad_ftop_pain;
	self.ad_th_die = ad_ftop_deathsequence;
};

//----------------------------------------------------------------------
void() ad_ftop_wakeup =
{
	self.skin = 1;		// Dark lava skin
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	self.velocity = '0 0 0';
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size

	self.enemy = ad_activator;			// Setup trigger enemy
	self.use = ad_ftop_deathsequence;	// Final death trigger event
	
	// DP particle spark and smoke effect to Chthon, originally done by Seven
	if (ad_ext_dppart) self.ad_traileffectnum = particleeffectnum("TR_BOSSCHTHON");
	
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LAVASPLASH);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);

	ad_ftop_rise1 ();
};

/*======================================================================
 QUAKED monster_firetopboss (1 0.25 0.25) (-128 -128 -24) (128 128 256)
======================================================================*/
void() ad_monster_firetopboss =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_bosschthon.mdl";
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_LAVA);

	precache_sound ("chthon/attack1.wav");
	precache_sound ("weapons/rocket1i.wav");
	precache_sound ("misc/power.wav");

	self.ad_pain_sound = "chthon/pain1.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "chthon/death1.wav";
	precache_sound (self.ad_death_sound);

	// Rise from lava roar + splash
	self.ad_sight_sound = "chthon/sight1.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound ("chthon/lavasplash.wav");

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_bbmins = '-128 -128 -24';		// has own entity setup
	self.ad_bbmaxs = '128 128 256';
	self.ad_bboxtype = ad_BBOX_CUSTOM;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	self.ad_poisonous = ad_FALSE;			// Cannot be poisonous
	self.ad_deathstring = " was destroyed by the Firetop Guardian\n";
	self.ad_lastorigin = self.origin;	// Origin for camera interpolation

	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	self.health = self.max_health = ad_MEGADEATH;
	self.takedamage = ad_DAMAGE_NO;
	self.ad_classtype = ad_CT_MONFIRETOP;
	self.ad_classgroup = ad_CG_BOSS;
	self.ad_infightextra = 8;
	self.ad_pain_ignore = 1;
	self.yaw_speed = 20;			// Fast turner
	self.deadflag = ad_DEAD_NO;

	// Always reset Ammo Resistance to be consistent
	// The shamblers infront of the boss are suppose to be killed
	// by the boss and they fire lightning (cell damage)
	// If the boss is 100% ammo resist == no infighting
	// The health is reset everytime pain is received
	self.ad_resist_shells = self.ad_resist_nails = 1;
	self.ad_resist_rockets = self.ad_resist_cells = 0.9;
	self.ad_reflectnails = self.ad_bouncegrenade = ad_TRUE;
	
	total_monsters = total_monsters + 1;
	self.use = ad_ftop_wakeup;
};