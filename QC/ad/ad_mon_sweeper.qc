// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_sweeper.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
 Small floating robot which drops mines (model/animation by Benoit Stordeur)
 * QC was created for Bal's Hypnagogia project

  Interesting QC traits
  * All enemy states go through one function so drone sound is consistent
  * Can start with a blue shield and waits for trigger event (like seeker)
  * The laser version is designed for tight ceiling space area's
  * The sweeper will not pursue enemies, instead it prefers to wait
  * If the sweeper loses sight of the enemy for more than 20s, reset location
  * The mine attack is using the new rocket seeking system
  * The mine stops steering towards the enemy if too close
  * Extra checks are done for space below before firing mines

  Assets required to get this monster working in AD
    (model's in 'progs' and wav's in 'sound' sub directories)
  * mon_sweeper.mdl (complete model)
  * proj_sweeper1.mdl (Small 8x8x8 mine)
  * proj_sweeper2.mdl (hell knight like spike)
  * gib_sweeper1.mdl (middle piece with light)
  * gib_sweeper2.mdl (top rotating part with spikes)
  * gib_sweeper3.mdl (bottom rotating part)
  * gib_sweeper4.mdl (spike from top)

==============================================================================*/

// (000) 
$frame blank1

// (001-010) Stand by mode (spinning bottom part)
$frame stand1 stand2 stand3 stand4 stand5 stand6 stand7 stand8
$frame stand9 stand10

// (011-020) Opening up top spikes
$frame wakeup1 wakeup2 wakeup3 wakeup4 wakeup5 wakeup6 wakeup7 wakeup8
$frame wakeup9 wakeup10

// (021-030) Walking animation + top spikes
$frame walk1 walk2 walk3 walk4 walk5 walk6 walk7 walk8
$frame walk9 walk10

// (031-040) Open the middle part
$frame open1 open2 open3 open4 open5 open6 open7 open8
$frame open9 open10

// (041-050) Run animation
$frame run1 run2 run3 run4 run5 run6 run7 run8
$frame run9 run10

// (051-060) Spin Attack
$frame spin1 spin2 spin3 spin4 spin5 spin6 spin7 spin8
$frame spin9 spin10

// (061-070) Mine Attack
$frame mine1 mine2 mine3 mine4 mine5 mine6 mine7 mine8
$frame mine9 mine10

// (071-080) Idle 1 - spin + dance top spikes
$frame idleA1 idleA2 idleA3 idleA4 idleA5 idleA6 idleA7 idleA8
$frame idleA9 idleA10

// (081-090) Idle 2 - spin + tilt around body
$frame idleB1 idleB2 idleB3 idleB4 idleB5 idleB6 idleB7 idleB8
$frame idleB9 idleB10

// (091-100) Laser Attack
$frame laser1 laser2 laser3 laser4 laser5 laser6 laser7 laser8
$frame laser9 laser10

float ad_SW_STAND = 0;			// Bobbing up/down
float ad_SW_STAND2WALK = 1;	// Blending - raise up head arms
float ad_SW_STAND2RUN = 2;		// Blending - Open middle
float ad_SW_WALK = 5;			// Head tentacles up
float ad_SW_WALK2STAND = 6;	// Blending - lower head arms
float ad_SW_WALK2RUN = 7;		// Blending - Opein middle
float ad_SW_RUN = 10;			// Middle section opened
float ad_SW_RUN2STAND = 11;	// Blending - Close middle
float ad_SW_RUN2WALK = 12;		// Blending - Close middle
float ad_SW_ATTACKSPIN = 15;	// Spin attack from top
float ad_SW_ATTACKMINE = 16;	// Mine attack from bottom
float ad_SW_ATTACKBLOB = 20;	// Spin attack from bottom
float ad_SW_ATTACKLASER = 21;	// Laser attack from middle
float ad_SW_PAIN = 30;			// Quick Spin around
float ad_SW_DEATH = 31;		// Do nothing

// Size of each animation block
float ad_SW_ANIMBLEND = 9;
float ad_SW_ANIMBLOCK = 10;

void() ad_sweeper_fire_mine;
void(float ad_offset) ad_sweeper_fire_laser;
void(float ad_offset) ad_sweeper_fire_hazard;

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_sweeper_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
	}
};

//----------------------------------------------------------------------
void() ad_sweeper_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_sweeper_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
}

//----------------------------------------------------------------------
void() ad_sweeper_setup_attachment = 
{
	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_sweeper_create_attachment();
	self.ad_attachment.state = ad_STATE_ON;
	setmodel(self.ad_attachment, self.ad_weaponglow);
	self.ad_attachment.skin = 0;
}

//----------------------------------------------------------------------
void() ad_sweeper_update_attachment =
{
	setorigin(self.ad_attachment, self.origin);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = self.frame;
	self.ad_attachment.alpha = 0.3 + random()*0.7;
};

//======================================================================
void() ad_sweeper_frame = 
{
	// If sooty is dead, no more updates
	if (self.health < 1) return;
	if (self.state == ad_SW_DEATH) return;

	// Update the drone sound
	if (self.t_width < time) {
		self.t_width = time + 0.9;
		// Play on auto channel so it overlaps with existing sound
		sound (self, ad_CHAN_AUTO, "sweeper/idledrone1.wav", 0.5, ad_ATTN_WEAPON);
	}

	// Setup function loop
	self.nextthink = time + 0.1;
	self.think = ad_sweeper_frame;

	// Beginning of annimation block (out of combat only)
	if (self.ad_walkframe == 0 && !self.enemy) ad_monster_idle_sound();
	
	//----------------------------------------------------------------------
	if (self.state == ad_SW_WALK2STAND) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.ad_walkframe = self.ad_walkframe + 2;
		if (self.ad_walkframe >= ad_SW_ANIMBLEND) {
			self.ad_idlebusy = time + 0.5;
			self.ad_walkframe = 0;
			self.velocity = '0 0 0';
			self.state = ad_SW_STAND;
		}
		else self.frame = $wakeup1 + (ad_SW_ANIMBLEND - self.ad_walkframe);
	}
	else if (self.state == ad_SW_RUN2STAND) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.ad_walkframe = self.ad_walkframe + 2;
		if (self.ad_walkframe >= ad_SW_ANIMBLEND) {
			self.ad_idlebusy = time + 0.5;
			self.ad_walkframe = 0;
			self.velocity = '0 0 0';
			self.state = ad_SW_STAND;
		}
		else self.frame = $open1 + (ad_SW_ANIMBLEND - self.ad_walkframe);
	}
	if (self.state == ad_SW_STAND) {
		// Standing idle has gentle bobbing up and down
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_FLY;
		
		// Check for idle animations (shield = exception)
		if (self.ad_walkframe == 0 && !(self.spawnflags & ad_MON_SWEEPER_SHIELD)) {
			// Reset standing frame
			self.ad_idleframe = $stand1;
			// Check for idle animations
			if (random() < ad_MON_IDLE_ANIMATION && self.ad_idlebusy < time) {
				self.ad_idlebusy = time + 0.5;
				if (self.lefty) self.ad_idleframe = $idleA1; 
				else self.ad_idleframe = $idleB1;
				self.lefty = 1 - self.lefty;
			}
		}
		// Update frame
		self.frame = self.ad_idleframe + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) self.ad_walkframe = 0;

		// Check velocity movement before bobbing up/down
		if (self.velocity_x == 0 && self.velocity_y == 0) {
			if (self.ad_attack_timer < time) {
				self.ad_attack_timer = time + 1;
				if (self.lip < 1) self.lip = 1;
				else self.lip = -1;
				self.velocity_z = 4 * self.lip;
			}
		}
		else {
			// Slowdown the velocity (movement = no friction)
			self.velocity = self.velocity * self.ad_velocityfriction;
			if (self.velocity_x > -5 && self.velocity_x < 5) self.velocity_x = 0;
			if (self.velocity_y > -5 && self.velocity_y < 5) self.velocity_y = 0;
			if (self.velocity_z > -5 && self.velocity_z < 5) self.velocity_z = 0;
			// Don't go into attack straight away when velocity is active
			self.ad_attack_finished = time + 0.5;
		}
		// Update shield or check for enemies
		if (self.spawnflags & ad_MON_SWEEPER_SHIELD) ad_sweeper_update_attachment();
		else ad_ai_stand();	
	}
	//----------------------------------------------------------------------
	if (self.state == ad_SW_STAND2WALK) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.ad_walkframe = self.ad_walkframe + 2;
		if (self.ad_walkframe >= ad_SW_ANIMBLEND) {
			self.ad_walkframe = 0;
			self.state = ad_SW_WALK;
		}
		else self.frame = $wakeup1 + self.ad_walkframe;
	}
	else if (self.state == ad_SW_RUN2WALK) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.ad_walkframe = self.ad_walkframe + 2;
		if (self.ad_walkframe >= ad_SW_ANIMBLEND) {
			self.ad_walkframe = 0;
			self.state = ad_SW_WALK;
		}
		else self.frame = $open1 + (ad_SW_ANIMBLEND - self.ad_walkframe);
	}
	if (self.state == ad_SW_WALK) {
		// Movement is steps, not velocity
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.velocity = '0 0 0';
		self.frame = $walk1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) self.ad_walkframe = 0;
		ad_ai_walk(6);
	}
	//----------------------------------------------------------------------
	if (self.state == ad_SW_STAND2RUN) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.ad_walkframe = self.ad_walkframe + 2;
		if (self.ad_walkframe >= ad_SW_ANIMBLEND) {
			self.ad_walkframe = 0;
			self.state = ad_SW_RUN;
		}
		else self.frame = $open1 + self.ad_walkframe;
	}
	else if (self.state == ad_SW_WALK2RUN) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.ad_walkframe = self.ad_walkframe + 2;
		if (self.ad_walkframe >= ad_SW_ANIMBLEND) {
			self.ad_walkframe = 0;
			self.state = ad_SW_RUN;
		}
		else self.frame = $open1 + self.ad_walkframe;
	}
	if (self.state == ad_SW_RUN) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.velocity = '0 0 0';
		self.frame = $run1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) self.ad_walkframe = 0;
		ad_enemy_vis = ad_visible(ad_SUB_entEnemyTarget());
		if (ad_enemy_vis) ad_ai_run(12);
		else ad_ai_run(0);
		if (self.ad_movespeed != 0) ad_ai_face();
	}

	//----------------------------------------------------------------------
	if (self.state == ad_SW_PAIN) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		// Speed up spin animation (5 frames)
		self.ad_walkframe = self.ad_walkframe + 2;
		// End of pain animation?
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) {
			self.angles_x = self.angles_z = 0;	// reset pitch/roll
			self.ad_walkframe = 0;					// reset animation
			self.state = ad_SW_RUN;				// Back to running
		}
		else {
			// Keep moving in the pitch/roll direction
			self.angles = self.angles + (self.pos1 * 0.25);
			// Update spin animation
			self.frame = $spin1 + self.ad_walkframe;
		}
	}
	else if (self.state == ad_SW_ATTACKSPIN) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.frame = $spin1 + self.ad_walkframe;
		if (self.ad_walkframe < 2) ad_ai_trackenemy();
		if (self.ad_walkframe > 0 && self.ad_walkframe < 8) {
			ad_sweeper_fire_hazard(self.ad_walkframe - 4);
		}
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) {
			self.ad_walkframe = 0;					// reset animation
			self.state = ad_SW_RUN;				// Back to running
		}
	}
	else if (self.state == ad_SW_ATTACKMINE) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.frame = $mine1 + self.ad_walkframe;
		if (self.ad_walkframe == 0) self.ad_attack_track = self.enemy.origin;
		else if (self.ad_walkframe > 0 && self.ad_walkframe < 3) ad_ai_trackenemy();
		if (self.ad_walkframe == 3) ad_sweeper_fire_mine();
		
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) {
			self.ad_walkframe = 0;					// reset animation
			self.state = ad_SW_RUN;				// Back to running
		}
	}
	else if (self.state == ad_SW_ATTACKLASER) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.frame = $laser1 + self.ad_walkframe;
		ad_ai_trackenemy();
		// Laser projectiles : Skill EASY = 1, NORMAL = 2, HARD/NM = 3
		if (self.ad_walkframe == 3) ad_sweeper_fire_laser(0);
		else if (self.ad_walkframe == 5 && ad_skill > ad_SKILL_EASY) ad_sweeper_fire_laser(-2);
		else if (self.ad_walkframe == 7 && ad_skill > ad_SKILL_NORMAL) ad_sweeper_fire_laser(2);
		self.ad_walkframe = self.ad_walkframe + 1;
		if (self.ad_walkframe >= ad_SW_ANIMBLOCK) {
			self.ad_walkframe = 0;					// reset animation
			self.state = ad_SW_RUN;				// Back to running
		}
	}
};

//======================================================================
// All monster states (stand,walk etc) have to go through one function
// because the robot has a constant sound update at specific intervals
//
void() ad_sweeper_stand = { 
	self.ad_walkframe = 0;
	self.ad_idlebusy = time + 0.5;
	self.ad_idleframe = $stand1;
	if (self.state == ad_SW_WALK) self.state = ad_SW_WALK2STAND;
	else if (self.state == ad_SW_RUN) self.state = ad_SW_RUN2STAND;
	else self.state = ad_SW_STAND;
	if (self.spawnflags & ad_MON_SEEK_SHIELD) ad_sweeper_setup_attachment(); 
	ad_sweeper_frame();
};

void() ad_sweeper_walk = {
	self.ad_walkframe = 0;
	if (self.state == ad_SW_STAND) self.state = ad_SW_STAND2WALK;
	else if (self.state == ad_SW_RUN) self.state = ad_SW_RUN2WALK;
	else self.state = ad_SW_WALK;
	ad_sweeper_frame();
};

void() ad_sweeper_run = {
	self.ad_walkframe = 0;
	// First time in combat?
	if (self.ad_attack_chance) {
		self.ad_attack_chance = ad_FALSE;
		// Do no attack steaight away, slight pause
		self.ad_attack_finished = time + 0.3;
		self.ad_weaponstate = ad_TRUE;	// Default = mines/lasers
	}
	if (self.state == ad_SW_STAND) self.state = ad_SW_STAND2RUN;
	else if (self.state == ad_SW_WALK) self.state = ad_SW_WALK2RUN;
	else self.state = ad_SW_RUN; 
	ad_sweeper_frame();
};

void() ad_sweeper_fire = {
	self.ad_walkframe = 0; 
	self.ad_pain_finished = time + 1;
	// weaponstate set in SweeperCheckAttack
	if (self.ad_weaponstate) {
		// Can change mine to laser (spawnflags)
		if (self.spawnflags & ad_MON_SWEEPER_LASER) self.state = ad_SW_ATTACKLASER;
		else self.state = ad_SW_ATTACKMINE;
	}
	else self.state = ad_SW_ATTACKSPIN; 
	ad_sweeper_frame();
};

//======================================================================
void(float ad_offset) ad_sweeper_fire_hazard =
{
	local vector ad_org, ad_torg, ad_dir, ad_ang, ad_avel;
	local float ad_targetang, ad_haz_loop;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	// Play firing sound like hell knight (0.1s rapid fire)
	sound (self, ad_CHAN_WEAPON, "sweeper/hazard_fire.wav", 1, ad_ATTN_NORM);
	
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_meleeoffset);

	if (ad_skill < ad_SKILL_HARD) ad_haz_loop = 1;
	else ad_haz_loop = 2;
	while(ad_haz_loop > 0) {
		// Keep looping
		ad_haz_loop = ad_haz_loop - 1;
		// Workout target origin (self.enemy)
		ad_torg = ad_SUB_orgEnemyTarget();
		// Allow for large target area
		ad_torg_x = ad_torg_x + (ad_crandom() * 64);
		ad_torg_y = ad_torg_y + (ad_crandom() * 64);
		ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, ad_torg, ad_SPEED_SWEEPER);
		// Work out angle
		ad_ang = vectoangles(ad_torg - ad_org);
		ad_ang_x = -ad_targetang;	// Negative = upwards angle 
		makevectors (ad_ang);
		// fire plasma in arc pattern (offset)
		ad_dir = ( (v_forward * (1 + random()*0.5)) + (v_right * (ad_offset*0.1)) ) * ad_SPEED_SWEEPER;	
		// Some random angle rotation
		ad_avel = ad_vecrand(100,200,ad_FALSE);
		ad_Launch_Hazard(ad_org, ad_dir, ad_avel, ad_CT_PROJ_SWEEPER2);
	}
};

//----------------------------------------------------------------------
void(float ad_offset) ad_sweeper_fire_laser =
{
	local vector ad_org, ad_dir, ad_vec;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	// Always make sure there is no monster or obstacle in the way
	// Cannot use enemy entity direct, enemytarget will be active
	if ( !ad_visxray(ad_SUB_entEnemyTarget(), '0 0 0', '0 0 12', ad_FALSE) ) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);

	makevectors (self.angles);
	// Shift left/right 2+ lasers
	ad_org = self.origin + (v_right * ad_offset);

	// Aim high to catch jumping players
	ad_dir = ad_SUB_orgEnemyTarget() + '0 0 12';
	ad_vec = normalize(ad_dir - ad_org);
	// Variable laser speed, original unit was just 800 every skill
	self.ad_attack_speed = ad_SPEED_SWEEPERPROJ + (ad_skill * ad_SPEED_SWEEPERPROJSKILL);
	ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_LASER, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_sweeper_fire_mine =
{
	local vector ad_org, ad_dir;
	local float ad_veclen, ad_vecdown;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "sweeper/mine_launch.wav", 1, ad_ATTN_NORM);	

	// Maximum speed, initial speed set in Launch_Missile
	self.ad_attack_speed = ad_SPEED_SWEEPERPROJ + (ad_skill * ad_SPEED_SWEEPERPROJSKILL);

	// check for enemy origin (based on sight test)
	// if cannot see enemy fire at last known location
	ad_ai_trackenemy();

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	
	// Check for space below for downward force of mine/rocket
	traceline(self.origin, self.origin-'0 0 1024', ad_TRUE, self);
	ad_veclen = vlen(self.origin - trace_endpos);
	// Normalize (0-1) vector length (cap at 100%)
	if (ad_veclen > 100) ad_veclen = 100;
	// Workout base + random % of downward force
	ad_vecdown = (ad_veclen*0.004) + (random() * (ad_veclen*0.005));
	ad_dir = normalize(self.ad_attack_track - ad_org) + (-v_up * ad_vecdown);
	// Rocket, smoke and particles
	ad_Launch_Missile (ad_org, ad_dir, '400 0 0', ad_CT_PROJ_SWEEP1, self.ad_attack_speed);
	ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, self.origin+'0 0 -24', "");
	ad_SpawnProjectileSmoke(self.origin, 50, -25, -25);
};

//======================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_sweeper_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Always play a pain sound
	if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);

	// Spawn a pile of sparks and dust falling down
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	
	// Work out which direction the damage came from (enemy)
	self.pos2 = self.origin - ad_attacker.origin;
	self.pos1 = vectoangles(self.pos2);
	self.pos1_y = 0;
	
	// Start pain animation
	self.state = ad_SW_PAIN;
	self.ad_walkframe = 0;
	self.velocity = '0 0 0';
};

//======================================================================
void() ad_sweeper_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Final fireworks!
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound);

	// no more sweeper
	ad_entity_hide (self);
	self.state = ad_SW_DEATH;
	ad_sweeper_remove_attachment();
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// Metal and custom body parts
	self.ad_gibtype = ad_GIBTYPE_METAL;
	ad_ThrowGib(11, 1);						// middle piece with light
	ad_ThrowGib(12, 1 + rint(random()*2));		// top rotating part with spikes
	ad_ThrowGib(13, 2 + rint(random()*2));		// bottom rotating part
	ad_ThrowGib(14, 1 + rint(random()*2));		// spike from top
	ad_ThrowGib(15, 2 + rint(random()*3));		// Generic metal
};

//============================================================================
void() ad_sweeper_shieldon =
{
	self.takedamage = ad_DAMAGE_YES;	// Grenades bounce off
	self.ad_bouncegrenade = ad_TRUE;		// Warning to other monsters
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage
	// Visually show resistance and reduce damage taken
	self.ad_resist_shells = self.ad_resist_nails = 1;
	self.ad_resist_rockets = self.ad_resist_cells = 1;
};

//----------------------------------------------------------------------
void() ad_sweeper_shieldoff =
{
	self.takedamage = ad_DAMAGE_AIM;	// Grenades can make contact
	self.ad_bouncegrenade = ad_FALSE;		// Reset to default
	self.ad_reflectnails = ad_FALSE;		// Allow nail projectiles
	self.ad_reflectlightning = ad_FALSE;	// Allow lightning strikes
	self.ad_reflectplasma = ad_FALSE;		// Allow plasma projectiles
	self.ad_reflectaxe = ad_FALSE;		// Allow axe damage
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_cells = 0;
	self.ad_resist_rockets = -1;	// Double damage from grenades/rockets
};

//----------------------------------------------------------------------
void() ad_sweeper_shield = 
{
	// Setup particle emitter for shield effect
	self.ad_part_active = ad_PARTICLE_STYLE_FFIELD;
	self.ad_spr_frame = ad_PARTICLE_BURST_BLUE;
	self.ad_part_vol = '12 12 24';		// Bounding box volume
	self.ad_part_limit = 50;			// Medium amount of particles
	self.ad_part_life = 4;				// Longer lifetime
	self.ad_part_ofs = '0 0 0';		// Move up from monster origin
	self.ad_part_vel = '0 0 4';		// Move up from monster origin
	self.ad_part_emitter = ad_spawn_pemitter(self, self, self.ad_part_active, ad_PARTICLE_START_ON);
	// Back into (default) stand around loop
	ad_sweeper_stand();
};

//----------------------------------------------------------------------
void() ad_sweeper_wakeup =
{
	// Check for sudden death!
	if (self.health < 0) return;
	
	self.use = ad_SUB_Null;				// no re-trigger
	ad_sweeper_finish_attachment();		// Remove shield + spawnflag
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_SWEEPER_SHIELD);
	
	// Switch off shield sound
	sound (self, ad_CHAN_WEAPON, "ambience/power_off.wav", 1, ad_ATTN_NORM);
	// Switch OFF any particle emitter
	if (self.ad_part_emitter) ad_misc_particle_off(self.ad_part_emitter);
	
	// Check for any trigger off events (trigger_once)
	if (self.ad_target2 != "") ad_trigger_strs(self.ad_target2, self);
	self.ad_target2 = "";
	
	// Restore all think functions
	self.ad_th_stand = ad_sweeper_stand;
	self.ad_th_walk = ad_sweeper_walk;
	self.ad_th_run = ad_sweeper_run;
	self.ad_th_missile = ad_sweeper_fire;
	self.ad_th_pain = ad_sweeper_pain;
	self.ad_th_die = ad_sweeper_die;
	ad_sweeper_shieldoff();			// Ammo resist + reflection
	ad_monster_targets();				// Check for targets
};

/*======================================================================
QUAKED monster_sweeper (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_monster_sweeper =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_sweeper.mdl";			// Sentinel clone
//	self.headmdl = "progs/h_sweeper.mdl";		// Not used
	self.ad_weaponglow = "progs/mon_sweeper_glow.mdl";
	self.ad_gib1mdl = "progs/gib_sweeper1.mdl";	// middle piece with light
	self.ad_gib2mdl = "progs/gib_sweeper2.mdl";	// top rotating part with spikes
	self.ad_gib3mdl = "progs/gib_sweeper3.mdl";	// bottom rotating part
	self.ad_gib4mdl = "progs/gib_sweeper4.mdl";	// spike from top
	self.ad_gib5mdl = "progs/gib_metal1.mdl";		// generic metal chunk

	precache_model (self.mdl);			// Sweeper
	precache_model (self.ad_weaponglow);	// Glowing blue shield
//	precache_model (self.headmdl);		// Not used
	precache_model (self.ad_gib1mdl);		// middle piece with light
	precache_model (self.ad_gib2mdl);		// top rotating part with spikes
	precache_model (self.ad_gib3mdl);		// bottom rotating part
	precache_model (self.ad_gib4mdl);		// spike from top
	precache_model (self.ad_gib5mdl);		// generic metal chunk

	// Robot talktalk
	self.ad_idle_sound = "sweeper/idle1.wav";
	precache_sound (self.ad_idle_sound);

	// Constant drone sound (background)
	precache_sound ("sweeper/idledrone1.wav");
	
	// Alternative spawnflag, lasers instead of mines
	if (self.spawnflags & ad_MON_SWEEPER_LASER) {
		// red version (new)
		if (self.ad_exactskin == 0) self.ad_exactskin = 1;
		precache_model (ad_MODEL_PROJ_LASER);		// Copy of enforcer laser
		precache_sound (ad_SOUND_LASER_FIRE);
		precache_sound (ad_SOUND_LASER_HIT);
		self.ad_part_trstyle = ad_PARTICLE_TRAIL_RED;
		self.ad_attack_proj2 = ad_MODEL_PROJ_SWEEPER2R;	// Red hazard plasma
	}
	else {
		// blue version (default)
		precache_model (ad_MODEL_PROJ_SWEEPER1);	// Floating mine
		precache_sound ("sweeper/mine_launch.wav");
		precache_sound ("sweeper/mine_fire.wav");
		precache_sound ("sweeper/mine_hit.wav");
		self.ad_part_trstyle = ad_PARTICLE_TRAIL_BLUE;
		self.ad_attack_proj2 = ad_MODEL_PROJ_SWEEPER2B;	// Blue hazard plasma
	}
	// Cache hazard projectile/sounds
	precache_model (self.ad_attack_proj2);	
	precache_sound ("sweeper/hazard_fire.wav");
	precache_sound ("sweeper/hazard_miss.wav");
	
	self.ad_pain_sound = "sweeper/pain1.wav";
	self.ad_pain_sound2 = "sweeper/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	self.ad_death_sound = "sweeper/explode_major.wav";
	precache_sound (self.ad_death_sound);
	// Power off sound for shield setup
	precache_sound ("ambience/power_off.wav");
	
	self.ad_sight_sound = "sweeper/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = 200;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Special explosion death
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 30;				// Sometimes flinch
	self.ad_steptype = ad_FS_FLYING;			// Silent feet
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous
	if (self.height < 1) self.height = (ad_MONAI_ABOVEDIST * 0.5);
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	self.ad_meleeoffset = '0 0 16';		// Top of body
	self.ad_attack_offset = '0 0 -16';		// Bottom of body
	self.yaw_speed = 45;				// Super fast turning
	if (self.ad_velocityfriction <= 0) self.ad_velocityfriction = 0.8 + (random() * 0.1);
	self.ad_sight_nofront = ad_TRUE;			// Has no front facing
	self.ad_deathstring = " was mined by a Sweeper\n";
	self.ad_attack_chance = ad_TRUE;			// First time attack setup

	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_SWEEPER_SHIELD) {
		ad_sweeper_shieldon();				// Ammo resist + reflection
		self.ad_th_stand = ad_sweeper_shield;	// Setup Shield
		self.ad_think1 = ad_sweeper_wakeup;	// Wakeup function when triggered
	}
	else {
		ad_sweeper_shieldoff();			// Ammo resist + reflection
		self.ad_th_stand = ad_sweeper_stand;
		self.ad_th_walk = ad_sweeper_walk;
		self.ad_th_run = ad_sweeper_run;
		self.ad_th_missile = ad_sweeper_fire;
		self.ad_th_pain = ad_sweeper_pain;
		self.ad_th_die = ad_sweeper_die;
	}

	self.ad_th_checkattack = ad_SweeperCheckAttack;
	self.ad_classtype = ad_CT_MONSWEEPER;
	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVEFLY;
	
	ad_monster_start();
};
