// AD's readme and docs/vr-port/CREDITS.md), my_progs/subs_soc.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// To determine if an entity is still active this function generates
// an unique number that can be checked/shared between linked entities
//----------------------------------------------------------------------
void(entity ad_targ) ad_gen_unique_no = 
{
	// Check if target entity has an unique number already
	if (ad_targ.ad_entno_unique == 0) 
		ad_targ.ad_entno_unique = rint(random()*1000) * rint(random()*1000);
};

//======================================================================
// Most of the monsters have an attack_offset setup to spawn their
// proejctiles in the right location relative to their gun model
// This function expects the makevectors has been done already
// makevectors (self.angles); <--- if missing, vector will be rubbish!
//----------------------------------------------------------------------
vector(vector ad_attack_dir) ad_attack_vector =
{
	local vector ad_retvec;
	ad_retvec = v_forward * ad_attack_dir_x;
	ad_retvec = ad_retvec + (v_right * ad_attack_dir_y);
	ad_retvec = ad_retvec + (v_up * ad_attack_dir_z);
	return ad_retvec;
};

//----------------------------------------------------------------------
// Check vectors for zero content (extremely useful)
//----------------------------------------------------------------------
float(vector ad_check_vec) ad_CheckZeroVector =
{
	if (ad_check_vec_x == 0 && ad_check_vec_y == 0 && ad_check_vec_z == 0)
		return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// Make sure vector range is positive and integers only (Z exception)
//----------------------------------------------------------------------
vector(vector ad_mrange) ad_CheckRangeVector =
{
	local vector ad_retvec;
	ad_retvec_x = rint(fabs(ad_mrange_x));
	ad_retvec_y = rint(fabs(ad_mrange_y));
	ad_retvec_z = rint(ad_mrange_z);
	return ad_retvec;
};

//----------------------------------------------------------------------
// Calculate the bounding box volume from bbmin/bbmax keys
//----------------------------------------------------------------------
vector(entity ad_targ) ad_bbox_volume =
{
	local vector ad_retvec;
	ad_retvec_x = fabs(ad_targ.ad_bbmins_x) + fabs(ad_targ.ad_bbmaxs_x);
	ad_retvec_y = fabs(ad_targ.ad_bbmins_y) + fabs(ad_targ.ad_bbmaxs_y);
	ad_retvec_z = fabs(ad_targ.ad_bbmins_z) + fabs(ad_targ.ad_bbmaxs_z);
	return ad_retvec;
};

//----------------------------------------------------------------------
// Bmodels have a 0,0,0 origin key, need to calculate from mins/maxs
// This function will return the true origin using mins/max vectors
//----------------------------------------------------------------------
vector(entity ad_bmodel_ent) ad_bmodel_origin =
{
	local vector ad_vdiff, ad_vorigin;

	// Calculate the middle point of the mins/maxs size vectors
	// Changed /2 operation to *0.5 instead (ad1.7p2)
	ad_vdiff_x = (ad_bmodel_ent.maxs_x - ad_bmodel_ent.mins_x) * 0.5;
	ad_vdiff_y = (ad_bmodel_ent.maxs_y - ad_bmodel_ent.mins_y) * 0.5;
	ad_vdiff_z = (ad_bmodel_ent.maxs_z - ad_bmodel_ent.mins_z) * 0.5;

	// The mins vector is an absolute value of where the Bmodel is located
	// Add mins vector to middle point to get true origin
	// When bmodel do move they also update their origin co-ordinates
	// So any additional movement needs to be added as well
	// This means that bmodels can be tracked by movement functions
	ad_vorigin = ad_bmodel_ent.origin + ad_bmodel_ent.mins + ad_vdiff;
	
	// Return origin
	return ad_vorigin;
};

//----------------------------------------------------------------------
// This is version is using the bbmin/bbmax entity keys instead
// Useful if the entity is hidden and want to know origin
vector(entity ad_bmodel_ent) ad_bmodel_bborigin =
{
	local vector ad_vdiff, ad_vorigin;
	ad_vdiff_x = (ad_bmodel_ent.ad_bbmaxs_x - ad_bmodel_ent.ad_bbmins_x) * 0.5;
	ad_vdiff_y = (ad_bmodel_ent.ad_bbmaxs_y - ad_bmodel_ent.ad_bbmins_y) * 0.5;
	ad_vdiff_z = (ad_bmodel_ent.ad_bbmaxs_z - ad_bmodel_ent.ad_bbmins_z) * 0.5;
	ad_vorigin = ad_bmodel_ent.origin + ad_bmodel_ent.ad_bbmins + ad_vdiff;
	return ad_vorigin;
};

//======================================================================
// Vector randomizer, used mostly for avelocity setups
// Used all over the place; monsters, weapons and gibs!
// 
//----------------------------------------------------------------------
vector(float ad_base, float ad_rndmix, float ad_plusminus) ad_vecrand =
{
	local vector ad_vecmix;
	if (ad_plusminus) {
		ad_vecmix_x = ad_base + ad_crandom() * ad_rndmix; 
		ad_vecmix_y = ad_base + ad_crandom() * ad_rndmix; 
		ad_vecmix_z = ad_base + ad_crandom() * ad_rndmix; 
	}
	else {
		ad_vecmix_x = ad_base + random() * ad_rndmix; 
		ad_vecmix_y = ad_base + random() * ad_rndmix; 
		ad_vecmix_z = ad_base + random() * ad_rndmix; 
	}
	return ad_vecmix;
};

//======================================================================
// Trigger/use all entities that match the supplied targetname
// self is switched around so target use function works correctly
//
//----------------------------------------------------------------------
void(string ad_target_strs, entity ad_activator_ent) ad_trigger_strs =
{
	local entity ad_tself, ad_tother, ad_tactivator, ad_ent_list;

	// Some entities constantly use this function (<0.1s trigger)
	// This is just an entity key to block the debug info
	if (ad_activator_ent.ad_nodebuginfo == ad_FALSE) {
		dprint("\b[STR_TRIG]\b Str ("); dprint(ad_target_strs);
		dprint(") Activator ("); dprint(ad_activator_ent.classname);
		if (ad_target_strs == "") dprint(") - ERROR!!\n");
		else dprint(")\n");
	}

	// Prevent this function from triggering everything by
	// checking if the target_str is empty (empty = world)
	if (ad_target_strs != "") {
		// Store self/other for later
		ad_tself = self;
		ad_tother = other;
		ad_tactivator = ad_activator;
		if (ad_activator_ent.flags & ad_FL_CLIENT) ad_activator = ad_activator_ent;
	
		// Build initial list from world
		ad_ent_list = find(world, targetname, ad_target_strs);
		// Cycle through list
		while(ad_ent_list) {
			// Setup self/other ready for trigger/use function
			self = ad_ent_list;
			other = ad_tself;
			if (self.use) {
				self.ad_activate = ad_activator_ent;		// Link activator
				self.use();							// Fire use function
			}
			// Find next trigger from intial list (not world)
			ad_ent_list = find(ad_ent_list, targetname, ad_target_strs);
		}
		// Restore self/other from previous temp storage
		self = ad_tself;
		other = ad_tother;
		if (ad_activator_ent.flags & ad_FL_CLIENT) ad_activator = ad_tactivator;
	}
};

//======================================================================
// Trigger/use the entity supplied and activator
// self is switched around so target use function works correctly
//
//----------------------------------------------------------------------
void(entity ad_target_ent, entity ad_activator_ent) ad_trigger_ent =
{
	local entity ad_tself, ad_tother, ad_tactivator;

	// Some entities constantly use this function (<0.1s trigger)
	// This is just an entity key to block the debug info
	if (ad_activator_ent.ad_nodebuginfo == ad_FALSE) {
		dprint("\b[ENT_TRIG]\b Ent ("); dprint(ftos(ad_target_ent.ad_classtype));
		dprint(") Activator ("); dprint(ad_activator_ent.classname);
		if (!ad_target_ent) dprint(") - ERROR!!\n");
		else dprint(")\n");
	}

	if (ad_target_ent && ad_target_ent.use) {
		// Save self/other for later
		ad_tself = self;
		ad_tother = other;
		ad_tactivator = ad_activator;
		if (ad_activator_ent.flags & ad_FL_CLIENT) ad_activator = ad_activator_ent;
		
		// Switch around self/other for USE function
		self = ad_target_ent;
		other = ad_tself;
		
		// Use trigger
		if (self.use) {
			self.ad_activate = ad_activator_ent;		// Link activator
			self.use();							// Fire use function
		}
			
		// Restore self/other from previous temp storage
		self = ad_tself;
		other = ad_tother;
		if (ad_activator_ent.flags & ad_FL_CLIENT) ad_activator = ad_tactivator;
	}
};

//======================================================================
// Check if the entity has solid surface below 
// There is no entity type checks, can be any entity in theory!
// First check is checkbottom for complete bounding box coverage
// Second check is trace down to find floor surface below
// Typical trace down distance is 128 units with 24 unit difference
//
// Uses for this function:-
// ai_states.qc - ai_stand
// monsters.qc  - monster_deadbody_check
// ai_gibs.qc   - CheckFloorGib
// items.qc     - item_thinkloop
//
//----------------------------------------------------------------------
void(entity ad_source, float ad_floor_dist) ad_ent_floorcheck =
{
	local vector ad_trace_pos1;
	local float ad_trace_dist;
	
	// if (!checkbottom(source)) = disabled
	//  too expensive, 5 traces (4 corners + center) and liquid check

	// Tracedown directly from origin for floor check
	ad_trace_pos1 = ad_source.origin;
	ad_trace_pos1_z = ad_trace_pos1_z - ad_FLOOR_TRACE_DIST;
	traceline (ad_source.origin, ad_trace_pos1, ad_TRUE, ad_source);
	
	// Work out distance from origin to floor
	ad_trace_dist = ad_source.origin_z - trace_endpos_z;
	
	// Check if the floor is too far away? (usually 24 units)
	if (ad_trace_dist > ad_floor_dist && ad_source.flags & ad_FL_ONGROUND) {
		// Move entity up and do a trace/fall down (256 units max)
		ad_source.oldorigin = ad_source.origin;
		ad_source.origin_z = ad_source.origin_z + 1;
		droptofloor();
		if (ad_source.oldorigin != ad_source.origin) {
			// lift entity upward and remove onground flag
			ad_source.flags = ad_source.flags - (ad_source.flags & ad_FL_ONGROUND);
			ad_source.velocity_z = 10 + 10*random();
			// Check for any attachment (lids) for ammo
			if (ad_source.ad_classgroup == ad_CG_AMMOITEM && ad_source.ad_attachment) {
				// sync flag/velocity so lid falls correctly
				ad_source.ad_attachment.flags = ad_source.ad_attachment.flags - (ad_source.ad_attachment.flags & ad_FL_ONGROUND);
				ad_source.ad_attachment.velocity = ad_source.velocity;
			}
		}
		// Move item back to original pos before droptofloor
		setorigin(ad_source, ad_source.oldorigin);
	}
};

//======================================================================
// Check for contact with sky brushes
// - Use pointcontent() for Typical/Enhanced Quake engines
// - Use new FTE string functions and surface check for Darkplaces engine
//
//----------------------------------------------------------------------
float(vector ad_targ_origin) ad_check_skycontent =
{
	local float ad_surfnum;
	local string ad_texturename;

	// projectile owner exeception (bad FPS for large maps)
	if (self.owner.ad_proj_noskycheck == ad_TRUE) return ad_FALSE;

	// Does the engine supports extended surface checks?
	// This functionality can be bad for FPS with large maps
	// 2 ways to disabled this, worldspawn key or individually
	else if (ad_ext_dpsurf) {
		ad_surfnum = getsurfacenearpoint(world, ad_targ_origin);
		if (ad_surfnum >= 0) {
			ad_texturename = getsurfacetexture(world, ad_surfnum);
			if (strncasecmp(ad_texturename, "SKY", 3) == 0) return ad_TRUE;
		}
	}
	else {
		// Original method for checking sky content (Fitz engines)
		if (pointcontents(ad_targ_origin) == ad_CONTENT_SKY) return ad_TRUE;
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
float(vector ad_bborg, float ad_bbx, float ad_bby, float ad_bbz) ad_check_skyvector =
{
	local vector ad_skyorg;
	ad_skyorg_x = ad_bborg_x + ad_bbx;
	ad_skyorg_y = ad_bborg_y + ad_bby;
	ad_skyorg_z = ad_bborg_z + ad_bbz;
	if (ad_check_skycontent(ad_skyorg) == ad_TRUE) return ad_TRUE;
	else return ad_FALSE;
};

