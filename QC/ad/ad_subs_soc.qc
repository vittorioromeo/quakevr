//----------------------------------------------------------------------
// Check point content for SOLID or SKY problems
//----------------------------------------------------------------------
float(vector ad_pc_org) ad_entity_pcontent =
{
	local float ad_pcontent;
	ad_pcontent = pointcontents(ad_pc_org);
	if (ad_pcontent == ad_CONTENT_SOLID) return ad_TRUE;
	if (ad_check_skycontent(ad_pc_org)) return ad_TRUE;
	return ad_FALSE;
}

//======================================================================
// Updates totals on the HUD (checks for client to exist)
// - Specify which total to update using constant
// - Uses MSG_ONE because it is more reliable across many clients
// - Other client updates (SVC_KILLEDMONSTER, SVC_FOUNDSECRET)
// 
//----------------------------------------------------------------------
void(float ad_hud_item) ad_update_hud_totals =
{
	// Has the client player been setup yet?
	if (ad_client_ent && ad_client_ent.flags & ad_FL_CLIENT) {

		// Update total secrets
		if (ad_hud_item & ad_HUD_SECRETS) {
			msg_entity = ad_client_ent;
			WriteByte (ad_MSG_ONE, ad_SVC_UPDATESTAT);
			WriteByte (ad_MSG_ONE, ad_STAT_TOTALSECRETS);
			WriteLong (ad_MSG_ONE, total_secrets); 
		}
		// Update total monsters
		if (ad_hud_item & ad_HUD_MONSTERS) {
			msg_entity = ad_client_ent;
			WriteByte (ad_MSG_ONE, ad_SVC_UPDATESTAT);
			WriteByte (ad_MSG_ONE, ad_STAT_TOTALMONSTERS);
			WriteLong (ad_MSG_ONE, total_monsters); 
		}
	}
};

//======================================================================
// Reduce any entity down to a non-interactive empty marker
//
//----------------------------------------------------------------------
void(entity ad_targ) ad_entity_stop =
{
	if (ad_targ == world) return;			// Targ is wrong
	ad_targ.use = ad_targ.touch = ad_SUB_Null;	// No more touchy
	ad_targ.think = ad_SUB_Null;				// No more thinking/animation
	ad_targ.nextthink = -1;				// Never fire think
	ad_targ.ad_estate = ad_ESTATE_OFF;			// Entity state off
	ad_targ.takedamage = ad_DAMAGE_NO;		// No pain/death triggers
	ad_targ.height = 0;					// Model fade functionality
	ad_targ.movetype = ad_MOVETYPE_NONE;		// Stationary
	ad_targ.solid = ad_SOLID_NOT;				// no world interaction
	setsize (ad_targ, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		// No size, no impact
	ad_targ.velocity = ad_targ.avelocity = '0 0 0';	// Frozen velocity
	ad_targ.spawnflags = ad_targ.effects = 0;			// reset flags
	ad_targ.waitmin = time + ad_LARGE_TIMER;			// Block touch function
	ad_targ.ad_attack_finished = time + ad_LARGE_TIMER;	// Block all functions
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_entity_hide =
{
	if (ad_targ == world) return;			// Targ is wrong
	ad_entity_stop(ad_targ);					// No world interaction
	ad_targ.modelindex = 0;				// Make sure no model
	setmodel (ad_targ, "");				// invisible
};

//----------------------------------------------------------------------
void(entity ad_targ, float ad_removetime) ad_entity_remove =
{
	if (ad_targ == world) return;			// Targ is wrong
	ad_entity_hide(ad_targ);					// Prepare entity for removal
	ad_targ.think = ad_SUB_Remove;			// Remove entity gradually
	ad_targ.nextthink = time + ad_removetime;
};

//======================================================================
// Show where broken monster/items are located (developer only)
// SPNMARK_YELLOW, SPNMARK_BLUE, SPNMARK_GREEN,
// SPNMARK_RED, SPNMARK_PURPLE, SPNMARK_WHITE
//----------------------------------------------------------------------
void(vector ad_marker_org, float ad_marker_type) ad_spawn_marker =
{
	local entity ad_marker;
	
	// Exceptions
	if (ad_query_configflag(ad_SVR_DEVHELPER)) return;
	if (ad_developer == 0) return;

	// Dev Marker
	ad_marker = spawn();
	ad_marker.ad_classtype = ad_CT_DEVMARKER;
	ad_marker.movetype = ad_MOVETYPE_NONE;
	ad_marker.solid = ad_SOLID_NOT;
	setmodel(ad_marker, ad_MODEL_BROKEN);
	setorigin(ad_marker, ad_marker_org);
	setsize (ad_marker, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	// Setup marker type (skin colour)
	// YELLOW = error, BLUE = delay, GREEN = nocount, RED = nightmare
	ad_marker.skin = ad_marker_type;
	ad_marker.frame = 0;
	// If DP engine active remove particle shadow
	if (ad_engine == ad_ENG_DPEXT) ad_marker.effects = ad_marker.effects + ad_EF_NOSHADOW;
};

//----------------------------------------------------------------------
void(vector ad_marker_org, vector ad_marker_ang, float ad_marker_type) ad_spawn_arrow =
{
	local entity ad_marker;
	
	// Exceptions
	if (ad_query_configflag(ad_SVR_DEVHELPER)) return;
	if (ad_developer == 0) return;

	// Dev Marker
	ad_marker = spawn();
	ad_marker.ad_classtype = ad_CT_DEVMARKER;
	ad_marker.movetype = ad_MOVETYPE_NONE;
	ad_marker.solid = ad_SOLID_NOT;
	setmodel(ad_marker, ad_MODEL_CORNER1);
	setorigin(ad_marker, ad_marker_org);
	setsize (ad_marker, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_marker.angles = ad_marker_ang;
	// Setup marker type (skin colour)
	// YELLOW = 0, DARK GREEN = 1, GREEN = 2, WHITE = 3, RED = 4
	ad_marker.skin = ad_marker_type;
	ad_marker.frame = 0;
	ad_marker.alpha = 0.5 + random()*0.5;
	// If DP engine active remove particle shadow
	if (ad_engine == ad_ENG_DPEXT) ad_marker.effects = ad_marker.effects + ad_EF_NOSHADOW;
};

//----------------------------------------------------------------------
entity(vector ad_spawn_org) ad_spawn_devmarker =
{
	local entity ad_spawn_ent;
	
	ad_spawn_ent = spawn();
	ad_spawn_ent.ad_classtype = ad_CT_DEVMARKER;
	ad_spawn_ent.movetype = ad_MOVETYPE_NONE;
	ad_spawn_ent.solid = ad_SOLID_NOT;
	setmodel(ad_spawn_ent, ad_MODEL_BROKEN);
	setorigin(ad_spawn_ent, ad_spawn_org);
	setsize (ad_spawn_ent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	return ad_spawn_ent;
};

//----------------------------------------------------------------------
// This is designed for delay spawn monsters ONLY!
// It will certainly do crazy things if not used correctly
//----------------------------------------------------------------------
void(entity ad_targ) ad_monster_devmarker =
{
	// Exceptions
	if (ad_query_configflag(ad_SVR_DEVHELPER)) return;
	if (ad_developer == 0) return;

	ad_targ.movetype = ad_MOVETYPE_NONE;
	ad_targ.solid = ad_SOLID_NOT;
	setmodel(ad_targ, ad_MODEL_BROKEN);
	if (ad_targ.ad_nomonstercount == 1) ad_targ.skin = ad_SPNMARK_GREEN;
	else if (ad_targ.ad_delaymonstercount == 1) ad_targ.skin = ad_SPNMARK_GREEN;
	else ad_targ.skin = ad_SPNMARK_BLUE;
	ad_targ.frame = 0;	
};

//----------------------------------------------------------------------
// Check for SKILL spawning conditions (frame 0 check ONLY)
// Returns FALSE = do nothing  TRUE = inhibit spawning
//----------------------------------------------------------------------
float() ad_check_nightmare =
{
	// Check for nightmare skill only spawning
	if (self.ad_nightmare == ad_TRUE) {
		// Double check the coop console variable, not setup till frame 1+
		// Use a nosave variable to prevent constant cvar command checking
		if (ad_skill_cvar != ad_TRUE) { ad_skill = cvar("skill"); ad_skill_cvar = ad_TRUE; }
		if (ad_skill >= ad_SKILL_NIGHTMARE) return ad_FALSE;
		else {
			// Check for BSP entities has origin is different
			if (self.ad_bsporigin) ad_spawn_marker(ad_bmodel_origin(self), ad_SPNMARK_RED);
			else ad_spawn_marker(self.origin, ad_SPNMARK_RED);
			// Hide entity instead of removing it
			// Because of possible active touch functions
			ad_entity_hide(self);
			return ad_TRUE;
		}
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Check for COOP spawning conditions (frame 0 check ONLY)
// Returns FALSE = do nothing  TRUE = inhibit spawning
//----------------------------------------------------------------------
float() ad_check_coop =
{
	// Check for coop only spawning conditions
	if (self.ad_cooponly == ad_TRUE || self.ad_cooponly == ad_NEGATIVE) {
		// Double check the coop console variable, not setup till frame 1+
		// Use a nosave variable to prevent constant cvar command checking
		if (ad_coop_cvar != ad_TRUE) { coop = cvar("coop"); ad_coop_cvar = ad_TRUE; }
		
		// Only one condition will let a cooponly item spawn
		// cooponly =  1  coop = 0 inhibit = TRUE
		// cooponly =  1  coop = 1 inhibit = FALSE
		// cooponly = -1  coop = 0 inhibit = FALSE (fixed)
		// cooponly = -1  coop = 1 inhibit = TRUE
		if (self.ad_cooponly == ad_TRUE && coop == ad_TRUE) return ad_FALSE;
		// Added 1.7 Patch 2 (cooponly negative logic was wrong)
		else if (self.ad_cooponly == ad_NEGATIVE && coop == ad_FALSE) return ad_FALSE;
		else {
			// Check for BSP entities has origin is different
			if (self.ad_bsporigin) ad_spawn_marker(ad_bmodel_origin(self), ad_SPNMARK_PURPLE);
			else ad_spawn_marker(self.origin, ad_SPNMARK_PURPLE);
			// Hide entity instead of removing it
			// Because of possible active touch functions
			ad_entity_hide(self);
			return ad_TRUE;
		}
	}
	return ad_FALSE;
};

//======================================================================
// Clear all trigger strings
//
//----------------------------------------------------------------------
void (entity ad_targ) ad_clear_trigstrs =
{
	if (ad_targ.target != "") ad_targ.target = ad_string_null;
	if (ad_targ.ad_target2 != "") ad_targ.ad_target2 = ad_string_null;
	if (ad_targ.killtarget != "") ad_targ.killtarget = ad_string_null;
};

//======================================================================
// model_fade : Gradually fade out a model over time 
// * Optionally entity removal if height = 0
//
//----------------------------------------------------------------------
void() ad_model_fade =
{
    self.alpha = 1 - ((time - self.ltime) / 1);

    if (self.alpha > 1) self.alpha = 1;
    else if (self.alpha <= 0) {
        self.alpha = 0;
		self.modelindex = 0;	// Make sure no model
        self.model = "";
        // Remove model by default
        if (self.height == 0) {
			self.think = ad_SUB_Remove;
			self.nextthink = time + 1;
 		}
        return;
    }

    self.nextthink = time + ad_FADEMODEL_TIME;
};

/*======================================================================
 skill_chanceattack
  Calculate chance to attack player based on skill level and distance
  The standard ID range formula
	(enemy_range == RANGE_MELEE) chance = 0.9
	(enemy_range == RANGE_NEAR) chance = 0.4
	(enemy_range == RANGE_MID) chance = 0.05
	else chance = 0;
	The problem with this formula is that the chance factor is not gradual
	and will spike in chance when close to range boundaries
	Also this formula has no skill modifiers leading to limited gameplay rules
  
======================================================================*/
float() ad_SUB_ChanceAttack =
{
	local float ad_chrange, ad_chskill, ad_chance;
	
	ad_chrange = ad_chskill = 0;					// taniwha patch
	
	// Upper and lower limits of range have fixed chance rates
	if (self.ad_enemydist > ad_MON_MAX_RANGE) ad_chance =  0.05;
	else if (self.ad_enemydist < ad_MON_RANGE_MELEE) ad_chance = 0.95;
	else {
		// Random chance of range attack based on player distance
		ad_chrange = ((ad_MON_MAX_RANGE - self.ad_enemydist) / ad_MON_STEPRANGE) / 10;
		
		// Skill modifier to chance (Easy -0.2 Norm -0.1, Hard 0, Night 0.1)
		ad_chskill = ((ad_skill-ad_SKILL_HARD)*0.1);
		ad_chance = ad_chrange + ad_chskill;
		
		// There Should always be a chance to HIT or MISS
		if (ad_chance > 0.95) ad_chance = 0.95;
		else if (ad_chance < 0.05) ad_chance = 0.05;
	}
	
	// Return result and finish debug information line
	if (random() < ad_chance) return ad_TRUE;
	else return ad_FALSE;
};

/*======================================================================
 skill_subattack
  Calculate attack_finished time based on skill level
======================================================================*/
float (float ad_min_time, float ad_ranbase_time) ad_SUB_SkillAttack =
{
	local float ad_ran_time, ad_sub_time;
	
	// Easy = min + random(base + 1.5)    Normal = min + random(base + 1.0)
	// Hard = min + random(base + 0.5)    Nightm = min + random(base + 0.0)
	ad_ran_time = ad_ranbase_time + ((ad_SKILL_NIGHTMARE - ad_skill) * 0.5);
	ad_sub_time = ad_min_time + (ad_ran_time * random());
	
	return ad_sub_time;
};

/*======================================================================
 SUB_Tracking
 Progressively tracks the origin of enemies making attacks more accurate
  * Original code by Necros (http://shoresofnis.com/)
======================================================================*/
vector(vector ad_iorg, vector ad_org_offset, entity ad_targ, float ad_zspeed) ad_SUB_Tracking =
{
	local vector ad_vec, ad_org;
	local float ad_diff;

	// Allow for source origin to be fine tuned (directional)
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(ad_org_offset);

	ad_diff = vlen(ad_iorg - ad_org) / ad_zspeed;		// Workout difference
	ad_vec = ad_targ.velocity;
	if (ad_targ.flags & ad_FL_MONSTER) ad_vec_z = 0;	// Flatten Z axis for monsters
	else ad_vec_z = ad_vec_z * 0.2;				// Aim for headshot with players

	ad_iorg = ad_targ.origin + ad_diff * ad_vec;		// Refine target origin
	return ad_iorg;
};

/*======================================================================
 SUB_Elevation
  Calculates the Elevation for Z Aware monsters
  * Original code by Preach (https://tomeofpreach.wordpress.com/)
  * Added support for variable origin locations and proj speeds
  * Added support for distance scaling linked to skill levels
======================================================================*/
float(float ad_theta, vector ad_sorg, vector ad_mdest, float ad_zspeed) ad_SUB_Elevation =
{
	local float ad_a, ad_b, ad_c; 	//constants in the equation to be solved
	local vector ad_ofs; 		//displacement we wish the projectile to travel
	local float y, z; 		//horizontal and vertical components of ofs
	local float ad_tan_theta; 	//trig values of the angle theta
	local vector ad_vec, ad_eorg;
	local float ad_dist, ad_sperc;

	// Place projectile destination at player head level
	if (self.ad_classtype == ad_CT_MONSPIDER) ad_mdest = ad_mdest + ad_ELEV_SPID_OFS;
	else ad_mdest = ad_mdest + ad_ELEV_VIEW_OFS;

	// Work out vector distance between source and destination
	// Normalize the distance and create a percentage of that
	// This is a skill based calculation so the aiming gets better
	// The grenade is aimed infront of target so that it bounces
	// No check for vertical difference so it bad going up height!
	// Zombie, poison spiders zaware calculation is fine, exception!
	if (self.ad_classgroup != ad_CG_ZOMBIE && self.ad_classtype != ad_CT_MONSPIDER
		&& self.ad_classtype != ad_CT_MONBOGLORD) {
		ad_vec = ad_mdest - ad_sorg;
		ad_dist = vlen(ad_vec);
		ad_vec = normalize(ad_vec);
		ad_sperc = 0.45 + ad_skill*0.15;
		ad_eorg = ad_sorg + (ad_vec * (ad_dist*ad_sperc));
		ad_ofs = ad_eorg - ad_sorg;
	}
	else ad_ofs = ad_mdest - ad_sorg;
		
	//calculate how far we are firing
	//	ofs = mdest - sorg;
	z = ad_ofs_z;
	ad_ofs_z = 0;
	y = vlen(ad_ofs);
 
	// Map gravity is a global variable defined in world.qc
	//find the coefficients of the quadratic in tan(theta)
	ad_a = 0.5 * ad_map_gravity * y * y / (ad_zspeed * ad_zspeed);
	ad_b = -y;
	ad_c = ad_a + z;
 
	//check if the destination is too far to reach
	if(ad_b*ad_b < 4*ad_a*ad_c) return ad_ELEV_DEFAULT;

	//calculate the tan value of the given theta
	ad_tan_theta = ad_mathlib_tan(ad_theta);

	//reuse ang to create the improved firing direction
	ad_theta = ad_mathlib_atan2(ad_a*ad_tan_theta*ad_tan_theta - ad_c, 2*ad_a*ad_tan_theta + ad_b);

	//constrain the values to stop anything too mad happening
	while(ad_theta > 90) ad_theta = ad_theta - 180;
	return ad_theta;
};

/*======================================================================
 SUB_Elevat (Alternative version, not used anymore, left for reference)
  Calculates the Elevation for Z Aware monsters
  * Original formula WIKI with QC help from ericw
======================================================================*/
/*float(vector source, vector targ, float zspeed) SUB_Elevat =
{
