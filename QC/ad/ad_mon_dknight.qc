void()	ad_dknight_walk1	=[	$walk1,		ad_dknight_walk2	] {self.ad_idlebusy = ad_FALSE;
	ad_monster_idle_sound(); ad_dk_walk(2);};
void()	ad_dknight_walk2	=[	$walk2,		ad_dknight_walk3	] {ad_monster_footstep(ad_FALSE);ad_dk_walk(5);};
