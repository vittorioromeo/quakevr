void()	ad_dknight_stand10	=[	$stand10,	ad_dknight_stand11	] {ad_dk_stand();};
void()	ad_dknight_stand11	=[	$stand11,	ad_dknight_stand12	] {ad_dk_stand();};
void()	ad_dknight_stand12	=[	$stand12,	ad_dknight_stand1	] {
	self.ad_idlebusy = ad_FALSE; 
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.ad_idlebusy = ad_TRUE; 
		// Make sure the idle animations don't repeat in a row
		self.lefty = self.lip;
		while (self.lefty == self.lip) { self.lefty = rint(random()*4);}
		self.lip = self.lefty;
		if (self.lip < 1) self.think = ad_dknight_standD1;			// Scratch chin
		else if (self.lip < 2) self.think = ad_dknight_standC1;	// Look at weapon
		else if (self.lip < 3) self.think = ad_dknight_standA1;	// Shoulder hunch
		else self.think = ad_dknight_standB1;						// Look around
	}
};

//===========================================================================
void(float ad_dist) ad_dk_walk = {
	if (self.spawnflags & ad_MON_GHOST_ONLY) {
		if (self.movetype != ad_MOVETYPE_STEP) self.movetype = ad_MOVETYPE_STEP;
		ad_movetogoal (ad_dist);
		ad_dknight_ghost_particle();
		ad_dknight_ghost_glow();
		
		// Find out if the ghost is close enough to next path corner
		// The ghost is not a monster, negative health and no body!
		// The path_corner touch function won't work with ghosts
		self.ad_enemydist = ad_range_distance(self.goalentity, ad_FALSE);
		if (self.ad_enemydist < 64) {
			// Check for any new targets to walk toward
			if (self.goalentity.target != "") {
				self.ad_movetarget = find(world, targetname, self.goalentity.target);
				if (self.ad_movetarget) {
					if (self.ad_movetarget.ad_classtype == ad_CT_PATHCORNER) {
						self.goalentity = self.ad_movetarget;
						self.ideal_yaw = vectoyaw(self.goalentity.origin - self.origin);
						return;
					}
				}
			}
			// It seems its time to stand around!
			self.ad_th_stand();
			// Check for any path corner event triggers
			if (self.goalentity.ad_corner_event) 
				ad_trigger_strs(self.goalentity.ad_corner_event, self);
		}
	}
	// Default walk for regular knights
	else ad_ai_walk(ad_dist);
};

