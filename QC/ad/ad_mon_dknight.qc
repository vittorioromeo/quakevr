void()	ad_dknight_char_a5	=[	$char_a5,	ad_dknight_char_a6	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(14);};
void()	ad_dknight_char_a6	=[	$char_a6,	ad_dknight_char_a7	] {ad_ai_charge(20); ad_ai_melee();};
void()	ad_dknight_char_a7	=[	$char_a7,	ad_dknight_char_a8	] {ad_ai_charge(21); ad_ai_melee(); ad_dknight_sword_sound();};
void()	ad_dknight_char_a8	=[	$char_a8,	ad_dknight_char_a9	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(13); ad_ai_melee();};
void()	ad_dknight_char_a9	=[	$char_a9,	ad_dknight_char_a10	] {ad_ai_charge(20); ad_ai_melee();};
void()	ad_dknight_char_a10=[	$char_a10,	ad_dknight_char_a11	] {ad_ai_charge(20); ad_ai_melee();};
void()	ad_dknight_char_a11=[	$char_a11,	ad_dknight_char_a12	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(18);};
void()	ad_dknight_char_a12=[	$char_a12,	ad_dknight_run1	] {ad_ai_charge(16);};

