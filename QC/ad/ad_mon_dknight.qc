// Identical frame set (Hell Knight / Death Knight)

void()	ad_dknight_char_b1	=[	$char_b1,	ad_dknight_char_b2	] {
	ad_CheckContinueCharge (); ad_ai_charge(23); ad_ai_melee(); ad_dknight_sword_sound();};
void()	ad_dknight_char_b2	=[	$char_b2,	ad_dknight_char_b3	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(17); ad_ai_melee();};
