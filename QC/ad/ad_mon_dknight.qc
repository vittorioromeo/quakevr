//----------------------------------------------------------------------
void() ad_dknight_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dknight_die1 ();
		else ad_dknight_dieb1 ();
	}
};


//============================================================================
// The Death Knight ghost system (this is not a monster)
//============================================================================
void() ad_dknight_ghostnull = {};
//----------------------------------------------------------------------
void() ad_dknight_ghost_glow =
{
	if (self.ad_attachment) {
		self.ad_attachment.frame = self.frame;
		setorigin(self.ad_attachment, self.origin);
		if (random() < 0.5) self.ad_attachment.alpha = 0.02;
		else self.ad_attachment.alpha = 0.05;
		self.ad_attachment.angles = self.angles;
		self.ad_attachment.velocity = self.velocity;
	}
};
//----------------------------------------------------------------------
void() ad_dknight_ghost_particle =
{
	self.alpha = 0.5 + (0.1*random());
	self.pos1 = '0 0 0';
	self.pos1_x = ad_crandom()*16;
	self.pos1_y = ad_crandom()*16;
	self.pos1_z = ad_crandom()*24;
	if (random() < 0.5) 
		ad_particle_explode(self.origin+self.pos1, 2, 1, ad_PARTICLE_BURST_WHITE, ad_PARTICLE_BURST_LOSTUP);
	if (self.ad_idletimer < time) {
		self.ad_idletimer = time + 7 + (random() * 3);
		self.lefty = 1 - self.lefty;
		if (self.lefty) sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_idle_sound2, 1, ad_ATTN_NORM);
	}
};

//----------------------------------------------------------------------
// The use function is for triggering the ghost to move
void() ad_dknight_ghost_use = { 
	// Check for a delay target route (using target2)
	if (self.ad_estate == ad_ESTATE_ON && self.ad_target2 != "") {
		self.target = self.ad_target2;
		self.ad_target2 = "";
		self.ad_estate = ad_ESTATE_OFF;
	}
	// Always go to an on state
	self.ad_estate_on();
};

//----------------------------------------------------------------------
void() ad_dknight_ghost_fade =
{
	if (self.ad_estate == ad_ESTATE_ON) return;	
    self.alpha = self.alpha - ad_FADEMODEL_TIME;

    if (self.alpha <= 0) setmodel (self, "");
	else self.nextthink = time + ad_FADEMODEL_TIME;
};
//----------------------------------------------------------------------
void() ad_dknight_ghost_off = {
	// Block if already off
	if (self.ad_estate == ad_ESTATE_OFF) return;	

	self.ad_estate = ad_ESTATE_OFF;
	ad_particle_explode(self.origin+'0 0 -20', 75, 2, ad_PARTICLE_BURST_FIRE, ad_PARTICLE_BURST_UPWARD);
	self.flags = self.effects = 0;		// Always reset
	self.takedamage = ad_DAMAGE_NO;		// No pain/death triggers
	self.movetype = ad_MOVETYPE_NONE;		// Stationary
	self.solid = ad_SOLID_NOT;				// no world interaction
	setsize (self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);		// No size, no impact
	self.velocity = self.avelocity = '0 0 0';	// Reset velocity
	if (self.ad_attachment) {
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;	// Stationary
		self.ad_attachment.solid = ad_SOLID_NOT;			// no world interaction
		setmodel(self.ad_attachment,"");
		self.ad_attachment.velocity = '0 0 0';
	}
	sound (self, ad_CHAN_VOICE, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	self.think = ad_dknight_ghost_fade;
	self.nextthink = time + ad_FADEMODEL_TIME;
}

//----------------------------------------------------------------------
void() ad_dknight_ghost_on = {
	// Block if already ON
	if (self.ad_estate == ad_ESTATE_ON) return;	
	
	self.ad_estate = ad_ESTATE_ON;
	ad_particle_explode(self.origin, 30, 2, ad_PARTICLE_BURST_WHITE, ad_PARTICLE_BURST_SKULLUP);
	self.flags = self.effects = 0;		// Always reset
	self.takedamage = ad_DAMAGE_NO;		// No pain/death triggers
	self.movetype = ad_MOVETYPE_NONE;		// Regular walking
	self.solid = ad_SOLID_NOT;				// no world interaction
	setmodel(self, self.mdl);					// Setup model
	if (self.ad_exactskin) self.skin = self.ad_exactskin;
	if (ad_CheckZeroVector(self.ad_bbmins)) ad_monster_bbox();
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	self.velocity = self.avelocity = '0 0 0';	// Reset velocity
	
	// Setup ghost glow effect
	if (!self.ad_attachment) self.ad_attachment = spawn();
	self.ad_attachment.movetype = ad_MOVETYPE_NOCLIP;	// No movement
	self.ad_attachment.solid = ad_SOLID_NOT;			// no world interaction
	setmodel(self.ad_attachment, self.ad_headmdl);
	setsize(self.ad_attachment,ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	setorigin(self.ad_attachment, self.origin);

	// Check for any targets to walk toward
	if (self.target != "") {
		self.ad_movetarget = find(world, targetname, self.target);
		if (self.ad_movetarget) {
			if (self.ad_movetarget.ad_classtype == ad_CT_PATHCORNER) {
				self.goalentity = self.ad_movetarget;
				self.ideal_yaw = vectoyaw(self.goalentity.origin - self.origin);
				self.ad_th_walk();
				return;
			}
		}
	}
	// No valid target, just stand around
	self.ad_movetarget = self.goalentity = world;
	self.ad_th_stand();
}

//============================================================================
void() ad_dknight_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

/*======================================================================
QUAKED monster_dknight (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_dknight =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dknight.mdl";			// New Hell Knight
	self.ad_headmdl = "progs/h_dknight.mdl";
	self.ad_gib1mdl = "progs/w_dknightsword.mdl";	// Unique sword
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";	// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";	// right foot

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_HKN);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib2mdl = "";
	if (random() < 0.5) self.ad_gib3mdl = "";

	self.ad_idle_sound = "hknight/idle.wav";
	precache_sound (self.ad_idle_sound);
	
	// Firing of magic spikes (first 0.1s must loop)
	precache_sound ("hknight/attack1.wav");
	
	// TE_KNIGHTSPIKE = Magic spike hitting the wall
	// Has got to be in this location because the 
	// filename is hardcoded (engine.exe)
	precache_sound ("hknight/hit.wav");				

	self.ad_sight_sound = "hknight/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.ad_pain_sound = "hknight/pain1.wav";
	self.ad_death_sound = "hknight/death1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_death_sound);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");
	
	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_HKNGRN);
	}

	// dknight model does not support stone skins
	//precache_stonegibs();
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 250;
	self.ad_gibhealth = -40;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 40;
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_pain_timeout = 1.5;			// Higher than a knight
	self.ad_steptype = ad_FS_TYPEHEAVY;
	self.ad_deathstring = " was cleaved by a Death Knight\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	// randomize last melee attack
	self.ad_meleeattack = rint(random()*3);	

	self.ad_classtype = ad_CT_MONDKNIGHT;
	self.ad_classgroup = ad_CG_DKNIGHT;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	// Special ghost prop, stands around or walks
	if (self.spawnflags & ad_MON_GHOST_ONLY) {
		self.ad_headmdl = "progs/mon_dknight_glow.mdl";
		precache_model (self.ad_headmdl);
		
		self.ad_idle_sound = "dknight/ghost_idle1.wav";
		self.ad_idle_sound2 = "dknight/ghost_idle2.wav";
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);
		
		self.ad_steptype = ad_FS_FLYING;
		self.ad_exactskin = 2;
		self.alpha = 0.1;
		self.ad_nomonstercount = ad_TRUE;
		self.ad_gibhealth = ad_MON_NEVERGIB;
		self.health = ad_LARGE_TIMER;
		self.yaw_speed = 20;
		
		self.ad_th_stand = ad_dknight_stand1;
		self.ad_th_walk = ad_dknight_walk1;
		self.ad_th_run = ad_dknight_walk1;
		
		// The ghost is a scenery prop, not a monster
		if (self.targetname != "") self.use = ad_entity_state_use;
		self.ad_estate_on = ad_dknight_ghost_on;
		self.ad_estate_off = ad_dknight_ghost_off;
		self.ad_estate_use = ad_dknight_ghost_use;

		// Always start off and wait for a trigger
		self.ad_estate = ad_ESTATE_OFF;
		self.takedamage = ad_DAMAGE_NO;		// No pain/death triggers
		self.movetype = ad_MOVETYPE_NONE;		// Stationary
		self.solid = ad_SOLID_NOT;				// no world interaction
		setmodel (self, "");				// invisible
	}
	else {
		self.ad_th_stand = ad_dknight_stand1;
		self.ad_th_walk = ad_dknight_walk1;
		self.ad_th_run = ad_dknight_run1;
		self.ad_th_melee = ad_dknight_melee;
		self.ad_th_charge = ad_dknight_char_a1;
		self.ad_th_missile = ad_dknight_magicc1;
		self.ad_th_pain = ad_dknight_pain;
		self.ad_th_die = ad_dknight_die;
		// Start monster (default)
		ad_monster_start();
	}
};

//----------------------------------------------------------------------
void() ad_monster_dknightghost =
{
	self.spawnflags = ad_MON_GHOST_ONLY;
	ad_monster_dknight();
};

//----------------------------------------------------------------------
// Re-direct all Quoth Death Knights requests to D Knights!
void() ad_monster_death_knight =
{
	ad_monster_dknight();
};