	self.solid = ad_SOLID_NOT; if (!self.ad_gibbed) ad_DropBackpack(); };
void()	ad_hogremac_dieA4	=[	$deathA4,	ad_hogremac_dieA5	] {ad_ai_forward(1);};
void()	ad_hogremac_dieA5	=[	$deathA5,	ad_hogremac_dieA6	] {ad_ai_forward(1);};
void()	ad_hogremac_dieA6	=[	$deathA6,	ad_hogremac_dieA7	] {ad_ai_forward(1);};
