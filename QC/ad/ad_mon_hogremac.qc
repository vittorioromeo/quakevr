======================================================================*/
void() ad_hogremac_shoot1	=[	$shoot1,		ad_hogremac_shoot2	] {ad_ai_face();
	ad_MonsterGrenadeSound(); self.ad_attack_speed = ad_MonsterGrenadeSpeed();
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.enemy.origin, self.ad_attack_speed); };
void() ad_hogremac_shoot2	=[	$shoot2,		ad_hogremac_shoot3	] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, self.ad_attack_speed); };
void() ad_hogremac_shoot3	=[	$shoot3,		ad_hogremac_shoot4	] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, self.ad_attack_speed); };
void() ad_hogremac_shoot4	=[	$shoot4,		ad_hogremac_shoot5	] {ad_ai_face();
	ad_MonsterFireGrenade(self.origin, self.enemy.origin);};
void() ad_hogremac_shoot5	=[	$shoot5,		ad_hogremac_shoot6	] {ad_ai_face();};
void() ad_hogremac_shoot6	=[	$shoot6,		ad_hogremac_shoot7	] {ad_ai_face();};
