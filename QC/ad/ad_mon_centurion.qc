//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_cent_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		self.lip = random ();
		if (self.lip < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
	
		// Not using long pain animation (need to be agile)
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
			// Randomly pick which pain animation to play
			if (self.lip < 0.3) ad_cent_paina1 ();
			else if (self.lip < 0.6) ad_cent_painb1 ();
			else ad_cent_painc1 ();
		}
	}
};

//============================================================================
// Every death frame spawn some smoke and detect impact!
void() ad_cent_crash =
{
	if (self.state) {
		// Spawn projectile smoke trails or smoke sprites
		if (random() < 0.5) ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
		else {
			self.oldorigin = self.origin + ad_vecrand(0,32,ad_TRUE);
			ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, self.oldorigin, "");
		}
		// Once on ground, thud sound and no more smoke
		if (self.flags & ad_FL_ONGROUND) {
			sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_WOOD, 1, ad_ATTN_NORM);
			self.state = ad_FALSE;
		}
	}
};

