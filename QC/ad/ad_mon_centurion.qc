void()	ad_cent_run8	=[	$stand8,	ad_cent_run1	] {ad_ai_run(8);};

//============================================================================
void() ad_cent_fire =
{
	if (VR_AimCone_Wait(ad_cent_fire, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_org, ad_vec;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_PLASMA_FIRE, 1, ad_ATTN_NORM);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	// Fire plasma projectile at players feet
	ad_vec = ad_SUB_orgEnemyTarget() - '0 0 12';
	ad_vec = normalize(ad_vec - self.origin);

	ad_launch_plasma(ad_org, ad_vec, ad_CT_MONCENTURION, ad_SPEED_PLASMA);
};

