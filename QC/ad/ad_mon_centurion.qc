void()	ad_cent_die1	=[	$death1,	ad_cent_die2	] {ad_cent_crash();};
void()	ad_cent_die2	=[	$death2,	ad_cent_die3	] {ad_monster_check_gib();ad_cent_crash();};
void()	ad_cent_die3	=[	$death3,	ad_cent_die4	] {ad_monster_check_gib();
self.solid = ad_SOLID_NOT; if (!self.ad_gibbed) ad_DropBackpack();ad_cent_crash();};
