//============================================================================
void()	ad_cent_run1	=[	$stand1,	ad_cent_run2	] {
	ad_centurionhover();ad_monster_idle_sound(); 
	if (self.ad_meleeattack < time) {
		self.ad_meleeattack = time + 4 + (random() * 4);
		self.lefty = rint(1 - self.lefty);
	}
	ad_ai_run(8);};
void()	ad_cent_run2	=[	$stand2,	ad_cent_run3	] {ad_ai_run(8);};
void()	ad_cent_run3	=[	$stand3,	ad_cent_run4	] {ad_ai_run(8);};
