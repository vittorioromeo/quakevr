//----------------------------------------------------------------------
void() ad_cent_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Kill hoverboard sound
	sound(self, ad_CHAN_ITEM, ad_SOUND_EMPTY, 1, ad_ATTN_IDLE);
	
	// regular death
	if (!self.ad_gibbed) {
		self.state = ad_TRUE;
		sound (self, ad_CHAN_VOICE, "enforcer/death1.wav", 1, ad_ATTN_NORM);
		// Make sure Centurion falls to the ground (like wizards)
		self.velocity_x = -200 + 400*random();
		self.velocity_y = -200 + 400*random();
		self.velocity_z = 100 + 100*random();
		self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
		// Spawn a big sprite explosion + sound
		ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, ad_SOUND_REXP3);
		if (random() > 0.5) ad_cent_die1 ();
		else ad_cent_fdie1 ();
	}
};

/*======================================================================
 QUAKED monster_centurion (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_centurion =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_centurion.mdl";
	self.ad_headmdl = "progs/h_centurion.mdl";
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_PLASMA);

	precache_sound ("enforcer/death1.wav");
	self.ad_pain_sound = "enforcer/pain1.wav";
	self.ad_pain_sound2 = "enforcer/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	self.ad_idle_sound = "enforcer/idle1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_sound = "enforcer/sight1.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound ("enforcer/sight2.wav");
	precache_sound ("enforcer/sight3.wav");
	precache_sound ("enforcer/sight4.wav");

	// Extra load/fire sounds (from Quoth MOD)
	precache_sound ("enforcer/elim_pg_load.wav");
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);
	
	// Originally from rubicon2 (re-processed)
	precache_sound ("enforcer/cent_hover.wav");
	precache_sound (ad_GIB_SOUND_WOOD);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_PLASMAGRN);
	}
	
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 120;
	self.ad_gibhealth = -35;
	self.ad_gibbed = ad_FALSE;
	self.yaw_speed = 35;				// Can turn really fast
	self.ad_pain_flinch = 60;				// high pain tolerance
	self.ad_pain_longanim = ad_FALSE;			// Not using D pain, too slow
	self.ad_steptype = ad_FS_FLYING;			// Silent feet
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	if (!self.ad_exactskin) self.ad_randomskin = 6;
	if (self.ammo_cells < 0) self.ammo_cells = 0;
	else if (self.ammo_cells == 0) self.ammo_cells = 3;
	self.ad_attack_offset = '28 8.5 24';
	self.ad_deathstring = " was vaporized by a Centurion\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_CenturionCheckAttack;
	self.ad_th_stand = ad_cent_stand1;
	self.ad_th_walk = ad_cent_walk1;
	self.ad_th_run = ad_cent_run1;
	self.ad_th_pain = ad_cent_pain;
	self.ad_th_die = ad_cent_die;
	self.ad_th_missile = ad_cent_atk1;

	self.ad_classtype = ad_CT_MONCENTURION;
	self.ad_classgroup = ad_CG_ENFORCER;
	self.ad_classmove = ad_MON_MOVEFLY;
	ad_monster_start();
};