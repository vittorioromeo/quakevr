void()	ad_voreling_spit1 = [ $pain1, ad_voreling_spit2 ] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.enemy.origin, ad_SPEED_VORELING); };
void()	ad_voreling_spit2 = [ $pain2, ad_voreling_spit3 ] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, ad_SPEED_VORELING); };
void()	ad_voreling_spit3 = [ $bite1, ad_voreling_spit4 ] {ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, ad_SPEED_VORELING); };
void()	ad_voreling_spit4 = [ $bite2, ad_voreling_spit5 ] {
	if (VR_AimCone_Wait(ad_voreling_spit4, VR_AIM_WIDE)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)
ad_voreling_spitacid(-0.1);};
void()	ad_voreling_spit5 = [ $bite3, ad_voreling_spit6 ] {ad_voreling_spitacid(0);};
void()	ad_voreling_spit6 = [ $bite4, ad_voreling_spit7 ] {ad_voreling_spitacid(0.1);};
void()	ad_voreling_spit7 = [ $bite5, ad_voreling_spit8 ] {};
void()	ad_voreling_spit8 = [ $bite6, ad_voreling_spit9 ] {};
void()	ad_voreling_spit9 = [ $bite7, ad_voreling_run1 ] {};

//======================================================================
// BITE
//======================================================================
void() ad_voreling_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);										// Get closer for extra bite
	ad_ai_damagebreakable(10);								// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEEVORELING,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	if (random() < 0.5) sound(self, ad_CHAN_VOICE, "voreling/attackmunch.wav", ad_TRUE, ad_TRUE);
	else sound(self, ad_CHAN_VOICE, "voreling/attacktear.wav", ad_TRUE, ad_TRUE);

	// Voreling bite (damage 1-9) is very weak
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	
	// Spawn some touch blood
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

//----------------------------------------------------------------------
void()	ad_voreling_bite1	=[	$bite1, ad_voreling_bite2	] {ad_ai_face();};
// Start bite attack loop
void()	ad_voreling_bite2	=[	$bite2, ad_voreling_bite3 ] {ad_ai_face();};
void()	ad_voreling_bite3	=[	$bite3, ad_voreling_bite4 ] {ad_ai_face();};
void()	ad_voreling_bite4 = [	$bite4, ad_voreling_bite5 ] {ad_voreling_melee();};
void()	ad_voreling_bite5 = [	$bite5, ad_voreling_bite6 ] {};
void()	ad_voreling_bite6 =[	$bite6, ad_voreling_bite7 ] {
	if (ad_ai_checkmelee(ad_MONAI_MELEEVORELING,ad_FALSE) && self.enemy.health > 0) self.think = ad_voreling_bite2;};
// Exit bite attack loop
void()	ad_voreling_bite7	=[	$bite7, ad_voreling_run1	] {};

//============================================================================
// JUMP FUNCTION (range)
//============================================================================
void()	ad_Voreling_JumpTouch =
{
	local float ad_ldmg;

	if (self.health <= 0) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	// Do not damage other vorelings with jump attacks
	// Prevents packs from killing themselves
	if (self.ad_classgroup != other.ad_classgroup && other.takedamage) {
		if ( vlen(self.velocity) > 300 ) {
			ad_ldmg = 5 + 5*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			// Spawn some touch blood (no explicit direction)
			ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
		}
	}

	// Is the voreling floating in the air?
	if (!checkbottom(self)) {
		// Is the voreling standing on something?
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_voreling_leap1	=[	$jump1, ad_voreling_leap2	] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	ad_monster_idle_sound();
};
void() ad_voreling_leap2	=[	$jump2, ad_voreling_leap3	] {ad_ai_face();};
void() ad_voreling_leap3	=[	$jump3, ad_voreling_leap4	] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	self.touch = ad_Voreling_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.origin_z = self.origin_z + 4;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

// Flying through the air waiting to touch something!
void() ad_voreling_leap4	=[	$jump4, ad_voreling_leap5	] {};
void() ad_voreling_leap5	=[	$jump5, ad_voreling_leap6 ] {};	
void() ad_voreling_leap6	=[	$jump6, ad_voreling_leap7	] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_voreling_leap3;
	}
	self.oldorigin = self.origin;
};
//----------------------------------------------------------------------
void() ad_voreling_leap7 =[ $jump3, ad_voreling_leap8 ] {ad_monster_footstep(ad_FALSE);};
void() ad_voreling_leap8 =[ $jump2, ad_voreling_leap9 ] {ad_monster_footstep(ad_FALSE);};
void() ad_voreling_leap9 =[ $jump1, ad_voreling_run1	] {ad_ai_resetangles();};

//======================================================================
// CEILING VORELINGS - Idle/Drop/Touch/Land functions
//======================================================================
void()	ad_voreling_idleup1 =[ $idleup1, ad_voreling_idleup2] {ad_monster_idle_sound();ad_ai_stand();};
void()	ad_voreling_idleup2 =[ $idleup2, ad_voreling_idleup3] {ad_ai_stand();};
void()	ad_voreling_idleup3 =[ $idleup3, ad_voreling_idleup4] {ad_ai_stand();};
void()	ad_voreling_idleup4 =[ $idleup4, ad_voreling_idleup5] {ad_ai_stand();};
void()	ad_voreling_idleup5 =[ $idleup5, ad_voreling_idleup6] {ad_ai_stand();};
void()	ad_voreling_idleup6 =[ $idleup6, ad_voreling_idleup1] {ad_ai_stand();};

//----------------------------------------------------------------------
void() ad_voreling_droptouch =
{
	// Check if landed on something that is not the ground?
	if (!checkbottom(self)) {
		// Is the voreling standing on something?
		if (self.flags & ad_FL_ONGROUND) {
			self.flags = self.flags - ad_FL_ONGROUND;
			self.origin_z = self.origin_z + 8;
			setorigin(self, self.origin);	// raise up
			self.ad_attack_timer = time + 1;	// reset timer
			
			makevectors (self.angles);
			self.velocity = v_forward * 100 + '0 0 200';
		}
		return;
	}

	// No more flying, back to running
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setsize(self, self.ad_bbmins, self.ad_bbmaxs);

	// Reset view offset (based on bbox height)
	self.view_ofs = '0 0 0';
	self.view_ofs_z = self.maxs_z*0.5;

	self.touch = ad_SUB_Null;			// No more jump touching
	ad_FoundHuntTarget(ad_TRUE);			// Setup goals and warn other monsters
	if (self.enemy.flags & ad_FL_CLIENT) ad_monster_sightsound();

	// Restore all think state functions (voreling is off the ceiling)
	self.ad_th_stand = ad_voreling_idle1;
	self.ad_th_walk = ad_voreling_walk1;
	self.ad_th_run = ad_voreling_run1; 
	self.ad_th_slide = ad_voreling_slide1;
	self.ad_th_melee = ad_voreling_bite1;

	// Voreling 1 and 2 have different range attacks
	if (self.spawnflags & ad_MON_VORELING_LARGE) self.ad_th_missile = ad_voreling_spit1;
	else self.ad_th_jump = ad_voreling_leap1;

	// Back to running or standing around!
	if (!self.enemy) self.think = self.ad_th_stand;
	else self.think = self.ad_th_run;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void()	ad_voreling_drop1	=[	$drop1,	ad_voreling_drop2	] {};
void()	ad_voreling_drop2	=[	$drop2,	ad_voreling_drop3	] {};
void()	ad_voreling_drop3	=[	$drop3,	ad_voreling_drop4	] {};
void()	ad_voreling_drop4	=[	$drop4,	ad_voreling_drop5	] {};
void()	ad_voreling_drop5	=[	$drop5,	ad_voreling_drop5	] {
	if (self.ad_attack_timer < time || self.velocity_z == 0) ad_voreling_droptouch();
};

//----------------------------------------------------------------------------
void() ad_voreling_wakeup =
{
	// Dead already?
	if (self.health < 1) return;
		
	// Only call wakeup function once
	self.ad_th_walk = self.ad_th_run = self.ad_th_slide = ad_SUB_Null;

	// No longer need cling to ceiling spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_VORELING_CEILING);

	self.flags = ad_FL_MONSTER;			// reset flags
	
	if (ad_engine == ad_ENG_FITZ) self.origin_z = self.origin_z - 8;
	else self.origin_z = self.origin_z - 32;	// Unstick from ceiling
	setorigin(self, self.origin);		// Move down slightly
	
	self.movetype = ad_MOVETYPE_TOSS;		// Affected by gravity
	self.solid = ad_SOLID_SLIDEBOX;
	self.ad_attack_timer = time + 1;		// Stuck timer

	self.ad_classmove = ad_MON_MOVEWALK;		// Back to walking/running 
	self.ad_pain_finished = time + 1.5;	// No pain
	ad_SUB_AttackFinished(2 + random());	// No attacking
		
	makevectors (self.angles);			// Move towards face direction
	self.velocity = v_forward * 50;		// Slight nudge forward

	self.touch = ad_voreling_droptouch;	// Touch something?
	if (!self.jump_flag) 
	self.jump_flag = time + 1 + random()*2;	// Don't jump straight away
	ad_voreling_drop1();						// Turn around, cat tricks!
};

//======================================================================
// MINION - Grow and spin up from nothing
//======================================================================
void() ad_voreling_growangle = {self.angles_y = self.angles_y + self.lefty;};
void() ad_voreling_grow1 = [ $grow1, ad_voreling_grow2 ] {};
void() ad_voreling_grow2 = [ $grow2, ad_voreling_grow3 ] {ad_voreling_growangle();};
void() ad_voreling_grow3 = [ $grow3, ad_voreling_grow4 ] {ad_voreling_growangle();};
void() ad_voreling_grow4 = [ $grow4, ad_voreling_grow5 ] {ad_voreling_growangle();};
void() ad_voreling_grow5 = [ $grow5, ad_voreling_grow6 ] {ad_voreling_growangle();};
void() ad_voreling_grow6 = [ $grow6, ad_voreling_grow7 ] {ad_voreling_growangle();};
void() ad_voreling_grow7 = [ $grow7, ad_voreling_grow8 ] {ad_voreling_growangle();};
void() ad_voreling_grow8 = [ $grow8, ad_voreling_grow9 ] {ad_voreling_growangle();};
void() ad_voreling_grow9 = [ $grow9, ad_voreling_grow10] {ad_voreling_growangle();};
void() ad_voreling_grow10= [ $grow10, ad_voreling_run1 ] {
	// Is the voreling stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		// Finally spin back to original position
		self.angles_y = self.angles_y + self.lefty;
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);

		// Restore all think state functions
		self.ad_th_stand = ad_voreling_idle1;
		self.ad_th_walk = ad_voreling_walk1;
		self.ad_th_run = ad_voreling_run1; 
		self.ad_th_slide = ad_voreling_slide1;
		self.ad_th_melee = ad_voreling_bite1;
		// Voreling 1 and 2 have different range attacks
		if (self.spawnflags & ad_MON_VORELING_LARGE) self.ad_th_missile = ad_voreling_spit1;
		else {
			self.ad_th_jump = ad_voreling_leap1;
			self.ad_th_jumpexit = ad_voreling_leap7;
		}
	}
};
//----------------------------------------------------------------------------
void() ad_voreling_grow =
{
	// Only call wakeup function once
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run  = ad_SUB_Null;
	if (random() < 0.5) self.lefty = 36;
	else self.lefty = -36;
	ad_monster_sightsound();
	ad_voreling_grow1();
};

//============================================================================
void() ad_voreling_pain1	=[	$pain1,	ad_voreling_pain2	] {};
void() ad_voreling_pain2	=[	$pain2,	ad_voreling_run1	] {};

//----------------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_voreling_pain = 
{
	// Has the voreling been hit while on the ceiling?
	if (self.spawnflags & ad_MON_VORELING_CEILING) {
		self.ad_pain_finished = time + 1;
		ad_voreling_wakeup();
		return;
	}
		
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		self.ad_pain_finished = time + 1;

		if (self.ad_pain_check == 1) ad_voreling_pain1();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.2;
			self.ad_axhitme = 0;
			ad_voreling_pain1();
		}
	}
};

//============================================================================
void() ad_voreling_die1 =[	$death1, ad_voreling_die2	] {};
void() ad_voreling_die2 =[	$death2, ad_voreling_die3	] {ad_monster_check_gib();};
void() ad_voreling_die3 =[	$death3, ad_voreling_die4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_voreling_die4 =[	$death4, ad_voreling_die5	] {};
void() ad_voreling_die5 =[	$death5, ad_voreling_die6	] {ad_monster_death_postcheck();};
void() ad_voreling_die6 =[	$death6, ad_voreling_die6	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------------
void() ad_voreling_dieB1 =[	$deathB1, ad_voreling_dieB2	] {};
void() ad_voreling_dieB2 =[	$deathB2, ad_voreling_dieB3	] {ad_monster_check_gib();};
void() ad_voreling_dieB3 =[	$deathB3, ad_voreling_dieB4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_voreling_dieB4 =[	$deathB4, ad_voreling_dieB5	] {};
void() ad_voreling_dieB5 =[	$deathB5, ad_voreling_dieB6	] {};
void() ad_voreling_dieB6 =[	$deathB6, ad_voreling_dieB7	] {ad_monster_death_postcheck();};
void() ad_voreling_dieB7 =[	$deathB7, ad_voreling_dieB7	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------------
void() ad_voreling_die = 
{
	// Vorelings are small, gibs don't bounce far
	self.max_health = ad_MON_NOGIBVELOCITY;

	// Has the voreling died while on the ceiling?
	if (self.spawnflags & ad_MON_VORELING_CEILING)
		self.ad_gibondeath = ad_TRUE;

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "voreling/death.wav", 1, ad_ATTN_NORM);
		if (random() < 0.6) ad_voreling_die1();
		else ad_voreling_dieB1();
	}
};

//======================================================================
/*ad:QUAKED monster_voreling (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_setup_voreling;
void() ad_monster_voreling =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	if (self.spawnflags & ad_MON_VORELING_LARGE) {
		self.mdl = "progs/mon_vorelingp.mdl";
		self.ad_gib1mdl = "progs/gib_vorelegp.mdl";	// Single Leg

		precache_model (self.mdl);
		precache_model (self.ad_gib1mdl);
		precache_model (ad_MODEL_PROJ_VORE);			// Spit Projectile
	}
	if (!(self.spawnflags & ad_MON_VORELING_LARGE) || 
		self.ad_classtype == ad_CT_CACHEVORELING) {
		self.mdl = "progs/mon_voreling.mdl";
		self.ad_gib1mdl = "progs/gib_voreleg.mdl";		// Single Leg

		precache_model (self.mdl);
		precache_model (self.ad_gib1mdl);
	}

	// IDLE/COMBAT and SIGHT sounds
	self.ad_idle_sound = "voreling/idle.wav";
	precache_sound (self.ad_idle_sound);

	// death/pain/attack sounds
	precache_sound("voreling/death.wav");
	self.ad_pain_sound = "voreling/pain.wav";
	precache_sound(self.ad_pain_sound);

	precache_sound("voreling/miss.wav");	// Spit misses
	precache_sound("voreling/hiss2.wav");	// Spit attack
	precache_sound("voreling/attackmunch.wav");
	precache_sound("voreling/attacktear.wav");
	precache_sound("voreling/jumpland.wav");

	self.ad_sight_sound = "voreling/sight.wav";
	precache_sound (self.ad_sight_sound);

	// Cache voreling is a special class used for precache only
	if (self.ad_classtype != ad_CT_CACHEVORELING) ad_setup_voreling();
};

//----------------------------------------------------------------------------
void() ad_monster_shalrathminion = { 
	self.ad_classtype = ad_CT_CACHEVORELING; 
	self.spawnflags = ad_MON_VORELING_LARGE;	// Precache both vorelings
	ad_monster_voreling();
};

//----------------------------------------------------------------------------
void() ad_setup_voreling =
{
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 10;				// Always flinch
	self.ad_steptype = ad_FS_TYPELIGHT;
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '20 0 0';		// Bite attack offset
	self.ad_attack_offset = '14 0 8';		// Used by purple voreling, at jaws
	self.ad_movespeed = 1;					// Can never be a turret
	self.ad_poisonous = ad_FALSE;				// Use swamplings if wanting poison
	self.ad_deathstring = " was nibbled by a Voreling\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_VorelingCheckAttack;
	self.ad_th_pain = ad_voreling_pain;
	self.ad_th_die = ad_voreling_die;

	if(!self.ad_classtype) self.ad_classtype = ad_CT_MONVORELING;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEWALK;

	// Setup white/purple voreling difference
	if (self.spawnflags & ad_MON_VORELING_LARGE) {
		if (self.health < 1) self.health = 60;
		self.ad_gibhealth = -25;
		self.ad_th_missile = ad_voreling_spit1;
	}
	else {
		if (self.health < 1) self.health = 30;
		self.ad_gibhealth = -20;
		self.ad_th_jump = ad_voreling_leap1;
		self.ad_th_jumpexit = ad_voreling_leap7;
		// Default jump forward/up distance
		if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '500 0 200';
		if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPVORELINGNEAR;
		if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPVORELINGFAR;
	}

	//----------------------------------------------------------------------
	// Check for quoth on ceiling entity flag
	//----------------------------------------------------------------------
	if (self.ad_dangle) {
		self.spawnflags = self.spawnflags | ad_MON_VORELING_CEILING;
	}
	
	//----------------------------------------------------------------------
	// Ceiling vorelings have special idle animation
	// and need to let go of the ceiling before resuming any
	// normal behaviour (most think functions are intercepted)
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_VORELING_CEILING) {
		self.ad_th_stand = self.ad_th_walk = ad_voreling_idleup1;
		self.ad_th_run = self.ad_th_slide = ad_voreling_wakeup;
		self.ad_th_melee = self.ad_th_missile = self.ad_th_jump = ad_voreling_wakeup;
		// th_pain and th_die functions understand ceiling vorelings
	}
	// Special spawning minion need to start spinning
	else if (self.ad_classtype == ad_CT_MINIONVORELING) {
		self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_voreling_grow;
		self.ad_th_melee = self.ad_th_slide = ad_SUB_Null;
		self.ad_th_missile = self.ad_th_jump = ad_SUB_Null;
	}
	// Default voreling behaviour functions
	else {
		self.ad_th_stand = ad_voreling_idle1;
		self.ad_th_walk = ad_voreling_walk1;
		self.ad_th_run = ad_voreling_run1;
		self.ad_th_melee = ad_voreling_bite1;
		self.ad_th_slide = ad_voreling_slide1;
	}
	
	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn vorelings (requires monster_shalrathminion entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_voreling =
{
	local entity ad_minion;

	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	ad_update_minioncount(self.owner, 1);		// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_voreling";	// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self.owner;				// Spawner Parent Link
	self.owner = ad_minion;					// Stop gibs interacting with minion
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_gibondeath = 1;					// Always gib on death
	ad_minion.ad_classtype = ad_CT_MINIONVORELING;	// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.spawnflags = 0;
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	if (random() < 0.2) ad_minion.spawnflags = ad_MON_VORELING_LARGE;
	else ad_minion.spawnflags = 0;

	if (ad_minion.spawnflags & ad_MON_VORELING_LARGE) {
		ad_minion.mdl = "progs/mon_vorelingp.mdl";		// Purpler horror
		ad_minion.ad_gib1mdl = "progs/gib_vorelegp.mdl";	// Single Leg
	}
	else {	
		ad_minion.mdl = "progs/mon_voreling.mdl";		// Creamy delight
		ad_minion.ad_gib1mdl = "progs/gib_voreleg.mdl";	// Single Leg
	}
	
	ad_minion.ad_idle_sound = "voreling/idle.wav";
	ad_minion.ad_sight_sound = "voreling/sight.wav";
	ad_minion.ad_pain_sound = "voreling/pain.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_voreling;
};