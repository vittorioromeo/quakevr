//----------------------------------------------------------------------
void(float ad_dist) ad_voreling_checkpause =
{
	// Do nothing is not to fight or dead
	if (!self.enemy) return;
	if (self.health < 1) return;

	// make vorelings run in bursts of speed (reset every run animation cycle)
	self.ad_movespeed = self.ad_movespeed + 1;
	// Do run code to check for enemies
	ad_ai_run(ad_dist + self.ad_movespeed);
	if (self.ad_enemydist < ad_MONAI_RUNPAUSE) return; // Too close

	// Random chance to stop and pause running
	if (self.ad_movespeed > 7 && random() < 0.2) {
		self.jump_flag = time + random();
		self.think = ad_voreling_runp1;
	}
};

//----------------------------------------------------------------------
void()	ad_voreling_run1 =[ $run1, ad_voreling_run2 ] {self.ad_movespeed = 0;
	ad_monster_idle_sound();
	ad_voreling_checkpause(8);
	// Vorelings have constant problems with weird angles (X/Z)
	// Just keep resetting them so they move normally
	ad_ai_resetangles();
};
void()	ad_voreling_run2 =[ $run2, ad_voreling_run3 ] {ad_monster_footstep(ad_FALSE); ad_voreling_checkpause(6);};
void()	ad_voreling_run3 =[ $run3, ad_voreling_run4 ] {ad_voreling_checkpause(8);};
void()	ad_voreling_run4 =[ $run4, ad_voreling_run5 ] {ad_voreling_checkpause(10);};
void()	ad_voreling_run5 =[ $run1, ad_voreling_run6 ] {ad_voreling_checkpause(8);};
void()	ad_voreling_run6 =[ $run2, ad_voreling_run7 ] {ad_monster_footstep(ad_FALSE); ad_voreling_checkpause(6);};
void()	ad_voreling_run7 =[ $run3, ad_voreling_run8 ] {ad_voreling_checkpause(8);};
void()	ad_voreling_run8 =[ $run4, ad_voreling_run1 ] {ad_voreling_checkpause(10);};

