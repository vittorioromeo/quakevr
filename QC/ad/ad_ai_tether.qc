// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 MONSTER TETHER SYSTEM

======================================================================*/
// new entity keys

.string		ad_tethertarget;		// String name to link tethering too
.entity		ad_tethertarg;			// Entity to track for tether system
.void()		ad_th_tether;			// Function to call when at max range
.float		ad_tethered;			// is the monster tethered during combat
.float		ad_tetherrange;		// The circular range around tether point
.float		ad_tetherdist;			// Distance from monster to tether point
.float		ad_tetherenemy;		// Distance from enemy to tether point
.float		ad_tetherwait;			// Amount of time to wait before returning
.float		ad_tethertimer;		// Time before returning (code generated)
.float		ad_tetherturn;			// Make sure monster turns towards enemy
.float		ad_tetherpause;		// % to not pause attack at max range
.entity		ad_tetherfocus;		// Enemy to turn towards while waiting

float ad_TETHER_RADIUS = 300;		// Default tether radius
float ad_TETHER_WAIT = 30;			// Default timer to wait before reset

// Defined under defs.qc
//.float tetherlock;		// Is the monster locked from movement

//----------------------------------------------------------------------
void(entity ad_targ) ad_display_tethersystem =
{
	local vector ad_org;
	
	// Find origin of tether target
	if (ad_targ.ad_tethertarg) {
		if (ad_targ.ad_tethertarg.ad_bsporigin) ad_org = ad_bmodel_origin(ad_targ.ad_tethertarg);
		else ad_org = ad_targ.ad_tethertarg.origin;
	}
	// Use own origin as backup
	else ad_org = ad_targ.origin;
	
	// Find out own distance to tether
	self.ad_tetherdist = vlen(ad_targ.origin - ad_org);
	// Find out enemy distance to tether
	if (ad_targ.enemy) ad_targ.ad_tetherenemy = vlen(ad_targ.enemy.origin - ad_org);
	else ad_targ.ad_tetherenemy = 0;

	dprint("\b[Tether system]\b\n"); 
	dprint("--------------------------------------\n");
	dprint("Class ("); dprint(ad_targ.classname); 
	if (ad_targ.ad_tethered) dprint(") Active (YES)\n");
	else dprint(") Active (NO)\n");
	dprint("Dist Max ("); dprint(ftos(ad_targ.ad_tetherrange));
	dprint(") Tether ("); dprint(ftos(ad_targ.ad_tetherdist)); 
	dprint(") Enemy ("); dprint(ftos(ad_targ.ad_tetherenemy)); 
	dprint(")\n");
	dprint("Wait time ("); dprint(ftos(ad_targ.ad_tetherwait));
	dprint(") Turn ("); dprint(ftos(ad_targ.ad_tetherturn));
	dprint(") Pause ("); dprint(ftos(ad_targ.ad_tetherpause));
	dprint(")\n");
	dprint("--------------------------------------\n");
};

//----------------------------------------------------------------------
// Check for tether point (find and setup entity)
//----------------------------------------------------------------------
void() ad_setup_tethersystem =
{
	// Check if the tether system be setup already
	if (self.ad_tethertarget != "") {
		// Check for range attack, cannot tether if no range
		if (!self.ad_th_missile) {
			dprint("\b[TETHER]\b No range attack for ");
			dprint(self.ad_tethertarget);
			dprint("\n");
			self.ad_tethertarget = "";
			return;
		}
	
		// Find the tether point (has to be path corner)
		self.ad_tethertarg = find(world, targetname, self.ad_tethertarget);
		if (self.ad_tethertarg != world) {
			// Tether system is active (reset lock)
			self.ad_tethered = ad_TRUE;
			self.ad_tetherlock = ad_FALSE;
			// Setup default tether range
			if (self.ad_tetherrange < 32) self.ad_tetherrange = ad_TETHER_RADIUS;
			if (self.ad_tetherwait <= 0) self.ad_tetherwait = ad_TETHER_WAIT;
			// Reset distances (updated in check function)
			self.ad_tetherdist = self.ad_tetherenemy = 0;
			// No stand/walk timer active yet
			self.ad_tethertimer = ad_LARGE_TIMER;
			// Check for tether function (def=missile)
			if (!self.ad_th_tether) self.ad_th_tether = self.ad_th_missile;
			// Don't need tethertarget anymore
			self.ad_tethertarget = "";
		}
		
		// Display debug info to console
		//display_tethersystem(self);
	}
};

//----------------------------------------------------------------------
// Check for tether range and return TRUE if at radius limit
//----------------------------------------------------------------------
float() ad_check_tethersystem =
{
	local vector ad_org;
	
	// Is the system active on the monster?
	if (self.ad_tethered == ad_FALSE) return ad_FALSE;
	
	// Read tether target for BSP/Ent origin
	if (self.ad_tethertarg.ad_bsporigin) ad_org = ad_bmodel_origin(self.ad_tethertarg);
	else ad_org = self.ad_tethertarg.origin;
	
	// Setup tether distance for monster and enemy
	self.ad_tetherdist = vlen(self.origin - ad_org);
	// Check for enemy entity first before distance check
	if (self.enemy) self.ad_tetherenemy = vlen(self.enemy.origin - ad_org);
	else self.ad_tetherenemy = 0;
	
	// Reset lock
	self.ad_tetherlock = ad_FALSE;

	// If inside tether range, keep moving
	if (self.ad_tetherdist < self.ad_tetherrange) return ad_FALSE;
	else {
		// If enemy behind tether point, move closer
		if (ad_infront(self.ad_tethertarg) && ad_infront(self.enemy))
			return ad_FALSE;
		// Reach tether limit
		else {
			// Can monster see the enemy?
			if (ad_enemy_vis) return ad_TRUE;
			else {
				// Check for any passive monsters
				if (self.ad_passive_mode) {
					// Return to passive monster state (reset)
					self.ad_passive_state = ad_MON_PASSIVESTATE_RESET;
					return ad_FALSE;
				}
				
				// Check for no pause override
				if (self.ad_tetherpause > 0) {
					if (random() <= self.ad_tetherpause) return ad_TRUE;
				}
				// At max range + cannot see enemy, exit combat
				self.ad_tetherfocus = self.enemy;	// Save for later
				self.enemy = self.goalentity = self.ad_movetarget = world;
				self.ad_attack_state = ad_AS_STRAIGHT;
				self.think = self.ad_th_stand;		// Wait for enemy
				self.ad_tethertimer = time + self.ad_tetherwait;
			}
		}
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Check tether timer for stand function
//----------------------------------------------------------------------
void() ad_check_tethertimer =
{
	if (self.ad_tethered == ad_FALSE) return;		// System active?
	if (!self.ad_tethertarg) return;			// No target active
	if (self.enemy) return;					// In combat?
	
	// Has the timer been reached?
	if (self.ad_tethertimer < time) {
		self.ad_tetherlock = ad_FALSE;			// Make sure not set
		self.goalentity = self.ad_movetarget = self.ad_tethertarg;
		self.ad_tethertimer = ad_LARGE_TIMER;		// Timer no longer needed
		self.ad_pausetime = 0;					// Start walking
	}
	else {
		// Check to see if facing enemy is active?
		if (self.ad_tetherturn && self.ad_tetherfocus) {
			self.ideal_yaw = vectoyaw(self.ad_tetherfocus.origin - self.origin);
			ChangeYaw ();			
		}
	}
};