void() ad_steelc_die10 =[$death19, ad_steelc_die10] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------------
void() ad_steelc_die = 
{
	// Gibs don't bounce far
	self.max_health = ad_MON_NOGIBVELOCITY;
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		ad_steelc_die1();
	}
};

//======================================================================
/*ad:QUAKED monster_steelclaw (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_monster_steelclaw =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_steelclaw.mdl";
	self.ad_headmdl = "progs/h_steelclaw.mdl";		// Front Jaws
	self.ad_gib1mdl = "progs/gib_steelleg.mdl";	// Single Leg
	self.ad_gib2mdl = "progs/gib_steelbody.mdl";	// Back Body

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);

	// Head/Body and Special GIB models
	self.ad_gib1frame = 9;

	// IDLE/COMBAT and SIGHT sounds
	self.ad_idle_sound = "steelclaw/idle1.wav";
	self.ad_idle_sound2 = "steelclaw/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	// death/pain/attack sounds
	self.ad_pain_sound = "steelclaw/pain1.wav";
	self.ad_pain_sound2 = "steelclaw/pain2.wav";
	precache_sound(self.ad_pain_sound);
	precache_sound(self.ad_pain_sound2);
	self.ad_death_sound = "steelclaw/death1.wav";
	precache_sound(self.ad_death_sound);

	precache_sound("steelclaw/attackmunch.wav");
	precache_sound("steelclaw/attacktear.wav");
	precache_sound("steelclaw/jumpattack1.wav");
	precache_sound("steelclaw/jumpattack2.wav");
	precache_sound("steelclaw/jumphit.wav");
	precache_sound("steelclaw/jumpland.wav");
	
	self.ad_sight_sound = "steelclaw/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	if (self.health < 1) self.health = 75;
	self.ad_gibhealth = -20;
	self.ad_gibbed = ad_FALSE;
	self.ad_idlemoreoften = ad_TRUE;			// More creepy idle sounds
	self.ad_pain_flinch = 10;				// Always flinch
	self.ad_steptype = ad_FS_TYPELIGHT;
	self.ad_poisonous = ad_FALSE;				// Never poisonous
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '24 0 20';		// Bite attack offset
	self.ad_movespeed = 1;					// Can never be a turret
	self.ad_deathstring = " was bled out by a Steelclaw\n";

	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '650 0 50';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPSTEELNEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPSTEELFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_SteelclawCheckAttack;	
	self.ad_th_stand = ad_steelc_idle1;
	self.ad_th_walk = ad_steelc_walk1;
	self.ad_th_run = ad_steelc_run1;
	self.ad_th_melee = ad_steelc_bite1;
	self.ad_th_slide = ad_steelc_slide1;
	self.ad_th_jump = ad_steelc_leap1;
	self.ad_th_jumpexit = ad_steelc_leap9;
	self.ad_th_pain = ad_steelc_pain;
	self.ad_th_die = ad_steelc_die;
	
	self.ad_classtype = ad_CT_MONSTEELCLAW;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
};
