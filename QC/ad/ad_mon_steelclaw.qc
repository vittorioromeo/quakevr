void() ad_steelc_leap8 =[ $jump11, ad_steelc_leap9] {ad_monster_footstep(ad_FALSE);};
void() ad_steelc_leap9 =[ $jump13, ad_steelc_leap10] {ad_monster_footstep(ad_FALSE);};
void() ad_steelc_leap10 =[ $jump15, ad_steelc_run1] {ad_ai_resetangles();};

