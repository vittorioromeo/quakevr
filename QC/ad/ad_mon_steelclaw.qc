//============================================================================
// JUMP FUNCTION (range)
//============================================================================
void() ad_steelc_JumpTouch =
{
	if (self.health <= 0) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	// Prevents packs from killing themselves
	if (self.ad_classgroup != other.ad_classgroup && other.takedamage) {
		sound (self, ad_CHAN_VOICE, "steelclaw/jumphit.wav", 1, ad_ATTN_NORM);
		ad_BleedDeBuff(other);
		ad_spawn_touchblood (self, self.enemy, 100);
	}

	// Is floating in the air?
	if (!checkbottom(self)) {
		// Is standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_steelc_leap1 =[ $jump1, ad_steelc_leap2 ] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPSTEELTIME; // Stop jumping so much
	if (random() > 0.5) {
		self.volume = 0.5 + (random()*0.5);
		if (self.lefty < 1) sound (self, ad_CHAN_VOICE, "steelclaw/jumpattack1.wav", self.volume, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, "steelclaw/jumpattack2.wav", self.volume, ad_ATTN_NORM);
		self.lefty = 1 - self.lefty;
	}
};
void() ad_steelc_leap2 =[ $jump3, ad_steelc_leap3 ] {ad_ai_face();};
void() ad_steelc_leap3 =[ $jump5, ad_steelc_leap4 ] {ad_ai_face();
	// Throw the steelclaw like a grenade!
	self.ad_attack_speed = self.ad_jumpdist_x + (random()*self.ad_jumpdist_z);
	// Aiming at the players head (+24 z axis)
	self.pos2 = self.enemy.origin + '0 0 24';
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.pos2, self.ad_attack_speed);
	self.pos1 = vectoangles(self.pos2 - self.origin);
	self.pos1_x = -self.ad_attack_elev;
	makevectors (self.pos1);
	self.velocity = v_forward * self.ad_attack_speed;
	
	self.jump_flag = time + ad_MONAI_JUMPSTEELTIME; // Stop jumping so much
	self.touch = ad_steelc_JumpTouch;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};
void() ad_steelc_leap4 =[ $jump7, ad_steelc_leap5 ] {};
void() ad_steelc_leap5 =[ $jump8, ad_steelc_leap6 ] {};	
void() ad_steelc_leap6 =[ $jump9, ad_steelc_leap7 ] {};
void() ad_steelc_leap7 =[ $jump10, ad_steelc_leap8 ] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_steelc_leap3;
	}
	self.oldorigin = self.origin;
};

