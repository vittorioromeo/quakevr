//======================================================================
// BITE - bleed attack or simple bite
//======================================================================
void() ad_steelc_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);									// Get closer for extra bite
	ad_ai_damagebreakable(10);							// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEESTEELCLAW,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	if (random() < 0.5) sound(self, ad_CHAN_WEAPON, "steelclaw/attackmunch.wav", ad_TRUE, ad_TRUE);
	else sound(self, ad_CHAN_WEAPON, "steelclaw/attacktear.wav", ad_TRUE, ad_TRUE);

	// Spider bite (damage 1-9) is very weak
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Spawn blood at mouth
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

