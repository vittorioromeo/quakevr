//======================================================================
void() ad_steelc_runpause =
{
	// Do nothing is not to fight or dead
	if (!self.enemy) return;
	if (self.health < 1) return;

	if (self.jump_flag < time) self.ad_th_run();
	// Is the enemy too close? no more pausing, fight!
	self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
	if (self.ad_enemydist < ad_MONAI_RUNPAUSE) self.ad_th_run();
};

