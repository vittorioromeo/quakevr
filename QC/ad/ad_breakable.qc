//=============================================================================
/*ad:QUAKED func_breakable (0 .5 .8) ? STARTOFF NODAMAGE EXPLOSION SILENT DAMAGE NOMOSTER NOSOUND NOROTATE Not_Easy Not_Normal Not_Hard Not_DM
Spawn breakable objects from a bmodel
-------- KEYS --------
target     : targets to fire when breakable is dead/used (only used once)
target2    : Additional trigger function (need target to be defined as well)
style      : pre-defined sound/model types - 1=rock, 2=wood, 3=glass, 4=metal, 5=brick, 6=flesh, 10=custom
brksound   : Initial breaking sound type (override style default)
brkimpsound : Impact sound type (override style default)
brkobjects : Breakable object model type (10-15=rocks, 20-22=woods, 30-32=glass, 40-42=metals, 50-54=brick, 60-62=flesh)
noise     : Initial breaking sound (unique sound file)
noise1    : Custom Rubble Impact sounds (unique sound files, must have 1 defined)
noise2    : Custom Rubble Impact sound 2
noise3    : Custom Rubble Impact sound 3
noise4    : Custom Rubble Impact sound 4
brkobj1   : Custom Rubble bmodel objects (unique models, must have 1 defined)
brkobj2   : Custom Rubble bmodel objects 2
brkobj3   : Custom Rubble bmodel objects 3
brkobj4   : Custom Rubble bmodel objects 4
health    : amount of damage to take before breaking (def 1)
count     : minimum quantity to spawn (def 4)
cnt       : random quantity to spawn (def 4) =-1 no random qty
dmg       : explosive radius damage (emits from center of func object)
pos1      : x=start particle colour, y=random range, z=quantity
brkvelbase : Base amount for velocity of broken parts (def "50 50 100")
brkveladd : Random additions for velocity of broken parts (def "100 100 150")
brkavel   : Amount of breaking object angle velocity (def 200)
brkfade   : Fade time before rubble fades away (def 4+random()x4)
brkmondmg : Damage multiplier for monster damage against breakable
angles    : direction to throw rubble (override default = impact direction)
brkgravity     : Change the gravity for rubble, useful for underwater (Value = 0-1)
brktrigjump    : Trigger if damaged by jumping monster attack (-1/1=active)
brktrigmissile : Trigger if damaged by rocket/grenade/shalball/radiusdmg (-1/1=active)
brktrignoplayer: No player/clients can damage this breakable
brkdelaydamage : Time pause before enabling damage on this breakable
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
-------- SPAWNFLAGS --------
STARTOFF  : Will wait for trigger to spawn
NODAMAGE  : Cannot be damaged or shot, trigger only
EXPLOSION : trigger sprite/particle explosion
SILENT    : No initial breakage sound
DAMAGE    : Spawning rubble can damage (def = 2, use dmg key for touch damage)
NOMONSTER : Monsters cannot damage this breakable and/or spawning rubble will not damage monsters
NOSOUND   : Spawning rubble has no impact sounds
NOROTATE  : Spawning rubble has No Y rotation
-------- NOTES --------
Spawn breakable ojects from a bmodel
*/

//=============================================================================
/*ad:QUAKED func_breakable_spawner (0.5 .5 .8) (-8 -8 -8) (8 8 8) x x EXPLOSION SILENT DAMAGE NOMOSTER NOSOUND NOROTATE Not_Easy Not_Normal Not_Hard Not_DM
Spawn breakable objects from a single point
-------- KEYS --------
target     : targets to fire when breakable is dead/used (only used once)
target2    : Additional trigger function (need target to be defined as well)
style      : pre-defined sound/model types - 1=rock, 2=wood, 3=glass, 4=metal, 5=brick, 6=flesh, 10=custom
brksound   : Initial breaking sound type (override style default)
brkimpsound: Impact sound type (override style default)
brkobjects : Breakable object model type (10-15=rocks, 20-22=woods, 30-32=glass, 40-42=metals, 50-54=brick, 60-62=flesh)
noise      : Initial breaking sound (unique sound file)
noise1    : Custom Rubble Impact sounds (unique sound files, must have 1 defined)
noise2    : Custom Rubble Impact sound 2
noise3    : Custom Rubble Impact sound 3
noise4    : Custom Rubble Impact sound 4
brkobj1   : Custom Rubble bmodel objects (unique models, must have 1 defined)
brkobj2   : Custom Rubble bmodel objects 2
brkobj3   : Custom Rubble bmodel objects 3
brkobj4   : Custom Rubble bmodel objects 4
health    : amount of damage to take before breaking (def 1)
count     : minimum quantity to spawn (def 4)
cnt       : random quantity to spawn (def 4) =-1 no random qty
dmg       : explosive radius damage (emits from center of func object)
pos1      : x=start particle colour, y=random range, z=quantity
brkvelbase: Base amount for velocity of broken parts (def "50 50 100")
brkveladd : Random additions for velocity of broken parts (def "100 100 150")
brkavel   : Amount of breaking object angle velocity (def 200)
brkfade   : Fade time before rubble fades away (def 4+random()x4)
angles    : direction to throw rubble (override default = impact direction)
brkgravity     : Change the gravity for rubble, useful for underwater (Value = 0-1)
brktrigjump    : Trigger if damaged by jumping monster attack (-1/1=active)
brktrigmissile : Trigger if damaged by rocket/grenade/shalball/radiusdmg (-1/1=active)
brktrignoplayer: No player/clients can damage this breakable
brkdelaydamage : Time pause before enabling damage on this breakable
brkvol      : Spawning volume vector for breakable point entity
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
-------- SPAWNFLAGS --------
EXPLOSION : trigger sprite/particle explosion
SILENT    : No initial breakage sound
DAMAGE    : Spawning rubble can damage (def = 2, use dmg key for touch damage)
NOMONSTER : Spawning rubble will not damage monsters
NOSOUND   : Spawning rubble has no impact sounds
NOROTATE  : Spawning rubble has No Y rotation
-------- NOTES --------
Spawn breakable ojects from a single point
*/

//----------------------------------------------------------------------
void() ad_breakable_remove =
{
	self.think = ad_model_fade;
	self.nextthink = time + 0.1;
	self.ltime = self.nextthink;
};

//----------------------------------------------------------------------
void() ad_breakable_checkfloor =
{
	// Is it time for the breakable to fade away?
	if (self.ad_pain_finished > time) {
		// Check floor below breakable (global function)
		// Origin at base of model + 16 (typical step height)
		ad_ent_floorcheck(self, ad_FLOOR_TRACE_BREAK);

		// Keep checking
		self.think = ad_breakable_checkfloor;
		self.nextthink = time + 0.1;
	}
	else ad_breakable_remove();
};

//----------------------------------------------------------------------
void() ad_breakable_particle =
{
	// Are particles disabled? has the model touched something?
	if (self.wait) {
		// Is there any time left to setup floor checks
		if (self.ad_pain_finished > time + 0.1) {
			self.think = ad_breakable_checkfloor;
		}
		else self.think = ad_breakable_remove;
		self.nextthink = time + 0.1;
	}
	else {
		// Add a bit of randomness to the particles generated
		if (random() < 0.5) self.nextthink = time + 0.01;
		else self.nextthink = time + 0.02;
		particle (self.origin, self.oldorigin, rint(self.pos1_x + random()*self.pos1_y), self.pos1_z);
		// Check for removal timer
		if (self.ad_pain_finished < time) self.think = ad_breakable_remove;
	}
};

//----------------------------------------------------------------------
void() ad_breakable_touch =
{
	if (self.ad_touchedvoid) { ad_entity_remove(self,0.1); return; }
	if (ad_check_skycontent(self.origin)) {ad_entity_remove(self, 0.1); return;}
	if (other.ad_classtype == ad_CT_FUNCBREAKOBJ) return;	// Ignore other breakables
	if (other.solid == ad_SOLID_TRIGGER) return;		// Ignore trigger fields
	self.wait = ad_TRUE;	// No more particles

	if (self.count < 1) {
		self.touch = ad_SUB_Null;				// no more touching
		self.solid = ad_SOLID_NOT;				// Turn off world interaction
		self.avelocity = '0 0 0';			// Stop any velocity rotation
	}
	else {
		// Does the spawning rubble hurt?
		if (self.owner.spawnflags & ad_BREAK_DAMAGE) {
			if (other.takedamage) {
				// Spawnflag BREAK_NOMONSTER = 32;  (No damage to monsters from rubble)
				// Was originally about monsters being immune to spawning rubble
				// This has changed over time to mean NO monster damage to breakable
				// The original intention is still active and really meant for
				// breakable spawners which don't have a bmodel component.
				// The ability for breakable rubble to injure monsters is not a major
				// feature and the no monster damage is more important.
				// 
				if ( other.flags & ad_FL_MONSTER && self.owner.spawnflags & ad_BREAK_NOMONSTER ) {}
				else ad_T_Damage(other, self, self, self.owner.dmg, ad_DAMARMOR);
			}
		}
		self.count = self.count - 1;
		if (!(self.owner.spawnflags & ad_BREAK_NOSOUND)) {
			// Randomize impact sound
			self.lip = random()*self.owner.ad_brkimpqty;
			if (self.lip < 1) sound(self, ad_CHAN_VOICE, self.owner.noise1, 1, ad_ATTN_BREAK);
			else if (self.lip < 2) sound(self, ad_CHAN_VOICE, self.owner.noise2, 1, ad_ATTN_BREAK);
			else if (self.lip < 3) sound(self, ad_CHAN_VOICE, self.owner.noise3, 1, ad_ATTN_BREAK);
			else sound(self, ad_CHAN_VOICE, self.owner.noise4, 1, ad_ATTN_BREAK);
		}
	}
};

//----------------------------------------------------------------------
// Can't have multiple radius explosion on same frame
// Always delay them to prevent endless loops
//----------------------------------------------------------------------
void() ad_funcbreakable_delayexplode =
{
	ad_T_RadiusDamage (self.ad_attachment, self.ad_attachment, self.dmg, self.ad_attachment, ad_DAMAGEALL);
};

//======================================================================
// Main function for generating rubble
//======================================================================
void() ad_funcbreakable_use =
{
	local vector ad_dirvec, ad_rorg, ad_gvel, ad_dirorg;
	local float ad_content_loop, ad_content_flag, ad_bbox_over;

	if (self.waitmin == ad_TRUE) return;	// Trigger once block
	if (self.ad_waitmin2 > time) return;	// Spawn damage block

	//----------------------------------------------------------------------
	// Play initial breaking sound (exception - silent spawnflag)
	if (!(self.spawnflags & ad_BREAK_SILENT)) 
		sound (self.ad_attachment, ad_CHAN_BODY, self.noise, 1, ad_ATTN_NORM);

	//----------------------------------------------------------------------
	// BMODEL breakable (brushwork)
	if (self.ad_classtype == ad_CT_FUNCBREAK) {
		self.waitmin = ad_TRUE;			// Only fire breakable ONCE
		self.use = ad_SUB_Null;			// No more triggers
		self.takedamage = ad_DAMAGE_NO;	// No more pain/damage
		self.model = "";				// hide model
		self.modelindex = 0;			// Make sure no model
		self.solid = ad_SOLID_NOT;			// no world interaction
		self.movetype = ad_MOVETYPE_NONE;
		// Work out bottom corner of min/max bounding box
		self.oldorigin = self.ad_attachment.origin - (self.size*0.5);
	}
	// MODEL breakable (.mdl file)
	else if (self.ad_classtype == ad_CT_FUNCBREAKMDL) {
		// Check for explosive puff + dust
		if (self.ad_brkpuff) {
			ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, self.origin, "");
			if (random() > 0.5) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
		}
		self.ad_movetarget = find(world, targetname, self.target);
		if (self.ad_movetarget.flags & ad_FL_MONSTER) {
			if (self.ad_jumpsquash) {
				// Always force the spawning of the telefrag (death) triggers
				// When the player is jumping onto the breakable model.
				// The player will touch the death trigger and automatically
				// kill the owner of this trigger (the spawning monster)
				self.ad_movetarget.ad_nospawndamage = ad_FALSE;
			}
			else {
				ad_bbox_over = ad_FALSE;
				// No Z comparision because brk/monster can start at diff heights
				// XY for all monsters are always the same because of rotation
				if (self.ad_movetarget.ad_bbmins_x < self.ad_bbmins_x) ad_bbox_over = ad_TRUE;
				else if (self.ad_movetarget.ad_bbmins_y < self.ad_bbmins_y) ad_bbox_over = ad_TRUE;
				else if (self.ad_movetarget.ad_bbmaxs_x > self.ad_bbmaxs_x) ad_bbox_over = ad_TRUE;
				else if (self.ad_movetarget.ad_bbmaxs_y > self.ad_bbmaxs_y) ad_bbox_over = ad_TRUE;
				// If bounding box same size as breakable, no telefrag dmg/check
				if (ad_bbox_over == ad_FALSE) self.ad_movetarget.ad_nospawndamage = ad_TRUE;
				else {
					// Warn the mapper that the spawning monster is too big!
					dprint ("\b[SPAWN]\b "); dprint (self.ad_movetarget.classname);
					dprint (" at "); dprint (vtos(self.origin));
					dprint (" larger than breakable!\n");
					ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
				}
			}
		}
		
		self.waitmin = ad_TRUE;			// Only fire breakable ONCE
		self.use = ad_SUB_Null;			// No more triggers
		self.takedamage = ad_DAMAGE_NO;	// No more pain/damage
		self.modelindex = 0;			// Make sure no model
		self.model = "";				// hide model
		self.frame = self.skin = 0;		// reset skin/frames
		self.solid = ad_SOLID_NOT;			// no world interaction
		self.movetype = ad_MOVETYPE_NONE;
	}
	// Breakable point entities just keep on spawning rubble
	else self.oldorigin = self.origin;
		
	//----------------------------------------------------------------------
	// Fire all targets (usually the target is the broken remains)
	// Only fire this target once and check based on target field only
	// Targets are fired before rubble so pointcontent check can
	// take into account any ruined sections and not spawn inside brushwork
	if (self.target != "") {
		// Check death entity (set in Killed in ai_combat.qc)
		if (self.ad_activate.flags & ad_FL_CLIENT) ad_activator = self.ad_activate;
		ad_SUB_UseTargets();
	}
	// Only fire targets once, remove any further triggering
	ad_clear_trigstrs(self);

	//----------------------------------------------------------------------
	// By default all breakables use direction force for rubble
	// If angles (movedir) set on breakable use that instead
	// Work out direction of impact (using activate passed from combat.qc or trigger.qc)
	// All bmodels are labelled with .bsporigin flag (origin = 0,0,0)
	// attachment points to self if funcbreakable_wall active
	if (self.spawnflags & ad_BREAK_MOVEDIR) { ad_dirvec = self.movedir; }
	// No activate condition? usually trigger events
	else if (!self.ad_activate) ad_dirvec = '0 0 1';
	else {
		// DEFAULT option
		if (self.ad_activate.ad_bsporigin) ad_dirorg = ad_bmodel_origin(self.ad_activate);
		else ad_dirorg = self.ad_activate.origin;
		ad_dirvec = vectoangles(self.ad_attachment.origin - ad_dirorg);
	}
	// Show impact direction for breakable
	if (ad_developer > 0) {
		if (self.ad_bsporigin) ad_spawn_arrow(ad_bmodel_origin(self), ad_dirvec, 0);
		else ad_spawn_arrow(self.origin, ad_dirvec, 0);
	}
	
	//----------------------------------------------------------------------
	// Main rubble loop
	while(self.count > 0 && self.ad_brkobjqty > 0) {
		//----------------------------------------------------------------------
		// Work out position inside bounding box of breakable bmodel
		// Just in case no space to spawn anywhere, dont do an infinite loop
		ad_content_loop = 4;
		
		while (ad_content_loop > 0) {
		// Setup broken object inside area (min/max) of parent breakable object
			if (self.ad_classtype == ad_CT_FUNCBREAK) {
				ad_rorg_x = self.oldorigin_x + random()*self.size_x;
				ad_rorg_y = self.oldorigin_y + random()*self.size_y;
				ad_rorg_z = self.oldorigin_z + random()*self.size_z;
			}
			else {
				// trigger version is a single origin point with slight wobble
				ad_rorg_x = self.origin_x + ad_crandom()*self.ad_brkvol_x;
				ad_rorg_y = self.origin_y + ad_crandom()*self.ad_brkvol_y;
				ad_rorg_z = self.origin_z + ad_crandom()*self.ad_brkvol_z;
			}
			// Check point content and keep checking (limited loop cycles)
			ad_content_flag = pointcontents(ad_rorg);
			if (ad_content_flag != ad_CONTENT_SOLID && ad_content_flag != ad_CONTENT_SKY) ad_content_loop = -1;
			else ad_content_loop = ad_content_loop - 1;
		}

		//----------------------------------------------------------------------
		// Was there any space to spawn rubble?
		if (ad_content_loop < 0) {
			// Create new piece of rubble
			ad_newmis = spawn();
			ad_newmis.classname = "rubble";
			ad_newmis.ad_classtype = ad_CT_FUNCBREAKOBJ;
			ad_newmis.ad_classgroup = ad_CG_TEMPENT;
			ad_newmis.owner = self;
			
			// Setup broken model/bsp (random selection if possible)
			self.lip = random()*self.ad_brkobjqty;
			if (self.lip < 1) setmodel (ad_newmis, self.ad_brkobj1);
			else if (self.lip < 2) setmodel (ad_newmis, self.ad_brkobj2);
			else if (self.lip < 3) setmodel (ad_newmis, self.ad_brkobj3);
			else setmodel (ad_newmis, self.ad_brkobj4);
	
			// Setup origin based on previous content checks
			setorigin (ad_newmis, ad_rorg);	
			setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	
			// Mirror the skin (exact) on the pot to the breakable chunks
			if (self.ad_classtype == ad_CT_FUNCBREAKMDL) ad_newmis.skin = self.ad_exactskin;
	
			//----------------------------------------------------------------------
			// Setup movement and spin parameters
			ad_newmis.movetype = ad_MOVETYPE_BOUNCE;
			ad_newmis.solid = ad_SOLID_BBOX;
			if (!(self.spawnflags & ad_BREAK_NOROTATE)) ad_newmis.angles_y = random() * 360;
			ad_newmis.avelocity = ad_vecrand(0,self.ad_brkavel,ad_TRUE);
			
			//----------------------------------------------------------------------
			if (self.spawnflags & ad_BREAK_MOVEDIR && self.movedir_y < 0) {
				// Up/down direction with slight X/Y wobble
				ad_newmis.velocity_x = ad_crandom() * (self.ad_brkveladd_x/2);
				ad_newmis.velocity_y = ad_crandom() * (self.ad_brkveladd_y/2);
				if (self.movedir_y == -2) ad_newmis.velocity_z = 0 - random()*50;
				else ad_newmis.velocity_z = self.ad_brkvelbase_z + (random()*self.ad_brkveladd_z);
			}
			else {
				// Directional velocity based on angle_y or activator entity
				makevectors(ad_dirvec);
				ad_gvel = v_forward * (self.ad_brkvelbase_x + random() * self.ad_brkveladd_x);
				ad_gvel = ad_gvel + v_right * (ad_crandom() * self.ad_brkveladd_y);
				ad_gvel = ad_gvel + v_up * (self.ad_brkvelbase_z + random() * self.ad_brkveladd_z);
				ad_newmis.velocity = ad_gvel;
			}
			//----------------------------------------------------------------------
			// How many bounce sounds - randomly pick 1-2
			if (random() < 0.2) ad_newmis.count = 2;
			else ad_newmis.count = 1;
		
			//----------------------------------------------------------------------
			// Touch and eventual fade functions		
			ad_newmis.touch = ad_breakable_touch;
			ad_newmis.ad_pain_finished = time + self.ad_brkfade + random()*self.ad_brkfade;
			ad_newmis.nextthink = time + 0.01;
			ad_newmis.think = ad_breakable_particle;
	
			//----------------------------------------------------------------------
			// Setup particle colour and particle dirction (forward)
			ad_newmis.pos1 = self.pos1;
			ad_gvel = vectoangles(ad_newmis.velocity);
			makevectors(ad_gvel);
			ad_newmis.oldorigin = v_forward;
			if (self.ad_brkgravity) ad_newmis.gravity = self.ad_brkgravity;			
		}
		
		//----------------------------------------------------------------------
		// Keep on spawning rubble!
		self.count = self.count - 1;
	}
	
	//----------------------------------------------------------------------
	// breakable trigger entities can spawn debris multiple times
	if (self.wait != -1) {
		self.count = self.height;
	}
	else {
		// Don't need to be active in the world anymore
		setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		// Produce explosion sprite/particle effect using attachment entity
		if (self.spawnflags & ad_BREAK_EXPLOSION) {
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
			WriteCoord (ad_MSG_BROADCAST, self.ad_attachment.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.ad_attachment.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.ad_attachment.origin_z);
			
			ad_SpawnExplosion(ad_EXPLODE_SMALL, self.ad_attachment.origin, ad_SOUND_REXP3);
			// Do no remove breakable, the rumble is still using
			// the noise keys for impact sounds
			ad_entity_hide(self);
		}
		//----------------------------------------------------------------------
		// create any explosive damage (do this last!)
		// setup the radius explosion as a delay to prevent endless loops
		if (self.dmg) {
			self.think = ad_funcbreakable_delayexplode;
			self.nextthink = time + 0.05;
		}
	}
};

//----------------------------------------------------------------------
void() ad_funcbreakable_touch =
{
	// This only works for monster and special jumping break impacts
	if (!(other.flags & ad_FL_MONSTER)) return;
	if (other.flags & ad_FL_ONGROUND) return;
	if (!self.ad_brktrigjump) return;
	self.touch = ad_SUB_Null;
	self.use();
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_funcbreakable_pain =
{
	local float ad_loop_count;
	local vector ad_vel;
	// As always there are exceptions
	// Grenades bounce and don't impact breakables, cannot tell impact point
	// If inflictor the same as attacker then particle impact done already
	if (ad_inflictor.ad_classtype == ad_CT_PROJ_GL) return;
	if (ad_inflictor == ad_attacker) return;
	// Check for player exception on damage to breakable
	if (ad_inflictor.flags & ad_FL_CLIENT && self.ad_brktrignoplayer != 0) return;
	if (ad_attacker.flags & ad_FL_CLIENT && self.ad_brktrignoplayer != 0) return;
	
	// Something is trying to wear down the breakable with damage
	// work out facing angle and project particles upward
	makevectors(ad_inflictor.angles);
	ad_vel = -v_up*2;
	while(ad_loop_count < 4) {
		particle (ad_inflictor.origin, ad_vel*0.1, self.ad_bleedcolour + rint(random()*7), ad_damage);
		ad_loop_count = ad_loop_count + 1;
	}
};

//----------------------------------------------------------------------
void() ad_funcbreakable_death =
{
	if (self.spawnflags & ad_BREAK_NOSHOOT) return;
	// Check for player exception on damage to breakable
	else if (self.ad_activate.flags & ad_FL_CLIENT && self.ad_brktrignoplayer != 0) return;
	else ad_funcbreakable_use();
};

//======================================================================
// Setup all model/sound pre-cache
//----------------------------------------------------------------------
void() ad_breakable_cache =
{
	//----------------------------------------------------------------------
	// If a breakable style key setup, update all undefined sounds/model keys
	if (self.style > 0 && self.style < ad_BTYPE_CUSTOM) {
		if (!self.ad_brksound) self.ad_brksound = self.style;
		if (!self.ad_brkimpsound) self.ad_brkimpsound = self.style;
		if (!self.ad_brkobjects) self.ad_brkobjects = self.style*10;
	}
	else return;
	
	//----------------------------------------------------------------------
	// make sure initial break sound is within range types (def=rock)
	if (self.ad_brksound < ad_BTYPE_ROCK || self.ad_brksound > ad_BTYPE_CUSTOM) 
		self.ad_brksound = ad_BTYPE_ROCK;
		
	if (self.ad_brksound == ad_BTYPE_ROCK || self.ad_brksound == ad_BTYPE_BRICK) {
		self.noise = ad_SOUND_BRK_ROCK;
		// Heavy rocks don't move around too much
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '0 0 50';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 100';
	}
	else if (self.ad_brksound == ad_BTYPE_WOOD) {
		self.noise = ad_SOUND_BRK_WOOD;
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '50 50 50';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 50';
	}
	else if (self.ad_brksound == ad_BTYPE_GLASS) {
		self.noise = ad_SOUND_BRK_GLASS;
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '50 50 50';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 150';
	}
	else if (self.ad_brksound == ad_BTYPE_METAL) {
		self.noise = ad_SOUND_BRK_METAL;
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '50 50 100';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 150';
	}
	else if (self.ad_brksound == ad_BTYPE_FLESH) {
		self.noise = ad_SOUND_BRK_FLESH;
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '0 0 50';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 100';
	}
	else if (self.ad_brksound == ad_BTYPE_CERAMIC) {
		self.noise = ad_SOUND_BRK_CERAMIC;
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '50 50 50';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 150';
	}
	else if (self.noise == "") {
		self.noise = ad_SOUND_EMPTY;
		if (!self.ad_brkvelbase) self.ad_brkvelbase = '50 50 50';
		if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 150';
	}
	precache_sound(self.noise);	

	//----------------------------------------------------------------------
	// make sure impack sounds are within range types (def=rock)
	if (self.ad_brkimpsound < ad_BTYPE_ROCK || self.ad_brkimpsound > ad_BTYPE_CUSTOM) 
		self.ad_brkimpsound = ad_BTYPE_ROCK;
	// All the impact sounds come in sets of 4 for random variety
	self.ad_brkimpqty = 4;
		
	if (self.ad_brkimpsound == ad_BTYPE_ROCK || self.ad_brkimpsound == ad_BTYPE_BRICK) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_ROCK1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_IMP_ROCK2;
		if (self.noise3 == "") self.noise3 = ad_SOUND_IMP_ROCK3;
		if (self.noise4 == "") self.noise4 = ad_SOUND_IMP_ROCK4;
	}
	else if (self.ad_brkimpsound == ad_BTYPE_WOOD) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_WOOD1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_IMP_WOOD2;
		if (self.noise3 == "") self.noise3 = ad_SOUND_IMP_WOOD3;
		if (self.noise4 == "") self.noise4 = ad_SOUND_IMP_WOOD4;
	}
	else if (self.ad_brkimpsound == ad_BTYPE_GLASS) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_GLASS1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_IMP_GLASS2;
		if (self.noise3 == "") self.noise3 = ad_SOUND_IMP_GLASS3;
		if (self.noise4 == "") self.noise4 = ad_SOUND_IMP_GLASS4;
	}
	else if (self.ad_brkimpsound == ad_BTYPE_METAL) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_METAL1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_IMP_METAL2;
		if (self.noise3 == "") self.noise3 = ad_SOUND_IMP_METAL3;
		if (self.noise4 == "") self.noise4 = ad_SOUND_IMP_METAL4;
	}
	else if (self.ad_brkimpsound == ad_BTYPE_FLESH) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_FLESH1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_IMP_FLESH2;
		if (self.noise3 == "") self.noise3 = ad_SOUND_IMP_FLESH3;
		if (self.noise4 == "") self.noise4 = ad_SOUND_IMP_FLESH4;
	}
	else if (self.ad_brkimpsound == ad_BTYPE_CERAMIC) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_CERAMIC1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_IMP_CERAMIC2;
		if (self.noise3 == "") self.noise3 = ad_SOUND_IMP_CERAMIC3;
		if (self.noise4 == "") self.noise4 = ad_SOUND_IMP_CERAMIC4;
	}
	else {
		// Workout total amount of active impact sounds (custom can have <4)
		// empty slots are filled up with empty sounds for precache reasons
		if (self.noise2 != "") {
			if (self.noise3 != "") {
				if (self.noise4 != "") self.ad_brkimpqty = 4;
				else self.ad_brkimpqty = 3;
			}
			else self.ad_brkimpqty = 2;
		}
		else self.ad_brkimpqty = 1;
		// Cannot have no impact sounds, always setup one sound by default
		if (self.pos1_x + self.pos1_y == 0) self.pos1 = '80 8 1';	// Green/Brown
		if (self.noise1 == "") self.noise1 = ad_SOUND_IMP_ROCK1;
		if (self.noise2 == "") self.noise2 = ad_SOUND_EMPTY;
		if (self.noise3 == "") self.noise3 = ad_SOUND_EMPTY;
		if (self.noise4 == "") self.noise4 = ad_SOUND_EMPTY;
	}
	precache_sound (self.noise1);
	precache_sound (self.noise2);
	precache_sound (self.noise3);
	precache_sound (self.noise4);

	//----------------------------------------------------------------------
	// make sure breakable objects are within range types (def=rock)
	//----------------------------------------------------------------------
	if (self.ad_brkobjects < ad_BMODTYPE_SELF) self.ad_brkobjects = ad_BMODTYPE_ROCK1;

	// Two ways the models can be defined, using the default bmodel types
	// or specifying the models via the brkobjs strings
	// If the first string is empty, then the default = 4 (pre-defined)
	// If first string defined, then count the model strings

	// If the first string is not empty then the mapper has to specify
	// exactly what rubble models to choose from (randomly)
	// The auto fill option (style/brkobjects) only if brkobj1 = empty
	
	if (self.ad_brkobj1 == "") self.ad_brkobjqty = 4; // Default
	else {
		// Need to check for custom breakable quantity first
		if (self.ad_brkobj2 != "") {
			if (self.ad_brkobj3 != "") {
				if (self.ad_brkobj4 != "") self.ad_brkobjqty = 4;
				else self.ad_brkobjqty = 3;
			}
			else self.ad_brkobjqty = 2;
		}
		else self.ad_brkobjqty = 1;
	}
	
	// All the broken models come in sets of 4 for random variety
	// if brkobjects is set to a custom value then model strings will be filled in
	// with a blank string and the brkobjqty will be adjusted to actual quanity	
	if (self.ad_brkobjects == ad_BMODTYPE_ROCK1) {
		if (self.pos1_x + self.pos1_y == 0) self.pos1 = '80 8 1';	// Green/Brown
		if (self.ad_brkobj1 == "") self.ad_brkobj1 = ad_MODEL_BRK_ROCK1A;
