		if (self.pos1_x + self.pos1_y == 0) self.pos1 = '48 8 1';	// Green
		if (self.ad_brkobj1 == "") self.ad_brkobj1 = ad_MODEL_BRK_FLESH2A;
		if (self.ad_brkobj2 == "") self.ad_brkobj2 = ad_MODEL_BRK_FLESH2B;
		if (self.ad_brkobj3 == "") self.ad_brkobj3 = ad_MODEL_BRK_FLESH2C;
		if (self.ad_brkobj4 == "") self.ad_brkobj4 = ad_MODEL_BRK_FLESH2D;
	}
	else if (self.ad_brkobjects == ad_BMODTYPE_FLESH3) {
		if (self.pos1_x + self.pos1_y == 0) self.pos1 = '168 8 1';	// Whiteish
		if (self.ad_brkobj1 == "") self.ad_brkobj1 = ad_MODEL_BRK_FLESH3A;
		if (self.ad_brkobj2 == "") self.ad_brkobj2 = ad_MODEL_BRK_FLESH3B;
		if (self.ad_brkobj3 == "") self.ad_brkobj3 = ad_MODEL_BRK_FLESH3C;
		if (self.ad_brkobj4 == "") self.ad_brkobj4 = ad_MODEL_BRK_FLESH3D;
	}
	else if (self.ad_brkobjects == ad_BMODTYPE_CERAMIC1) {
		if (self.pos1_x + self.pos1_y == 0) self.pos1 = '96 8 1';	// Pink/Yellow
		if (self.ad_brkobj1 == "") self.ad_brkobj1 = ad_MODEL_BRK_GLASS3A;
		if (self.ad_brkobj2 == "") self.ad_brkobj2 = ad_MODEL_BRK_GLASS3B;
		if (self.ad_brkobj3 == "") self.ad_brkobj3 = ad_MODEL_BRK_GLASS3C;
		if (self.ad_brkobj4 == "") self.ad_brkobj4 = ad_MODEL_BRK_GLASS3D;
	}
	else {
		// Cannot have no breakable models, always setup one model by default
		if (self.ad_brkobj1 == "") self.ad_brkobj1 = ad_MODEL_BRK_ROCK1A;
		if (self.ad_brkobj2 == "") self.ad_brkobj2 = ad_MODEL_EMPTY;
		if (self.ad_brkobj3 == "") self.ad_brkobj3 = ad_MODEL_EMPTY;
		if (self.ad_brkobj4 == "") self.ad_brkobj4 = ad_MODEL_EMPTY;
	}

	precache_model(self.ad_brkobj1);
	precache_model(self.ad_brkobj2);
	precache_model(self.ad_brkobj3);
	precache_model(self.ad_brkobj4);
};
	
//----------------------------------------------------------------------
// Setup defaults
//----------------------------------------------------------------------
void() ad_breakable_defaults =
{
	// Setup breakable use blockers (trig once, delay damage)
	self.waitmin = self.ad_waitmin2 = ad_FALSE;

	// Setup rubble counter = count + random*cnt
	if (self.count <= 0) self.count = ad_BREAK_DEFCOUNT;
	if (self.cnt == 0) self.cnt = ad_BREAK_DEFCNT;

	// If cnt = -1 then don't do any random factor, just exact amount
	if (self.cnt < 0) self.height = self.count;
	else self.height = self.count + rint(random()*self.cnt);
	
	// Backup rubble count for later (point entity)
	self.count = self.height;	
	
	// Special conditions - jump only, missile only, no health
	if (self.ad_brktrigjump != 0 || self.ad_brktrigmissile != 0 || self.health < 0) 
		self.spawnflags = self.spawnflags | ad_BREAK_NOSHOOT;

	// Setup default health
	if (self.health == 0) self.health = 1;
	
	// Rubble damage overrides any explosion damage
	if (self.spawnflags & ad_BREAK_DAMAGE) {
		if (self.dmg <= 0) self.dmg = 2;
	}
	else if (self.spawnflags & ad_BREAK_EXPLOSION) {
		if (self.dmg <= 0) self.dmg = ad_DAMAGE_MONROCKET;
	}
	
	// Setup default base + additional velocity and angle spin
	if (!self.ad_brkvelbase) self.ad_brkvelbase = '50 50 100';
	if (!self.ad_brkveladd) self.ad_brkveladd = '100 100 150';
	if (self.ad_brkavel <= 0) self.ad_brkavel = 200;
	if (self.ad_brkfade <= 0) self.ad_brkfade = 4;

	// angles has to be 0 0 0 otherwise brush model is twisted
	// Is there any angle direction defined for impact force direction
	// Exception: breakable models have random rotation on the model!
	if (self.angles_y && self.ad_classtype != ad_CT_FUNCBREAKMDL) {
		self.movedir_y = self.angles_y;
		self.spawnflags = self.spawnflags | ad_BREAK_MOVEDIR;
	}
	self.mangle = self.angles = '0 0 0';
	
	// reset velocity / avelocity just in case of rogue key fields
	self.velocity = self.avelocity = '0 0 0';
	
	// Can fire other triggers, make sure no delay on breakable function
	self.delay = 0;
};

//----------------------------------------------------------------------
void() ad_funcbreakable_damageon =
{
	self.takedamage = ad_DAMAGE_YES;
	self.ad_th_pain = ad_funcbreakable_pain;
	self.ad_th_die = ad_funcbreakable_death;
};

//----------------------------------------------------------------------
void() ad_breakable_trigger_touch =
{ if (other.flags & ad_FL_CLIENT) dprint("Client "); };

//----------------------------------------------------------------------
void(entity ad_targ) ad_breakable_trigger_field =
{
	ad_targ.ad_trigger_field = spawn();
	ad_targ.ad_trigger_field.ad_classtype = ad_CT_TEMPTRIG;
	ad_targ.ad_trigger_field.movetype = ad_MOVETYPE_NONE;
	ad_targ.ad_trigger_field.solid = ad_SOLID_TRIGGER;
	ad_targ.ad_trigger_field.owner = ad_targ;
	ad_targ.ad_trigger_field.touch = ad_breakable_trigger_touch;
	setsize(ad_targ.ad_trigger_field, ad_targ.ad_bbmins, ad_targ.ad_bbmaxs);
	setorigin(ad_targ.ad_trigger_field, ad_targ.origin);
};

//----------------------------------------------------------------------
void() ad_breakable_on =
{
	// Make sure use function reset
	self.use = ad_SUB_Null;
	
	// Setup collision based on bmodel type
	if (self.ad_bsporigin) {
		self.solid = ad_SOLID_BSP;
		self.movetype = ad_MOVETYPE_PUSH;
		setmodel (self, self.model);
		setorigin (self, self.origin);	
		setsize (self, self.mins , self.maxs);

		// Used for sound, radius damage and explosion
		self.ad_attachment = spawn();
		self.ad_attachment.origin = ad_bmodel_origin(self);
		setorigin(self.ad_attachment, self.ad_attachment.origin);
	}
	else {
		self.solid = ad_SOLID_BBOX;
		self.movetype = ad_MOVETYPE_NONE;
		setmodel (self, self.mdl);
		setorigin (self, self.origin);	
		setsize (self, self.ad_bbmins , self.ad_bbmaxs);
		self.angles = self.pos2;
		self.skin = self.ad_exactskin;
		// Vase 0-9 = combined models; Pot 10-29 = single models
		if (self.ad_brkmdltype < 10) self.frame = self.ad_brkmdltype;
		else self.frame = 0;
		
		// Used for sound, radius damage and explosion
		self.ad_attachment = self;
	}
	
	if (self.spawnflags & ad_BREAK_NOSHOOT) {
		self.takedamage = ad_DAMAGE_NO;
		self.ad_th_pain = ad_SUB_Null_pain;
		self.ad_th_die = ad_SUB_Null;
	}
	else {
		// Check for any damage pause before spawning new breakable
		// This is to prevent any breakables from spawning and
		// instantly being destroyed by radius damage from explosions
		// Really designed for multiple break stages
		if (self.ad_brkdelaydamage > 0) {
			self.takedamage = ad_DAMAGE_NO;
			self.ad_th_pain = ad_SUB_Null_pain;
			self.ad_th_die = ad_SUB_Null;
			self.think = ad_funcbreakable_damageon;
			self.nextthink = self.ad_waitmin2 = time + self.ad_brkdelaydamage;
		}
		else {
			self.takedamage = ad_DAMAGE_YES;
			self.ad_th_pain = ad_funcbreakable_pain;
			self.ad_th_die = ad_funcbreakable_death;
		}
		
		self.ad_bleedcolour = self.pos1_x;
		// Setup location (origin) to spawn particles
		if (self.ad_bsporigin) self.oldorigin = ad_bmodel_origin(self);
		else self.oldorigin = self.origin;
	}
	
	// Originally had this as a targetname condition because
	// if the breakable is used then it needs a referenced name
	// Since adding brktrigjump, brktrigmissile ent keys there are
	// external trigger events which need breakable entities to react
	self.use = ad_funcbreakable_use;
	// Jumping monsters don't often hit the breakable object easily
	// Easier to trap jump impact triggering with a touch function
	if (self.ad_brktrigjump) self.touch = ad_funcbreakable_touch;
};

//======================================================================
// Basic workhorse of breakable system (bmodel)
//======================================================================
void() ad_func_breakable =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	// reset out of range styles and setup default = BTYPE_ROCK (1)
	if (self.style < ad_BTYPE_ROCK || self.style > ad_BTYPE_MAX) self.style = ad_BTYPE_ROCK;
	// precache all sound/model stuff
	ad_breakable_cache();
	ad_breakable_defaults();

	// No point setting up a breakable if it cannot be triggered or shoot
	if (self.targetname == "" && self.spawnflags & ad_BREAK_NOSHOOT) {
		// Check for external event triggers and warn on console
		if (self.ad_brktrigjump != 0 || self.ad_brktrigmissile != 0) {
			dprint("\b[BRKMDL]\b trigger jump/missile exception!\n");
		}
		else {
			dprint("\b[BRKMDL]\b Cannot be triggered or shoot, removed\n");
			setmodel (self, self.model);	// set size and link into world
			setorigin (self, self.origin);	
			setsize (self, self.mins , self.maxs);
			self.oldorigin = ad_bmodel_origin(self);
			ad_spawn_marker(self.oldorigin, ad_SPNMARK_YELLOW);
			dprint("\b[BRKMDL]\b Origin - ");
			dprint(vtos(self.oldorigin));
			dprint("\n");
			remove(self);
			return;
		}
	}

	self.ad_classtype = ad_CT_FUNCBREAK;
	self.ad_classgroup = ad_CG_BREAKABLE;
	self.ad_bsporigin = ad_TRUE;		// bmodel origin 0,0,0
	self.wait = -1;				// Always work once, cannot unbreak

	if (self.spawnflags & ad_BREAK_STARTOFF) self.use = ad_breakable_on;
	else ad_breakable_on();
};

//----------------------------------------------------------------------
// Point entity version of breakbles
// Good for producing rubble from areas unreachable players
// Earthquake and rubble and dust from ceilings
//----------------------------------------------------------------------
void() ad_func_breakable_spawner =
{
	// Check for targetname
	if (self.targetname == "") {
		dprint("\b[BRKTRIG]\b Missing targetname\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}

	// reset out of range styles and setup default = BTYPE_ROCK (1)
	if (self.style < ad_BTYPE_ROCK || self.style > ad_BTYPE_MAX) self.style = ad_BTYPE_ROCK;
	// precache all sound/model stuff
	ad_breakable_cache();
	ad_breakable_defaults();

	self.ad_classtype = ad_CT_FUNCBREAKSPN;
	self.ad_classgroup = ad_CG_BREAKABLE;
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	if (self.ad_brkvol_x < 8) self.ad_brkvol_x = 8;
	if (self.ad_brkvol_y < 8) self.ad_brkvol_y = 8;
	if (self.ad_brkvol_z < 8) self.ad_brkvol_z = 8;
	// Not used, but should be defined for later
	self.ad_exactskin = self.ad_brkmdltype = 0;
	
	// Already a point entity, don't need to generate anything else
	self.ad_attachment = self;
	self.use = ad_funcbreakable_use;
};

//======================================================================
// General purpose bmodel with toggle states and solid/fade functions
// Could be used for all sorts of situations not involving breakables
//======================================================================
/*ad:QUAKED func_breakable_wall (0 .5 .8) ? START_ON SOLID FADEOUT
Switchable bmodel for breakable setups with optional collision
-------- KEYS --------
targetname : trigger entity (works with entity state system)
wait       : set to -1 for trigger once condition (def=0)
waitmin    : random time to wait before fading out
-------- SPAWNFLAGS --------
START_ON : Will spawn visible and wait for trigger
SOLID    : Will block player/monster movement
FADEOUT  : Will fade out after a certain amount of time if visible!
-------- NOTES --------
Switchable bmodel for breakable setups with optional collision

=============================================================================*/
void() ad_breakable_wall_state =
{
	// Show model and setup collision state
	if (self.state == ad_STATE_ENABLED) {
		// Does the bmodel require any solid collision?
		if (self.spawnflags & ad_BREAKWALL_SOLID) {
			self.solid = ad_SOLID_BSP;
			self.movetype = ad_MOVETYPE_PUSH;
		}
		else {
			// Bmodel visiable, no collision
			self.solid = ad_SOLID_NOT;
			self.movetype = ad_MOVETYPE_NONE;
		}
		// Add bmodel to the world
		setmodel (self, self.mdl);
	}
	// hide model
	else {
		self.solid = ad_SOLID_NOT;
		self.movetype = ad_MOVETYPE_NONE;
		self.modelindex = 0;
		self.model = "";
	}
};

//----------------------------------------------------------------------
void() ad_breakable_wall_use =
{
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	if (self.ad_attack_finished > time) return;

	// Setup to trigger once?
	if (self.wait < 0) self.ad_attack_finished = ad_LARGE_TIMER;

	// Toggle bmodel visible state
	if (self.state == ad_STATE_ENABLED) self.state = ad_STATE_DISABLED;
	else self.state = ad_STATE_ENABLED;
	
	// make sure model state is correct
	ad_breakable_wall_state();

	// Is the breakable wall visible and designed to fade away?
	if (self.spawnflags & ad_BREAKWALL_FADEOUT && self.state == ad_STATE_ENABLED) {
		// Setup random timer and fade away!
		self.nextthink = time + self.waitmin + random()*self.waitmin;
		self.think = ad_breakable_remove;
		// Change the model type and state otherwise will not alpah fade
		self.movetype = ad_MOVETYPE_NONE;
		self.solid = ad_SOLID_BBOX;
	}	
};	

//----------------------------------------------------------------------
void() ad_func_breakable_wall =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	self.ad_classtype = ad_CT_FUNCBREAKWALL;
	self.ad_classgroup = ad_CG_BREAKABLE;
	self.ad_bsporigin = ad_TRUE;		// bmodel origin 0,0,0
	self.angles = '0 0 0';		// Stop model twisting
	self.mdl = self.model;		// Save for later
	
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	// Make sure the bmodel is active in the world before changing state
	self.solid = ad_SOLID_BSP;
	self.movetype = ad_MOVETYPE_PUSH;
	setmodel (self, self.mdl);

	// Something that fades away does it only once
	if (self.spawnflags & ad_BREAKWALL_FADEOUT) self.wait = -1;
	// Default fade time = time+fade+random()*fade
	if (!self.waitmin) self.waitmin = 4;

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_breakable_wall_use;
	self.ad_estate = ad_ESTATE_ON;
	
	if (self.spawnflags & ad_BREAKWALL_START_ON) self.state = ad_STATE_ENABLED;
	else self.state = ad_STATE_DISABLED;
	ad_breakable_wall_state();
};

//======================================================================
// A point entity which triggers a breakable and monster together
//======================================================================
/*ad:QUAKED trigger_monsterbreak (.8 .5 .8) (-8 -8 -8) (8 8 8) NODELAY WAKEANIM
Trigger (once) breakable and monster together
-------- KEYS --------
targetname : trigger entity (works with entity state system)
target     : points to func_breakable (single target)
target2    : points to a monster (single target)
wait       : time before breakable is triggered (def 0.2)
-------- SPAWNFLAGS --------
NODELAY  : No delay between monster and breakable trigger
WAKEANIM : Will do special wakeup animation when triggered
-------- NOTES --------
Trigger (once) breakable and monster together

======================================================================*/
void() ad_trig_monbreak_delay =
{
	// Check for breakable targetname first
	if (self.target != "") {
		// Find breakable (single target only)
		self.owner = find(world,targetname,self.target);
		if (self.owner.ad_classtype == ad_CT_FUNCBREAK) {
			self.owner.ad_activate = self;
			self = self.owner;
			self.use();
		}
	}
};

//----------------------------------------------------------------------
void() ad_trig_monbreak_use =
{
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	if (self.ad_attack_finished > time) return;
	
	// Trigger once
	self.ad_attack_finished = ad_LARGE_TIMER;

	// Any monster defined to wakeup?
	if (self.ad_target2 != "") {
		// Find monster (single target only)
		self.enemy = find(world,targetname,self.ad_target2);
		if (self.enemy.flags & ad_FL_MONSTER) {
			if (self.spawnflags & ad_MONTRIG_WAKEUPANIM) self.enemy.ad_wakeuptrigger = ad_TRUE;
			ad_trigger_ent(self.enemy, other);
		}
	}

	// Time to explode breakable?
	if (self.spawnflags & ad_MONTRIG_NODELAY) ad_trig_monbreak_delay();
	else {
		// setup delay to trigger breakable wall
		self.nextthink = time + self.wait;
		self.think = ad_trig_monbreak_delay;
	}
};

//----------------------------------------------------------------------
void() ad_trigger_monsterbreak =
{
	self.ad_classtype = ad_CT_TRIGMONBREAK;
	self.ad_classgroup = ad_CG_BREAKABLE;
	if (self.wait <= 0) self.wait = 0.2;

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trig_monbreak_use;
	self.ad_estate = ad_ESTATE_ON;
};

//======================================================================
/*ad:QUAKED func_breakable_vase (1 .5 .25) (-16 -16 -16) (16 16 24) STARTOFF NODAMAGE EXPLOSION SILENT DAMAGE NOMOSTER NOSOUND NOROTATE
{ model(":progs/brk_vase1.mdl"); }
Breakable ceramic vase (model)
-------- KEYS --------
mdl        : Name of model to display (def = 'progs/brk_vase1.mdl')
brkobj1    : Breakable rubble 1 (def = 'progs/brk_vase1part1.mdl')
brkobj2    : Breakable rubble 2 (def = 'progs/brk_vase1part2.mdl')
brkobj3    : Breakable rubble 3 (def = 'progs/brk_vase1part3.mdl')
brkobj4    : Breakable rubble 4 (def = 'progs/brk_vase1part4.mdl')
exactskin  : Skin override of model (def 0, cannot be negative)
target     : Additional triggers to fire when model breaks
angle      : Yaw rotation of model (-1/0 = random rotation)
health     : amount of damage to take before breaking (def 1)
count      : minimum quantity to spawn (def 4)
cnt        : random quantity to spawn (def 4) final qty = count + random(cnt)
dmg        : explosive radius damage (emits from center of func object)
pos1       : x=start particle colour, y=random range, z=quantity (def '168 8 1')
bbmins     : Model bounding box MINIMUM size (def '-8 -8 -16')
bbmaxs     : Model bounding box MAXIMUM size (def '8 8 16')
brkvol     : Volume size for spawning pieces inside of (def '16 16 32')
brkmdltype : Predefined sizes (0/1 = '16 16 32' and 2/3 = '24 24 40')
brkpuff    : Spawn explosive puff of smoke and extra particles (-1 = disable)
brkvelbase : Base amount for velocity of broken parts (def '50 50 100')
brkveladd  : Random additions for velocity of broken parts (def '100 100 150')
brkavel    : Amount of breaking object angle velocity (def 200)
brkfade    : Fade time before rubble fades away (def 4+random()x4)
brkgravity : will change the gravity for rubble, useful for underwater
-------- SPAWNFLAGS --------
STARTOFF   : Will wait for trigger to spawn
NODAMAGE   : Cannot be damaged or shot, trigger only
EXPLOSION  : trigger sprite/particle explosion
SILENT     : No initial breakage sound
DAMAGE     : Spawning rubble can damage (def = 2, use dmg key for touch damage)
NOMONSTER  : monsters cannot damage this breakable and/or spawning rubble will not damage monsters
NOSOUND    : Spawning rubble has no impact sounds
NOROTATE   : Spawning rubble has No Y rotation
-------- NOTES --------
Breakable ceramic vase (model)

======================================================================*/
void() ad_func_breakable_ceramic_model =
{
	// Setup object defaults
	self.ad_classtype = ad_CT_FUNCBREAKMDL;
	self.ad_classgroup = ad_CG_BREAKABLE;
	self.style = ad_BTYPE_CERAMIC;
	self.ad_brkobjects = ad_BMODTYPE_CUSTOM;

	// Setup particle dust colour
	if (ad_CheckZeroVector(self.pos1)) self.pos1 = '168 8 1'; // Whiteish
	
	// Check for exactskin range errors, will be copied to rubble
	if (self.ad_exactskin <= 0) self.ad_exactskin = 0;
	self.skin = self.ad_exactskin;

	// Setting the angle key in the editor to UP/DOWN = random rotation	
	if (self.angles_y <= 0) self.angles_y = rint(random()*359);
	self.pos2 = self.angles;	// Save for later
	self.wait = -1;				// Only break once
	// Setup default puff of smoke on break
	if (self.ad_brkpuff < 1) self.ad_brkpuff = 0;
	else self.ad_brkpuff = 1;
	
	// precache all sound/model stuff
	ad_breakable_cache();
	ad_breakable_defaults();

	if (self.spawnflags & ad_BREAK_STARTOFF) self.use = ad_breakable_on;
	else ad_breakable_on();
};

//----------------------------------------------------------------------
void() ad_misc_breakable_vase1 =
{
	// Default model/skin
	if (self.mdl == "") self.mdl = "progs/brk_vase1.mdl";
	precache_model(self.mdl);

	if (self.ad_brkobj1 == "") self.ad_brkobj1 = "progs/brk_vase1part1.mdl";
	if (self.ad_brkobj2 == "") self.ad_brkobj2 = "progs/brk_vase1part2.mdl";
	if (self.ad_brkobj3 == "") self.ad_brkobj3 = "progs/brk_vase1part3.mdl";
	if (self.ad_brkobj4 == "") self.ad_brkobj4 = "progs/brk_vase1part4.mdl";

	// Make sure no out of range errors
	if (self.ad_brkmdltype <= 0) self.ad_brkmdltype = 0;
	// pre-defined large version (2/3)
	if (self.ad_brkmdltype == 2 || self.ad_brkmdltype == 3) {
		// 2 = large, 3 = large (animated)
		self.ad_bbmins = '-16 -16 -16';
		self.ad_bbmaxs = '16 16 24';
		self.ad_brkvol = '32 32 40';
	}
	else {
		// Default bounding box and volume
		if (ad_CheckZeroVector(self.ad_bbmins)) self.ad_bbmins = '-8 -8 -16';
		if (ad_CheckZeroVector(self.ad_bbmaxs)) self.ad_bbmaxs = '8 8 16';
		if (ad_CheckZeroVector(self.ad_brkvol)) self.ad_brkvol = '16 16 32';
	}
	// Default setup
	ad_func_breakable_ceramic_model();
};

// Re-direct (old entity format)
void() ad_func_breakable_vase = { ad_misc_breakable_vase1(); };

//----------------------------------------------------------------------
void() ad_misc_breakable_pot_setup =
{
	// Check for random model setup
	if (self.ad_brkmdltype == -1) self.ad_brkmdltype = rint(11+(random()*3.5));
	if (self.ad_brkmdltype < -1) self.ad_brkmdltype = rint(21+(random()*3.5));
	// Check for errors
	if (self.ad_brkmdltype < 11) self.ad_brkmdltype = 11;
	else if (self.ad_brkmdltype > 25) self.ad_brkmdltype = 25;
	else if (self.ad_brkmdltype > 15 && self.ad_brkmdltype < 21) self.ad_brkmdltype = 15;

	// Pick model
	if (self.ad_brkmdltype == 11) self.mdl = "progs/brk_pot1a.mdl";
	else if (self.ad_brkmdltype == 12) self.mdl = "progs/brk_pot1b.mdl";
	else if (self.ad_brkmdltype == 13) self.mdl = "progs/brk_pot1c.mdl";
	else if (self.ad_brkmdltype == 14) self.mdl = "progs/brk_pot1d.mdl";
	else if (self.ad_brkmdltype == 15) self.mdl = "progs/brk_pot1aflr.mdl";
	else if (self.ad_brkmdltype == 21) self.mdl = "progs/brk_pot2a.mdl";
	else if (self.ad_brkmdltype == 22) self.mdl = "progs/brk_pot2b.mdl";
	else if (self.ad_brkmdltype == 23) self.mdl = "progs/brk_pot2c.mdl";
	else if (self.ad_brkmdltype == 24) self.mdl = "progs/brk_pot2d.mdl";
	else if (self.ad_brkmdltype == 25) self.mdl = "progs/brk_pot2aflr.mdl";
	precache_model(self.mdl);
	
	// Pot 1a and 2a
	if (self.ad_brkmdltype == 11 || self.ad_brkmdltype == 21) {
		if (ad_CheckZeroVector(self.ad_bbmins)) self.ad_bbmins = '-16 -16 -16';
		if (ad_CheckZeroVector(self.ad_bbmaxs)) self.ad_bbmaxs = '16 16 32';
		if (ad_CheckZeroVector(self.ad_brkvol)) self.ad_brkvol = '32 32 48';
	}
	// Pot 1b and 2b
	else if (self.ad_brkmdltype == 12 || self.ad_brkmdltype == 22) {
		if (ad_CheckZeroVector(self.ad_bbmins)) self.ad_bbmins = '-10 -10 -16';
		if (ad_CheckZeroVector(self.ad_bbmaxs)) self.ad_bbmaxs = '10 10 16';
		if (ad_CheckZeroVector(self.ad_brkvol)) self.ad_brkvol = '20 20 32';
	}
	// Pot 1c and 2c
	else if (self.ad_brkmdltype == 13 || self.ad_brkmdltype == 23) {
		if (ad_CheckZeroVector(self.ad_bbmins)) self.ad_bbmins = '-16 -16 -16';
		if (ad_CheckZeroVector(self.ad_bbmaxs)) self.ad_bbmaxs = '16 16 32';
		if (ad_CheckZeroVector(self.ad_brkvol)) self.ad_brkvol = '32 32 48';
	}
	// Pot 1d and 2d
	else if (self.ad_brkmdltype == 14 || self.ad_brkmdltype == 24) {
		if (ad_CheckZeroVector(self.ad_bbmins)) self.ad_bbmins = '-12 -12 -16';
		if (ad_CheckZeroVector(self.ad_bbmaxs)) self.ad_bbmaxs = '12 12 32';
		if (ad_CheckZeroVector(self.ad_brkvol)) self.ad_brkvol = '24 24 48';
	}
	else if (self.ad_brkmdltype == 15 || self.ad_brkmdltype == 25) {
		// Find out any random rotation of the pot early for this setup
		if (self.angles_y <= 0) self.angles_y = rint(random()*359);
		// Calculate the true rotation of XY bounding box
		self.ad_bbmins = ad_mathlib_vectorotateZ('-20 -12 -16', self.angles_y);
		// The vector should have a minimum size, otherwise odd sizes
		if (self.ad_bbmins_x > -16) self.ad_bbmins_x = -16;
		if (self.ad_bbmins_y > -16) self.ad_bbmins_y = -16;
		// Calculate the true rotation of XY bounding box
		self.ad_bbmaxs = ad_mathlib_vectorotateZ('20 12 12', self.angles_y);
		// The vector should have a minimum size, otherwise odd sizes
		if (self.ad_bbmaxs_x < 16) self.ad_bbmaxs_x = 16;
		if (self.ad_bbmaxs_y < 16) self.ad_bbmaxs_y = 16;
		// Pot2a floor version is flatter on top (lower Z)
		if (self.ad_brkmdltype == 25) self.ad_bbmaxs_z = 8;
		// Volume is the same for breakable parts
		self.ad_brkvol = '32 32 32';
	}
	
	
	// Setup breakable parts for each model type
	if (self.ad_brkmdltype >= 11 && self.ad_brkmdltype <= 15) {
		self.ad_brkobj1 = "progs/brk_pot1part1.mdl";
		self.ad_brkobj2 = "progs/brk_pot1part2.mdl";
		self.ad_brkobj3 = "progs/brk_pot1part3.mdl";
		self.ad_brkobj4 = "progs/brk_pot1part4.mdl";
	}
	else if (self.ad_brkmdltype >= 21 && self.ad_brkmdltype <= 25) {
		self.ad_brkobj1 = "progs/brk_pot2part1.mdl";
		self.ad_brkobj2 = "progs/brk_pot2part2.mdl";
		self.ad_brkobj3 = "progs/brk_pot2part3.mdl";
		self.ad_brkobj4 = "progs/brk_pot2part4.mdl";
	}
	ad_func_breakable_ceramic_model();
};

//----------------------------------------------------------------------
void() ad_misc_breakable_pot1a = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -1;
	else self.ad_brkmdltype = 11;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot1b = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -1;
	else self.ad_brkmdltype = 12;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot1c = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -1;
	else self.ad_brkmdltype = 13;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot1d = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -1;
	else self.ad_brkmdltype = 14;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot1aflr = {
	self.ad_brkmdltype = 15;
	ad_misc_breakable_pot_setup();
};
//----------------------------------------------------------------------
void() ad_misc_breakable_pot2a = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -2;
	else self.ad_brkmdltype = 21;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot2b = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -2;
	else self.ad_brkmdltype = 22;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot2c = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -2;
	else self.ad_brkmdltype = 23;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot2d = {
	if (self.ad_brkmdltype < 0) self.ad_brkmdltype = -2;
	else self.ad_brkmdltype = 24;
	ad_misc_breakable_pot_setup();
};
void() ad_misc_breakable_pot2aflr = {
	self.ad_brkmdltype = 25;
	ad_misc_breakable_pot_setup();
};
