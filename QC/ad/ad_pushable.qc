// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/pushable.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 Pushables bmodels

 * Looked at the code from Hipnotic Interactive (hip_push.qc)
   - It uses a proxy entity for the player to interact with
   - Movement is done by constantly updating origin
   - Code seems really experimental and a horrible mess

   * Looked at the code from the Nehara mod (push.qc)
   - It uses the original bmodel entity with velocity instead
   - Has one push sound type and moves XY directions

   * AD solution is inspired by Nehara code 
   - It uses the original bmodel and velocity movement
   - Switches movetype/solid so players can stand on top
   - Fades the bmodel (via alpha) so it does not block view
   - Works with entity state system, reset very useful if stuck
   - Works really close with breakables (target2 triggers)
 
======================================================================*/
float ad_PUSH_DAMAGE = 2;		// Can receive damage (from anything) 
float ad_PUSH_NOFLRCHECK = 8;	// No floor below check for movement
float ad_PUSH_FLOATING = 16;	// Start floating on spawn (like items)
float ad_PUSH_NOMONSTER = 32;	// Cannot be damaged by monsters

// Pushable sound/impact types
float ad_PTYPE_ROCK = 1;		// Default rock
float ad_PTYPE_WOOD = 2;
float ad_PTYPE_GLASS = 3;
float ad_PTYPE_METAL = 4;
float ad_PTYPE_BRICK = 5;
float ad_PTYPE_CUSTOM = 10;	// Custom push sounds

// Three sounds to randomly pick from 0.5s each
string ad_SOUND_PUSH_ROCK1 = "pushable/rock_m1.wav";
string ad_SOUND_PUSH_ROCK2 = "pushable/rock_m2.wav";
string ad_SOUND_PUSH_ROCK3 = "pushable/rock_m3.wav";
string ad_SOUND_PUSH_WOOD1 = "pushable/wood_m1.wav";
string ad_SOUND_PUSH_WOOD2 = "pushable/wood_m2.wav";
string ad_SOUND_PUSH_WOOD3 = "pushable/wood_m3.wav";
string ad_SOUND_PUSH_GLASS1 = "pushable/glass_m1.wav";
string ad_SOUND_PUSH_GLASS2 = "pushable/glass_m2.wav";
string ad_SOUND_PUSH_GLASS3 = "pushable/glass_m3.wav";
string ad_SOUND_PUSH_METAL1 = "pushable/metal_m1.wav";
string ad_SOUND_PUSH_METAL2 = "pushable/metal_m2.wav";
string ad_SOUND_PUSH_METAL3 = "pushable/metal_m3.wav";
string ad_SOUND_PUSH_BRICK1 = "pushable/brick_m1.wav";
string ad_SOUND_PUSH_BRICK2 = "pushable/brick_m2.wav";
string ad_SOUND_PUSH_BRICK3 = "pushable/brick_m3.wav";

// Which touch state (used for fading)
float ad_STATE_PUSH = 1;
float ad_STATE_SOLID = 2;

//======================================================================
/*ad:QUAKED func_pushable (0 .5 .8) ? x DAMAGE x NOFLRCHECK FLOATING NOMONSTER STARTOFF x Not_Easy Not_Normal Not_Hard Not_DM
Moveable brushwork (pushable)
-------- KEYS --------
targetname : trigger entity (works with entity state system)
style      : sound move/impact types - 1=rock, 2=wood, 3=glass, 4=metal, 5=brick, 10=custom
noise1     : Custom move sound 1 (style=10)
noise2     : Custom move sound 2
noise3     : Custom move sound 3
bleedcolour: Impact particle colour (starting point on palette)
target     : target(s) to fire when pushable is dead (once only)
deathtarget: target(s) to fire when pushable is dead (once only)
target2    : points to a func_breakable_spawner to trigger on death
message    : Message to display when killed by player
message2   : Message to display when touched by player
wait       : Time for showing touch/death message (=-1 once, def=2)
health     : damage taken before death
death_dmg  : will explode on death (reqs health)
speed      : pushing speed (def = 1)
waitmin    : length of pushable sounds (def=0.5s)
waitmin2   : Alpha value to fade block down to when pushing
-------- SPAWNFLAGS --------
DAMAGE    : Pushable can be damaged or destroyed
NOFLRCHECK: No floor below check for extra velocity
FLOATING  : Pushable starts off floating (until touched)
NOMONSTER : Cannot be damaged by monsters
STARTOFF  : Starts off and waits for trigger
-------- NOTES --------
Moveable brushwork (pushable)
*/
//======================================================================

//----------------------------------------------------------------------
void() ad_func_pushable_push =
{
	self.movetype = ad_MOVETYPE_STEP;	// Default monster move type
	self.solid = ad_SOLID_SLIDEBOX;	// Discrete movement stepping
	self.state = ad_STATE_PUSH;		// Can be moved by player
};

//----------------------------------------------------------------------
void() ad_func_pushable_solid = 
{
	self.movetype = ad_MOVETYPE_PUSH;	// Blocks projectiles
	self.solid = ad_SOLID_BSP;			// Square bounding box
	self.state = ad_STATE_SOLID;		// No world interaction
	self.ad_inpain = ad_FALSE;			// Reset touch flag
};

//----------------------------------------------------------------------
void() ad_func_pushable_movement =
{
	// Block entity state exceptions
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Block movement if nothing has changed
	if (self.oldorigin == self.origin && !self.ad_inpain) return;
	self.oldorigin = self.origin;
	// Reset touch function flag
	self.ad_inpain = ad_FALSE;
	
	// Check for moving sound
	if (self.ad_attack_finished < time && self.state == ad_STATE_PUSH) {
		// Random start to setup blending and overlap
		self.ad_attack_finished = time + self.waitmin + (random()*self.waitmin);
		// Make sure sound WAVs don't repeat in a row
		self.lefty = self.ad_meleeattack;
		while (self.lefty == self.ad_meleeattack) { 
			self.lefty = rint(random()*3);
		}
		// CHAN_AUTO to allow for sound blending
		self.ad_meleeattack = self.lefty;
		if (self.ad_meleeattack == 1) 
			sound (self, ad_CHAN_AUTO, self.noise1, 1, ad_ATTN_NORM);
		else if (self.ad_meleeattack == 2) 
			sound (self, ad_CHAN_AUTO, self.noise2, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_AUTO, self.noise3, 1, ad_ATTN_NORM);
	}	

	// Remove onground flag so bmodel can move
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);

	// Transfer velocity from player to pushable
	// Read velocity from saved touch entity
	self.velocity_x = self.ad_finaldest_x * self.speed;
	self.velocity_y = self.ad_finaldest_y * self.speed;

	// Enable floor below check?
	if (!(self.spawnflags & ad_PUSH_NOFLRCHECK)) {
		// Work out push direction
		makevectors(self.finalangle);
		self.movedir = normalize(v_forward);
		self.movedir_z = 0;
		
		// Work out true min/max for bmodel using origin (offset)
		self.ad_bbmins = self.origin + self.mins;
		self.ad_bbmaxs = self.origin + self.maxs;

		// Find the middle of the bottom edge
		self.ad_move_state = self.ad_bbmins;
		self.ad_move_state_x = self.ad_move_state_x + (self.size_x*0.5);
		self.ad_move_state_y = self.ad_move_state_y + (self.size_y*0.5);
		
		// Trace down and see if anything is underneath it
		traceline(self.ad_move_state, self.ad_move_state+'0 0 -1024', ad_FALSE, self);
		// Work out length of traceline downward
		self.t_length = fabs(trace_endpos_z - self.ad_move_state_z);
		
		// Is there space below middle point?
		if (self.t_length > 0) {
			// Keep velocity active while ground is missing
			self.velocity = self.velocity + (self.movedir*self.t_width);
			// Keep looping around until on ground
			self.think = ad_func_pushable_movement;
			self.nextthink = time + 0.05;
		}
	}
};

//----------------------------------------------------------------------
void() ad_func_pushable_touch =
{
	// Block entity state exceptions
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Allow for pushables to stack
	if (other.ad_classtype == ad_CT_FUNCPUSHABLE && other.state == ad_STATE_PUSH) {
		// Switch to solid block
		ad_func_pushable_solid();
		return;
	}
	
	// Only works for the player
	if ( !(other.flags & ad_FL_CLIENT) ) return;

	// Touch function is active
	self.ad_inpain = ad_TRUE;

	// Keep updating touch condition for fade controller
	// Create an overlap for the touch to stop working
	self.ad_pain_finished = time + 0.5;
	
	// Check for a touch message
	if (self.ad_message2 != "" && self.ad_idletimer < time) {
		if (self.wait > 0) self.ad_idletimer = time + self.wait;
		ad_centerprint(other, self.ad_message2);
		if (self.wait < 0) self.ad_message2 = "";
	}

	// Slow down the detection of the touching object
	//
	// This is not an ideal solution, its a horrible hack!
	// The touching entity should be consistent with its Z axis
	// origin if the entity is not moving up or down.
	// For some reason the Z axis is inconsistent +/- 18 units
	// Cannot slowdown the touch function because the movement
	// of the pushable stutters and looks terrible.
	// Touch functions cycle at really high frame rates so
	// its easier to slowdown the reading the entity instead!
	//
	if (self.ad_oldenemy != other || self.ad_meleetimer < time) {
		// Save player details for later
		self.ad_oldenemy = other;
		self.dest1 = self.ad_oldenemy.origin;
		self.dest2 = self.ad_oldenemy.view_ofs;
		// Slowdown the reading of the touching entity
		self.ad_meleetimer = time + 0.01;
	}
	
	self.finalangle = self.ad_oldenemy.angles;
	self.ad_finaldest = self.ad_oldenemy.velocity;

	// Setup origin of player (at feet level)
	self.ad_pos3 = self.dest1 - self.dest2;
	
	// Work out true min/max for bmodel using origin (offset)
	self.ad_bbmins = self.origin + self.mins;
	self.ad_bbmaxs = self.origin + self.maxs;

	// Check if player is above/below pushable
	if (self.ad_pos3_z >= self.ad_bbmaxs_z) 
		ad_func_pushable_solid();		// Stop the bmodel interacting with player
	else {
		ad_func_pushable_push();		// bmodel can be moved (again)
		ad_func_pushable_movement();	// Move the pushable block
	}
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_func_pushable_pain =
{
	local float ad_loop_count;
	local vector ad_vel;

	// default = Pushables cannot die
	if (!(self.spawnflags & ad_PUSH_DAMAGE)) {self.health = ad_MEGADEATH; return;}
	// Block entity state exceptions
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Something is trying to wear down the pushable with damage
	// work out facing angle and project particles upward
	makevectors(ad_inflictor.angles);
	ad_vel = -v_up*2;
	while(ad_loop_count < 4) {
		particle (ad_inflictor.origin, ad_vel*0.1, self.ad_bleedcolour + rint(random()*7), ad_damage);
		ad_loop_count = ad_loop_count + 1;
	}
};

//----------------------------------------------------------------------
void() ad_func_pushable_death =
{
	// default = Pushables cannot die
	if (!(self.spawnflags & ad_PUSH_DAMAGE)) {self.health = ad_MEGADEATH; return;}
	// Block entity state exceptions
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	
	// Work out current bmodel origin
	self.oldorigin = ad_bmodel_origin(self);
	
	// Check for breakable spawners
	if (self.ad_target2 != "") {
		self.enemy = find (world, targetname, self.ad_target2);
		// Make sure its a breakable spawner ONLY!
		if (self.enemy.ad_classtype == ad_CT_FUNCBREAKSPN) {
			// Copy over pushable bmodel origin and volume to breakable
			self.enemy.origin = self.oldorigin;
			setorigin(self.enemy, self.enemy.origin);
			self.enemy.ad_brkvol = self.size;
			// Use entity which killed pushable for breakable direction
			ad_trigger_ent(self.enemy, self.ad_activate);
		}
	}

	// Check for explosion sprite/particle effect
	if (self.ad_death_dmg > 0) {
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
		WriteCoord (ad_MSG_BROADCAST, self.oldorigin_x);
		WriteCoord (ad_MSG_BROADCAST, self.oldorigin_y);
		WriteCoord (ad_MSG_BROADCAST, self.oldorigin_z);
		
		ad_SpawnExplosion(ad_EXPLODE_SMALL, self.oldorigin, ad_SOUND_REXP3);
		ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	}
	
	// Fire death targets (check DT first, because target can have uses)
	if (self.ad_deathtarget != "") ad_trigger_strs(self.ad_deathtarget, self.ad_activate);
	if (self.target != "") ad_trigger_strs(self.target, self.ad_activate);

	// Any final words ...
	if (self.ad_activate.flags & ad_FL_CLIENT && self.message != "")
		ad_centerprint (self.ad_activate, self.message);
	
	// Fire once condition?
	if (self.wait < 0) {
		self.target = self.ad_deathtarget = self.message = "";
	}
	
	// Check for any pushable above? (fake physics)
	self.ad_move_state = ad_bmodel_origin(self);
	
	// Trace up and see if anything is above
	traceline(self.ad_move_state, self.ad_move_state + '0 0 1024', ad_FALSE, self);

	// Check for a pushable entity above (but not touching)
	if (trace_ent != self && trace_ent.ad_classtype == ad_CT_FUNCPUSHABLE)
		ad_trigger_ent(trace_ent, self);
	
	// Switch off entity instead of hide/remove
	// So the pushable can be reset again
	self.ad_estate_off();
};

//======================================================================
// The pushable needs a controller to reach to the touch function
// and to reset the alpha fade if the pushable is not being touched
//======================================================================
void() ad_pushable_controller_think =
{
	// Keep the controller alive
	self.think = ad_pushable_controller_think;
	self.nextthink = time + 0.1;
	
	// Block entity state exceptions
	if (self.owner.ad_estate & ad_ESTATE_BLOCK) return;
	
	// Check if the player is touching the pushable?
	// If the player is standing on the block, no alpha
	if (self.owner.ad_pain_finished > time && self.owner.state == ad_STATE_PUSH) {
		// Is the alpha set the right amount?
		if (self.owner.alpha > self.owner.ad_waitmin2) {
			self.owner.alpha = self.owner.alpha - 0.01;
			self.nextthink = time + ad_FADEMODEL_TIME;
		}
	}
	else {
		if (self.owner.alpha < 1.00) {
			self.owner.alpha = self.owner.alpha + 0.01;
			self.nextthink = time + ad_FADEMODEL_TIME;
		}
	}
};

//----------------------------------------------------------------------
void() ad_func_pushable_controller_setup =
{
	// Check if controller entity been setup
	if (!self.ad_attachment) self.ad_attachment = spawn();

	// Setup link back to pushable
	self.ad_attachment.owner = self;
	self.ad_attachment.ad_classtype = ad_CT_CONTROL;
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	self.ad_attachment.solid = ad_SOLID_NOT;
	// Move to pushable bmodel origin location
	self.ad_attachment.origin = ad_bmodel_origin(self);
	setorigin(self.ad_attachment, self.ad_attachment.origin);
	setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	
	// Start fade controller think loop
	self.ad_attachment.think = ad_pushable_controller_think;
	self.ad_attachment.nextthink = time + 0.1;
};

//======================================================================
// Entity state functions
//======================================================================
void() ad_func_pushable_use =
{
	// Switch on pushable first
	if (self.ad_estate == ad_ESTATE_OFF) ad_entity_state_on();
	else {
		// Let the pushable move around
		ad_func_pushable_push();
		self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
		// Push upward using size as force
		self.velocity_z = self.t_width;
	}
};

//----------------------------------------------------------------------
void() ad_func_pushable_reset = 
{	
	// If the block starts off(disabled) then do nothing
	if (self.spawnflags & ad_ENT_STARTOFF) return;

	// reset to original position
	setorigin(self, ad_VEC_ORIGIN);
	// Make sure the bmodel drops down, no weird ofset
	self.velocity = self.avelocity = '0 0 0';
	self.ad_estate_on();	
};

//----------------------------------------------------------------------
void() ad_func_pushable_off = 
{
	// Do nothing if pushable is already off
	if (self.ad_estate == ad_ESTATE_OFF) return;
	
	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel (self, "");
	// Switch off impact particles
	self.takedamage = ad_DAMAGE_NO;
};

//----------------------------------------------------------------------
void() ad_func_pushable_on = 
{
	// Do nothing if pushable is already on
	if (self.ad_estate == ad_ESTATE_ON) return;
	
	// No longer need this spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_ENT_STARTOFF);

	self.ad_estate = ad_ESTATE_ON;
	ad_func_pushable_push();
	setmodel (self, self.mdl);
	
	// Setup touch fade controller
	if (!self.ad_attachment) ad_func_pushable_controller_setup();

	// Switch on impact particles
	self.takedamage = ad_DAMAGE_AIM;
	// Reset health to spawn 
	self.health = self.max_health;

	if (!(self.spawnflags & ad_PUSH_FLOATING)) {
		// Make sure it drops to ground on spawn
		self.origin_z = self.origin_z + 4;
		self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	}
	else ad_func_pushable_solid();
};

//======================================================================
// Main entity definition
//======================================================================
void() ad_func_pushable =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	//------------------------------------------------------------------
	// make sure initial break sound is within range types (def=rock)
	if (self.style < ad_PTYPE_ROCK || self.style > ad_PTYPE_CUSTOM) 
		self.style = ad_PTYPE_ROCK;
		
	// Medium drag sound with light brown impact particles
	if (self.style == ad_PTYPE_WOOD) {
		self.noise1 = ad_SOUND_PUSH_WOOD1;
		self.noise2 = ad_SOUND_PUSH_WOOD2;
		self.noise3 = ad_SOUND_PUSH_WOOD3;
		if (self.ad_bleedcolour <= 0) self.ad_bleedcolour = 112;
	}
	// Light drag sound with light yellow impact particles
	else if (self.style == ad_PTYPE_GLASS) {
		self.noise1 = ad_SOUND_PUSH_GLASS1;
		self.noise2 = ad_SOUND_PUSH_GLASS2;
		self.noise3 = ad_SOUND_PUSH_GLASS3;
		if (self.ad_bleedcolour <= 0) self.ad_bleedcolour = 96;
	}
	// Medium drag sound with green/brown impact particles
	else if (self.style == ad_PTYPE_METAL) {
		self.noise1 = ad_SOUND_PUSH_METAL1;
		self.noise2 = ad_SOUND_PUSH_METAL2;
		self.noise3 = ad_SOUND_PUSH_METAL3;
		if (self.ad_bleedcolour <= 0) self.ad_bleedcolour = 80;
	}
	// Light drag sound with brown impact particles
	else if (self.style == ad_PTYPE_BRICK) {
		self.noise1 = ad_SOUND_PUSH_BRICK1;
		self.noise2 = ad_SOUND_PUSH_BRICK2;
		self.noise3 = ad_SOUND_PUSH_BRICK3;
		if (self.ad_bleedcolour <= 0) self.ad_bleedcolour = 80;
	}
	// Custom sounds with white/grey impact particles
	else if (self.style == ad_PTYPE_CUSTOM) {
		if (self.noise1 == "") self.noise1 = ad_SOUND_EMPTY;
		if (self.noise2 == "") self.noise2 = ad_SOUND_EMPTY;
		if (self.noise3 == "") self.noise3 = ad_SOUND_EMPTY;
		if (self.ad_bleedcolour <= 0) self.ad_bleedcolour = 1;
	}
	// *** DEFAULT ***
	// Heavy drag sound with brown impact particles
	else {
		self.noise1 = ad_SOUND_PUSH_ROCK1;
		self.noise2 = ad_SOUND_PUSH_ROCK2;
		self.noise3 = ad_SOUND_PUSH_ROCK3;
		if (self.ad_bleedcolour <= 0) self.ad_bleedcolour = 80;
	}
	
	// Cache all sounds
	precache_sound (self.noise1);
	precache_sound (self.noise2);
	precache_sound (self.noise3);

	self.ad_classtype = ad_CT_FUNCPUSHABLE;
	self.ad_classgroup = ad_CG_BREAKABLE;
	self.ad_bsporigin = ad_TRUE;
	self.mdl = self.model;

	// Save starting position and reset angles
	self.mangle = self.angles;
	self.angles = '0 0 0';

	// Default parameters and states
	if (!self.speed) self.speed = 1;
	if (!self.wait) self.wait = 2;
	
	// Length of dragging sounds
	if (!self.waitmin) self.waitmin = 0.5;
	// Create halway point for random start
	self.waitmin = self.waitmin * 0.5;
	// Start with pushing state
	self.state = ad_STATE_PUSH;
	self.ad_pain_finished = -1;
	// Setup default alpha fade (lower) value
	if (!self.ad_waitmin2) self.ad_waitmin2 = 0.6;
	self.alpha = 1;

	// setup pain/die functions
	self.ad_th_pain = ad_func_pushable_pain;
	self.ad_th_die = ad_func_pushable_death;
	
	// The pushable needs to take damage for impact sounds
	// to work correctly. Check for health default first
	// Pain/death needs to reset health if indestructible
	if (self.health <= 0) {
		if (self.spawnflags & ad_PUSH_DAMAGE) self.health = 1;
		else self.health = ad_MEGADEATH;
	}
	self.max_health = self.health;
	
	// Setup the bmodel ready for interaction
	ad_func_pushable_solid();
	setmodel(self, self.mdl);
	setorigin(self, ad_VEC_ORIGIN);
	setsize(self, self.mins, self.maxs);
	
	// Work out average size of block
	self.t_width = rint((self.size_x + self.size_y) * 0.5);
	
	// Check for spawning conditions (nightmare, coop)
	// Needs to exist after entity has been added to work for BSPorigin
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;
	
	// Setup Entity State functionality
	self.use = ad_entity_state_use;
	self.ad_estate_use = ad_func_pushable_use;
	self.ad_estate_on = ad_func_pushable_on;
	self.ad_estate_off = ad_func_pushable_off;
	self.ad_estate_reset = ad_func_pushable_reset;
	self.touch = ad_func_pushable_touch;
	
	// Setup pushable in correct state
	if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
	else self.ad_estate_on();
};
