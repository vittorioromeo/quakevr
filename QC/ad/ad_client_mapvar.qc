// AD's readme and docs/vr-port/CREDITS.md), my_progs/client_mapvar.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
Client Map Variables
--------------------

Allows for binary (0/1) map variables to be stored with the map save
system (parm1-16) by the engine. The top 6 parm variables are never used
and can easily be turned into variables for the map to use.

======================================================================*/
float ad_MAPV_BITS = 22;			// Bits used in each parm block
float ad_MAPV_BLCK = 6;			// Blocks used (total parm's)
float ad_MAPV_TOTAL = 132;			// Maximum amount of variables

float ad_MAPV_QUERY = 1;			// Point entity - Query value
float ad_MAPV_UPDATE = 2;			// Point entity - Update value
float ad_MAPV_TOGGLE = 4;			// Point entity - Toggle value
float ad_MAPV_MONSTERS = 32;		// Monsters can use bmodel trigger

float ad_bitflags[24];				// Bitflag values
float ad_mapvar[6];				// Map variables stored in savefile

//======================================================================
/*ad:QUAKED trigger_mapvar_query (.5 .7 1) (-8 -8 -16) (8 8 16) x
Trigger target(s) based on mapvar
-------- KEYS --------
targetname : trigger entity (works with entity state system)
count   : Map Variable to check (range checks)
target  : Map variable == 0 fire these target(s)
target2 : Map variable == 1 fire these target(s)
noise   : aframe switchable object
wait    : -1 = trigger once
-------- SPAWNFLAGS --------
-------- NOTES --------
Trigger target(s) based on mapvar
*/
//-----------------------------------------------------------------------------
/*ad:QUAKED trigger_mapvar_update (.5 .7 1) (-8 -8 -16) (8 8 16) x
Update the value of mapvar
-------- KEYS --------
targetname : trigger entity (works with entity state system)
count   : Map Variable to check (range checks)
cnt     : Value (0/1)
target  : Map variable == 0 fire these target(s)
target2 : Map variable == 1 fire these target(s)
noise   : aframe switchable object
wait    : -1 = trigger once
-------- SPAWNFLAGS --------
-------- NOTES --------
Update the value of mapvar
*/
//-----------------------------------------------------------------------------
/*ad:QUAKED trigger_mapvar_toggle (.5 .7 1) (-8 -8 -16) (8 8 16) x
Toggle the value of mapvar
-------- KEYS --------
targetname : trigger entity (works with entity state system)
count   : Map Variable to check (range checks)
target  : Map variable == 0 fire these target(s)
target2 : Map variable == 1 fire these target(s)
noise   : aframe switchable object
wait    : -1 = trigger once
-------- SPAWNFLAGS --------
-------- NOTES --------
Toggle the value of mapvar
*/

// Setup the bitflag array (used in world.qc)
void() ad_mapvar_setuparray =
{
	local float ad_bitindex, ad_bitpow;
	
	// Setup loop and first bit
	ad_bitindex = 0; ad_bitpow = 1;
	while (ad_bitindex < 24) {
		ad_bitflags[ad_bitindex] = ad_bitpow;
		ad_bitpow = ad_bitpow * 2;
		ad_bitindex = ad_bitindex + 1;
	}
};

//----------------------------------------------------------------------
// Reset all map variable banks to zero (used in client.qc)
void() ad_mapvar_reset =
{
	local float ad_mapv_bank;
	
	ad_mapv_bank = 0;
	while (ad_mapv_bank < ad_MAPV_BLCK) {
		ad_mapvar[ad_mapv_bank] = 0;
		ad_mapv_bank = ad_mapv_bank + 1;
	}
};

//----------------------------------------------------------------------
// Read map variable from block/bits parms and return value
float(float ad_mapv_indx) ad_query_mapvar =
{
	local float ad_mapv_bank, ad_mapv_cell, ad_mapv_bit;
	
	// Work out parm and bitflag index
	ad_mapv_bank = floor(ad_mapv_indx/ad_MAPV_BITS);
	ad_mapv_cell = ad_mapv_indx - (ad_mapv_bank*ad_MAPV_BITS);
	// Error check return value
	if (ad_mapv_bank < 0 || ad_mapv_bank >= ad_MAPV_BLCK) ad_mapv_bank = 0;
	if (ad_mapv_cell < 0 || ad_mapv_cell >= ad_MAPV_BITS) ad_mapv_cell = 0;
	// Find bitflag mask value
	ad_mapv_bit = ad_mapvar[ad_mapv_bank] & ad_bitflags[ad_mapv_cell];
	
	/* Debug info (not used anymore)
	dprint("Number ("); dprint(ftos(mapv_indx));
	dprint(") B/C ("); dprint(ftos(mapv_bank));
	dprint(" "); dprint(ftos(mapv_cell));
	dprint(") = ("); dprint(ftos(mapv_bit));
	dprint(")\n"); */

	if (ad_mapv_bit > 0) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// Update map variable from block/bits parms
void(float ad_mapv_indx, float ad_mapv_val) ad_update_mapvar =
{
	local float ad_mapv_bank, ad_mapv_cell;
	
	// Work out parm and bitflag index
	ad_mapv_bank = floor(ad_mapv_indx/ad_MAPV_BITS);
	ad_mapv_cell = ad_mapv_indx - (ad_mapv_bank*ad_MAPV_BITS);
	// Error check return value
	if (ad_mapv_bank < 0 || ad_mapv_bank >= ad_MAPV_BLCK) ad_mapv_bank = 0;
	if (ad_mapv_cell < 0 || ad_mapv_cell >= ad_MAPV_BITS) ad_mapv_cell = 0;
	
	// Remove any existing bitflag value
	ad_mapvar[ad_mapv_bank] = ad_mapvar[ad_mapv_bank] - (ad_mapvar[ad_mapv_bank] & ad_bitflags[ad_mapv_cell]);

	// Is the bit value TRUE?
	if (ad_mapv_val == ad_TRUE) {
		ad_mapvar[ad_mapv_bank] = ad_mapvar[ad_mapv_bank] | ad_bitflags[ad_mapv_cell];
	}
};

//----------------------------------------------------------------------
// Set a range of map variables (used in triggers.qc)
void(vector ad_mapv_range) ad_mapvar_range =
{
	local vector ad_mapv_dest;
	local float ad_mapv_swap, ad_mapv_loop;
	
	// Remove any negative or fractions
	ad_mapv_dest_x = fabs(rint(ad_mapv_range_x));
	ad_mapv_dest_y = fabs(rint(ad_mapv_range_y));
	ad_mapv_dest_z = fabs(rint(ad_mapv_range_z));

	// Check for upper variable range
	if (ad_mapv_dest_x >= (ad_MAPV_BLCK*ad_MAPV_BITS))
		ad_mapv_dest_x = (ad_MAPV_BLCK*ad_MAPV_BITS) - 1;
	if (ad_mapv_dest_y >= (ad_MAPV_BLCK*ad_MAPV_BITS))
		ad_mapv_dest_y = (ad_MAPV_BLCK*ad_MAPV_BITS) - 1;
	if (ad_mapv_dest_z > 1) ad_mapv_dest_z = 1;

	// Check for reverse order on range
	if (ad_mapv_dest_x > ad_mapv_dest_y) {
		ad_mapv_swap = ad_mapv_dest_x;
		ad_mapv_dest_x = ad_mapv_dest_y;
		ad_mapv_dest_y = ad_mapv_swap;
	}

	// Count through range
	ad_mapv_loop = ad_mapv_dest_x;
	while (ad_mapv_loop <= ad_mapv_dest_y) {
		// Change map variable
		ad_update_mapvar(ad_mapv_loop, ad_mapv_dest_z);
		ad_mapv_loop = ad_mapv_loop + 1;
	}
};

//----------------------------------------------------------------------
// Display the value of all map variable parm blocks
void() ad_display_mapvar =
{
	local float ad_loopbank, ad_loopcell, ad_loopspace, ad_loopval;
	
	// Default return conditions (must be player and developer)
	if ( !(self.flags & ad_FL_CLIENT) ) return;
	if (ad_developer == 0) {
		sprint(self,"\b[IMPULSE]\b Only works in developer mode!\n");
		return;
	}
	// Has the map variable system been setup?
	if (!ad_mapvar_cvar) {
		sprint(self,"\b[MAPVAR]\b System has not been setup yet!\n");
		return;
	}

	// Reset impulse and initialize variables
	self.impulse = 0;
	ad_loopbank = ad_loopcell = 0;

	dprint("\n\b[MAPVAR]\b Current System Values\n"); 
	dprint("--------------------------------------\n");
	while (ad_loopbank < ad_MAPV_BLCK) {
		dprint("Bank "); dprint(ftos(ad_loopbank)); dprint(" - ");
		ad_loopcell = 0; ad_loopspace = 4;
		while (ad_loopcell < ad_MAPV_BITS) {
			ad_loopval = ad_query_mapvar((ad_loopbank*ad_MAPV_BITS)+ad_loopcell);
			dprint(ftos(ad_loopval));
			
			ad_loopcell = ad_loopcell+1;
			if (ad_loopcell == ad_loopspace) {
				dprint(" "); 
				ad_loopspace = ad_loopspace+4;
			}
		}
		dprint("\n");
		ad_loopbank = ad_loopbank+1;
	}
	dprint("--------------------------------------\n");
};

//----------------------------------------------------------------------
void() ad_trigger_mapvar_base_use =
{
	// Block entity state exceptions
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	// Is the trigger blocked? (trigger_once)
	if (self.ad_attack_finished > time) return;

	// UPDATE : Map Variable
	if (self.style == ad_MAPV_UPDATE) {
		self.lefty = self.cnt;
		ad_update_mapvar(self.count, self.cnt);
	}
	// TOGGLE : map variable
	else if (self.style == ad_MAPV_TOGGLE) {
		self.lefty = ad_query_mapvar(self.count);
		self.lefty = 1 - self.lefty;
		ad_update_mapvar(self.count, self.lefty);
	}
	// QUERY : map variable
	else {
		self.lefty = ad_query_mapvar(self.count);
	}

	// Check for On/Off target(s)
	if (self.lefty == ad_FALSE) {
		if (self.target != "") ad_trigger_strs(self.target, ad_activator);
	}
	else {
		if (self.ad_target2 != "") ad_trigger_strs(self.ad_target2, ad_activator);
	}

	// Check for switchable bmodel
	if (self.noise != "") {
		// Check if entity exists first
		if (!self.ad_oldenemy) 
			self.ad_oldenemy = find(world, targetname, self.noise);
		// Only work with Bmodel entities (usually aframes)
		if (self.ad_oldenemy.ad_bsporigin) {
			// Flashing (ON) is +0frame ; Static (OFF) is +aframe
			if (self.lefty == ad_TRUE) self.ad_oldenemy.frame = 0;
			else self.ad_oldenemy.frame = 1;
		}
	}

	// Check for fire once condition and wait timer
	if (self.wait < 0) self.ad_attack_finished = ad_LARGE_TIMER;
	else self.ad_attack_finished = time + self.wait;
};

//----------------------------------------------------------------------
void() ad_trigger_mapvar_base =
{
	// Check for any missing keys
	if (self.targetname == "") dprint("\b[MAPVAR]\b Missing targetname!\n");
	// Remove any negative or fractions
	self.count = fabs(rint(self.count));
	
	// Check for upper variable range
	if (self.count >= (ad_MAPV_BLCK*ad_MAPV_BITS))
		self.count = (ad_MAPV_BLCK*ad_MAPV_BITS) - 1;
	
	// Check for bitflag value range
	if (self.cnt < ad_FALSE || self.cnt > ad_TRUE) self.cnt = ad_FALSE;
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trigger_mapvar_base_use;
	self.ad_estate = ad_ESTATE_ON;
};

//----------------------------------------------------------------------
void() ad_trigger_mapvar_query =
{
	self.ad_classtype = ad_CT_MAPVAR;
	self.style = ad_MAPV_QUERY;
	ad_trigger_mapvar_base();
};

//----------------------------------------------------------------------
void() ad_trigger_mapvar_update =
{
	self.ad_classtype = ad_CT_MAPVAR;
	self.style = ad_MAPV_UPDATE;
	ad_trigger_mapvar_base();
};

//----------------------------------------------------------------------
void() ad_trigger_mapvar_toggle =
{
	self.ad_classtype = ad_CT_MAPVAR;
	self.style = ad_MAPV_TOGGLE;	
	ad_trigger_mapvar_base();
};

//======================================================================
/*ad:QUAKED trigger_mapvar_multiple (0.5 0 0.5) ? x x x x x MONSTERS STARTOFF x Not_Easy Not_Normal Not_Hard Not_DM
Touch trigger target(s) based on mapvar
------- KEYS --------
targetname : trigger entity (works with entity state system)
count   : Map Variable to check (range checks)
target  : Map variable == 0 fire these target(s)
message : Map variable == 0 message to display
target2 : Map variable == 1 fire these target(s)
message2: Map variable == 1 message to display
health  : Can be damaged instead of touched
wait    : time between re-triggering
delay   : delay before firing (after being triggered)
angle   : Facing Direction for trigger to work, use "360" for angle 0.
sounds  : 1=Secret,2=talk(def),3=switch,4=silent,5=custom,6=secret2
noise   : custom sound to play when triggered
-------- SPAWNFLAGS --------
MONSTER  : can be touched/triggered by monsters
STARTOFF : Requires trigger to activate
------- NOTES --------
Touch trigger target(s) based on mapvar
======================================================================*/
void() ad_trigger_mapvar_multiple_fire = 
{
	if (self.ad_attack_finished > time) return;	// Trigger once?

	// Find out map variable value
	self.lefty = ad_query_mapvar(self.count);
	// Switch around target/message strings
	if (self.lefty == ad_FALSE) {
		self.target = self.ad_idle_sound;
		self.message = self.ad_idle_soundcom;
	}
	else {
		self.target = self.ad_idle_sound2;
		self.message = self.ad_idle_soundcom2;
	}
	
	// Play the sound ON the trigger, NOT the activator
	if (self.noise != "") sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);

	// Original trigger_multiple activator behaviour
	ad_activator = self.ad_bmodel_act;
	ad_SUB_UseTargets();

	// Is the trigger repeatable?
	if (self.wait > 0) {
		self.ad_attack_finished = time + self.wait;
		self.nextthink = self.ad_attack_finished;
		self.think = self.ad_estate_on;
	}
	else {
		// TRIGGER_ONCE functionality
		self.ad_attack_finished = ad_LARGE_TIMER;
		self.ad_estate_off();
	}
};

//----------------------------------------------------------------------
void() ad_trigger_mapvar_multiple =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	// Remove excessive spawnflags not used
	self.lefty = 0;
	if (self.spawnflags & ad_MAPV_MONSTERS) self.lefty = self.lefty | ad_MAPV_MONSTERS;
	if (self.spawnflags & ad_ENT_STARTOFF) self.lefty = self.lefty | ad_ENT_STARTOFF;
	self.spawnflags = self.lefty;

	// Remove any negative or fractions
	self.count = fabs(rint(self.count));
	
	// Check for upper variable range
	if (self.count >= (ad_MAPV_BLCK*ad_MAPV_BITS))
		self.count = (ad_MAPV_BLCK*ad_MAPV_BITS) - 1;

	// Typical bmodel trigger setup
	ad_trigger_bmodel_sounds();
	self.ad_classtype = ad_CT_MAPVAR;
	ad_InitTrigger ();
	if (!self.wait) self.wait = 0.2;
	
	// Save all entity for later
	self.ad_idle_sound = self.target;
	self.ad_idle_sound2 = self.ad_target2;
	self.ad_idle_soundcom = self.message;
	self.ad_idle_soundcom2 = self.ad_message2;
	
	// Reset all strings to prevent SUB_UseTargets errors
	self.target = ""; self.ad_target2 = "";
	self.message = ""; self.ad_message2 = "";
	
	// Setup Entity State functionality
	self.ad_estate_fire = ad_trigger_mapvar_multiple_fire;
	ad_trigger_bmodel_setup();	
};