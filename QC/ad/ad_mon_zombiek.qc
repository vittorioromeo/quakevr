void()	ad_zombiek_attc1	=[	$attc2,		ad_zombiek_attc4	] {ad_ai_face();};
void()	ad_zombiek_attc4	=[	$attc4,		ad_zombiek_attc5	] {ad_ai_face();};
void()	ad_zombiek_attc5	=[	$attc5,		ad_zombiek_attc6	] {ad_zombiek_sound(7); ad_ai_face();};
void()	ad_zombiek_attc6	=[	$attc6,		ad_zombiek_attc7	] {ad_ai_face();};
