void() ad_zombiek_walk8	=[	$walk8,		ad_zombiek_walk9	] {ad_ai_walk(1);ad_monster_footstep(ad_FALSE);};
void() ad_zombiek_walk9	=[	$walk9,		ad_zombiek_walk10] {ad_ai_walk(1);};
void() ad_zombiek_walk10	=[	$walk10,	ad_zombiek_walk11] {ad_ai_walk(1);};
void() ad_zombiek_walk11	=[	$walk11,	ad_zombiek_walk12] {ad_ai_walk(1);};
void() ad_zombiek_walk12	=[	$walk12,	ad_zombiek_walk13] {ad_ai_walk(1);ad_monster_footstep(ad_TRUE);};	// Scrapping Clubfoot
void() ad_zombiek_walk13	=[	$walk13,	ad_zombiek_walk14] {ad_ai_walk(1);};
void() ad_zombiek_walk14	=[	$walk14,	ad_zombiek_walk1	] {ad_zombiek_sound(2);ad_ai_walk(1);};

