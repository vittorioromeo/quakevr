// Removed frames 1,3,4,5,7
void()	ad_zombiek_attb1	=[	$attb2,		ad_zombiek_attb6 ] {ad_ai_face();};
void()	ad_zombiek_attb6	=[	$attb6,		ad_zombiek_attb8	] {ad_ai_face();};
