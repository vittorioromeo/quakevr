//----------------------------------------------------------------------
void() ad_zombiek_melee =
{
	ad_ai_face ();		// Turn towards enemy target
	ad_walkmove (self.ideal_yaw, 20);

	// Randomly select melee attacks
	if (random() < 0.5) ad_zombiek_attb1();	// Stationary over arm swing 
	else ad_zombiek_attc1();					// Stationary sideways swing
};

//============================================================================
// Jump + melee attack
// Melee Attack 1 - Smash, chop overhead to ground (19->10/11 frames)
//============================================================================
void()	ad_zombiek_JumpTouch =
{
	local float ad_ldmg;
	
	if (self.health < 1) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	if ( ad_CanDamage(other, self) ) {
		if ( vlen(self.velocity) > 300 ) {
		  ad_ldmg = 10 + 10*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);

			// Check for poisonous attribute (new poison version)
			if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);
		}
	}

	// Is the zombie knight floating in the air?
	if (!checkbottom(self)) {
		// Is the zombie knight standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void()	ad_zombiek_jump1	=[	$atta1,		ad_zombiek_jump2 ] {ad_ai_charge(12);
	self.jump_flag = time + ad_MONAI_JUMPZOMBTIME;
	ad_zombiek_sound(3);	// Moan about jumping forward
};
void()	ad_zombiek_jump2	=[	$atta2,		ad_zombiek_jump3 ] {ad_ai_charge(16);};
void()	ad_zombiek_jump3	=[	$atta3,		ad_zombiek_jump4 ] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPZOMBTIME;
	self.touch = ad_zombiek_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*(self.ad_jumpdist_x + random()*50)) + ('0 0 1'*self.ad_jumpdist_z);
	self.origin_z = self.origin_z + 4;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

// Flying through the air waiting to touch something!
void()	ad_zombiek_jump4	=[	$atta4,		ad_zombiek_jump5 ] {ad_ai_face();};
void()	ad_zombiek_jump5	=[	$atta5,		ad_zombiek_jump6	] {ad_ai_face();};
void()	ad_zombiek_jump6	=[	$atta6,		ad_zombiek_jump6	] {ad_ai_face();};
void()	ad_zombiek_jump7	=[	$atta7,		ad_zombiek_jump7	] {ad_ai_face();};
void()	ad_zombiek_jump8	=[	$atta8,		ad_zombiek_jump9	] {ad_ai_face();
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		if (!checkbottom(self)) {
			self.ideal_yaw = random() * 360; 	//random jump angle
			self.think = ad_zombiek_jump3;
		}
	}
	self.oldorigin = self.origin;
};

