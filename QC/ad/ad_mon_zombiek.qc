void() ad_zombiek_stand12	=[	$stand12,		ad_zombiek_stand13	] {ad_ai_stand();};
void() ad_zombiek_stand13	=[	$stand13,		ad_zombiek_stand14	] {ad_ai_stand();};
void() ad_zombiek_stand14	=[	$stand14,		ad_zombiek_stand15	] {ad_ai_stand();};
void() ad_zombiek_stand15	=[	$stand15,		ad_zombiek_stand1	] {
	self.ad_idlebusy = ad_FALSE;
	self.solid = ad_SOLID_SLIDEBOX;
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.ad_idlebusy = ad_TRUE;
		// Make sure the idle animations don't repeat in a row
		self.lefty = self.lip;
		while (self.lefty == self.lip) { self.lefty = rint(random()*4);}
		self.lip = self.lefty;
		if (self.lip < 1) self.think = ad_zombiek_standB1;				// Pick brains!
		else if (self.lip < 2) self.think = ad_zombiek_standE1;	// Look BOTH
		else if (self.lip < 3) self.think = ad_zombiek_standC1;	// Look LEFT
		else self.think = ad_zombiek_standD1;										// Look RIGHT
	}
	ad_ai_stand();
};

