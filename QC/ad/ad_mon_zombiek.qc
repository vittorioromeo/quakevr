void() ad_zombiek_jump15;		// Chance of quick animation exit
void()	ad_zombiek_jump9	=[	$atta9,		ad_zombiek_jump10] {ad_ai_melee();};
void()	ad_zombiek_jump10=[	$atta10,	ad_zombiek_jump11] {ad_ai_melee();};
