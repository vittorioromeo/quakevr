void() ad_zombiek_run1		=[	$run1,		ad_zombiek_run2	] {
	self.ad_inpain = 0; self.solid = ad_SOLID_SLIDEBOX; ad_ai_run(12);};
void() ad_zombiek_run2		=[	$run2,		ad_zombiek_run3	] {ad_ai_run(12);};
void() ad_zombiek_run3		=[	$run3,		ad_zombiek_run4	] {ad_ai_run(13);};
void() ad_zombiek_run4		=[	$run4,		ad_zombiek_run5	] {ad_ai_run(12);};
void() ad_zombiek_run5		=[	$run5,		ad_zombiek_run6	] {ad_ai_run(12);ad_monster_footstep(ad_FALSE);};
void() ad_zombiek_run6		=[	$run6,		ad_zombiek_run7	] {ad_ai_run(12);};
void() ad_zombiek_run7		=[	$run7,		ad_zombiek_run8	] {ad_ai_run(12);};
void() ad_zombiek_run8		=[	$run8,		ad_zombiek_run9	] {ad_ai_run(11);};
void() ad_zombiek_run9		=[	$run9,		ad_zombiek_run10	] {ad_ai_run(14);};
void() ad_zombiek_run10	=[	$run10,		ad_zombiek_run11	] {ad_ai_run(13);};
void() ad_zombiek_run11	=[	$run11,		ad_zombiek_run1	] {ad_ai_run(11); 
	self.ad_steptype = ad_FS_TYPEHEAVY;		// Heavy clubfoot
	ad_monster_footstep(ad_FALSE);
	self.ad_steptype = ad_FS_TYPESLOW;		// Normal zombie foot
};

