//============================================================================
// Final thrash, explosion and on screen text waffle
//============================================================================
void() ad_finale_1 =
{
	ad_intermission_running = ad_INTERMISSION_ENDGAME;	//End of the game!
	ad_intermission_exittime = time + 100000;			// never allow exit

	// find the intermission spot
	self.owner = find (world, classname, "info_intermission");
	if (!self.owner) dprint("Cannot find info_intermission");
		
	// Find misc teleport thing and remove it
	self.enemy = find (world, classname, "misc_teleporttrain");
	if (!self.enemy) dprint("Cannot find teleporttrain");
	else remove (self.enemy);

	WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
	WriteString (ad_MSG_ALL, "");

	// Cycle through all players and reset them as below
	self.enemy = find (world, classname, "player");
	while (self.enemy != world) {
		self.enemy.view_ofs = '0 0 0';
		self.enemy.angles = self.enemy.v_angle = self.owner.mangle;
		self.enemy.fixangle = ad_TRUE;		// turn this way immediately
		self.enemy.map = self.map;
		self.enemy.nextthink = time + 0.5;
		self.enemy.takedamage = ad_DAMAGE_NO;
		self.enemy.solid = ad_SOLID_NOT;
		self.enemy.movetype = ad_MOVETYPE_NONE;
		self.enemy.modelindex = 0;
		setorigin (self.enemy, self.owner.origin);
		self.enemy = find (self.enemy, classname, "player");
	}	
	
	self.nextthink = time + 0.3;
	self.think = ad_finale_2;
	self.count = 10;
};

//----------------------------------------------------------------------
// Randomnly spawn 10 teleporter sparkle effects
//----------------------------------------------------------------------
void() ad_finale_2 =
{
	if (self.count < 0) ad_finale_3();
	else {
		sound (self, ad_CHAN_VOICE, "misc/r_tele1.wav", 1, ad_ATTN_NORM);

		// start a teleport splash inside shub
		self.view_ofs_x = ad_crandom()*50;
		self.view_ofs_y = -100;
		self.view_ofs_z = random()*100;
		self.oldorigin = self.origin + self.view_ofs;
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_TELEPORT);
		WriteCoord (ad_MSG_BROADCAST, self.oldorigin_x);
		WriteCoord (ad_MSG_BROADCAST, self.oldorigin_y);
		WriteCoord (ad_MSG_BROADCAST, self.oldorigin_z);

		self.count = self.count - 1;
		self.nextthink = time + random()*0.5;
		self.think = ad_finale_2;
	}
};

//----------------------------------------------------------------------
void() ad_finale_3 =
{
	// start shub thrashing wildly
	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
	lightstyle(0, "abcdefghijklmlkjihgfedcb");	
	ad_idshub_pain1();
};

//----------------------------------------------------------------------
// Called after thrash animation (last frame)
//----------------------------------------------------------------------
void() ad_finale_4 =
{
	local entity ad_entlist;
	
	// Play exploding sound
	sound (self, ad_CHAN_VOICE, self.ad_death_sound2, 1, ad_ATTN_NORM);
	self.oldorigin = self.origin;

	// Cycle through all monsters and kill them
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);
	// Keep looping through entity list
	while (ad_entlist) {
		// Only interested in monsters, kill them all!
		if (ad_entlist.flags & ad_FL_MONSTER && ad_entlist.health > 0) {
			self.view_ofs = self.origin + ad_vecrand(0,64,ad_TRUE);
			self.view_ofs_z = 50 + random()*200;
			setorigin(ad_entlist, self.view_ofs);
			ad_entlist.max_health = ad_MON_GIBFOUNTAIN;
			ad_monster_remove_kill(ad_entlist, ad_TRUE, ad_TRUE);
		}
		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	}
	
	// Setup temp entity for directional force for gibs
	self.ad_movelast = spawn();
	self.ad_movelast.oldorigin = self.origin - '0 0 -300';
	setorigin (self.ad_movelast, self.ad_movelast.oldorigin);
	setmodel (self.ad_movelast, ad_MODEL_BROKEN);
	self.enemy = self.ad_movelast;

	// loop through old one x/y/z space and throw tons of meat chunks	
	self.count = 16;
	while (self.count > 0) {
		self.view_ofs = ad_vecrand(0,64,ad_TRUE);				// random xyz volume loc
		self.view_ofs_z = 50 + random()*200;			// Extra lift up
		self.origin = self.oldorigin + self.view_ofs;	// Move origin around
		self.health = 0 - random()*200;					// Velocity boast
		
		self.lip = random();
		if (self.lip < 0.1) ad_ThrowGib(1, 1);
		else if (self.lip < 0.3) ad_ThrowGib(2, 1);
		else if (self.lip < 0.5) ad_ThrowGib(4, 1+random()*3);
		else ad_ThrowGib(5, 1+random()*3);

		self.count = self.count - 1;
	}
	// Check if skill 4 + Chaos are active?
	if (ad_Client_QueryEvilmode()) {
		// start the end text
		WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
		WriteString (ad_MSG_ALL, "Congratulations and well done! You have\nbeaten the hideous Shub-Niggurath, and\nher hundreds of ugly changelings and\nmonsters. You have proven that your\nskill and your cunning are greater than\nall the powers of Quake.\n\nThe Arcane Dimensions Team salutes you!");

		// Switch in special dancing player model
		self.oldorigin = self.oldorigin - '32 235 0';
		setorigin (self.ad_movelast, self.oldorigin);
		setmodel (self.ad_movelast, ad_MODEL_PLAYER_DANCE);
		self.ad_movelast.angles = '0 330 0';
		// Use frame group (constant animation)
		self.ad_movelast.frame = 0;		
		// No funky CD music track!
		WriteByte (ad_MSG_ALL, ad_SVC_CDTRACK);
		WriteByte (ad_MSG_ALL, 35);
		WriteByte (ad_MSG_ALL, 35);
		// Reset light styles
		lightstyle(0, "m");	
	}
	else {
		// start the end text
		WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
		WriteString (ad_MSG_ALL, "Congratulations and well done! You have\nbeaten the hideous Shub-Niggurath, and\nher hundreds of ugly changelings and\nmonsters. You have proven that your\nskill and your cunning are greater than\nall the powers of Quake. You are the\nmaster now. Id Software salutes you!");

		// Default player model setup
		self.oldorigin = self.oldorigin - '32 264 0';
		setorigin (self.ad_movelast, self.oldorigin);
		setmodel (self.ad_movelast, ad_MODEL_PLAYER);
		self.ad_movelast.angles = '0 290 0';
		self.ad_movelast.frame = 1;
		// Default end cd track
		WriteByte (ad_MSG_ALL, ad_SVC_CDTRACK);
		WriteByte (ad_MSG_ALL, 3);
		WriteByte (ad_MSG_ALL, 3);
		// Reset light styles
		lightstyle(0, "m");	
	}

	// Hide shubshub!
	ad_entity_hide(self);
};

//============================================================================
void (entity ad_inflictor, entity ad_attacker, float ad_damage) ad_idshub_pain =
{
	self.health = self.max_health;		// reset health	
};

//----------------------------------------------------------------------
void() ad_idshub_die =
{
	self.deadflag = ad_DEAD_DEAD;	// Nour bites the dust
	self.effects = 0;			// Remove effects on death
	self.max_health = ad_MON_GIBEXPLOSION;
	ad_finale_1();
};

/*============================================================================
 QUAKED monster_oldone (1 0 0) (-16 -16 -24) (16 16 32)
============================================================================*/
void() ad_monster_oldone =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/oldone.mdl";
	precache_model (self.mdl);

	// idle/sight not used
	self.ad_idle_sound = "boss2/idle.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_sound = "boss2/sight.wav";
	precache_sound (self.ad_sight_sound);
	
	// No default pain sound
	self.ad_pain_sound = ad_SOUND_EMPTY;
	
	// finale_3/finale_4 stages
	self.ad_death_sound = "boss2/death.wav";
	self.ad_death_sound2 = "boss2/pop2.wav";
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);
	
	// Skill 4 + Chaos mode surprise
	precache_model (ad_MODEL_PLAYER_DANCE);
	precache_sound ("boss2/funk_crush.wav");

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	// Use to be 128 square, reduced size to help with
	// radius/splash damage being more effective
	self.ad_bbmins = '-96 -96 -24';	// has own entity setup
	self.ad_bbmaxs = '96 96 192';
	self.ad_bboxtype = ad_BBOX_CUSTOM;	// Custom BBox size
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	self.health = self.max_health = 40000;	// kill ONLY by telefrag
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_longanim = ad_FALSE;		// No special axe animation
	self.ad_blockudeath = ad_TRUE;		// no humanoid death sound
	self.ad_steptype = ad_FS_FLYING;		// Stationary, no feet sound
	self.ad_poisonous = ad_FALSE;			// Cannot be poisonous
	self.velocity = '0 0 0';		// Make sure stationary
	self.ad_lastorigin = self.origin;	// Origin for camera interpolation
	self.ad_deathstring = " became one with Shub-Niggurath\n";
	
	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 1;
	self.ad_resist_rockets = self.ad_resist_cells = 1;
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage

	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_idshub_idle1;
	self.ad_th_pain = ad_idshub_pain;
	self.ad_th_die = ad_idshub_die;
	
	// Manually add monster count
	total_monsters = total_monsters + 1;

	self.ad_classtype = ad_CT_MONIDSHUB;
	self.ad_classgroup = ad_CG_BOSS;
	
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	self.takedamage = ad_DAMAGE_YES;				// Can be telefragged!

	self.think = ad_idshub_idle1;
	self.nextthink = time + 0.1;	
};

