	self.nextthink = time + 4 + random()*4;
	self.velocity = '0 0 0';
	self.movetype = ad_MOVETYPE_NONE;
};

//----------------------------------------------------------------------
void() ad_iceg_die =
{
	self.deadflag = ad_DEAD_DEAD;	// Nour bites the dust
	self.effects = 0;			// Remove effects on death
	self.style = ad_ICEG_PHASE4;	// Heavy Water
	self.max_health = ad_MON_GIBEXPLOSION;

	sound (self, ad_CHAN_BODY, "golem/death.wav", 1, ad_ATTN_NORM);
	self.solid = ad_SOLID_NOT;
	ad_iceg_death1 ();
};

//============================================================================
// Wakeup From Statue form
//============================================================================
void() ad_iceg_birth = {
	if (random() < 0.4) ad_SpawnProjectileSmoke(self.origin, 200, 100, 100);
	if (random() < 0.8) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
	if (random() < 0.1) ad_ThrowGib(11, 1);	// Small Golem rock
	// Hexen 2 models were designed for 20fps
	self.ad_ticktimer = 0.05;
	self.nextthink = time + self.ad_ticktimer;
};

//----------------------------------------------------------------------
void() ad_iceg_wake1 =[ $birth1, ad_iceg_wake2 ] {
	self.use = ad_SUB_Null;				// No more triggers
	self.style = ad_ICEG_PHASE2;			// Free to fight
	self.yaw_speed = 20 + (ad_skill * 4);	// Really Fast Speed

	// Setup player focus
	if (ad_activator.flags & ad_FL_CLIENT) {
		self.goalentity = self.enemy = ad_activator;
	}
	else self.enemy = world;
	
	// Restore all think functions
	self.ad_th_stand = ad_iceg_stand1;
	self.ad_th_walk = ad_iceg_walk1;
	self.ad_th_run = ad_iceg_run1;
	self.ad_th_melee = ad_iceg_knock1;
	self.ad_th_missile = ad_iceg_magic1;
	self.ad_th_updmissile = ad_iceg_shardtrail;
	self.ad_th_charge = ad_iceg_magic7;
	self.ad_th_slide = ad_iceg_stomp1;
	self.ad_th_jump = ad_iceg_waveboundary;
	self.ad_th_pain = ad_iceg_pain;
	self.ad_th_die = ad_iceg_die;
	
	self.ad_pain_finished = time + 3;		// Make pain go away
	self.ad_attack_finished = time + 2;	// Reset attack system

	ad_iceg_birth();
	sound (self, ad_CHAN_BODY, "golem/wakestatue.wav", 1, ad_ATTN_NORM);
};
void() ad_iceg_wake2 =[ $birth2, ad_iceg_wake3 ] {ad_iceg_birth();ad_ai_forward(2);};
