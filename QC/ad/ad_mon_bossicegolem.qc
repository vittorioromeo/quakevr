//============================================================================
// WAVE BOUNDARY - destroy some objects and spawn adds
//============================================================================
void() ad_iceg_aiturn =
{
	// turn towards a target if one exists
	if (self.ad_enemytarget) {
		// Check if enemy target is bmodel or point entity
		if (self.ad_enemytarget.ad_bsporigin)
			self.pos1 = ad_bmodel_origin(self.ad_enemytarget);
		else self.pos1 = self.ad_enemytarget.origin;
		// Force turn towards new target
		self.ideal_yaw = vectoyaw(self.pos1 - self.origin);
		ChangeYaw ();

		// Check angle difference
		if ((self.ideal_yaw - 10) > self.angles_y) self.ad_attack_elev = ad_TRUE;
		else if ((self.ideal_yaw + 10)<self.angles_y) self.ad_attack_elev = ad_TRUE;
		else self.ad_attack_elev = ad_FALSE;
	}
};

//----------------------------------------------------------------------
void() ad_iceg_waveface = {
	// Hexen 2 quicktime!
	self.ad_ticktimer = 0.05;
	self.nextthink = time + self.ad_ticktimer;
	ad_iceg_aiturn();
};

//----------------------------------------------------------------------
void() ad_iceg_waveb1 = [ $magic1, ad_iceg_waveb2 ] {ad_iceg_waveface();};
void() ad_iceg_waveb2 = [ $magic2, ad_iceg_waveb3 ] {ad_iceg_waveface();};
