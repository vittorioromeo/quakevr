void() ad_iceg_knock12 = [ $knock12, ad_iceg_knock13 ] {ad_iceg_mcharge(5);
	sound (self, ad_CHAN_VOICE, "golem/melee_swipe.wav", 1, ad_ATTN_IDLE);};
void() ad_iceg_knock13 = [ $knock13, ad_iceg_knock14 ] {ad_iceg_mcharge(4);};
void() ad_iceg_knock14 = [ $knock14, ad_iceg_knock15 ] {ad_iceg_mcharge(3);};
void() ad_iceg_knock15 = [ $knock15, ad_iceg_knock16 ] {ad_iceg_mcharge(2);};
void() ad_iceg_knock16 = [ $knock16, ad_iceg_knock17 ] {ad_iceg_mcharge(1);
	self.ad_meleehitsound = "golem/melee_punch.wav";
	self.ad_meleecontact = ad_TRUE;ad_ai_meleesmash(30);
	// If punch made contact, lift the enemy off ground
	if (self.ad_meleecontact == ad_FALSE) {
		self.pos1 = self.enemy.origin - self.origin;
		self.pos1_z = 0;
		self.pos1 = normalize(self.pos1);
		self.enemy.velocity = self.enemy.velocity + self.pos1 * 400;
		self.enemy.velocity_z = self.enemy.velocity_z + 250;
		self.enemy.flags = self.enemy.flags - (self.enemy.flags & ad_FL_ONGROUND);
	}
	self.ad_meleecontact = ad_FALSE;
};
