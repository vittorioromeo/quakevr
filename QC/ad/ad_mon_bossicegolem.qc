};

// Stop turning
void() ad_iceg_waveb21 = [ $magic21, ad_iceg_waveb22 ] {ad_iceg_waveface();};
void() ad_iceg_waveb22 = [ $magic22, ad_iceg_waveb23 ] {ad_iceg_waveface();};
