void() ad_iceg_waveb24 = [ $magic24, ad_iceg_run1 ] {
	self.style = ad_ICEG_PHASE2;
	ad_Resist_ChangeType(self, ad_FALSE);
	ad_iceg_waveface();
	// Pause before next attack
	self.ad_pain_finished = self.ad_attack_finished = time + 2;
};

//----------------------------------------------------------------------
void() ad_iceg_turnframe =
{
	// Do nothing if dead
	if (self.health < 1) return;
	
	// Check for any special frame events
	if (self.ad_walkframe == 0 || self.ad_walkframe == 16) ad_monster_footstep(ad_FALSE);

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 33) self.ad_walkframe = 0;
	self.frame = $walk1 + self.ad_walkframe;
	// Hexen 2 models were designed for 20fps
	self.ad_ticktimer = 0.05;
	self.nextthink = time + self.ad_ticktimer;
	
	// Facing the first target?
	ad_iceg_aiturn();
	if (self.ad_attack_elev == ad_FALSE) self.think = ad_iceg_waveb1;
	else self.think = ad_iceg_turnframe;
};

//----------------------------------------------------------------------
void() ad_iceg_waveboundary = 
{
	// Find a target to aim at (columns to blow up)
	self.ad_enemytarget = find(world, targetname, self.ad_attachment2.noise1);
	// First target seems to be dead
	if (!self.ad_enemytarget) {
		self.ad_enemytarget = find(world, targetname, self.ad_attachment2.noise2);
		// Second target is missing, try current enemy
		if (!self.ad_enemytarget) self.ad_enemytarget = self.enemy;
	}
	
	// If nothing to shoot at, back to running!
	if (!self.ad_enemytarget) {
		// Back to running!
		self.think = self.ad_th_run;
		self.ad_ticktimer = 0.05;
		self.nextthink = time + self.ad_ticktimer;
	}
	else {
		// Time to blow stuff up, switch on resistance and roar!
		self.style = ad_ICEG_PHASE3;
		ad_Resist_ChangeType(self, ad_TRUE);
		sound (self, ad_CHAN_WEAPON, "golem/icestorm.wav", 1, ad_ATTN_NORM);
		// Start turning towards target (using walk animation)
		self.ad_walkframe = 0;
		ad_iceg_turnframe();
	}
};

//============================================================================
// PAIN (no pain animations)
//============================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_iceg_pain =
{
	// Check for boss wave trigger events
	if (ad_iceg_WaveCheck() == ad_TRUE) {self.ad_th_jump(); return;}

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
	}
};

//============================================================================
// DEATH : Time to melt the heavy water GOLEM!
//============================================================================
void() ad_iceg_fadeout =
{
	self.origin_z = self.origin_z - 0.2;	// Slowly sink into the ground (melting)
    self.alpha = 1 - ((time - self.ltime) / 1);
	if (random() < 0.1) ad_SpawnProjectileSmoke(self.origin, 200, 100, 100);
    if (self.alpha <= 0) ad_entity_hide(self);
    else self.nextthink = time + ad_FADEMODEL_TIME;
};

//----------------------------------------------------------------------
void() ad_iceg_startfade =
{
	// Check for any final trigger events
	if (self.ad_message2 != "") ad_trigger_strs(self.ad_message2,self);

	// Setup ready for fade away ice->water
	self.frame = $death22;
	self.alpha = 0.99; 
	self.ltime = time + 2;
	self.think = ad_iceg_fadeout;
	ad_iceg_fadeout();
};

//----------------------------------------------------------------------
void(float ad_fdist) ad_iceg_brk =
{
	if (ad_fdist > 0) ad_ai_forward(ad_fdist);
	if (random() < 0.2) ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
	if (random() < 0.4) ad_SpawnProjectileSmoke(self.origin, 300, 50, 150);
	if (random() < 0.6) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
	if (random() < 0.3) ad_ThrowGib(11, 1);	// Small Golem rock
};

//----------------------------------------------------------------------
void() ad_iceg_death1	= [ $death1, ad_iceg_death2 ] {ad_iceg_brk(0);};
