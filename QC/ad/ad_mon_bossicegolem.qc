void() ad_iceg_tranB7 = [ $tranB7, ad_iceg_tranB8 ] {ad_iceg_birth();ad_ai_forward(5);ad_monster_idle_sound();};
void() ad_iceg_tranB8 = [ $tranB8, ad_iceg_tranB9 ] {ad_iceg_birth();ad_ai_forward(5);};
void() ad_iceg_tranB9 = [ $tranB9, ad_iceg_tranB10 ] {ad_iceg_birth();ad_ai_forward(5);};
void() ad_iceg_tranB10 = [ $tranB10, ad_iceg_tranB11 ] {ad_iceg_birth();ad_ai_forward(5);};
void() ad_iceg_tranB11 = [ $tranB11, ad_iceg_tranB12 ] {ad_iceg_birth();ad_ai_forward(5);};
void() ad_iceg_tranB12 = [ $tranB12, ad_iceg_tranB13 ] {ad_iceg_birth();ad_ai_forward(5);};
void() ad_iceg_tranB13 = [ $tranB13, ad_iceg_run1 ] {
	ad_monster_footstep(ad_FALSE);
	self.takedamage = ad_DAMAGE_YES;	// Can take damage
	self.style = ad_ICEG_PHASE2;		// Time to fight!
	ad_Resist_ChangeType(self,ad_FALSE);	// restore resistance
	self.ad_walkframe = 13;			// Mid way through set
	ad_iceg_runframe();
};

//======================================================================
// Setup Ice Golem after trigger event
//======================================================================
void() ad_iceg_setup =
{
	VR_AD_MonsterSetup();
	self.use = ad_SUB_Null;		// No more triggers
	self.style = ad_ICEG_PHASE1;	// Bursting intro sequence
	self.flags = ad_FL_MONSTER;	// Reset flag (no user settings)

	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size

	self.velocity = '0 0 0';		// Make sure stationary
	self.deadflag = ad_DEAD_NO;		// used to stop death re-triggering
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	self.ad_pain_longanim = ad_FALSE;		// No axe advantage
	self.takedamage = ad_DAMAGE_NO;	// No damage, statue time
	self.ad_noinfighting = ad_TRUE;		// No infighting
	self.skin = 1;					// Frozen skin

	self.ad_blockudeath = ad_TRUE;		// No humanoid death
	self.ad_bleedcolour = 16;			// Brown dust/dirt
	self.ad_meleerange = ad_MONAI_MELEEGOLEM;
	self.ad_attack_offset = '10 0 112';	// Ice storm

	self.ad_gibhealth = -1000;			// Special death sequence
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_finished = self.ad_attack_finished = ad_LARGE_TIMER;
	
	// Setup Ammo Resistance
	self.ad_resist_shells = self.ad_resist_cells = 0;
	self.ad_resist_nails = self.ad_resist_rockets = 0.75;
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage
	
	//Resist_CheckRange(self);		// Double check values
	ad_Resist_Save(self);				// Save for Later
	ad_Resist_ChangeType(self,ad_TRUE);	// resist everything

	// Setup boss waves and overall health
	self.ad_bosswave = 1;
	self.ad_bosswavetotal = 5;
	self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_iceg_WaveSetupHP();

	// default = No think functions
	self.ad_th_checkattack = ad_IcegCheckAttack;
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_SUB_Null;
	self.ad_th_missile = self.ad_th_die = ad_SUB_Null;
	self.ad_th_pain = ad_SUB_Null_pain;

	// Check there is space for Ice Golem to spawn
	self.origin_z = self.origin_z + 1;
	droptofloor();
	if (!ad_walkmove(0,0)) {
		// this condition should be a map spawn event only
		dprint ("\b[STUCK]\b "); dprint (self.classname);
		dprint (" at "); dprint (vtos(self.origin));
		dprint ("\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
	}

	// Find the tether marker (must be path_corner)
	if (self.ad_tethertarget != "") {
		self.ad_movelast = find(world,targetname,self.ad_tethertarget);
		if (self.ad_movelast.ad_classtype != ad_CT_PATHCORNER) {
			dprint("\b[ICEG]\b Tether marker not path_corner!\n");
			ad_spawn_marker(self.ad_movelast.origin, ad_SPNMARK_YELLOW);
			self.ad_movelast = world;
		}
		else ad_spawn_marker(self.ad_movelast.origin, ad_SPNMARK_GREEN);
		// Setup default tetherrange
		if (!self.ad_tetherrange) self.ad_tetherrange = ad_MONAI_MAXICEG;
	}
	// Make sure tethertarget is blank
	self.ad_tethertarget = "";

	// Make sure all death triggers are setup ready
	self.ad_message2 = self.target;
	self.target = self.ad_target2 = self.ad_deathtarget = "";

	// Wait for trigger event to be wakeup
	self.use = ad_iceg_wake1;
};

//======================================================================
/*ad:QUAKED monster_icegolem (1 0.2 0) (-32 -32 -24) (32 32 128)
======================================================================*/
void() ad_monster_icegolem =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_bossicegolem.mdl";
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_RINGSHOCK);	// Ground shockwave
	precache_model (ad_MODEL_PROJ_RINGBLAST);	// Ice ring shockwave
	precache_model (ad_MODEL_PROJ_GROCK1);		// Golem rocks
	precache_model (ad_MODEL_PROJ_GROCK2);
	precache_model (ad_MODEL_PROJ_GSHARD);		// Ice shards
	
	self.ad_gib1mdl = ad_MODEL_PROJ_GROCK1;	// small golem rock
	self.ad_gib2mdl = ad_MODEL_PROJ_GROCK2;	// medium golem rock
	self.ad_gib1frame = self.ad_gib2frame = 9;

	// Idle1a-1b (long sound) idle2a-2b (short sound)
	self.ad_idle_sound = "golem/idle1a.wav";
	self.ad_idle_sound2 = "golem/idle1b.wav";
	self.ad_idle_soundcom = "golem/idle2a.wav";
	self.ad_idle_soundcom2 = "golem/idle2b.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);
	precache_sound (self.ad_idle_soundcom2);
	
	// Break free of statue pose
	precache_sound ("golem/wakestatue.wav");
	
	// Several melee smack sounds and giant ground slam
	precache_sound ("golem/melee_swipe.wav");
	precache_sound ("golem/melee_punch.wav");
	precache_sound ("golem/melee_pound.wav");
	precache_sound ("golem/groundslam.wav");

	// Used for ceiling rubble breakables
	precache_sound (ad_SOUND_BRK_ROCK);
	precache_sound (ad_SOUND_IMP_ROCK1);
	precache_sound (ad_SOUND_IMP_ROCK2);
	if (self.ad_brkobj1 == "") self.ad_brkobj1 = ad_MODEL_BRK_ROCK1A;
	precache_model (self.ad_brkobj1);
	if (self.ad_brkobj2 == "") self.ad_brkobj2 = ad_MODEL_BRK_ROCK1B;
	precache_model (self.ad_brkobj2);
	
	// Additional rubble emitter parameters
	if (ad_CheckZeroVector(self.dest1)) self.dest1 = '80 8 1';
	if (ad_CheckZeroVector(self.dest2)) self.dest2 = '0 0 16';
	if (ad_CheckZeroVector(self.ad_brkvol)) self.ad_brkvol = '160 160 8';
	if (ad_CheckZeroVector(self.ad_brkvelbase)) self.ad_brkvelbase = '0 0 50';
	if (ad_CheckZeroVector(self.ad_brkveladd)) self.ad_brkveladd = '100 100 100';
	if (self.ad_brkfade <= 0) self.ad_brkfade = 4;
	
	// Ice Storm - range attack
	precache_sound ("golem/icestorm.wav");
	precache_sound ("golem/iceshard1.wav");
	precache_sound ("golem/iceshard2.wav");
	precache_sound ("golem/iceshard3.wav");
	precache_sound ("golem/iceshard_impact.wav");
	precache_model (ad_SEXP_ICE_BIG);		// Shard impact (ne_ruin)
	
	self.ad_pain_sound = "golem/pain1.wav";
	self.ad_pain_sound2 = "golem/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	precache_sound ("golem/death.wav");

	// Roar!
	self.ad_sight_sound = "golem/sight.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_bbmins = '-32 -32 -24';	// Special Size
	self.ad_bbmaxs = '32 32 128';
	self.ad_bboxtype = ad_BBOX_CUSTOM;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	self.ad_poisonous = ad_FALSE;			// Cannot be poisonous
	self.ad_deathstring = " was shattered by the Ice Golem\n";
	self.ad_lastorigin = self.origin;	// Origin for camera interpolation
	self.ad_ticktimer = 0.1;			// Model starts animations at 10fps

	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	self.ad_steptype = ad_FS_TYPEGIANT;	// Giant sound
	self.health = self.max_health = ad_MEGADEATH;
	
	self.ad_classtype = ad_CT_MONICEGOLEM;
	self.ad_classgroup = ad_CG_STONE;
	self.ad_classmove = ad_MON_MOVEWALK;
	self.style = 0;
	
	// No targetname = no trigger!
	if (self.targetname == "") {
		dprint("\b[ICEGOLEM]\b Missing targetname name!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}

	total_monsters = total_monsters + 1;
	self.use = ad_iceg_setup;
};

//======================================================================
/*ad:QUAKED monster_icegolem_wavetrig (0.75 0.25 1) (-32 -32 -8) (32 32 8) x
Target for boss column smash wave event
-------- KEYS --------
targetname : name of wave event (links to noise key on boss)
target     : trigger name of adds to spawn
noise1     : trigger name of column 1
noise2     : trigger name of column 2
-------- SPAWNFLAGS --------
-------- NOTES --------
Target for boss column smash wave event

======================================================================*/
void() ad_monster_icegolem_wavetrig = 
{
	self.ad_classtype = ad_CT_MONICEGOLEMWAVE;
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	self.takedamage = ad_DAMAGE_NO;
	setsize (self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
};
