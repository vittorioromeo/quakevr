void() ad_iceg_knock7 = [ $knock6, ad_iceg_knock8 ] {ad_iceg_mcharge(9);};
void() ad_iceg_knock8 = [ $knock8, ad_iceg_knock9 ] {ad_iceg_mcharge(8);};
