//============================================================================
// RANGE ATTACK (Stomp ground and drop debris from ceiling)
//============================================================================
void() ad_iceg_ceilingrubble = 
{
	// No enemy or dead?
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	// Trace a line up from the enemy/player
	traceline(self.enemy.origin, self.enemy.origin+'0 0 1024', ad_TRUE, self.enemy);
	self.pos2 = trace_endpos;
	// is there any space for rubble?
	if (vlen(self.enemy.origin - self.pos2) < 64) return;

	// Spawn a func_breakable_spawner entity
	// Manually setup all parameters
	// All sounds/models pre-cached with ice golem
	self.ad_attachment = spawn();
	// Move the emitter slightly down from ceiling
	self.ad_attachment.origin = trace_endpos - self.dest2;
	
	self.ad_attachment.owner = self;
	self.ad_attachment.style = ad_BTYPE_ROCK;
	self.ad_attachment.ad_brkimpsound = ad_BTYPE_ROCK;
	self.ad_attachment.ad_brkobjects = ad_BTYPE_ROCK;
	self.ad_attachment.ad_brkvelbase = self.ad_brkvelbase;
	self.ad_attachment.ad_brkveladd = self.ad_brkveladd;
	self.ad_attachment.ad_brkavel = 200;
	self.ad_attachment.ad_brkfade = self.ad_brkfade;
	self.ad_attachment.noise = ad_SOUND_BRK_ROCK;
	self.ad_attachment.noise1 = ad_SOUND_IMP_ROCK1;
	self.ad_attachment.noise2 = ad_SOUND_IMP_ROCK2;
	self.ad_attachment.ad_brkimpqty = 2;
	
	// Allow for custom rubble bmodels
	self.ad_attachment.ad_brkobj1 = self.ad_brkobj1;
	self.ad_attachment.ad_brkobj2 = self.ad_brkobj2;
	self.ad_attachment.ad_brkobjqty = 2;
	self.ad_attachment.pos1 = self.dest1;
	self.ad_attachment.cnt = 5 + random() * 5;
	self.ad_attachment.count = 5 + random() * 5;
	self.ad_attachment.movedir = '0 -2 0';
	self.ad_attachment.angles = '0 0 0';
	
	// Check if the boss has dmg key set for rubble damage
	if (self.dmg > 0) self.ad_attachment.spawnflags = ad_BREAK_MOVEDIR | ad_BREAK_DAMAGE;
	else self.ad_attachment.spawnflags = ad_BREAK_MOVEDIR;
	if (self.dmg > 0) self.ad_attachment.dmg = self.dmg;
	else self.ad_attachment.dmg = 2;
	
	// Default entity stuff (type/movement etc)
	self.ad_attachment.ad_classtype = ad_CT_FUNCBREAKSPN;
	self.ad_attachment.ad_classgroup = ad_CG_BREAKABLE;
	self.ad_attachment.solid = ad_SOLID_NOT;
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	self.ad_attachment.ad_brkvol = self.ad_brkvol;
	self.ad_attachment.think = ad_funcbreakable_use;
	self.ad_attachment.nextthink = time + 0.05;
};

