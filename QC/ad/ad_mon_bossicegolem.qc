void() ad_iceg_knock24 = [ $knock24, ad_iceg_run1 ] {ad_iceg_mcharge(5); 
	// Check for combo Melee+quick range
	ad_iceg_CheckCombo();
};

//============================================================================
// RANGE ATTACK (ICE SHARDS == rockets)
// Total shards to fire is based on skill level
// easy=3, normal=3, hard=4, nm=5
//============================================================================
void() ad_iceg_shardanimate =
{
	// manually animate
	self.frame = self.frame + 1;
	self.lip = 1 - (self.frame / 11);
	self.lip = self.lip * 0.5;
	// Gradualy fade out
	self.alpha = self.lip;
	// Hit animaton frame boundary?
	if (self.frame > 10) ad_entity_remove(self, 0.1);
	else self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_iceg_shardtrail =
{
	local entity ad_oring;
	
	// Spawn a temporary entity
	ad_oring = spawn();
	ad_oring.owner = self;
	ad_oring.solid = ad_SOLID_NOT;			// No interaction with world
	ad_oring.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	
	// move to current projectile location
	setmodel(ad_oring, ad_MODEL_PROJ_RINGBLAST);
	setsize(ad_oring, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	setorigin(ad_oring, self.origin);
	ad_oring.alpha = 0.5;
	ad_oring.skin = 3;
	
	// Match orientiation and start Oring animation
	self.pos2 = normalize(self.velocity);
	ad_oring.angles = vectoangles(self.pos2);
	ad_oring.think = ad_iceg_shardanimate;
	ad_oring.nextthink = time + 0.1;

	// Has the DP particle trail been setup yet?
	if (!self.ad_pain_finished) {
		// only run this once
		self.ad_pain_finished = ad_TRUE;
		// Re-use plasma trail
		if (ad_ext_dppart) {
			self.ad_traileffectnum = particleeffectnum(ad_DPP_TRPLASMA);
			self.effects = 0;
		}
	}
	else {
		// Classic (fitz/qs) engine particles only
		if (!ad_ext_dppart) {
			self.oldorigin = ad_crandom() * '1 1 1';
			// Silver colour
			self.lip = 40 + rint(random()*8);
			particle (self.origin, self.oldorigin, self.lip, 8 + rint(random()*8));
			// Yellow colour
			self.lip = 198 + rint(random()*4);
			particle (self.origin, self.oldorigin, self.lip, 4 + rint(random()*4));
		}
	}
	
	// Keep looping for O rings trails
	self.think = ad_iceg_shardtrail;
	self.nextthink = time + 0.05 + random()*0.05;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_iceg_icestorm = 
{
	local float ad_zpart;
	local vector ad_org, ad_targ_org, ad_dir, ad_yrand, ad_zrand;

	// No enemy or dead? stop firing
	if (!ad_targ) return;
	if (self.health < 1) return;

	// Play random firing sound
	self.lip = random();
	if (self.lip < 0.3) 
		sound (self, ad_CHAN_WEAPON, "golem/iceshard1.wav", 1, ad_ATTN_IDLE);
	else if (self.lip  < 0.6)
		sound (self, ad_CHAN_WEAPON, "golem/iceshard2.wav", 1, ad_ATTN_IDLE);
	else
		sound (self, ad_CHAN_WEAPON, "golem/iceshard3.wav", 1, ad_ATTN_IDLE);
	
	// Make sure facing the right direction
	ad_ai_face();
	makevectors(self.angles);

	// Check if enemy is bmodel or point entity
	if (ad_targ.ad_bsporigin) ad_targ_org = ad_bmodel_origin(ad_targ);
	else ad_targ_org = ad_targ.origin;

		// Spawn a mist of particles where projectiles came from
	ad_org = self.origin + ad_attack_vector('20 0 64');
	ad_zpart = 20 + rint(random()*20);
	ad_particle_explode(ad_org, ad_zpart, 1+random(), ad_PARTICLE_BURST_BLUE, ad_PARTICLE_BURST_UPWARD);

	// Randomly spawn projectiles from golems chest
	ad_yrand = (ad_crandom()*10)*v_right;
	ad_zrand = (ad_crandom()*10)*v_up;
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset) + ad_yrand + ad_zrand;

	// Add some right/left bias to the final destination
	ad_dir = (ad_targ_org - ad_org) + (v_right*(ad_crandom()*50));
	ad_dir = normalize (ad_dir);

	// Variable speed based on skill level
	self.ad_attack_speed = ad_SPEED_ICEGSHARD + (ad_skill * ad_SPEED_ICEGSKILL);
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_ICEG1, self.ad_attack_speed);
};

