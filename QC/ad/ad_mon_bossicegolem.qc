float ad_ICEG_PHASE1 = 1;	// Frozen in Ice
float ad_ICEG_PHASE2 = 2;	// Fighting
float ad_ICEG_PHASE3 = 3;	// Busting Columns
float ad_ICEG_PHASE4 = 4;	// Death

//======================================================================
// Global functions
//======================================================================
// Special streamlined player find function
//----------------------------------------------------------------------
float() ad_iceg_FindTarget =
{
	local entity ad_client;
	
	// Get the obvious exception(s) done first
	if (self.health < 1) return ad_FALSE;
	if (ad_intermission_running > 0) return ad_FALSE;
	if (ad_cinematic_running > 0) return ad_FALSE;

	// Find a client in current PVS
	ad_client = checkclient ();
	
	// Go through all the exception(s)
	if (!ad_client) return ad_FALSE;
	if (!(ad_client.flags & ad_FL_CLIENT)) return ad_FALSE;
	if (ad_client.flags & ad_FL_NOTARGET) return ad_FALSE;
	if (ad_client.items & ad_IT_INVISIBILITY) return ad_FALSE;
	
	// Check range and visibility of player
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return ad_FALSE;
	if (!ad_infront(ad_client)) return ad_FALSE;

	// Finally found something
	self.enemy = ad_client;
	self.oldorigin = self.origin;		// Save origin
	self.goalentity = self.enemy;		// Focus on enemy
	// Setup turning angle towards new enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);

	// We have a winner!
	return ad_TRUE;	
};

//----------------------------------------------------------------------
// Setup wave HP and trigger boundaries
//----------------------------------------------------------------------
void() ad_iceg_WaveSetupHP =
{
	// Is there anymore boss waves left?
	if (self.ad_bosswave >= self.ad_bosswavetotal) {
		// Only one wave left (death is final trigger)
		self.health = self.ad_bosswaveqty;
		self.ad_bosswavetrig = -1000;
	}
	else {
		// Multiple waves are still left (reset hp+trigger)
		// Always reset HP to stop high DPS weapons trashing waves boundaries
		self.health = ((self.ad_bosswavetotal - self.ad_bosswave) + 1) * self.ad_bosswaveqty;
		// The wave trigger is always one wave lower
		self.ad_bosswavetrig = self.health - self.ad_bosswaveqty;
	}
	// Debug messages for wave and health
	dprint("\b[BOSS]\b Wave ("); dprint(ftos(self.ad_bosswave));
	dprint(" / "); dprint(ftos(self.ad_bosswavetotal));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//----------------------------------------------------------------------
// Check if HP reached next wave, turn and fire at targets
//----------------------------------------------------------------------
float() ad_iceg_WaveCheck =
{
	// Check for boss wave boundary event
	if (self.health > 1 && self.health < self.ad_bosswavetrig) {
		// Check for wave boundary triggers
		self.noise = "";
		if (self.ad_bosswave == 1) self.noise = self.noise1;
		else if(self.ad_bosswave == 2) self.noise = self.noise2;
		else if(self.ad_bosswave == 3) self.noise = self.noise3;
		else if(self.ad_bosswave == 4) self.noise = self.noise4;
		
		// Is there any trigger for the wave boundary?
		if (self.noise != "") {
			self.ad_attachment2 = find(world, targetname, self.noise);
			if (self.ad_attachment2.ad_classtype == ad_CT_MONICEGOLEMWAVE) {
				// Spawn any adds to keep player busy
				if (self.ad_attachment2.target != "") 
					ad_trigger_strs(self.ad_attachment2.target, self);
				
				// Turn around and blow up breakables
				self.ad_th_jump();
			}
		}

		// Update Boss wave parameters (next wave!)
		self.ad_bosswave = self.ad_bosswave + 1;
		ad_iceg_WaveSetupHP();		// Reset trigger/hp
		return ad_TRUE;
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Check the tether system
//----------------------------------------------------------------------
float() ad_iceg_CheckTether =
{
	self.t_length = vlen(self.origin - self.ad_movelast.origin);
	// Check the most obvious first, inside tether range?
	if (self.t_length < self.ad_tetherrange) return ad_FALSE;
	else {
		// If player or tether close to each other?
		if (ad_infront(self.ad_movelast) && ad_infront(self.enemy) )
			return ad_FALSE;
		// Stop moving around
		else return ad_TRUE;
	}
};
	
//----------------------------------------------------------------------
// Quick check for stomp/melee + fast range attack
//----------------------------------------------------------------------
void() ad_iceg_CheckCombo =
{
	if (self.health < 1) return;
	if (self.enemy.health < 1) return;
	if (ad_skill < ad_SKILL_NORMAL) return;
	
	// If the enemy is visible, quickly go for range attack
	if (ad_visxray(self.enemy, self.ad_attack_offset, self.enemy.view_ofs, ad_TRUE)) {
		self.ad_attack_finished = time + ((4-ad_skill)*0.5) + random();
		// Skip forward in magic attack
		self.think = self.ad_th_charge;
	}
};

//----------------------------------------------------------------------
// Ice Golem game play logic
//----------------------------------------------------------------------
void() ad_IcegCheckAttack = 
{
	//----------------------------------------------------------------------
	// Check Melee range and constantly fire
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_MELEEICEG) {
		self.ad_attack_finished = time + 1;
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	// Walk around a bit
	if (time < self.ad_attack_finished) return;

	//----------------------------------------------------------------------
	// Floor stomp attack
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_STOMPICEG && random() < 0.5) {
		self.ad_attack_finished = time + ((4-ad_skill)*0.5) + random() + random();
		self.ad_th_slide ();
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attacks (O Rings + Ceiling Rubble)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (!ad_visblocked_wide(self.enemy, self.ad_attack_offset, self.enemy.view_ofs)) {
		self.ad_attack_finished = time + ((4-ad_skill)*0.6) + random() + random();
		self.ad_attack_state = ad_AS_MISSILE;
	}
};

//======================================================================
// MONSTER STATES (stand, walk run, attack, pain and death!
//======================================================================
void() ad_iceg_idleframe = 
{
	// Do nothing if dead
	if (self.health < 1) return;
	if (self.ad_walkframe == 0) ad_monster_idle_sound();

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 20) self.ad_walkframe = 0;
	self.frame = $wait1 + self.ad_walkframe;
	self.think = ad_iceg_idleframe;
	// Tick slower (10fps) for idle
	self.ad_ticktimer = 0.1;
	self.nextthink = time + self.ad_ticktimer;

	// Keep looking for a player
	ad_iceg_FindTarget ();
};

//----------------------------------------------------------------------
void() ad_iceg_stand1 = {self.ad_walkframe = 0; ad_iceg_idleframe();};

//============================================================================
void() ad_iceg_walkframe =
{
	// Do nothing if dead
	if (self.health < 1) return;
	
	// Default walk speed (very slow)
	self.lip = 5;
	// Check for any special frame events
	if (self.ad_walkframe == 0 || self.ad_walkframe == 16) {
		self.lip = 0;
		ad_monster_footstep(ad_FALSE);
	}		
	else if (self.ad_walkframe == 1 || self.ad_walkframe == 17) self.lip = 4;
	else if (self.ad_walkframe == 7 || self.ad_walkframe == 24) 
		ad_monster_idle_sound();

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 33) self.ad_walkframe = 0;
	self.frame = $walk1 + self.ad_walkframe;
	self.think = ad_iceg_walkframe;
	// Hexen 2 models were designed for 20fps
	self.ad_ticktimer = 0.05;
	self.nextthink = time + self.ad_ticktimer;
	
	// Keep looking for a player
	ad_iceg_FindTarget ();
	
	// Any feet movement?
	if (self.lip > 0) {
		// Check for tether system (cutom version)
		if (self.ad_movelast) {
			if (ad_iceg_CheckTether()) ad_movetogoal(self.lip); 
		}
		else ad_movetogoal(self.lip);		
	}
};

//----------------------------------------------------------------------
void() ad_iceg_walk1 = { self.ad_walkframe = 0; ad_iceg_walkframe(); };

//============================================================================
void() ad_iceg_runframe =
{
	if (self.style != ad_ICEG_PHASE2) return;
	if (self.health < 1) return;
	
	// Check for boss wave trigger events
	if (ad_iceg_WaveCheck() == ad_TRUE) {self.ad_th_jump(); return;}
	
	// Default run speed (very slow)
	self.lip = 8;
	// Check for any special frame events
	if (self.ad_walkframe == 0 || self.ad_walkframe == 12) {
		self.lip = 0;
		ad_monster_footstep(ad_FALSE);
	}		
	else if (self.ad_walkframe == 1 || self.ad_walkframe == 13) self.lip = 6;
	else if (self.ad_walkframe == 6 || self.ad_walkframe == 17) 
		ad_monster_idle_sound();

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 23) self.ad_walkframe = 0;
	self.frame = $run1 + self.ad_walkframe;
	self.think = ad_iceg_runframe;
	// Hexen 2 models were designed for 20fps
	self.ad_ticktimer = 0.05;
	self.nextthink = time + self.ad_ticktimer;
	
	// Check for tether system (cutom version)
	if (self.ad_movelast) {
		if (ad_iceg_CheckTether()) ad_ai_run(0);
		else ad_ai_run(self.lip);
	}
	else ad_ai_run(self.lip);
};

//----------------------------------------------------------------------
void() ad_iceg_run1 = { self.ad_walkframe = 0; ad_iceg_runframe(); };

//============================================================================
// MELEE - knockback the player with swipe
//============================================================================
void(float ad_dist) ad_iceg_mcharge = { 
	ad_ai_charge(ad_dist);
	// Hexen 2 models were designed for 20fps
	self.ad_ticktimer = 0.05;
	self.nextthink = time + self.ad_ticktimer;
};

