void() ad_iceg_waveb4 = [ $magic4, ad_iceg_waveb5 ] {ad_iceg_waveface();};
void() ad_iceg_waveb5 = [ $magic5, ad_iceg_waveb6 ] {ad_iceg_waveface();};
void() ad_iceg_waveb6 = [ $magic6, ad_iceg_waveb7 ] {ad_iceg_waveface();};
void() ad_iceg_waveb7 = [ $magic7, ad_iceg_waveb8 ] {ad_iceg_waveface();};
void() ad_iceg_waveb8 = [ $magic8, ad_iceg_waveb9 ] {ad_iceg_waveface();};
void() ad_iceg_waveb9 = [ $magic9, ad_iceg_waveb10 ] {ad_iceg_waveface();};

// Fire at first target
void() ad_iceg_waveb10 = [ $magic10, ad_iceg_waveb11 ] {ad_iceg_waveface();
	if (self.ad_enemytarget) ad_iceg_icestorm(self.ad_enemytarget);};
void() ad_iceg_waveb11 = [ $magic11, ad_iceg_waveb12 ] {ad_iceg_waveface();
	if (self.ad_enemytarget) ad_iceg_icestorm(self.ad_enemytarget);};
void() ad_iceg_waveb12 = [ $magic12, ad_iceg_waveb13 ] {ad_iceg_waveface();
	if (self.ad_enemytarget) ad_iceg_icestorm(self.ad_enemytarget);};
void() ad_iceg_waveb13 = [ $magic13, ad_iceg_waveb14 ] {ad_iceg_waveface();
	if (self.ad_enemytarget) {
		ad_iceg_icestorm(self.ad_enemytarget);
		// Trigger the target entity
		ad_trigger_ent(self.ad_enemytarget, self);
		// Find next target and turn towards it
		self.ad_enemytarget = find(world, targetname, self.ad_attachment2.noise2);
	}
};

// Start turning towards next target
