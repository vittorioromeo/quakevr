//======================================================================
// Global functions
//======================================================================
// Special streamlined player find function
//----------------------------------------------------------------------
float() ad_mammoth_FindTarget =
{
	local entity ad_client;
	
	// Get the obvious exception(s) done first
	if (self.health < 1) return ad_FALSE;
	if (ad_intermission_running > 0) return ad_FALSE;
	if (ad_cinematic_running > 0) return ad_FALSE;

	// Find a client in current PVS
	ad_client = checkclient ();
	
	// Go through all the exception(s)
	if (!ad_client) return ad_FALSE;
	if (!(ad_client.flags & ad_FL_CLIENT)) return ad_FALSE;
	if (ad_client.flags & ad_FL_NOTARGET) return ad_FALSE;
	if (ad_client.items & ad_IT_INVISIBILITY) return ad_FALSE;
	
	// Check range and visibility of player
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return ad_FALSE;
	if (!ad_infront(ad_client)) return ad_FALSE;

	// Finally found something
	self.enemy = ad_client;
	self.oldorigin = self.origin;		// Save origin
	self.goalentity = self.enemy;		// Focus on enemy
	// Setup turning angle towards new enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);

	// Locked, boss cannot attack or run
	if (self.state == ad_MM_LOCKED) return ad_FALSE;

	// We have a winner!
	return ad_TRUE;	
};

//----------------------------------------------------------------------
// Setup wave HP and trigger boundaries
//----------------------------------------------------------------------
void() ad_mammoth_WaveSetupHP =
{
	// Is there anymore boss waves left?
	if (self.ad_bosswave >= self.ad_bosswavetotal) {
		// Only one wave left (death is final trigger)
		self.health = self.ad_bosswaveqty;
		self.ad_bosswavetrig = -1000;
	}
	else {
		// Multiple waves are still left (reset hp+trigger)
		// Always reset HP to stop high DPS weapons trashing waves boundaries
		self.health = ((self.ad_bosswavetotal - self.ad_bosswave) + 1) * self.ad_bosswaveqty;
		// The wave trigger is always one wave lower
		self.ad_bosswavetrig = self.health - self.ad_bosswaveqty;
	}
	// Debug messages for wave and health
	dprint("\b[BOSS]\b Wave ("); dprint(ftos(self.ad_bosswave));
	dprint(" / "); dprint(ftos(self.ad_bosswavetotal));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//----------------------------------------------------------------------
// Check if HP has reached next boss wave trigger event
//----------------------------------------------------------------------
float() ad_mammoth_WaveCheck =
{
	// Check for boss wave boundary event
	if (self.health > 1 && self.health < self.ad_bosswavetrig) {
		// Check for wave boundary triggers
		self.noise = "";
		if (self.ad_bosswave == 1) self.noise = self.noise1;
		else if(self.ad_bosswave == 2) self.noise = self.noise2;
		else if(self.ad_bosswave == 3) self.noise = self.noise3;
		else if(self.ad_bosswave == 4) self.noise = self.noise4;
		else if(self.ad_bosswave == 5) self.noise = self.ad_noise5;
		
		// Is there any trigger for the wave boundary?
		if (self.noise != "") ad_trigger_strs(self.noise, self);

		// Update Boss wave parameters (next wave!)
		self.ad_bosswave = self.ad_bosswave + 1;
		ad_mammoth_WaveSetupHP();
		return ad_TRUE;
	}
	return ad_FALSE;
};

//======================================================================
// Mammoth BLUE Shield setup and maintainence functions
//======================================================================
void() ad_mammoth_shieldon =
{
	self.takedamage = ad_DAMAGE_YES;	// Grenades bounce off
	self.ad_bouncegrenade = ad_TRUE;		// Warning to other monsters
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectaxe = ad_TRUE;			// Reflect axe damage
	// Visually show resistance and reduce damage taken
	self.ad_resist_shells = self.ad_resist_nails = 1;
	self.ad_resist_rockets = self.ad_resist_cells = 1;
	sound (self, ad_CHAN_FEET, "mammoth/shield_on.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
void() ad_mammoth_shieldoff =
{
	self.takedamage = ad_DAMAGE_AIM;	// Grenades can make contact
	self.ad_bouncegrenade = ad_FALSE;		// Reset to default
	self.ad_reflectnails = ad_FALSE;		// Allow nail projectiles
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectaxe = ad_TRUE;			// Reflect axe damage
	self.ad_resist_shells = self.ad_resist_nails = 0;
	// Phase 3 has lower resistance, outer shell broken
	if (self.style == ad_MM_PHASE3)
		{ self.ad_resist_rockets = self.ad_resist_cells = 0.5; }
	else { self.ad_resist_rockets = self.ad_resist_cells = 0.75; }
	sound (self, ad_CHAN_FEET, "mammoth/shield_off.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
void() ad_mammothshield_finished = { if (self.ad_attachment) self.ad_attachment.ad_estate = ad_ESTATE_OFF;};
void() ad_mammothshield_disable = { if (self.ad_attachment) self.ad_attachment.ad_estate = ad_ESTATE_DISABLE;};
void() ad_mammothshield_enable = { if (self.ad_attachment) self.ad_attachment.ad_estate = ad_ESTATE_ON;};
void() ad_mammothshield_switchoff = {
	// Only use particles for wakeup phase
	if (self.ad_part_emitter) ad_misc_particle_off(self.ad_part_emitter);
	self.model = ""; setmodel(self, self.model);
};

//----------------------------------------------------------------------
void() ad_mammothshield_update =
{
	// Shield no longer needed, no more thinking either!
	if (self.ad_estate == ad_ESTATE_OFF) { ad_mammothshield_switchoff(); return;	}
	// Wake up phase has particles, spawn emitter
	if (!self.ad_part_emitter) {
		// Setup particle emitter for wakeup phase
		self.ad_part_active = ad_PARTICLE_STYLE_FFIELD;
		self.ad_spr_frame = ad_PARTICLE_BURST_BLUE;
		self.ad_part_vol = '32 32 16';		// Bounding box volume
		self.ad_part_limit = 50;			// Medium amount of particles
		self.ad_part_life = 4;				// Longer lifetime
		self.ad_part_ofs = '0 0 80';		// Top of mammoth body
		self.ad_part_vel = '0 0 4';		// Move upwards ... gradually
		self.ad_part_emitter = ad_spawn_pemitter(self, self, self.ad_part_active, ad_PARTICLE_START_ON);
	}

	// Shield temporarily disabled (wakeup/phase 1+2), still thinking ...
	if (self.ad_estate == ad_ESTATE_DISABLE) ad_mammothshield_switchoff();
	// Setup model, sync to owner/source and randomize alpha
	else if (self.ad_estate == ad_ESTATE_ON) { 
		// Check if model is active
		if (self.model == "") {
			self.model = self.owner.ad_weaponglow;
			setmodel(self, self.model);
			setsize(self,ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		}
		// Keep in sync with the owner
		setorigin(self, self.owner.origin);
		self.angles = self.owner.angles;
		self.frame = self.owner.frame;
		// Randomize the alpha value
		if (self.owner.state == ad_MM_PAIN) self.alpha = random()*0.8;
		else self.alpha = 0.7 + random()*0.3;
		if (self.alpha < 0.5) self.alpha = 0.01;
	}
	// Keep ticking and checking entity states
	self.think = ad_mammothshield_update;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_mammothshield_setup = 
{
	// Has the shield been defined already?
	if (self.ad_attachment) return;
	
	// Create the shield
	self.ad_attachment = spawn();
	self.ad_attachment.owner = self;
	self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
	self.ad_attachment.model = "";
	self.ad_attachment.origin = self.origin;
	self.ad_attachment.ad_estate = ad_ESTATE_DISABLE;

	// No movement and reset model frame/skin
	self.ad_attachment.solid = ad_SOLID_NOT;
	self.ad_attachment.movetype = ad_MOVETYPE_NOCLIP;
	self.ad_attachment.velocity = '0 0 0';
	self.ad_attachment.frame = 0;
	self.ad_attachment.skin = 0;

	// Start the shield
	self.ad_attachment.think = ad_mammothshield_update;
	self.ad_attachment.nextthink = time + 0.1;
}

//======================================================================
// Creates a debug marker for testing firing positions
//======================================================================
entity() ad_mammoth_devmarker =
{
	local entity ad_targ;
	ad_targ = spawn();
	ad_targ.movetype = ad_MOVETYPE_NONE;
	ad_targ.solid = ad_SOLID_NOT;
	setmodel(ad_targ, ad_MODEL_BROKEN);
	setorigin(ad_targ, self.origin);
	setsize (ad_targ, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	return ad_targ;
};

//----------------------------------------------------------------------
void(float ad_genqty) ad_mammoth_genericgibs =
{
	// Generic metal chunk
	self.ad_gibtype = ad_GIBTYPE_METAL;
	self.ad_gib5mdl = "progs/gib_metal1.mdl";
	ad_ThrowGib(15, ad_genqty + rint(random()*ad_genqty));	
};

//----------------------------------------------------------------------
void() ad_mammoth_uniquegibs =
{
	// Phase 2 gib models
	if (self.state == ad_MM_PHASE2_3) {
		self.ad_gib1mdl = "progs/gib_mammoth1.mdl";	// Front light panel
		self.ad_gib2mdl = "progs/gib_mammoth2.mdl";	// Corner chunk 1
		self.ad_gib3mdl = "progs/gib_mammoth3.mdl";	// Arm piece
		self.ad_gib4mdl = "progs/gib_mammoth4.mdl";	// Front light panel
		self.ad_gib5mdl = "progs/gib_mammoth5.mdl";	// Arm piece
		ad_ThrowGib(12, 2);						// Extra corners
		ad_ThrowGib(13, 1); ad_ThrowGib(15, 1);		// two arms
	}
	// Phase 3 gib models
	else if (self.state == ad_MM_DEATH) {
		self.ad_gib1mdl = "progs/gib_mammoth6.mdl";	// Back panel
		self.ad_gib2mdl = "progs/gib_mammoth7.mdl";	// Feet jet
		self.ad_gib3mdl = "progs/gib_mammoth8.mdl";	// Grenade panel
		self.ad_gib4mdl = "progs/gib_mammoth9.mdl";	// Corner chunk 2
		self.ad_gib5mdl = "progs/gib_mammoth10.mdl";	// Back Fan
		ad_ThrowGib(12, 2);						// three feet
		ad_ThrowGib(13, 1); ad_ThrowGib(14, 3);		// grenade panel + corners
	}
	// Throw unique gibs
	ad_ThrowGib(11, 1); ad_ThrowGib(12, 1);
	ad_ThrowGib(13, 1); ad_ThrowGib(14, 1);
	ad_ThrowGib(15, 1);
};

//----------------------------------------------------------------------
// Puff Puff of downward sprite smoke for QS/Fitz clients ONLY
// This is a duplicate of SpawnExplosion in ai_explosion.qc
// The spawnExp function has a DP alternative which is not needed
//----------------------------------------------------------------------
void() ad_mammoth_smoke_think =
{
	self.frame = self.frame + 1;
	if (self.frame > self.count) ad_SUB_Remove();
	else self.nextthink = time + self.speed;
};

//----------------------------------------------------------------------
void(vector ad_smorg, vector ad_smdir) ad_mammoth_spritesmoke =
{
	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;
	// This is designed for QS/Fitz engines (no extensions)
	if (ad_ext_dppart) return;
	
	ad_newmis = spawn();
	ad_newmis.ad_classgroup = ad_CG_TEMPENT;
	ad_newmis.movetype = ad_MOVETYPE_FLY;
	ad_newmis.solid = ad_SOLID_NOT;
	setorigin(ad_newmis, ad_smorg);
	setmodel(ad_newmis, ad_SBURST_SMOKE);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	
	ad_newmis.alpha = 0.85;		// Slightly transparent
	ad_newmis.effects = 32;		// Additive blending
	ad_newmis.count = 6;			// Total frames
	ad_newmis.speed = 0.05;		// Frame speed
	ad_newmis.velocity = ad_smdir;	// Move downward

	ad_newmis.think = ad_mammoth_smoke_think;
	ad_newmis.nextthink = time + ad_newmis.speed;
};

//----------------------------------------------------------------------
// Jets effects uses new particle systems (stream and DPsmoke)
// rnd_smoke allows for extra smoke to be created for start sequence
//----------------------------------------------------------------------
void(float ad_start_angle, float ad_curr_angle, float ad_rnd_smoke) ad_mammoth_jet =
{
	local vector ad_feetangle, ad_feetvec, ad_feetdest;

	ad_feetangle = '0 0 0';
	// Calculate the angle position of each jet
	ad_feetangle_y = self.angles_y + ad_start_angle + (ad_curr_angle * ad_MM_FEETANGLE);
	// Use v_forward/v_right/v_up to create vector offset
	makevectors (ad_feetangle);
	ad_feetvec = self.origin + (v_forward * ad_MM_FEETHORZ) + (v_up * ad_MM_FEETVERT);
	// Setup particles drifting outward and down (really far down)
	ad_feetdest = ad_feetvec + (v_forward * ad_MM_FEETHORZ) + ((v_up * ad_MM_FEETVERT)*4);
	ad_particle_stream(ad_feetvec, ad_feetdest, random()*2, 0.5+random(), 1+random(), 6, ad_PARTICLE_BURST_YELLOW);
	// Smoke can be intense on FPS, don't do it every frame
	if (random() < ad_rnd_smoke) {
		// Push smoke downward
		ad_feetdest = ad_feetdest + ((v_up * ad_MM_FEETVERT) * 2); 
		ad_particle_DPsmoke(ad_feetvec, ad_feetdest, 1, 3, 2, 7 );
		// Special sprite version for QS/Fitz engines
		ad_feetdest = v_forward + (-v_up * (200 + random() * 100));
		ad_mammoth_spritesmoke(ad_feetvec+(-v_up * 10), ad_feetdest);
	}
};

//----------------------------------------------------------------------
// Create particles and smoke (DP/QSS/FTE engines only) from jets
//----------------------------------------------------------------------
void(float ad_jet_frame, float ad_smoke_override) ad_mammoth_jeteffects =
{
	// Gen effect for every jet
	ad_mammoth_jet(self.ad_meleeoffset_x, ad_jet_frame, ad_smoke_override);
	ad_mammoth_jet(self.ad_meleeoffset_y, ad_jet_frame, ad_smoke_override);
	ad_mammoth_jet(self.ad_meleeoffset_z, ad_jet_frame, ad_smoke_override);
};

//----------------------------------------------------------------------
// Play random light click sounds for front of mammoth
// chance = TRUE for loud click sound
// volume = TRUE for maximum volume
//----------------------------------------------------------------------
void(float ad_litchance, float ad_litvolume) ad_mammoth_frontlight =
{
	if (ad_litchance <= 0) ad_litchance =  random();
	if (ad_litchance < 0.2) self.noise = "mammoth/front_light3.wav";
	else if (ad_litchance < 0.7) self.noise = "mammoth/front_light2.wav";
	else self.noise = "mammoth/front_light1.wav";
	
	if (ad_litvolume <= 0) ad_litvolume = 0.25 + (random() * 0.65);
	if (ad_litvolume > 1) ad_litvolume = 1;
	sound (self, ad_CHAN_AUTO, self.noise, ad_litvolume, ad_ATTN_FEET);
};

//----------------------------------------------------------------------
// Random strikes of lightning outward from origin
//----------------------------------------------------------------------
void(vector ad_offset) ad_mammoth_lightning =
{
	local vector ad_startvec, ad_randvec, ad_finishvec;
	
	// Middle of the chest
	ad_randvec = ad_vecrand(0,16,ad_TRUE);
	ad_startvec = self.origin + ad_offset + ad_randvec;
	ad_randvec = ad_vecrand(0,50,ad_TRUE);
	// Try to make sure its always up
	ad_randvec_z = ad_randvec_z + random()*25;
	ad_finishvec = normalize(ad_randvec);
	traceline(ad_startvec, ad_startvec + ad_finishvec * 600, ad_FALSE, self);
		
	// Create lightning bolt
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
	WriteEntity (ad_MSG_BROADCAST, self); WriteByte (ad_MSG_BROADCAST, 0);
	WriteCoord (ad_MSG_BROADCAST, ad_startvec_x);
	WriteCoord (ad_MSG_BROADCAST, ad_startvec_y);
	WriteCoord (ad_MSG_BROADCAST, ad_startvec_z);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);

	// Play some arching lightning sounds
	if (random() < 0.5) sound (self, ad_CHAN_BODY, "mammoth/elec_arch1.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_BODY, "mammoth/elec_arch2.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
// Plasma bolt firing in random direction
//----------------------------------------------------------------------
void(vector ad_offset) ad_mammoth_plasmabolt =
{
	local vector ad_org, ad_randvec, ad_dir;

	makevectors(self.angles);
	ad_randvec = ad_vecrand(0,16,ad_TRUE);
	ad_org = self.origin + ad_attack_vector(ad_offset) + ad_randvec;
	ad_randvec = ad_vecrand(0,50,ad_TRUE);
	ad_dir = normalize(ad_randvec);
	self.ad_attack_speed = ad_SPEED_MAMMOTHLAZ + (random() * ad_SPEED_MAMMOTHLAZSKILL);
	ad_launch_plasma(ad_org, ad_dir, ad_CT_MONMAMMOTH, self.ad_attack_speed);
};

//----------------------------------------------------------------------
// Explosions, Sparks and Smoke
// EXPL_TYPE   : 1=LEFT, 2=RIGHT, 3=MID_LEFT, 4=MID_CENTER, 5=MID_RIGHT
// EXPL_HIGH   : Extra vertical offset
// EXPL_SIZE   : 0 = Medium, 1 = Big (+ spark/smoke)
// EXPL_SILENT : 0 = no change, 1 = silent
//----------------------------------------------------------------------
void(float ad_expl_type, float ad_expl_high, float ad_expl_size, float ad_expl_silent) ad_mammoth_explosions =
{
	local vector ad_expl_org, ad_expl_vec;
	local string ad_expl_wav;
	
	if (ad_expl_type == ad_MM_EXPL_LEFT) ad_expl_vec = '30 38 0';
	else if (ad_expl_type == ad_MM_EXPL_RIGHT) ad_expl_vec = '30 -38 0';
	else if (ad_expl_type == ad_MM_EXPL_MIDL) ad_expl_vec = '28 16 0';
	else if (ad_expl_type == ad_MM_EXPL_MIDC) ad_expl_vec = '28 0 0';
	else if (ad_expl_type == ad_MM_EXPL_MIDR) ad_expl_vec = '28 -16 0';

	ad_expl_vec_y = ad_expl_vec_y + (ad_crandom() * 8);
	ad_expl_vec_z = ad_expl_vec_z + ad_expl_high + (ad_crandom() * 8);
	ad_expl_org = self.origin + ad_attack_vector(ad_expl_vec);
	
	if (ad_expl_size == 1) ad_expl_wav = "mammoth/explode_major.wav";
	else ad_expl_wav = "mammoth/explode_minor.wav";
	if (ad_expl_silent) ad_expl_wav = "";

	if (ad_expl_size == 1) {	
		ad_SpawnExplosion(ad_EXPLODE_BIG, ad_expl_org, ad_expl_wav);
		ad_SpawnProjectileSmoke(ad_expl_org, 150, 50, 150);
		if (random() < 0.7) 
			ad_particle_dust(ad_expl_org, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	}
	else ad_SpawnExplosion(ad_EXPLODE_MED, ad_expl_org, ad_expl_wav);
};

//----------------------------------------------------------------------
// Work out ideal tilt angle towards enemy and check for rotation locks
// This is like ai_face, but it works on two axis (Up/down and left/right)
// startblock, endblock are the animation frame sections to gradually tilt
// Return values = self.attack_angle, self.finalangle
//----------------------------------------------------------------------
/* DEBUG STUFF (not required anymore) 
if (!self.tno1) self.tno1 = mammoth_devmarker();
	dprint("WF ("); dprint(ftos(self.walkframe));
	dprint(") % ("); dprint(ftos(self.lip));
	dprint(") Org ("); dprint(ftos(self.pos2_x));
	dprint(") AA ("); dprint(ftos(self.attack_angle));
	dprint(") New ("); dprint(ftos(self.pos3_x));
	dprint(")\n");
	self.finalangle = mathlib_vectorotateY('30 38 40', self.attack_angle);
	setorigin(self.tno1, self.origin + attack_vector(self.finalangle)); */
//----------------------------------------------------------------------
void(float ad_startblock, float ad_endblock) ad_mammoth_tiltbody =
{
	local vector ad_idealvec, ad_idealang;
	local float ad_bodytilt, ad_startperc, ad_endperc;
	
	// Find perfect angle (from mammoth to enemy)
	// Create directional vector and convert to angles
	ad_idealvec = ad_SUB_orgEnemyTarget() - self.origin;
	ad_idealang = vectoangles(ad_idealvec);
	// only interested in up/down and left/right axis/angles
	// The z axis will twist the body (rarely used)
	ad_idealang_z = 0;

	// Is the enemy below or above the mammoth?
	if (ad_idealang_x > 180) {
		// Restrict rotation angle (BELOW)
		if (ad_idealang_x < (360 - ad_MM_ATTACKANGLE))
			ad_idealang_x = 360 - ad_MM_ATTACKANGLE;
		// Create ideal angle +/- around 0 degree
		self.ad_attack_angle = 360 - ad_idealang_x;
	}
	else {
		// Restrict rotation angle (ABOVE)
		if (ad_idealang_x > ad_MM_ATTACKANGLE) 
			ad_idealang_x = ad_MM_ATTACKANGLE;
		// Create ideal angle +/- around 0 degree
		self.ad_attack_angle = 0 - ad_idealang_x;
	}

	// Create YAW only angles as baseline for gradual tilt setup
	self.finalangle = '0 0 0';
	self.finalangle_y = ad_idealang_y;
	// Setup forward/right/up projection vectors (used later)
	makevectors (self.finalangle);
	
	// Work out gradual tilt percentage based on frames available
	ad_startperc = 1 / (ad_startblock + 1);
	ad_endperc = 1 / (ad_MM_ANIMBLOCK - ad_endblock);
	
	// Check for start/end parts of the animation block that can
	// be used for a gradual change of the final tilt
	if (self.ad_walkframe < ad_startblock) {
		ad_bodytilt = (self.ad_walkframe + 1) * ad_startperc;
		self.finalangle_x = ad_bodytilt * self.ad_attack_angle;
	}
	// End of animation block (no more tilt)
	else if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.finalangle_x = 0;
	// Gradually fade tilt back to normal angle
	else if (self.ad_walkframe > ad_endblock) {
		ad_bodytilt = (ad_MM_ANIMBLOCK - self.ad_walkframe) * ad_endperc;
		self.finalangle_x = ad_bodytilt * self.ad_attack_angle;
	}
	// 100% look/tilt at enemy (ready for projectiles)
	else self.finalangle_x = -self.ad_attack_angle;
	
	// Update model YAW/angles
	self.ideal_yaw = self.finalangle_y;
	ChangeYaw ();
	self.angles = self.finalangle;
	self.fixangle = ad_TRUE;
};

//----------------------------------------------------------------------
// Check the tether system
//----------------------------------------------------------------------
float() ad_mammoth_CheckTether =
{
	local float ad_currentdist;
	
	ad_currentdist = vlen(self.origin - self.ad_movelast.origin);
	// Check the most obvious first, inside tether range?
	if (ad_currentdist < self.ad_tetherrange) return ad_FALSE;
	else {
		// If player or tether close to each other?
		if (ad_infront(self.ad_movelast) && ad_infront(ad_SUB_entEnemyTarget()) )
			return ad_FALSE;
		// Stop moving around
		else return ad_TRUE;
	}
};
	
//----------------------------------------------------------------------
// Mammoth game play logic
//----------------------------------------------------------------------
void() ad_mammothCheckAttack = 
{
	local vector ad_armorg, ad_eorg;
	
	// Check for boss wave trigger events
	if (ad_mammoth_WaveCheck() == ad_TRUE) return;

	//----------------------------------------------------------------------
	// setup enemytarget if one is not active
	//----------------------------------------------------------------------
	if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET) {
		if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
			self.enemy = self.ad_enemytarget;
		}
	}

	//----------------------------------------------------------------------
	// Melee attack (Dumping fire on to player/floor)
	// this has always got to be available, no cooldown
	//----------------------------------------------------------------------
	// Flatten distance checks, the mammoth is constantly flying
	self.ad_enemydist = ad_range_distance(ad_SUB_entEnemyTarget(), ad_TRUE);
	// Any sprite space left for hazard projectiles? (def=14 frames)
	// There is no skill difference with the fire/dump attack
	if (ad_HazardProjectile_CheckLimit(self, self.ad_proj_attqty_z)) {
		if (self.ad_enemydist < ad_MONAI_MELEEMAMMOTH) {
			self.ad_attack_state = ad_AS_MELEE;
			return;
		}
	}
	
	//----------------------------------------------------------------------
	// Mammoth is a very wide and needs more visibility checks,
	// especially for the arms during phase 1 & 2.
	// Phase 3 = central attacks, front and top only
	//----------------------------------------------------------------------
	self.ad_attack_sidedeny = ad_FALSE;
	if (!ad_enemy_vis) {
		// Work out enemy origin + vertical offset
		ad_eorg = self.enemy.origin + self.enemy.view_ofs;
		makevectors(self.angles);
		
		// Phase 3 has no arms, use left/right side of body instead
		if (self.style == ad_MM_PHASE3) ad_armorg = self.origin + ad_attack_vector('30 24 46');
		else ad_armorg = self.origin + ad_attack_vector('30 38 46');

		traceline (ad_armorg, ad_eorg, ad_TRUE, self);
		if (trace_fraction == 1) ad_enemy_vis = ad_TRUE;
		else {
			// first arm was blocked, try second instead
			if (self.style == ad_MM_PHASE3) ad_armorg = self.origin + ad_attack_vector('30 -24 46');
			else ad_armorg = self.origin + ad_attack_vector('30 -38 46');

			traceline (ad_armorg, ad_eorg, ad_TRUE, self);
			if (trace_fraction == 1) ad_enemy_vis = ad_TRUE;
		}
		// Partly blocked, so use agressive attack instead
		if (ad_enemy_vis) self.ad_attack_sidedeny = ad_TRUE;
	}
	
	//----------------------------------------------------------------------
	// Range attacks (Laser, Rockets, Arc and Grenades)
	//----------------------------------------------------------------------
	// Range attack if cooldown has finished and can see enemy
	if (self.ad_attack_finished < time && ad_enemy_vis) {
		// Is the enemy close enough for attack?
		// If the mammoth at maximum tether range, keep firing!
		if (ad_mammoth_CheckTether() || self.ad_enemydist < ad_MONAI_RANGEMAMMOTH) {
			ad_SUB_AttackFinished(2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
			return;
		}
	}

	//----------------------------------------------------------------------
	// Maintain distance (strafe)
	//----------------------------------------------------------------------
	// Don't strafe if at max tether range
	if (ad_mammoth_CheckTether()) return;
	if (ad_enemy_range >= ad_RANGE_MID || !ad_enemy_vis) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else self.ad_attack_state = ad_AS_SLIDING;
};

//======================================================================
// Different projectile attacks
//----------------------------------------------------------------------
void(vector ad_offset, float ad_side) ad_mammoth_laser =
{
	local vector ad_org, ad_dir, ad_vec;
	local float ad_sideoff;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);

	// Make sure boss is tilted at the enemy
	makevectors (self.angles);
	// Use new rotated offset for start position
	ad_org = self.origin + ad_attack_vector(ad_offset);
	// Add side offset so its not exact aiming, looks more natural
	if (ad_side < 0) {
		// Remember side offsets for left/right
		if (self.ad_attack_offset_x <= 0) {
			ad_sideoff = ad_side * (3 + random() + random());
			self.ad_attack_offset_x = ad_sideoff;
		}
		else ad_sideoff = self.ad_attack_offset_x;
	}
	else {
		// Remember side offsets for left/right
		if (self.ad_attack_offset_y <= 0) {
			ad_sideoff = ad_side * (3 + random() + random());
			self.ad_attack_offset_y = ad_sideoff;
		}
		else ad_sideoff = self.ad_attack_offset_y;
	}
	ad_dir = ad_SUB_orgEnemyTarget() + (v_up * 12) + (v_right * ad_sideoff);
	ad_vec = normalize(ad_dir - ad_org);

	// Variable laser speed
	self.ad_attack_speed = ad_SPEED_MAMMOTHLAZ + (ad_skill * ad_SPEED_MAMMOTHLAZSKILL);

	// Velocity tracking ("Bal : tracking is brutal af")
	if (self.ad_attack_rage) {
		// The tracking system starts with predicting enemy movement
		// by using the enemy velocity. This tracking can get better
		// over time by using the previous enemy location.
		// The first tracking point is often the weakest and easiest
		// to avoid because it has no velocity history.
		//
		// There are two types : single shot or refined shots
		// The refined tracking should only be used for NIGHTMARE skill
		// because it can feel unfair and relentless at times!
		// The single shot is perfect for HARD skill as its a challenge.
		//
		// Attack 1 is 4 shots over a long period of time (12 frames)
		//          and would be extra hard if refined tracking
		// Attack 2 is 8 burst shots and would suit refined tracking
		//          because its designed for hard/nm skill
	
		// Reset the tracking system if EASY/NORMAL/HARD skill or Attack 1
		if (ad_skill <= ad_SKILL_HARD || self.state == ad_MM_ATTACKLASER1) 
			self.ad_attack_sidestep = self.ad_walkframe;
		// Is this the first prediction point for tracking?
		if (self.ad_walkframe == self.ad_attack_sidestep)
			self.ad_attack_track = ad_SUB_Tracking(ad_SUB_orgEnemyTarget(), ad_offset, ad_SUB_entEnemyTarget(), self.ad_attack_speed);
		else
			// Keep refining the velocity tracking over multiple frames
			self.ad_attack_track = ad_SUB_Tracking(self.ad_attack_track, ad_offset, ad_SUB_entEnemyTarget(), self.ad_attack_speed);
		// Update projectile direction
		ad_vec = normalize(self.ad_attack_track - ad_org);
	}
	// Projectile away!
	ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_LASER, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void(vector ad_offset, float ad_side) ad_mammoth_rocket =
{
	local vector ad_org, ad_dir, ad_vec;
	local float ad_sideoff;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "mammoth/rocket_fire.wav", 1, ad_ATTN_NORM);	

	// Maximum speed, initial speed set in Launch_Missile
	self.ad_attack_speed = ad_SPEED_MAMMOTHROCK + (ad_skill * ad_SPEED_MAMMOTHROCKSKILL);

	// Make sure boss is tilted at the enemy
	makevectors (self.angles);
	// Use new rotated offset for start position
	ad_org = self.origin + ad_attack_vector(ad_offset);
	// Add side offset so its not exact aiming, looks more natural
	if (ad_side < 0) {
		// Remember side offsets for left/right
		if (self.ad_attack_offset_x <= 0) {
			ad_sideoff = ad_side * (3 + random() + random());
			self.ad_attack_offset_x = ad_sideoff;
		}
		else ad_sideoff = self.ad_attack_offset_x;
	}
	else {
		// Remember side offsets for left/right
		if (self.ad_attack_offset_y <= 0) {
			ad_sideoff = ad_side * (3 + random() + random());
			self.ad_attack_offset_y = ad_sideoff;
		}
		else ad_sideoff = self.ad_attack_offset_y;
	}
	ad_dir = ad_SUB_orgEnemyTarget() + (v_right * ad_sideoff);
	ad_vec = normalize(ad_dir - ad_org);

	ad_Launch_Missile (ad_org, ad_vec, '0 0 0', ad_CT_PROJ_MAMMOTH, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void(vector ad_offset, float ad_side) ad_mammoth_grenade =
{
	local vector ad_org, ad_eorg, ad_torg, ad_ang, ad_dir, ad_avel;
	local float ad_enemy_vlen, ad_targetang;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "weapons/grenade.wav", 1, ad_ATTN_NORM);
	
	// A bit of randomness to projectile speed +/- 16
	self.ad_attack_speed = ad_SPEED_PLAYGRENADE + (ad_crandom()*32);

	// need boss facing angle for firing direction
	makevectors (self.angles);
	// Use new rotated offset for start position
	ad_org = self.origin + ad_attack_vector(ad_offset);
	ad_eorg = ad_SUB_orgEnemyTarget();
	// Projectile enemy origin infront based on facing direction
	ad_enemy_vlen = vlen(ad_eorg - self.origin);
	ad_torg = self.origin + (v_forward * ad_enemy_vlen);
	// Target origin is the same as enemy Z axis + some randomness
	ad_torg_z = ad_eorg_z + (ad_crandom()*16);
	// Pick sides for grenades to stop central point of attack
	ad_torg = ad_torg + (v_right * (ad_side * 8));
	// Work out elevation angle to hit target origin
	ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, ad_torg, self.ad_attack_speed);
	ad_ang = vectoangles(ad_torg - ad_org);
	ad_ang_x = -ad_targetang;	// Negative = upwards angle 
	makevectors (ad_ang);
	// Final direction to fire grenade
	ad_dir = v_forward * self.ad_attack_speed;
	
	// Typically this function would use the MonsterFireGrenade function
	// The Mammoth is not firing grenades to be precise, its suppression fire
	// So the angle/arc is predicted based on facing angles of Mammoth
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_GLMON);
};


//----------------------------------------------------------------------
void(vector ad_offset) ad_mammoth_coreattack =
{
	local vector ad_org, ad_dir, ad_vec;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);

	// Make sure boss is tilted at the enemy
	makevectors (self.angles);
	// Use new rotated offset for start position
	ad_org = self.origin + ad_attack_vector(ad_offset);
	ad_dir = ad_SUB_orgEnemyTarget();
	ad_vec = normalize(ad_dir - ad_org);

	// Variable laser speed
	self.ad_attack_speed = ad_SPEED_MAMMOTHLAZ + (ad_skill * ad_SPEED_MAMMOTHLAZSKILL);

	// Velocity tracking
	if (ad_skill >= ad_SKILL_HARD) {
		// Reset the tracking system if EASY/NORMAL/HARD skill
		if (ad_skill <= ad_SKILL_HARD) self.ad_attack_sidestep = self.ad_walkframe;
		// Is this the first prediction point for tracking?
		if (self.ad_walkframe == self.ad_attack_sidestep)
			self.ad_attack_track = ad_SUB_Tracking(ad_SUB_orgEnemyTarget(), ad_offset, ad_SUB_entEnemyTarget(), self.ad_attack_speed);
		else
			// Keep refining the velocity tracking over multiple frames
			self.ad_attack_track = ad_SUB_Tracking(self.ad_attack_track, ad_offset, ad_SUB_entEnemyTarget(), self.ad_attack_speed);
		// Update projectile direction
		ad_vec = normalize(self.ad_attack_track - ad_org);
	}
	// Track that player!
	ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_RICLASER, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_mammoth_jetdump =
{
	local vector ad_org, ad_torg, ad_dir, ad_ang;
	local float ad_targetang;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	// Start flames at jet/feet
	makevectors (self.angles);	
	ad_org = self.origin + ad_attack_vector('0 0 -24');

	// Workout target origin (self.enemy)
	ad_torg = ad_SUB_orgEnemyTarget();
	// Allow for medium target area
	ad_torg_x = ad_torg_x + (ad_crandom() * 64);
	ad_torg_y = ad_torg_y + (ad_crandom() * 64);
	ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, ad_org, ad_torg, ad_SPEED_FLAME);
	// Work out angle
	ad_ang = vectoangles(ad_torg - ad_org);
	ad_ang_x = -ad_targetang;	// Negative = upwards angle 
	makevectors (ad_ang);
	// fire flames in arc pattern (offset)
	ad_dir = ( (v_forward * (1 + random()*0.5)) + (v_right * (ad_crandom()*0.1)) ) * ad_SPEED_FLAME;
	// Fire that flame!
	// target, origin, v_forward, colour, size, lifetime, speed
	ad_Launch_Flame (self, ad_org, ad_dir, ad_FLAME_RED, -1, -1, ad_SPEED_FLAME);
};

//----------------------------------------------------------------------
void(float ad_fireqty) ad_mammoth_jetexplosion =
{
	local vector ad_torg, ad_dir, ad_ang;
	local float ad_targetang, ad_fire_loop, ad_fire_time;

	// Is the fire explosion disabled?
	if (ad_fireqty <= 0) return;

	ad_fire_loop = ad_fireqty;
	while (ad_fire_loop > 0) {
		ad_fire_loop = ad_fire_loop - 1;
		ad_ang = '0 0 0';
		// Pick random angle around orgin
		ad_ang_y = rint(random()*360);
		makevectors (ad_ang);
		// Random distance = 50 + random() * 50
		ad_torg = self.origin + (v_forward * (10 + (random() * 10)));
		ad_torg_z = ad_torg_z + (random() * 16);
		ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, ad_torg, ad_SPEED_FLAME);
		// Work out angle
		ad_ang = vectoangles(ad_torg - self.origin);
		ad_ang_x = -ad_targetang;	// Negative = upwards angle 
		makevectors (ad_ang);
		// fire flames in arc pattern (offset)
		ad_dir = ( (v_forward * (0.5 + random() * 0.5)) ) * ad_SPEED_FLAME;
		// Random fire time
		ad_fire_time = 8 + (random()*8);
		// Fire that flame!
		// target, origin, v_forward, colour, size, lifetime, speed
		ad_Launch_Flame (self, self.origin, ad_dir, ad_FLAME_RED, -1, ad_fire_time, ad_SPEED_FLAME);
	}
};

//----------------------------------------------------------------------
void(float ad_fireqty) ad_mammoth_firewreck =
{
	local vector ad_org;
	local float ad_fire_loop, ad_fire_time;

	ad_fire_loop = ad_fireqty;
	while (ad_fire_loop > 0) {
		ad_fire_loop = ad_fire_loop - 1;
		ad_org = self.origin + ('24 24 0' * ad_crandom()) + ('0 0 8' * random());
		// Random fire time
		ad_fire_time = 16 + (random()*8);
		// Create dead body flames
		// target, origin, v_forward, colour, size, lifetime, speed
		ad_Launch_Flame (self, ad_org, '0 0 0', ad_FLAME_RED, -1, ad_fire_time, 0);
	}
};

//----------------------------------------------------------------------
// Mammoth has multiple projectile types (general function)
//----------------------------------------------------------------------
void(float ad_proj_type, vector ad_body_offset, float ad_robotside) ad_mammoth_fireprojectile =
{
	local vector ad_bodyorg;

	// This is where the attack orgin vector is rotated into position
	// based on the attack_angled defined before in the tilt function
	// Grenade attack does not use body tilt function
	if (ad_proj_type == ad_MM_PROJGREN) ad_bodyorg = ad_body_offset;
	// Rotate the projectile firing position around the body origin
	// Makevectors (forward/right/up) has to be set beforehand!
	else ad_bodyorg = ad_mathlib_vectorotateY(ad_body_offset, self.ad_attack_angle);
	
	// Pick which type of projectile is being fired
	if (ad_proj_type == ad_MM_PROJLASER) ad_mammoth_laser(ad_bodyorg, ad_robotside);
	else if (ad_proj_type == ad_MM_PROJROCK) ad_mammoth_rocket(ad_bodyorg, ad_robotside);
	else if (ad_proj_type == ad_MM_PROJGREN) ad_mammoth_grenade(ad_bodyorg, ad_robotside);
	else if (ad_proj_type == ad_MM_PROJCORE) ad_mammoth_coreattack(ad_bodyorg);
};

//======================================================================
// C E N T R A L   L O O P  ( all animation blocks )
//
//======================================================================
void() ad_mammoth_frame =
{
	// Death phase, no HP checks, smoke or droning sound
	if (self.style != ad_MM_PHASE4) {
		// This condition should never be fired
		if (self.health < 1) return;
	
		// Spew particles and smoke
		ad_mammoth_jeteffects(self.ad_walkframe, 0.25);
	
		// Update the drone sound
		if (self.ad_waitmin3 < time) {
			self.ad_waitmin3 = time + 1.3;
			// Play on auto channel so it overlaps with existing sound
			sound (self, ad_CHAN_AUTO, "mammoth/idledrone2.wav", self.volume, ad_ATTN_NORM);
		}
	}

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_mammoth_frame;

	// Check for boss wave trigger events
	if (ad_mammoth_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}
	
	//----------------------------------------------------------------------
	// Beginning of annimation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();

	// Check for any front light sound triggers
	if (self.state == ad_MM_STAND || self.state == ad_MM_WALK || self.state == ad_MM_RUN) {
		if (self.ad_walkframe == 5 || self.ad_walkframe == 8 || self.ad_walkframe == 12)
			ad_mammoth_frontlight(ad_FALSE, ad_FALSE);
		
		// Different stand/walk/run animation sets depending on phase
		if (self.style == ad_MM_PHASE1) self.frame = $runA1 + self.ad_walkframe;
		else if (self.style == ad_MM_PHASE2) self.frame = $runB1 + self.ad_walkframe;
		else if (self.style == ad_MM_PHASE3) self.frame = ($runC1 + self.ad_walkframe) - $blank2;
		else dprint("\b[MAMMOTH]\b Movement phase not detected!\n");
		self.ad_walkframe = self.ad_walkframe + 1;
	}
	
	//----------------------------------------------------------------------
	if (self.state == ad_MM_STAND) {
		// Standing idle has gentle bobbing up and down
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_FLY;

		// Check velocity movement before bobbing up/down
		if (self.velocity_x == 0 && self.velocity_y == 0) {
			if (self.ad_attack_timer < time) {
				self.ad_attack_timer = time + 1;
				if (self.lip < 1) self.lip = 1;
				else self.lip = -1;
				self.velocity_z = 4 * self.lip;
			}
		}
		else {
			// Slowdown the velocity (movement = no friction)
			self.velocity = self.velocity * self.ad_velocityfriction;
			if (self.velocity_x > -5 && self.velocity_x < 5) self.velocity_x = 0;
			if (self.velocity_y > -5 && self.velocity_y < 5) self.velocity_y = 0;
			if (self.velocity_z > -5 && self.velocity_z < 5) self.velocity_z = 0;
			// Don't go into attack straight away when velocity is active
			self.ad_attack_finished = time + 0.3;
		}
		
		// Keep looking for a player
		if (ad_mammoth_FindTarget ()) ad_FoundTarget();
	}
	// Everything except stand is step movement (no velocity)
	// Might as well have a stand 'else if' to fix this
	else {
		// Movement is steps, not velocity
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		self.velocity = '0 0 0';
	}
	
	//----------------------------------------------------------------------
	if (self.state == ad_MM_WALK || self.state == ad_MM_RUN) {
		// What type of movement/functionality
		if (self.state == ad_MM_WALK) {
			// Check tether point before moving
			if (ad_mammoth_CheckTether()) { ad_ai_walk(0); ad_ai_face(); }
			else ad_ai_walk(6);
		}
		else {
			// Check tether point before moving
			if (ad_mammoth_CheckTether()) { ad_ai_run(0); ad_ai_face(); }
			else ad_ai_run(6);
		}
	}
	//----------------------------------------------------------------------
	// SWITCH OVER : Change animations for phases 1>2 and 2>3
	//----------------------------------------------------------------------
	else if (self.state == ad_MM_PHASE1_2) {
		// Check for any front light sound triggers
		if (self.ad_walkframe == 5 || self.ad_walkframe == 7 || self.ad_walkframe == 10)
			ad_mammoth_frontlight(ad_TRUE, ad_FALSE);

		// Start arm movement, switch all lights on and finish arms
		if (self.ad_walkframe == 0)
			sound (self, ad_CHAN_BODY, "mammoth/arms_start.wav", 1, ad_ATTN_NORM);
		else if (self.ad_walkframe == 14) ad_mammoth_frontlight(ad_TRUE, ad_TRUE);
		else if (self.ad_walkframe == 15)
			sound (self, ad_CHAN_BODY, "mammoth/arms_finish.wav", 1, ad_ATTN_NORM);

		ad_ai_face();
		self.frame = $switch1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;		

		// End of switch over from P1 > P2
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) {
			self.state = ad_MM_RUN;
			self.style = ad_MM_PHASE2;
			self.ad_walkframe = 0;
			// Default resistance
			ad_mammoth_shieldoff();		// Default resistance
			ad_mammothshield_disable();	// Disable blue shield
		}
	}
	//----------------------------------------------------------------------
	else if (self.state == ad_MM_PHASE2_3) {
		// Keep looking at the player
		ad_ai_face();
		
		// Random lightning and plasma shots
		if (random() < 0.5) ad_mammoth_lightning('0 0 32');

		// all vectors are from projectile attacks
		makevectors(self.angles);

		// Explosions Pre-change over
		if (self.ad_walkframe == 0) {
			// gib velocity override
			self.ad_gibdir = ad_MON_GIBFOUNTAIN;
			// Start chain explosion on left arm + small on right arm
			ad_mammoth_explosions(ad_MM_EXPL_LEFT, 40, 0, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_RIGHT, 52, 1, ad_FALSE);
		}
		else if (self.ad_walkframe == 1) {
			// Finish chain explosion on left arm + small central
			ad_mammoth_explosions(ad_MM_EXPL_LEFT, 48, 1, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_MIDC, 24, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 2) {
			// Start chain explosion on right arm
			ad_mammoth_explosions(ad_MM_EXPL_RIGHT, 40, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 3) {
			// Finish chain explosion on right arm + small central
			ad_mammoth_explosions(ad_MM_EXPL_RIGHT, 48, 1, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_MIDL, 24, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 4) {
			// Start chain explosion in middle area
			ad_mammoth_explosions(ad_MM_EXPL_MIDC, 48, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 5) {
			// Finish chain explosion in middle area + small central
			ad_mammoth_explosions(ad_MM_EXPL_MIDC, 64, 1, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_MIDR, 32, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 6) {
			// Single central explosion
			ad_mammoth_explosions(ad_MM_EXPL_MIDR, 48, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 7) {
			// Start chain explosion on right arm
			ad_mammoth_explosions(ad_MM_EXPL_RIGHT, 40, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 8) {
			// Spawn metal gibs
			ad_mammoth_genericgibs(3);
			// Finish chain explosion on right arm + small central
			ad_mammoth_explosions(ad_MM_EXPL_RIGHT, 48, 1, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_MIDL, 32, 0, ad_FALSE);
		}
		else if (self.ad_walkframe == 9) {
			// Start chain explosion on left arm
			ad_mammoth_explosions(ad_MM_EXPL_LEFT, 40, 0, ad_FALSE);
		}	
		else if (self.ad_walkframe == 10) {
			// Spawn generic + unique gibs
			ad_mammoth_genericgibs(6);
			ad_mammoth_uniquegibs();
			// Finish chain explosion on left arm + small central
			ad_mammoth_explosions(ad_MM_EXPL_LEFT, 50, 1, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_MIDR, 48, 0, ad_FALSE);
			setmodel(self, self.ad_mdl2);					// SWITCH model
			setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
			// Smaller jet flame explosion
			ad_mammoth_jetexplosion(self.ad_attack_expflame*0.5);
		}
		else if (self.ad_walkframe == 11) {
			// no more blue shield, its all gone
			ad_mammothshield_finished();
			// Spawn metal gibs
			ad_mammoth_genericgibs(3);
			// Finish central explosions
			ad_mammoth_explosions(ad_MM_EXPL_MIDR, 72, 0, ad_FALSE);
			ad_mammoth_explosions(ad_MM_EXPL_MIDL, 48, 1, ad_FALSE);
		}
		
		// Use correct animation offset for model
		if (self.ad_walkframe >= 10) 
			self.frame = ($swapB1 + self.ad_walkframe) - $blank2;
		else self.frame = $swapA1 + self.ad_walkframe;
		// Keep on going
		self.ad_walkframe = self.ad_walkframe + 1;

		// End of switch over from P2 > P3
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) {
			self.state = ad_MM_RUN;
			self.style = ad_MM_PHASE3;
			self.ad_walkframe = 0;
			ad_mammoth_shieldoff();	// Phase 3 resistance setup
		}
	}
	//----------------------------------------------------------------------
	// MELEE COMBAT
	//----------------------------------------------------------------------
	else if (self.state == ad_MM_ATTACKDUMP) {
		// No front lights for phase 3
		if (self.style != ad_MM_PHASE3) {
			// Check for any front light sound triggers
			if (self.ad_walkframe == 5  || self.ad_walkframe == 7 ||
				self.ad_walkframe == 9 || self.ad_walkframe == 11) {
				ad_mammoth_frontlight(ad_FALSE, ad_FALSE);
			}
		}
		// Player facing
		ad_ai_face();
		
		// Wind up sound for attack
		if (self.ad_walkframe == 0) {
			sound (self, ad_CHAN_BODY, "mammoth/flame_attack.wav", 1, ad_ATTN_NORM);
		}
		// Start the dump! (first/last 3 frames do nothing)
		else if (self.ad_walkframe >= 3 && self.ad_walkframe <= 16) {
			// Setup short/long firing sounds
			if (self.ad_walkframe < 16)
				// Small 
				sound (self, ad_CHAN_WEAPON, "mammoth/flame_fire.wav", 1, ad_ATTN_NORM);	
			else 
				// Giant explosion at the end of the sequence
				sound (self, ad_CHAN_WEAPON, "mammoth/flame_explode.wav", 1, ad_ATTN_NORM);
			
			// Keep on dumpin! (14 frames)
			ad_mammoth_jetdump();
		}

		// Update frame based on phase
		if (self.style == ad_MM_PHASE1) self.frame = $dumpA1 + self.ad_walkframe;
		else if (self.style == ad_MM_PHASE2) self.frame = $dumpB1 + self.ad_walkframe;
		else self.frame = ($dumpC1 + self.ad_walkframe) - $blank2;
		// Keep moving forward
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.state = ad_MM_RUN;
	}
	//----------------------------------------------------------------------
	// PHASE 1 COMBAT
	//----------------------------------------------------------------------
	else if (self.state == ad_MM_ATTACKLASER1) {
		// Check for any front light sound triggers
		if (self.ad_walkframe == 4  || self.ad_walkframe == 7 ||
			self.ad_walkframe == 12 || self.ad_walkframe == 15)
			ad_mammoth_frontlight(ad_FALSE, ad_FALSE);

		// Work out tilt angle and check for locks
		ad_mammoth_tiltbody(4, 15);

		// Enable velocity tracking for hard/nm skill
		if (ad_skill >= ad_SKILL_HARD) {
			self.ad_attack_rage = ad_TRUE;
			self.ad_attack_sidestep = 4;
		}
		else self.ad_attack_rage = ad_FALSE;
		
		// Which laser to fire?
		if (self.ad_walkframe == 4) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '30 38 40', 1);
		else if (self.ad_walkframe == 7) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '30 38 52', 1);
		else if (self.ad_walkframe == 12) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '30 -38 40', -1);
		else if (self.ad_walkframe == 15) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '30 -38 52', -1);

		// Update frame
		self.frame = $laserA1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) {
			self.angles_x = 0;
			self.state = ad_MM_RUN;
		}
	}
	else if (self.state == ad_MM_ATTACKLASER2) {
		// Check for any front light sound triggers
		if (self.ad_walkframe > 6 && self.ad_walkframe < 13)
			ad_mammoth_frontlight(ad_FALSE, ad_FALSE);

		// Work out tilt angle and check for locks
		ad_mammoth_tiltbody(6, 15);
			
		// Enable velocity tracking for hard/nm skill
		if (ad_skill >= ad_SKILL_HARD) {
			self.ad_attack_rage = ad_TRUE;
			self.ad_attack_sidestep = 7;
		}
		else self.ad_attack_rage = ad_FALSE;

		// 8 shot burst mode
		if (self.ad_walkframe == 7) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 38 52', 1);
		else if (self.ad_walkframe == 8) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 -38 52', -1);
		else if (self.ad_walkframe == 9) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 38 40', 1);
		else if (self.ad_walkframe == 10) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 -38 40', -1);
		else if (self.ad_walkframe == 11) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 38 52', 1);
		else if (self.ad_walkframe == 12) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 -38 52', -1);
		else if (self.ad_walkframe == 13) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 38 40', 1);
		else if (self.ad_walkframe == 14) ad_mammoth_fireprojectile( ad_MM_PROJLASER, '33 -38 40', -1);

		// Update frame
		self.frame = $laserB1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) {
			self.angles_x = 0;
			self.state = ad_MM_RUN;
		}
	}
	//----------------------------------------------------------------------
	// PHASE 2 COMBAT
	//----------------------------------------------------------------------
	else if (self.state == ad_MM_ATTACKROCK1) {
		// Check for any front light sound triggers
		if (self.ad_walkframe == 3  || self.ad_walkframe == 5 ||
			self.ad_walkframe == 13 || self.ad_walkframe == 15)
			ad_mammoth_frontlight(ad_FALSE, ad_FALSE);

		// Work out tilt angle and check for locks
		ad_mammoth_tiltbody(3, 15);
			
		// Which rocket to fire?
		if (self.ad_walkframe == 2) sound (self, ad_CHAN_WEAPON, "mammoth/rocket_load.wav", 1, ad_ATTN_NORM);
		else if (self.ad_walkframe == 3) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '28 40 36', 1);
		else if (self.ad_walkframe == 5) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '28 42 54', 1);
		else if (self.ad_walkframe == 13) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '28 -40 36', -1);
		else if (self.ad_walkframe == 15) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '26 -40 54', -1);

		// Update frame
		self.frame = $rocketA1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.state = ad_MM_RUN;
	}
	else if (self.state == ad_MM_ATTACKROCK2) {
		// Check for any front light sound triggers
		if (((self.ad_walkframe >= 4  && self.ad_walkframe <= 8) ||
			self.ad_walkframe >= 11) && self.ad_walkframe <= 15)
			ad_mammoth_frontlight(ad_FALSE, ad_FALSE);

		// Work out tilt angle and check for locks
		ad_mammoth_tiltbody(8, 15);
			
		// Which rocket to fire?
		if (self.ad_walkframe == 3) sound (self, ad_CHAN_WEAPON, "mammoth/rocket_load.wav", 1, ad_ATTN_NORM);
		else if (self.ad_walkframe == 11) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '14 48 56', 1);
		else if (self.ad_walkframe == 12) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '14 -48 56', -1);
		else if (self.ad_walkframe == 13) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '20 48 38', 1);
		else if (self.ad_walkframe == 14) ad_mammoth_fireprojectile( ad_MM_PROJROCK, '20 -48 38', -1);

		// Update frame
		self.frame = $rocketB1 + self.ad_walkframe;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.state = ad_MM_RUN;
	}
	//----------------------------------------------------------------------
	// PHASE 3 COMBAT
	//----------------------------------------------------------------------
	else if (self.state == ad_MM_ATTACKCORE1 || self.state == ad_MM_ATTACKCORE2) {
		// Wind up sound for attack
		if (self.ad_walkframe == 0) 
			sound (self, ad_CHAN_BODY, "mammoth/core_attack.wav", 1, ad_ATTN_NORM);

		// Work out tilt angle and check for locks
		ad_mammoth_tiltbody(5, 25);

		// Fire projectiles from center +/- Y offset
		self.finalangle = '30 0 56';
		if (self.state == ad_MM_ATTACKCORE1) {
			// Shorter attack
			self.ad_attack_frame = 8;
			self.ad_attack_count = 12;
			self.ad_attack_lifetime = self.ad_attack_frame + self.ad_attack_count;
			self.ad_frame_box = ($coreA1 + self.ad_walkframe) - $blank2;
		}
		else {
			// Long attack
			self.ad_attack_frame = 6;
			self.ad_attack_count = 16;
			self.ad_attack_lifetime = self.ad_attack_frame + self.ad_attack_count;
			self.ad_frame_box = ($coreB1 + self.ad_walkframe) - $blank2;
		}
			
		// Check for projectile burst mode
		if (self.ad_walkframe >= self.ad_attack_frame && self.ad_walkframe <= self.ad_attack_lifetime) {
			// Create Y offset for projectiles to sweep along
			self.finalangle_y = (self.ad_walkframe - self.ad_attack_frame) - (self.ad_attack_count * 0.5);
			// Attack 2 goes the opposite direction
			if (self.state == ad_MM_ATTACKCORE2) self.finalangle_y = -self.finalangle_y;
			// Launch projectile + velocity tracking
			ad_mammoth_fireprojectile( ad_MM_PROJCORE, self.finalangle, 0 );
		}

		// Update frame
		self.frame = self.ad_frame_box;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_COREBLOCK) {
			self.state = ad_MM_RUN;
			self.ad_walkframe = 0;
		}
	}
	else if (self.state == ad_MM_ATTACKGREN1) {
		// There is no tilt function for grenade attack
		// Keep turning towards the player
		ad_ai_face();
		
		if (self.ad_walkframe == 2) sound (self, ad_CHAN_WEAPON, "mammoth/grenade_load.wav", 1, ad_ATTN_NORM);
		else if (self.ad_walkframe == 6) ad_mammoth_fireprojectile( ad_MM_PROJGREN, '30 12 88', 1);
		else if (self.ad_walkframe == 9) ad_mammoth_fireprojectile( ad_MM_PROJGREN, '30 -12 88', -1);
		else if (self.ad_walkframe == 13) ad_mammoth_fireprojectile( ad_MM_PROJGREN, '32 15 84', 1);
		else if (self.ad_walkframe == 15) ad_mammoth_fireprojectile( ad_MM_PROJGREN, '30 -19 85', -1);

		// Update frame
		self.frame = ($grenadeA1 + self.ad_walkframe) - $blank2;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.state = ad_MM_RUN;
	}
	else if (self.state == ad_MM_ATTACKGREN2) {
		// There is no tilt function for grenade attack
		// Keep turning towards player until ready to fire
		if (self.ad_walkframe <= 6) ad_ai_face();
		
		if (self.ad_walkframe == 2) sound (self, ad_CHAN_WEAPON, "mammoth/grenade_load.wav", 1, ad_ATTN_NORM);
		else if (self.ad_walkframe == 6) {
			// Save central angle point
			self.ad_attack_angle = self.angles_y;
			// Swing to the left
			self.ideal_yaw = self.ad_attack_angle - 30;
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 10 88', 1);
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 -10 84', -1); }
		else if (self.ad_walkframe >= 7 && self.ad_walkframe <= 8) ChangeYaw();
		else if (self.ad_walkframe == 9) {
			// Swing back to central point
			self.ideal_yaw = self.ad_attack_angle;
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 16 88', 1);
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 -10 88', -1); }
		else if (self.ad_walkframe >= 10 && self.ad_walkframe <= 11) ChangeYaw();
		else if (self.ad_walkframe == 12) {
			// Swing to right
			self.ideal_yaw = self.ad_attack_angle + 30;
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 16 84', 1);
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 -16 88', -1); }
		else if (self.ad_walkframe >= 13 && self.ad_walkframe <= 14) ChangeYaw();
		else if (self.ad_walkframe == 15) {
			// Swing back to the central point
			self.ideal_yaw = self.ad_attack_angle;
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 10 84', 1);
			ad_mammoth_fireprojectile( ad_MM_PROJGREN, '28 -16 84', -1); }

		// Update frame
		self.frame = ($grenadeB1 + self.ad_walkframe) - $blank2;
		self.ad_walkframe = self.ad_walkframe + 1;
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.state = ad_MM_RUN;
	}
	//----------------------------------------------------------------------
	// PAIN and DEATH functionality
	//----------------------------------------------------------------------
	if (self.state == ad_MM_PAIN) {
		// Check for any front light sound triggers
		if (self.ad_walkframe == 1  || self.ad_walkframe == 4 ||
			self.ad_walkframe == 5 || self.ad_walkframe == 9) {
			ad_mammoth_frontlight(ad_FALSE, ad_FALSE);
		}
		
		if (random() < 0.5) self.angles_x = random()*8;
		
		// Random lightning and plasma shots
		// Phase 1 = 0.4, 2 = 0.5, 3 = 0.6, 4 = 0.7, 5 = 0.8, 6 = 0.9
		self.ad_attack_frame = 0.3 + (self.ad_attack_count * 0.1); 
		if (random() < self.ad_attack_frame) ad_mammoth_lightning('0 0 32');
		else if ( random() < 0.4) ad_mammoth_plasmabolt('0 0 32');
		
		// Random explosions on body (Phase 3 = no arms)
		if (self.ad_walkframe == 2 && random() < 0.4)
			ad_mammoth_explosions(ad_MM_EXPL_MIDL, 32, 0, ad_FALSE);
		if (self.ad_walkframe == 3 && random() < self.ad_attack_frame)
			ad_mammoth_explosions(ad_MM_EXPL_MIDL, 48, 1, ad_FALSE);
		if (self.ad_walkframe == 5 && random() < 0.4)
			ad_mammoth_explosions(ad_MM_EXPL_MIDR, 56, 0, ad_FALSE);
		if (self.ad_walkframe == 6 && random() < self.ad_attack_frame)
			ad_mammoth_explosions(ad_MM_EXPL_MIDR, 32, 1, ad_FALSE);
		if (self.ad_walkframe == 8 && random() < 0.4)
			ad_mammoth_explosions(ad_MM_EXPL_MIDC, 16, 0, ad_FALSE);
		if (self.ad_walkframe == 9 && random() < self.ad_attack_frame)
			ad_mammoth_explosions(ad_MM_EXPL_MIDC, 48, 1, ad_FALSE);

		// Update frame based on phase
		if (self.style == ad_MM_PHASE3) 
			self.frame = ($painC1 + self.ad_walkframe) - $blank2;
		else self.frame = $painA1 + self.ad_walkframe;
		// Keep on loopin!
		self.ad_walkframe = self.ad_walkframe + 1;
		
		// End of animation block?
		if (self.ad_walkframe >= ad_MM_PAINBLOCK) {
			// Reset animation and tilt angle
			self.ad_walkframe = self.angles_x = 0;
			// Reduce loop counter (allow for multiple pain sets)
			self.ad_attack_count = self.ad_attack_count - 1;
			// Is it time to exit this animation yet?
			if (self.ad_attack_count <= 0) {
				// Which phase to switch to next?
				if (self.style == ad_MM_PHASE1) self.state = ad_MM_PHASE1_2;
				else if (self.style == ad_MM_PHASE2) self.state = ad_MM_PHASE2_3;
				// The final phase of pain is death!
				else self.state = ad_MM_DEATH;
			}
		}
	}
	//----------------------------------------------------------------------
	if (self.state == ad_MM_DEATH) {
		// Final body fireworks!
		ad_mammoth_explosions(ad_MM_EXPL_MIDL, 48, 1, ad_FALSE);
		ad_mammoth_explosions(ad_MM_EXPL_MIDR, 32, 1, ad_FALSE);
		ad_mammoth_explosions(ad_MM_EXPL_MIDC, 0, 0, ad_FALSE);
		ad_mammoth_explosions(ad_MM_EXPL_MIDC, 80, 1, ad_FALSE);
		
		// Stop functionality, there is a dead body model
		ad_entity_stop (self);
		// Make sure gibs go flying up
		self.ad_gibdir = ad_MON_GIBEXPLOSION;
		self.health = -100; self.max_health = 0;
		// Dead body model
		setmodel(self, self.ad_headmdl);
		self.frame = 0;

		// Make sure there is collision
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_NONE;
		self.ad_bbmaxs = '32 32 24';
		setsize(self, self.ad_bbmins, self.ad_bbmaxs);

		// Spawn all generic/unique gibs
		ad_mammoth_genericgibs(12);
		ad_mammoth_uniquegibs();
		// Giant jet flame explosion + dead body flames
		ad_mammoth_jetexplosion(self.ad_attack_expflame);
		ad_mammoth_firewreck(6);
		
		// Lots of random chunks
		self.pos1 = self.origin + '0 0 80';
		ad_SpawnProjectileSmoke(self.pos1, 64, 450, 100);
		ad_SpawnProjectileSmoke(self.pos1, 96, 500, 100);
		ad_SpawnProjectileSmoke(self.pos1, 64, 450, 100);
		ad_SpawnProjectileSmoke(self.pos1, 96, 400, 100);

		// Final Yellow explosion
		self.pos1 = self.origin + '0 0 64';
		if (ad_ext_dppart) te_explosion2(self.pos1, 192, 8);
		else {
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
			WriteCoord (ad_MSG_BROADCAST, self.pos1_x);
			WriteCoord (ad_MSG_BROADCAST, self.pos1_y);
			WriteCoord (ad_MSG_BROADCAST, self.pos1_z);
			WriteByte (ad_MSG_BROADCAST, 192);
			WriteByte (ad_MSG_BROADCAST, 8);
		}
	}
	
	//----------------------------------------------------------------------
	// Cycle animation set? (exception = core attacks (30+ frames)
	if (self.state != ad_MM_ATTACKCORE1 && self.state != ad_MM_ATTACKCORE2) {
		if (self.ad_walkframe >= ad_MM_ANIMBLOCK) self.ad_walkframe = 0;
	}
};

//----------------------------------------------------------------------
// Only used to find out vector locations (dev only)
//----------------------------------------------------------------------
void() ad_mammoth_framecheck = {
	//setmodel(self, self.mdl);
	setmodel(self, self.ad_mdl2);
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	setorigin(self, self.origin+'0 0 64');
	self.use = ad_SUB_Null;
	self.think = ad_SUB_Null;
	self.nextthink = ad_LARGE_TIMER;
	makevectors (self.angles);
		
	self.ad_finaldest = self.origin + ad_attack_vector('28 -16 84');
	if (!self.ad_tno1) self.ad_tno1 = ad_mammoth_devmarker();
	setorigin(self.ad_tno1, self.ad_finaldest);
	self.frame = 168;
};

//======================================================================
// Different monster states
//----------------------------------------------------------------------
void() ad_mammoth_stand = {
	self.ad_walkframe = 0;		// Reset animation block
	self.angles_x = 0;		// Turn off any tilt angle
	self.state = ad_MM_STAND;	// Change animation state
	ad_mammoth_frame();		// Back to main loop
};
void() ad_mammoth_walk = { 
	self.ad_walkframe = 0;		// Reset animation block
	self.angles_x = 0;		// Turn off any tilt angle
	self.state = ad_MM_WALK;	// Change animation state
	ad_mammoth_frame();		// Back to main loop
};
void() ad_mammoth_run = { 
	self.ad_walkframe = 0;		// Reset animation block
	self.angles_x = 0;		// Turn off any tilt angle
	self.state = ad_MM_RUN;	// Change animation state
	ad_mammoth_frame();		// Back to main loop
};

void() ad_mammoth_dump = {
	self.ad_walkframe = 0;				// Reset animation block
	self.angles_x = 0;				// Turn off any tilt angle
	self.ad_pain_finished = time + 2;	// No pain interruption
	self.state = ad_MM_ATTACKDUMP;		// Change animation state
	ad_mammoth_frame();				// Back to main loop
};

//----------------------------------------------------------------------
void() ad_mammoth_range = {
	self.ad_walkframe = 0;				// Reset animation block
	self.angles_x = 0;				// Turn off any tilt angle
	self.ad_attack_offset = '0 0 0';	// Reset random arm side offset
	self.ad_pain_finished = time + 2;	// no pain interruptions
	
	// Pick range attack based on phase (1-3)
	if (self.style == ad_MM_PHASE1) {
		// If weapons partly blocked, use 2nd more aggressive attack
		// Otherwise setup chance based on skill level instead
		if (self.ad_attack_sidedeny) self.ad_attack_chance = -1;
		else self.ad_attack_chance = 0.9 - (ad_skill * 0.3);
		if (random() > self.ad_attack_chance)
			self.state = ad_MM_ATTACKLASER2;
		else self.state = ad_MM_ATTACKLASER1;
		// Reset aggressive mode
		self.ad_attack_sidedeny = ad_FALSE;
	}
	else if (self.style == ad_MM_PHASE2) {
		// If weapons partly blocked, use 2nd more aggressive attack
		// Otherwise setup chance based on skill level instead
		if (self.ad_attack_sidedeny) self.ad_attack_chance = -1;
		else self.ad_attack_chance = 0.8 - (ad_skill * 0.2);
		if (random() > self.ad_attack_chance)
			self.state = ad_MM_ATTACKROCK2;
		else self.state = ad_MM_ATTACKROCK1;
		// Reset aggressive mode
		self.ad_attack_sidedeny = ad_FALSE;
	}
	else if (self.style == ad_MM_PHASE3) {
		// If weapons partly blocked, use grenade suppresion mode
		// Otherwise setup chance based on skill level instead
		if (self.ad_attack_sidedeny) self.state = ad_MM_ATTACKGREN2;
		else {
			// How close is the player?
			self.ad_enemydist = ad_range_distance(ad_SUB_entEnemyTarget(), ad_FALSE);
			// Is player is too close? ALWAYS use lasers
			if (self.ad_enemydist < ad_MONAI_COREMAMMOTH) self.ad_attack_chance = 0;
			// Is the player is too far away? ALWAYS use grenades
			else if (self.ad_enemydist > ad_MONAI_GRENMAMMOTH) self.ad_attack_chance = 1;
			// Otherwise 50/50 split between lasers/grenades
			else self.ad_attack_chance = 0.5;
			// Pick primary attack type
			if (random() > self.ad_attack_chance) {
				// Core attack
				self.ad_attack_chance = 0.9 - (ad_skill * 0.3);
				if (random() > self.ad_attack_chance)
					self.state = ad_MM_ATTACKCORE2;
				else self.state = ad_MM_ATTACKCORE1;
			}
			else {
				// Grenade attack
				self.ad_attack_chance = 0.8 - (ad_skill * 0.2);
				if (random() > self.ad_attack_chance)
					self.state = ad_MM_ATTACKGREN2;
				else self.state = ad_MM_ATTACKGREN1;
			}
		}
		// Reset aggressive mode
		self.ad_attack_sidedeny = ad_FALSE;
	}
	ad_mammoth_frame();		// Back to main loop
};	
	
//----------------------------------------------------------------------
void() ad_mammoth_phaseswitch = {
	// Check for half phase transitions
	if (self.ad_bosswave == 2 || self.ad_bosswave == 4) return;
	// Check for the final phase = death
	if (self.ad_bosswave == 6) return;
	
	self.ad_walkframe = 0;		// Reset animation block
	self.angles_x = 0;		// Turn off any tilt angle
	// Move on to pain animation and then transistion phase
	if (self.ad_bosswave == 3 || self.ad_bosswave == 5) {
		ad_mammoth_shieldon();		// Default resistance
		ad_mammothshield_enable();	// Blue shield on
		self.state = ad_MM_PAIN; self.ad_attack_count = self.style + 1;
	}
	// If all else fails, go back to running
	else self.state = ad_MM_RUN;
	ad_mammoth_frame();		// Back to main loop
};

//======================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_mammoth_pain =
{
	// Check for boss wave trigger events
	if (ad_mammoth_WaveCheck() == ad_TRUE) {self.ad_th_summon(); return;}

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0)
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	// There is no pain animation for the mammoth!
};

//======================================================================
void() ad_mammoth_die =
{
	self.deadflag = ad_DEAD_DEAD;	// Mammoth kicks the bucket
	self.effects = 0;			// Remove effects on death
	self.style = ad_MM_PHASE4;		// Used to stop motor drone sound
	self.ad_attack_count = 6;		// Repeat pain 6 times
	self.ad_walkframe = 0;		// Reset animation block
	self.angles_x = 0;		// Turn off any tilt angle
	ad_mammoth_shieldon();		// Default resistance

	// Check for final trigger event
	if(self.ad_noise6 != "") ad_trigger_strs(self.ad_noise6, self);
	// Machine winding down sound (6s)
	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
	// Final animation (pain,pain and more pain)
	self.state = ad_MM_PAIN; 
	ad_mammoth_frame();	
};

//======================================================================
// Long animation sequence where front lights come on and the arms
// are extended outward ready to fire
//----------------------------------------------------------------------
void() ad_mammoth_wakeframe =
{
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_mammoth_wakeframe;
	
	// Spew lots particles and smoke as boss lifts off ground
	if (self.ad_walkframe > 31) ad_mammoth_jeteffects(self.ad_walkframe - 31, 0.25);
	// Start with lots of smoke (override active)
	else if (self.ad_walkframe > 5) ad_mammoth_jeteffects(0, 1);
	
	// Play all the start up sequence special sounds
	if (self.ad_walkframe == 4)
		sound (self, ad_CHAN_VOICE, "mammoth/wake_start.wav", 1, ad_ATTN_NORM);
	else if (self.ad_walkframe == 30)
		sound (self, ad_CHAN_BODY, "mammoth/arms_start.wav", 1, ad_ATTN_NORM);
	else if (self.ad_walkframe == 40)
		sound (self, ad_CHAN_BODY, "mammoth/arms_finish.wav", 1, ad_ATTN_NORM);

	// Front click sounds
	if (self.ad_walkframe == 1 || self.ad_walkframe == 4 || self.ad_walkframe == 7)
		ad_mammoth_frontlight(ad_TRUE, ad_FALSE);
	
	// Setup drone (jet feet) sound
	if (self.ad_walkframe == 8 || self.ad_walkframe == 22 || self.ad_walkframe == 36)
		sound (self, ad_CHAN_AUTO, "mammoth/idledrone2.wav", self.volume, ad_ATTN_NORM);
	
	// Keep moveing the animation frame forward
	self.frame = $wake1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Wait for sound/animation to start
	if (self.ad_walkframe > 4) {
		// Gently push the mammoth off the ground (use animation block total)
		self.velocity_z = (ad_MM_WAKEBLOCK - self.ad_walkframe) * 0.5;
	}

	// Time to fight?
	if (self.ad_walkframe >= ad_MM_WAKEBLOCK) {
		ad_mammothshield_disable();	// Blue shield off
		ad_mammoth_shieldoff();		// Default resistance

		// New phase and switch over function
		self.style = ad_MM_PHASE1;
		self.ad_th_summon = ad_mammoth_phaseswitch;

		// Restore all think functions
		self.ad_th_stand = ad_mammoth_stand;
		self.ad_th_walk = ad_mammoth_walk;
		self.ad_th_run = ad_mammoth_run;
		self.ad_th_melee = ad_mammoth_dump;
		self.ad_th_missile = ad_mammoth_range;
		self.ad_th_pain = ad_mammoth_pain;
		self.ad_th_die = ad_mammoth_die;

		// Go through stand to acquire a target
		self.think = self.ad_th_stand;
	}
};

//----------------------------------------------------------------------
void() ad_mammoth_wakeup = { 
	// Allow wake up to fly up gradually
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_FLY;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.flags = self.flags | ad_FL_FLY;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	// Reset animation frame
	self.ad_walkframe = 0; 
	ad_mammoth_wakeframe();
};
void() ad_mammoth_locked1 = [ $wake1, ad_mammoth_locked1 ] {};

//======================================================================
void() ad_mammoth_start =
{
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.state = ad_MM_LOCKED;			// Starting position
	self.style = ad_MM_PHASE0;			// Current boss phase
	
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	setorigin(self, self.origin);

	self.yaw_speed = 20;			// Average yaw rotation
	self.velocity = '0 0 0';		// Make sure stationary
	self.deadflag = ad_DEAD_NO;		// used to stop death re-triggering
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	self.ad_pain_longanim = ad_FALSE;		// No axe advantage
	
	self.ad_gibhealth = -1000;			// Special death sequence
	self.ad_pain_finished = self.ad_attack_finished = 0;
	
	ad_mammoth_shieldon();				// Locked resistance

	// Setup boss waves and overall health
	self.ad_bosswave = 1;
	self.ad_bosswavetotal = 6;
	self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_mammoth_WaveSetupHP();

	// Check there is space for mammoth to spawn
	self.origin_z = self.origin_z + 1;
	droptofloor();
	if (!ad_walkmove(0,0)) {
		// this condition should be a map spawn event only
		dprint ("\b[STUCK]\b "); dprint (self.classname);
		dprint (" at "); dprint (vtos(self.origin));
		dprint ("\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
	}

	// Check if defined tether target exists
	if (self.ad_tethertarget != "") {
		// Find tether target entit
		self.ad_movelast = find( world, targetname, self.ad_tethertarget);
		// If does not exist, reset and generate one
		if (!self.ad_movelast) self.ad_tethertarget = "";
	}
	
	// Any custom tether target defined?
	if (self.ad_tethertarget == "") {
		// Tether point, save for later
		self.ad_movelast = spawn();
		self.ad_movelast.owner = self;
		self.ad_movelast.targetname = "mammoth_pole1";
		self.ad_tethertarget = self.ad_movelast.targetname;
		self.ad_movelast.ad_classtype = ad_CT_TETHERENT;
		self.ad_movelast.movetype = ad_MOVETYPE_NONE;
		self.ad_movelast.solid = ad_SOLID_NOT;
		self.ad_movelast.origin = self.origin;
		setsize (self.ad_movelast, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	}
	// Debug marker (only developer = 1)
	ad_spawn_marker(self.ad_movelast.origin, ad_SPNMARK_RED);
	
	// Setup blue shield glow
	ad_mammothshield_setup();
	ad_mammothshield_enable();
	
	// Default tether range (override for different room sizes)
	if (!self.ad_tetherrange) self.ad_tetherrange = ad_MONAI_MAXMAMMOTH;
	if (self.ad_tetherrange <= 64) self.ad_tetherrange = 64;

	// Wait for trigger event to get off the floor
	self.think = ad_mammoth_locked1;
	self.nextthink = time + 0.1;
	self.use = ad_mammoth_wakeup;
	// Freeze mammoth in certain frame
	//mammoth_framecheck();
};

//======================================================================
/*ad:QUAKED monster_mammoth (1 0 0) (-32 -32 -24) (32 32 96)
======================================================================*/
void() ad_monster_mammoth =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_mammoth.mdl";			// Mammoth Phase 1+2
	self.ad_mdl2 = "progs/mon_mammothb.mdl";		// Mammoth Phase 3
	self.ad_weaponglow = "progs/mon_mammoth_glow.mdl";	// Blue shield
	self.ad_headmdl = "progs/mon_mammothd.mdl";		// Final dead chunk
	precache_model (self.mdl);
	precache_model (self.ad_mdl2);
	precache_model (self.ad_weaponglow);
	precache_model (self.ad_headmdl);

	// Phase 2 gib models
	precache_model ("progs/gib_mammoth1.mdl");	// Front light panel
	precache_model ("progs/gib_mammoth2.mdl");	// Corner chunk 1
	precache_model ("progs/gib_mammoth3.mdl");	// Arm piece
	precache_model ("progs/gib_mammoth4.mdl");	// Front light panel
	precache_model ("progs/gib_mammoth5.mdl");	// Arm piece
	// Phase 3 gib models
	precache_model ("progs/gib_mammoth6.mdl");	// Back panel
	precache_model ("progs/gib_mammoth7.mdl");	// Feet jet
	precache_model ("progs/gib_mammoth8.mdl");	// Grenade panel
	precache_model ("progs/gib_mammoth9.mdl");	// Corner chunk 2
	precache_model ("progs/gib_mammoth10.mdl");	// Back Fan
	precache_model ("progs/gib_metal1.mdl");	// Generic metal chunk
	self.ad_gibtype = ad_GIBTYPE_METAL;				// All metal
	self.ad_gibdir = ad_MON_GIBFOUNTAIN;				// Velocity override

	// Robot talktalk
	self.ad_idle_sound = "mammoth/idle1.wav";
	precache_sound (self.ad_idle_sound);

	// Constant drone sound (background)
	precache_sound ("mammoth/idledrone2.wav");
	// Wake sequence
	precache_sound ("mammoth/wake_start.wav");
	// Arms movement/update
	precache_sound ("mammoth/arms_start.wav");
	precache_sound ("mammoth/arms_finish.wav");
	// Front lights on/off
	precache_sound ("mammoth/front_light1.wav");
	precache_sound ("mammoth/front_light2.wav");
	precache_sound ("mammoth/front_light3.wav");
	
	// Attacks - Lasers, Rockets and Grenades
	precache_model (ad_MODEL_PROJ_LASER);
	precache_sound (ad_SOUND_LASER_FIRE);
	precache_sound (ad_SOUND_LASER_HIT);
	precache_sound (ad_SOUND_LASER_RIC);
	precache_model (ad_MODEL_PROJ_ROCKET);
	// Extra load/fire sounds (from Quoth MOD)
	precache_sound ("mammoth/rocket_load.wav");
	precache_sound ("mammoth/rocket_fire.wav");
	precache_sound ("mammoth/rocket_hit.wav");
	// Load flame sprites / sounds
	ad_PreCache_Flame();
	precache_sound ("mammoth/flame_attack.wav");
	precache_sound ("mammoth/flame_fire.wav");
	precache_sound ("mammoth/flame_explode.wav");
	// Core sounds
	precache_sound ("mammoth/core_attack.wav");
	// Grenade sounds
	precache_sound ("mammoth/grenade_load.wav");
	precache_sound ("mammoth/grenade_fire.wav");

	// Pain, death and gibs!
	self.ad_pain_sound = "mammoth/pain1.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "mammoth/death1.wav";
	precache_sound (self.ad_death_sound);
	precache_sound ("mammoth/explode_minor.wav");
	precache_sound ("mammoth/explode_major.wav");
	precache_sound ("mammoth/elec_arch1.wav");
	precache_sound ("mammoth/elec_arch2.wav");
	// Fired from boss between phases
	precache_model (ad_MODEL_PROJ_PLASMA);
	// Mechanic on/off sounds for blue shield
	precache_sound ("mammoth/shield_on.wav");
	precache_sound ("mammoth/shield_off.wav");
	
	// Wakeup sound
	self.ad_sight_sound = "mammoth/sight1.wav";
	precache_sound (self.ad_sight_sound);
	
	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_bbmins = '-32 -32 -24';	// Special Size
	self.ad_bbmaxs = '32 32 96';
	self.ad_bboxtype = ad_BBOX_CUSTOM;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	self.ad_poisonous = ad_FALSE;			// Robots are not poisonous
	self.ad_deathstring = " was obliterated by the Mammoth\n";
	
	self.health = self.max_health = ad_MEGADEATH;
	self.ad_pain_finished = time + ad_LARGE_TIMER;
	self.takedamage = ad_DAMAGE_NO;
	
	self.ad_gibhealth = ad_MON_NEVERGIB;	// Special explosion death
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 400;			// Really low chance of pain
	self.ad_pain_longanim = ad_FALSE;		// No long pain animation
	self.ad_infightextra = 16;			// Extremely high infighting damage
	self.ad_steptype = ad_FS_FLYING;		// Ninja robot feet (jets)
	self.ad_blockudeath = ad_TRUE;		// No humanoid death sound
	self.ad_no_liquiddmg = ad_TRUE;		// Immune to slime/lava
	self.ad_meleeoffset = '70 180 290';// Jet feet circular positions
	self.ad_attack_offset = '0 0 0';	// Side (left/right) fire offset
	self.ad_attack_explosive = ad_TRUE;	// Rockets = Phase 2, Grenades = Phase 3
	if (!self.ad_attack_expflame) self.ad_attack_expflame = 24;

	// Setup default Proj Count = Base (X) * (Skill * Y) Maximum = Z
	if (ad_CheckZeroVector(self.ad_proj_attqty)) self.ad_proj_attqty = '0 0 14';
	self.ad_part_exitpuff = self.ad_part_exitsound = ad_TRUE;

	if (!self.height) self.height = 64; // Custom attack height (min = 32)
	if (self.height < 32) self.height = 32;

	if (!self.volume) self.volume = 1;	// Drone volume (+range checks)
	if (self.volume < 0) self.volume = 0;
	if (self.volume > 1) self.volume = 1;
	
	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);

	// default = No think functions
	self.ad_th_checkattack = ad_mammothCheckAttack;
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_SUB_Null;
	self.ad_th_melee = self.ad_th_missile = self.ad_th_summon = ad_SUB_Null;
	self.ad_th_die = ad_SUB_Null;
	self.ad_th_pain = ad_SUB_Null_pain;

	self.ad_classtype = ad_CT_MONMAMMOTH;
	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVEFLY;

	// No targetname = no trigger!
	if (self.targetname == "") {
		dprint("\b[MAMMOTH_BOSS]\b Missing trigger name!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}

	total_monsters = total_monsters + 1;
	self.think = ad_mammoth_start;
	self.nextthink = time + 0.1;
};
