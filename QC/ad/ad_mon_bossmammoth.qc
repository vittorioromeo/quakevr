float ad_MM_WALK = 10;			// Walk and run are combined
float ad_MM_RUN = 11;

float ad_MM_ATTACKDUMP = 15;	// Phase 1/2/3 Plasma/Fire dump (MELEE)

float ad_MM_ATTACKLASER1 = 20;	// Phase 1 Laser attack 1
float ad_MM_ATTACKLASER2 = 21;	// Phase 1 Laser attack 2

float ad_MM_ATTACKROCK1 = 25;	// Phase 2 Rocket attack 1
