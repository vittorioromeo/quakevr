//======================================================================
// ATTACK C - Projectile vomit rocks and dust at the player
// Animation - breathe, swings arms back and push head forward
//======================================================================
void(vector ad_rockofs) ad_Fire_attackC =
{
	local vector ad_org, ad_dir;

	if (!self.enemy) return;
	if (self.health < 1) return;

	makevectors(self.angles);
	// Spawn a mist of particles where projectiles came from
	ad_org = self.origin + ad_attack_vector(ad_rockofs) + v_right*(ad_crandom()*8) + v_up*(ad_crandom()*16);

	ad_dir = normalize(self.enemy.origin - ad_org);
	ad_particle_explode(ad_org, 5 + rint(random()*5), 2, ad_PARTICLE_BURST_WHITE, ad_PARTICLE_BURST_UPWARD);
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_EIDOSPIKE + (ad_skill * ad_SPEED_EIDOSKILLSP);
	
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_GROCK, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_eidolon_attackC2 = {
	// Do nothing if dead
	if (self.health < 0) return;

	self.nextthink = time + 0.05;
	// Keep turning towards the player
	ad_ai_face();
	
	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 43) self.think = self.ad_th_run;
	self.frame = $breath1 + self.ad_walkframe;
	
	// Start demon roar and then rocks!?!
	if (self.frame == $breath4)
		sound (self, ad_CHAN_WEAPON, "eidolon/attackc.wav", 1, ad_ATTN_NORM);
	
	// Rock breath!?!
	if (self.frame > $breath17 && self.frame < $breath35)
		ad_Fire_attackC('56 0 44');
};

//----------------------------------------------------------------------
void() ad_eidolon_attackC1 = [ $breath1, ad_eidolon_attackC2 ] {ad_ai_face();
	self.ad_pain_finished = time + 2;
	self.ad_walkframe = 0;
};

