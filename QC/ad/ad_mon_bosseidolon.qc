//======================================================================
void() ad_eidolon_attackD1 =
{
};

//======================================================================
// ATTACK E - Summon monsters from blocks of stone
// Animation - power, lean head back, put hands up right infront
//======================================================================
void(vector ad_rockofs, float ad_rockframe) ad_Setup_attackE =
{
	local vector ad_org;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_eidolon_create_attachment();
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_rockframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.skin = 1;

		// Start long growl
		sound (self, ad_CHAN_VOICE, "eidolon/attacke.wav", 1, ad_ATTN_NORM);
		sound (self, ad_CHAN_WEAPON, "weapons/lhit.wav", 1, ad_ATTN_NORM);
	}
	
	if (ad_rockframe == 7) {
		// Goodbye little rock!
		ad_eidolon_finish_attachment();
		// Wakeup crystal and golems
		if (self.ad_attachment2.ad_target2 != "") 
					ad_trigger_strs(self.ad_attachment2.ad_target2, self);
	}
	else {
		// Turn towards enemy and update model attachment
		// The offset is based on the Eidolon facing forward
		makevectors(self.angles);
		ad_org = self.origin + ad_attack_vector(ad_rockofs);
		setorigin(self.ad_attachment, ad_org);
		self.ad_attachment.angles = self.angles;
		self.ad_attachment.angles_x = random()*360;
		self.ad_attachment.frame = ad_rockframe;
		// Random explosion like particles from ball as it grows
		ad_particle_explode(self.ad_attachment.origin, 10+random()*10, 0.5+random(), ad_PARTICLE_BURST_BLUE, 0);

		// Generate the lightning effect
		self.effects = self.effects | ad_EF_MUZZLEFLASH;
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
		WriteEntity (ad_MSG_BROADCAST, self);
		WriteCoord (ad_MSG_BROADCAST, self.ad_attachment.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.ad_attachment.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.ad_attachment.origin_z);
		WriteCoord (ad_MSG_BROADCAST, self.ad_attachment2.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.ad_attachment2.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.ad_attachment2.origin_z);
	}
};

//----------------------------------------------------------------------
void() ad_eidolon_attackE_firing = {
	self.nextthink = time + 0.1;
	
	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	// is the lightning spell finished?
	if (self.ad_walkframe > 19) {
		self.think = self.ad_th_run;
		self.ad_walkframe = 0;
		ad_Resist_ChangeType(self, ad_FALSE);
		self.takedamage = ad_DAMAGE_YES;
		self.goalentity = self.enemy;
	}
	self.frame = $power1 + self.ad_walkframe;

	// Check the state of the projectile (grow/fire)
	if (self.frame == $power7) ad_Setup_attackE('68 16 84',0);
	else if (self.frame == $power8) ad_Setup_attackE('72 16 92',1);
	else if (self.frame == $power9) ad_Setup_attackE('74 16 94',2);
	else if (self.frame == $power10) ad_Setup_attackE('76 16 98',3);
	else if (self.frame == $power11) ad_Setup_attackE('76 16 102',4);
	else if (self.frame == $power12) ad_Setup_attackE('78 16 104',5);
	else if (self.frame == $power13) ad_Setup_attackE('80 16 104',7);
}

//----------------------------------------------------------------------
void() ad_eidolon_attackE2 = [ $power1, ad_eidolon_attackE_firing ] {
	self.ad_walkframe = 0;
};

//----------------------------------------------------------------------
void() ad_eidolon_attackE_turning = {
	self.nextthink = time + 0.05;
	
	// Turn towards the power crystal
	if (ad_eidolon_angcheck(self.ad_attachment2.origin,5)) ChangeYaw();
	
	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 23) {
		self.think = ad_eidolon_attackE2;
		self.ad_walkframe = 0;
	}
	self.frame = $walk1 + self.ad_walkframe;
	
	// Check for any special frame events
	if (self.frame == $walk2 || self.frame == $walk14)
		ad_monster_footstep(ad_FALSE);
	
	// Move slowly closer to crystal or backward!
	self.ad_enemydist = ad_range_distance(self.ad_attachment2, ad_FALSE);
	if (self.ad_enemydist > ad_MONAI_CLOSEEIDO) ad_movetogoal(6);
	else ad_walkmove (self.ideal_yaw - 180, 3);
};

//----------------------------------------------------------------------
void() ad_eidolon_attackE1 = [ $walk1, ad_eidolon_attackE_turning ] {
	ad_Resist_ChangeType(self, ad_TRUE);
	self.takedamage = ad_DAMAGE_NO;
	self.goalentity = self.ad_attachment2;
	self.yaw_speed = 6;		// Turning slowly
	self.ad_walkframe = 0;		// Reset animation counter
	
	// Check angle difference betweem boss and crystal
	// If within 5 degree's tolerance, skip turning
	if (!ad_eidolon_angcheck(self.ad_attachment2.origin,5)) 
		self.think = ad_eidolon_attackE2;
};

//============================================================================
// PAIN and DEATH
//============================================================================
void() ad_eidolon_painA2 =
{
	// Do nothing if dead
	if (self.health < 1) return;
	self.nextthink = time + 0.1;

	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 8) {
		self.frame = $painA8;
		self.think = ad_eidolon_run1;
	}
	else self.frame = $painA1 + self.ad_walkframe;
};

//----------------------------------------------------------------------
void() ad_eidolon_painB2 =
{
	// Do nothing if dead
	if (self.health < 1) return;
	self.nextthink = time + 0.05;

	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 19) {
		self.frame = $painB20;
		self.think = ad_eidolon_run1;
	}
	else self.frame = $painB1 + self.ad_walkframe;
};

//----------------------------------------------------------------------
void() ad_eidolon_painA1 = [ $painA1, ad_eidolon_painA2 ] {self.ad_walkframe = 0;};
void() ad_eidolon_painB1 = [ $painB1, ad_eidolon_painB2 ] {self.ad_walkframe = 0;};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_eidolon_pain =
{
	// Finish with all attachments
	ad_eidolon_finish_attachment();

	// Check for boss wave trigger events
	if (ad_eidolon_WaveCheck() == ad_TRUE) return;

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
			// Randomly pick which pain animation to play
			if (random() < 0.7) ad_eidolon_painA1 ();	// Short recoil
			else {
				ad_eidolon_painB1 ();					// Long recoil
				self.ad_pain_finished = time + 2;		// long animation
			}
		}
	}
};

//============================================================================
// Oh no rocky has died!?!
//============================================================================
void() ad_eidolon_explode =
{
	// Check for any final trigger events
	if (self.ad_message2 != "") ad_trigger_strs(self.ad_message2,self);

	// No more Boss!
	ad_entity_hide(self);
	
	// Blue ID particle explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	WriteByte (ad_MSG_BROADCAST, 35);
	WriteByte (ad_MSG_BROADCAST, 8);
	
	// Classic sprite/DP explosion
	ad_SpawnExplosion(ad_EXPLODE_PLASMA_BIG, self.origin, "eidolon/explode_death.wav");

	// Gib explosive fountain!?!
	self.max_health = ad_MON_GIBEXPLOSION;
	ad_ThrowGib(11, 10 + rint(random()*10));	// Small Golem rock
	ad_ThrowGib(12, 10 + rint(random()*10));	// Large Golem rock
	ad_ThrowGib(4, 5 + rint(random()*3));		// Some flesh bits
	ad_ThrowGib(5, 5 + rint(random()*3));
};

//----------------------------------------------------------------------
void() ad_eidolon_die2 = 
{
	self.nextthink = time + 0.1;
	if (self.frame == $crouch3) self.solid = ad_SOLID_NOT;
	
	// Keep moveing the animation frame forward
	if (self.ad_walkframe < 30) {
		self.ad_walkframe = self.ad_walkframe + 1;
		self.frame = $crouch1 + self.ad_walkframe;
	}
	else {
		// Make sure final frame is set
		self.frame = $crouch30;

		// Spawn implosion effect
		if (random() < 0.5)
			ad_particle_implode(self.origin, 20+random()*20, 100, 100, ad_PARTICLE_BURST_WHITE);
		// Spawn particle smoke and explosive smoke
		else {
			ad_SpawnProjectileSmoke(self.origin, 150, 100, 300);
			ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_WHITE);
		}
	
		// Check for any random lightning strikes outward
		if (random() < 0.5) {
			self.pos1 = self.origin - '0 0 16';
			self.pos2 = ad_vecrand(0,50,ad_TRUE);
			self.pos2_z = 25 + random()*25;	// Always up!
			self.ad_pos3 = normalize(self.pos2);
			traceline(self.pos1, self.pos1 + self.ad_pos3 * 600, ad_FALSE, self);
			
			// Create lightning bolt
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
			WriteEntity (ad_MSG_BROADCAST, self);
			WriteCoord (ad_MSG_BROADCAST, self.origin_x);
			WriteCoord (ad_MSG_BROADCAST, self.origin_y);
			WriteCoord (ad_MSG_BROADCAST, self.origin_z);
			WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
			WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
			WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);

			// Play some arching lightning sounds
			if (random() < 0.5) {
				if (random() < 0.5) sound (self, ad_CHAN_BODY, "eidolon/elec_arch1.wav", 1, ad_ATTN_NORM);
				else sound (self, ad_CHAN_BODY, "eidolon/elec_arch2.wav", 1, ad_ATTN_NORM);
			}
		}
	
		// Cycle through end phase
		self.lip = self.lip + 1;
		self.nextthink = time + 0.1;	// Slow down to regular time
		if (self.lip == 26) sound (self, ad_CHAN_AUTO, "eidolon/implode_death.wav", 1, ad_ATTN_NONE);
		if (self.lip > 40) ad_eidolon_explode();
	}
};

//----------------------------------------------------------------------
void() ad_eidolon_die1 = [ $crouch1, ad_eidolon_die2 ] {
	self.ad_walkframe = self.lip = 0;
};

//----------------------------------------------------------------------
void() ad_eidolon_die =
{
	self.deadflag = ad_DEAD_DEAD;		// the rock finally crashed
	self.effects = 0;				// Remove effects on death
	ad_eidolon_finish_attachment();	// Remove any attachments
	ad_eidolon_remove_attachment();

	sound (self, ad_CHAN_VOICE, "eidolon/death.wav", 1, ad_ATTN_NORM);
	ad_eidolon_die1 ();
};

//======================================================================
// Roar and break free from cage!
//======================================================================
void() ad_eidolon_free2 =
{
	// Do nothing if dead
	if (self.health < 1) return;

	self.nextthink = time + 0.1;
	
	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 27) {
		self.yaw_speed = 20;			// Average Speed
		ad_Resist_ChangeType(self, ad_FALSE);	// Default resistance
		self.think = self.ad_th_run;		// Start running!
	}
	self.frame = $howl1 + self.ad_walkframe;
};

//----------------------------------------------------------------------
void() ad_eidolon_free1 = [ $howl1, ad_eidolon_free2 ] {
	self.takedamage = ad_DAMAGE_YES;		// Enable resistance effects
	sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_NORM);
	self.ad_walkframe = 0;
};

//======================================================================
// Setup Eidolon after trigger event
//======================================================================
void() ad_eidolon_wakeup =
{
	self.use = ad_SUB_Null;			// No more triggers
	self.style = ad_EIDOLON_PHASE2;	// Free to fight
	
	// Restore all think functions
	self.ad_th_stand = ad_eidolon_stand1;
	self.ad_th_walk = ad_eidolon_walk1;
	self.ad_th_run = ad_eidolon_run1;
	self.ad_th_melee = ad_eidolon_attackC1;
	self.ad_th_missile = ad_eidolon_attackA1;
	self.ad_th_summon = ad_eidolon_attackE1;
	self.ad_th_pain = ad_eidolon_pain;
	self.ad_th_die = ad_eidolon_die;
	
	self.ad_pain_finished = time + 3;		// Make pain go away
	self.ad_attack_finished = time + 2;	// Reset attack system

	// Time for Eidolon to break free!
	self.think = ad_eidolon_free1;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_eidolon_start =
{
	self.use = ad_SUB_Null;			// Suppress trigger events
	self.style = ad_EIDOLON_PHASE1;	// Trapped in cage
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	setorigin(self, self.origin);
	
	self.yaw_speed = 6;				// Really slow while in cage
	self.velocity = '0 0 0';		// Make sure stationary
	self.deadflag = ad_DEAD_NO;		// used to stop death re-triggering
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	self.ad_pain_longanim = ad_FALSE;		// No axe advantage
	self.takedamage = ad_DAMAGE_NO;	// Immune to damage
	
	self.ad_gibhealth = -1000;			// Special death sequence
	self.ad_pain_finished = self.ad_attack_finished = 0;
	
	// Setup Ammo Resistance
	self.ad_resist_shells = self.ad_resist_cells = 0;
	self.ad_resist_nails = self.ad_resist_rockets = 0.75;
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	self.ad_reflectaxe = ad_TRUE;			// Prevent axe damage
		
	//Resist_CheckRange(self);		// Double check values
	ad_Resist_Save(self);				// Save for Later
	ad_Resist_ChangeType(self,ad_TRUE);	// resist everything
	
	// Setup boss waves and overall health
	self.ad_bosswave = 1;
	self.ad_bosswavetotal = 5;
	self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_eidolon_WaveSetupHP();

	// default = No think functions
	self.ad_th_checkattack = ad_EidolonCheckAttack;
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_SUB_Null;
	self.ad_th_missile = self.ad_th_die = ad_SUB_Null;
	self.ad_th_pain = ad_SUB_Null_pain;
	
	// Check there is space for Eidolon to spawn
	self.origin_z = self.origin_z + 1;
	droptofloor();
	if (!ad_walkmove(0,0)) {
		// this condition should be a map spawn event only
		dprint ("\b[STUCK]\b "); dprint (self.classname);
		dprint (" at "); dprint (vtos(self.origin));
		dprint ("\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
	}

	// Tether point, save for later
	self.ad_movelast = spawn();
	self.ad_movelast.owner = self;
	self.ad_movelast.ad_classtype = ad_CT_TETHERENT;
	self.ad_movelast.movetype = ad_MOVETYPE_NONE;
	self.ad_movelast.solid = ad_SOLID_NOT;
	self.ad_movelast.origin = self.origin;
	setsize (self.ad_movelast, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_spawn_marker(self.ad_movelast.origin+'0 0 8', ad_SPNMARK_RED);
	if (self.ad_tetherrange < 32) self.ad_tetherrange = ad_MONAI_MAXEIDO;

	// Make sure all death triggers are setup ready
	self.ad_message2 = self.target;
	self.target = self.ad_target2 = self.ad_deathtarget = "";

	// Can only stand around and walk on the spot
	self.ad_th_stand = ad_eidolon_stand1;
	self.ad_th_walk = self.ad_th_run = ad_eidolon_walk1;
	
	// Wait for trigger event to be free from cage
	self.think = self.ad_th_stand;
	self.nextthink = time + 0.1;
	self.use = ad_eidolon_wakeup;
};

//======================================================================
/*ad:QUAKED monster_eidolon (1 0 0) (-32 -32 -24) (32 32 128)
======================================================================*/
void() ad_monster_eidolon =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_bosseidolon.mdl";
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_EIDO1);
	precache_model (ad_MODEL_PROJ_GROCK1);
	precache_model (ad_MODEL_PROJ_GROCK2);

	self.ad_gib1mdl = ad_MODEL_PROJ_GROCK1;	// small golem rock
	self.ad_gib2mdl = ad_MODEL_PROJ_GROCK2;	// medium golem rock
	self.ad_gib1frame = self.ad_gib2frame = 9;

	// sight/pain/death sounds
	self.ad_idle_sound = "eidolon/idle1.wav";
	self.ad_idle_sound2 = "eidolon/idle2.wav";
	self.ad_pain_sound = "eidolon/pain.wav";
	self.ad_sight_sound = "eidolon/sight.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_sight_sound);

	// Final death sequence
	precache_sound ("eidolon/death.wav");
	precache_sound ("eidolon/explode_death.wav");
	precache_sound ("eidolon/implode_death.wav");
	precache_sound ("eidolon/elec_arch1.wav");
	precache_sound ("eidolon/elec_arch2.wav");
	
	// Attack A - Throw Boulder - range attack
	precache_sound ("eidolon/attacka.wav");
	precache_sound ("eidolon/rock_hit1.wav");
	precache_sound ("eidolon/rock_hit2.wav");

	// Attack C - Rockstorm - range attack
	precache_sound ("eidolon/attackc.wav");
	precache_sound (ad_SOUND_IMP_ROCK1);
	precache_sound (ad_SOUND_IMP_ROCK2);
	precache_sound (ad_SOUND_IMP_ROCK3);
	precache_sound (ad_SOUND_IMP_ROCK4);

	// Attack E - Lightning at summoning crystal - range attack
	precache_sound ("eidolon/attacke.wav");
	
	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_bbmins = '-32 -32 -24';	// Special Size
	self.ad_bbmaxs = '32 32 128';
	self.ad_bboxtype = ad_BBOX_CUSTOM;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	self.ad_poisonous = ad_FALSE;			// Cannot be poisonous
	self.ad_deathstring = " was pulverized by the Sculptor\n";
	self.ad_lastorigin = self.origin;	// Origin for camera interpolation
	self.ad_ticktimer = 0.05;			// Model animations at 20fps
	
	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	self.health = self.max_health = ad_MEGADEATH;
	self.ad_pain_finished = time + ad_LARGE_TIMER;
	self.takedamage = ad_DAMAGE_NO;	// Immune to damage
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_flinch = 200;			// 1/2 Shambler level
	self.ad_pain_timeout = 2;			// Stop constant pain
	self.ad_infightextra = 3;			// Crazy damage, noinfighting
	self.skin = 1;					// New rocky skin

	// Custom feet sounds
	self.ad_stepc1 = "eidolon/footstep1.wav";
	self.ad_stepc2 = "eidolon/footstep2.wav";
	self.ad_stepc3 = "eidolon/footstep3.wav";
	self.ad_stepc4 = "eidolon/footstep4.wav";
	self.ad_stepc5 = "eidolon/footstep1.wav";
	precache_sound (self.ad_stepc1);
	precache_sound (self.ad_stepc2);
	precache_sound (self.ad_stepc3);
	precache_sound (self.ad_stepc4);
	precache_sound (self.ad_stepc5);
	self.ad_steptype = ad_FS_TYPECUSTOM;
	
	self.ad_classtype = ad_CT_MONEIDOLON;
	self.ad_classgroup = ad_CG_STONE;
	self.ad_classmove = ad_MON_MOVEWALK;
	self.style = 0;
	
	// No targetname = no trigger!
	if (self.targetname == "") {
		dprint("\b[EIDO_BOSS]\b Missing trigger name!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}

	total_monsters = total_monsters + 1;
	self.use = ad_eidolon_start;
};

//======================================================================
/*ad:QUAKED monster_eidolon_wavetrig (0.75 0.25 1) (-32 -32 -4) (32 32 4) x
Target for boss lightning wave event
-------- KEYS --------
targetname : name of wave event (links to noise key on boss)
target     : trigger name of adds to spawn
target2    : trigger name of crystal event
noise      : targetname of collision entity
-------- SPAWNFLAGS --------
-------- NOTES --------
Target for boss lightning wave event

======================================================================*/
void() ad_monster_eidolon_wavetrig = 
{
	self.ad_classtype = ad_CT_MONEIDOLONWAVE;
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	self.takedamage = ad_DAMAGE_NO;
	setsize (self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
};

