float ad_EIDOLON_PHASE1 = 1;	// Trapped in cage
float ad_EIDOLON_PHASE2 = 2;	// Fighting

//======================================================================
// Global functions
//======================================================================
// Work out angle difference between player and boss
//----------------------------------------------------------------------
float(vector ad_targorg, float ad_angdiff) ad_eidolon_angcheck =
{
	self.ideal_yaw = vectoyaw(ad_targorg - self.origin);
	if ((self.ideal_yaw - ad_angdiff) > self.angles_y) return ad_TRUE;
	else if ((self.ideal_yaw + ad_angdiff)<self.angles_y) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// Need own find player function because of arena size
// Also setup all parameters ready to start combat quicker
//----------------------------------------------------------------------
float() ad_eidolon_FindTarget =
{
	local entity ad_client;
	
	// Get the obvious exception(s) done first
	if (self.health < 1) return ad_FALSE;
	if (ad_intermission_running > 0) return ad_FALSE;
	if (ad_cinematic_running > 0) return ad_FALSE;

	// Find a client in current PVS
	ad_client = checkclient ();
	
	// Go through all the exception(s)
	if (!ad_client) return ad_FALSE;
	if (!(ad_client.flags & ad_FL_CLIENT)) return ad_FALSE;
	if (ad_client.flags & ad_FL_NOTARGET) return ad_FALSE;
	if (ad_client.items & ad_IT_INVISIBILITY) return ad_FALSE;
	
	// Check range and visibility of player
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return ad_FALSE;
	if (!ad_infront(ad_client)) return ad_FALSE;

	// Finally found something
	self.enemy = ad_client;
	self.oldorigin = self.origin;		// Save origin
	self.goalentity = self.enemy;		// Focus on enemy
	// Setup turning angle towards new enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);

	// Stage 1 is trapped, boss cannot attack or run
	if (self.style == ad_EIDOLON_PHASE1) return ad_FALSE;

	// Move straight into run+attack
	self.nextthink = time + 0.1;
	self.think = self.ad_th_run;		// Start running
	ad_SUB_AttackFinished (1);			// wait a while before first attack

	// We have a winner!
	return ad_TRUE;	
};

//----------------------------------------------------------------------
// Setup wave HP and trigger boundaries
//----------------------------------------------------------------------
void() ad_eidolon_WaveSetupHP =
{
	// Is there anymore boss waves left?
	if (self.ad_bosswave >= self.ad_bosswavetotal) {
		// Only one wave left (death is final trigger)
		self.health = self.ad_bosswaveqty;
		self.ad_bosswavetrig = -1000;
	}
	else {
		// Multiple waves are still left (reset hp+trigger)
		// Always reset HP to stop high DPS weapons trashing waves boundaries
		self.health = ((self.ad_bosswavetotal - self.ad_bosswave) + 1) * self.ad_bosswaveqty;
		// The wave trigger is always one wave lower
		self.ad_bosswavetrig = self.health - self.ad_bosswaveqty;
	}
	// Debug messages for wave and health
	dprint("\b[BOSS]\b Wave ("); dprint(ftos(self.ad_bosswave));
	dprint(" / "); dprint(ftos(self.ad_bosswavetotal));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//----------------------------------------------------------------------
// Check if HP reached next wave, walk to center and fire targets
//----------------------------------------------------------------------
float() ad_eidolon_WaveCheck =
{
	// Check for boss wave boundary event
	if (self.health > 1 && self.health < self.ad_bosswavetrig) {
		// Check for wave boundary triggers
		self.noise = "";
		if (self.ad_bosswave == 1) self.noise = self.noise1;
		else if(self.ad_bosswave == 2) self.noise = self.noise2;
		else if(self.ad_bosswave == 3) self.noise = self.noise3;
		else if(self.ad_bosswave == 4) self.noise = self.noise4;
		
		// Is there any trigger for the wave boundary?
		if (self.noise != "") {
			self.ad_attachment2 = find(world, targetname, self.noise);
			if (self.ad_attachment2.ad_classtype == ad_CT_MONEIDOLONWAVE) {
				// Spawn any adds to keep player busy
				if (self.ad_attachment2.target != "") 
					ad_trigger_strs(self.ad_attachment2.target, self);
				
				// Turn around and fire at crystal
				self.ad_th_summon();
			}
		}

		// Update Boss wave parameters (next wave!)
		self.ad_bosswave = self.ad_bosswave + 1;
		ad_eidolon_WaveSetupHP();		// Reset trigger/hp
		return ad_TRUE;
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Eidolon game play logic
//----------------------------------------------------------------------
void() ad_EidolonCheckAttack = 
{
	local float ad_currentdist;
	
	// Check for boss wave trigger events
	if (ad_eidolon_WaveCheck() == ad_TRUE) return;

	//----------------------------------------------------------------------
	// Check the tether system
	//----------------------------------------------------------------------
	ad_currentdist = vlen(self.origin - self.ad_movelast.origin);
	//self.t_width = vlen(self.enemy.origin - self.movelast.origin);
	// Is the boss at maximum range?
	if (ad_currentdist > self.ad_tetherrange) {
		// Can the boss see the player?
		if (ad_enemy_vis) self.ad_attack_state = ad_AS_MELEE;
		else {
			// At max range + cannot see player, exit combat
			self.ad_enemytarget = self.enemy;
			self.enemy = world;
			self.goalentity = self.ad_movetarget = self.ad_movelast;
			self.ad_attack_state = ad_AS_STRAIGHT;
			self.think = self.ad_th_walk;
		}
		return;
	}
		
	//----------------------------------------------------------------------
	// Check Melee range and constantly fire
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_CLOSEEIDO) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}

	//----------------------------------------------------------------------
	// Range attacks (Boulder + Rock Storm)
	//----------------------------------------------------------------------
	// Only range attack if cooldown has finished
	if (time > self.ad_attack_finished) {
		// Intense rock storm attack
		if (self.ad_enemydist < ad_MONAI_MEDIUMEIDO && random() < 0.75) {
			// Skill 0=3s, 1=2.25s, 2=1.5s, 3=0.75s
			self.ad_attack_speed = (4 - ad_skill) * 0.75;
			self.ad_attack_finished = time + self.ad_attack_speed + random();
			self.ad_attack_state = ad_AS_MELEE;
			return;
		}
		// Large boulder attack
		else {
			// Skill 0=4s, 1=3s, 2=2s, 3=1s
			self.ad_attack_speed = (4 - ad_skill) * 1;
			self.ad_attack_finished = time + self.ad_attack_speed + random();
			self.ad_attack_state = ad_AS_MISSILE;
			return;
		}
	}
};

//======================================================================
// MONSTER STATES (stand, walk run, attack, pain and death!
//======================================================================
void() ad_eidolon_idle =
{
	// Do nothing if dead
	if (self.health < 1) return;
	if (self.ad_walkframe == 1) ad_monster_idle_sound();
	self.nextthink = time + 0.05;

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 14) self.ad_walkframe = 0;
	self.frame = $stand1 + self.ad_walkframe;
	
	// Keep looking for a player
	ad_eidolon_FindTarget ();
	
	if (self.style == ad_EIDOLON_PHASE1) {
		// Slow animation speed, trapped inside cage
		self.nextthink = time + 0.1;
		// Found a player, now track them around the room
		if (self.enemy.flags & ad_FL_CLIENT) {
			if (ad_eidolon_angcheck(self.enemy.origin, 60)) 
				self.think = self.ad_th_walk;
		}
	}
};

//----------------------------------------------------------------------
void() ad_eidolon_stand1 = [ $stand1, ad_eidolon_idle ] {self.ad_walkframe = 0;};

//======================================================================
// There is only one set of animations for walk and run and
// the only different is the final AI state (walk/run) 
// This is a hexen2 model so it should run at 20fps not 10fps
//----------------------------------------------------------------------
float ad_EIDOLON_WALK = 2;
float ad_EIDOLON_RUN = 4;

//----------------------------------------------------------------------
void(float ad_fstate) ad_eidolon_move =
{
	// Do nothing if dead
	if (self.health < 1) return;
	self.nextthink = time + 0.05;
	
	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 23) self.ad_walkframe = 0;
	self.frame = $walk1 + self.ad_walkframe;
	
	// Check for any special frame events
	if (self.frame == $walk1) ad_monster_idle_sound();
	if (self.frame == $walk2 || self.frame == $walk14)
		ad_monster_footstep(ad_FALSE);
	
	// Phase 1 (caged) uses walk to turn around
	if (self.style == ad_EIDOLON_PHASE1) {
		// Wrong angle difference? keep turning
		if (ad_eidolon_angcheck(self.enemy.origin, 10)) ChangeYaw();
		else {
			// Close the beginning or the end of the animation?
			if (self.ad_walkframe < 4 || self.ad_walkframe > 20) 
				self.think = self.ad_th_stand;
		}
	}
	// Phase 2 (free) walking back to center
	else if (self.style == ad_EIDOLON_PHASE2 && ad_fstate == ad_EIDOLON_WALK) {
		// Check for player
		if (ad_eidolon_FindTarget ()) return;

		// Calculate distance to origin location (notouch function)
		self.ad_enemydist = vlen(self.ad_movelast.origin - self.origin);
		// Reached origin point yet?
		if (self.ad_enemydist < ad_MONAI_SPAWNEIDO) {
			// Still remember the old player?
			if (self.ad_enemytarget.flags & ad_FL_CLIENT) {
				self.enemy = self.ad_enemytarget;
				self.ad_enemytarget = world;
			}
			// Keep turning towards old player
			if (ad_eidolon_angcheck(self.enemy.origin, 10)) ChangeYaw();
			else self.think = self.ad_th_stand;
		}
		// Still not reached center
		else ad_movetogoal(6);
	}
	// Time to walk or run?
	else if (ad_fstate == ad_EIDOLON_RUN && self.enemy) ad_ai_run(6);
};

//----------------------------------------------------------------------
void() ad_eidolon_walk1 = [ $walk1, ad_eidolon_walk1 ] {ad_eidolon_move(ad_EIDOLON_WALK);};
void() ad_eidolon_run1 = [ $walk1, ad_eidolon_run1 ] {ad_eidolon_move(ad_EIDOLON_RUN);};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_eidolon_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.mdl = ad_MODEL_PROJ_EIDO1;
	}
};

//----------------------------------------------------------------------
void() ad_eidolon_setup_attachment = 
{
	// Is monster dead or dying?
	if (self.health < 1) return;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_eidolon_create_attachment();

	// Move attachment into place ready for use
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	self.ad_attachment.solid = ad_SOLID_NOT;
	setmodel(self.ad_attachment, ad_MODEL_EMPTY);
	setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	setorigin(self.ad_attachment, self.origin);
	// Using empty model, so reset angle, frame and skin.
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = self.ad_attachment.skin = 0;
};

//----------------------------------------------------------------------
void() ad_eidolon_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_eidolon_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
}

//======================================================================
// ATTACK A  - Fire large explosive rock (grenade)
// Animation - Spell, put right hand up and infront
//======================================================================
void(vector ad_rockofs) ad_Fire_attackA =
{
	local float ad_foffset, ad_offset, ad_shotcount;
	local vector ad_org, ad_sorg, ad_dir, ad_offang, ad_avel;

	// Finished with growing rock
	ad_eidolon_finish_attachment();

	if (!self.enemy) return;
	if (self.health < 1) return;

	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_rockofs);
	self.effects = self.effects | ad_EF_MUZZLEFLASH;

	// create an arc of rockets fanning outwards from source
	ad_foffset = 8;
	ad_offset = -ad_foffset; ad_shotcount = 3;
	while (ad_shotcount > 0) {
	// based angle of projectiles on straight line between source and target
		ad_offang = vectoangles ((self.enemy.origin-'0 0 24') - ad_org);
		ad_offang_y = ad_offang_y + ad_offset;
		makevectors (ad_offang);
	
		// Randomly spawn projectiles around central point
		ad_sorg = ad_org + v_up * (5 + random() * 10);
		
		// Straight line velocity from source to target
		ad_dir = normalize (v_forward);
		ad_dir_z = 0 - ad_dir_z + (random() - 0.5)*0.1;	// Slight wiggle up/down
		ad_avel = ad_vecrand(100,200,ad_FALSE);
		
		// Variable speed based on skill level with extra random spice
		self.ad_attack_speed = ad_SPEED_EIDOROCK + (ad_skill * ad_SPEED_EIDOSKILL) + random()*10;
		ad_Launch_Missile (ad_sorg, ad_dir, ad_avel, ad_CT_PROJ_EIDO1, self.ad_attack_speed );
		ad_offset = ad_offset + ad_foffset;
		ad_shotcount = ad_shotcount - 1;
	}
};

//----------------------------------------------------------------------
void(vector ad_rockofs, float ad_rockframe) ad_Setup_attackA =
{
	local vector ad_org;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_eidolon_create_attachment();
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_rockframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;

		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

		// Start throwing rock sound
		sound (self, ad_CHAN_WEAPON, "eidolon/attacka.wav", 1, ad_ATTN_NORM);
	}

	// Turn towards enemy and update model attachment
	// The offset is based on the Eidolon facing forward
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_rockofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.angles_x = random()*360;
	self.ad_attachment.frame = ad_rockframe;
	// Random explosion like particles from ball as it grows
	ad_particle_explode(self.ad_attachment.origin, 10+random()*10, 0.5+random(), ad_PARTICLE_BURST_WHITE, 0);
};

//----------------------------------------------------------------------
void() ad_eidolon_attackA2 = {
	// Do nothing if dead
	if (self.health < 0) return;

	self.nextthink = time + 0.05;
	
	// Keep moveing the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 19) self.think = self.ad_th_run;
	self.frame = $spell1 + self.ad_walkframe;
	
	// Keep turning towards the player
	if (self.frame < $spell14) ad_ai_face();
	
	// Check the state of the projectile (grow/fire)
	if (self.frame == $spell3) ad_eidolon_setup_attachment();
	else if (self.frame == $spell4) ad_Setup_attackA('60 18 64',0);
	else if (self.frame == $spell5) ad_Setup_attackA('62 18 68',1);
	else if (self.frame == $spell6) ad_Setup_attackA('64 18 72',2);
	else if (self.frame == $spell7) ad_Setup_attackA('68 18 78',3);
	else if (self.frame == $spell8) ad_Setup_attackA('72 18 86',4);
	else if (self.frame == $spell9) ad_Setup_attackA('74 18 96',5);
	else if (self.frame == $spell10) ad_Setup_attackA('70 18 104',6);
	else if (self.frame == $spell11) ad_Setup_attackA('72 18 112',7);
	else if (self.frame == $spell12) ad_Setup_attackA('73 18 112',7);
	else if (self.frame == $spell13) ad_Fire_attackA('73 18 112');
};

//----------------------------------------------------------------------
void() ad_eidolon_attackA1 = [ $spell1, ad_eidolon_attackA2 ] {ad_ai_face();
	self.ad_pain_finished = time + 1.5;
	self.ad_walkframe = 0;
};

