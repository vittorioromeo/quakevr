// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_tarbaby.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 Tarbaby, spawn, blue blob! (mostly annoying ... troll monster)
========================================================================*/

$frame walk1 walk2 walk3 walk4  walk5 walk6 walk7 walk8 walk9 walk10
$frame walk11 walk12 walk13 walk14 walk15 walk16 walk17 walk18 walk19
$frame walk20 walk21 walk22 walk23 walk24 walk25

$frame run1 run2 run3 run4 run5 run6  run7 run8 run9 run10 run11 run12 run13
$frame run14 run15 run16 run17 run18 run19 run20 run21 run22 run23
$frame run24 run25

$frame jump1 jump2 jump3 jump4 jump5 jump6

$frame fly1 fly2 fly3 fly4

$frame exp

// Return to death explosion
void() ad_tbaby_finaldeath;

//======================================================================
// A small looped idle animation using walk
//======================================================================
void() ad_tbaby_standframe =
{
	// Return to explosive death
	if (self.deadflag > ad_DEAD_NO) { ad_tbaby_finaldeath(); return; }
	
	// Keep looping
	if (self.ad_walkframe == 4 || self.ad_walkframe == 7)
		self.nextthink = 0.1 + random()*0.3;
	else self.nextthink = time + 0.1;
	self.think = ad_tbaby_standframe;
	
	// Reverse the stand idle frames (0,1,2,3,4,3,2,1)
	if (self.ad_walkframe < 5) self.frame = $walk1 + self.ad_walkframe;
	else self.frame = $walk1 + (7-self.ad_walkframe);
	self.ad_walkframe = self.ad_walkframe + 1;
	
	// Keep looping
	if (self.ad_walkframe >= 8) self.ad_walkframe = 0;
	ad_ai_stand();
}
//----------------------------------------------------------------------
void() ad_tbaby_stand1 = { self.ad_walkframe = 0; ad_tbaby_standframe(); }
// Can't find where this is being used, probably an old idea in id code
void() ad_tbaby_hang1 =[$walk1, ad_tbaby_hang1] {ad_ai_stand();};

//======================================================================
// The classic slow turning/walk animation
//======================================================================
void() ad_tbaby_walkframe =
{
	// Return to explosive death
	if (self.deadflag > ad_DEAD_NO) { ad_tbaby_finaldeath(); return; }
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_tbaby_walkframe;
	// The famous tarbaby wakeup sound!
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	// Keep moving forward in animation
	self.frame = $walk1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Odd way to do walking
	if (self.ad_walkframe < 11) ad_ai_turn();
	else ad_ai_walk(2);
	// Keep looking
	if (self.ad_walkframe >= 25) self.ad_walkframe = 0;
};
//----------------------------------------------------------------------
void() ad_tbaby_walk1 = { self.ad_walkframe = 0; ad_tbaby_walkframe(); }

//======================================================================
// Running like a snail!
//======================================================================
void() ad_tbaby_runframe = 
{
	// Return to explosive death
	if (self.deadflag > ad_DEAD_NO) { ad_tbaby_finaldeath(); return; }
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_tbaby_runframe;
	// Keep moving forward in animation
	self.frame = $run1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Turns as much as moving forward!
	if (self.ad_walkframe < 11) ad_ai_face();
	else ad_ai_run(2);
	// Keep looping
	if (self.ad_walkframe >= 25) self.ad_walkframe = 0;
};
//----------------------------------------------------------------------
void() ad_tbaby_run1 = { self.ad_walkframe = 0; ad_tbaby_runframe(); }

//======================================================================
// The crazy jump functionality of spawns!
//======================================================================
void()	ad_Tar_JumpTouch =
{
	local float ad_ldmg;
	// Return to explosive death
	if (self.deadflag > ad_DEAD_NO) { ad_tbaby_finaldeath(); return; }
	ad_ai_jumpbreakable(20);			// Damage any breakables

	if (other.takedamage && other.classname != self.classname) {
		if ( vlen(self.velocity) > 400 ) {
			ad_ldmg = 10 + 10*random();
			// Can only poison the player
			if (other.flags & ad_FL_CLIENT && self.ad_poisonous) {
				// Check if player is posioned already?
				if (other.ad_poisoned) ad_T_Damage (other, self, self, ad_ldmg * 0.25, ad_DAMARMOR);
				// Make sure player is posioned
				else ad_PoisonDeBuff(other);
			}
			// Everything else gets the usual tarbaby thump!
			else ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);
			sound (self, ad_CHAN_WEAPON, "blob/hit1.wav", 1, ad_ATTN_NORM);
		}
	}
	else sound (self, ad_CHAN_WEAPON, "blob/land1.wav", 1, ad_ATTN_NORM);

	// Is the tarbaby floating in the air?
	if (!checkbottom(self)) {
		// Is the tarbaby standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			self.touch = ad_SUB_Null;
			self.think = self.ad_th_run;
			self.movetype = ad_MOVETYPE_STEP;
			self.nextthink = time + 0.1;
		}
		return;	// not on ground yet
	}

	self.touch = ad_SUB_Null;
	if (self.spawnflags & ad_MON_TARBYLESSJUMP) {
		// RRP - Ijed (reduce constant jumping around like id version)
		// Skill percentage Easy 0% = never jump, Nightmare 60% = good chance
		if (random() > ad_skill / 5) self.think =  self.ad_th_run;
		else self.think = self.ad_th_jump;
	}
	// Original ID behaviour, constantly jump around like crazy
	else self.think = self.ad_th_jump;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_tbaby_fly1 =[$fly1, ad_tbaby_fly2] {};
void() ad_tbaby_fly2 =[$fly2, ad_tbaby_fly3] {};
void() ad_tbaby_fly3 =[$fly3, ad_tbaby_fly4] {};
void() ad_tbaby_fly4 =[$fly4, ad_tbaby_fly1] { 
	self.cnt = self.cnt + 1;
	if (self.cnt == 4) self.ad_th_jumpexit();
};

//----------------------------------------------------------------------
void() ad_tbaby_jump1 =[$jump1, ad_tbaby_jump2] {ad_ai_face();};
void() ad_tbaby_jump2 =[$jump2, ad_tbaby_jump3] {ad_ai_face();};
void() ad_tbaby_jump3 =[$jump3, ad_tbaby_jump4] {ad_ai_face();};
void() ad_tbaby_jump4 =[$jump4, ad_tbaby_jump5] {ad_ai_face();};
void() ad_tbaby_jump5 =[$jump5, ad_tbaby_jump6]
{	
	self.movetype = ad_MOVETYPE_BOUNCE;
	self.touch = ad_Tar_JumpTouch;
	makevectors (self.angles);
	self.origin_z = self.origin_z + 1;
	self.velocity = v_forward * 600 + '0 0 200';
	self.velocity_z = self.velocity_z + random()*150;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.cnt = 0;
};
void() ad_tbaby_jump6 =[$jump6, ad_tbaby_fly1] {};

//======================================================================
// There is no pain animation, just the chance of pain sounds
//======================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_tbaby_pain =
{
	// Return to explosive death
	if (self.deadflag > ad_DEAD_NO) { ad_tbaby_finaldeath(); return; }
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	}
};

//======================================================================
// Death of the Tarbaby!
//======================================================================
void() ad_tbaby_finished = { 
	// Can drop health packs! - randomizer
	if (self.healamount > 0) ad_DropHealthpack();
	// Hide monster
	ad_entity_hide(self);
};
//----------------------------------------------------------------------
// The final insult, exploding death!
//----------------------------------------------------------------------
void() ad_tbaby_explode =
{
	self.deadflag = ad_DEAD_FINISHED;
	// Tarbabies explode when they die
	ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);

	sound (self, ad_CHAN_BODY, self.ad_death_sound, 1, ad_ATTN_NORM);
	self.origin = self.origin - 8*normalize(self.velocity);

	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_TAREXPLOSION);	// Hard coded explosion
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	
	// Sprite explosion for Fitz engines
	// Check for DP particle system as visuals is done with TE_TAREXPLOSION
	if (!ad_ext_dppart) ad_SpawnExplosion(ad_EXPLODE_SMALL, self.origin, ad_SOUND_REXP3);
	else sound(self, ad_CHAN_WEAPON, ad_SOUND_REXP3, 1, ad_ATTN_NORM);
	
	// Hide monster
	ad_tbaby_finished();
};
//----------------------------------------------------------------------
// Waiting 1 frame to explode!
//----------------------------------------------------------------------
void() ad_tbaby_die1 =
{ 
	self.deadflag = ad_DEAD_EXPLODE;
	self.takedamage = ad_DAMAGE_NO;
	self.frame = $exp;
	self.think = ad_tbaby_explode;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// The tarbaby has 1 frame delay before exploding and it can cause
// problems with all the functions. This is to make sure everything
// returns to the part of the death journey of the spawn!
//----------------------------------------------------------------------
void() ad_tbaby_finaldeath =
{
	// Check death states
	if (self.deadflag == ad_DEAD_DEAD) ad_tbaby_die1();
	else if (self.deadflag == ad_DEAD_EXPLODE) ad_tbaby_explode();
	// Finally Remove die
	else ad_tbaby_finished();
};

//----------------------------------------------------------------------
// Classic death function
//----------------------------------------------------------------------
void() ad_tbaby_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	// Start death explosion
	ad_tbaby_finaldeath();
};

//======================================================================
//QUAKED monster_tarbaby (1 0 0) (-16 -16 -24) (16 16 24) Ambush x Lessjump
//======================================================================
void() ad_monster_tarbaby =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_tarbaby.mdl";
	self.ad_headmdl = ad_string_null;
	precache_model (self.mdl);

	self.ad_idle_sound = "blob/sight1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_sound = self.ad_idle_sound;
	self.ad_pain_sound = self.ad_idle_sound;

	self.ad_death_sound = "blob/death1.wav";
	precache_sound (self.ad_death_sound);
	
	precache_sound ("blob/hit1.wav");
	precache_sound ("blob/land1.wav");
	
	// The randomizer drops health packs on death
	if (self.healamount > 0) ad_CacheHealthpacks();
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = ad_HP_MONTARBABY;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 20;
	self.ad_deathstring = " was slimed by a Spawn\n";
	
	// Allow for extra functionality (death damage and poison)
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_TARBABY;
	if (self.ad_poisonous < 1) self.ad_poisonous = ad_FALSE;
	else { self.ad_poisonous = ad_TRUE; self.ad_exactskin = 2; }

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_SpawnCheckAttack;
	self.ad_th_stand = ad_tbaby_stand1;
	self.ad_th_walk = ad_tbaby_walk1;
	self.ad_th_run = ad_tbaby_run1;
	self.ad_th_jump = ad_tbaby_jump1;
	self.ad_th_jumpexit = ad_tbaby_jump5;
	self.ad_th_melee = ad_tbaby_jump1;
	self.ad_th_pain = ad_tbaby_pain;
	self.ad_th_die = ad_tbaby_die;
	
	self.ad_classtype = ad_CT_MONSPAWN;
	self.ad_classgroup = ad_CG_SPAWN;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	// Delay spawn randomized tarbabies a couple of frame
	// To avoid telefrags issues of bad placement of HP packs
	if (self.ad_randomized > 0) {
		self.nextthink = time + 0.1 + (random()*0.2);
		self.think = ad_monster_start;
	}
	else ad_monster_start();
};