//----------------------------------------------------------------------
void() ad_hogre_melee =
{
	self.lip = random();
	if (self.lip < 0.2 && ad_skill > ad_SKILL_NORMAL) ad_hogre_thrust1();
	else if (self.lip < 0.4) ad_hogre_smash1();
	else ad_hogre_swing1();
};

