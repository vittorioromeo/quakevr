void()	ad_hogre_dieA6	=[	$deathA6,	ad_hogre_dieA7	] {ad_ai_forward(1);};
void()	ad_hogre_dieA7	=[	$deathA7,	ad_hogre_dieA8	] {};
void()	ad_hogre_dieA8	=[	$deathA8,	ad_hogre_dieA9	] {ad_hogre_sound(3);};	// Chainsaw hits floor
void()	ad_hogre_dieA9	=[	$deathA9,	ad_hogre_dieA10] {ad_monster_death_postcheck();};
void()	ad_hogre_dieA10=[	$deathA10,	ad_hogre_dieA10] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
// (166 - 179) deathB (Backward)
//----------------------------------------------------------------------
void()	ad_hogre_dieB1	=[	$deathB1,	ad_hogre_dieB2	] {ad_ai_back(4);};
void()	ad_hogre_dieB2	=[	$deathB2,	ad_hogre_dieB3	] {ad_monster_check_gib();ad_ai_back(10);};
void()	ad_hogre_dieB3	=[	$deathB3,	ad_hogre_dieB4	] {ad_monster_check_gib();ad_ai_back(3);
	self.solid = ad_SOLID_NOT; if (!self.ad_gibbed) ad_DropBackpack(); };
void()	ad_hogre_dieB4	=[	$deathB4,	ad_hogre_dieB5	] {ad_ai_back(1);};
void()	ad_hogre_dieB5	=[	$deathB5,	ad_hogre_dieB6	] {};
void()	ad_hogre_dieB6	=[	$deathB6,	ad_hogre_dieB7	] {};
void()	ad_hogre_dieB7	=[	$deathB7,	ad_hogre_dieB8	] {ad_ai_back(1);};
void()	ad_hogre_dieB8	=[	$deathB8,	ad_hogre_dieB9	] {ad_ai_back(1);};
void()	ad_hogre_dieB9	=[	$deathB9,	ad_hogre_dieB10] {ad_hogre_sound(3);};	// Chainsaw
void()	ad_hogre_dieB10=[	$deathB10,	ad_hogre_dieB11] {};
void()	ad_hogre_dieB11=[	$deathB11,	ad_hogre_dieB12] {};
void()	ad_hogre_dieB12=[	$deathB12,	ad_hogre_dieB13] {};
void()	ad_hogre_dieB13=[	$deathB13,	ad_hogre_dieB14] {ad_monster_death_postcheck();};
void()	ad_hogre_dieB14=[	$deathB14,	ad_hogre_dieB14] {ad_monster_deadbody_check();};

//======================================================================
void() ad_hogre_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		self.lip = random();
		if (self.lip < 0.05) ad_hogre_dieS1();
		else if (self.lip < 0.5) ad_hogre_dieA1();
		else ad_hogre_dieB1();
	}
};

//============================================================================
void(float ad_soundtype) ad_hogre_sound =
{
	if (ad_soundtype == 1) sound (self, ad_CHAN_VOICE, "ogre/ogdrag.wav", 1, ad_ATTN_IDLE);
	else if (ad_soundtype == 2) sound (self, ad_CHAN_WEAPON, "ogre/ogsawatk.wav", 1, ad_ATTN_NORM);
	else if (ad_soundtype == 3) sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_WOOD, 1, ad_ATTN_NORM);
	else if (ad_soundtype == 4) sound (self, ad_CHAN_WEAPON, "ogre/ogleap.wav", 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
// Special wakeup animation for attacking/breaking something infront
// The monster should be setup facing the right direction before call
// Starts in large overhead swing downwards (no damage checks)
//----------------------------------------------------------------------
void() ad_hogre_wakeup1a	=[	$smash7,	ad_hogre_wakeup2a ] {ad_monster_sightsound();};
void() ad_hogre_wakeup2a	=[	$smash6,	ad_hogre_wakeup3a ] {};
void() ad_hogre_wakeup3a	=[	$smash8,	ad_hogre_wakeup4a ] {};
void() ad_hogre_wakeup4a	=[	$smash9,	ad_hogre_wakeup5a ] {};
void() ad_hogre_wakeup5a	=[	$smash10,	ad_hogre_wakeup6a ] {};
void() ad_hogre_wakeup6a	=[	$smash11,	ad_hogre_wakeup7a ] {};
void() ad_hogre_wakeup7a	=[	$smash12,	ad_hogre_wakeup8a ] {};
void() ad_hogre_wakeup8a	=[	$smash13,	ad_hogre_wakeup9a ] {};
void() ad_hogre_wakeup9a	=[	$smash14,	ad_hogre_run1	] {};

void() ad_hogre_wakeup1b	=[	$thrust7,	ad_hogre_wakeup2b ] {ad_monster_sightsound();};
void() ad_hogre_wakeup2b	=[	$thrust6,	ad_hogre_wakeup3b ] {};
void() ad_hogre_wakeup3b	=[	$thrust8,	ad_hogre_wakeup4b ] {};
void() ad_hogre_wakeup4b	=[	$thrust9,	ad_hogre_wakeup5b ] {};
void() ad_hogre_wakeup5b	=[	$thrust10,	ad_hogre_wakeup6b ] {};
void() ad_hogre_wakeup6b	=[	$thrust11,	ad_hogre_wakeup7b ] {};
void() ad_hogre_wakeup7b	=[	$thrust12,	ad_hogre_wakeup8b ] {};
void() ad_hogre_wakeup8b	=[	$thrust13,	ad_hogre_wakeup9b ] {};
void() ad_hogre_wakeup9b	=[	$thrust14,	ad_hogre_run1	] {};

void() ad_hogre_wakeup1 = {
	if (random() < 0.7) ad_hogre_wakeup1a();	// More over head swing than thrust
	else ad_hogre_wakeup1b();
};

//======================================================================
/*ad:QUAKED monster_hogre (0.5 0.75 0) (-32 -32 -24) (32 32 64) AMBUSH x METAL NOSIGHT NOIDLE NOGFX STARTOFF ANGRY Not_Easy Not_Normal Not_Hard Not_DM
{ model(":progs/mon_hogre.mdl"); }
Ogre, 200 health points.
-------- KEYS --------
-------- SPAWNFLAGS --------
METAL : Chain mail metal armour and +100HP
-------- NOTES --------

======================================================================*/
void() ad_monster_hogre =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_hogre.mdl";			// New Ogre Model
	self.ad_headmdl = "progs/h_hogre.mdl";
	self.ad_gib1mdl = "progs/w_chainsaw.mdl";		// Chainsaw
	self.ad_gib2mdl = "progs/gib_ogfoot1.mdl";		// Left foot
	self.ad_gib3mdl = "progs/gib_ogfoot2.mdl";		// Right foot
	self.ad_gib4mdl = "progs/w_ogregl.mdl";		// Grenade Launcher

	precache_model ("progs/ogre.mdl");			// Precache for upgrade
	precache_model ("progs/h_ogre.mdl");		// Load/Quickload need this
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_GRENADE);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);

	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	// Random chance to switch GL for chainsaw
	if (random() < 0.5) self.ad_gib1mdl = self.ad_gib4mdl;
	self.ad_gib4mdl = "";

	self.ad_idle_sound = "ogre/ogidle.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_idle_soundcom = "ogre/ogidle2.wav";
	precache_sound (self.ad_idle_soundcom);

	precache_sound ("ogre/ogdrag.wav");		// Chainsaw scrap on floor sound
	self.ad_death_sound = "ogre/ogdth.wav";
	precache_sound (self.ad_death_sound);		// Death sound
	self.ad_pain_sound = "ogre/ogpain1.wav";
	precache_sound (self.ad_pain_sound);		// Pain
	
	precache_sound ("ogre/ogsawatk.wav");	// Attack
	precache_sound ("ogre/ogleap.wav");		// Leap Attack

	self.ad_sight_sound = "ogre/ogwake.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	self.ad_gibhealth = -80;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 30;
	self.ad_pain_longanim = ad_TRUE;
	self.ad_steptype = ad_FS_TYPESLOW;
	self.ad_attack_explosive = ad_TRUE;		// Has explosive attack
	self.ad_meleerange = ad_MONAI_MELEEOGRE;	// Chainsaw range
	self.ad_deathstring = " was blown up by an Ogre Hunter\n";
	
	// Standard ogre health 200 with metal+ option
	if (self.health < 1) self.health = 200;
	if (self.spawnflags & ad_MON_HOGRE_METAL) {
		self.health = self.health + ad_MON_HOGRE_METUPG;
		self.skin = 1;
	}

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_GRENADEGRN);
	}

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_OgreCheckAttack;
	self.ad_th_stand = ad_hogre_stand1;
	self.ad_th_walk = ad_hogre_walk1;
	self.ad_th_run = ad_hogre_run1;
	self.ad_th_die = ad_hogre_die;
	self.ad_th_melee = ad_hogre_melee;
	self.ad_th_missile = ad_hogre_shoot1;
	self.ad_th_pain = ad_hogre_pain;
	self.ad_th_wakeup = ad_hogre_wakeup1;
	
	if (self.ammo_rockets < 0) self.ammo_rockets = 0;
	else if (self.ammo_rockets == 0) self.ammo_rockets = 2;
	self.ad_classtype = ad_CT_MONHOGRE;		// new style hunter ogre
	self.ad_classgroup = ad_CG_OGRE;			// One big happy ogre family!
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
};
