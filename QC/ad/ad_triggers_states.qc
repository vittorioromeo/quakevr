// AD's readme and docs/vr-port/CREDITS.md), my_progs/triggers_states.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// TRIGGER STATE FUNCTIONS
//======================================================================

float ad_TRIG_NOTOUCH = 1;		// Touch functionality is disabled
							// Will need special setup to avoid this!
							// Active in the delay/restore functions

float ad_TRIG_DEVMODE = 4;		// Will only trigger in dev model
							// Only affects trigger_ONCE & _MULTIPLE

float ad_TRIG_INVIEW = 8;		// player has to see trigger
							// Only affects trigger_ONCE

float ad_TRIG_MODCHECK = 16;	// Will remove entity if mod version wrong
							// Only affects trigger_ONCE, _MULTIPLE & _HURT
							// Is checked before any trigger is spawned
							// into the map

float ad_TRIG_MONSTERS = 32;	// Can be touched/triggered by monsters
							// Used by many triggers to prevent monster use.
							// Will need special setup to avoid this!
							// Used in trigger_bmodel_touch function ONLY

// float ENT_STARTOFF = 64;	// Global spawnflags setting

// Added by functions, no map entity interaction
float ad_TRIG_NODAMAGE = 16384;	// Block trigger damage functionality
float ad_TRIG_ALWAYTOUCH = 32768;	// Always allow touch function to exist

//----------------------------------------------------------------------
void(float ad_defvol) ad_trigger_bmodel_volume =
{
	// Volume has to be within range of 0-1, otherwise engine errors
	if (self.volume == 0) self.volume = ad_defvol;	// Default
	else if (self.volume < 0) self.volume = 0;	// Out of range
	else if (self.volume > 1) self.volume = 1;	// Out of range
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_sounds =
{
	// Used by lots of different triggers for standard sounds
	if (self.sounds == 1) self.noise = "misc/secret.wav";
	else if (self.sounds == 2) self.noise = ad_SOUND_TALK;
	else if (self.sounds == 3) self.noise = "misc/trigger1.wav";
	else if (self.sounds == 4) self.noise = ad_SOUND_EMPTY;
	else if (self.sounds == 6) self.noise = "misc/secret3.wav";
	// precache any sounds that have been defined
	if (self.noise != "") precache_sound(self.noise);
	// setup default volume (entity key override)
	ad_trigger_bmodel_volume(1);
};

//----------------------------------------------------------------------
// Special sight trigger, Is the player *looking* at this trigger
// This sight trigger cannot be disabled or turned off atm
//----------------------------------------------------------------------
void() ad_trigger_bmodel_inview =
{
	local entity ad_client, ad_tself;
	local float ad_play_dist, ad_play_range, ad_play_angle;

	// Is the trigger blocked? (trigger_once)
	if (self.ad_attack_finished > time) return;
	
	// Checkclient needs an proper entity origin, bmodels are '0 0 0'
	// Create a temporary entity to switch around too for checkclient
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.oldorigin = ad_bmodel_origin(self);
		setorigin(self.ad_attachment, self.oldorigin);
	}
	
	// Swap around self/attachment so checkclient can work properly
	ad_tself = self; self = self.ad_attachment;
	ad_client = checkclient ();		// Find a client in current PVS
	self = ad_tself;
	
	// Found a player to check sight/distance for?
	if (ad_client.flags & ad_FL_CLIENT) {
		if (ad_visxray(ad_client, ad_VEC_ORIGIN, ad_VEC_ORIGIN, ad_FALSE)) {
			// Work out vector length between entity and player	
			ad_play_dist = vlen(self.oldorigin - ad_client.origin);
			// Is there a distance check active? if not make sure it will pass
			if (!self.t_length) ad_play_range = ad_play_dist + 1;
			else ad_play_range = self.t_length;
			
			// The angle the player is facing towards the trigger (45 = forward)
			ad_play_angle = ad_viewangle(self.oldorigin, ad_client.origin, 45, ad_TRUE, ad_client.v_angle_y);
		
			// Check distance is correct and facing angle focused
			if (ad_play_dist < ad_play_range && ad_play_angle > 30 && ad_play_angle < 60) {
				self.wait = -1;
				self.ad_bmodel_act = ad_activator;
				self.ad_estate_fire();
				return;
			}
		}
	}

	// Keep checking, 0.1 standard entity timing
	self.nextthink = time + 0.1;
	self.think = ad_trigger_bmodel_inview;
};

//----------------------------------------------------------------------
//  the trigger was just touched/killed/used
//  self.bmodel_act should be set to the activator so it can be held 
//  through a delay so wait for the delay time before firing
//----------------------------------------------------------------------
void() ad_trigger_bmodel_fire =
{
	// Is the trigger blocked? (trigger_once)
	if (self.ad_attack_finished > time) return;
	
	// Check for developer mode only triggers
	if (self.spawnflags & ad_TRIG_DEVMODE && ad_developer == 0) {
		// This feature only work for ONCE/MULTIPLE triggers
		if (self.ad_classtype == ad_CT_TRIGONCE || 
			self.ad_classtype == ad_CT_TRIGMULTI) return;
	}
	
	//----------------------------------------------------------------------
	// The Shotgun and Axe upgrades can make maps too easy, allow for
	// triggers to not fire if the key is TRUE and inventory empty
	// Was planning to remove this feature with AD 1.8 codebase
	// Howver it seems someone did use it! - ad_magna
	//----------------------------------------------------------------------
	if ( self.ad_bmodel_act.flags & ad_FL_CLIENT ) {
		if (self.ad_upgrade_axe && !VR_AD_HasUpgrade(self.ad_bmodel_act, ad_IT_UPGRADE_AXE)) return;
		if (self.ad_upgrade_ssg && !VR_AD_HasUpgrade(self.ad_bmodel_act, ad_IT_UPGRADE_SSG)) return;
		if (self.ad_upgrade_lg && !VR_AD_HasUpgrade(self.ad_bmodel_act, ad_IT_UPGRADE_LG)) return;
	}
	
	// Trigger secrets only work for players
	if (self.ad_classtype == ad_CT_TRIGSECRET) {
		// If trigger_secret has NOTOUCH then check activator
		if (!(self.ad_bmodel_act.flags & ad_FL_CLIENT)) return;
		// The trigger can be reset, so double check
		if (self.count > 0) {
			found_secrets = found_secrets + self.count;
			WriteByte (ad_MSG_ALL, ad_SVC_FOUNDSECRET);
			self.count = 0;	// Secrets only work once
		}
	}
	// Switch off ability for trigger_mulitiple ONLY
	else if (self.ad_classtype == ad_CT_TRIGMULTI && self.count > 0) {
		self.count = self.count - 1;
		if (self.count <= 0) self.wait = -1;
	}

	// Play the sound ON the trigger, NOT the activator
	if (self.noise != "") sound (self, ad_CHAN_VOICE, self.noise, self.volume, ad_ATTN_NORM);

	//----------------------------------------------------------------------
	// One of the downside to trigger_multi and trigger_once is that they
	// reset the activator global variable each time they are used.
	// This can causes problems with triggers that require client references
	// for centerprint/sound cues (like trigger_secret)
	// The way to get around this problem is to use trigger_relay as this does
	// not change the activator variable
	//
	ad_activator = self.ad_bmodel_act;
	ad_SUB_UseTargets();

	// Is the trigger repeatable?
	if (self.wait > 0) {
		// Double check trigger is turned on!?!
		// The sequence and timing for QC is not always perfect
		// Always check stuff before resetting think/nextthink
		if (self.ad_estate & ad_ESTATE_BLOCK) return;
		// Setup a re-trigger event
		self.ad_attack_finished = time + self.wait;
		self.nextthink = self.ad_attack_finished;
		self.think = self.ad_estate_on;
	}
	else {
		// TRIGGER_ONCE functionality
		self.ad_attack_finished = time + ad_LARGE_TIMER;
		self.ad_estate_off();
	}
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_use =
{
	// There is no client test here because this can come from
	// multiple entity types, the activator is passed on
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	self.ad_bmodel_act = ad_activator;
	self.ad_estate_fire();
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_touch =
{
	// This is a client touch event, triggers that require
	// other entity types need to have their own touch event
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	if ( !(self.spawnflags & ad_TRIG_MONSTERS) && !(other.flags & ad_FL_CLIENT) ) return;
	
	// Check for any target entity tracking
	ad_TargetMovedir(self, ad_FALSE);
	
	// Did the trigger have an angle key setup?
	if (!ad_CheckZeroVector(self.movedir)) {
		makevectors (other.angles);
		if (v_forward * self.movedir < 0) return;		
	}
	self.ad_bmodel_act = other;
	self.ad_estate_fire();
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_anytouch =
{
	// This will allow anything to touch it
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	self.ad_bmodel_act = other;
	self.ad_estate_fire();
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_killed =
{
	// The proto button setup of triggers using health
	// Always reset health regardless if blocked or not
	self.health = self.max_health;
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	self.takedamage = ad_DAMAGE_NO;
	self.ad_bmodel_act = ad_damage_attacker; 
	self.ad_estate_fire();
};

//----------------------------------------------------------------------
// Setup touch/damage/bounding box functionality
//----------------------------------------------------------------------
void() ad_trigger_bmodel_restore =
{
	// Damage functionality
	if (self.max_health > 0 && !(self.spawnflags & ad_TRIG_NODAMAGE) ) {
		self.health = self.max_health;
		self.takedamage = ad_DAMAGE_YES;
		self.solid = ad_SOLID_BBOX;
	}
	// The extra option (ALWAYSTOUCH) was added because some triggers
	// have re-used spawnflag 1 for other purposes and they still need
	// touch founctionality
	else if ( !(self.spawnflags & ad_TRIG_NOTOUCH) || self.spawnflags & ad_TRIG_ALWAYTOUCH)
		self.solid = ad_SOLID_TRIGGER;
	// Turn off touch functionality
	else self.solid = ad_SOLID_NOT;

	// Restore bounding box (dev testing visual thing)
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);

	// Check for spawning conditions (nightmare, coop)
	// Needs to exist after entity has been added to work for BSPorigin
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_delay =
{
	if (self.ad_estate == ad_ESTATE_DISABLE) return;
	
	// Remove the START OFF functionality
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_ENT_STARTOFF);

	// Reset USE and trigger_once conditions
	self.ad_estate_use = ad_trigger_bmodel_use;
	self.ad_attack_finished = 0;
	self.ad_estate = ad_ESTATE_ON;

	// Check if the player needs to be inview before triggering?
	// It would be weird to have this on multiple/secret triggers
	if (self.ad_classtype == ad_CT_TRIGONCE && self.spawnflags & ad_TRIG_INVIEW) {
		// Restore bounding box (dev testing visual thing)
		setsize (self, self.ad_bbmins, self.ad_bbmaxs);
		// Inview triggers are not touchable and cannot be damaged
		self.spawnflags = self.spawnflags | ad_TRIG_NOTOUCH | ad_TRIG_NODAMAGE;
		self.ad_estate_use = ad_trigger_bmodel_inview;
		self.ad_estate_use();
		return;
	}
	
	//----------------------------------------------------------------------
	// I would have never of guessed this was used throughout the original
	// ID maps and there are countless cases of trigger_multiple entities
	// being used like buttons that can be damaged but not touched.
	// I get the impression this was a prototype stage of development where
	// everyone was waiting for func_button functionality to come online.
	//
	if (self.health && !(self.spawnflags & ad_TRIG_NODAMAGE)) {
		self.max_health = self.health;			// save health for later
		self.ad_th_die = ad_trigger_bmodel_killed;	// damage trigger
	}
	else {
		// Setup touch functionality
		if ( !(self.spawnflags & ad_TRIG_NOTOUCH) || self.spawnflags & ad_TRIG_ALWAYTOUCH) {
			if (!self.touch) self.touch = ad_trigger_bmodel_touch;
		}
	}
	
	// Setup touch/damage/bounding box functionality
	ad_trigger_bmodel_restore();
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_on =
{
	self.ad_estate = ad_ESTATE_ON;
	self.movetype = ad_MOVETYPE_NONE;

	// Check for delayed/trigger_once functionality?
	if (self.spawnflags & ad_ENT_STARTOFF || self.ad_attack_finished > time)
		self.solid = ad_SOLID_NOT;
	else {
		// Setup touch/damage/bounding box functionality
		ad_trigger_bmodel_restore();
	}
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_off =
{
	self.oldorigin = ad_bmodel_origin(self);
	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	self.ad_estate_disable();
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_disable =
{
	// Shutdown trigger completely
	self.takedamage = ad_DAMAGE_NO;
	self.think = ad_SUB_Null;
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_reset =
{
	// Reset trigger_once conditions
	self.ad_attack_finished = 0;
	self.ad_estate_on();
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_default =
{
	self.ad_classgroup = ad_CG_TRIGGERS;
	self.ad_estate_on = ad_trigger_bmodel_on;
	self.ad_estate_off = ad_trigger_bmodel_off;
	if (!self.ad_estate_fire) self.ad_estate_fire = ad_trigger_bmodel_fire;
	self.ad_estate_disable = ad_trigger_bmodel_disable;
	self.ad_estate_reset = ad_trigger_bmodel_reset;
	self.ad_estate = ad_ESTATE_ON;
	// setup default sound volume
	ad_trigger_bmodel_volume(1);
};

//----------------------------------------------------------------------
void() ad_trigger_bmodel_setup =
{
	ad_trigger_bmodel_default();
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_use = ad_trigger_bmodel_delay;

	if (self.spawnflags & ad_ENT_STARTOFF) {
		self.ad_estate_use = ad_trigger_bmodel_delay;
		self.ad_estate_on = ad_trigger_bmodel_delay;
		self.ad_estate_off();
	}
	// The original functionality of the trigger is to pass through
	else self.ad_estate_use();
};

//======================================================================
// Check for bmodel errors, model key empty (can crash engine)
//----------------------------------------------------------------------
float() ad_check_bmodel_keys =
{
	if (self.model == "") {
		// this error can be fatal for most engines, show warning
		dprint ("\b[BMODEL]\b "); dprint (self.classname);
		dprint (" ("); dprint (self.targetname);
		dprint (") missing MODEL key!\n");
		
		self.ad_classtype = ad_CT_DEVMARKER;		// Useless entity
		self.movetype = ad_MOVETYPE_NONE;		// Stationary
		self.solid = ad_SOLID_NOT;				// no world interaction
		
		// If developer active show yellow diamond
		if (ad_developer > 0) setmodel(self, ad_MODEL_BROKEN);
		else setmodel(self,"");
		
		// Make sure no world interaction
		setsize (self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		
		// Randomly place debug diamond above 0,0,0
		self.pos1 = '0 0 0';
		self.pos1_z = random()*64;
		setorigin(self, self.pos1);
		
		// Do nothing with this entity
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
float() ad_check_bmodel_notouch =
{
	// Cannot have a no touch AND no targetname setup!!!
	if (self.spawnflags & ad_TRIG_NOTOUCH && self.targetname == "" && self.health < 1) {
		dprint("\b[TRIGGER]\b NO touch + NO targetname!\n");
		setmodel (self, self.model);
		self.oldorigin = ad_bmodel_origin(self);
		ad_spawn_marker(self.oldorigin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return ad_TRUE;
	}
	else return ad_FALSE;
	
};

//----------------------------------------------------------------------
// Check if the right mod version is active
// return TRUE = delete trigger, everything ok, >= active version
// return FALSE = error, show trigger message, < active version
//----------------------------------------------------------------------
float() ad_check_bmodel_modver =
{
	// Is the trigger suppose to block/check the mod?
	if (self.spawnflags & ad_TRIG_MODCHECK) {
		// Is the mod ver/patch/beta check set to zero?
		// - no version check, then return TRUE (delete this trigger)
		if (ad_CheckZeroVector(self.ad_modver_check)) {
			ad_entity_hide(self);
			return ad_TRUE;
		}
		else {
			dprint("Test ("); dprint(vtos(self.ad_modver_check));
			dprint(") Mod ("); dprint(ftos(ad_mod_version));
			dprint(") Patch ("); dprint(ftos(ad_mod_patch));
			dprint(") Beta ("); dprint(ftos(ad_mod_beta));
			dprint(")\n");
			// Is the trigger version/patch number correct?
			if (self.ad_modver_check_x > ad_mod_version) return ad_FALSE;
			else if (self.ad_modver_check_y > ad_mod_patch) return ad_FALSE;
			else if (self.ad_modver_check_z > ad_mod_beta) return ad_FALSE;
			// Trigger no longer needed, current version is right
			else { ad_entity_hide(self); return ad_TRUE; }
		}
	}
	// AD MOD is not active, keep the trigger
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Re-direction for map hacks (not used normally)
//----------------------------------------------------------------------
void() ad_multi_trigger = { 
	ad_trigger_bmodel_default();
	ad_trigger_bmodel_fire();
};
void() ad_multi_killed = { 
	ad_trigger_bmodel_default();
	ad_trigger_bmodel_killed();
};
void() ad_multi_use = {
	ad_trigger_bmodel_default();
	ad_trigger_bmodel_use();
};
void() ad_multi_touch = {
	ad_trigger_bmodel_default();
	ad_trigger_bmodel_touch();
};
void() ad_multi_wait = {
	if (self.max_health) {
		self.health = self.max_health;
		self.takedamage = ad_DAMAGE_YES;
		self.solid = ad_SOLID_BBOX;
	}
};
