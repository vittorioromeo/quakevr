// AD's readme and docs/vr-port/CREDITS.md), my_progs/ai_checkattack.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 SPECIFIC AI LOGIC ROUTINES

 * Specific routines for certain monster types to determine if
   they can melee or missile (range) attack
 * Always working 1 frame behind the ai_run function
 * Moved demon/wizard checkattack routines here (split locations)
 
 CheckAttack (generic)
======================================================================*/
void() ad_CheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
		
	//----------------------------------------------------------------------
	// Melee attack
	// enemy_range is checked before this function (ai_run - ai.qc)
	// If the monster is within melee range they instantly attack
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE) && self.ad_th_melee) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0 && self.ad_th_missile) {
		if (time < self.ad_attack_finished) return;
		ad_SUB_AttackFinished (2 + random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack
	// The attack chance percentages are constant across skill levels
	//----------------------------------------------------------------------
	if (!self.ad_th_missile) return;
	if (time < self.ad_attack_finished) return;
	if (ad_enemy_range == ad_RANGE_FAR) return;

	// range < 120 map units
	if (ad_enemy_range == ad_RANGE_MELEE) {
		self.ad_attack_chance = 0.9;
		self.ad_attack_finished = 0;
	}
	// range < 500 map units
	else if (ad_enemy_range == ad_RANGE_NEAR) {
		if (self.ad_th_melee) self.ad_attack_chance = 0.2;
		else self.ad_attack_chance = 0.4;
	}
	// range < 1000 map units
	else if (ad_enemy_range == ad_RANGE_MID) {
		if (self.ad_th_melee) self.ad_attack_chance = 0.05;
		else self.ad_attack_chance = 0.1;
	}
	else self.ad_attack_chance = 0;

	if (random () < self.ad_attack_chance) {
		ad_SUB_AttackFinished (2*random());
		self.ad_th_missile ();
	}
};

/*======================================================================
 SoldierCheckAttack (Rocket version has melee)
======================================================================*/
void() ad_SoldierCheckAttack =
{
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (2 + random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// If enemy is within melee range, just keep on attacking!
	// Original ID behaviour is 10% chance to not attack in melee range
	// This has changed so that the soldier is more agressive up close
	// The army rocket has a special behaviour for melee range
	//----------------------------------------------------------------------
	if (self.ad_classtype != ad_CT_MONARMYROCKET && ad_enemy_range == ad_RANGE_MELEE) {
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}	
	
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
	if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) return;

	if (self.ad_classtype == ad_CT_MONARMYROCKET) {
		if (ad_ai_checkmelee(ad_MONAI_RANGEARMYR,ad_FALSE)) {
			self.oldorigin = self.origin;
			// If move backward works, run back animation
			if (ad_walkmove(self.angles_y+180, 16)) {
				setorigin(self, self.oldorigin);
				self.ad_attack_state = ad_AS_MELEE;
				if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
				return;
			}
			else setorigin(self, self.oldorigin);
		}
	}
	
	//----------------------------------------------------------------------
	// Range attack (bullets)
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	if (ad_enemy_range == ad_RANGE_FAR) return;	
	if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
	else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.4;	// range < 500 map units
	else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.05;	// range < 1000 map units
	else self.ad_attack_chance = 0;
	if (random () < self.ad_attack_chance) {
		self.ad_attack_state = ad_AS_MISSILE;
		if (self.ad_classtype == ad_CT_MONARMYROCKET) ad_SUB_AttackFinished (2 + random());
		else ad_SUB_AttackFinished (1 + random());
		if (random() < 0.3) self.lefty = !self.lefty;
	}
};

/*======================================================================
 PyrpCheckAttack (Melee=FIRE!)
======================================================================*/
void() ad_PyroCheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	if (ad_ai_checkmelee(ad_MONAI_RANGEPYRO,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
};

/*======================================================================
 ShamCheckAttack
======================================================================*/
void() ad_ShamCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack(claws/overhead smash)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEESHAM,ad_MONAI_MELEEZTALL)) {
		self.ad_attack_state = ad_AS_MELEE;
		// Don't wait for next frame, melee attack straight away 
		// (different id behaviour)
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}

	//----------------------------------------------------------------------
	// Range attack (lightning)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	if (self.ad_enemydist > ad_MONAI_SHAMRANGE && !self.ad_attack_sniper) return;

	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	ad_SUB_AttackFinished (2 + (2*random()));
	self.ad_attack_state = ad_AS_MISSILE;
};

/*======================================================================
 GugCheckAttack
======================================================================*/
void() ad_GugCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack(left/right smack)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEGUG,ad_MONAI_MELEEZTALL)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack (Bile Bombs)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
};

/*======================================================================
 BogLordCheckAttack (Shambler model)
======================================================================*/
void() ad_BogLordCheckAttack =
{
	//----------------------------------------------------------------------
	// Special attack setup (more aggressive)
	//----------------------------------------------------------------------
	if (self.ad_attack_rage > 0) {
		// Can the monster attack and see the enemy?
		// There is no intelligent sight check, its just rage!
		if (time > self.ad_attack_finished && ad_enemy_vis) {
			if (self.ad_attack_rage > random()) {
				self.ad_attack_state = ad_AS_MELEE; if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
			}
			else self.ad_attack_state = ad_AS_MISSILE;
			return;
		}
	}
	
	//----------------------------------------------------------------------
	// Melee attack(overhead slime balls)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_BOGLORDMELEE,ad_MONAI_MELEEZTALL)) {
		// Easy to dodge ball attack, bolts are more difficult
		if (self.spawnflags & ad_MON_BOGL_STRONG)
			self.ad_attack_chance = random();
		else {
			// Easy = 10%, Normal = 20%, Hard = 30%, NM = 40%
			self.ad_attack_chance = 0.1 + (ad_skill * 0.1);
		}
		if (random() < self.ad_attack_chance) self.ad_attack_state = ad_AS_MISSILE;
		else { self.ad_attack_state = ad_AS_MELEE; if (VR_MeleeArc_Launch()) self.ad_th_melee (); } // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack (Fast volley of bolts)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;

	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	// Setup attack chance of using fast bolt attack more often
	// easy=0.0, norm=0.2, hard=0.4, nm=0.6
	// The stronger version is just pure random 50/50
	if (self.spawnflags & ad_MON_BOGL_STRONG) self.ad_attack_chance = random();
	else self.ad_attack_chance = 0.0 + (ad_skill * 0.2);
	
	// Give the monster a chance to move if not tethered
	if (!self.ad_tethered) ad_SUB_AttackFinished (1 + 2*random());
	
	// Check for random chance to keep doing overhead smash
	if (random() > self.ad_attack_chance) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
	}
	// Range attack harder to dodge at higher projectile speed
	else self.ad_attack_state = ad_AS_MISSILE;
};

/*======================================================================
 SeekerCheckAttack
======================================================================*/
void() ad_SeekerCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee punch
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELRAGESEEKER,ad_MONAI_MELEEZTALL)) {
		// Need both arms for melee animation
		if (self.state == 0) {
			self.ad_attack_state = ad_AS_MELEE;
			if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		}
		// Instantly go to rocket range attack
		// If the player is too close
		else {
			self.ad_attack_state = ad_AS_MISSILE;
			ad_SUB_AttackFinished (1 + random());
		}
		return;
	}

	//----------------------------------------------------------------------
	// Range attack (rockets or lasers)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;

	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (2 + 2*random());
};

/*======================================================================
 SantaCheckAttack
======================================================================*/
void() ad_SantaCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (Antlers)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEESANTA,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// Let sightsound play out before machine gun attack
	//----------------------------------------------------------------------
	if (self.ad_attack_rage) {
		self.ad_attack_finished = time + 3;
		self.ad_attack_rage = ad_FALSE;
	}	
	//----------------------------------------------------------------------
	// Range attack (snowball machine gun)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
	// Check if gun is being blocked (extra wide check)
	if ( ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0') ) return;
	
	// Straight to snow machine gun!
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (2 + 2*random());
};

