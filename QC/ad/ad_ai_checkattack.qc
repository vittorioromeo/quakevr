	if (!ad_enemy_vis) {
		ad_SUB_switchEnemyTarget();
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
