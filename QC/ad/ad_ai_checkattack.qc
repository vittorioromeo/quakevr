	// setup enemytarget if one is not active
	//----------------------------------------------------------------------
	if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET && self.height > 0) {
		if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
			self.enemy = self.ad_enemytarget;
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Plasma volley)
	//----------------------------------------------------------------------
	// Only range attack if cooldown has finished
	if (time > self.ad_attack_finished) {
		if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
		else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
		else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
		else self.ad_attack_chance = 0;
		if (random () < self.ad_attack_chance) {
			if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
				if (ad_enemy_range != ad_RANGE_MELEE)	ad_SUB_AttackFinished(2 + random());
				self.ad_attack_state = ad_AS_MISSILE;
				return;
			}
		}
	}
	
	//----------------------------------------------------------------------
	// Make sure the Gaunt maintains its distance (strafe)
	//----------------------------------------------------------------------
	if (ad_enemy_range >= ad_RANGE_MID) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else self.ad_attack_state = ad_AS_SLIDING;
};

/*======================================================================
 FishCheckAttack (melee only)
======================================================================*/
void() ad_FishCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (Bite)
	// Uses larger knight distance and closer bite check afterward
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
};

/*======================================================================
 EelCheckAttack (No melee attack)
======================================================================*/
void() ad_EelCheckAttack =
{
	//----------------------------------------------------------------------
	// Range attack (Plasma bolt)
	//----------------------------------------------------------------------
	// Only range attack if cooldown has finished
	if (time > self.ad_attack_finished) {
		if (!ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0')) {
			if (ad_enemy_range != ad_RANGE_MELEE)	ad_SUB_AttackFinished(2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
			return;
		}
	}
	
	//----------------------------------------------------------------------
	// Make sure the Eel maintains its distance (strafe)
	//----------------------------------------------------------------------
	if (ad_enemy_range >= ad_RANGE_MID || !ad_enemy_vis) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else self.ad_attack_state = ad_AS_SLIDING;
};

/*======================================================================
 WraithCheckAttack (No melee attack)
======================================================================*/
void() ad_WraithCheckAttack =
{
	//----------------------------------------------------------------------
	// Cannot see enemy? stop chasing enemytarget
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) {
		ad_SUB_switchEnemyTarget();
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
			ad_SUB_AttackFinished(2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
		return;
	}
	//----------------------------------------------------------------------
	// setup enemytarget if one os not active
	//----------------------------------------------------------------------
	if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET && self.height > 0) {
		if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
			self.enemy = self.ad_enemytarget;
		}
	}
	//----------------------------------------------------------------------
	// Range attack (burning and creature summons)
	// Much more aggressive decision on range attacks (ogre style)
	// No random chance percentages, logic with wraith magic function
	//----------------------------------------------------------------------
	// Only range attack if cooldown has finished
	if (time > self.ad_attack_finished) {
		if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
			if (ad_enemy_range != ad_RANGE_MELEE)	ad_SUB_AttackFinished(2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
			return;
		}
	}

	//----------------------------------------------------------------------
	// If turret, then do not move sideways
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
		return;
	}
	//----------------------------------------------------------------------
	// Make sure the wraith maintains its distance (strafe)
	//----------------------------------------------------------------------
	if (ad_enemy_range >= ad_RANGE_MID) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else self.ad_attack_state = ad_AS_SLIDING;
};

/*======================================================================
 MinotaurCheckAttack
======================================================================*/
void() ad_MinotaurCheckAttack =
{
	//----------------------------------------------------------------------
	// If health is low enough, switch to rage mode
	// This does not affect the minion spawning version
	if ( !(self.spawnflags & ad_MON_MINOTAUR_MINIONS) && self.ad_movespeed >= 0) {
		if (self.health < self.max_health*0.5 && !self.ad_attack_rage) {
			self.ad_attack_rage = ad_TRUE;
			self.ad_th_charge();	// Short howl at the sky
			return;
		}
	}
	//----------------------------------------------------------------------
	// Melee attack (claws)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEMINOTAUR,ad_MONAI_MELEEZTALL)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		// Keep firing rockets when at range
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// RAGE mode (keep running at player)
	//----------------------------------------------------------------------
	if (self.ad_attack_rage) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
		// Check range and sight for a low chance range attack
		if (!ad_enemy_vis) return;
		if (time < self.ad_attack_finished) return;
		// If enemy not infront or random chance, stop and range attack
		if (!ad_infront(self.enemy) || random() < 0.1) {
			// Does the monster have a clear shot to the player?
			// sightline can be blocked by other monsters
			if (ad_visblocked(self.enemy)) return;
			// Plasma bolt attack
			ad_SUB_AttackFinished (2 + 2*random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
	}	
	//----------------------------------------------------------------------
	// PASSIVE mode (keep at distance)
	//----------------------------------------------------------------------
	else {
		// Is the player NOT visible? Keep getting closer
		if (!ad_enemy_vis) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) 
				self.ad_attack_state = ad_AS_STRAIGHT;
		}
		else {
			//----------------------------------------------------------------------
			// Mid Range attack (JUMP) Not spawning dark version
			//----------------------------------------------------------------------
			if ( !(self.spawnflags & ad_MON_MINOTAUR_MINIONS) && random() < 0.35) {
				// Jumped recently, facing right direction and not blocked?
				if ( self.jump_flag < time && ad_infront(self.enemy)) {
					if (!ad_visblocked_wide(self.enemy, self.view_ofs, VR_AD_ViewOfs(self.enemy)) ) {
						// Check for enemy above? (z axis)
						if (self.enemy.origin_z <= self.origin_z) {
							// Is the minotaur within the right range?
							if (self.ad_enemydist > self.ad_jumprange_x &&
								self.ad_enemydist < self.ad_jumprange_y) {
								// Block any range attacks for a while
								ad_SUB_AttackFinished (random());
								self.ad_jumptouch = world;	// Reset last object touched
								self.count = 0;			// Number of times jumped
								self.ad_th_jump ();
								return;
							}
						}
					}
				}
			}
			//----------------------------------------------------------------------
			// Range / missile attack (plasma bolts)
			//----------------------------------------------------------------------
			// Any chance of a range attack?
			if (time < self.ad_attack_finished) {
				// Calculate a flat vector to ignore Z axis difference
				self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
				// Don't always stay at absolute range, move closer
				if (random() < 0.15 && self.ad_enemydist > ad_MONAI_RANGEMINOTAUR) {
					self.ad_attack_sidedeny = time + 1 + random();
					self.ad_attack_state = ad_AS_STRAIGHT;
				}
				else {
					// If not blocked, turn and move sideways
					if (self.ad_attack_sidedeny < time)
						self.ad_attack_state = ad_AS_SIDESTEP;
				}
			}
			else {
				// Does the monster have a clear shot to the player?
				// sightline can be blocked by other monsters
				if (ad_visblocked(self.enemy)) return;
				// Keep firing plasma when at range
				ad_SUB_AttackFinished (2 + 2*random());
				self.ad_attack_state = ad_AS_MISSILE;
			}
		}
	}
};

/*======================================================================
 DroleCheckAttack
======================================================================*/
void() ad_DroleCheckAttack =
{
	//----------------------------------------------------------------------
	// Quoth setup - 500HP, with rage at 350HP
	// Converted it to a % so mappers can change health
	//----------------------------------------------------------------------
	if (self.ad_movespeed >= 0) {
		if (self.health < self.max_health*0.7 && !self.ad_attack_rage) {
			self.ad_attack_rage = ad_TRUE;
		}
	}
	//----------------------------------------------------------------------
	// Melee attack (claws)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEDROLE2,ad_MONAI_MELEEZTALL)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		// Keep firing rockets when at range
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// RAGE mode (keep running at player)
	//----------------------------------------------------------------------
	if (self.ad_attack_rage) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
		// Check range and sight for a low chance range attack
		if (!ad_enemy_vis) return;
		if (time < self.ad_attack_finished) return;
		// Calculate a flat vector to ignore Z axis difference
		// Not convinced a flat vector is good for a melee only state
		// Switched to 3D distance chance so its not so dumb
		self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
		if (self.ad_enemydist > ad_MONAI_RANGEDROLE && random() < 0.3) {
			// Does the monster have a clear shot to the player?
			// sightline can be blocked by other monsters
			if (ad_visblocked(self.enemy)) return;
			// Standard rocket attack
			ad_SUB_AttackFinished (1 + 2*random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
	}	
	//----------------------------------------------------------------------
	// PASSIVE mode (keep at distance)
	//----------------------------------------------------------------------
	else {
		// Is the player visible? Keep getting closer
		if (!ad_enemy_vis) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) 
				self.ad_attack_state = ad_AS_STRAIGHT;
		}
		// Player in sight, fireball or loiter?
		else {
			// Any chance of a range attack?
			if (time < self.ad_attack_finished) {
				// Calculate a flat vector to ignore Z axis difference
				// Not convinced a flat vector is good for a melee only state
				// Switched to 3D distance chance so its not so dumb
				self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
				// Don't always stay at absolute range, move closer
				if (random() < 0.15 && self.ad_enemydist > ad_MONAI_RANGEDROLE) {
					self.ad_attack_sidedeny = time + 1 + random();
					self.ad_attack_state = ad_AS_STRAIGHT;
				}
				else {
					// If not blocked, turn and move sideways
					if (self.ad_attack_sidedeny < time)
						self.ad_attack_state = ad_AS_SIDESTEP;
				}
			}
			else {
				// Does the monster have a clear shot to the player?
				// sightline can be blocked by other monsters
				if (ad_visblocked(self.enemy)) return;
				// Keep firing rockets when at range
				ad_SUB_AttackFinished (1 + 2*random());
				self.ad_attack_state = ad_AS_MISSILE;
			}
		}
	}
};

/*======================================================================
 Death Guard (Quoth) CheckAttack
======================================================================*/
void() ad_DGuardQCheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
	if (ad_enemy_range == ad_RANGE_FAR) return;
		
	//----------------------------------------------------------------------
	// Melee attack (Over head smash attack)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEDGUARDQ,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}

	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed > 0) {
		if (time < self.ad_attack_finished) return;
		ad_SUB_AttackFinished ((1.4 * random()) + 0.8);
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Charge attack (Just outside of melee and before range)
	//----------------------------------------------------------------------
	if (self.ad_enemydist > ad_MONAI_CHARGEDGARDQ1 && 
		self.ad_enemydist < ad_MONAI_CHARGEDGARDQ2) {
		// Check for a random chance to break out from charging
		// and do a quick range attack instead
		if (time > self.ad_attack_finished && random() < 0.2) {
			ad_SUB_AttackFinished ((1.4 * random()) + 0.8);
			self.ad_th_missile ();
		}
		else self.ad_th_charge ();
		return;
	}

	//----------------------------------------------------------------------
	// Range attack - Fireball
	//----------------------------------------------------------------------
	if (self.ad_enemydist > ad_MONAI_RANGEDGARDQ) {
		if (time < self.ad_attack_finished) return;
		if (random() < 0.5) {
			ad_SUB_AttackFinished ((1.4 * random()) + 0.8);
			self.ad_th_missile ();
		}
	}
};

/*======================================================================
 DSergeantCheckAttack
======================================================================*/
void() ad_DSergeantCheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	//----------------------------------------------------------------------
	// Melee attack
	// enemy_range is checked before this function (ai_run - ai.qc)
	// If the monster is within melee range they instantly attack
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		// If the sightline between self and player blocked by anything, keep moving
		if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 10', ad_FALSE)) return;
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}

	// If range blocked do charging instead
	if (time < self.ad_attack_finished) {
		//----------------------------------------------------------------------
		// Charge attack
		// Player within certain range, height and charging not blocked?
		//----------------------------------------------------------------------
		self.height = fabs(self.origin_z - self.enemy.origin_z);
		if (ad_ai_checkmelee(ad_MONAI_CHARGEFLAIL,ad_FALSE) && self.height < ad_MONAI_CHARGEZAXIS
				&& self.ad_attack_timer < time) {
			// If attack timer not active, bump up with a random amount
			if (self.ad_attack_finished < time) ad_SUB_AttackFinished (random());
			self.ad_th_charge ();
			return;
		}	
	}
	else {
		//----------------------------------------------------------------------
		// Range attack - Homing missile
		//----------------------------------------------------------------------
		// If the sightline between self and player blocked
		// Allow for monsters to be hit (infighting rules!)
		if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 10', ad_FALSE)) return;
		self.ad_attack_state = ad_AS_MISSILE;
	}
};

/*======================================================================
 DLordCheckAttack
======================================================================*/
void() ad_DLordCheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
		
	//----------------------------------------------------------------------
	// Melee attack
	// enemy_range is checked before this function (ai_run - ai.qc)
	// If the monster is within melee range they instantly attack
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		// If the sightline between self and player blocked by anything, keep moving
		if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) return;
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	// If the sightline between self and player blocked by anything, keep moving
	if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) return;
	
	// Strong lightning attack (melee again)
	if (self.ad_enemydist < ad_MONAI_RANGEDLORD && random() < 0.4) {
		ad_SUB_AttackFinished (3 + random()*2);
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	
	// Long volley of spike balls (NG damage)
	if (self.ad_enemydist >= ad_MONAI_RANGEDLORD && random() < 0.6) {
		ad_SUB_AttackFinished (5 + random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
};

/*======================================================================
 DPrinceCheckAttack
======================================================================*/
void() ad_DPrinceCheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
		
	//----------------------------------------------------------------------
	// Melee attack
	// enemy_range is checked before this function (ai_run - ai.qc)
	// If the monster is within melee range they instantly attack
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	// Hazard projectiles are fired over 6 frames
	if (ad_skill <= ad_SKILL_NORMAL) self.ad_attack_count = 6;
	else self.ad_attack_count = 12;

	// Weaponstate range attacks
	// 1=Close range (hazard), 2=Far range (rockets)
	
	// Always attack monsters with rockets (good range/damage)
	if (self.enemy.flags & ad_FL_MONSTER) self.ad_weaponstate = 2;
	// If enemy too far above (vertical height) don't use hazard
	// Allow some extra height (steplarge) for jumping players
	else if (self.enemy.origin_z > (self.origin_z+ad_MONAI_STEPLARGE)) 
		self.ad_weaponstate = 2;
	// If reached hazard projectile limit use rockets instead
	else if ( !(ad_HazardProjectile_CheckLimit(self, self.ad_attack_count)) )
		self.ad_weaponstate = 2;
	// If enemy close, use hazard attack
	else if (self.ad_enemydist < ad_MONAI_RANGEDPRINCE) self.ad_weaponstate = 1;
	// Default = rocket attack
	else self.ad_weaponstate = 2;
	
	// Turret mode needs to fire much faster
	if (self.ad_movespeed < 0) ad_SUB_AttackFinished (1 + random());
	else {
		// The hazard attack should be faster recovery time
		if (self.ad_weaponstate > 1) ad_SUB_AttackFinished (2 + random());
		else ad_SUB_AttackFinished (1 + random());
	}
	// Range attacks (decided by weaponstate)
	self.ad_attack_state = ad_AS_MISSILE;
};

/*======================================================================
 DFuryCheckAttack
======================================================================*/
void() ad_DFuryCheckAttack =
{
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
		
	//----------------------------------------------------------------------
	// Melee attack
	// enemy_range is checked before this function (ai_run - ai.qc)
	// If the monster is within melee range they instantly attack
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		// If the sightline between self and player blocked by anything, keep moving
		if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) return;
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// is the enemy close enough for a double sword slice attack?
	//----------------------------------------------------------------------
	if (self.ad_enemydist < self.ad_jumprange_x) {
		self.ad_attack_state = ad_AS_MELEE;
		self.ad_th_slide (); 
		return;
	}
	//----------------------------------------------------------------------
	// Mid Range attack (JUMP)
	//----------------------------------------------------------------------
	// Jumped recently, facing right direction and not blocked?
	if ( self.jump_flag < time && ad_infront(self.enemy) && !ad_visblocked(self.enemy) ) {
		// Check for enemy above? (z axis)
		if (self.enemy.origin_z <= self.origin_z) {
			// Is the fury knight within the right range?
			if (self.ad_enemydist > self.ad_jumprange_x &&
				self.ad_enemydist < self.ad_jumprange_y) {
				// Block any range attacks for a while
				ad_SUB_AttackFinished (random());
				self.ad_jumptouch = world;		// Reset last object touched
				self.count = 0;				// Number of times jumped
				if (random() < 0.65) self.ad_th_jump ();
				else self.ad_th_charge ();
				return;
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack
	// The attack chance percentages are constant across skill levels
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	// If the sightline between self and player blocked by anything, keep moving
	if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) return;
	
	if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
	else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.4;	// range < 500 map units
	// If jump ability blocked, be more aggressive with range
	else if (ad_enemy_range > ad_RANGE_NEAR && self.jump_flag == ad_LARGE_TIMER) self.ad_attack_chance = 0.4;
	else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.05;	// range < 1000 map units
	else self.ad_attack_chance = 0;
	if (random () < self.ad_attack_chance) self.ad_attack_state = ad_AS_MISSILE;
};

/*======================================================================
 JusticeCheckAttack
======================================================================*/
void() ad_JusticeCheckAttack =
{
	//----------------------------------------------------------------------
	// Special melee attack for monster infighting
	//----------------------------------------------------------------------
	if (self.enemy.flags & ad_FL_MONSTER) {
		// If monster outside of melee range, blast them with range
		if (self.ad_enemydist > self.ad_meleerange) self.ad_attack_state = ad_AS_MISSILE;
		else self.ad_attack_state = ad_AS_MELEE;
		return;
	}

	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Melee attack (Slash (left/right) and overhead smash)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEJUSTICE,ad_FALSE)) {
		// Looks really odd if justice just charges all the time
		// Random chance to stop and do a range (flame/spike) attack
		if (self.ad_enemydist > ad_MONAI_CLOSEJUSTICE && random() < 0.5) {
			self.ad_attack_state = ad_AS_MISSILE;
			ad_SUB_AttackFinished (2 + random());
		}
		// Swing or Smash
		else self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack conditions
	//----------------------------------------------------------------------
	// Can see the enemy?
	if (!ad_enemy_vis) return;
	// Range/Jump attacks blocked for a while
	if (time < self.ad_attack_finished) return;
	// If the sightline between self and player blocked by anything, keep moving
	if (!ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE)) return;
	
	//----------------------------------------------------------------------
	// Mid Range attack (JUMP)
	//----------------------------------------------------------------------
	// Jumped recently, facing right direction and not blocked?
	if ( self.jump_flag < time && ad_infront(self.enemy) && !ad_visblocked(self.enemy) ) {
		// Check for enemy above? (z axis)
		if (self.enemy.origin_z <= self.origin_z) {
			// Is the justice knight within the right range?
			if (self.ad_enemydist > self.ad_jumprange_x &&
				self.ad_enemydist < self.ad_jumprange_y) {
				// Block any range attacks for a while
				ad_SUB_AttackFinished (random());
				self.ad_jumptouch = world;		// Reset last object touched
				self.count = 0;				// Number of times jumped
				self.ad_th_jump ();
				return;
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Spikes or Flames)
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_RANGEJUSTICE) return;
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (2 + random());
};

/*======================================================================
 BaronCheckAttack (from Nehara MOD)
======================================================================*/
void() ad_BaronCheckAttack =
{
	//----------------------------------------------------------------------
	// Special melee attack for monster infighting
	//----------------------------------------------------------------------
	if (self.enemy.flags & ad_FL_MONSTER) {
		// If monster outside of melee range, blast them with range
		if (self.ad_enemydist > self.ad_meleerange) self.ad_attack_state = ad_AS_MISSILE;
		else self.ad_attack_state = ad_AS_MELEE;
		return;
	}

	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Check for Blast Belt and create random chance of detecting it
	//----------------------------------------------------------------------
	if (self.enemy.flags & ad_FL_CLIENT && self.enemy.ad_moditems & ad_IT_ARTBLASTBELT)
		self.ad_attack_chance = random();
	else self.ad_attack_chance = 0;
	
	//----------------------------------------------------------------------
	// Melee attack (Special fist ground smash)
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_MELEEBARON && self.ad_attack_chance < 0.5) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack conditions
	//----------------------------------------------------------------------
	// Can see the enemy?
	if (!ad_enemy_vis) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
	
	//----------------------------------------------------------------------
	// Mid Range attack (JUMP)
	//----------------------------------------------------------------------
	// Jumped recently, facing right direction and not blocked?
	if ( self.jump_flag < time && ad_infront(self.enemy) ) {
		// Check for enemy above? (z axis)
		if (self.enemy.origin_z <= self.origin_z) {
			// Is the Baron within the right range?
			if (self.ad_enemydist > self.ad_jumprange_x &&
				self.ad_enemydist < self.ad_jumprange_y) {
				// Block any range attacks for a while
				ad_SUB_AttackFinished (random());
				self.ad_jumptouch = world;		// Reset last object touched
				self.count = 0;				// Number of times jumped
				self.ad_th_jump ();
				return;
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Spikeball or Firewall)
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (1 + random());
};

/*======================================================================
 DCrossCheckAttack
======================================================================*/
void() ad_DCrossCheckAttack =
{
	if (!ad_enemy_vis) return;
	//----------------------------------------------------------------------
	// Melee attack (blunt end of crossbow)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		// If sight blocked by another monster, do nothing
		if (!ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0')) return;
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// Range / missile attack (slow bolts)
	// The range logic is done via two set of animations (hold/slide)
	// Once within a certain range, stay there and snipe at the enemy
	//----------------------------------------------------------------------
	// range < 500 map units
	if (ad_enemy_range == ad_RANGE_NEAR || self.ad_enemymaxdist) {
		// If sight blocked by another monster, slide to the side
		if (!ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0')) {
			self.ad_attack_state = ad_AS_SLIDING;
			self.ad_th_slide ();
		}
		else {
			// No monster in the way, hold still and start aiming
			self.ad_attack_state = ad_AS_MISSILE;
			self.ad_th_missile ();
		}
	}
	else self.ad_attack_state = ad_AS_STRAIGHT;
};

/*======================================================================
 ZombiekCheckAttack (Has no range attack)
 The player is in view, so decide to jump or melee
======================================================================*/
void() ad_ZombiekCheckAttack =
{
	if (!ad_enemy_vis) return;
	//----------------------------------------------------------------------
	// Melee attack (rusty sword)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, randomly do melee attacks
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (random() < ad_MONAI_TURRETMODE) return;
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range / missile attack (jumping)
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	self.ad_attack_chance = 0.3 + ad_skill*0.1;
	if (random() < self.ad_attack_chance) {
		// Is the enemy the right distance away and the random chance is correct?
		if (self.ad_enemydist > self.ad_jumprange_x && self.ad_enemydist < self.ad_jumprange_y) {
			ad_SUB_AttackFinished (2 + random()*2);
			self.ad_jumptouch = world;			// Reset last object touched
			self.count = 0;					// Number of times jumped
			self.ad_attack_state = ad_AS_JUMP;	// JUMP JUMP JUMP!
		}
	}
};

/*======================================================================
 BoilCheckAttack (Has no range attack)
 The player is in view, so blow up!
======================================================================*/
void() ad_BoilCheckAttack =
{
	if (!ad_enemy_vis) return;
	// Only has one attack, run at player and explode
	// Does one simple range check regardless if turret
	if (self.ad_enemydist < ad_MONAI_MELEEBOIL) self.ad_attack_state = ad_AS_MELEE;
};

/*======================================================================
 SpawnCheckAttack
======================================================================*/
void() ad_SpawnCheckAttack =
{
	// Spawns don't start jumping straight away unless they can directly
	// see the player. 	// They slowly crawl around which can make them
	// tricky to plan for an ambush.
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	//----------------------------------------------------------------------
	// JUMP Melee attack
	// This pretty much a close quarter jump in the face attack!
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEESPAWN,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, randomly do melee attacks
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (random() < ad_MONAI_TURRETMODE) return;
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// JUMP Range attack
	// The attack chance percentages are constant across skill levels
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;

	// range < 120 map units
	if (ad_enemy_range == ad_RANGE_MELEE) {
		self.ad_attack_chance = 0.9;
		self.ad_attack_finished = 0;
	}
	// range < 500 map units
	else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.2;
	// range < 1000 map units
	else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.05;
	else self.ad_attack_chance = 0;

	if (random () < self.ad_attack_chance) {
		ad_SUB_AttackFinished (2*random());
		self.ad_jumptouch = world;			// Reset last object touched
		self.count = 0;					// Number of times jumped
		self.ad_attack_state = ad_AS_JUMP;	// JUMP JUMP JUMP!
	}
};

/*======================================================================
 DemonCheckAttack
======================================================================*/
void() ad_DemonCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (CLAWS)
	//----------------------------------------------------------------------
	// Check that within range of a claw attack
	if (ad_ai_checkmelee(ad_MONAI_MELEEDEMON,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, randomly do melee attacks
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (random() < ad_MONAI_TURRETMODE) return;
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (JUMP)
	//----------------------------------------------------------------------
	// Time for another jump?
	if (self.jump_flag < time) {
		// Stop the demon over or under jumping the enemy
		if (self.origin_z + self.mins_z > self.enemy.origin_z + self.enemy.mins_z
		+ 0.75 * self.enemy.size_z) return;
		if (self.origin_z + self.maxs_z < self.enemy.origin_z + self.enemy.mins_z
		+ 0.25 * self.enemy.size_z) return;
			
		// Check for closeness, but not long range!
		self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
		if (self.ad_enemydist < self.ad_jumprange_x) return;
		
		// Check for low ceilings directly above the demon
		traceline(self.origin, self.origin + '0 0 256', ad_TRUE, self);
		self.height = fabs(vlen(trace_endpos - self.origin));
		// Ceiling is too low (looks dumb hitting ceilings)
		if (self.height < ad_MONAI_JUMPDEMONCHECK) return; 
	
		// ** QC code from necros **
		// Move the demon forward 16 units and check if blocked
		self.pos1 = self.origin;
		self.ideal_yaw = vectoyaw(self.enemy.origin - self.pos1);
		// If move forward fails, move back and indicate no jump
		if (!ad_walkmove(self.ideal_yaw, 16)) {
			setorigin(self, self.pos1);
			return;
		}
		
		setorigin(self, self.pos1);			// walkmove successful, move demon back
		self.ad_jumptouch = world;				// Reset last object touched
		self.count = 0;						// Number of times jumped
		self.ad_attack_state = ad_AS_JUMP;		// JUMP JUMP JUMP!
	}
};

/*======================================================================
 ScorpionCheckAttack (high damage pincher)
======================================================================*/
void() ad_ScorpionCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (CLAWS)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEESCORPION,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, do range attacks
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		ad_SUB_AttackFinished (2 + random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack (JUMP/TAIL)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;

	if (self.spawnflags & ad_MON_SCORPION_STINGER) {
		// check for extra wide space to jump
		if (!ad_visblocked_wide(self, self.ad_attack_offset, VR_AD_ViewOfs(self.enemy))) return;
		
		// Time for another jump?
		if (self.jump_flag < time) {
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			if (self.ad_enemydist < self.ad_jumprange_x) return;
			if (self.ad_enemydist > self.ad_jumprange_y) return;

			self.ad_jumptouch = world;		// Reset last object touched
			self.count = 0;				// Number of times jumped
			self.ad_attack_state = ad_AS_JUMP;
		}
	}
	else {
		if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
		else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
		else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
		else self.ad_attack_chance = 0;
		if (random () < self.ad_attack_chance) {
			ad_SUB_AttackFinished (2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
	}
};

/*======================================================================
 DogCheckAttack
======================================================================*/
void()	ad_DogCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (BITE)
	//----------------------------------------------------------------------
	// Check that within range of a bite attack
	if (ad_ai_checkmelee(ad_MONAI_MELEEDOG,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, randomly do melee attacks
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (random() < ad_MONAI_TURRETMODE) return;
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (JUMP)
	//----------------------------------------------------------------------
	// Has the dog jumped less than 2 seconds ago?
	if (self.jump_flag < time) {
		// Stop the dog over or under jumping the enemy
		if (self.origin_z + self.mins_z > self.enemy.origin_z + self.enemy.mins_z
		+ 0.75 * self.enemy.size_z) return;
		if (self.origin_z + self.maxs_z < self.enemy.origin_z + self.enemy.mins_z
		+ 0.25 * self.enemy.size_z) return;
		
		self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
		if (self.ad_enemydist < self.ad_jumprange_x) return;
		if (self.ad_enemydist > self.ad_jumprange_y) return;

		// Check for enemy above? (z axis)
		if (self.enemy.origin_z > self.origin_z) return;
		self.ad_jumptouch = world;			// Reset last object touched
		self.count = 0;					// Number of times jumped
		self.ad_attack_state = ad_AS_JUMP;
	}
};

/*======================================================================
 SpiderCheckAttack
======================================================================*/
void() ad_SpiderCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (BITE)
	//----------------------------------------------------------------------
	// Check that within range of a bite attack
	if (ad_ai_checkmelee(ad_MONAI_MELEESPIDER,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (Large Green Spider = SPIT)
	// Behaves like a wizards; strafe, spit goo
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_SPIDER_LARGE) {
		if (!ad_enemy_vis) return;
		if (time < self.ad_attack_finished) return;

		// Does the monster have a clear shot to the player?
		// sightline can be blocked by other monsters
		if (ad_enemy_range == ad_RANGE_FAR || ad_visblocked(self.enemy)) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) {
				self.ad_attack_state = ad_AS_STRAIGHT;
				self.ad_th_run ();
			}
			return;
		}

		if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
		else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
		else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
		else self.ad_attack_chance = 0;
		if (random () < self.ad_attack_chance) {
			ad_SUB_AttackFinished (2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
		else if (ad_enemy_range == ad_RANGE_MID) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) {
				self.ad_attack_state = ad_AS_STRAIGHT;
				self.ad_th_run ();
			}
		}
		else {
			if (self.ad_attack_state != ad_AS_SLIDING) {
				self.ad_attack_state = ad_AS_SLIDING;
				self.ad_th_slide ();
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Small Brown Spider = JUMP)
	// Behaves like a dog; run and jump
	//----------------------------------------------------------------------
	else {
		// Is it time to jump?
		if (self.jump_flag < time) {
			// Stop the spider over or under jumping the enemy
			if (self.origin_z + self.mins_z > self.enemy.origin_z + self.enemy.mins_z
			+ 0.75 * self.enemy.size_z) return;
			if (self.origin_z + self.maxs_z < self.enemy.origin_z + self.enemy.mins_z
			+ 0.25 * self.enemy.size_z) return;
				
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			if (self.ad_enemydist < self.ad_jumprange_x) return;
			if (self.ad_enemydist > self.ad_jumprange_y) return;
			// Check for enemy above? (z axis)
			if (self.enemy.origin_z > self.origin_z) return;
			self.ad_jumptouch = world;		// Reset last object touched
			self.count = 0;				// Number of times jumped
			self.ad_attack_state = ad_AS_JUMP;
		}
	}
};

/*======================================================================
 SteelclawCheckAttack
======================================================================*/
