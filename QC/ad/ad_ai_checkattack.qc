/*======================================================================
 SnowmanCheckAttack
======================================================================*/
void() ad_SnowmanCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (Antlers)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEESNOWMAN,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		// As soon as out of melee, range attack!
		self.ad_attack_finished = 0;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (rockets)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (2 + 2*random());
};

/*======================================================================
 GolemCheckAttack
======================================================================*/
void() ad_GolemCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack(Punch/Pound)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (self.ad_enemydist < ad_MONAI_MELEEGOLEM) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Floor stomp attack
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_GOLEMRANGE && random() < 0.3) {
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_th_slide ();
		return;
	}	
	//----------------------------------------------------------------------
	// Range attack (Rock Attack)
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	if (!self.ad_th_missile) return;
	
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (!ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 24')) {
		self.ad_attack_state = ad_AS_MISSILE;
		ad_SUB_AttackFinished (2 + 2*random());
	}
};

/*======================================================================
 ShalCheckAttack
======================================================================*/
void() ad_ShalCheckAttack =
{
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		// Slower spawnrate for minion eggs than voreballs
		if (!(self.spawnflags & ad_MON_SHALRATH_MINIONS)) {
			if (ad_visblocked(self.enemy)) return;
			ad_SUB_AttackFinished (2*random());
		}
		else ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	// Minion spawning shalraths should maintain distance
	// Use the new turn and side walk function to stay mid range
	if (self.spawnflags & ad_MON_SHALRATH_MINIONS && self.enemy.flags & ad_FL_CLIENT) {
		// Calculate a flat vector to ignore Z axis difference
		self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
		// If too far away from enemy, move in a straight line
		if (self.ad_enemydist > ad_MONAI_RANGESHAL) {
			self.ad_attack_state = ad_AS_STRAIGHT;
		}
		else {
			// If range attack still blocked, move sideway/backwards
			if (time < self.ad_attack_finished) {
				// If too close, move backwards and sideways so that
				// there is plenty of room to spawn more minions
				if (self.ad_enemydist < ad_MONAI_RANGESHAL2)
					self.ad_attack_state = ad_AS_BACKWARD;
				else self.ad_attack_state = ad_AS_SIDESTEP;
				// straight away move
				return;
			}
		}
	}

	// Does the monster have a clear shot to the enemy?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
		
	//----------------------------------------------------------------------
	// Range attack
	// The attack chance percentages are constant across skill levels
	//----------------------------------------------------------------------
	if (ad_enemy_range == ad_RANGE_FAR) return;
	if (time < self.ad_attack_finished) return;

	// random chance based on distance to enemy
	if (ad_enemy_range == ad_RANGE_MELEE) {
		self.ad_attack_chance = 0.9;	// < 120
		self.ad_attack_finished = 0;	// If enemy really close, constantly fire!
	}
	else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.4;	// < 500
	else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.1;	// < 1000
	else self.ad_attack_chance = 0;

	// Random chance of range attack?
	if (random () < self.ad_attack_chance) {
		// Slower spawnrate for minion eggs than voreballs
		if (self.spawnflags & ad_MON_SHALRATH_MINIONS) ad_SUB_AttackFinished (1 + 2*random());
		else ad_SUB_AttackFinished (2*random());
		self.ad_attack_state = ad_AS_MISSILE;
	}
};

/*======================================================================
 EliminatorCheckAttack (Range=Plasma)
======================================================================*/
void() ad_EliminatorCheckAttack =
{
	//----------------------------------------------------------------------
	// Range attack (Plasma)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// This is a range check for firing plasma bolts
	// Could easily work with massive range and attack_sniper
	if (ad_enemy_range == ad_RANGE_FAR && !self.ad_attack_sniper) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	// Aggressive range attack, no % chances
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (1 + 2*random());
};

/*======================================================================
 DeflectorCheckAttack (Melee=Flames/Plasma, Range=Rockets)
======================================================================*/
void() ad_DeflectorCheckAttack =
{
	// Check for visibility
	if (!ad_enemy_vis) return;

	// Plasma and Flame attacks are close combat attacks only
	// Enemy really needs to be infront as they front cone attacks
	if (ad_ai_checkmelee(ad_MONAI_RANGEDEFLECT,ad_FALSE) && ad_infront(self.enemy) ) {
		// Forced pause between attacks
		if (self.ad_attack_timer < time) {
			// Rapid firing plasma projectiles
			if (self.spawnflags & ad_MON_DEFLECTOR_PLASMA) {
				self.ad_attack_state = ad_AS_MELEE;
				if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
				return;
			}
			else {
				// Flame Count = Base (X) * (Skill * Y) Maximum = Z
				self.ad_attack_count = ad_SpriteCount_Flame(self.ad_proj_attqty);
				// Any sprite space left for hazard projectiles?
				if (ad_HazardProjectile_CheckLimit(self, self.ad_attack_count)) {
					self.ad_attack_state = ad_AS_MELEE;
					if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
					return;
				}
			}
		}
	}
	
	//----------------------------------------------------------------------
	// Range attack (Rockets)
	//----------------------------------------------------------------------
	if (time < self.ad_attack_finished) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
	// This is a range check for firing rockets
	if (ad_enemy_range == ad_RANGE_FAR && !self.ad_attack_sniper) return;

	// Aggressive range attack, no % chances
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (2 + 2*random());
};

/*======================================================================
 DefenderCheckAttack (Melee=SSG, Range=GL)
======================================================================*/
void() ad_DefenderCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (Super Shotgun to face)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_RANGEDEFSSG,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (Grenades)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// This is a range check for firing grenades
	// It need to be less than 600 units, otherwise likely to miss
	// No point having attack_sniper versions firing early
	if (ad_enemy_range == ad_RANGE_FAR) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;
	
	// Check enemy for grenade resistance?
	if (self.enemy.ad_bouncegrenade) {
		self.ad_attack_state = ad_AS_MELEE;
		if (VR_MeleeArc_Launch()) self.ad_th_melee (); // AD support: melee arc: facing away, it turns first (ad_ai_run_melee; fight.qc)
	}
	else {
		// Aggressive range attack, no % chances
		self.ad_attack_state = ad_AS_MISSILE;
		ad_SUB_AttackFinished (1 + 2*random());
	}
};

/*======================================================================
 FloydCheckAttack (Range=Plasma)
======================================================================*/
void() ad_FloydCheckAttack =
{
	//----------------------------------------------------------------------
	// Range attack (Plasma)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// This is a range check for firing plasma bolts
	// Could easily work with massive range and attack_sniper
	if (ad_enemy_range == ad_RANGE_FAR && !self.ad_attack_sniper) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	// Aggressive range attack, no % chances
	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (1 + 2*random());
};

/*======================================================================
 OgreCheckAttack
 Vanilla, Hunter, Fishing and Mace versions
======================================================================*/
void() ad_OgreCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (chainsaw)
	//----------------------------------------------------------------------
	if (self.ad_enemydist < self.ad_meleerange) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (grenades)
	// strangely enough the chance attack percentages are not used
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	// Check enemy for grenade resistance?
	// Move closer to enemy instead for melee range
	if (!self.enemy.ad_bouncegrenade) {
		self.ad_attack_state = ad_AS_MISSILE;
		// Fishing ogre fires much faster than standard
		if (self.ad_classtype == ad_CT_MONOGREFISH)
			ad_SUB_AttackFinished (1 + random());
		else ad_SUB_AttackFinished (1 + 2*random());
	}
};

/*======================================================================
 OgreHamCheckAttack (Hammer only, much faster)
======================================================================*/
void() ad_OgreHamCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (Special hammer attack)
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_HOGRE_METAL) {
		if (self.ad_enemydist < ad_MONAI_MELEEOGREHAM) {
			self.ad_attack_state = ad_AS_MELEE;
			return;
		}
	}
	else {
		// Default melee attack, just a simple hammer
		if (self.ad_enemydist < self.ad_meleerange) {
			self.ad_attack_state = ad_AS_MELEE;
			return;
		}
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (grenades)
	// strangely enough the chance attack percentages are not used
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (1 + random());
};

/*======================================================================
 FreddieCheckAttack
======================================================================*/
void() ad_FreddieCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (chainsaw)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEEFREDDIE,ad_MONAI_MELEEZTALL)) {
		// Hard/Nightmare skill have chance to ignore melee attacks
		if (ad_skill < ad_SKILL_HARD || (ad_skill > ad_SKILL_NORMAL && random() < 0.7)) {
			self.ad_attack_state = ad_AS_MELEE;
			return;
		}
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (ad_visblocked(self.enemy)) return;
		ad_SUB_AttackFinished (1 + 2*random());
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (spikes/laser)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	// If Freddie too far away for stationary attack?
	if (self.ad_enemydist > ad_MONAI_RANGEFREDDIE && ad_skill > ad_SKILL_EASY) {
		// Work out vector angle of enemy infront
		makevectors (self.angles);
		self.pos1 = normalize (self.enemy.origin - self.origin);
		self.lip = self.pos1 * v_forward;
		// Is the enemy infront of freddie?
		if (self.lip > 0.8) {
			self.cnt = 0;
			self.ad_attack_timer = ad_TRUE;
			ad_SUB_AttackFinished (1 + random());
		}
		else {
			// Small random chance of stop+fire
			if (random() < 0.2) {
				self.ad_attack_timer = ad_FALSE;
				self.ad_attack_state = ad_AS_MISSILE;
				ad_SUB_AttackFinished (1 + 2*random());
			}
		}
	}
	else {
		// Close to enemy, stop+fire
		self.ad_attack_timer = ad_FALSE;
		self.ad_attack_state = ad_AS_MISSILE;
		ad_SUB_AttackFinished (1 + 2*random());
	}
};

/*======================================================================
 WizardCheckAttack (No melee attack)
======================================================================*/
void() ad_WizardCheckAttack =
{
	//----------------------------------------------------------------------
	// Unique stuff for wizard above version
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_WIZARD_ABOVE) {
		// Cannot see enemy? stop chasing enemytarget
		if (!ad_enemy_vis) {
			ad_SUB_switchEnemyTarget();
			return;
		}
		// setup enemytarget if one is not active
		if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET && self.height > 0) {
			if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
				self.enemy = self.ad_enemytarget;
			}
		}
	}	
	//----------------------------------------------------------------------
	// Do nothing if cannot see enemy or waiting for attack timer
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (ad_visblocked(self.enemy)) return;
		self.ad_attack_state = ad_AS_MISSILE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (spit)
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	// The original id behaviour is wizards run until within range
	//----------------------------------------------------------------------
	if (ad_enemy_range == ad_RANGE_FAR || ad_visblocked(ad_SUB_entEnemyTarget()) ) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) 
			self.ad_attack_state = ad_AS_STRAIGHT;
		return;
	}

	if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
	else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
	else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
	else self.ad_attack_chance = 0;
	if (random () < self.ad_attack_chance) {
		self.ad_attack_state = ad_AS_MISSILE;
	}
	//----------------------------------------------------------------------
	// keep moving forward to enemy target
	//----------------------------------------------------------------------
	else if (ad_enemy_range == ad_RANGE_MID) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) 
			self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else {
		if (self.ad_attack_state != ad_AS_SLIDING) {
			self.ad_attack_state = ad_AS_SLIDING;
			self.ad_th_slide ();
		}
	}
};

/*======================================================================
 SkullWizardCheckAttack (No melee attack)
======================================================================*/
void() ad_SkullWizCheckAttack =
{
	//----------------------------------------------------------------------
	// Teleport away if player too close
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_MELEESKULLW && !self.ad_bodystatic) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	// make sure enemy is stationary (turret)
	else self.ad_attack_state = ad_AS_TURRET;
		
	//----------------------------------------------------------------------
	// Range / missile attack (skull attack)
	//----------------------------------------------------------------------
	if (!ad_enemy_vis) return;
	if (time < self.ad_attack_finished) return;
	// Does the monster have a clear shot to the player?
	// sightline can be blocked by other monsters
	if (ad_visblocked(self.enemy)) return;

	self.ad_attack_state = ad_AS_MISSILE;
	ad_SUB_AttackFinished (1 + 2*random());
};

/*======================================================================
 LostCheckAttack
======================================================================*/
void() ad_LostCheckAttack =
{
	//----------------------------------------------------------------------
	// setup enemytarget if one is not active
	//----------------------------------------------------------------------
	if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET && self.height > 0) {
		if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
			self.enemy = self.ad_enemytarget;
		}
	}

	//----------------------------------------------------------------------
	// Melee attack (bite)
	//----------------------------------------------------------------------
	if (ad_ai_checkmelee(ad_MONAI_MELEELOSTSOUL,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}

	//----------------------------------------------------------------------
	// If too close, move sideways until can ram again
	// If too far, move closer
	//----------------------------------------------------------------------
	if (self.ad_enemydist < ad_MONAI_RANGELOSTNEAR) {
		self.ad_attack_state = ad_AS_SLIDING;
		return;
	}
	else if (self.ad_enemydist > ad_MONAI_RANGELOSTFAR) {
		self.ad_attack_state = ad_AS_STRAIGHT;
		return;
	}

	//----------------------------------------------------------------------
	// Cannot see enemy? go into guard mode
	//----------------------------------------------------------------------
	if (!ad_enemy_vis && self.ad_lostsearch == ad_FALSE) {
		ad_SUB_switchEnemyTarget();
		self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
		self.ad_lostsearch = ad_TRUE;
		self.ad_lostenemy = self.enemy;
		self.ad_losttimer = time + ad_MONAI_LOSTTIMER + random()*5;
		self.enemy = self.goalentity = self.ad_movetarget = world;
		self.ad_th_altstand();
		return;
	}
	
	//----------------------------------------------------------------------
	// Range attack (Ramming Speed)
	//----------------------------------------------------------------------
	// Only range attack if cooldown has finished
	if (time > self.ad_attack_finished) {
		if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.view_ofs, '0 0 24')) {
			ad_SUB_AttackFinished(2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
		// No space for raming speed, strafe side to side
		else self.ad_attack_state = ad_AS_SLIDING;
	}
	// Wait for attack timer, better to face the player
	else self.ad_attack_state = ad_AS_SLIDING;
};

/*======================================================================
 JimCheckAttack (No melee attack)
 This is essentially the monster_centarion check
======================================================================*/
void() ad_JimCheckAttack =
{
	// Cannot see enemy? stop chasing enemytarget
	if (!ad_enemy_vis) {
		ad_SUB_switchEnemyTarget();
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
			ad_SUB_AttackFinished(2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
		return;
	}
	//----------------------------------------------------------------------
	// setup enemytarget if one is not active
	//----------------------------------------------------------------------
	if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET && self.height > 0) {
		if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
			self.enemy = self.ad_enemytarget;
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Lasers)
	//----------------------------------------------------------------------
	// Only range attack if cooldown has finished
	if (time > self.ad_attack_finished) {
		if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
		else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
		else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
		else self.ad_attack_chance = 0;
		if (random () < self.ad_attack_chance) {
			if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
				if (ad_enemy_range != ad_RANGE_MELEE)	ad_SUB_AttackFinished(2 + random());
				self.ad_attack_state = ad_AS_MISSILE;
				return;
			}
		}
	}
	//----------------------------------------------------------------------
	// Make sure jim maintains its distance (strafe)
	//----------------------------------------------------------------------
	if (ad_enemy_range >= ad_RANGE_MID) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else self.ad_attack_state = ad_AS_SLIDING;
};

/*======================================================================
 SweeperCheckAttack (No melee attack)
 This is essentially the monster_centarion check
======================================================================*/
void() ad_SweeperCheckAttack =
{
	// Cannot see enemy? stop chasing enemytarget (wait 20s)
	if (!ad_enemy_vis && self.ad_enemylastseen < (time - 20) ) {
		self.ad_enemyexit = ad_TRUE;
		return;
	}
	//----------------------------------------------------------------------
	// If setup to be a turret, check range attack only
	//----------------------------------------------------------------------
	if (self.ad_movespeed < 0) {
		if (time < self.ad_attack_finished) return;
		if (!ad_visblocked_wide(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 0')) {
			ad_SUB_AttackFinished(2 + random());
			self.ad_weaponstate = ad_TRUE; 	// Mines/Lasers
			self.ad_attack_state = ad_AS_MISSILE;
		}
		return;
	}
	//----------------------------------------------------------------------
	// setup enemytarget if one is not active
	//----------------------------------------------------------------------
	if (self.enemy.ad_classtype != ad_CT_ENEMYTARGET && self.height > 0) {
		if (ad_SUB_setupEnemyTarget(self.enemy, self.height, ad_MONAI_ABOVETIMER)) {
			self.enemy = self.ad_enemytarget;
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Mines/Spikes)
	//----------------------------------------------------------------------
	// Range attack if cooldown has finished and can see enemy
	if (self.ad_attack_finished < time && ad_enemy_vis) {
		// Is the enemy close enough for plasma spin attack?
		if (self.ad_enemydist < ad_MONAI_RANGESWEEPER) {
			self.ad_weaponstate = ad_FALSE;	// Fire plasma
			ad_SUB_AttackFinished(1);		// Relentless attacks
			self.ad_attack_state = ad_AS_MISSILE;
			return;
		}
		else {
			// Work out the distance below
			traceline(self.origin, self.origin + '0 0 -1024', ad_TRUE, self);
			self.distance = fabs(vlen(trace_endpos - self.origin));

			// Is there enough space below to fire mines?
			if (self.distance > ad_MONAI_RANGEMINESWEEPER) {
				self.ad_weaponstate = ad_TRUE;	// Fire Mines
				ad_SUB_AttackFinished(2 + random());
				self.ad_attack_state = ad_AS_MISSILE;
				return;
			}
		}
	}
	//----------------------------------------------------------------------
	// Make sure sweeper maintains its distance (strafe)
	//----------------------------------------------------------------------
	if (ad_enemy_range >= ad_RANGE_MID) {
		if (self.ad_attack_state != ad_AS_STRAIGHT) self.ad_attack_state = ad_AS_STRAIGHT;
	}
	else self.ad_attack_state = ad_AS_SLIDING;
};

