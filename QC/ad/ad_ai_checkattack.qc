				self.ad_th_run ();
			}
			return;
		}

		if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
		else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
		else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
		else self.ad_attack_chance = 0;
		if (random () < self.ad_attack_chance) {
			ad_SUB_AttackFinished (2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
		else if (ad_enemy_range == ad_RANGE_MID) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) {
				self.ad_attack_state = ad_AS_STRAIGHT;
				self.ad_th_run ();
			}
		}
		else {
			if (self.ad_attack_state != ad_AS_SLIDING) {
				self.ad_attack_state = ad_AS_SLIDING;
				self.ad_th_slide ();
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Elf 1 (green/red pants) = JUMP)
	// Behaves like a dog; run and jump
	//----------------------------------------------------------------------
	else {
		// Is it time to jump?
		if (self.jump_flag < time) {
			// Stop the elf over or under jumping the enemy
			if (self.origin_z + self.mins_z > self.enemy.origin_z + self.enemy.mins_z
			+ 0.75 * self.enemy.size_z) return;
			if (self.origin_z + self.maxs_z < self.enemy.origin_z + self.enemy.mins_z
			+ 0.25 * self.enemy.size_z) return;
				
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			if (self.ad_enemydist < self.ad_jumprange_x) return;
			if (self.ad_enemydist > self.ad_jumprange_y) return;
			// Check for enemy above? (z axis)
			if (self.enemy.origin_z > self.origin_z) return;
			self.ad_jumptouch = world;		// Reset last object touched
			self.count = 0;				// Number of times jumped
			self.ad_attack_state = ad_AS_JUMP;
		}
	}
};

/*======================================================================
 VorelingCheckAttack
======================================================================*/
void() ad_VorelingCheckAttack =
{
	//----------------------------------------------------------------------
	// Melee attack (BITE)
	//----------------------------------------------------------------------
	// Check that within range of a bite attack
	if (ad_ai_checkmelee(ad_MONAI_MELEEVORELING,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		return;
	}
	//----------------------------------------------------------------------
	// Range attack (Large Purple Voreling = SPIT)
	// Behaves like a wizards; strafe, spit goo
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_VORELING_LARGE) {
		if (!ad_enemy_vis) return;
		if (time < self.ad_attack_finished) return;

		// Does the monster have a clear shot to the player?
		// sightline can be blocked by other monsters
		if (ad_enemy_range == ad_RANGE_FAR || ad_visblocked(self.enemy)) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) {
				self.ad_attack_state = ad_AS_STRAIGHT;
				self.ad_th_run ();
			}
			return;
		}

		if (ad_enemy_range == ad_RANGE_MELEE) self.ad_attack_chance = 0.9;		// range < 120 map units
		else if (ad_enemy_range == ad_RANGE_NEAR) self.ad_attack_chance = 0.6;	// range < 500 map units
		else if (ad_enemy_range == ad_RANGE_MID) self.ad_attack_chance = 0.2;	// range < 1000 map units
		else self.ad_attack_chance = 0;
		if (random () < self.ad_attack_chance) {
			ad_SUB_AttackFinished (2 + random());
			self.ad_attack_state = ad_AS_MISSILE;
		}
		else if (ad_enemy_range == ad_RANGE_MID) {
			if (self.ad_attack_state != ad_AS_STRAIGHT) {
				self.ad_attack_state = ad_AS_STRAIGHT;
				self.ad_th_run ();
			}
		}
		else {
			if (self.ad_attack_state != ad_AS_SLIDING) {
				self.ad_attack_state = ad_AS_SLIDING;
				self.ad_th_slide ();
			}
		}
	}
	//----------------------------------------------------------------------
	// Range attack (Small White Voreling = JUMP)
	// Behaves like a dog; run and jump
	//----------------------------------------------------------------------
	else {
		// Is it time to jump?
		if (self.jump_flag < time) {
			// Stop the voreling over or under jumping the enemy
			if (self.origin_z + self.mins_z > self.enemy.origin_z + self.enemy.mins_z
			+ 0.75 * self.enemy.size_z) return;
			if (self.origin_z + self.maxs_z < self.enemy.origin_z + self.enemy.mins_z
			+ 0.25 * self.enemy.size_z) return;
				
			// Too close/far?
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			if (self.ad_enemydist < self.ad_jumprange_x) return;
			if (self.ad_enemydist > self.ad_jumprange_y) return;
			// Check for enemy above? (z axis)
			if (self.enemy.origin_z > self.origin_z) return;
			self.ad_jumptouch = world;			// Reset last object touched
			self.count = 0;					// Number of times jumped
			self.ad_attack_state = ad_AS_JUMP;
		}
	}
};

