// AD's readme and docs/vr-port/CREDITS.md), my_progs/client_advinfo.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 Player/client debug info functions
======================================================================*/
entity ad_ammocontrol;			// Stats controller

// Ammo controller phases
float ad_AC_PHASE0 = 0;		// Ready to start
float ad_AC_PHASE1 = 1;		// Weapon stats
float ad_AC_PHASE2 = 2;		// Ammo stats
float ad_AC_PHASE3 = 3;		// Weapon stats
float ad_AC_PHASE4 = 4;		// Armour + HP stats
float ad_AC_PHASE5 = 5;		// Final stats table

float ad_AC_AMMOQTY = 0;		// Sub total
float ad_AC_SMALLBOX = 1;		// Total small ammo boxes
float ad_AC_LARGEBOX = 2;		// Total large ammo boxes
float ad_AC_RESPAWN = 3;		// Total from respawning boxes
float ad_AC_BACKPACK = 4;		// Total from backpacks
float ad_AC_WEAPON = 5;		// Total from weapon pickups
float ad_AC_MONSTER = 6;		// Total from monsters
float ad_AC_WORLDSPN = 7;		// Duplicate + Capped worldspawn
float ad_AC_SHOTSTART = 8;		// Shotgun start weapon detection
float ad_AC_AMMOFINAL = 9;		// Final total (0+4+5+6+7)

float ad_MAX_AMMOARRAY = 10;	// Total of S+N+R+C sets
float ad_MAX_WPNDISP = 25;		// Limit of Weapon display
float ad_MAX_AMMODISP = 400;	// Limit of Ammo display
float ad_NOHP_MONARRAY = 0;	// Health for special monsters (boss or >9999)

float ad_MAX_MONCOUNT = 400;	// limit of monster display (display_monsleft)
float ad_MAX_MONARRAY = 50;	// Size of monster array (display_monsqty)

//----------------------------------------------------------------------
// Define all arrays for Ammo and Monster Stats
// 0=Total found, 1=Small box, 2=Large box
// 3=Worldspawn, 4=Player, 5=Backpacks, 6=Monsters
// 7=Final (0+3+4+5+6)
//----------------------------------------------------------------------
float ad_shellqty[10], ad_nailqty[10];
float ad_rockqty[10], ad_cellqty[10];
// Totals for weapon, ammo, and monsters
float ad_as_wpnqty, ad_as_ammoqty, ad_as_monqty, ad_as_monlist;
float ad_as_armgrnqty, ad_as_armyelqty, ad_as_armredqty, ad_as_armhpqty;
float ad_as_hp15qty, ad_as_hp25qty, ad_as_hp100qty, ad_as_hpqty;
float ad_as_backgrnqty, ad_as_backyelqty, ad_as_backredqty; 
float ad_as_hpsec, ad_as_backarmqty, ad_as_backarmsec, ad_as_hpfinal;
float ad_as_nightonly, ad_as_cooponly, ad_as_backammo;
float ad_as_monzombie, ad_as_mondelay, ad_as_monnocount;
float ad_as_artsuit, ad_as_artpent, ad_as_artinv, ad_as_artquad;
float ad_as_finalammo, ad_as_zombiehp, ad_as_finalmonhp; 

// Forward compiler references
void() ad_ammostats_phase1;
void() ad_ammostats_phase2;
void() ad_ammostats_phase3;
void() ad_ammostats_phase4;
void() ad_ammostats_phase5;

//----------------------------------------------------------------------
void(entity ad_targ, float ad_ammoqty, string ad_zero10, string ad_zero100, string ad_zero1000, string ad_zero10000, string ad_zero100000) ad_zerofill_number =
{
	// Cap number based on strings
	if (ad_ammoqty > 99999 && ad_zero100000 == "") ad_ammoqty = 99999;
	if (ad_ammoqty > 9999 && ad_zero10000 == "") ad_ammoqty = 9999;
	if (ad_ammoqty > 999 && ad_zero1000 == "") ad_ammoqty = 999;
	if (ad_ammoqty > 99 && ad_zero100 == "") ad_ammoqty = 99;
	// Zero fill based on strings existing
	if (ad_ammoqty < 100000 && ad_zero100000 != "") sprint(ad_targ, ad_zero100000);
	if (ad_ammoqty < 10000 && ad_zero10000 != "") sprint(ad_targ, ad_zero10000);
	if (ad_ammoqty < 1000 && ad_zero1000 != "") sprint(ad_targ, ad_zero1000);
	if (ad_ammoqty < 100 && ad_zero100 != "") sprint(ad_targ, ad_zero100);
	if (ad_ammoqty < 10 && ad_zero10 != "") sprint(ad_targ, ad_zero10);
	sprint(ad_targ, ftos(ad_ammoqty));	
};

//======================================================================
void() ad_display_ammostats =
{
	local float ad_statloop;
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only

	// flush keyboard buffer
	self.impulse = 0;
	// Has the ammo controller been spawned yet?
	if (!ad_ammocontrol) ad_ammocontrol = spawn();
	// What state is the controller in?
	if (ad_ammocontrol.state == ad_AC_PHASE0) {
		// Reset global array values
		ad_statloop = 0;
		while(ad_statloop < ad_MAX_AMMOARRAY) {
			ad_shellqty[ad_statloop] = ad_nailqty[ad_statloop] = 0;
			ad_rockqty[ad_statloop] = ad_cellqty[ad_statloop] = 0;
			ad_statloop = ad_statloop + 1;
		}

		// The world ammo quantities can be over max holdable values
		// But these values are given to the player on spawn and capped!
		// There is no point using any of the excess qty for the stats
		if (world.ammo_shells > ad_AMMO_MAXSHELLS) ad_shellqty[ad_AC_WORLDSPN] = ad_AMMO_MAXSHELLS;
		else ad_shellqty[ad_AC_WORLDSPN] = world.ammo_shells;
		if (world.ammo_nails > ad_AMMO_MAXNAILS) ad_nailqty[ad_AC_WORLDSPN] = ad_AMMO_MAXNAILS;
		else ad_nailqty[ad_AC_WORLDSPN] = world.ammo_nails;
		if (world.ammo_rockets > ad_AMMO_MAXROCKETS) ad_rockqty[ad_AC_WORLDSPN] = ad_AMMO_MAXROCKETS;
		else ad_rockqty[ad_AC_WORLDSPN] = world.ammo_rockets;
		if (world.ammo_cells > ad_AMMO_MAXCELLS) ad_cellqty[ad_AC_WORLDSPN] = ad_AMMO_MAXCELLS;
		else ad_cellqty[ad_AC_WORLDSPN] = world.ammo_cells;
		
		// Self/owner should be player
		ad_ammocontrol.owner = self;
		// next stage of stats
		ad_ammocontrol.state = ad_AC_PHASE1;
		ad_ammocontrol.think = ad_ammostats_phase1;
		ad_ammocontrol.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
// PHASE 1 : WEAPON stats
//----------------------------------------------------------------------
void() ad_ammostats_phase1 =
{
	local float ad_as_shadaxe, ad_as_windowmaker, ad_as_plasmagun;
	local entity ad_entlist;
	//----------------------------------------------------------------
	// List of all WEAPON pickups in the map
	//----------------------------------------------------------------
	ad_as_wpnqty = ad_as_shadaxe = ad_as_plasmagun = ad_as_windowmaker = 0;
	ad_as_artsuit = ad_as_artpent = ad_as_artinv = ad_as_artquad = 0;

	//                    1234567890123456789012345678901234567890
	sprint(self.owner, "\b[--  Ammo and Monster Statistics  --]\b\n"); 
	sprint(self.owner,   "--------------------------------------\n");
	sprint(self.owner, "\bNo Type Ammo Weapon Name\b\n");
	//                    xx xxxx  xxx x---------------------x
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);
	// Keep looping through entity list
	while (ad_entlist) {
		//----------------------------------------------------------------
		// Only interested in weapon pickups
		if (ad_entlist.flags & ad_FL_ITEM && ad_entlist.ad_classgroup == ad_CG_WEAPON) {
			ad_as_wpnqty = ad_as_wpnqty + 1;

			if (ad_entlist.ad_classtype == ad_CT_SHOTGUN || ad_entlist.ad_classtype == ad_CT_SUPER_SHOTGUN 
				|| ad_entlist.ad_classtype == ad_CT_UPGRADE_SSG) {
				ad_shellqty[ad_AC_WEAPON] = ad_shellqty[ad_AC_WEAPON] + ad_entlist.aflag;
				ad_shellqty[ad_AC_SHOTSTART] = ad_TRUE;
				// Reached display limit?
				if (ad_as_wpnqty <= ad_MAX_WPNDISP) {
					ad_zerofill_number(self.owner, ad_as_wpnqty, "0", "", "", "", "");
					sprint(self.owner, " SHEL  ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Display weapon name
					sprint(self.owner, " "); sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
					// Check for zombie damage alternative
					if (ad_entlist.ad_classtype == ad_CT_UPGRADE_SSG) ad_as_windowmaker = ad_TRUE;
				}
			}
			else if (ad_entlist.ad_classtype == ad_CT_NAILGUN || ad_entlist.ad_classtype == ad_CT_SUPER_NAILGUN) {
				ad_nailqty[ad_AC_WEAPON] = ad_nailqty[ad_AC_WEAPON] + ad_entlist.aflag;
				ad_nailqty[ad_AC_SHOTSTART] = ad_TRUE;
				// Reached display limit?
				if (ad_as_wpnqty <= ad_MAX_WPNDISP) {
					ad_zerofill_number(self.owner, ad_as_wpnqty, "0", "", "", "", "");
					sprint(self.owner, " NAIL  ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Display weapon name
					sprint(self.owner, " "); sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
				}
			}
			else if (ad_entlist.ad_classtype == ad_CT_GRENADE_LAUNCHER || ad_entlist.ad_classtype == ad_CT_ROCKET_LAUNCHER) {
				ad_rockqty[ad_AC_WEAPON] = ad_rockqty[ad_AC_WEAPON] + ad_entlist.aflag;
				ad_rockqty[ad_AC_SHOTSTART] = ad_TRUE;
				// Reached display limit?
				if (ad_as_wpnqty <= ad_MAX_WPNDISP) {
					ad_zerofill_number(self.owner, ad_as_wpnqty, "0", "", "", "", "");
					sprint(self.owner, " ROCK  ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Display weapon name
					sprint(self.owner, " "); sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
				}
			}
			else if (ad_entlist.ad_classtype == ad_CT_LIGHTNING || ad_entlist.ad_classtype == ad_CT_UPGRADE_LG) {
				ad_cellqty[ad_AC_WEAPON] = ad_cellqty[ad_AC_WEAPON] + ad_entlist.aflag;
				ad_cellqty[ad_AC_SHOTSTART] = ad_TRUE;
				// Reached display limit?
				if (ad_as_wpnqty <= ad_MAX_WPNDISP) {
					ad_zerofill_number(self.owner, ad_as_wpnqty, "0", "", "", "", "");
					sprint(self.owner, " CELL  ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Display weapon name
					sprint(self.owner, " "); sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
					// Check for zombie damage alternative
					if (ad_entlist.ad_classtype == ad_CT_UPGRADE_LG) ad_as_plasmagun = ad_TRUE;
				}
			}
			// Report the shadow axe (no ammo interest)
			else if (ad_entlist.ad_classtype == ad_CT_UPGRADE_AXE && ad_as_wpnqty <= ad_MAX_WPNDISP) {
				ad_zerofill_number(self.owner, ad_as_wpnqty, "0", "", "", "", "");
				sprint(self.owner, "   --   -- Shadow Axe\n");
				// Alternative way to deal with zombies
				ad_as_shadaxe = ad_TRUE;
			}
			else {
				// unknown weapon type
				if (ad_as_wpnqty <= ad_MAX_WPNDISP) 
					ad_zerofill_number(self.owner, ad_as_wpnqty, "0", "", "", "", "");
					sprint(self.owner, "   --   -- Unknown Weapon\n");
			}
		}
	
		//----------------------------------------------------------------
		// Only interested in artifact items
		if (ad_entlist.flags & ad_FL_ITEM && ad_entlist.ad_classgroup == ad_CG_ARTIFACT) {	
			if (ad_entlist.ad_classtype == ad_CT_ARTSUIT)
				ad_as_artsuit = ad_as_artsuit + 1;
			else if (ad_entlist.ad_classtype == ad_CT_ARTPENT)
				ad_as_artpent = ad_as_artpent + 1;
			else if (ad_entlist.ad_classtype == ad_CT_ARTINVS)
				ad_as_artinv = ad_as_artinv + 1;
			else if (ad_entlist.ad_classtype == ad_CT_ARTQUAD)
				ad_as_artquad = ad_as_artquad + 1;
		}

		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	}
	// Any ITEM weapons found?
	if (ad_as_wpnqty == 0) sprint(self.owner, "NO weapon pickups found!\n");
	// Warn mappers that the weapon display was limited
	// Cannot display too many items, will hit memory issues
	if (ad_as_wpnqty > ad_MAX_WPNDISP) {
		sprint(self.owner, " * Found ("); sprint(self.owner, ftos(ad_as_wpnqty));
		sprint(self.owner, ") showing ("); sprint(self.owner, ftos(ad_MAX_WPNDISP));
		sprint(self.owner, ") only!\n");
	}
	if (ad_as_shadaxe || ad_as_plasmagun || ad_as_windowmaker)
		sprint(self.owner, " * Alt weapons exist to kill zombies!\n");

	// next stage of stats
	ad_ammocontrol.state = ad_AC_PHASE2;
	ad_ammocontrol.think = ad_ammostats_phase2;
	ad_ammocontrol.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// PHASE 2 : AMMO boxes + BACKPACK stats
//----------------------------------------------------------------------
void() ad_ammostats_phase2 =
{
	local float ad_mixedval;
	local entity ad_entlist;
	//----------------------------------------------------------------
	// List of all AMMO pickups in the map
	//----------------------------------------------------------------
	ad_as_wpnqty = ad_as_backammo = 0;
	//                    1234567890123456789012345678901234567890
	sprint(self.owner,   "--------------------------------------\n");
	sprint(self.owner, "\b No Type  Qty L X R Ammo Name\b\n");
	//                    xxx xxxxx xxx x x x x---------------------x
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);
	// Keep looping through entity list
	while (ad_entlist) {
		// Only interested in ammo items
		if (ad_entlist.flags & ad_FL_ITEM && ad_entlist.ad_classgroup == ad_CG_AMMOITEM) {
			if (ad_entlist.ad_classtype == ad_CT_AMMOSHELLS) {
				// Update ammo stats
				ad_as_ammoqty = ad_as_ammoqty + 1;
				ad_shellqty[ad_AC_AMMOQTY] = ad_shellqty[ad_AC_AMMOQTY] + ad_entlist.aflag;
				if (ad_entlist.spawnflags & ad_A_LARGE) ad_shellqty[ad_AC_LARGEBOX] = ad_shellqty[ad_AC_LARGEBOX] + 1;
				else ad_shellqty[ad_AC_SMALLBOX] = ad_shellqty[ad_AC_SMALLBOX] + 1;
				if (ad_entlist.spawnflags & ad_ITEM_RESPAWN || ad_entlist.use == ad_SUB_regen)
					ad_shellqty[ad_AC_RESPAWN] = ad_shellqty[ad_AC_RESPAWN] + ad_entlist.aflag;
				
				// Reached display limit?
				if (ad_as_ammoqty <= ad_MAX_AMMODISP) {
					ad_zerofill_number(self.owner, ad_as_ammoqty, "0", "0", "", "", "");
					sprint(self.owner, " SHELL ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Size of ammo
					if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Extra lid attachment
					if (ad_entlist.spawnflags & ad_A_LID) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Respawn option
					if (ad_entlist.spawnflags & ad_ITEM_RESPAWN) sprint(self.owner, " Y ");
					else sprint(self.owner, " - ");
					// Display ammo name
					sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
				}
			}
			else if (ad_entlist.ad_classtype == ad_CT_AMMONAILS) {
				// Update ammo stats
				ad_as_ammoqty = ad_as_ammoqty + 1;
				ad_nailqty[ad_AC_AMMOQTY] = ad_nailqty[ad_AC_AMMOQTY] + ad_entlist.aflag;
				if (ad_entlist.spawnflags & ad_A_LARGE) ad_nailqty[ad_AC_LARGEBOX] = ad_nailqty[ad_AC_LARGEBOX] + 1;
				else ad_nailqty[ad_AC_SMALLBOX] = ad_nailqty[ad_AC_SMALLBOX] + 1;
				if (ad_entlist.spawnflags & ad_ITEM_RESPAWN || ad_entlist.use == ad_SUB_regen)
					ad_nailqty[ad_AC_RESPAWN] = ad_nailqty[ad_AC_RESPAWN] + ad_entlist.aflag;
				
				// Reached display limit?
				if (ad_as_ammoqty <= ad_MAX_AMMODISP) {
					ad_zerofill_number(self.owner, ad_as_ammoqty, "0", "0", "", "", "");
					sprint(self.owner, " NAIL  ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Size of ammo
					if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Extra lid attachment
					if (ad_entlist.spawnflags & ad_A_LID) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Respawn option
					if (ad_entlist.spawnflags & ad_ITEM_RESPAWN) sprint(self.owner, " Y ");
					else sprint(self.owner, " - ");
					// Display ammo name
					sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
				}
			}
			else if (ad_entlist.ad_classtype == ad_CT_AMMOROCKETS) {
				// Update ammo stats
				ad_as_ammoqty = ad_as_ammoqty + 1;
				ad_rockqty[ad_AC_AMMOQTY] = ad_rockqty[ad_AC_AMMOQTY] + ad_entlist.aflag;
				if (ad_entlist.spawnflags & ad_A_LARGE) ad_rockqty[ad_AC_LARGEBOX] = ad_rockqty[ad_AC_LARGEBOX] + 1;
				else ad_rockqty[ad_AC_SMALLBOX] = ad_rockqty[ad_AC_SMALLBOX] + 1;
				if (ad_entlist.spawnflags & ad_ITEM_RESPAWN || ad_entlist.use == ad_SUB_regen)
					ad_rockqty[ad_AC_RESPAWN] = ad_rockqty[ad_AC_RESPAWN] + ad_entlist.aflag;
				
				// Reached display limit?
				if (ad_as_ammoqty <= ad_MAX_AMMODISP) {
					ad_zerofill_number(self.owner, ad_as_ammoqty, "0", "0", "", "", "");
					sprint(self.owner, " ROCKT ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Size of ammo
					if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Extra frame setup
					if (ad_entlist.ad_frame_box != 0) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Respawn option
					if (ad_entlist.spawnflags & ad_ITEM_RESPAWN) sprint(self.owner, " Y ");
					else sprint(self.owner, " - ");
					// Display ammo name
					sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
				}
			}
			else if (ad_entlist.ad_classtype == ad_CT_AMMOCELLS) {
				// Update ammo stats
				ad_as_ammoqty = ad_as_ammoqty + 1;
				ad_cellqty[ad_AC_AMMOQTY] = ad_cellqty[ad_AC_AMMOQTY] + ad_entlist.aflag;
				if (ad_entlist.spawnflags & ad_A_LARGE) ad_cellqty[ad_AC_LARGEBOX] = ad_cellqty[ad_AC_LARGEBOX] + 1;
				else ad_cellqty[ad_AC_SMALLBOX] = ad_cellqty[ad_AC_SMALLBOX] + 1;
				if (ad_entlist.spawnflags & ad_ITEM_RESPAWN || ad_entlist.use == ad_SUB_regen)
					ad_cellqty[ad_AC_RESPAWN] = ad_cellqty[ad_AC_RESPAWN] + ad_entlist.aflag;
				
				// Reached display limit?
				if (ad_as_ammoqty <= ad_MAX_AMMODISP) {
					ad_zerofill_number(self.owner, ad_as_ammoqty, "0", "0", "", "", "");
					sprint(self.owner, " CELL  ");
					ad_zerofill_number(self.owner, ad_entlist.aflag, "0", " ", "", "", "");
					// Size of ammo
					if (ad_entlist.spawnflags & ad_A_LARGE) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Extra frame setup
					if (ad_entlist.ad_frame_box != 0) sprint(self.owner, " Y");
					else sprint(self.owner, " -");
					// Respawn option
					if (ad_entlist.spawnflags & ad_ITEM_RESPAWN) sprint(self.owner, " Y ");
					else sprint(self.owner, " - ");
					// Display ammo name
					sprint(self.owner, ad_entlist.netname);
					sprint(self.owner, "\n");
				}
			}
			// Fixed ammo setup? (count set = random)
			else if (ad_entlist.ad_classtype == ad_CT_AMMOITEMPACK && ad_entlist.count == 0) {
				// Reset counters
				ad_mixedval = 0;
				// Check for any ammo in backpack?
				if (ad_entlist.ammo_shells > 0) ad_mixedval = ad_mixedval + 1;
				if (ad_entlist.ammo_nails > 0) ad_mixedval = ad_mixedval + 1;
				if (ad_entlist.ammo_rockets > 0) ad_mixedval = ad_mixedval + 1;
				if (ad_entlist.ammo_cells > 0) ad_mixedval = ad_mixedval + 1;
				// Ammo found?
				if (ad_mixedval > 0) {
					// Update ammo stats
					ad_as_ammoqty = ad_as_ammoqty + 1;
					ad_as_backammo = ad_TRUE;
					// Record backpack ammo separately
					ad_shellqty[ad_AC_BACKPACK]= ad_shellqty[ad_AC_BACKPACK]+ ad_entlist.ammo_shells;
					ad_nailqty[ad_AC_BACKPACK] = ad_nailqty[ad_AC_BACKPACK] + ad_entlist.ammo_nails;
					ad_rockqty[ad_AC_BACKPACK] = ad_rockqty[ad_AC_BACKPACK] + ad_entlist.ammo_rockets;
					ad_cellqty[ad_AC_BACKPACK] = ad_cellqty[ad_AC_BACKPACK] + ad_entlist.ammo_cells;

					// Reached display limit?
					if (ad_as_ammoqty <= ad_MAX_AMMODISP) {
						ad_zerofill_number(self.owner, ad_as_ammoqty, "0", "0", "", "", "");
						sprint(self.owner, " BACKP S=");
						ad_zerofill_number(self.owner, ad_entlist.ammo_shells, "0", "0", "", "", "");
						sprint(self.owner, " N=");
						ad_zerofill_number(self.owner, ad_entlist.ammo_nails, "0", "0", "", "", "");
						sprint(self.owner, " R=");
						ad_zerofill_number(self.owner, ad_entlist.ammo_rockets, "0", "0", "", "", "");
						sprint(self.owner, " C=");
						ad_zerofill_number(self.owner, ad_entlist.ammo_cells, "0", "0", "", "", "");
						sprint(self.owner, "\n");	
					}
				}
			}
		}
		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	}
	// ERROR = AMMO items found?
	if (ad_as_ammoqty == 0) {
		sprint(self.owner, "--------------------------------------\n");
		sprint(self.owner, "\b[ERROR]\b No Ammo ITEMS found!\n");
		sprint(self.owner, " * Cannot create Ammo & Monster Stats!\n\n");
		ad_ammocontrol.state = ad_AC_PHASE0;
		return;
	}
	// Warn mappers that the ammo display was limited
	// Cannot display too many items, will hit memory issues
	if (ad_as_ammoqty > ad_MAX_AMMODISP) {
		sprint(self.owner, " * Found ("); sprint(self.owner, ftos(ad_as_ammoqty));
		sprint(self.owner, ") showing ("); sprint(self.owner, ftos(ad_MAX_AMMODISP));
		sprint(self.owner, ") only\n");
	}
	// next stage of stats
	ad_ammocontrol.state = ad_AC_PHASE3;
	ad_ammocontrol.think = ad_ammostats_phase3;
	ad_ammocontrol.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// Display MONSTER Summary for the map
//----------------------------------------------------------------------
void(entity ad_targ) ad_ammostats_monsummary =
{
	//              1234567890123456789012345678901234567890
	sprint(ad_targ,   "======================================\n");
	sprint(ad_targ, "\bMonstrs Qty NoC Dly +NM +CO Zomb    HP\b\n");
	//              Total  xxxx xxx xxx xxx xxx xxx xxxxxx

	sprint(ad_targ, "Total   ");
	ad_zerofill_number(ad_targ, ad_as_monqty, " ", " ", "", "", "");
	sprint(ad_targ, " "); 
	ad_zerofill_number(ad_targ, ad_as_monnocount, " ", " ", "", "", "");
	sprint(ad_targ, " "); 
	ad_zerofill_number(ad_targ, ad_as_mondelay, " ", " ", "", "", "");
	sprint(ad_targ, " "); 
	ad_zerofill_number(ad_targ, ad_as_nightonly, " ", " ", "", "", "");
	sprint(ad_targ, " "); 
	ad_zerofill_number(ad_targ, ad_as_cooponly, " ", " ", "", "", "");
	sprint(ad_targ, " "); 
	ad_zerofill_number(ad_targ, ad_as_monzombie, " ", " ", "", "", "");
	sprint(ad_targ, " "); 
	ad_zerofill_number(ad_targ, ad_as_finalmonhp, "0", "0", " ", " ", " ");
	sprint(ad_targ, "\n"); 
};

//----------------------------------------------------------------
// Display ARTIFACT Summary for the map
//----------------------------------------------------------------
void(entity ad_targ) ad_ammostats_artsummary =
{
	local float ad_artqty;
	//              1234567890123456789012345678901234567890
	sprint(ad_targ,   "--------------------------------------\n");
	sprint(ad_targ, "\bArtifact Suit  Pent  InvR  Quad  Total\b\n");
	//              Totals   xxxx  xxxx  xxxx  xxxx   xxxx

	ad_artqty = ad_as_artsuit + ad_as_artpent + ad_as_artinv + ad_as_artquad;
	sprint(ad_targ, "Totals   ");
	ad_zerofill_number(ad_targ, ad_as_artsuit, " ", " ", " ", "", "");
	sprint(ad_targ, "  "); 
	ad_zerofill_number(ad_targ, ad_as_artpent, " ", " ", " ", "", "");
	sprint(ad_targ, "  "); 
	ad_zerofill_number(ad_targ, ad_as_artinv, " ", " ", " ", "", "");
	sprint(ad_targ, "  "); 
	ad_zerofill_number(ad_targ, ad_as_artquad, " ", " ", " ", "", "");
	sprint(ad_targ, "   "); 
	ad_zerofill_number(ad_targ, ad_artqty, " ", " ", " ", "", "");
	sprint(ad_targ, "\n"); 
};

//----------------------------------------------------------------------
// PHASE 3 : Count MONSTERS and display summary table
//----------------------------------------------------------------------
void() ad_ammostats_phase3 =
{
	local entity ad_entlist;
	//----------------------------------------------------------------
	// FIND all MONSTERS in the map
	//----------------------------------------------------------------
	ad_as_monqty = ad_as_monlist = ad_as_finalmonhp = ad_as_zombiehp = 0;
	ad_as_nightonly = ad_as_cooponly = 0;
	ad_as_monzombie = ad_as_mondelay = ad_as_monnocount = 0;
	
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);
	// Keep looping through entity list
	while (ad_entlist) {
		// Only interested in monsters
		if (ad_entlist.flags & ad_FL_MONSTER) {
			// Spawn exceptions
			if (ad_entlist.ad_nightmare == ad_TRUE)
				ad_as_nightonly = ad_as_nightonly + 1;
			if (ad_entlist.ad_cooponly == ad_TRUE)
				ad_as_cooponly = ad_as_cooponly + 1;
			
			// Is the monster designed for nightmare skill only?
			if (ad_entlist.ad_nightmare && ad_skill != ad_SKILL_NIGHTMARE) {
				// Easier to do nothing
			}
			// Is the monster designed for coop only?
			else if (ad_entlist.ad_cooponly && coop == ad_FALSE) {
				// Easier to do nothing
			}
			else {
				// Total monsters in map might be different to HUD
				// Exceptions = nomonstercount, delaymonstercount
				ad_as_monqty = ad_as_monqty + 1;
				
				// Include any backpack ammo drops
				ad_shellqty[ad_AC_MONSTER]= ad_shellqty[ad_AC_MONSTER]+ ad_entlist.ammo_shells;
				ad_nailqty[ad_AC_MONSTER] = ad_nailqty[ad_AC_MONSTER] + ad_entlist.ammo_nails;
				ad_rockqty[ad_AC_MONSTER] = ad_rockqty[ad_AC_MONSTER] + ad_entlist.ammo_rockets;
				ad_cellqty[ad_AC_MONSTER] = ad_cellqty[ad_AC_MONSTER] + ad_entlist.ammo_cells;
				
				// Keep track of zombie's, they need rockets!
				if (ad_entlist.ad_classgroup == ad_CG_ZOMBIE) {
					// Exception = crucified zombies
					if (!(ad_entlist.spawnflags & ad_MON_CRUCIFIED)) {
						ad_as_monzombie = ad_as_monzombie + 1;
						ad_as_zombiehp = ad_as_zombiehp + ad_entlist.max_health;
					}
				}
				// Keep track of spawn delay monsters
				if (ad_entlist.spawnflags & ad_MON_SPAWN_DELAY)
					ad_as_mondelay = ad_as_mondelay + 1;
				// Keep track of monsters with no count
				if (ad_entlist.ad_nomonstercount > 0 || ad_entlist.ad_delaymonstercount > 0)
					ad_as_monnocount = ad_as_monnocount + 1;
				// Keep track of all monster HP, exclude negative + boss
				if (ad_entlist.max_health > 0 && !ad_entlist.ad_bossflag) {
					// Some monsters reset HP later
					if (ad_entlist.ad_reset_health > 0) 
						ad_as_finalmonhp = ad_as_finalmonhp + ad_entlist.ad_reset_health;
					// Anything over 9999 is a special setup (don't include it)
					else if (ad_entlist.max_health < 9999) {
						ad_as_finalmonhp = ad_as_finalmonhp + ad_entlist.max_health;	
					}
				}
			}
		}
		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	} 

	// ERROR = No MONSTERS found?
	if (ad_as_monqty == 0) {
		sprint(self.owner, "--------------------------------------\n");
		sprint(self.owner, "\b[ERROR]\b Missing any MONSTERS!\n");
		sprint(self.owner, " * Cannot create Ammo & Monster Stats!\n\n");
		ad_ammocontrol.state = ad_AC_PHASE0;
		return;
	}
		
	// Display Summary stuff for the map
	ad_ammostats_monsummary(self.owner);
	ad_ammostats_artsummary(self.owner);

	// next stage of stats
	ad_ammocontrol.state = ad_AC_PHASE4;
	ad_ammocontrol.think = ad_ammostats_phase4;
	ad_ammocontrol.nextthink = time + 0.1;
};
	
//----------------------------------------------------------------------
// PHASE 4 : Count ARMOUR and HEALTH packs
//----------------------------------------------------------------------
void() ad_ammostats_phase4 =
{
	local entity ad_entlist;
	//----------------------------------------------------------------
	// FIND all armour/health packs
	//----------------------------------------------------------------
	ad_as_armgrnqty = ad_as_armyelqty = ad_as_armredqty = ad_as_armhpqty = 0;
	ad_as_hp15qty = ad_as_hp25qty = ad_as_hp100qty = ad_as_hpqty = ad_as_hpsec = 0;
	ad_as_backgrnqty = ad_as_backyelqty = ad_as_backredqty = 0;
	ad_as_backarmqty = ad_as_backarmsec = ad_as_hpfinal = 0;
	
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);
	// Keep looping through entity list
	while (ad_entlist) {
		// Interested in health items
		if (ad_entlist.flags & ad_FL_ITEM && ad_entlist.ad_classgroup == ad_CG_HEALTH) {
			ad_as_hpqty = ad_as_hpqty + ad_entlist.healamount;
			if (ad_entlist.ad_classtype == ad_CT_HEALROT)
				ad_as_hp15qty = ad_as_hp15qty + 1;
			else if (ad_entlist.ad_classtype == ad_CT_HEALNORM)
				ad_as_hp25qty = ad_as_hp25qty + 1;
			else if (ad_entlist.ad_classtype == ad_CT_HEALMEGA)
				ad_as_hp100qty = ad_as_hp100qty + 1;
		}
		// Interested in armour items
		if (ad_entlist.flags & ad_FL_ITEM && ad_entlist.ad_classgroup == ad_CG_ARMOR) {
			ad_as_armhpqty = ad_as_armhpqty + ad_entlist.armorvalue;
			if (ad_entlist.ad_classtype == ad_CT_ARMOR1)
				ad_as_armgrnqty = ad_as_armgrnqty + 1;
			else if (ad_entlist.ad_classtype == ad_CT_ARMOR2)
				ad_as_armyelqty = ad_as_armyelqty + 1;
			else if (ad_entlist.ad_classtype == ad_CT_ARMORINV)
				ad_as_armredqty = ad_as_armredqty + 1;
		}		
		// Interested in backpack (armour) items
		if (ad_entlist.flags & ad_FL_ITEM && ad_entlist.ad_classtype == ad_CT_ARMORITEMPACK) {
			if (ad_entlist.armorvalue > 0) {
				ad_as_backarmqty = ad_as_backarmqty + ad_entlist.armorvalue;
				if (ad_entlist.armortype == ad_ARMOR_GRN_TYPE || ad_entlist.armortype == 0)
					ad_as_backgrnqty = ad_as_backgrnqty + 1;
				else if (ad_entlist.armortype == ad_ARMOR_YEL_TYPE)
					ad_as_backyelqty = ad_as_backyelqty + 1;
				else if (ad_entlist.armortype == ad_ARMOR_RED_TYPE)
					ad_as_backredqty = ad_as_backredqty + 1;
				// Exclude YA / RA from pickups
				if (ad_entlist.armortype != ad_ARMOR_YEL_TYPE && ad_entlist.armortype != ad_ARMOR_RED_TYPE)
					ad_as_backarmsec = ad_as_backarmsec + ad_entlist.armorvalue;
			}
		}
		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	}
	
	// Calculate Health Points with NO SECRETS (usually MH or RED)
	ad_as_hpsec = (ad_as_hp15qty*ad_HEAL_ROT) + (ad_as_hp25qty*ad_HEAL_NORM);
	ad_as_hpsec = ad_as_hpsec + (ad_as_armgrnqty*ad_ARMOR_GRN_VALUE) + (ad_as_armyelqty*ad_ARMOR_YEL_VALUE);
	ad_as_hpfinal = ad_as_hpsec + ad_as_backarmsec;
	
	//              1234567890123456789012345678901234567890
	sprint(self.owner,   "--------------------------------------\n");
	sprint(self.owner, "\bHEALTH  15 25 MH GA YA RA Total  -MHRA\b\n");
	//                    Pickup  xx xx xx xx xx xx xxxxx  xxxxx
	//                    BackPck          xx xx xx xxxxx  xxxxx
	sprint(self.owner, "Pickup  ");
	ad_zerofill_number(self.owner, ad_as_hp15qty, " ", "", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_hp25qty, " ", "", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_hp100qty, " ", "", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_armgrnqty, " ", "", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_armyelqty, " ", "", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_armredqty, " ", "", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_hpqty+ad_as_armhpqty, "0", " ", " ", " ", "");
	sprint(self.owner, "  "); 
	ad_zerofill_number(self.owner, ad_as_hpsec, "0", " ", " ", " ", "");
	sprint(self.owner, "\n");

	// Any armour backpacks in map?
	if (ad_as_backarmqty > 0) {
		sprint(self.owner, "BackPck          ");
		ad_zerofill_number(self.owner, ad_as_backgrnqty, " ", "", "", "", "");
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_backyelqty, " ", "", "", "", "");
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_backredqty, " ", "", "", "", "");
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_backarmqty, "0", " ", " ", " ", "");
		sprint(self.owner, "  "); 
		ad_zerofill_number(self.owner, ad_as_backarmsec, "0", " ", " ", " ", "");
		sprint(self.owner, "\n");
	}
	
	// next stage of stats
	ad_ammocontrol.state = ad_AC_PHASE5;
	ad_ammocontrol.think = ad_ammostats_phase5;
	ad_ammocontrol.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// PHASE 5 : Finally display data tables
//----------------------------------------------------------------------
void() ad_ammostats_phase5 =
{
	local float ad_subtwbm, ad_subtsml, ad_subtlrg, ad_totalrock;
	local float ad_hpmon_ammo_ratio, ad_hparm_hpmon_ratio;
	local float ad_nozombammo, ad_nozombmonhp, ad_nobackammo, ad_shotgunstart;
	local float ad_nobackshell, ad_nobacknail, ad_nobackrock, ad_nobackcell;
	//----------------------------------------------------------------
	// Final table 
	//----------------------------------------------------------------
	//                    1234567890123456789012345678901234567890
	sprint(self.owner,   "--------------------------------------\n");
	sprint(self.owner, "\bSource        Shell  Nail  Rock   Cell\b\n");
	//                    x-----------x  xxxx  xxxx  xxxx   xxxx

	// Current ammo quantity in player inventory (not included in stats)
	if (self.owner.ammo_shells != 25) {
		sprint(self.owner, "Player Inv     "); 
		ad_zerofill_number(self.owner, self.owner.ammo_shells, " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, self.owner.ammo_nails, " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, self.owner.ammo_rockets, " ", " ", " ", "", "");
		sprint(self.owner, "   "); ad_zerofill_number(self.owner, self.owner.ammo_cells, " ", " ", " ", "", "");
		sprint(self.owner, "\n");
	}
	// All ammo item pickups
	sprint(self.owner, "Ammo Boxes     "); 
	ad_zerofill_number(self.owner, ad_shellqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, "   "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner,"\n");
	// All ammo item pickups
	ad_subtwbm = ad_shellqty[ad_AC_RESPAWN] + ad_nailqty[ad_AC_RESPAWN] + ad_rockqty[ad_AC_RESPAWN] + ad_cellqty[ad_AC_RESPAWN];
	if (ad_subtwbm > 0) {
		sprint(self.owner, "Respawn Ammo   "); 
		ad_zerofill_number(self.owner, ad_shellqty[ad_AC_RESPAWN], " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_RESPAWN], " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_RESPAWN], " ", " ", " ", "", "");
		sprint(self.owner, "   "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_RESPAWN], " ", " ", " ", "", "");
		sprint(self.owner,"\n");
	}
	// All ammo from weapons
	sprint(self.owner, "Weapon Pickups "); 
	ad_zerofill_number(self.owner, ad_shellqty[ad_AC_WEAPON], " ", " ", " ", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_WEAPON], " ", " ", " ", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_WEAPON], " ", " ", " ", "", "");
	sprint(self.owner, "   "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_WEAPON], " ", " ", " ", "", "");
	sprint(self.owner,"\n");
	
	// AD only feature; Change start ammo for player
	ad_subtwbm = world.ammo_shells + world.ammo_nails + world.ammo_rockets + world.ammo_cells;
	if (ad_subtwbm > 0) {
		sprint(self.owner, "Worldspawn     "); 
		ad_zerofill_number(self.owner, world.ammo_shells, " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, world.ammo_nails, " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, world.ammo_rockets, " ", " ", " ", "", "");
		sprint(self.owner, "   "); ad_zerofill_number(self.owner, world.ammo_cells, " ", " ", " ", "", "");
		sprint(self.owner, "\n");
	}
	// All ammo from backpacks
	if (ad_as_backammo == ad_TRUE) {
		sprint(self.owner, "Backpacks      "); 
		ad_zerofill_number(self.owner, ad_shellqty[ad_AC_BACKPACK], " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_BACKPACK], " ", " ", " ", "", "");
		sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_BACKPACK], " ", " ", " ", "", "");
		sprint(self.owner, "   "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_BACKPACK], " ", " ", " ", "", "");
		sprint(self.owner,"\n");
	}
	// All ammo from monsters
	sprint(self.owner, "Monster Drops  "); 
	ad_zerofill_number(self.owner, ad_shellqty[ad_AC_MONSTER], " ", " ", " ", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_MONSTER], " ", " ", " ", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_MONSTER], " ", " ", " ", "", "");
	sprint(self.owner, "   "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_MONSTER], " ", " ", " ", "", "");
	sprint(self.owner,"\n");
	//sprint(self.owner, " * World qty capped, player excluded\n");
	
	ad_totalrock = ad_rockqty[ad_AC_AMMOQTY] + ad_rockqty[ad_AC_BACKPACK] + ad_rockqty[ad_AC_WORLDSPN] + ad_rockqty[ad_AC_WEAPON] + ad_rockqty[ad_AC_MONSTER];
	if (ad_totalrock < ad_as_monzombie)
		sprint(self.owner, " * Rocket quantity less than zombies!\n");
	
	// List of all ammo stats
	sprint(self.owner,   "--------------------------------------\n");
	sprint(self.owner, "\bAmmo   Sml Lrg  Qty Wpn WBM Dmg  Total\b\n");
	//                    xxxxxx xxx xxx xxxx xxx xxx xxx  xxxxxx
	//                    Total  xxx xxx                   xxxxxx
	
	ad_subtwbm = ad_shellqty[ad_AC_WORLDSPN] + ad_shellqty[ad_AC_BACKPACK] + ad_shellqty[ad_AC_MONSTER];
	ad_shellqty[ad_AC_AMMOFINAL] = ( ad_shellqty[ad_AC_AMMOQTY] + ad_shellqty[ad_AC_WEAPON] + ad_subtwbm ) * ad_DAMAGE_SHELL;
	ad_as_finalammo = ad_shellqty[ad_AC_AMMOFINAL];
	sprint(self.owner, "Shell  "); ad_zerofill_number(self.owner, ad_shellqty[ad_AC_SMALLBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_shellqty[ad_AC_LARGEBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_shellqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_shellqty[ad_AC_WEAPON], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_subtwbm, " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_DAMAGE_SHELL, " ", " ", "", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_shellqty[ad_AC_AMMOFINAL], "0", "0", "0", " ", "");
	sprint(self.owner, " \n");

	ad_subtwbm = ad_nailqty[ad_AC_WORLDSPN] + ad_nailqty[ad_AC_BACKPACK] + ad_nailqty[ad_AC_MONSTER];
	ad_nailqty[ad_AC_AMMOFINAL] = (ad_nailqty[ad_AC_AMMOQTY] + ad_nailqty[ad_AC_WEAPON] + ad_subtwbm) * ad_DAMAGE_NGSPIKE;
	ad_as_finalammo = ad_as_finalammo + ad_nailqty[ad_AC_AMMOFINAL];
	sprint(self.owner, "Nail   "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_SMALLBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_LARGEBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_WEAPON], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_subtwbm, " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_DAMAGE_NGSPIKE, " ", " ", "", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_nailqty[ad_AC_AMMOFINAL], "0", "0", "0", " ", "");
	sprint(self.owner, " \n");

	ad_subtwbm = ad_rockqty[ad_AC_WORLDSPN] + ad_rockqty[ad_AC_BACKPACK] + ad_rockqty[ad_AC_MONSTER];
	ad_rockqty[ad_AC_AMMOFINAL] = (ad_rockqty[ad_AC_AMMOQTY] + ad_rockqty[ad_AC_WEAPON] + ad_subtwbm) * ad_DAMAGE_PLAYGRENADE;
	ad_as_finalammo = ad_as_finalammo + ad_rockqty[ad_AC_AMMOFINAL];
	sprint(self.owner, "Rocket "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_SMALLBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_LARGEBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_WEAPON], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_subtwbm, " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_DAMAGE_PLAYGRENADE, " ", " ", "", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_rockqty[ad_AC_AMMOFINAL], "0", "0", "0", " ", "");
	sprint(self.owner, " \n");

	ad_subtwbm = ad_cellqty[ad_AC_WORLDSPN] + ad_cellqty[ad_AC_BACKPACK] + ad_cellqty[ad_AC_MONSTER];
	ad_cellqty[ad_AC_AMMOFINAL] = (ad_cellqty[ad_AC_AMMOQTY] + ad_cellqty[ad_AC_WEAPON] + ad_subtwbm) * ad_DAMAGE_LGPLAYER;
	ad_as_finalammo = ad_as_finalammo + ad_cellqty[ad_AC_AMMOFINAL];
	sprint(self.owner, "Cell   "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_SMALLBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_LARGEBOX], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_AMMOQTY], " ", " ", " ", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_WEAPON], " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_subtwbm, " ", " ", "", "", "");
	sprint(self.owner, " "); ad_zerofill_number(self.owner, ad_DAMAGE_LGPLAYER, " ", " ", "", "", "");
	sprint(self.owner, "  "); ad_zerofill_number(self.owner, ad_cellqty[ad_AC_AMMOFINAL], "0", "0", "0", " ", "");
	sprint(self.owner, " \n");

	ad_subtsml = ad_shellqty[ad_AC_SMALLBOX] + ad_nailqty[ad_AC_SMALLBOX] + ad_rockqty[ad_AC_SMALLBOX] + ad_cellqty[ad_AC_SMALLBOX];
	ad_subtlrg = ad_shellqty[ad_AC_LARGEBOX] + ad_nailqty[ad_AC_LARGEBOX] + ad_rockqty[ad_AC_LARGEBOX] + ad_cellqty[ad_AC_LARGEBOX];
	
	sprint(self.owner, "Total  "); 
	ad_zerofill_number(self.owner, ad_subtsml, " ", " ", "", "", "");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_subtlrg, " ", " ", "", "", "");
	sprint(self.owner, "                  ");
	ad_zerofill_number(self.owner, ad_as_finalammo, "0", " ", " ", " ", " ");
	sprint(self.owner, " \n");
	
	//----------------------------------------------------------------
	// Display FINAL Stats for the map
	//----------------------------------------------------------------
	// How much ammo there is in the map compared to monster HP
	// Positive ratio means MORE THAN ENOUGH ammo to deal with monsters
	// Negative ratio means NOT ENOUGH ammo to deal with  all monsters
	//                    1234567890123456789012345678901234567890
	sprint(self.owner,   "======================================\n");
	sprint(self.owner, "\bSkill (\b"); sprint(self.owner, ftos(ad_skill));
	sprint(self.owner, "\b)    HPvMo  MonHP   Ammo Ratio\b\n");
	//                    Skill (x)    HPvMo  MonHP   Ammo Ratio
	//                    All Monsters xx.xx xxxxxx xxxxxx xx.xx
	//                    No Zombies   xx.xx xxxxxx xxxxxx xx.xx
	//                    No Backpacks xx.xx xxxxxx xxxxxx xx.xx
	//                    Shotgun Strt xx.xx xxxxxx xxxxxx xx.xx

	// Standard ratio (no accounting for explosives)
	ad_hpmon_ammo_ratio = ad_as_finalammo / ad_as_finalmonhp;
	ad_hparm_hpmon_ratio = (ad_as_hpfinal / ad_as_finalmonhp)*1000;
	sprint(self.owner, "All Monsters ");
	ad_lftos(self.owner, ad_hparm_hpmon_ratio, 2, 2, ad_BUFFER_SPRINT);
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_finalmonhp, "0", " ", " ", " ", " ");
	sprint(self.owner, " "); 
	ad_zerofill_number(self.owner, ad_as_finalammo, "0", " ", " ", " ", " ");
	sprint(self.owner, " ");
	ad_lftos(self.owner, ad_hpmon_ammo_ratio, 2, 2, ad_BUFFER_SPRINT);
	sprint(self.owner, "\n"); 

	// Zombie ratio (need explosives to be destroyed)
	// Skip this condition if no zombies on map!
	if (ad_as_monzombie > 0) {
		ad_nozombmonhp = ad_as_finalmonhp-ad_as_zombiehp;
		ad_nozombammo = ad_as_finalammo - (ad_as_monzombie * ad_DAMAGE_PLAYGRENADE);
		ad_hpmon_ammo_ratio = ad_nozombammo / ad_nozombmonhp;
		ad_hparm_hpmon_ratio = (ad_as_hpfinal / ad_nozombmonhp)*1000;
		sprint(self.owner, "No Zombies   ");
		ad_lftos(self.owner, ad_hparm_hpmon_ratio, 2, 2, ad_BUFFER_SPRINT);
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_nozombmonhp, "0", " ", " ", " ", " ");
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_nozombammo, "0", " ", " ", " ", " ");
		sprint(self.owner, " ");
		ad_lftos(self.owner, ad_hpmon_ammo_ratio, 2, 2, ad_BUFFER_SPRINT);
		sprint(self.owner, "\n"); 
	}

	// No backpack option, often given as secret items
	// Detect any backpacks (as_backammo) and subtract ammo
	if (ad_as_backammo == ad_TRUE) {
		ad_nobackshell = ad_shellqty[ad_AC_BACKPACK] * ad_DAMAGE_SHELL;
		ad_nobacknail = ad_nailqty[ad_AC_BACKPACK] * ad_DAMAGE_NGSPIKE;
		ad_nobackrock = ad_rockqty[ad_AC_BACKPACK] * ad_DAMAGE_PLAYGRENADE;
		ad_nobackcell = ad_cellqty[ad_AC_BACKPACK] * ad_DAMAGE_LGPLAYER;
		ad_nobackammo = ad_nobackshell + ad_nobacknail + ad_nobackrock + ad_nobackcell;
		ad_hpmon_ammo_ratio = (ad_as_finalammo - ad_nobackammo) / ad_as_finalmonhp;
		ad_hparm_hpmon_ratio = (ad_as_hpfinal / ad_as_finalmonhp)*1000;
		sprint(self.owner, "No Backpacks ");
		ad_lftos(self.owner, ad_hparm_hpmon_ratio, 2, 2, ad_BUFFER_SPRINT);
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_finalmonhp, "0", " ", " ", " ", " ");
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_finalammo - ad_nobackammo, "0", " ", " ", " ", " ");
		sprint(self.owner, " ");
		ad_lftos(self.owner, ad_hpmon_ammo_ratio, 2, 2, ad_BUFFER_SPRINT);
		sprint(self.owner, "\n"); 
	}
		
	// Check for Shotgun Start (Have ammo, but missing gun)
	ad_shotgunstart = ad_FALSE;
	// Shotguns + shell ammo
	if (ad_shellqty[ad_AC_SHOTSTART] == ad_FALSE && ad_shellqty[ad_AC_AMMOFINAL] > 0)
		ad_shotgunstart = ad_TRUE;
	// Nailguns + nail ammo
	if (ad_nailqty[ad_AC_SHOTSTART] == ad_FALSE && ad_nailqty[ad_AC_AMMOFINAL] > 0)
		ad_shotgunstart = ad_TRUE;
	// Grenade and rocket launcher + rocket ammo
	if (ad_rockqty[ad_AC_SHOTSTART] == ad_FALSE && ad_rockqty[ad_AC_AMMOFINAL] > 0)
		ad_shotgunstart = ad_TRUE;
	// Lightning and plasma gun + cell ammo
	if (ad_cellqty[ad_AC_SHOTSTART] == ad_FALSE && ad_rockqty[ad_AC_AMMOFINAL] > 0)
		ad_shotgunstart = ad_TRUE;
		
	// Any ammo + weapon missing?
	if (ad_shotgunstart == ad_TRUE) {
		ad_as_finalammo = 0;
		if (ad_shellqty[ad_AC_SHOTSTART] == ad_TRUE)
			ad_as_finalammo = ad_as_finalammo + ad_shellqty[ad_AC_AMMOFINAL];
		if (ad_nailqty[ad_AC_SHOTSTART] == ad_TRUE)
			ad_as_finalammo = ad_as_finalammo + ad_nailqty[ad_AC_AMMOFINAL];
		if (ad_rockqty[ad_AC_SHOTSTART] == ad_TRUE)
			ad_as_finalammo = ad_as_finalammo + ad_rockqty[ad_AC_AMMOFINAL];
		if (ad_cellqty[ad_AC_SHOTSTART] == ad_TRUE)
			ad_as_finalammo = ad_as_finalammo + ad_cellqty[ad_AC_AMMOFINAL];
		
		ad_hpmon_ammo_ratio = ad_as_finalammo / ad_as_finalmonhp;
		ad_hparm_hpmon_ratio = (ad_as_hpfinal / ad_as_finalmonhp)*1000;
		sprint(self.owner, "Shotgun Strt ");
		ad_lftos(self.owner, ad_hparm_hpmon_ratio, 2, 2, ad_BUFFER_SPRINT);
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_finalmonhp, "0", " ", " ", " ", " ");
		sprint(self.owner, " "); 
		ad_zerofill_number(self.owner, ad_as_finalammo, "0", " ", " ", " ", " ");
		sprint(self.owner, " ");
		ad_lftos(self.owner, ad_hpmon_ammo_ratio, 2, 2, ad_BUFFER_SPRINT);
		sprint(self.owner, "\n");
	}
		
	// Last stage
	ad_ammocontrol.state = ad_AC_PHASE0;
};
	
//======================================================================
// Display monsters left alive in map
//======================================================================
void() ad_display_monsleft =
{
	local float ad_entcount, ad_montotal, ad_monalive, ad_mondead;
	local entity ad_entlist;
	
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only

	// flush keyboard buffer
	self.impulse = 0;
	// Reset counters
	ad_entcount = ad_montotal = ad_monalive = ad_mondead = 0;

	sprint(self, "\b[-- Monsters Alive and Kicking --]\b\n"); 
	sprint(self, "--------------------------------------\n");
	sprint(self, " No   HP D Classname + XYZ location\n");
	//            xxx xxxx x x------------------------------x
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);

	// Keep looping through entity list
	while (ad_entlist) {
		// Found another entity
		ad_entcount = ad_entcount + 1;
		// Only interested in monsters (regular + boss)
		if (ad_entlist.flags & ad_FL_MONSTER || ad_entlist.ad_bossflag) {
			// Keep counting up monsters
			ad_montotal = ad_montotal + 1;
			
			if (ad_entlist.health > 0) {
				ad_monalive = ad_monalive + 1;
				if (ad_monalive <= ad_MAX_MONCOUNT) {
					// Update console display
					ad_zerofill_number(self, ad_monalive, "0", "0", "", "", "");
					sprint(self, " ");
					ad_zerofill_number(self, ad_entlist.health, " ", " ", " ", "", "");
					// Check for monster spawn delay (flag)
					if (ad_entlist.spawnflags & ad_MON_SPAWN_DELAY) sprint(self, " Y ");
					else sprint(self, " - ");
					// Print monster class and position
					sprint(self, ad_entlist.classname); sprint(self, " ");
					sprint(self, vtos(ad_entlist.origin)); sprint(self, "\n");
				}
				// Only report the first xxx monsters
				// Otherwise will get SZ_GETSPACE : OVERFLOW error
				if (ad_monalive == (ad_MAX_MONCOUNT+1)) {
					sprint(self, " * Can only list ");
					sprint(self, ftos(ad_MAX_MONCOUNT));
					sprint(self, "monsters!\n");
				}
			}
			// Monster found is dead
			else ad_mondead = ad_mondead + 1;			
		}		
		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	}
	sprint(self, "--------------------------------------\n");
	sprint(self, "Monster Total ("); sprint(self, ftos(ad_montotal));
	sprint(self, ") Alive ("); sprint(self, ftos(ad_monalive));
	sprint(self, ") Dead ("); sprint(self, ftos(ad_mondead));
	sprint(self, ")\n");
	sprint(self, "Player location "); sprint(self, vtos(self.origin));
	sprint(self, "\n\n");
};

//======================================================================
// Display quantity of different monster types
//======================================================================
void() ad_display_monsqty =
{
	// Monster Array of quantity/hp differences
	local entity ad_asmonent[ad_MAX_MONARRAY];
	local float ad_asmonqty[ad_MAX_MONARRAY], ad_asmonhp[ad_MAX_MONARRAY];

	local float ad_monloop, ad_monfound, ad_monarrayfull, ad_subtmonhp;
	local entity ad_entlist;
	
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only

	// flush keyboard buffer
	self.impulse = 0;

	//----------------------------------------------------------------
	// FIND all MONSTERS in the map
	//----------------------------------------------------------------
	ad_as_monqty = ad_as_monlist = ad_as_finalmonhp = 0;
	ad_as_nightonly = ad_as_cooponly = ad_as_backammo = 0;
	ad_as_monzombie = ad_as_zombiehp = ad_as_mondelay = ad_as_monnocount = 0;
	ad_monarrayfull = ad_FALSE;
	
	// Start from beginning of entity list, world!
	ad_entlist = nextent(world);
	// Keep looping through entity list
	while (ad_entlist) {
		// Only interested in monsters
		if (ad_entlist.flags & ad_FL_MONSTER) {
			// Spawn exceptions
			if (ad_entlist.ad_nightmare == ad_TRUE)
				ad_as_nightonly = ad_as_nightonly + 1;
			if (ad_entlist.ad_cooponly == ad_TRUE)
				ad_as_cooponly = ad_as_cooponly + 1;
			
			// Is the monster designed for nightmare skill only?
			if (ad_entlist.ad_nightmare && ad_skill != ad_SKILL_NIGHTMARE) {
				// Easier to do nothing
			}
			// Is the monster designed for coop only?
			else if (ad_entlist.ad_cooponly && coop == ad_FALSE) {
				// Easier to do nothing
			}
			else {
				// Total monsters in map might be different to HUD
				// Exceptions = nomonstercount, delaymonstercount
				ad_as_monqty = ad_as_monqty + 1;
				
				// Include any backpack ammo drops
				ad_shellqty[ad_AC_MONSTER]= ad_shellqty[ad_AC_MONSTER]+ ad_entlist.ammo_shells;
				ad_nailqty[ad_AC_MONSTER] = ad_nailqty[ad_AC_MONSTER] + ad_entlist.ammo_nails;
				ad_rockqty[ad_AC_MONSTER] = ad_rockqty[ad_AC_MONSTER] + ad_entlist.ammo_rockets;
				ad_cellqty[ad_AC_MONSTER] = ad_cellqty[ad_AC_MONSTER] + ad_entlist.ammo_cells;
				
				// Keep track of zombie's, they need rockets!
				if (ad_entlist.ad_classgroup == ad_CG_ZOMBIE) {
					// Exception = crucified zombies
					if (!(ad_entlist.spawnflags & ad_MON_CRUCIFIED)) {
						ad_as_monzombie = ad_as_monzombie + 1;
						ad_as_zombiehp = ad_as_zombiehp + ad_entlist.max_health;
					}
				}
				// Keep track of spawn delay monsters
				if (ad_entlist.spawnflags & ad_MON_SPAWN_DELAY)
					ad_as_mondelay = ad_as_mondelay + 1;
				// Keep track of monsters with no count
				if (ad_entlist.ad_nomonstercount > 0 || ad_entlist.ad_delaymonstercount > 0)
					ad_as_monnocount = ad_as_monnocount + 1;
				// Keep track of all monster HP, exclude negative + boss
				if (ad_entlist.max_health > 0 && !ad_entlist.ad_bossflag) {
					// Some monsters reset HP later
					if (ad_entlist.ad_reset_health > 0) 
						ad_as_finalmonhp = ad_as_finalmonhp + ad_entlist.ad_reset_health;
					// Anything over 9999 is a special setup (don't include it)
					else if (ad_entlist.max_health < 9999) {
						ad_as_finalmonhp = ad_as_finalmonhp + ad_entlist.max_health;	
					}
				}
				
				// ------------------------------------------------------
				// Is this the FIRST monster in the LIST?
				if (ad_as_monlist == 0) {
					// Add first monster to front of list
					ad_asmonent[ad_as_monlist] = ad_entlist;
					ad_asmonqty[ad_as_monlist] = 1;
					if (ad_entlist.ad_bossflag) ad_asmonhp[ad_as_monlist] = ad_NOHP_MONARRAY;
					else ad_asmonhp[ad_as_monlist] = ad_entlist.max_health;
					// First entry in list
					ad_as_monlist = 1;
				}
				// --------------------------------------------------
				// Search through monster LIST for possible match
				else {
					ad_monloop = 0;
					ad_monfound = ad_FALSE;
					// Loop through list
					while (ad_monloop < ad_as_monlist) {
						// Found monster in list?
						// This condition will always setup boss monsters
						// in separate table entries (HP reset to zero)
						if (ad_entlist.ad_classtype == ad_asmonent[ad_monloop].ad_classtype
							&& ad_entlist.max_health == ad_asmonhp[ad_monloop]) {
							// Found monster, update quantity and exit
							ad_asmonqty[ad_monloop] = ad_asmonqty[ad_monloop] + 1;
							ad_monfound = ad_TRUE;
						}
						// Keep looping through list
						ad_monloop = ad_monloop + 1;
					}

					// --------------------------------------------------
					// Was the new monster found in the LIST?
					if (ad_monfound == ad_FALSE) {
						// only add monsters if array is large enough
						if (ad_as_monlist < ad_MAX_MONARRAY) {						
							// Add monster to list
							ad_asmonent[ad_as_monlist] = ad_entlist;
							ad_asmonqty[ad_as_monlist] = 1;
							if (ad_entlist.ad_bossflag) ad_asmonhp[ad_as_monlist] = ad_NOHP_MONARRAY;
							else ad_asmonhp[ad_as_monlist] = ad_entlist.max_health;
							// Increase list counter
							ad_as_monlist = ad_as_monlist + 1;
						}
						// Reach limit of array
						else ad_monarrayfull = ad_TRUE;
					}
				}
			}
		}
		// Keep search through ALL of the entity list
		ad_entlist = nextent(ad_entlist);
	} 

	// ERROR = No MONSTERS found?
	if (ad_as_monqty == 0) {
		sprint(self, "--------------------------------------\n");
		sprint(self, "\b[ERROR]\b Missing any MONSTERS!\n");
		sprint(self, " * Cannot create Monster Stats!\n\n");
		return;
	}
		
	//----------------------------------------------------------------
	// Display MONSTER ARRAY for the map
	//----------------------------------------------------------------
	ad_monloop = 0;
	sprint(self, "\b[-- Advanced Monsters Statistics --]\b\n"); 
	sprint(self, "--------------------------------------\n");
	sprint(self, "\bNo  Qty   HP  Total Classname\b\n");
	//              xx xxxx xxxx xxxxxx x---------------------x
	// Loop through list
	while (ad_monloop < ad_as_monlist) {
		ad_zerofill_number(self, ad_monloop+1, "0", "", "", "", "");
		sprint(self, " ");
		
		// Check for any special cases (reset_health)
		if (ad_asmonent[ad_monloop].ad_reset_health > 0) {
			ad_asmonhp[ad_monloop] = ad_asmonent[ad_monloop].ad_reset_health;
		}
		// Display monster quantity, individual HP and subtotal
		if (ad_asmonent[ad_monloop].ad_bossflag == ad_FALSE) {
			ad_zerofill_number(self, ad_asmonqty[ad_monloop], "0", " ", " ", "", "");
			sprint(self, " "); 
			ad_zerofill_number(self, ad_asmonhp[ad_monloop], "0", " ", " ", "", "");
			sprint(self, " "); 
			ad_subtmonhp = ad_asmonhp[ad_monloop] * ad_asmonqty[ad_monloop];
			ad_zerofill_number(self, ad_subtmonhp, "0", " ", " ", " ", " ");
		}
		// BOSS monsters are usually a special setup
		// They might as well be zero HP for this table
		else {
			ad_zerofill_number(self, ad_asmonqty[ad_monloop], "0", " ", " ", "", "");
			sprint(self, " "); 
			ad_zerofill_number(self, 0, " ", " ", " ", "", "");
			sprint(self, " "); 
			ad_zerofill_number(self, 0, " ", " ", " ", " ", " ");
		}
		// Display monster name
		sprint(self, " ");
		sprint(self, ad_asmonent[ad_monloop].classname);
		sprint(self, "\n");
		// Keep looping through list
		ad_monloop = ad_monloop + 1;
	}
	// Is monster array is full?
	if (ad_monarrayfull == ad_TRUE) {
		sprint(self, " * Monster Array table is incomplete\n");
	}

	// Display Summary stuff for the map
	ad_ammostats_monsummary(self);
};

//======================================================================
// Find and display secret locations
//======================================================================
void() ad_display_secrets =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_secloc_running) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] cannot work, \bSecret Cam\b active!\n");
		return;
	}

	// flush keyboard buffer
	self.impulse = 0;
	// Spawn secret trigger camera entity
	if (!ad_secloc_cam) ad_secloc_cam = spawn();
	ad_secloc_cam.count = 0;

	sprint(self, "\n--------------------------------------\n");
	sprint(self, "List of secret locations:\n\n");
	
	// Search entity list for secrets
	ad_secloc_cam.enemy = find(world, classname, "trigger_secret");
	// If no secrets exist, tell player and exit
	if (!ad_secloc_cam.enemy) { sprint(self, "No secrets found!\n"); return; }

	// Keep looping through triggers
	while (ad_secloc_cam.enemy) {
		// Found a secret!
		ad_secloc_cam.count = ad_secloc_cam.count + 1;
		ad_secloc_cam.enemy.cnt = ad_secloc_cam.count;
		// Update console display
		sprint(self, "(");
		// make sure table is aligned by zero filling
		if (ad_secloc_cam.enemy.cnt < 10) sprint(self, "0");
		// display secret no + XYZ origin location
		sprint(self, ftos(ad_secloc_cam.enemy.cnt)); 
		sprint(self, ") = ");
		sprint(self, vtos(ad_secloc_cam.enemy.oldorigin)); 
		if (ad_CheckZeroVector(ad_secloc_cam.enemy.oldorigin)) sprint(self, " [Err]");
		if (ad_secloc_cam.enemy.ad_estate & ad_ESTATE_OFF) sprint(self, " [Off]");
		else if (ad_secloc_cam.enemy.ad_estate & ad_ESTATE_DISABLE) sprint(self, "[Disabled]");
		sprint(self, "\n");
		
		// Keep search for more secrets
		ad_secloc_cam.enemy = find(ad_secloc_cam.enemy, classname, "trigger_secret");
	}
	sprint(self, "--------------------------------------\n");
	sprint(self, "Total secrets found ("); 
	sprint(self, ftos(ad_secloc_cam.count));
	sprint(self, ")\n\n");
};

//----------------------------------------------------------------------
void() ad_FinishSecretCamera =
{
	// Restore player core parameters (NO save)
	setmodel (self, ad_MODEL_PLAYER);
	ad_modelindex_player = self.modelindex;
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_WALK;
	self.takedamage = ad_DAMAGE_AIM;
	// Don't restore any velocity, wierd stuff will happen
	self.velocity = self.avelocity = '0 0 0';

	// Restore STORED player parameters
	self.flags = ad_secloc_cam.flags;
	setorigin(self, ad_secloc_cam.origin);
	self.view_ofs = ad_secloc_cam.view_ofs;
	self.angles = ad_secloc_cam.angles;
	self.v_angle = ad_secloc_cam.v_angle;
	self.fixangle = ad_TRUE;
	// Block player movement after camera exit
	self.teleport_time = time + 0.2;

	// Restore STORED weapon/ammo
	self.weapon = ad_secloc_cam.weapon;
	self.currentammo = ad_secloc_cam.currentammo;
	self.weaponmodel = ad_secloc_cam.weaponmodel;
	self.weaponframe = ad_secloc_cam.weaponframe;
	
	// Clear secret camera settings
	ad_secloc_cam.flags = 0;
	ad_secloc_cam.view_ofs = '0 0 0';
	ad_secloc_cam.angles = ad_secloc_cam.v_angle = '0 0 0';
	ad_secloc_cam.weaponmodel = ad_string_null;
	ad_secloc_cam.weaponframe = 0;
	
	// Restore pre/post player functions
	ad_secloc_running = ad_FALSE;	
	// flush keyboard buffers
	self.impulse = 0;
	self.button0 = self.button1 = self.button2 = 0;
};

//----------------------------------------------------------------------
void() ad_SaveSecretCamera =
{
	// Block pre/post player functions
	ad_secloc_running = ad_TRUE;	

	// SAVE player parameters
	ad_secloc_cam.flags = self.flags;
	ad_secloc_cam.origin = self.origin;
	ad_secloc_cam.view_ofs = self.view_ofs;
	ad_secloc_cam.angles = self.angles;
	ad_secloc_cam.v_angle = self.v_angle;
	ad_secloc_cam.weapon = self.weapon;
	ad_secloc_cam.currentammo = self.currentammo;
	ad_secloc_cam.weaponmodel = self.weaponmodel;
	ad_secloc_cam.weaponframe = self.weaponframe;	
};

//----------------------------------------------------------------------
void() ad_NextSecretCamera =
{
	if (!ad_secloc_cam.enemy) { ad_FinishSecretCamera(); return; }
	
	// Find next secret location
	ad_secloc_cam.count = ad_secloc_cam.count + 1;
	ad_secloc_cam.enemy.cnt = ad_secloc_cam.count;
	// Centerprint message about secret number found
	if (ad_secloc_cam.enemy.ad_estate & ad_ESTATE_BLOCK)
		ad_centerprint_msg3(self, "Secret (", ftos(ad_secloc_cam.enemy.cnt), ") Disabled\n");
	else
		ad_centerprint_msg3(self, "Secret (", ftos(ad_secloc_cam.enemy.cnt), ")\n");
	setorigin(self, ad_secloc_cam.enemy.oldorigin);

	// Keep search for more secrets
	ad_secloc_cam.enemy = find(ad_secloc_cam.enemy, classname, "trigger_secret");
};

//----------------------------------------------------------------------
void() ad_CheckSecretCamera =
{
	if (ad_impulse_playeronly()) return;		// Player only
	if (!ad_secloc_running) return;
	if (self.waitmin > time) return;		// delay input
	
	// check for jump button to exit
	if (self.button1 || self.button2) {
		// Time to exit
		ad_FinishSecretCamera();
	}
	// check for attack button to switch cameras
	else if (self.button0) {
		self.button0 = self.button1 = self.button2 = 0;
		self.waitmin = time + 0.5;
		// Next secret
		ad_NextSecretCamera();
	}
};

//----------------------------------------------------------------------
void() ad_display_secretlocs =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_secloc_running) return;

	// flush keyboard buffer
	self.impulse = 0;
	// Spawn secret trigger camera entity
	if (!ad_secloc_cam) ad_secloc_cam = spawn();
	ad_secloc_cam.count = 0;
	
	// Search entity list for secrets
	ad_secloc_cam.enemy = find(world, classname, "trigger_secret");
	// If no secrets exist, tell player and exit
	if (!ad_secloc_cam.enemy) { sprint(self, "No secrets found!\n"); return; }

	// Save player parameters
	ad_SaveSecretCamera();

	// Switch on notarget so monsters don't attack player
	// Add god mode to prevent any damage
	self.flags = self.flags + (ad_FL_NOTARGET || ad_FL_GODMODE);
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);		
		
	// reset player model to nothing and no world interaction
	self.view_ofs = self.velocity = self.avelocity = '0 0 0';
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;		// no more movement
	self.takedamage = ad_DAMAGE_NO;		// no more damage
	setmodel(self, ad_MODEL_EMPTY);		// Hide player model
	setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	self.weaponmodel = ad_string_null;		// No vmodel updates
	self.frame = self.weaponframe = 0;	// reset all frames
	
	// Display first camera
	ad_NextSecretCamera();
};
