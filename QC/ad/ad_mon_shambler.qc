//----------------------------------------------------------------------
void() ad_sham_melee =
{
	// Make sure lightning attachment is hidden
	ad_sham_reset_attachment();
	// If infighting and enemy is low on health, go for smash!
	if (self.enemy.flags & ad_FL_MONSTER && self.enemy.health < 40) ad_sham_smash1 ();
	else {
		self.ad_meleeattack = random();
		// Try to start with a smash
		if (self.ad_meleeattack > 0.6 || self.health == self.max_health) ad_sham_smash1 ();
		else if (self.ad_meleeattack > 0.3) ad_sham_swingr1 ();
		else ad_sham_swingl1 ();
	}
};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_sham_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		//self.attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.alpha = 0.85;
		self.ad_attachment.state = ad_FALSE;
	}
};

//----------------------------------------------------------------------
void() ad_sham_reset_attachment =
{
	if (self.ad_attachment) {
		if (self.ad_attachment.state) {
			// Move attachment into place ready for use
			self.ad_attachment.movetype = ad_MOVETYPE_NONE;
			self.ad_attachment.solid = ad_SOLID_NOT;
			self.ad_attachment.frame = 0;
			self.ad_attachment.skin = 0;
			setmodel(self.ad_attachment, "");
			setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
			setorigin(self.ad_attachment, self.origin);
			// Using empty model, so reset angle, frame and skin.
			self.ad_attachment.angles = self.angles;
			self.ad_attachment.state = ad_FALSE;
		}
	}
};

//----------------------------------------------------------------------
void() ad_sham_setup_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		setmodel(self.ad_attachment, ad_MODEL_PROJ_SHAMLIT);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.state = ad_TRUE;
	}
};

//----------------------------------------------------------------------
void() ad_sham_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.state = ad_FALSE;
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
};

//======================================================================
// RANGE ATTACK 1 - classic hitscan lightning
//======================================================================
void() ad_sham_lightning =
{
	local vector ad_org, ad_dir;
	if (self.health < 1) return;
	
	ad_ai_face ();
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	ad_sham_reset_attachment();

	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = self.enemy.origin + '0 0 16' - ad_org;
	ad_dir = normalize (ad_dir);

	// Check if the shambler can fire further than default
	if (self.ad_attack_sniper == ad_TRUE)
		self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);
	else self.ad_enemydist = ad_MONAI_SHAMRANGE;
	// Trace direct line of lightning infront of shambler
	traceline (ad_org, self.origin + ad_dir*self.ad_enemydist, ad_TRUE, self);

	// Display lightning model segments
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING1);
	WriteEntity (ad_MSG_BROADCAST, self); WriteByte (ad_MSG_BROADCAST, 0);
	WriteCoord (ad_MSG_BROADCAST, ad_org_x);
	WriteCoord (ad_MSG_BROADCAST, ad_org_y);
	WriteCoord (ad_MSG_BROADCAST, ad_org_z);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);

	// Check for any breakables first
	if (ad_ai_foundbreakable(self, trace_ent, ad_FALSE)) {
		ad_T_Damage (trace_ent, self, self, 80, ad_DAMARMOR);
	}
	// Standard player lightning damage function
	else ad_LightningDamage (ad_org, trace_endpos, self, 10);
};

// Map hack entry for old function
void() ad_CastLightning = { ad_sham_lightning(); };

//----------------------------------------------------------------------
void(vector ad_leftofs, vector ad_rightofs, float ad_litframe) ad_sham_casting =
{
	local vector ad_dir;
	local float ad_litpoint;
	
	if (self.health < 1) return;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_sham_create_attachment();

	// Frame 0 is start of the sequence (move everything into place)
	if (ad_litframe == 0) ad_sham_setup_attachment();

	// Turn toward enemy
	ad_ai_face();
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	
	// Place orb in the center of the electricity
	setorigin(self.ad_attachment, self.origin);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = ad_litframe;
	
	// Work out each hand position
	makevectors(self.angles);
	self.pos1 = self.origin + ad_attack_vector(ad_leftofs);
	self.pos2 = self.origin + ad_attack_vector(ad_rightofs);
	
	// Spawn some particles randomly along the lighting beam
	ad_dir = normalize(self.pos2 - self.pos1);
	ad_litpoint = vlen(self.pos2 - self.pos1) * random();
	self.ad_pos3 = self.pos1 + (ad_dir*ad_litpoint);
	ad_particle_explode(self.ad_pos3, 5+random()*5, 0.2+random(), ad_PARTICLE_BURST_BLUE, ad_PARTICLE_BURST_SKULLUP);
};

