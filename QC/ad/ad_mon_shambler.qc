//----------------------------------------------------------------------
void() ad_sham_die =
{
	// Finish and remove all attachments
	ad_sham_reset_attachment();
	ad_sham_remove_attachment();

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "shambler/sdeath.wav", 1, ad_ATTN_NORM);
		ad_sham_death1 ();
	}
	// Added feature for a Shambler marked with gibondeath
	// would explode, but it looks confusing
	// ** Feature removed **
	/*
	else {
		//Explosion for gib death!
		T_RadiusDamage (self, self, 20, world, DAMAGEALL);
		// Sprite/Particle based explosion
		WriteByte (MSG_BROADCAST, SVC_TEMPENTITY);
		WriteByte (MSG_BROADCAST, TE_EXPLOSION);
		WriteCoord (MSG_BROADCAST, self.origin_x);
		WriteCoord (MSG_BROADCAST, self.origin_y);
		WriteCoord (MSG_BROADCAST, self.origin_z);
		// Play original explosion sound or replacement
		SpawnExplosion(EXPLODE_SMALL, self.origin, SOUND_REXP3);
	} */
};

//----------------------------------------------------------------------
// Special wakeup animation for attacking/breaking something infront
// The monster should be setup facing the right direction before call
// Starts in large overhead swing downwards (no damage checks)
//----------------------------------------------------------------------
void() ad_sham_wakeup1 =[ $smash7,		ad_sham_wakeup2 ] {
	sound (self, ad_CHAN_VOICE, "shambler/melee1.wav", 1, ad_ATTN_NORM);};
void() ad_sham_wakeup2 =[ $smash9,		ad_sham_wakeup3 ] {};
void() ad_sham_wakeup3 =[ $smash10,	ad_sham_wakeup4 ] {};
void() ad_sham_wakeup4 =[ $smash11,	ad_sham_wakeup5 ] {};
void() ad_sham_wakeup5 =[ $smash12,	ad_sham_run1 ] {};

/*======================================================================
QUAKED monster_shambler (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_shambler =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	if (self.ad_poisonous) {
		self.mdl = "progs/mon_shambler.mdl";
		self.ad_headmdl = "progs/h_shambler.mdl";		// Large head
		self.ad_gib1mdl = "progs/gib_blclaw1.mdl";		// Left claw
		self.ad_gib2mdl = "progs/gib_blclaw2.mdl";		// Right claw
		self.ad_gib3mdl = "progs/gib_blfoot1.mdl";		// foot
		self.ad_gib4mdl = "progs/gib_blfoot2.mdl";		// foot
	}
	else {
		self.mdl = "progs/mon_shambler.mdl";
		self.ad_headmdl = "progs/h_shambler.mdl";		// Large head
		self.ad_gib1mdl = "progs/gib_shclaw1.mdl";		// Left claw
		self.ad_gib2mdl = "progs/gib_shclaw2.mdl";		// Right claw
		self.ad_gib3mdl = "progs/gib_shfoot1.mdl";		// foot
		self.ad_gib4mdl = "progs/gib_shfoot2.mdl";		// foot
	}

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_SHAMLIT);
	precache_model ("progs/s_light.mdl");
	precache_model ("progs/bolt.mdl");
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);
	
	// Randomly swap claws and feet around
	self.lip = random();
	if (self.lip < 0.25) self.ad_gib1mdl = self.ad_gib4mdl;
	else if (self.lip < 0.5) self.ad_gib2mdl = self.ad_gib4mdl;
	else if (self.lip < 0.75) self.ad_gib3mdl = self.ad_gib4mdl;

	self.ad_idle_sound = "shambler/sidle.wav";
	precache_sound (self.ad_idle_sound);

	precache_sound ("shambler/sdeath.wav");
	self.ad_pain_sound = "shambler/shurt2.wav";
	precache_sound (self.ad_pain_sound);

	precache_sound ("shambler/sattck1.wav");
	precache_sound ("shambler/sboom.wav");
	precache_sound ("shambler/melee1.wav");
	precache_sound ("shambler/melee2.wav");
	
	self.ad_meleehitsound = "shambler/smack.wav";
	precache_sound (self.ad_meleehitsound);

	self.ad_sight_sound = "shambler/ssight.wav";
	precache_sound (self.ad_sight_sound);
	
	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		self.ad_exactskin = 1;				// New green skin
	}
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_MASSIVE;
	if (self.health < 1) self.health = ad_HP_MONSHAMBLER;
	self.ad_gibhealth = -60;
	self.ad_gibbed = ad_FALSE;				// In one peice
	self.ad_pain_flinch = 400;				// Really low chance of pain
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_pain_timeout = 2;				// Long pause on pain
	self.ad_steptype = ad_FS_TYPELARGE;		// Large stomping feet
	self.ad_blockudeath = ad_TRUE;			// No player gib sound
	self.ad_attack_offset = '0 0 40';		// Between hands
	self.ad_deathstring = " was smashed by a Shambler\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = 0.5; self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_ShamCheckAttack;
	self.ad_th_stand = ad_sham_stand1;
	self.ad_th_walk = ad_sham_walk1;
	self.ad_th_run = ad_sham_run1;
	self.ad_th_die = ad_sham_die;
	self.ad_th_melee = ad_sham_melee;
	self.ad_th_missile = ad_sham_magic1;
	self.ad_th_pain = ad_sham_pain;
	self.ad_th_wakeup = ad_sham_wakeup1;

	self.ad_classtype = ad_CT_MONSHAM;
	self.ad_classgroup = ad_CG_SHAM;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
