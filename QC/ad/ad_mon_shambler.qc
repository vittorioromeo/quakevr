//======================================================================
// MELEE ATTACK 1 - Claw and Smash
// Merged shambler melee attacks (over head smash and side claw)
// Standardized to test vlen and zaxis height difference better
//======================================================================
float ad_SHAM_MSMASH = 1;
float ad_SHAM_MCLAW = 2;

//----------------------------------------------------------------------
void(float ad_melee_attack, float ad_side) ad_sham_meleeattack =
{
	local float ad_ldmg, ad_dmg_multiplier;
	
	if (!self.enemy) return;					// Something to fight?
	if (self.health < 1) return;				// Shambler alive?
	ad_ai_damagebreakable(40);						// Damage any breakables
	if (!ad_ai_checkmelee(ad_MONAI_MELEESHAM, ad_MONAI_MELEEZTALL)) return;// Too far away
	ad_dmg_multiplier = 1;

	// Get closer to enemy
	if (ad_melee_attack == ad_SHAM_MSMASH) ad_ai_charge(0);		// Stationary attack
	else if (ad_melee_attack == ad_SHAM_MCLAW) ad_ai_charge(10);	// Swing forward

	// Can the target bleed? - generate red/green blood
	if (!ad_CanDamage (self.enemy, self)) return;
	
	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Shambler over head claw smash to ground (slow and high damage)
	// If this is infighting do more damage as it will look more impressive
	// Also if this damage is enough to kill in a single blow, gib for effect
	if (ad_melee_attack == ad_SHAM_MSMASH) {
		sound (self, ad_CHAN_VOICE, self.ad_meleehitsound, 1, ad_ATTN_NORM);
		// Do double damage to other monsters (overhead smash attack only)
		if (self.enemy.flags & ad_FL_MONSTER) ad_dmg_multiplier = ad_dmg_multiplier * 2;
		// Damage 1-120
		ad_ldmg = (random() + random() + random()) * (40*ad_dmg_multiplier);
		if (ad_ldmg < 1) ad_ldmg = 1;
		// Make sure of impressive gib death
		if (self.enemy.health < ad_ldmg) ad_ldmg = ad_ldmg*3;
		ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	
		// Lots of blood and gore
		ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
		ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
	}
	// Shambler side swipe (left/right and half damage)
	else if (ad_melee_attack == ad_SHAM_MCLAW) {
		sound (self, ad_CHAN_VOICE, self.ad_meleehitsound, 1, ad_ATTN_NORM);
		// Damage 1-60
		ad_ldmg = (random() + random() + random()) * 20;
		if (ad_ldmg < 1) ad_ldmg = 1;
		ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
		ad_SpawnMeatSpray (self, self.enemy, ad_side);
	}
};

