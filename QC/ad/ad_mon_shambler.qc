void() ad_sham_swingl4 =[      $swingl4,      ad_sham_swingl5   ] {ad_ai_charge(3);};
void() ad_sham_swingl5 =[      $swingl5,      ad_sham_swingl6   ] {ad_ai_charge(7);};
void() ad_sham_swingl6 =[      $swingl6,      ad_sham_swingl7   ] {ad_ai_charge(9);};
