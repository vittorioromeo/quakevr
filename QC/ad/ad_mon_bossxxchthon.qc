/*==============================================================================
Chthon (Custom Version)
==============================================================================*/
$frame rise1 rise2 rise3 rise4 rise5 rise6 rise7 rise8 rise9 rise10
$frame rise11 rise12 rise13 rise14 rise15 rise16 rise17 

$frame walk1 walk2 walk3 walk4 walk5 walk6 walk7 walk8
$frame walk9 walk10 walk11 walk12 walk13 walk14 walk15
$frame walk16 walk17 walk18 walk19 walk20 walk21 walk22
$frame walk23 walk24 walk25 walk26 walk27 walk28 walk29 walk30 walk31

$frame death1 death2 death3 death4 death5 death6 death7 death8 death9

$frame attack1 attack2 attack3 attack4 attack5 attack6 attack7 attack8
$frame attack9 attack10 attack11 attack12 attack13 attack14 attack15
$frame attack16 attack17 attack18 attack19 attack20 attack21 attack22
$frame attack23

$frame shocka1 shocka2 shocka3 shocka4 shocka5 shocka6 shocka7 shocka8
$frame shocka9 shocka10 

$frame shockb1 shockb2 shockb3 shockb4 shockb5 shockb6

$frame shockc1 shockc2 shockc3 shockc4 shockc5 shockc6 shockc7 shockc8 
$frame shockc9 shockc10

float ad_CHTHON_PHASE1 = 1;	// Rising from Lava
float ad_CHTHON_PHASE2 = 2;	// Fighting
float ad_CHTHON_PHASE3 = 3;	// Frenzy mode
float ad_CHTHON_PHASE4 = 4;	// Death

//======================================================================
// Global functions
//======================================================================
// Special streamlined player find function
//----------------------------------------------------------------------
float() ad_xxchthon_FindTarget =
{
	local entity ad_client;
	
	// Get the obvious exception(s) done first
	if (self.health < 1) return ad_FALSE;
	if (ad_intermission_running > 0) return ad_FALSE;
	if (ad_cinematic_running > 0) return ad_FALSE;

	// Find a client in current PVS
	ad_client = checkclient ();
	
	// Go through all the exception(s)
	if (!ad_client) return ad_FALSE;
	if (!(ad_client.flags & ad_FL_CLIENT)) return ad_FALSE;
	if (ad_client.flags & ad_FL_NOTARGET) return ad_FALSE;
	if (ad_client.items & ad_IT_INVISIBILITY) return ad_FALSE;
	
	// Check range and visibility of player
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return ad_FALSE;
	if (self.ad_sight_nofront == ad_FALSE && !ad_infront(ad_client)) return ad_FALSE;

	// Finally found something
	self.enemy = ad_client;
	self.oldorigin = self.origin;		// Save origin
	self.goalentity = self.enemy;		// Focus on enemy
	// Setup turning angle towards new enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);

	// We have a winner!
	return ad_TRUE;	
};

//----------------------------------------------------------------------
// Setup wave HP and trigger boundaries
//----------------------------------------------------------------------
void() ad_xxchthon_WaveSetupHP =
{
	// Is there anymore boss waves left?
	if (self.ad_bosswave >= self.ad_bosswavetotal) {
		// Only one wave left (death is final trigger)
		self.health = self.ad_bosswaveqty;
		self.ad_bosswavetrig = -1000;
	}
	else {
		// Multiple waves are still left (reset hp+trigger)
		// Always reset HP to stop high DPS weapons trashing waves boundaries
		self.health = ((self.ad_bosswavetotal - self.ad_bosswave) + 1) * self.ad_bosswaveqty;
		// The wave trigger is always one wave lower
		self.ad_bosswavetrig = self.health - self.ad_bosswaveqty;
	}
	// Debug messages for wave and health
	dprint("\b[BOSS]\b Wave ("); dprint(ftos(self.ad_bosswave));
	dprint(" / "); dprint(ftos(self.ad_bosswavetotal));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//----------------------------------------------------------------------
// Check if HP has reached next boss wave trigger event
//----------------------------------------------------------------------
float() ad_xxchthon_WaveCheck =
{
	// Check for boss wave boundary event
	if (self.health > 1 && self.health < self.ad_bosswavetrig) {
		// Check for wave boundary triggers
		self.noise = "";
		if (self.ad_bosswave == 1) self.noise = self.noise1;
		else if(self.ad_bosswave == 2) self.noise = self.noise2;
		else if(self.ad_bosswave == 3) self.noise = self.noise3;
		else if(self.ad_bosswave == 4) self.noise = self.noise4;
		
		// Is there any trigger for the wave boundary?
		if (self.noise != "") ad_trigger_strs(self.noise, self);

		// Update Boss wave parameters (next wave!)
		self.ad_bosswave = self.ad_bosswave + 1;
		ad_xxchthon_WaveSetupHP();
		self.style = ad_CHTHON_PHASE3;	// Frenzy mode
		return ad_TRUE;
	}
	return ad_FALSE;
};

//----------------------------------------------------------------------
// Forces the next HP wave event to happen (use function)
//----------------------------------------------------------------------
void() ad_xxchthon_WaveTrigger = { 
	// Force HP down through T_damage function (safer option)
	ad_T_Damage (self, self, self, (self.health-self.ad_bosswavetrig)+1, ad_NOARMOR);

	// Debug messages for wave and health
	dprint("\b[BOSS]\b Force Wave HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//===========================================================================
// IDLE state - waiting for player
//===========================================================================
void() ad_xxchthon_idleframe =
{
	// Get the obvious exception(s) done first
	if (self.health < 1) return;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 30) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_xxchthon_idleframe;
	
	// Setup current animation frame
	self.frame = $walk1 + self.ad_walkframe;

	// Check for HP trigger event
	if (ad_xxchthon_WaveCheck() == ad_TRUE) self.ad_th_jump();
	// Keep checking for players
	else if (ad_xxchthon_FindTarget()) self.ad_th_missile();
	
	// Chance for turret mode?
	if (random() < 0.1) {
		// Turret mode (no front facing checks)
		self.ad_sight_nofront = ad_TRUE;
		// Setup random turning angle (clockwise direction)
		self.ideal_yaw = ad_anglemod(self.angles_y + 45 + (random()*90));
		ChangeYaw ();
	}
};

//----------------------------------------------------------------------
void() ad_xxchthon_idle ={ self.ad_walkframe = 0; ad_xxchthon_idleframe(); };

//===========================================================================
// ATTACK 1 - Constant fireballs
//===========================================================================
void(vector ad_orgofs) ad_xxchthon_missile =
{
	local vector ad_offang, ad_org, ad_vec, ad_dir, ad_mdest, ad_avel;
	local float ad_projlen;

	// No enemy or player dead?
	if (!self.enemy) return;
	
	sound (self, ad_CHAN_WEAPON, "chthon/attack1.wav", 1, ad_ATTN_NORM);
	ad_offang = vectoangles (self.enemy.origin - self.origin);	
	makevectors (ad_offang);
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	
	// Skill level adjustment
	self.ad_attack_speed = self.pos1_x + (ad_skill*self.pos1_y);
	
	// Lead the missile on hard mode (This formula is not perfect) 
	// There are plenty of missiles that go in strange directions, 
	// especially if the player strafes a lot from side to side.
	if (ad_skill > ad_SKILL_HARD) {
		ad_projlen = vlen(self.enemy.origin - ad_org) / self.ad_attack_speed;
		ad_vec = self.enemy.velocity;
		ad_vec_z = 0;
		ad_mdest = self.enemy.origin + ad_projlen * ad_vec;		
	}
	else ad_mdest = self.enemy.origin;
	
	ad_dir = normalize (ad_mdest - ad_org);
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Missile (ad_org, ad_dir, ad_avel, ad_CT_PROJ_CHTHON, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_xxchthon_attackframe =
{
	// Get the obvious exception(s) done first
	if (self.health < 1) return;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	else if (self.ad_walkframe == 7) ad_xxchthon_missile('100 100 200');
	else if (self.ad_walkframe == 18) ad_xxchthon_missile('100 -100 200');

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 22) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_xxchthon_attackframe;
	// Turn off turret mode (360 degree tracking)
	self.ad_sight_nofront = ad_FALSE;
	
	// Setup current animation frame
	self.frame = $attack1 + self.ad_walkframe;

	// Check for HP trigger event
	if (ad_xxchthon_WaveCheck() == ad_TRUE) self.ad_th_jump();
	// Keep checking for players
	else {
		// Keep checking for player and turning towards them
		// Check for any no combat conditions
		if (self.enemy.health < 1) self.enemy = world;
		else if (ad_intermission_running > 0) self.enemy = world;
		else if (ad_cinematic_running > 0) self.enemy = world;
		else if (self.enemy.flags & ad_FL_NOTARGET) self.enemy = world;
		else if (self.enemy.items & ad_IT_INVISIBILITY) self.enemy = world;
		
		// No enemy? back to idle, else keep turning
		if (!self.enemy) self.ad_th_stand();
		else ad_ai_face();
	}
};

//----------------------------------------------------------------------
void() ad_xxchthon_attack ={ self.ad_walkframe = 0; ad_xxchthon_attackframe(); };

//============================================================================
// Re-using the original shock animations for end of wave event
//============================================================================
void() ad_xxchthon_shakeattack =
{
	local vector ad_org, ad_ang, ad_dir, ad_avel;
	
	// Custom grenade firing speed
	self.ad_attack_speed = self.ad_pos3_x;

	// Shoot grenades from top of shub
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(self.dest2);

	// Randomly shoot grenades in any directions
	ad_ang = '0 0 0';
	ad_ang_y = rint(random()*360);
	makevectors(ad_ang);
	// Use classic grenade angle system, not Z aware
	ad_dir = v_forward * self.ad_attack_speed;
	ad_dir_z = self.ad_pos3_y;
	
	// A bit of random spin and fire!
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_CHTHON2);
};

//----------------------------------------------------------------------
void() ad_xxchthon_shakeframe =
{
	// Randomnly fire grenades outward
	if (random() < 0.75) ad_xxchthon_shakeattack();
	
	// Keep on looping around
	self.nextthink = time + 0.1;
	self.think = ad_xxchthon_shakeframe;
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 9) {
		self.ad_walkframe = 0;
		self.count = self.count + 1;
		self.ad_inpain = self.ad_inpain + 1;
		
		// has chthon looped around 3 times?
		if (self.count > 1) {
			ad_Resist_ChangeType(self, ad_FALSE);
			self.style = ad_CHTHON_PHASE2;
			// Straight back to throwing fireballs!
			self.think = self.ad_th_missile;
		}
	}

	// Update current frames (2 sets of animations)
	if (self.ad_inpain == 0) self.frame = $shocka1 + self.ad_walkframe;
	else self.frame = $shockc1 + self.ad_walkframe;
};

//----------------------------------------------------------------------
void() ad_xxchthon_shake =
{
	// Start roaring and shaking
	sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_NORM);
	ad_Resist_ChangeType(self, ad_TRUE);
	self.ad_walkframe = self.count = self.ad_inpain = 0;
	ad_xxchthon_shakeframe();
};

//============================================================================
// PAIN and DEATH
//============================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_xxchthon_pain =
{
	// Check for boss wave trigger events
	if (ad_xxchthon_WaveCheck() == ad_TRUE) {self.ad_th_jump(); return;}
	self.ad_pain_finished = time + 2 + random()*2;

	// Spawn particle/smoke damage
	ad_SpawnProjectileSmoke(ad_inflictor.origin, 200, 50, 150);
	if (ad_damage > 30) ad_SpawnProjectileSmoke(ad_inflictor.origin, 200, 50, 250);
	// The pain sound not linked to animation, so less useful
	if (random() < 0.2 && ad_damage > 30)
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
};

//============================================================================
// DEATH - Fall down and explode
//============================================================================
void() ad_xxchthon_lavasplash =
{
	sound (self, ad_CHAN_BODY, "chthon/lavasplash.wav", 1, ad_ATTN_NORM);
	if (ad_ext_dppart) {
		// Two different types of liquid splash (only DP)
		if (self.spawnflags & ad_MON_CHTHON_GREEN) 
			pointparticles(particleeffectnum("TE_SLIMESPLASH"), self.origin, '0 0 0', 1);
		else
			pointparticles(particleeffectnum("TE_LAVASPLASH"), self.origin, '0 0 0', 1);
	}
	else {
		// Classic Fitz/QS engine effects (hard coded)
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_LAVASPLASH);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	}
};

//----------------------------------------------------------------------
void() ad_xxchthon_explode = 
{
	// No more Boss!
	ad_entity_hide(self);

	// Gib explosive fountain!?!
	self.max_health = ad_MON_GIBEXPLOSION;
	ad_ThrowGib(11, 15 + rint(random()*10));	// lava explosions
};

//----------------------------------------------------------------------
void() ad_xxchthon_explosion =
{
	// Pick random location above/center of chthon
	self.oldorigin = self.origin + ad_vecrand(0,100,ad_TRUE);
	self.oldorigin_z = self.origin_z + 50 + random()*100;

	// Spawn smoke, explosion and lava gib!
	ad_SpawnProjectileSmoke(self.oldorigin, 100, 400, 100);
	if (random() < 0.5) self.lip = ad_EXPLODE_MED;
	else self.lip = ad_EXPLODE_BIG;
	ad_SpawnExplosion(self.lip, self.oldorigin, "");
	ad_ThrowGib(11, 1);
};

//----------------------------------------------------------------------
void() ad_xxchthon_death1 = [$death1, ad_xxchthon_death2] {};
void() ad_xxchthon_death2 = [$death2, ad_xxchthon_death3] {ad_xxchthon_explosion();};
void() ad_xxchthon_death3 = [$death3, ad_xxchthon_death4] {ad_xxchthon_explosion();};
void() ad_xxchthon_death4 = [$death4, ad_xxchthon_death5] {ad_xxchthon_explosion();};
void() ad_xxchthon_death5 = [$death5, ad_xxchthon_death6] {ad_xxchthon_explosion();};
void() ad_xxchthon_death6 = [$death6, ad_xxchthon_death7] {ad_xxchthon_explosion();};
void() ad_xxchthon_death7 = [$death7, ad_xxchthon_death8] {ad_xxchthon_explosion();};
void() ad_xxchthon_death8 = [$death8, ad_xxchthon_death9] {ad_xxchthon_explosion();};
void() ad_xxchthon_death9 = [$death9, ad_xxchthon_explode] {ad_xxchthon_lavasplash();};

//----------------------------------------------------------------------
void() ad_xxchthon_die =
{
	self.style = ad_CHTHON_PHASE4;		// Game Over for Chthon!
	self.deadflag = ad_DEAD_DEAD;		// the rock finally crashed
	self.effects = 0;				// Remove effects on death
	self.solid = ad_SOLID_NOT;			// no longer need to block
	self.max_health = ad_MON_GIBEXPLOSION;

	sound (self, ad_CHAN_VOICE, "chthon/death1.wav", 1, ad_ATTN_NORM);
	ad_xxchthon_death1 ();
};

//============================================================================
// RISE up from the swirling liquid
//============================================================================
void() ad_xxchthon_rise1	=[	$rise1, ad_xxchthon_rise2 ] {ad_xxchthon_lavasplash();};
void() ad_xxchthon_rise2	=[	$rise2, ad_xxchthon_rise3 ] {
	sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_NORM);};
void() ad_xxchthon_rise3	=[	$rise3, ad_xxchthon_rise4 ] {};
void() ad_xxchthon_rise4	=[	$rise4, ad_xxchthon_rise5 ] {ad_ai_face();};
void() ad_xxchthon_rise5	=[	$rise5, ad_xxchthon_rise6 ] {};
void() ad_xxchthon_rise6	=[	$rise6, ad_xxchthon_rise7 ] {ad_ai_face();};
void() ad_xxchthon_rise7	=[	$rise7, ad_xxchthon_rise8 ] {};
void() ad_xxchthon_rise8	=[	$rise8, ad_xxchthon_rise9 ] {ad_ai_face();};
void() ad_xxchthon_rise9	=[	$rise9, ad_xxchthon_rise10 ] {};
void() ad_xxchthon_rise10	=[	$rise10, ad_xxchthon_rise11 ] {ad_ai_face();};
void() ad_xxchthon_rise11	=[	$rise11, ad_xxchthon_rise12 ] {};
void() ad_xxchthon_rise12	=[	$rise12, ad_xxchthon_rise13 ] {ad_ai_face();};
void() ad_xxchthon_rise13	=[	$rise13, ad_xxchthon_rise14 ] {};
void() ad_xxchthon_rise14	=[	$rise14, ad_xxchthon_rise15 ] {ad_ai_face();};
void() ad_xxchthon_rise15	=[	$rise15, ad_xxchthon_rise16 ] {};
void() ad_xxchthon_rise16	=[	$rise16, ad_xxchthon_rise17 ] {ad_ai_face();};
void() ad_xxchthon_rise17	=[	$rise17, ad_xxchthon_attack ] {
	// Enable wave use functionality?
	if (self.ad_bosswaveuse > 0) self.use = ad_xxchthon_WaveTrigger;
	self.style = ad_CHTHON_PHASE2;		// Start fighting
	self.takedamage = ad_DAMAGE_AIM;
};

//======================================================================
// Setup Chthon after trigger event
//======================================================================
void() ad_xxchthon_awake =
{
	self.use = ad_SUB_Null;			// No more triggers
	self.style = ad_CHTHON_PHASE1;		// Rising from Lava
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)

	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	self.frame = 0; self.skin = self.ad_exactskin;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size

	self.takedamage = ad_DAMAGE_NO;	// Still immune to damage
	self.yaw_speed = 20;			// Average Speed
	self.velocity = '0 0 0';		// Make sure stationary
	self.ad_pain_longanim = ad_FALSE;		// No axe advantage
	self.ad_noinfighting = ad_TRUE;		// No infighting

	// Check for delay spawn monster count
	if (self.ad_delaymonstercount) {
		// Reset both monster count conditions
		self.ad_nomonstercount = self.ad_delaymonstercount = 0;
		total_monsters = total_monsters + 1;
		ad_update_hud_totals(ad_HUD_MONSTERS);
	}

	ad_Resist_CheckRange(self);		// Double check values
	ad_Resist_Save(self);				// Save for Later
		
	// Setup boss waves and overall health
	if (self.ad_bosswave < 1) self.ad_bosswavetotal = 5;
	else self.ad_bosswavetotal = self.ad_bosswave;
	
	// Always start bosswave at 1
	self.ad_bosswave = 1;
	if (self.ad_bosswaveqty < 1) self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_xxchthon_WaveSetupHP();

	// Restore all think functions
	self.ad_th_stand = ad_xxchthon_idle;
	self.ad_th_walk = ad_xxchthon_idle;
	self.ad_th_run = ad_xxchthon_idle;
	self.ad_th_missile = ad_xxchthon_attack;
	self.ad_th_jump = ad_xxchthon_shake;
	self.ad_th_pain = ad_xxchthon_pain;
	self.ad_th_die = ad_xxchthon_die;
	
	self.ad_pain_finished = time + 3;		// Make pain go away
	self.ad_attack_finished = time + 2;	// Reset attack system
	self.ad_gibhealth = -1000;				// Special death sequence
	self.enemy = ad_activator;

	// DP particle spark and smoke effect to Chthon 
	// original idea by Seven, green version added later by me
	if (ad_ext_dppart) self.ad_traileffectnum = particleeffectnum(self.ad_dpp_name);

	// Time to rise from lava
	ad_xxchthon_rise1 ();
};

/*======================================================================
 QUAKED monster_chthon (1 0 0) (-128 -128 -24) (128 128 256)
======================================================================*/
void() ad_monster_chthon =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_bosschthon.mdl";
	precache_model (self.mdl);
	precache_model(ad_MODEL_PROJ_CHTHON1);
	
	// Final explosion (10 distorted balls of lava/slime)
	self.ad_gib1mdl = ad_MODEL_PROJ_CHTHON1;
	self.ad_gib1frame = 9;
	
	// Load up slime version and switch gibs
	if (self.spawnflags & ad_MON_CHTHON_GREEN) {
		self.skin = self.ad_gib1skin = 2;
		precache_model (ad_MODEL_PROJ_SLIME);
		self.ad_dpp_name = "TR_BOSSCHTHONGRN";
		self.ad_gibtype = ad_GIBTYPE_POISON;
		self.ad_poisonous = ad_TRUE;
	}
	else {
		// Check for new red/fire skin
		if (self.spawnflags & ad_MON_CHTHON_RED) {
			self.skin = self.ad_gib1skin = 1;
		}
		precache_model (ad_MODEL_PROJ_LAVA);
		self.ad_dpp_name = "TR_BOSSCHTHON";
		self.ad_poisonous = ad_FALSE;
	}

	self.ad_idle_sound = "chthon/idle1.wav";
	precache_sound (self.ad_idle_sound);

	// Attack/throw/electric sound
	precache_sound ("chthon/attack1.wav");
	precache_sound ("weapons/rocket1i.wav");
	precache_sound ("chthon/bounce.wav");
	
	self.ad_pain_sound = "chthon/pain1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound ("chthon/death1.wav");

	// Rise from lava roar + splash
	self.ad_sight_sound = "chthon/sight1.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound ("chthon/lavasplash.wav");

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	// Use to be 128 square, reduced size to help with
	// radius/splash damage being more effective
	self.ad_bbmins = '-80 -80 -24';	// has own entity setup
	self.ad_bbmaxs = '80 80 256';
	self.ad_bboxtype = ad_BBOX_CUSTOM;
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	
	self.health = self.max_health = ad_MEGADEATH;
	self.ad_pain_finished = ad_LARGE_TIMER;
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_deathstring = " was blown apart by Chthon\n";
	self.ad_lastorigin = self.origin;	// Origin for camera interpolation

	// Save for wakeup function
	self.frame = 0; self.ad_exactskin = self.skin;

	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	self.ad_pain_flinch = 400;			// Shambler level
	self.ad_pain_timeout = 2;			// Stop constant pain
	self.takedamage = ad_DAMAGE_NO;	// Immune to damage
	self.ad_sight_nofront = ad_TRUE;		// 360 degree wakeup

	self.deadflag = ad_DEAD_NO;					// used to stop death re-triggering
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	
	// Setup projectile speed (250 + 50*skill)
	if (ad_CheckZeroVector(self.pos1)) self.pos1 = '250 50 0';
	// Setup projectile damage (Base + Random, Splash)
	if (ad_CheckZeroVector(self.pos2)) self.pos2 = ad_DAMAGE_RLPLAYER;
	// Attack 2 - Setup projectile speed, splash damage
	if (ad_CheckZeroVector(self.ad_pos3)) self.ad_pos3 = '300 500 40';
	// Attack 2 - Spawn location (offset from origin)
	if (ad_CheckZeroVector(self.dest2)) self.dest2 = '0 0 96';
	
	self.ad_classtype = ad_CT_MONXXCHTHON;
	self.ad_classgroup = ad_CG_BOSS;
	self.style = 0;
	
	// No targetname = no trigger!
	if (self.targetname == "") {
		dprint("\b[CHTHON]\b Missing trigger name!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}

	// Monster count exceptions
	if (self.ad_nomonstercount > 0 || self.ad_delaymonstercount > 0) {
		// Some maps have way too many no monster counts
		if (world.ad_no_moncountdevmsg <= 0) {
			dprint("\b[CHTHON]\b ("); dprint(self.targetname);
			dprint(") - no monster count\n");
		}
	}
	// Update count before client spawn
	else total_monsters = total_monsters + 1;
	
	// Display debug diamonds
	ad_monster_devmarker(self);
	
	// Wait for trigger event
	self.use = ad_xxchthon_awake;
};
