/*==============================================================================
PLAYER
==============================================================================*/
$cd id1/models/player_4
$origin 0 -6 24
$base base		
$skin skin

$frame axrun1 axrun2 axrun3 axrun4 axrun5 axrun6

$frame rockrun1 rockrun2 rockrun3 rockrun4 rockrun5 rockrun6

$frame stand1 stand2 stand3 stand4 stand5

$frame axstnd1 axstnd2 axstnd3 axstnd4 axstnd5 axstnd6
$frame axstnd7 axstnd8 axstnd9 axstnd10 axstnd11 axstnd12

$frame axpain1 axpain2 axpain3 axpain4 axpain5 axpain6

$frame pain1 pain2 pain3 pain4 pain5 pain6

$frame axdeth1 axdeth2 axdeth3 axdeth4 axdeth5 axdeth6
$frame axdeth7 axdeth8 axdeth9

$frame deatha1 deatha2 deatha3 deatha4 deatha5 deatha6 deatha7 deatha8
$frame deatha9 deatha10 deatha11

$frame deathb1 deathb2 deathb3 deathb4 deathb5 deathb6 deathb7 deathb8
$frame deathb9

$frame deathc1 deathc2 deathc3 deathc4 deathc5 deathc6 deathc7 deathc8
$frame deathc9 deathc10 deathc11 deathc12 deathc13 deathc14 deathc15

$frame deathd1 deathd2 deathd3 deathd4 deathd5 deathd6 deathd7
$frame deathd8 deathd9

$frame deathe1 deathe2 deathe3 deathe4 deathe5 deathe6 deathe7
$frame deathe8 deathe9

// attacks
$frame nailatt1 nailatt2
$frame light1 light2
$frame rockatt1 rockatt2 rockatt3 rockatt4 rockatt5 rockatt6
$frame shotatt1 shotatt2 shotatt3 shotatt4 shotatt5 shotatt6
$frame axatt1 axatt2 axatt3 axatt4 axatt5 axatt6
$frame axattb1 axattb2 axattb3 axattb4 axattb5 axattb6
$frame axattc1 axattc2 axattc3 axattc4 axattc5 axattc6
$frame axattd1 axattd2 axattd3 axattd4 axattd5 axattd6

void() ad_player_run;

//----------------------------------------------------------------------
// Updated player idle/fire weapon frame logic to be consistent
// Bug highlighted by Stas "dwere" Kuznetsov
//----------------------------------------------------------------------
float ad_IDLE_WEAPON_FRAME = 0;	// Default idle state
float ad_FIRE_WEAPON_FRAME = 1;	// Start of firing frames

//----------------------------------------------------------------------
// 
//----------------------------------------------------------------------
float() ad_frame_pause =
{
	if (ad_intermission_running > 0 || ad_cinematic_running > 0) return ad_TRUE;
	else return ad_FALSE;
};

/*==============================================================================
PLAYER AXE

Frame 0 - Idle LOW
Frame 1 - Idle HIGH

Axe A 	Original - 1,2,3,4		New - 3,4,5,7				a3,a4,a5,a7
Axe B		Original - 5,6,7,8		New - 10,11,13,14		b3,b4,b6,b7
Axe C		Original - 1,2,3,4		New - 17,18,20,21		c3,c4,c6,c7
Axe D		Original - 5,6,7,8		New - 24,25,26,28		d3,d4,d5,d7
Axe E		Original - x,x,x,x		New - 31,32,34,35		e3,e4,e6,e7

============================================================================*/
void()	ad_player_axe1 =	[$axatt1, ad_player_axe2	] {if (!ad_frame_pause()) self.weaponframe=1;};
void()	ad_player_axe2 =	[$axatt2, ad_player_axe3	] {if (!ad_frame_pause()) self.weaponframe=2;};
void()	ad_player_axe3 =	[$axatt3, ad_player_axe4	] {if (!ad_frame_pause()) {self.weaponframe=3;ad_W_FireAxe();} };
void()	ad_player_axe4 =	[$axatt4, ad_player_run	] {if (!ad_frame_pause()) self.weaponframe=4;};

void()	ad_player_axeb1 =	[$axattb1, ad_player_axeb2	] {if (!ad_frame_pause()) self.weaponframe=5;};
void()	ad_player_axeb2 =	[$axattb2, ad_player_axeb3	] {if (!ad_frame_pause()) self.weaponframe=6;};
void()	ad_player_axeb3 =	[$axattb3, ad_player_axeb4	] {if (!ad_frame_pause()) {self.weaponframe=7;ad_W_FireAxe();} };
void()	ad_player_axeb4 =	[$axattb4, ad_player_run	] {if (!ad_frame_pause()) self.weaponframe=8;};

void()	ad_player_axec1 =	[$axattc1, ad_player_axec2	] {if (!ad_frame_pause()) self.weaponframe=9;};
void()	ad_player_axec2 =	[$axattc2, ad_player_axec3	] {if (!ad_frame_pause()) self.weaponframe=10;};
void()	ad_player_axec3 =	[$axattc3, ad_player_axec4	] {if (!ad_frame_pause()) {self.weaponframe=11;ad_W_FireAxe();} };
void()	ad_player_axec4 =	[$axattc4, ad_player_run	] {if (!ad_frame_pause()) self.weaponframe=12;};

void()	ad_player_axed1 =	[$axattd1, ad_player_axed2	] {if (!ad_frame_pause()) self.weaponframe=13;};
void()	ad_player_axed2 =	[$axattd2, ad_player_axed3	] {if (!ad_frame_pause()) self.weaponframe=14;};
void()	ad_player_axed3 =	[$axattd3, ad_player_axed4	] {if (!ad_frame_pause()) {self.weaponframe=15;ad_W_FireAxe();} };
void()	ad_player_axed4 =	[$axattd4, ad_player_run	] {if (!ad_frame_pause()) self.weaponframe=16;};

void()	ad_player_axee1 =	[$axattd1, ad_player_axee2	] {if (!ad_frame_pause()) self.weaponframe=17;};
void()	ad_player_axee2 =	[$axattd2, ad_player_axee3	] {if (!ad_frame_pause()) self.weaponframe=18;};
void()	ad_player_axee3 =	[$axattd3, ad_player_axee4	] {if (!ad_frame_pause()) {self.weaponframe=19;ad_W_FireAxe();} };
void()	ad_player_axee4 =	[$axattd4, ad_player_run	] {if (!ad_frame_pause()) self.weaponframe=20;};

//============================================================================
void()	ad_player_stand1 =[	$axstnd1,	ad_player_stand1	] {
	// Stop if intermission/cinematic running
	if (ad_frame_pause()) return;
	// Get out of any weapon animation
	self.weaponframe=ad_IDLE_WEAPON_FRAME;
	if (self.velocity_x || self.velocity_y) {
		self.ad_walkframe = 0;
		ad_player_run();
		return;
	}

	if (self.weapon == ad_IT_AXE) {
		if (self.ad_walkframe >= 12) self.ad_walkframe = 0;
		self.frame = $axstnd1 + self.ad_walkframe;
	}
	else {
		if (self.ad_walkframe >= 5) self.ad_walkframe = 0;
		self.frame = $stand1 + self.ad_walkframe;
	}
	self.ad_walkframe = self.ad_walkframe + 1;	
};

//============================================================================
void()	ad_player_run =[ $rockrun1, ad_player_run ] {
	// Stop if intermission/cinematic running
	if (ad_frame_pause()) return;
	// Get out of any weapon animation
	self.weaponframe = ad_IDLE_WEAPON_FRAME;
	// Standing around has different animation sets
	if (!self.velocity_x && !self.velocity_y) {
		self.ad_walkframe = 0;
		ad_player_stand1();
		return;
	}
	// make sure correct player animation active
	if (self.weapon == ad_IT_AXE) {
		if (self.ad_walkframe >= 6) self.ad_walkframe = 0;
		self.frame = $axrun1 + self.ad_walkframe;
	}
	else {
		if (self.ad_walkframe >= 6) self.ad_walkframe = 0;
		self.frame = self.frame + self.ad_walkframe;
	}
	
	// Check for player feet sound, using velocity & ground flag
	if ((self.ad_walkframe == 2 || self.ad_walkframe == 5) && 
		self.flags & ad_FL_ONGROUND) {
		self.cnt = fabs(self.velocity_x + self.velocity_y);
		// Need to be moving before feet sounds
		if (self.cnt > 50) ad_monster_footstep(ad_FALSE);
	}
	// Update frame
	self.ad_walkframe = self.ad_walkframe + 1;
};

//============================================================================
void()	ad_player_run_nofeet =[ $rockrun1, ad_player_run ] {
	// Stop if intermission/cinematic running
	if (ad_frame_pause()) return;
	// Get out of any weapon animation
	self.weaponframe = ad_IDLE_WEAPON_FRAME;
	// Standing around has different animation sets
	if (!self.velocity_x && !self.velocity_y) {
		self.ad_walkframe = 0;
		ad_player_stand1();
		return;
	}
	// make sure correct player animation active
	if (self.weapon == ad_IT_AXE) {
		if (self.ad_walkframe >= 6) self.ad_walkframe = 0;
		self.frame = $axrun1 + self.ad_walkframe;
	}
	else {
		if (self.ad_walkframe >= 6) self.ad_walkframe = 0;
		self.frame = self.frame + self.ad_walkframe;
	}
		
	// Update frame
	self.ad_walkframe = self.ad_walkframe + 1;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_remoteplayer_run =
{
	local entity ad_tself;
	ad_tself = self; self = ad_targ;
	// This has to run the block above otherwise weaponframe errors
	// the animation code "xx = [ $x, x ]" has to be run
	// The above code cannot be pasted into this function
	// Be careful with this function, it needs a certain layout!
	ad_player_run_nofeet();
	self = ad_tself;
};

//============================================================================
// Grapple Hook (From Rogue Entertainment, coder=ZOID)
//============================================================================
void()	ad_player_ghreset =[$axattd1, ad_player_grapple2] {
	if (!ad_frame_pause()) self.weaponframe=ad_FIRE_WEAPON_FRAME; };
void() ad_player_grapple4;
void() ad_player_grapple5;
	
void() ad_player_grapple1 =[$axattd1, ad_player_grapple2] {
	if (ad_frame_pause()) return;
	self.weaponframe=1; ad_W_FireGrapple();};
void() ad_player_grapple2 =[$axattd2, ad_player_grapple3] {
	if (!ad_frame_pause()) self.weaponframe=2;};
// Grapple loop -----------------------------------------
void() ad_player_grapple3 =[$axattd3, ad_player_grapple3] {
	if (ad_frame_pause()) return;
	self.weaponframe=2;
	if (!self.ad_gh_hookout) { ad_player_grapple5(); return; }
	ad_GrappleHook_Distance();
	if (self.ad_gh_hookdist >= self.ad_hookent.ad_gh_minbeam) {
		if (self.ad_gh_onhook) { ad_player_grapple4(); return; }
	}
};
void() ad_player_grapple4 =[$deathc4, ad_player_grapple4] {
	if (ad_frame_pause()) return;
	self.weaponframe=2;
	// Exit loop when hook not out
	if (!self.ad_gh_hookout) { ad_player_grapple5(); return; }
	ad_GrappleHook_Distance();
	if (!self.ad_gh_onhook || self.ad_gh_hookdist < self.ad_hookent.ad_gh_minbeam) {
		ad_player_grapple3(); return; 
	}
};
// End of loop -----------------------------------------
void() ad_player_grapple5 = [$axattd4, ad_player_run] {
	if (!ad_frame_pause()) self.weaponframe=1;};

