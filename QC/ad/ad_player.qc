//============================================================================
// The Nailgun
//============================================================================
void(float ad_oframe, float ad_ox) ad_nail_upd = {
	if (ad_frame_pause()) return;
	if (!self.button0) { ad_player_run(); return; }
	self.weaponframe = ad_oframe;
	ad_W_FireSpikes (0,ad_ox);
};

void() ad_player_nail1 =[$nailatt1, ad_player_nail2] {ad_nail_upd(1,2);};
void() ad_player_nail2 =[$nailatt2, ad_player_nail3] {ad_nail_upd(2,-2);};
void() ad_player_nail3 =[$nailatt1, ad_player_nail4] {ad_nail_upd(3,2);};
void() ad_player_nail4 =[$nailatt2, ad_player_nail5] {ad_nail_upd(4,-2);};
void() ad_player_nail5 =[$nailatt1, ad_player_nail6] {ad_nail_upd(5,2);};
void() ad_player_nail6 =[$nailatt2, ad_player_nail7] {ad_nail_upd(6,-2);};
void() ad_player_nail7 =[$nailatt1, ad_player_nail8] {ad_nail_upd(7,2);};
void() ad_player_nail8 =[$nailatt2, ad_player_nail1] {ad_nail_upd(8,-2);};

//============================================================================
// The Super Nailgun
// I really liked the idea of saving the frame number of the SNG
// so that when it stops/starts it remembers where it left off
// Unfortunately the gun is reset to frame 0 - the idle state
// when the weapon is not being fired.
// - SNG projectile offset idea by Kinn
//============================================================================
void(float ad_oframe, float ad_oz, float ad_ox) ad_snail_upd = {
	if (ad_frame_pause()) return;
	if (!self.button0) { ad_player_run(); return; }
	self.weaponframe = ad_oframe;
	ad_W_FireSpikes (ad_oz,ad_ox);
};

void() ad_player_snail1 =[$nailatt1, ad_player_snail2] {ad_snail_upd(1,8,2.5);};
void() ad_player_snail2 =[$nailatt2, ad_player_snail3] {ad_snail_upd(2,5.5,-3.5);};
void() ad_player_snail3 =[$nailatt1, ad_player_snail4] {ad_snail_upd(3,3,2.5);};
void() ad_player_snail4 =[$nailatt2, ad_player_snail5] {ad_snail_upd(4,9,0);};
void() ad_player_snail5 =[$nailatt1, ad_player_snail6] {ad_snail_upd(5,3,-2.5);};
void() ad_player_snail6 =[$nailatt2, ad_player_snail7] {ad_snail_upd(6,5.5,3.5);};
void() ad_player_snail7 =[$nailatt1, ad_player_snail8] {ad_snail_upd(7,8,-2.5);};
void() ad_player_snail8 =[$nailatt2, ad_player_snail1] {ad_snail_upd(8,2,0);};

