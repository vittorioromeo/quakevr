//----------------------------------------------------------------------
// Only used for the player when they die
//----------------------------------------------------------------------
void() ad_misc_bubble_bob;
void() ad_death_bubble_spawn =
{
	local entity ad_bubble;
	
	if (self.owner.waterlevel != 3) return;
	
	ad_bubble = spawn();
	ad_bubble.classname = "bubble";
	ad_bubble.solid = ad_SOLID_NOT;
	ad_bubble.movetype = ad_MOVETYPE_NOCLIP;
	setmodel (ad_bubble, ad_SBUBBLE_DROWN);
	ad_bubble.frame = ad_bubble.cnt = 0;
	setorigin (ad_bubble, self.owner.origin + '0 0 24');
	setsize (ad_bubble, '-8 -8 -8', '8 8 8');
	ad_bubble.velocity = '0 0 15';
	ad_bubble.nextthink = time + 0.5;
	ad_bubble.think = ad_misc_bubble_bob;
	
	self.nextthink = time + 0.1;
	self.think = ad_death_bubble_spawn;
	self.ad_air_finished = self.ad_air_finished + 1;
	if (self.ad_air_finished >= self.ad_bubble_count) remove(self);
};

//----------------------------------------------------------------------
void(float ad_num_bubbles) ad_death_bubbles =
{
	local entity ad_bubble_spawner;
	
	ad_bubble_spawner = spawn();
	ad_bubble_spawner.owner = self;
	ad_bubble_spawner.ad_air_finished = 0;
	ad_bubble_spawner.ad_bubble_count = ad_num_bubbles;
	setorigin (ad_bubble_spawner, self.origin);
	ad_bubble_spawner.nextthink = time + 0.1;
	ad_bubble_spawner.think = ad_death_bubble_spawn;
};

//============================================================================
void() ad_PainSound =
{
	if (self.health < 0) return;
	if (self.ad_pain_finished > time) { self.ad_axhitme = 0; return;	}

	// don't make multiple pain sounds right after each other
	self.ad_pain_finished = time + 0.5;

	if (ad_damage_attacker.classname == "teledeath") {
		sound (self, ad_CHAN_VOICE, "player/teledth1.wav", 1, ad_ATTN_NONE);
	}
	// water pain sounds
	else if (self.watertype == ad_CONTENT_WATER && self.waterlevel == 3) {
		ad_death_bubbles(1);
		if (random() > 0.5) sound (self, ad_CHAN_VOICE, "player/drown1.wav", 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, "player/drown2.wav", 1, ad_ATTN_NORM);
	}
	// slime pain sounds
	else if (self.watertype == ad_CONTENT_SLIME) {
		// FIX ME	put in some steam here
		if (random() > 0.5) sound (self, ad_CHAN_VOICE, "player/lburn1.wav", 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, "player/lburn2.wav", 1, ad_ATTN_NORM);
	}
	else if (self.watertype == ad_CONTENT_LAVA) {
		if (random() > 0.5) sound (self, ad_CHAN_VOICE, "player/lburn1.wav", 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, "player/lburn2.wav", 1, ad_ATTN_NORM);
	}
	else {
		// ax pain sound
		if (self.ad_axhitme > 0) {
			self.ad_axhitme = 0;
			// Player been hit by an axe (MP thing)
			sound (self, ad_CHAN_VOICE, ad_SOUND_AXE_PLAYER, 1, ad_ATTN_NORM);
		}
		else {
			self.lip = rint((random() * 5) + 1);
			if (self.lip == 1) self.noise = "player/pain1.wav";
			else if (self.lip == 2) self.noise = "player/pain2.wav";
			else if (self.lip == 3) self.noise = "player/pain3.wav";
			else if (self.lip == 4) self.noise = "player/pain4.wav";
			else if (self.lip == 5) self.noise = "player/pain5.wav";
			else self.noise = "player/pain6.wav";

			sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);
		}
	}
};

//============================================================================
void()	ad_player_pain1 =	[	$pain1,	ad_player_pain2	] {
	ad_PainSound();
	self.weaponframe=ad_IDLE_WEAPON_FRAME;
};
void()	ad_player_pain2 =	[	$pain2,	ad_player_pain3	] {};
void()	ad_player_pain3 =	[	$pain3,	ad_player_pain4	] {};
void()	ad_player_pain4 =	[	$pain4,	ad_player_pain5	] {};
void()	ad_player_pain5 =	[	$pain5,	ad_player_pain6	] {};
void()	ad_player_pain6 =	[	$pain6,	ad_player_run	] {};

void()	ad_player_axpain1 =	[	$axpain1,	ad_player_axpain2	] {
	ad_PainSound();
	self.weaponframe=ad_IDLE_WEAPON_FRAME;
};
void()	ad_player_axpain2 =	[	$axpain2,	ad_player_axpain3	] {};
void()	ad_player_axpain3 =	[	$axpain3,	ad_player_axpain4	] {};
void()	ad_player_axpain4 =	[	$axpain4,	ad_player_axpain5	] {};
void()	ad_player_axpain5 =	[	$axpain5,	ad_player_axpain6	] {};
void()	ad_player_axpain6 =	[	$axpain6,	ad_player_run	] {};

//============================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_player_pain =
{
	if (self.weaponframe) return;
	if (self.ad_invisible_finished > time) return;		// eyes don't have pain frames
	if (self.weapon == ad_IT_AXE) ad_player_axpain1 ();
	else ad_player_pain1 ();
};

//============================================================================
void() ad_player_dead =
{
	self.nextthink = -1;
	// allow respawn after a certain time
	self.deadflag = ad_DEAD_DEAD;
};

