//============================================================================
void() ad_player_death_sound =
{
	// water death sounds
	if (self.waterlevel == 3) {
		ad_death_bubbles(20);
		sound (self, ad_CHAN_VOICE, "player/h2odeath.wav", 1, ad_ATTN_NONE);
	}
	else {
		self.lip = rint ((random() * 4) + 1);
		if (self.lip == 2) self.noise = "player/death2.wav";
		else if (self.lip == 3) self.noise = "player/death3.wav";
		else if (self.lip == 4) self.noise = "player/death4.wav";
		else if (self.lip == 5) self.noise = "player/death5.wav";
		else self.noise = "player/death1.wav";
	
		sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NONE);
	}
};

//============================================================================
void() ad_player_gib =
{
	// Set all gib/death flags correctly
	self.ad_gibbed = ad_TRUE;
	self.deadflag = ad_DEAD_DEAD;
	self.takedamage = ad_DAMAGE_NO;
	self.nextthink = -1;

	// Let the head model bounce around
	self.movetype = ad_MOVETYPE_BOUNCE;
	setmodel (self, self.ad_headmdl);
	setsize (self, '-16 -16 0', '16 16 32');
	self.frame = 0;		// Reset frame, head model only has 1 frame
	self.height = 1;	// Do not remove after model fadeout


	ad_ThrowGib(1, 1);
	ad_ThrowGib(2, 1);
	ad_ThrowGib(3, 1);
	ad_ThrowGib(4, rint(random()*2));
	ad_ThrowGib(5, 1);

	// Lots of vertical momentum
	self.velocity_x = 50 * ad_crandom();
	self.velocity_y = 50 * ad_crandom();
	self.velocity_z = 200 + 100 * random();

	// Minimal angle rotation
	self.avelocity = '0 0 0';
	self.avelocity_y = 200 + random() * 200;
	self.angles = '0 0 0';
	self.angles_y = self.ideal_yaw = random() * 360;

	// Play GIB death sound
	if (ad_damage_attacker.classname == "teledeath") 
		sound (self, ad_CHAN_VOICE, "player/teledth1.wav", 1, ad_ATTN_NONE);
	else if (ad_damage_attacker.classname == "teledeath2")
		sound (self, ad_CHAN_VOICE, "player/teledth1.wav", 1, ad_ATTN_NONE);
	else {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, "player/gib.wav", 1, ad_ATTN_NONE);
		else sound (self, ad_CHAN_VOICE, "player/udeath.wav", 1, ad_ATTN_NONE);
	}
};

//============================================================================
void() ad_player_death =
{
	// don't let sbar look bad if a player
	if (self.health < -99) self.health = -99;	
	if (deathmatch || coop) ad_DropBackpack();
	
	// Remove all powerup/debuff effects
	ad_ResetPowerSystem(self,0,ad_TRUE);
	ad_ResetDebuffSystem(self);

	self.weaponmodel="";
	self.view_ofs = '0 0 8';
	self.deadflag = ad_DEAD_DYING;
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_TOSS;
	
	// Remove floor/ground flag, time to fly
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	setorigin(self, self.origin + '0 0 1');
	
	// Did the player explode from high damage?
	if (self.health < self.ad_gibhealth) ad_player_gib();
	else {
		ad_player_death_sound();
		self.angles_x = self.angles_z = 0;
		if (self.velocity_z < 10)
			self.velocity_z = self.velocity_z + random()*300;
		
		if (self.weapon == ad_IT_AXE) ad_player_die_ax1 ();
		else {
			self.lip = 1 + floor(random()*6);
			if (self.lip == 1) ad_player_diea1();
			else if (self.lip == 2) ad_player_dieb1();
			else if (self.lip == 3) ad_player_diec1();
			else if (self.lip == 4) ad_player_died1();
			else ad_player_diee1();
		}
	}
};

//============================================================================
void() ad_set_suicide_frame =
{	
	// used by kill command and diconnect command
	if (self.ad_gibbed == ad_TRUE) return;	// already gibbed
	self.frame = $deatha11;
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_TOSS;
	self.deadflag = ad_DEAD_DEAD;
	self.nextthink = -1;
};
