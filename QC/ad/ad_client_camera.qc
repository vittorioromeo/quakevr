// AD's readme and docs/vr-port/CREDITS.md), my_progs/client_camera.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
Intermission Camera System

 SetupIntermissionCamera - Find/setup all camera(s)
 StartIntermissionCamera - Setup player ready for viewing
 NextIntermissionCamera - Move player to first/next camera
 CycleIntermissionCamera - wait for player input
 FinishIntermissionCamera - No more viewing
======================================================================*/
float ad_CAMERA_NOINTERMIS = 1;	// Will not work if intermission active
float ad_CAMERA_SOLID = 2;			// Intermission camera interacts with world
float ad_INTERMISSION_ACTIVE = 2;	// Regular Intermission active
float ad_INTERMISSION_RUNE = 3;	// Check for end of episode
float ad_INTERMISSION_ENDGAME = 4;	// End of game!?! (set in oldone.qc)
float ad_INTERMISSION_CAMERA = 10;	// Special Camera only mode

//----------------------------------------------------------------------
void() ad_SetupIntermissionCamera = 
{
	local entity ad_intercam, ad_prevcam;

	// Is the infomission camera chain been setup already?
	if (ad_camera_ent) return;	

	// Try to find the first intermission camera
	ad_intercam = find (world, classname, "info_intermission");
	ad_prevcam = world;
	
	if (ad_intercam) {
		// Cycle through all intermission cameras and link them together
		while(ad_intercam) {
			// first camera in chain? setup first and previous camera
			if (!ad_prevcam) { ad_camera_ent = ad_intercam; ad_camera_ent.count = 0;}
			else ad_prevcam.owner = ad_intercam;

			// Save current camera to previous ready for loop
			ad_prevcam = ad_intercam;
			ad_camera_ent.count = ad_camera_ent.count + 1;
			//dprint("[CAM] ("); dprint(ftos(camera_ent.count));
			//dprint(") Org ("); dprint(vtos(intercam.origin)); dprint(")\n");
				
			ad_intercam = find(ad_intercam, classname, "info_intermission");
		}
		// Close the camera chain
		ad_prevcam.owner = ad_camera_ent;
		dprint("\b[CAMERA]\b Intermissions found (");
		dprint(ftos(ad_camera_ent.count)); dprint(")\n");
	}
	else {
		dprint("\b[CAMERA]\b Intermissions missing!\n");
		// Cannot find any info_intermission cameras, so use player start
		// If there is no player start then use player's last location!
		if (deathmatch) ad_intercam = find (world, classname, "info_player_deathmatch");
		else ad_intercam = find (world, classname, "info_player_start");
		if (!ad_intercam) ad_intercam = ad_client_ent;
			
		// Spawn a new camera entity
		ad_camera_ent = spawn();
		ad_camera_ent.ad_classtype = ad_CT_CAMERA;
		setsize (ad_camera_ent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_camera_ent.movetype = ad_MOVETYPE_NONE;
		ad_camera_ent.solid = ad_SOLID_NOT;
		setorigin(ad_camera_ent, ad_intercam.origin);
		setmodel(ad_camera_ent, ad_MODEL_EMPTY);
		ad_camera_ent.mangle = ad_intercam.angles;
		ad_camera_ent.count = 1;
		ad_camera_ent.owner = ad_camera_ent;
	}
};

//----------------------------------------------------------------------
void() ad_FinishIntermissionCamera =
{
	// skip any text in deathmatch
	if (deathmatch) { ad_GotoNextMap (); return; }
	
	ad_intermission_exittime = time + 1;
	ad_intermission_running = ad_intermission_running + 1;

	//----------------------------------------------------------------------
	// run some text if at the end of an each episode
	//----------------------------------------------------------------------
	if (ad_intermission_running == ad_INTERMISSION_RUNE) {
		if (world.model == "maps/e1m7.bsp") {
			WriteByte (ad_MSG_ALL, ad_SVC_CDTRACK);
			WriteByte (ad_MSG_ALL, 2);
			WriteByte (ad_MSG_ALL, 3);
			if (!cvar("registered")) {
				WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
				WriteString (ad_MSG_ALL, "As the corpse of the monstrous entity\nChthon sinks back into the lava whence\nit rose, you grip the Rune of Earth\nMagic tightly. Now that you have\nconquered the Dimension of the Doomed,\nrealm of Earth Magic, you are ready to\ncomplete your task in the other three\nhaunted lands of Quake. Or are you? If\nyou don't register Quake, you'll never\nknow what awaits you in the Realm of\nBlack Magic, the Netherworld, and the\nElder World!");
			}
			else {
				WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
				WriteString (ad_MSG_ALL, "As the corpse of the monstrous entity\nChthon sinks back into the lava whence\nit rose, you grip the Rune of Earth\nMagic tightly. Now that you have\nconquered the Dimension of the Doomed,\nrealm of Earth Magic, you are ready to\ncomplete your task. A Rune of magic\npower lies at the end of each haunted\nland of Quake. Go forth, seek the\ntotality of the four Runes!");
			}
			return;
		}
		else if (world.model == "maps/e2m6.bsp") {
			WriteByte (ad_MSG_ALL, ad_SVC_CDTRACK);
			WriteByte (ad_MSG_ALL, 2);
			WriteByte (ad_MSG_ALL, 3);

			WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
			WriteString (ad_MSG_ALL, "The Rune of Black Magic throbs evilly in\nyour hand and whispers dark thoughts\ninto your brain. You learn the inmost\nlore of the Hell-Mother; Shub-Niggurath!\nYou now know that she is behind all the\nterrible plotting which has led to so\nmuch death and horror. But she is not\ninviolate! Armed with this Rune, you\nrealize that once all four Runes are\ncombined, the gate to Shub-Niggurath's\nPit will open, and you can face the\nWitch-Goddess herself in her frightful\notherworld cathedral.");
			return;
		}
		else if (world.model == "maps/e3m6.bsp") {
			WriteByte (ad_MSG_ALL, ad_SVC_CDTRACK);
			WriteByte (ad_MSG_ALL, 2);
			WriteByte (ad_MSG_ALL, 3);

			WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
			WriteString (ad_MSG_ALL, "The charred viscera of diabolic horrors\nbubble viscously as you seize the Rune\nof Hell Magic. Its heat scorches your\nhand, and its terrible secrets blight\nyour mind. Gathering the shreds of your\ncourage, you shake the devil's shackles\nfrom your soul, and become ever more\nhard and determined to destroy the\nhideous creatures whose mere existence\nthreatens the souls and psyches of all\nthe population of Earth.");
			return;
		}
		else if (world.model == "maps/e4m7.bsp") {
			WriteByte (ad_MSG_ALL, ad_SVC_CDTRACK);
			WriteByte (ad_MSG_ALL, 2);
			WriteByte (ad_MSG_ALL, 3);

			WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
			WriteString (ad_MSG_ALL, "Despite the awful might of the Elder\nWorld, you have achieved the Rune of\nElder Magic, capstone of all types of\narcane wisdom. Beyond good and evil,\nbeyond life and death, the Rune\npulsates, heavy with import. Patient and\npotent, the Elder Being Shub-Niggurath\nweaves her dire plans to clear off all\nlife from the Earth, and bring her own\nfoul offspring to our world! For all the\ndwellers in these nightmare dimensions\nare her descendants! Once all Runes of\nmagic power are united, the energy\nbehind them will blast open the Gateway\nto Shub-Niggurath, and you can travel\nthere to foil the Hell-Mother's plots\nin person.");
			return;
		}
		// No special end text? go straight to next map
		ad_GotoNextMap();
	}
	//----------------------------------------------------------------------
	// If the player has all four runes, print more text!?!
	//----------------------------------------------------------------------
	else if (ad_intermission_running == ad_INTERMISSION_ENDGAME) {
		if (!cvar("registered")) {	
			// shareware episode has been completed, go to sell screen
			WriteByte (ad_MSG_ALL, ad_SVC_SELLSCREEN);
			return;
		}
		
		if ( (serverflags & ad_SVR_RUNE_ALL) == ad_SVR_RUNE_ALL) {
			WriteByte (ad_MSG_ALL, ad_SVC_FINALE);
			WriteString (ad_MSG_ALL, "Now, you have all four Runes. You sense\ntremendous invisible forces moving to\nunseal ancient barriers. Shub-Niggurath\nhad hoped to use the Runes Herself to\nclear off the Earth, but now instead,\nyou will use them to enter her home and\nconfront her as an avatar of avenging\nEarth-life. If you defeat her, you will\nbe remembered forever as the savior of\nthe planet. If she conquers, it will be\nas if you had never been born.");
			return;
		}
	}
	// Finished episode text and shub waking up text, then finally next map!
	else ad_GotoNextMap();
};

//----------------------------------------------------------------------
void() ad_NextIntermissionCamera = 
{
	// This method is unreliable, it is better to move the players
	// origin like the orginal method used by the id QC
	//msg_entity = self;
	//WriteByte(MSG_ALL, SVC_SETVIEW);
	//WriteEntity(MSG_ALL, self.goalentity);
	
	// Exclude the special intermission cameras (special impulse)
	if (ad_camera_ent.count > 1 && ad_intermission_running > 0
		&& ad_intermission_running < ad_INTERMISSION_CAMERA) {
		// Cycle through list trying to find a camera
		// designed for the intermission at the end of a map
		// Can have special cameras designed for impulse 145!
		while(self.goalentity.spawnflags & ad_CAMERA_NOINTERMIS) {
			self.goalentity = self.goalentity.owner;
		}
	}
	
	// Switch player view to intermission camera
	self.view_ofs = '0 0 0';
	setorigin(self, self.goalentity.origin);
	self.angles = self.v_angle = self.goalentity.mangle;
	self.fixangle = ad_TRUE; 
	
	// Change the camera to allow for environment interaction
	if (self.goalentity.spawnflags & ad_CAMERA_SOLID) {
		self.solid = ad_SOLID_TRIGGER;
		setsize(self, ad_VEC_HULLE_MIN, ad_VEC_HULLE_MAX);
	}
	// no interaction, static
	else {
		self.solid = ad_SOLID_NOT;
		setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	}
	
	// If target exists on camera fire triggers (once)
	if (self.goalentity.target != "") {
		ad_trigger_strs(self.goalentity.target, self); 
		self.goalentity.target = "";
	}

	// CHANGE fog for intermission camera
	if (ad_fog_active && self.goalentity.fog_density > 0) {
		// Double check for quake.rc parameter
		// AD 1.8 removed SVR_NOFOGCMDS (winquake idea)
		ad_fade_fog(self.goalentity.fog_density, self.goalentity.ad_fog_colour, self.goalentity.speed);
	}
	
	// CHANGE sky_fog for intermission camera
	if (ad_fog_active && self.goalentity.ad_skyfog_density > 0) {
		// Double check for quake.rc parameter
		// AD 1.8 removed SVR_NOFOGCMDS (winquake idea)
		ad_fade_skyfog(self.goalentity.ad_skyfog_density, self.goalentity.speed);
	}
	
	// CHANGE skybox for intermission camera
	if (self.goalentity.ad_skybox != "") {
		ad_trig_skybox = self.goalentity.ad_skybox;
		ad_trigger_skybox_change(self);
	}
};

//----------------------------------------------------------------------
void() ad_CycleIntermissionCamera =
{
	// Is the intermission camera still being setup?
	if (ad_intermission_running < ad_INTERMISSION_ACTIVE) return;
	if (self.waitmin > time) return;		// delay input from keyboard
	
	// check for jump button to exit
	if (self.button1 || self.button2 || (self.button0 && ad_camera_ent.count == 1) ) {
		self.button0 = self.button1 = self.button2 = 0;
		if (ad_intermission_running != ad_INTERMISSION_CAMERA) {
			self.waitmin = time + 1;
			if (time > ad_intermission_exittime) ad_FinishIntermissionCamera ();
		}
	}
	// check for attack button to switch cameras
	else if (self.button0) {
		self.button0 = self.button1 = self.button2 = 0;
		self.waitmin = time + 0.5;

		// Shift forward to next camera
		self.goalentity = self.goalentity.owner;
		ad_NextIntermissionCamera();
	}
};

//----------------------------------------------------------------------
void() ad_StartIntermissionCamera = 
{
	if (ad_camera_ent) {
		// Switch self to client (stored when client is setup)
		self = ad_client_ent;
		
		// Switch on notarget so monsters don't attack player
		// Add god mode to prevent any damage, is reset on map change
		self.flags = self.flags + (ad_FL_NOTARGET || ad_FL_GODMODE);
		self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	
		// reset player model to nothing and no world interaction
		self.view_ofs = self.velocity = self.avelocity = '0 0 0';
		self.solid = ad_SOLID_NOT;
		self.movetype = ad_MOVETYPE_NONE;		// no more movement
		self.takedamage = ad_DAMAGE_NO;		// no more damage
		setmodel(self, ad_MODEL_EMPTY);		// Hide player model
		setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.weaponmodel = ad_string_null;		// No vmodel updates
		self.frame = self.weaponframe = 0;	// reset all frames
		self.waitmin = time + 0.5;			// Delay before start
		self.think = ad_SUB_Null;				// Stop player.qc

		// Finish artifacts timers, except vania items
		ad_ResetPowerSystem(self,0,ad_FALSE);

		// Setup default - first camera to look through
		self.goalentity = ad_camera_ent;
		// Is there more than 1 camera and intermission time?
		// Always start at the first camera if using camera test mode
		if (ad_camera_ent.count > 1 && ad_intermission_running > 0) {
			// Randomly pick a camera to cycle forward to
			self.lip = rint(random() * ad_camera_ent.count);
			while (self.lip > 0) {
				self.goalentity = self.goalentity.owner;// Cycle through list
				self.lip = self.lip - 1;				// Keep looping
			}
		}

		// Switch player to the currently selected camera
		ad_NextIntermissionCamera();
		
		// Check if end of map intermission is really running? 
		// Can enter this function via camera test mode (impulse xxx)
		if (ad_intermission_running == 0) ad_intermission_running = ad_INTERMISSION_CAMERA;
		else ad_intermission_running = ad_INTERMISSION_ACTIVE;
	}
	// If camera entity not setup, go straight to next map
	else ad_FinishIntermissionCamera ();
};
