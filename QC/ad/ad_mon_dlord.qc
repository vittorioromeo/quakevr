//===========================================================================
void() ad_dlord_shieldon =
{
	self.effects = ad_EF_BRIGHTFIELD;	// Glowing yellow particle effect
	self.takedamage = ad_DAMAGE_YES;	// Grenades bounce off
	self.ad_bouncegrenade = ad_TRUE;		// Warning to other monsters
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles
	// Visually show resistance and reduce damage taken
	self.ad_resist_shells = self.ad_resist_nails = 0.5;
	self.ad_resist_rockets = self.ad_resist_cells = 0.5;
};

void() ad_dlord_shieldoff =
{
	self.effects = ad_FALSE;			// No engine particle effects active
	self.takedamage = ad_DAMAGE_AIM;	// Grenades make contact
	self.ad_bouncegrenade = ad_FALSE;		// Reset to default
	self.ad_reflectlightning = ad_FALSE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_FALSE;		// Reflect plasma projectiles
	self.ad_reflectnails = ad_FALSE;		// Reflect nail projectiles
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
};

