void()	ad_dlord_dieb3	=[	$deathb3,	ad_dlord_dieb4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void()	ad_dlord_dieb4	=[	$deathb4,	ad_dlord_dieb5	] {};
void()	ad_dlord_dieb5	=[	$deathb5,	ad_dlord_dieb6	] {};
void()	ad_dlord_dieb6	=[	$deathb6,	ad_dlord_dieb7	] {};
void()	ad_dlord_dieb7	=[	$deathb7,	ad_dlord_dieb8	] {};
void()	ad_dlord_dieb8	=[	$deathb8,	ad_dlord_dieb9	] {ad_monster_death_postcheck();};
void()	ad_dlord_dieb9	=[	$deathb9,	ad_dlord_dieb9	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_dlord_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	
	// regular death
	if (!self.ad_gibbed) {
	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dlord_die1 ();	// Forward - standard
		else ad_dlord_dieb1 ();				// Backward - standard
	}
};

//============================================================================
void() ad_dlord_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

/*======================================================================
 QUAKED monster_death_lord (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_death_lord =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	// No head model defined
	self.mdl = "progs/mon_dlord.mdl";			// hknight.mdl (quoth)
	self.ad_gib1mdl = "progs/h_dlord.mdl";			// h_dlord.mdl (quoth)
	self.ad_gib2mdl = "progs/w_hknightsword.mdl";	// Unique sword
	self.ad_gib3mdl = "progs/gib_knfoot_l.mdl";	// left foot
	self.ad_gib4mdl = "progs/gib_knfoot_r.mdl";	// right foot
	
	// The Quoth head model only has 1 skin which does not match the
	// dlord model which has 2, so throw the head as a custom gib instead
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_DLORD1);			// Copy of proj_serg.mdl
	precache_model (self.ad_gib1mdl);				// Head gib (skin probs)
	precache_model (self.ad_gib2mdl);				// Old HK Sword
	precache_model (self.ad_gib3mdl);				// HK foot
	precache_model (self.ad_gib4mdl);

	self.ad_gib2sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib3mdl = ad_string_null;
	if (random() < 0.5) self.ad_gib4mdl = ad_string_null;

	self.ad_idle_sound = "dlord/idle.wav";
	precache_sound (self.ad_idle_sound);

	// Firing of magic spikes (first 0.1s must loop)
	precache_sound ("hknight/attack1.wav");
	
	// TE_KNIGHTSPIKE = Magic spike hitting the wall
	// Has got to be in this location because the 
	// filename is hardcoded (engine.exe)
	precache_sound ("hknight/hit.wav");				

	// precache sight, pain and death (changes on type)
	self.ad_sight_sound = "dlord/sight.wav";
	precache_sound (self.ad_sight_sound);

	// Pain and Death and Taxes!
	self.ad_pain_sound = "dlord/pain.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "dlord/death.wav";
	precache_sound (self.ad_death_sound);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");
		
	self.solid = ad_SOLID_NOT;					// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;			// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 400;
	self.ad_gibhealth = -50;					// Not easy to gib
	self.ad_gibbed = ad_FALSE;					// Still in one piece
	self.ad_pain_flinch = 60;					// Medium pain threshold
	self.ad_pain_timeout = 2;					// High pain threshold
	self.ad_pain_longanim = ad_TRUE;				// can be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPEHEAVY;			// Heavy Hell Knight
	self.ad_attack_offset = '20 0 24';			// End of sword
	self.ad_exactskin = 1;						// Rotting Lord skin
	self.ad_poisonous = ad_FALSE;					// No support for this
	self.ad_deathstring = " was executed by a Death Lord\n";
	
	// Reset Ammo Resistance/Shield parameters
	ad_dlord_shieldoff();

	// Using alt magic and charge attacks
	self.ad_th_checkattack = ad_DLordCheckAttack;
	self.ad_th_stand = ad_dlord_stand1;		// Idling on feet
	self.ad_th_walk = ad_dlord_walk1;			// Walking
	self.ad_th_run = ad_dlord_slow1;			// Running
	self.ad_th_melee = ad_dlord_magica1;		// Sword attack
	self.ad_th_missile = ad_dlord_magicb1;	// Spike ball attack
	self.ad_th_updmissile = ad_dlord_spike_think;	// Update flying spikeball
	self.ad_th_pain = ad_dlord_pain;			// Stumble and pain
	self.ad_th_die = ad_dlord_die;			// Face meets floor
	
	self.ad_classtype = ad_CT_MONDLORD;
	self.ad_classgroup = ad_CG_DCAPTAIN;		// Classic tincan!
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();
};
