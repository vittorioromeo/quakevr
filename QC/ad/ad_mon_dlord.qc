//============================================================================
// RANGE - SPIKEBALL (Fast spike damage)
//============================================================================
void() ad_dlord_spike_think =
{
	// Only track enemies with a pulse!
	if (self.enemy.health < 1) return;
	
	// Only do a limited amount of updates
	self.count = self.count + 1;
	if (self.count < (5+ad_skill)) {
		// Keep ticking (slowly)
		self.nextthink = time + 0.1;

		// Steer towards enemy (not very precise)
		self.pos1 = (self.enemy.origin - (self.origin + '0 0 -12')) * 0.6;
		self.pos2 = self.pos1 + self.velocity * 0.4;
		self.ad_pos3 = normalize(self.pos2);
		self.velocity = self.ad_pos3 * self.ad_attack_speed;
		
		// Perfect angle correction, very frustrating
		// self.attack_track = normalize(self.enemy.origin - self.origin);
		// self.velocity = self.attack_track * self.attack_speed;
		// self.angles = vectoangles(self.velocity);
	}
	else {
		// Remove spikeball after a long while
		self.nextthink = time + ad_LIFE_PROJECTILE;
		self.think = ad_SUB_Remove;
	}
};

//----------------------------------------------------------------------
void() ad_dlord_attackb =
{
	local vector ad_org, ad_dir, ad_offang;
	
	// Keep adding up projectile counter
	self.ad_attack_chance = self.ad_attack_chance + 1;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "hknight/attack1.wav", 1, ad_ATTN_NORM);	

	// Randomize projectile offset (similar to HK)
	if (random() < 0.4) self.ad_weaponstate = 0;
	else {
		if (random() <= 0.7) self.ad_weaponstate = -1;
		else self.ad_weaponstate = 1;
	}

	// Keep tracking enemy origin (similar to wizards)
	ad_ai_trackenemy();

	// Shift the firing angle 6 degree's left/right
	ad_offang = vectoangles(self.ad_attack_track - self.origin);
	ad_offang_y = ad_offang_y + (self.ad_weaponstate * 6);
	makevectors (ad_offang);

	// Calculate the origin (end of sword)
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	// Use previous firing angle to calculate firing direction
	ad_dir = normalize (v_forward);
	ad_dir_z = 0 - ad_dir_z + (random() - 0.5) * 0.2;
	
	// Add skill level to firing speed calculation
	self.ad_attack_speed = ad_SPEED_DLORDMISSILE + (ad_skill * ad_SPEED_DLORDSKILL);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_DLORD, self.ad_attack_speed);
}

//----------------------------------------------------------------------
void() ad_dlord_magicb1 = [ $magicb1, ad_dlord_magicb2 ] {
	self.ad_attack_track = self.enemy.origin;
	self.ad_attack_chance = self.ad_attack_timer = 0;
	ad_dlord_shieldoff();
};
void() ad_dlord_magicb2 = [ $magicb2, ad_dlord_magicb3 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb3 = [ $magicb3, ad_dlord_magicb4 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb4 = [ $magicb4, ad_dlord_magicb5 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb5 = [ $magicb5, ad_dlord_magicb6 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb6 = [ $magicb6, ad_dlord_magicb7 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb7 = [ $magicb7, ad_dlord_magicb8 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb8 = [ $magicb8, ad_dlord_magicb9 ] {ad_ai_trackenemy();};
void() ad_dlord_magicb9 = [ $magicb9, ad_dlord_magicb10] {
	if (VR_AimCone_Wait(ad_dlord_magicb9, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	// Is the enemy active and self alive?
	if (self.enemy && self.health > 0) {
		ad_dlord_attackb();	// Fire projectile
		
		// Anymore projectiles to fire?
		if (self.ad_attack_chance < ad_MONAI_DLORDMAX) {
			// Is the player still visible?
			if ( ad_visxray(self.enemy, self.ad_attack_offset, '0 0 0', ad_FALSE) ) {
				self.ad_attack_timer = time + 0.8;
			}
			// Is the enemy in view timer still active?
			if (self.ad_attack_timer > time) self.think = ad_dlord_magicb8;
		}
	}
};
void() ad_dlord_magicb10 = [ $magicb10, ad_dlord_magicb11 ] {};
void() ad_dlord_magicb11 = [ $magicb11, ad_dlord_magicb12 ] {};
void() ad_dlord_magicb12 = [ $magicb12, ad_dlord_magicb13 ] {};
void() ad_dlord_magicb13 = [ $magicb13, ad_dlord_slow1 ] {ad_ai_face();};

