/*======================================================================
 MATHLIB STUFF

 Originally created by FrikaC
 Some functions provided by Kashua & LordHavoc & Preach

======================================================================*/

// for speed...
float ad_pi = 3.14159265;
float ad_OneEightyOverPi = 57.29577;
float ad_PiOverOneEighty = 0.017453;

float() ad_crandom = { return 2*(random() - 0.5); };

// You can set the accuracy of mathlib by changing this value.
// If unset, it defaults to 0.001
float ad_mathlib_accuracy; //accuracy of sqrt & pow

// Definition/list of all math functions
float(float ad_num) ad_mathlib_sqrt;
float(float ad_num) ad_mathlib_sin;
float(float ad_num) ad_mathlib_cos;
float(float ad_a, float ad_b) ad_mathlib_fast_pow;
float (float ad_number, float ad_exp) ad_mathlib_bitshift;
float(float ad_a, float ad_b) ad_mod;
float(float ad_v) ad_anglemod;
float (float ad_y1, float ad_y2) ad_angcomp;
float (float ad_a, float ad_b) ad_mathlib_min;
float (float ad_a, float ad_b) ad_mathlib_max;
float(float ad_minimum, float ad_val, float ad_maximum) ad_mathlib_bound;
vector() ad_mathlib_randomvec;
float (float ad_num) ad_rad2deg;
float (float ad_num) ad_deg2rad;
float(float ad_theta) ad_mathlib_tan;
float(float y, float x) ad_mathlib_atan2;

/*----------------------------------------------------------------------
Will return 0/1 if bitflag is present in bitvalue
----------------------------------------------------------------------*/
float(float ad_bitvalue, float ad_bitflag) ad_mathlib_bitvalue =
{
	return floor( (ad_bitvalue & ad_bitflag) / ad_bitflag);
};

/*----------------------------------------------------------------------
square root
----------------------------------------------------------------------*/
float(float ad_num) ad_mathlib_sqrt =
{
	local float ad_apr;

	//this sets a level of accuracy, it's a global float
	if(ad_mathlib_accuracy <= 0) ad_mathlib_accuracy = 0.001;   

	if (ad_num < ad_mathlib_accuracy) return 0;
	if (ad_num>1) ad_apr = ad_num;
	else ad_apr = 1;
	do {
		ad_apr = (ad_num + (ad_apr * ad_apr)) / (2 * ad_apr);
	}
	while (fabs((ad_apr * ad_apr) - ad_num) > (ad_num * ad_mathlib_accuracy));
	return ad_apr;
};

/*----------------------------------------------------------------------
sine
----------------------------------------------------------------------*/
float(float ad_num) ad_mathlib_sin =
{
	local vector ad_ang,ad_vf,ad_vu,ad_vr;
	
	// Save V_ variable states
	ad_vf = v_forward;
	ad_vu = v_up;
	ad_vr = v_right;
	// Use makevectors to get sin
	ad_ang = '0 1 0' * ad_num;
	makevectors(ad_ang);
	ad_num = v_forward_y;
	// Restore V_ variables
	v_forward = ad_vf;
	v_up = ad_vu;
	v_right = ad_vr;
	// Return SIN
	return ad_num;
};

/*----------------------------------------------------------------------
cosine
----------------------------------------------------------------------*/
float(float ad_num) ad_mathlib_cos =
{
	local vector ad_ang,ad_vf,ad_vu,ad_vr;
	
	ad_vf = v_forward;
	ad_vu = v_up;
	ad_vr = v_right;
	
	ad_ang = '0 1 0' * ad_num;
	makevectors(ad_ang);
	ad_num = v_forward_x;
	
	v_forward = ad_vf;
	v_up = ad_vu;
	v_right = ad_vr;
	
	return ad_num;
};

/*----------------------------------------------------------------------
pow

raise to a power

you ought not use this if the power you're raising to is constant
ie, just use r * r * r for cubing, it's a lot faster
----------------------------------------------------------------------*/
float(float ad_a, float ad_b) ad_mathlib_fast_pow =
{
	local float ad_fb, ad_n, ad_bit, ad_factor;
	
	ad_fb = fabs(ad_b);
	ad_bit = 1;
	ad_n = 1;
	ad_factor = ad_a;
	while (ad_bit <= ad_fb)
	{
		if (ad_fb&ad_bit)
			ad_n = ad_n * ad_factor;
		ad_factor = ad_factor * ad_factor;
		ad_bit = ad_bit * 2;
	}
	if (ad_b < 0)
		return 1/ad_n;
	else
		return ad_n;
};

float(float ad_a, float ad_b) ad_mathlib_pow =
{
	local float ad_e1,ad_e2,ad_f,ad_i;
	
	if (ad_mathlib_accuracy <= 0)
		ad_mathlib_accuracy = 0.001; 
	if (fabs(rint(ad_b) - ad_b) <= ad_mathlib_accuracy)
		return ad_mathlib_fast_pow(ad_a, rint(ad_b));
		
	ad_f = (ad_a - 1) / (ad_a + 1);
	//this is the first trick
	//we're essentially doing exp(b*log(a))
	//but the power series for log (1+x) is only defined for small x
	//however log x = 2 * arctanh((x-1)/(x+1)) which will converge for any x we choose

	ad_e1 = 0;	            
	ad_e2 = 2 * ad_f;
	ad_i = 1;
	ad_f = ad_f * ad_f;
	
	// this calculates successive terms of arctanh
	//when the absolute value of a term drops
	//below accuracy we call it a day
	//note that this doesn't actually mean
	//the output is accurate to 0.001, there's no
	//direct bound on accuracy
	while(fabs(ad_e2) > ad_mathlib_accuracy)
	{
		ad_e1 = ad_e1 + ad_e2;
		ad_e2 = ad_e2 * ad_f * ((2 * ad_i) - 1) / ((2 * ad_i) + 1);
		ad_i = ad_i + 1;
	}

	ad_f = ad_e2 = ad_e1 * ad_b;
	ad_e1 = 1;
	ad_i = 1;
	//same idea, this is the exponential function
	//which has a nice power series
	//same comments about accuracy apply, except
	//the rapid decay of terms mean it's probably
	//close to the true value of exp f, if not pow(a,b)
	while(fabs(ad_e2) > ad_mathlib_accuracy)
	{
		ad_e1 = ad_e1 + ad_e2;
		ad_i = ad_i + 1;
		ad_e2 = ad_e2 * ad_f / ad_i;
	}
	return ad_e1;
} ;

/*----------------------------------------------------------------------
Bitshift
----------------------------------------------------------------------*/
float (float ad_number, float ad_exp) ad_mathlib_bitshift =
{
	local float ad_bit, ad_fexp;
	ad_bit = 1;
	ad_fexp = fabs(ad_exp);
	ad_number = rint(ad_number);
	
	while (ad_bit <= ad_fexp) {
		if (ad_fexp & ad_bit) {
			if (ad_exp > 0) ad_number = ad_number * ad_bit * 2;
			else ad_number = floor(ad_number / (ad_bit * 2));
		}
		ad_bit = ad_bit * 2;
	}
	return ad_number;
};

//----------------------------------------------------------------------
// Returns power of 10
//----------------------------------------------------------------------
float(float ad_pow_loop, float ad_pow_bit) ad_mathlib_powbit =
{
	local float ad_pow_num, ad_pow_counter;
	// Allow for starting range to be different
	ad_pow_num = ad_pow_bit;
	ad_pow_counter = 1;
	if (ad_pow_loop < 1) ad_pow_loop = 1;
			
	while (ad_pow_counter < ad_pow_loop) {
		ad_pow_num = ad_pow_num * ad_pow_bit;
		ad_pow_counter = ad_pow_counter + 1;
	}
	return ad_pow_num;
}; 

/*----------------------------------------------------------------------
Return exact division
----------------------------------------------------------------------*/
float(float ad_divnum, float ad_divider) ad_mathlib_divisible =
{
	local float ad_retval;
	ad_retval = 0;
	// Check for leading zero (always return zero)
	if (ad_divider > ad_divnum) return ad_retval;
	// Got a number that can be divided
	while (ad_divnum >= ad_divider) {
		ad_divnum = ad_divnum - ad_divider;
		ad_retval = ad_retval + 1;
	}
	return ad_retval;
};

/*----------------------------------------------------------------------
Return truncated number
----------------------------------------------------------------------*/
float(float ad_trnum, float ad_topbit, float ad_botbit) ad_mathlib_truncate =
{
	local float ad_tr_pow, ad_tr_counter, ad_tr_result;
	
	// Calc Maximum POW above number to truncate
	ad_tr_counter = 0;
	ad_tr_pow = ad_mathlib_powbit(ad_topbit,10);
	while (ad_tr_pow < ad_trnum) {
		ad_tr_counter = ad_tr_counter + 1;
		ad_tr_pow = ad_tr_pow * 10;
	}
	
	// Count down the digits to remove
	while (ad_tr_counter > 0) {
		// Move down one pow digit
		ad_tr_pow = ad_tr_pow / 10;
		// Divide number by pow to get divider
		ad_tr_result = ad_mathlib_divisible(ad_trnum, ad_tr_pow);
		ad_trnum = ad_trnum - (ad_tr_result * ad_tr_pow);
		ad_tr_counter = ad_tr_counter - 1;
	}
	
	// Fix the rounding errors by shifting the number up/down
	ad_tr_pow = ad_mathlib_powbit(ad_botbit,10);
	ad_trnum = rint(ad_trnum*ad_tr_pow);
	ad_trnum = ad_trnum / ad_tr_pow;
	// Final result
	return ad_trnum;
};

/*----------------------------------------------------------------------
Remainder

Similar to C's % operator, but deals with
negative numbers differently.
----------------------------------------------------------------------*/
float(float ad_a, float ad_b) ad_mod =
{
	return ad_a - (floor(ad_a / ad_b) * ad_b);
};

/*======================================================================
mathlib_anglemod 

faster version of id's anglemod
======================================================================*/
float(float ad_v) ad_anglemod =
{
	return ad_v - floor(ad_v/360) * 360;
};

//----------------------------------------------------------------------
// Vector version of anglemod
vector(vector ad_targang) ad_vectormod =
{
	local vector ad_finang;
	ad_finang_x = ad_anglemod(ad_targang_x);
	ad_finang_y = ad_anglemod(ad_targang_y);
	ad_finang_z = ad_anglemod(ad_targang_z);
	return ad_finang;
}

//----------------------------------------------------------------------
// Original version from ai.qc
/*float(float v) anglemod =
{
	while (v >= 360)
		v = v - 360;
	while (v < 0)
		v = v + 360;
	return v;
};
*/

/*----------------------------------------------------------------------
angcomp (part of FrikBot)

subtracts one angle from another
----------------------------------------------------------------------*/
float (float ad_y1, float ad_y2) ad_angcomp = 
{
	ad_y1 = ad_anglemod(ad_y1);
	ad_y2 = ad_anglemod(ad_y2);

	local float ad_answer;
	ad_answer = ad_y1 - ad_y2;
	if (ad_answer > 180)
		ad_answer = ad_answer - 360;
	else if (ad_answer < -180)
		ad_answer = ad_answer + 360;
	return ad_answer;
};

/*----------------------------------------------------------------------
min
Returns the lesser of two (or more) numbers
----------------------------------------------------------------------*/
float (float ad_a, float ad_b) ad_mathlib_min =
{
	if (ad_a<ad_b)
		return ad_a;
	else
		return ad_b;
};

float (float ad_a, float ad_b, float ad_c) ad_mathlib_min3 =
{
	if (ad_a<ad_b)
	{
		if (ad_c<ad_a)
			return ad_c;
		else
			return ad_a;
	}
	else
	{
		if (ad_c<ad_b)
			return ad_c;
		else
			return ad_b;
	}
};

float (float ad_a, float ad_b, float ad_c, float ad_d) ad_mathlib_min4 =
{
	return ad_mathlib_min(ad_mathlib_min3(ad_a,ad_b,ad_c),ad_d);
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e) ad_mathlib_min5 =
{
	return ad_mathlib_min3(ad_mathlib_min3(ad_a,ad_b,ad_c),ad_d,ad_e);
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e, float ad_f) ad_mathlib_min6 =
{
	return ad_mathlib_min(ad_mathlib_min3(ad_a,ad_b,ad_c), ad_mathlib_min3(ad_d,ad_e,ad_f));
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e, float ad_f, float ad_g) ad_mathlib_min7 =
{
	return ad_mathlib_min3(ad_mathlib_min3(ad_a,ad_b,ad_c), ad_mathlib_min3(ad_d,ad_e,ad_f), ad_g);
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e, float ad_f, float ad_g, float ad_h) ad_mathlib_min8 =
{
	return ad_mathlib_min3(ad_mathlib_min3(ad_a,ad_b,ad_c), ad_mathlib_min3(ad_d,ad_e,ad_f), ad_mathlib_min(ad_g, ad_h));
};

/*----------------------------------------------------------------------
max
Returns the greater of two (or more) numbers
----------------------------------------------------------------------*/
float (float ad_a, float ad_b) ad_mathlib_max =
{
	if (ad_a>ad_b)
		return ad_a;
	else
		return ad_b;
};
float (float ad_a, float ad_b, float ad_c) ad_mathlib_max3 =
{
	if (ad_a>ad_b)
	{
		if (ad_c>ad_a)
			return ad_c;
		else
			return ad_a;
	}
	else
	{
		if (ad_c>ad_b)
			return ad_c;
		else
			return ad_b;
	}
};
float (float ad_a, float ad_b, float ad_c, float ad_d) ad_mathlib_max4 =
{
	return ad_mathlib_max(ad_mathlib_max3(ad_a,ad_b,ad_c),ad_d);
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e) ad_mathlib_max5 =
{
	return ad_mathlib_max3(ad_mathlib_max3(ad_a,ad_b,ad_c),ad_d,ad_e);
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e, float ad_f) ad_mathlib_max6 =
{
	return ad_mathlib_max(ad_mathlib_max3(ad_a,ad_b,ad_c), ad_mathlib_max3(ad_d,ad_e,ad_f));
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e, float ad_f, float ad_g) ad_mathlib_max7 =
{
	return ad_mathlib_max3(ad_mathlib_max3(ad_a,ad_b,ad_c), ad_mathlib_max3(ad_d,ad_e,ad_f), ad_g);
};
float (float ad_a, float ad_b, float ad_c, float ad_d, float ad_e, float ad_f, float ad_g, float ad_h) ad_mathlib_max8 =
{
	return ad_mathlib_max3(ad_mathlib_max3(ad_a,ad_b,ad_c), ad_mathlib_max3(ad_d,ad_e,ad_f), ad_mathlib_max(ad_g, ad_h));
};

/*----------------------------------------------------------------------
bound
Returns a number bound to certain limits
----------------------------------------------------------------------*/
float(float ad_minimum, float ad_val, float ad_maximum) ad_mathlib_bound =
{
	if (ad_val<ad_minimum)
		ad_val=ad_minimum;
	else if (ad_val>ad_minimum)
		ad_val=ad_maximum;
	return ad_val;
};

/*----------------------------------------------------------------------
randomvec
Returns a random vector of length < 1
----------------------------------------------------------------------*/
vector () ad_mathlib_randomvec =
{
	local vector ad_v;
	do
	{
		ad_v_x = random() * 2 - 1;
		ad_v_y = random() * 2 - 1;
		ad_v_z = random() * 2 - 1;
	}
	while(vlen(ad_v) > 1);
	return ad_v;
};

/*----------------------------------------------------------------------
Radians <--> Degrees

Simple functions that convert radians to
degrees.
----------------------------------------------------------------------*/
float (float ad_num) ad_rad2deg = { return ad_num*ad_OneEightyOverPi; };
float (float ad_num) ad_deg2rad = { return ad_num*ad_PiOverOneEighty; };

/*----------------------------------------------------------------------
 QC Rotation around world co-ord 0,0,0 (2 axis only)
  - Expecting one axis (XYZ) to always be constant
----------------------------------------------------------------------*/
vector(vector ad_targvec, float ad_targang) ad_mathlib_vectorotateX =
{
	local vector ad_retvec;
	ad_retvec_x = ad_targvec_x;
	ad_retvec_y = (ad_targvec_y * ad_mathlib_cos(ad_targang)) - (ad_targvec_z * ad_mathlib_sin(ad_targang));
	ad_retvec_z = (ad_targvec_y * ad_mathlib_sin(ad_targang)) + (ad_targvec_z * ad_mathlib_cos(ad_targang));
	return(ad_retvec);
};
//----------------------------------------------------------------------
vector(vector ad_targvec, float ad_targang) ad_mathlib_vectorotateY =
{
	local vector ad_retvec;
	ad_retvec_x = (ad_targvec_x * ad_mathlib_cos(ad_targang)) + (ad_targvec_z * ad_mathlib_sin(ad_targang));
	ad_retvec_y = ad_targvec_y;
	ad_retvec_z = (-ad_targvec_x * ad_mathlib_sin(ad_targang)) + (ad_targvec_z * ad_mathlib_cos(ad_targang));
	return(ad_retvec);
};
//----------------------------------------------------------------------
vector(vector ad_targvec, float ad_targang) ad_mathlib_vectorotateZ =
{
	local vector ad_retvec;
	ad_retvec_x = (ad_targvec_x * ad_mathlib_cos(ad_targang)) - (ad_targvec_y * ad_mathlib_sin(ad_targang));
	ad_retvec_y = (ad_targvec_x * ad_mathlib_sin(ad_targang)) + (ad_targvec_y * ad_mathlib_cos(ad_targang));
	ad_retvec_z = ad_targvec_z;
	return(ad_retvec);
};

/*----------------------------------------------------------------------
TAN
Changes v_forward, v_right, v_up
----------------------------------------------------------------------*/
float(float ad_theta) ad_mathlib_tan =
{
  local vector ad_ang; //temporary used to calculate trig values
  ad_ang = '0 0 0';
  ad_ang_y = ad_theta; //assign theta to the yaw to simplify reasoning
  makevectors(ad_ang);
  return v_forward_y / v_forward_x;
};

/*----------------------------------------------------------------------
Inverse TAN
----------------------------------------------------------------------*/
float(float y, float x) ad_mathlib_atan2 =
{
  local vector ad_ang; //temporary used to calculate trig values
  ad_ang = '0 0 0';
  ad_ang_x = x;
  ad_ang_y = y;
  //return mathlib_vectoyaw(ang);
  return vectoyaw(ad_ang);
};

/*----------------------------------------------------------------------
QC version of engine code vectoyaw function
 - Used to prevent returning integers (errors) on some engines
 - Broken and abandoned, don't use!!! (keep for reference)
 - Found a better solution with angle smoothing code instead
----------------------------------------------------------------------
float(vector targvec) mathlib_vectoyaw =
{
	local float vecyaw;

	// Conditions below taken from atan2 wiki page
	if (targvec_x == 0 && targvec_y > 0)
		vecyaw = pi / 2;
	
	else if (targvec_x == 0 && targvec_y < 0)
		vecyaw = - (pi / 2);
	
	else if (targvec_x < 0 && targvec_y >= 0)
		vecyaw = mathlib_tan(targvec_y / targvec_x) + pi;
	
	else if (targvec_x < 0 && targvec_y < 0)
		vecyaw = mathlib_tan(targvec_y / targvec_x) - pi;
	
	else if (targvec_x > 0)
		vecyaw = mathlib_tan(targvec_y / targvec_x);
		
	// default x == 0 && y == 0
	else vecyaw = 0;
	
	if (vecyaw < 0) vecyaw = vecyaw + 360;	// yaw += 360;
	return vecyaw;
}; */

/*----------------------------------------------------------------------
QC version of engine code vectoangles function
 - Used to prevent returning integers (errors) on some engines
 - Found a better solution with angle smoothing code instead
----------------------------------------------------------------------*/
vector(vector ad_targvec) ad_mathlib_vectoangles =
{
	// value1[0] = targvec_x, value1[1] = targvec_y, value1[2] = targvec_z
	// X=Pitch, Y=Yaw, Z=Forward;
	local vector ad_ang;
	ad_ang = '0 0 0';
	
	// if (value1[1] == 0 && value1[0] == 0)
	if (ad_targvec_y == 0 && ad_targvec_x == 0) {
		ad_ang_y = 0;	// yaw=0
		// if (value1[2] > 0) pitch = 90;
		if (ad_targvec_z > 0) ad_ang_x = 90;	// pitch=90
		else ad_ang_x = 270;				// pitch=270
	}
	else {
		// yaw = (int) (atan2(value1[1], value1[0]) * 180 / M_PI);
		// mathlib atan2 returns degree's not radian's (don't need *180/PI)
		ad_ang_y = ad_mathlib_atan2(ad_targvec_y, ad_targvec_x);
		if (ad_ang_y < 0) ad_ang_y = ad_ang_y + 360;	// yaw += 360;
		
		// forward = sqrt (value1[0]*value1[0] + value1[1]*value1[1]);
		ad_ang_z = ad_mathlib_sqrt(ad_targvec_x * ad_targvec_x + ad_targvec_y * ad_targvec_y);

		// pitch = (int) (atan2(value1[2], forward) * 180 / M_PI);
		// mathlib atan2 returns degree's not radian's (don't need *180/PI)
		ad_ang_x = ad_mathlib_atan2(ad_targvec_z, ad_ang_z);
		if (ad_ang_x < 0) ad_ang_x = ad_ang_x + 360;	// pitch += 360;
	}
	
	// forward (Z) not required, zero instead
	ad_ang_z = 0;
	return ad_ang;
};

/*----------------------------------------------------------------------
QC version of engine code makevectors function
----------------------------------------------------------------------*/
void(vector ad_targang) ad_mathlib_makevectors =
{
	local float ad_sr, ad_sp, ad_sy, ad_cr, ad_cp, ad_cy;
	
	// targangs X=Pitch, Y=Yaw, Z=Roll
    ad_sp = ad_mathlib_sin(ad_targang_x);
    ad_cp = ad_mathlib_cos(ad_targang_x);
    ad_sy = ad_mathlib_sin(ad_targang_y);
    ad_cy = ad_mathlib_cos(ad_targang_y);
    ad_sr = ad_mathlib_sin(ad_targang_z);
    ad_cr = ad_mathlib_cos(ad_targang_z);
	
    v_forward_x = ad_cp*ad_cy;
    v_forward_y = ad_cp*ad_sy;
    v_forward_z = -ad_sp;
    v_right_x = (-1*ad_sr*ad_sp*ad_cy+-1*ad_cr*-ad_sy);
    v_right_y = (-1*ad_sr*ad_sp*ad_sy+-1*ad_cr*ad_cy);
    v_right_z = -1*ad_sr*ad_cp;
    v_up_x = (ad_cr*ad_sp*ad_cy+-ad_sr*-ad_sy);
    v_up_y = (ad_cr*ad_sp*ad_sy+-ad_sr*ad_cy);
    v_up_z = ad_cr*ad_cp;
};
	
/* *********************************************************
!!!FTEQCC or FrikQCC only code follows !!!
This code allows the engine to accelerate math functions
If not needed, you can simply delete the rest of the file
and call the mathlib functions above directly.
It checks for the extensions DP_QC_MINMAXBOUND,
DP_QC_RANDOMVEC, DP_QC_SINCOSSQRTPOW, EXT_BITSHIFT
********************************************************* */
/*
var float (float num) sqrt;
var float (float num) sin;
var float (float num) cos;
var float (float num, float exp) pow;
var float (float number, float exp) bitshift;
var float (float a, float b) min;
var float (float a, float b, float c) min3;
var float (float a, float b, float c, float d) min4;
var float (float a, float b, float c, float d, float e) min5;
var float (float a, float b, float c, float d, float e, float f) min6;
var float (float a, float b, float c, float d, float e, float f, float g) min7;
var float (float a, float b, float c, float d, float e, float f, float g, float h) min8;
var float (float a, float b) max;
var float (float a, float b, float c) max3;
var float (float a, float b, float c, float d) max4;
var float (float a, float b, float c, float d, float e) max5;
var float (float a, float b, float c, float d, float e, float f) max6;
