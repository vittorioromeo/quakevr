//============================================================================
// JUMP FUNCTION (range)
//============================================================================
void()	ad_pinch_jumptouch =
{
	if (self.health <= 0) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	//Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	// Do not damage other scorpions with jump attacks
	// Prevents packs from killing themselves
	if (self.ad_classgroup != other.ad_classgroup && other.takedamage) {
		sound (self, ad_CHAN_VOICE, "scorpion/jumphit.wav", 1, ad_ATTN_NORM);
		ad_BleedDeBuff(other);
		ad_spawn_touchblood (self, self.enemy, 100);
	}

	// Is the scorpion floating in the air?
	if (!checkbottom(self)) {
		// Is the scorpion standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_pinch_leap1	=[	$attackC1, ad_pinch_leap2	] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPSCORPTIME;
	if (self.lefty < 1) sound (self, ad_CHAN_VOICE, "scorpion/jumpattack1.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, "scorpion/jumpattack2.wav", 1, ad_ATTN_NORM);
	self.lefty = 1 - self.lefty;
};
void() ad_pinch_leap2	=[	$attackC3, ad_pinch_leap3	] {ad_ai_face(); };
void() ad_pinch_leap3	=[	$attackC5, ad_pinch_leap4	] {ad_ai_face();
	// This is a crazy idea, throw the scorpion like a grenade!
	// Using the same logic as the ogre grenade zware system
	self.ad_attack_speed = self.ad_jumpdist_x + (random()*self.ad_jumpdist_z);
	// Aiming at the players head (+24 z axis)
	self.pos2 = self.enemy.origin + '0 0 24';
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.pos2, self.ad_attack_speed);
	self.pos1 = vectoangles(self.pos2 - self.origin);
	self.pos1_x = -self.ad_attack_elev;
	makevectors (self.pos1);
	self.velocity = v_forward * self.ad_attack_speed;
	
	self.jump_flag = time + ad_MONAI_JUMPSCORPTIME;
	self.touch = ad_pinch_jumptouch;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

// Flying through the air waiting to touch something!
void() ad_pinch_leap4	=[	$attackC7, ad_pinch_leap5	] {ad_ai_face();};
void() ad_pinch_leap5	=[	$attackC8, ad_pinch_leap6 ] {ad_ai_face();};	
void() ad_pinch_leap6	=[	$attackC9, ad_pinch_leap8 ] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_pinch_leap3;
	}
	self.oldorigin = self.origin;
};

//----------------------------------------------------------------------
void() ad_pinch_leap8	=[	$attackC10, ad_pinch_leap9 ] {ad_ai_charge(4);};
void() ad_pinch_leap9	=[	$attackC11, ad_pinch_leap10] {ad_ai_charge(4);};
void() ad_pinch_leap10	=[	$attackC12, ad_pinch_leap11] {ad_ai_charge(4);};
