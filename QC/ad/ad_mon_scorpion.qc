//======================================================================
// BITE Melee Range
//======================================================================
void(float ad_side) ad_pinch_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);							// Get closer for extra bite
	ad_ai_damagebreakable(10);					// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEESCORPION,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	if (self.ad_meleeattack < 1) sound(self, ad_CHAN_WEAPON, "scorpion/clawattack1.wav", ad_TRUE, ad_TRUE);
	else sound(self, ad_CHAN_WEAPON, "scorpion/clawattack2.wav", ad_TRUE, ad_TRUE);
	self.ad_meleeattack = 1 - self.ad_meleeattack;

	// Scorpion claw = 1-12 Damage
	ad_ldmg = (random() + random() + random()) * 4;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	ad_SpawnMeatSpray (self, self.enemy, ad_side);
};

