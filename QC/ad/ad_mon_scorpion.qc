//----------------------------------------------------------------------------
void() ad_pinch_die = 
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		ad_pinch_die1();
	}
};

//======================================================================
/*ad:QUAKED monster_scorpion (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_setup_scorpion;
void() ad_monster_scorpion =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_scorpion.mdl";
	self.ad_headmdl = "progs/h_scorpion.mdl";		// Front Jaws
	self.ad_gib1mdl = "progs/gib_scorpleg.mdl";	// Single Leg
	self.ad_gib2mdl = "progs/gib_scorptail.mdl";	// Tail + Sting
	self.ad_gib3mdl = "progs/gib_scorpclaw.mdl";	// Claw

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);		
	precache_model (self.ad_gib3mdl);	

	// Random chance of 2 claws, or 2 legs
	if (random() < 0.5) self.ad_gib2mdl = self.ad_gib3mdl;
	else if (random() < 0.5) self.ad_gib2mdl = self.ad_gib1mdl;
	
	// IDLE/COMBAT and SIGHT sounds
	if (self.spawnflags & ad_MON_SCORPION_STINGER) {
		self.ad_idle_sound = "scorpion/idle1.wav";
		self.ad_idle_sound2 = "scorpion/idle2.wav";
		self.ad_sight_sound = "scorpion/sight1.wav";

		precache_sound("scorpion/jumpattack1.wav");
		precache_sound("scorpion/jumpattack2.wav");
		precache_sound("scorpion/jumphit.wav");
		if (self.health < 1) self.health = 120;
		self.ad_gibhealth = -25;
		self.ad_idlemoreoften = ad_TRUE;		// More creepy idle sounds
		self.ad_exactskin = 3;				// Black skin
	}
	else {
		precache_model (ad_MODEL_PROJ_SCORP);		// Large green spike
		self.ad_idle_sound = "scorpion/warning1.wav";
		self.ad_idle_sound2 = "scorpion/warning2.wav";
		self.ad_sight_sound = "scorpion/hiss.wav";

		precache_sound("scorpion/tailfire1.wav");
		precache_sound("scorpion/tailfire2.wav");
		precache_sound("scorpion/tailattack1.wav");
		precache_sound("scorpion/tailattack2.wav");
		if (self.health < 1) self.health = 80;
		self.ad_gibhealth = -20;
		if (!self.ad_exactskin) self.ad_exactskin = rint((random()*3)-0.5);
	}
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_sight_sound);

	// death/pain/attack sounds
	self.ad_pain_sound = "scorpion/pain1.wav";
	self.ad_pain_sound2 = "scorpion/pain2.wav";
	precache_sound(self.ad_pain_sound);
	precache_sound(self.ad_pain_sound2);
	self.ad_death_sound = "scorpion/death1.wav";
	precache_sound(self.ad_death_sound);

	precache_sound("scorpion/clawattack1.wav");
	precache_sound("scorpion/clawattack2.wav");

	// Cache scorpion is a special class used for precache only
	if (self.ad_classtype != ad_CT_CACHESCORPION) ad_setup_scorpion();
};

//----------------------------------------------------------------------------
void() ad_monster_wraithminion2 = { 
	self.ad_classtype = ad_CT_CACHESCORPION; 
	ad_monster_scorpion();
};
	
//----------------------------------------------------------------------------
void() ad_setup_scorpion =
{
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 10;				// Always flinch
	self.yaw_speed = 30;				// Very fast turning (def=20)
	self.ad_steptype = ad_FS_TYPELIGHT;
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '32 0 10';		// Claw attack offset
	self.ad_attack_offset = '32 8 14';		// Nail attack offset
	self.ad_poisonous = ad_FALSE;				// Scorpions have bleeding debuff
	self.ad_deathstring = " was stung by a Scorpion\n";
	
	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '575 0 50';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPSCORPNEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPSCORPFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_ScorpionCheckAttack;
	self.ad_th_pain = ad_pinch_pain;
	self.ad_th_die = ad_pinch_die;

	// Special spawning minion need to start spinning
	if (self.ad_classtype == ad_CT_MINIONSCORPION) {
		self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_pinch_grow;
		self.ad_th_melee = self.ad_th_missile = ad_SUB_Null;
	}
	else {
		self.ad_th_stand = ad_pinch_idle1;
		self.ad_th_walk = ad_pinch_walk1;
		self.ad_th_run = ad_pinch_run1;
		self.ad_th_melee = ad_pinch_claw1;
		// Black stinger jumps and regulars range attack
		if (self.spawnflags & ad_MON_SCORPION_STINGER) {
			self.ad_th_jump = ad_pinch_leap1;
			self.ad_th_jumpexit = ad_pinch_leap8;
		}
		else self.ad_th_missile = ad_pinch_tail1;
		
	}
	
	self.ad_gib1skin = self.ad_gib2skin = self.ad_gib3skin = self.ad_exactskin;
	if(!self.ad_classtype) self.ad_classtype = ad_CT_MONSCORPION;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn scorpion (requires monster_scorpionspawn entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_scorpion =
{
	local entity ad_minion;
	
	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	ad_update_minioncount(self.owner, 1);		// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_scorpion";	// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self.owner;				// Spawner Parent Link
	self.owner = ad_minion;					// Stop gibs interacting with minion
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_gibondeath = 1;					// Always gib on death
	ad_minion.ad_classtype = ad_CT_MINIONSCORPION;	// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	ad_minion.spawnflags = 0;
	
	ad_minion.mdl = "progs/mon_scorpion.mdl";
	ad_minion.ad_headmdl = "progs/h_scorpion.mdl";	// Front Jaws
	ad_minion.ad_gib1mdl = "progs/gib_scorpleg.mdl";	// Single Leg
	ad_minion.ad_gib2mdl = "progs/gib_scorptail.mdl";	// Tail + Sting
	ad_minion.ad_gib3mdl = "progs/gib_scorpclaw.mdl";	// Claw
	ad_minion.ad_exactskin = rint((random()*3)-0.5);
	ad_minion.ad_gibhealth = -20;
	ad_minion.health = 80;

	ad_minion.ad_idle_sound = "scorpion/warning1.wav";
	ad_minion.ad_idle_sound2 = "scorpion/warning2.wav";
	ad_minion.ad_sight_sound = "scorpion/hiss.wav";

	ad_minion.ad_pain_sound = "spider/pain1.wav";
	ad_minion.ad_pain_sound2 = "spider/pain2.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_scorpion;
};