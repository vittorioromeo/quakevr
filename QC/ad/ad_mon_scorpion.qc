void()	ad_pinch_tail1	=[	$attackA2,		ad_pinch_tail2	] {ad_ai_face();
	if (self.lefty < 1) sound (self, ad_CHAN_VOICE, "scorpion/tailattack1.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, "scorpion/tailattack2.wav", 1, ad_ATTN_NORM);
	self.lefty = 1 - self.lefty;
};
