//============================================================================
// TAIL FUNCTION (range)
//============================================================================
float ad_TAILOFFSET = 8;

//----------------------------------------------------------------------
void() ad_pinch_tailsound =
{
	if (self.ad_meleeattack < 1) sound(self, ad_CHAN_WEAPON, "scorpion/tailfire1.wav", ad_TRUE, ad_TRUE);
	else sound(self, ad_CHAN_WEAPON, "scorpion/tailfire2.wav", ad_TRUE, ad_TRUE);
	self.ad_meleeattack = 1 - self.ad_meleeattack;
};

//----------------------------------------------------------------------
void(vector ad_tailofs) ad_pinch_tailspike =
{
	local vector ad_org, ad_dir;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	ad_ai_face();
	ad_pinch_tailsound();
	self.ad_attack_speed = ad_SPEED_SCORPTAIL + (ad_skill * ad_SPEED_SCORPSKILL);
	makevectors(self.angles);

	// Generate spike at final animation position
	ad_org = self.origin + ad_attack_vector(ad_tailofs);
	ad_dir = self.enemy.origin + v_right*(ad_TAILOFFSET*3);
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_SCORP, self.ad_attack_speed+random()*25);

	ad_dir = self.enemy.origin;
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_SCORP, self.ad_attack_speed+random()*25);

	ad_dir = self.enemy.origin - v_right*(ad_TAILOFFSET*3);
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_SCORP, self.ad_attack_speed+random()*25);
}

