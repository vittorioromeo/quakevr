	if (ad_ai_checkmelee(ad_MONAI_MELEESCORPION,ad_FALSE) && self.enemy.health > 0) 
		self.think = ad_pinch_claw2;
};
void() ad_pinch_leap14	=[	$attackC20, ad_pinch_run1 ] {};

//======================================================================
// MINION - Grow and spin up from nothing
//======================================================================
void() ad_pinch_growangle = {self.angles_y = self.angles_y + self.lefty;};
void() ad_pinch_grow1 = [ $grow1, ad_pinch_grow2 ] {};
void() ad_pinch_grow2 = [ $grow2, ad_pinch_grow3 ] {ad_pinch_growangle();};
void() ad_pinch_grow3 = [ $grow3, ad_pinch_grow4 ] {ad_pinch_growangle();};
void() ad_pinch_grow4 = [ $grow4, ad_pinch_grow5 ] {ad_pinch_growangle();};
void() ad_pinch_grow5 = [ $grow5, ad_pinch_grow6 ] {ad_pinch_growangle();};
void() ad_pinch_grow6 = [ $grow6, ad_pinch_grow7 ] {ad_pinch_growangle();};
void() ad_pinch_grow7 = [ $grow7, ad_pinch_grow8 ] {ad_pinch_growangle();};
void() ad_pinch_grow8 = [ $grow8, ad_pinch_grow9 ] {ad_pinch_growangle();};
void() ad_pinch_grow9 = [ $grow9, ad_pinch_grow10] {ad_pinch_growangle();};
void() ad_pinch_grow10= [ $grow10, ad_pinch_run1 ] {
	// Is the scorpion stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		// Finally spin back to original position
		self.angles_y = self.angles_y + self.lefty;
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);

		// Restore all think state functions
		self.ad_th_stand = ad_pinch_idle1;
		self.ad_th_walk = ad_pinch_walk1;
		self.ad_th_run = ad_pinch_run1;
		self.ad_th_melee = ad_pinch_claw1;
		self.ad_th_missile = ad_pinch_tail1;
	}
};

//----------------------------------------------------------------------------
void() ad_pinch_grow =
{
	// Only call wakeup function once
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run  = ad_SUB_Null;
	if (random() < 0.5) self.lefty = 36;
	else self.lefty = -36;
	ad_monster_sightsound();
	ad_pinch_grow1();
};

