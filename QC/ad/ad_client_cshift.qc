// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 v_cshift - Quake engine screen flash or colour tint
======================================================================*/

.float		ad_cshift_func;		// 1=Screen flash, 3=artifacts, 5=debuff
.float		ad_cshift_upd;			// Screen updates (v_cshift) are active
.float		ad_cshift_time;		// Timer (0.1s tick) for screen updates
.vector		ad_cshift_col;			// RGB / XYZ values for screen colour
.float		ad_cshift_den;			// Screen colour density
.float		ad_cshift_step;		// Quantity to reduce density by per tick

//----------------------------------------------------------------------
void(entity ad_targ) ad_ResetCShift =
{
	stuffcmd(ad_targ, "v_cshift 0 0 0 0\n");
};
