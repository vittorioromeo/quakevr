// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 CLIENT EVIL (skill 4) MODE FUNCTIONS
======================================================================*/

void() ad_Client_SetEvilFlag = { cvar_set("scratch4", "1"); };
void() ad_Client_ClearEvilFlag = { cvar_set("scratch4", "0"); };
void() ad_Client_SetEvilSkill = { cvar_set("skill", ftos(ad_SKILL_EVIL)); ad_skill = ad_SKILL_EVIL; };

//----------------------------------------------------------------------
// The engine constantly changes skill to 0-3 only
// Read console variable and set evil skill again
//----------------------------------------------------------------------
void() ad_Client_SyncEvilmode = 
{
	// Console variable set?
	if (cvar("scratch4") > 0) {
		dprint("\b[SKILL4]\b Re-sync skill to scratch4 cvar\n");	
		ad_Client_SetEvilSkill();
		// Force a re-sync in PlayerPreThink
		ad_oskill = -1;
	}
};

//----------------------------------------------------------------------
// This is designed to catch quickload/load games
// Detect changes with oskill that are written to savefiles
//----------------------------------------------------------------------
void() ad_Client_SyncPrevEvilmode =
{
	// Quickload skill check?
	if (ad_oskill >= ad_SKILL_EVIL) {
		dprint("\b[SKILL4]\b Detecting Quickload functions\n");
		// Set evil and skill cvar's
		ad_Client_SetEvilFlag();
		ad_Client_SetEvilSkill();
		// Force a re-sync in PlayerPreThink
		ad_oskill = -1;
	}
};

//----------------------------------------------------------------------
// Basic check for EVIL mode (cvar + skill)
//----------------------------------------------------------------------
float() ad_Client_QueryEvilmode =
{
	if (cvar("scratch4") > 0 || ad_skill >= ad_SKILL_EVIL) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
float() ad_Client_QueryEvilskill =
{
	if (ad_skill >= ad_SKILL_EVIL) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// Check HP for max limit and minimum (50%) balance for new games
//----------------------------------------------------------------------
void(entity ad_targ, float ad_hpminimum) ad_Client_CheckMaxHP =
{
	// Make sure current HP is not over limit
	if (ad_targ.health > ad_targ.max_health) ad_targ.health = ad_targ.max_health;
	if (ad_hpminimum && ad_targ.health < (ad_targ.max_health/2)) 
		ad_targ.health = ad_targ.max_health/2;
};

//----------------------------------------------------------------------
// Evil mode should always have a shadow axe (default)
//----------------------------------------------------------------------
void(entity ad_targ) ad_Client_CheckEvilInv = 
{
	// Evil skill active?
	if (ad_Client_QueryEvilmode()) {
		// Make sure player always starts with shadow axe!?!
		if (!(ad_targ.ad_moditems & ad_IT_UPGRADE_AXE)) {
			ad_targ.items = ad_targ.items | ad_IT_AXE;
			// Add shadow axe to extra inventory
			ad_targ.ad_moditems = ad_targ.ad_moditems | ad_IT_UPGRADE_AXE;
			// Cannot have grapple hook at the same time
			ad_targ.ad_moditems = ad_targ.ad_moditems - (ad_targ.ad_moditems & ad_IT_UPGRADE_GHOOK);
			// Switch weapons and focus on Shadow Axe
			ad_targ.weapon = ad_IT_AXE;
			ad_W_SetCurrentAmmo(ad_targ);
		}
	}
};

//----------------------------------------------------------------------
// Setup HP/Mega limits for Evil skill and add Shadow Axe!
//----------------------------------------------------------------------
void() ad_Client_SetupEvilmode =
{
	dprint("\b[SKILL4]\b EvilMode Enabled!\n");
	// Set Evil skill flag
	ad_Client_SetEvilFlag();
	self.max_health = ad_HEAL_EVILMAX;
	self.ad_mega_health = ad_HEAL_PLAYMAX;
	// Current HP over limit?
	ad_Client_CheckMaxHP(self, ad_FALSE);
	ad_Client_CheckEvilInv(self);
};

//----------------------------------------------------------------------
// Reset HP/Mega back to skill 0-3 and check worldspawn for overrides
// prevskill is for players who switch skills to gain ShadowAxe!
//----------------------------------------------------------------------
void(float ad_prevskill) ad_Client_ResetEvilmode =
{
	dprint("\b[SKILL4]\b EvilMode Disabled!\n");
	// Clear Evil skill flag
	ad_Client_ClearEvilFlag();
	// Check worldspawn for any previous default?
	if (world.ad_player_health_z <= 0) {
		self.max_health = ad_HEAL_PLAYMAX;
		self.ad_mega_health = ad_HEAL_MEGAMAX;
	}
	else {
		// Are there any skill level restriction?
		// 1 = EASY, 2 = NORMAL, 4 = HARD, 8 = NIGHTMARE, 15 = ALL
		if ( (world.ad_player_health_z & ad_HP_EASY && ad_skill == ad_SKILL_EASY) ||
			 (world.ad_player_health_z & ad_HP_NORMAL && ad_skill == ad_SKILL_NORMAL) ||
			 (world.ad_player_health_z & ad_HP_HARD && ad_skill == ad_SKILL_HARD) ||
			 (world.ad_player_health_z & ad_HP_NIGHTMARE && ad_skill >= ad_SKILL_NIGHTMARE) ) {
			// Double check max is not negative or zero
			if (world.ad_player_health_x <= 0) self.max_health = ad_HEAL_PLAYMAX;
			else self.max_health = world.ad_player_health_x;
			if (world.ad_player_health_y <= 0) self.ad_mega_health = ad_HEAL_MEGAMAX;
			else self.ad_mega_health = world.ad_player_health_y;
		}
	}
	// Current HP over limit?
	ad_Client_CheckMaxHP(self, ad_FALSE);
	// Switching skill levels has consequences
	if (ad_prevskill >= ad_SKILL_EVIL) { 
		// Shadow axe is removed and quake axe restored
		if (self.ad_moditems & ad_IT_UPGRADE_AXE) {
			sprint(self, "Shadow Axe removed!\n");
			sprint(self, "You feel your power fading!\n");
			stuffcmd(self, "bf\n");
			self.ad_moditems = self.ad_moditems - (self.ad_moditems & ad_IT_UPGRADE_AXE);
			self.items = self.items | ad_IT_AXE;
			self.weapon = ad_IT_AXE;
			ad_W_SetCurrentAmmo(self);
		}
	}
};

//----------------------------------------------------------------------
// Show a random EVIL console/topleft message on start of map
//----------------------------------------------------------------------
void() ad_Client_DispEvilmsg =
{
	local float ad_rndmsg;
	// Just some funny EVIL messages
	ad_rndmsg = floor(random()*10);
	// Draw a line on the console and pick and a random message
	sprint(self,"\<\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\-\>\n");
	//                                 1234567890123456789012345678901234567890
		 if (ad_rndmsg < 1) sprint(self, "  -- Could you be \bEVIL\b incarnate? --");
	else if (ad_rndmsg < 2) sprint(self, " -- Hear \bEVIL\b, speak \bEVIL\b, do \bEVIL\b! --");
	else if (ad_rndmsg < 3) sprint(self, " - What is your bidding \bEVIL\b Acolyte? -");
	else if (ad_rndmsg < 4) sprint(self, "  -- Embrace the \bEVIL\b within you! --");
	else if (ad_rndmsg < 5) sprint(self, " -- Cut them down with \bEVIL\b intent! --");
	else if (ad_rndmsg < 6) sprint(self, " -- \bChaos\b and \bEVIL\b are just divine! --");
	else if (ad_rndmsg < 7) sprint(self, "-- Have you become an \bEVIL\b Believer? --");
	else if (ad_rndmsg < 8) sprint(self, " -- \bEVIL\b deeds create great needs! --");
	else if (ad_rndmsg < 9) sprint(self, " - After eons of time \bEVIL\b is alive! -");
					else sprint(self, "- \bEVIL\b hands find righteous purpose! -");
	sprint(self,"\n\n");
	stuffcmd(self, "bf\n");
};
