// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_sentinel.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
SENTINEL (Originally from Quoth - Kell/Necros/Preach)
  * QC was created for AD mappers to play with in their own projects
  * Original Quoth model/sounds not included with main MOD
 
  Interesting QC traits
  * All stand/walk/run go through single function, easier setup
  * Has no front section to model, wakeup event is 360 FOV
  * Does not move when attacking so can maintain original height
  * Will move very fast when out of sight of enemy
  * No head model or body on death, just a pile of gibs
  
  QUOTH assets required to get this monster working in AD
    (model's in 'progs' and wav's in 'sound' sub directories)
  * sentinel.mdl -> mon_sentinel.mdl (rename file)
  * sentinel/widle1.wav, sentinel/widle2.wav, sentinel/wsight.wav
  * sentinel/laser.wav, sentinel/nail.wav, sentinel/wpain.wav

 ==============================================================================*/
// Writhe (move tentacles) animation
$frame idle1 idle2 idle3 idle4 idle5 idle6 idle7 idle8 idle9 idle10

// Pain (move tentacles) animation
$frame pain1 pain2 pain3 pain4 pain5 pain6

// Export frames (ignored)
$frame base1

float ad_SENT_STAND = 0;		// Default state
float ad_SENT_WALK = 1;		// Patrolling
float ad_SENT_RUN = 2;			// Attacking - Sentry mode

//======================================================================
// Update Sentinel every frame
// Its a great shame the quoth model has no idle animations
// - could have been body attachments or different tentacle movements
//======================================================================
void() ad_sent_update = 
{
	// If Sentinel is dead, no more updates
	if (self.health < 1) return;

	// Time for an idle sound?
	if (self.ad_idletimer < time) ad_monster_idle_sound();

	// Update animation frame
	self.frame = $idle1 + self.ad_walkframe;

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 9) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_sent_update;
	
	// Check sentinel states
	if (self.ad_attack_timer == ad_SENT_STAND) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_FLY;

		// Change the movement type so that can easily move up/down
		// using velocity, forced origin movement is really jerky!
		if (self.velocity_x == 0 && self.velocity_y == 0) {
			if (self.ad_attack_finished < time) {
				self.ad_attack_finished = time + 2;
				if (self.lip < 1) self.lip = 1;
				else self.lip = -1;
				self.velocity_z = 2 * self.lip;
			}
		}
	
		ad_ai_stand();
	}
	else if (self.ad_attack_timer == ad_SENT_WALK) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		ad_ai_walk(8);
	}
	else if (self.ad_attack_timer == ad_SENT_RUN) {
		self.solid = ad_SOLID_SLIDEBOX;
		self.movetype = ad_MOVETYPE_STEP;
		// If can see enemy, don't move, just fire
		if (ad_visible(self.enemy)) {
			self.ad_movespeed = -1;
			ad_ai_run(0);
		}
		// Cannot see enemy, track them down
		else {
			self.ad_movespeed = 1;
			ad_ai_run(8);
		}
	}
};

//======================================================================
// All stand, walk and run functions are condensed down to one entry
// Might as well be one loop as there is only one animation set
//
void() ad_sent_stand = { self.ad_attack_timer = ad_SENT_STAND; ad_sent_update(); };
void() ad_sent_walk = { self.ad_attack_timer = ad_SENT_WALK; ad_sent_update(); };
void() ad_sent_run = { self.ad_attack_timer = ad_SENT_RUN; ad_sent_update(); };

//===========================================================================
// RANGE ATTACK - Fires spikes or laser bolts
//===========================================================================
void() ad_sent_attack =
{
	local vector ad_org, ad_dir, ad_vec;

	// Keep cycling the pain animation
	self.think = ad_sent_run;
	self.nextthink = time + 0.1;	

	if (self.enemy && self.health > 0) {
		
		// Always make sure there is no monster or obstacle in the way
		// Cannot use enemy entity direct, enemytarget will be active
		if ( !ad_visxray(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 12', ad_FALSE) ) return;

		self.effects = self.effects | ad_EF_MUZZLEFLASH;

		makevectors (self.angles);
		ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

		// Aim high to catch jumping players
		ad_dir = ad_SUB_orgEnemyTarget() + '0 0 12';
		ad_vec = normalize(ad_dir - ad_org);
		// Laser/nail speed : 575=easy, 650=normal, 725=hard, nm=800
		self.ad_attack_speed = ad_SPEED_SENTPROJ + (ad_skill * ad_SPEED_SENTPROJSKILL);

		// Switch projectile type
		if (self.spawnflags & ad_MON_SENTINEL_NAIL) {
			if (random() < 0.2) sound (self, ad_CHAN_WEAPON, "sentinel/nail.wav", 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_WEAPON, "weapons/rocket1i.wav", 1, ad_ATTN_NORM);
			ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_MONNG, self.ad_attack_speed);
		}
		else {
			if (random() < 0.2) sound (self, ad_CHAN_WEAPON, "sentinel/laser.wav", 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);
			ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_LASER, self.ad_attack_speed);
		}
	}
};

//============================================================================
// ROBOT PAIN!?!
//============================================================================
void() ad_sent_inpain =
{
	// Update animation frame
	self.frame = $pain1 + self.ad_inpain;
	// Move backwards away from damage
	ad_ai_backface(5-self.ad_inpain);

	// Keep cycling the pain animation
	self.think = ad_sent_inpain;
	self.nextthink = time + 0.1;
	
	// Start of pain cycle
	if (self.ad_inpain ==  0) {
		// Spawn a pile of sparks and dust falling down
		ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	}
	// Finished, back to combat
	else if (self.ad_inpain >= 5) {
		self.think = self.ad_th_run;
	}
	
	// Next pain animation
	self.ad_inpain = self.ad_inpain + 1;
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_sent_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Stop any ai_run velocity and reset movetype
	self.velocity = '0 0 0';
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	self.ad_inpain = 0;
	
	ad_sent_inpain();
};

//============================================================================
void() ad_sent_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Final fireworks!
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound);

	// no more sentinel
	ad_entity_hide (self);
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// Regular blood like gibs
	ad_ThrowGib(4, 2 + rint(random()*4));
	ad_ThrowGib(5, 1);
	// Metal and custom body parts
	self.ad_gibtype = ad_GIBTYPE_METAL;
	ad_ThrowGib(11, 2 + rint(random()*2));
	ad_ThrowGib(12, 2 + rint(random()*2));	
};

/*======================================================================
QUAKED monster_sentinel (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_monster_sentinel =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_sentinel.mdl";		// AD naming
	self.ad_gib1mdl = "progs/gib_metal1.mdl";		// Breakable metal
	self.ad_gib2mdl = "progs/gib_metal3.mdl";		// Breakable metal

	precache_model (self.mdl);
	precache_model (self.ad_gib1mdl);				// Generic metal1_2
	precache_model (self.ad_gib2mdl);				// Generic metal1_2
	
	self.ad_idle_sound = "sentinel/widle1.wav";
	self.ad_idle_sound2 = "sentinel/widle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	// Default attack - lasers!
	precache_model (ad_MODEL_PROJ_LASER);			// Copy of enforcer laser
	precache_sound("sentinel/laser.wav");		// Unique laser fire
	precache_sound (ad_SOUND_LASER_FIRE);
	precache_sound (ad_SOUND_LASER_HIT);

	// Alternative attack - red hot nails!?!
	if (self.spawnflags & ad_MON_SENTINEL_NAIL) {
		self.ad_exactskin = 1;						// Nail version
		precache_model (ad_MODEL_PROJ_NGRED);		// Copy of freddie nails
		precache_sound("weapons/rocket1i.wav");
		precache_sound("sentinel/nail.wav");	// Unique nail fire
	}

	self.ad_pain_sound = "sentinel/wpain.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "jim/explode_major.wav";
	precache_sound (self.ad_death_sound);
	
	self.ad_sight_sound = "sentinel/wsight.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = 75;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 30;				// Sometimes flinch
	self.ad_steptype = ad_FS_FLYING;			// Silent feet
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	//self.idlemoreoften = TRUE;		// More creepy idle sounds
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous
	if (self.height == 0) self.height = 32; // Custom height
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	self.ad_walkframe = 0;					// Reset frame counter
	self.ad_attack_offset = '0 0 14';		// front/middle of body
	self.ad_sight_nofront = ad_TRUE;			// Has no front facing
	self.ad_deathstring = " was scorched by a Sentinel\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_SentinelCheckAttack;
	self.ad_th_stand = ad_sent_stand;
	self.ad_th_walk = ad_sent_walk;
	self.ad_th_run = ad_sent_run;
	self.ad_th_missile = ad_sent_attack;
	self.ad_th_pain = ad_sent_pain;
	self.ad_th_die = ad_sent_die;

	self.ad_classtype = ad_CT_MONSENTINEL;
	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVEFLY;
	
	ad_monster_start();
};
