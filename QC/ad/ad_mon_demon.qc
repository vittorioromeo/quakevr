//===========================================================================
// Melee damage function, called from animation frame set
// Standardized layout (matching ai_melee (ai.qc)
// Added each claw attack checks enemy distance (before no check)
// Added z depth check on attacks +/- 64 units
// Added claw miss sound (borrowed HK slash sound)
// Changed some explicit values to constant variables
//===========================================================================
void(float ad_side) ad_Demon_Claw =
{
	local float 	ad_ldmg;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	VR_MeleeArc_TurnBegin(); ad_ai_face (); VR_MeleeArc_TurnEnd(); // AD support: melee arc: the swing's turn held (fight.qc)						// Turn towards enemy target
	local vector ad_before = self.origin; // QVR: (VR_MeleeSpace_Step: fight.qc)
	ad_walkmove (self.ideal_yaw, 12);
	VR_MeleeSpace_Step(ad_before);	// Get extra close to enemy target
	ad_ai_damagebreakable(20);			// Damage any breakables

	// Moved the check for melee distance to here with takedamage
	// If the demon is outside of melee range then need miss swipe sound
	// same goes for enemies that cannot be damaged (world geo mostly)
	if (!(ad_ai_checkmelee(ad_MONAI_MELEEDEMON,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE)) || !self.enemy.takedamage) { // AD support: melee arc (fight.qc VR_MeleeArc_Hits)
		// Melee claw miss sound
		if (random() < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	}
	else {
		// Check for poisonous attribute (new poison version)
		if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

		// Melee claw hit sound
		sound (self, ad_CHAN_WEAPON, "demon/dhit2.wav", 1, ad_ATTN_NORM);
		ad_ldmg = 10 + 5*random();
		ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);		
		ad_SpawnMeatSpray (self, self.enemy, ad_side);
	}
};

