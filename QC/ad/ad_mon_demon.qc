//===========================================================================
// JumpTouch setup from animation frame set
// Changed so that it does not keep going in a loop
// * Demon will jump again if stuck (only 2 jumps)
//===========================================================================
void() ad_Demon_JumpTouch =
{
	local float ad_ldmg;

	if (self.health < 1) return;
	ad_ai_jumpbreakable(50);				// Damage any breakables
	self.touch = ad_SUB_Null;				// No more touching
	self.count = self.count + 1;		// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;		// Exit frame

	// Keep track of how many times touched the same object
	if (self.ad_jumptouch == other) self.jump_flag = time + ad_MONAI_JUMPTIMEOUT;
	self.ad_jumptouch = other;				// Keep track of touch target

	// Do not damage other demons with jump attacks
	if (self.ad_classtype != other.ad_classtype && other.takedamage) {
		if ( vlen(self.velocity) > 300 ) {
			ad_ldmg = 40 + 10*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			ad_SpawnMeatSpray(self, other, ad_FALSE);
			ad_SpawnMeatSpray(self, other, ad_FALSE);
			ad_SpawnMeatSpray(self, other, ad_FALSE);
			
			// Check for poisonous attribute (new poison version)
			if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);
		}
	}

	// Is the demon floating in the air?
	if (!checkbottom(self)) {
		// Is the demon standing on something?
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void()	ad_demon1_jump1	=[	$leap1,		ad_demon1_jump2	] {ad_ai_face();
	self.jump_flag = time;	// No jump time limits
	sound (self, ad_CHAN_VOICE, "demon/djump.wav", 1, ad_ATTN_NORM);
};
void()	ad_demon1_jump2	=[	$leap2,		ad_demon1_jump3	] {ad_ai_face();};
void()	ad_demon1_jump3	=[	$leap3,		ad_demon1_jump4	] {ad_ai_face();};
void()	ad_demon1_jump4	=[	$leap4,		ad_demon1_jump5	] {
	ad_ai_face();
	self.jump_flag = time;	// No jump time limits
	self.touch = ad_Demon_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

// Flying through the air waiting to touch something!
void()	ad_demon1_jump5	=[	$leap5,		ad_demon1_jump6	] {};
void()	ad_demon1_jump6	=[	$leap6,		ad_demon1_jump7	] {};
void()	ad_demon1_jump7	=[	$leap7,		ad_demon1_jump8	] {};
void()	ad_demon1_jump8	=[ 	$leap8,		ad_demon1_jump9	] {};
void()	ad_demon1_jump9	=[ 	$leap9,		ad_demon1_jump10	] {};
void()	ad_demon1_jump10	=[ 	$leap10,	ad_demon1_jump1	] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_demon1_jump3;
	}
	self.oldorigin = self.origin;
};
//----------------------------------------------------------------------
void()	ad_demon1_jump11	=[ 	$leap11,	ad_demon1_jump12] {ad_monster_footstep(ad_FALSE); };
void()	ad_demon1_jump12	=[ 	$leap12,	ad_demon1_run1	] {ad_ai_resetangles();};

/*======================================================================
  PAIN
========================================================================*/
void()	ad_demon1_pain1	=[	$pain1,		ad_demon1_pain2	] {};
void()	ad_demon1_pain2	=[	$pain2,		ad_demon1_pain3	] {};
void()	ad_demon1_pain3	=[	$pain3,		ad_demon1_pain4	] {};
void()	ad_demon1_pain4	=[	$pain4,		ad_demon1_pain5	] {};
void()	ad_demon1_pain5	=[	$pain5,		ad_demon1_pain6	] {};
void()	ad_demon1_pain6	=[	$pain6,		ad_demon1_run1	] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_demon1_pain =
{
	if (self.touch == ad_Demon_JumpTouch) return;

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_demon1_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.6;
			self.ad_axhitme = 0;
			ad_demon1_pain1 ();
		}
	}
};

//============================================================================
void()	ad_demon1_death1	=[	$death1, ad_demon1_death2 ] {};
void()	ad_demon1_death2	=[	$death2, ad_demon1_death3 ] {ad_monster_check_gib();};
void()	ad_demon1_death3	=[	$death3, ad_demon1_death4 ] {ad_monster_check_gib();
self.solid = ad_SOLID_NOT;};
void()	ad_demon1_death4	=[	$death4, ad_demon1_death5 ] {};
void()	ad_demon1_death5	=[	$death5, ad_demon1_death6 ] {};
void()	ad_demon1_death6	=[	$death6, ad_demon1_death7 ] {};
void()	ad_demon1_death7	=[	$death7, ad_demon1_death8 ] {};
void()	ad_demon1_death8	=[	$death8, ad_demon1_death9 ] {ad_monster_death_postcheck();};
void()	ad_demon1_death9	=[	$death9, ad_demon1_death9 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_demon1_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "demon/ddeath.wav", 1, ad_ATTN_NORM);
		ad_demon1_death1 ();
	}
};

/*======================================================================
QUAKED monster_demon1 (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_demon1 =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_demon.mdl";
	self.ad_headmdl = "progs/h_demon.mdl";
	self.ad_gib1mdl = "progs/gib_dmleg1.mdl";		// Left leg
	self.ad_gib2mdl = "progs/gib_dmleg2.mdl";		// Right leg
	self.ad_gib3mdl = "progs/gib_dmtail.mdl";		// Tail
	self.ad_gib4mdl = "progs/gib_dmclaw1.mdl";		// Claw 1
	self.ad_gib5mdl = "progs/gib_dmclaw2.mdl";		// Claw 2

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);		// Always precache extra models
	precache_model (self.ad_gib5mdl);		// regardless if picked or not
	
	// Randomly swap in demon claws instead of legs
	if (random() < 0.5) self.ad_gib1mdl = self.ad_gib4mdl;
	if (random() < 0.5) self.ad_gib2mdl = self.ad_gib5mdl;
	self.ad_gib4mdl = ""; self.ad_gib5mdl = "";

	self.ad_idle_sound = "demon/idle1.wav";
	precache_sound (self.ad_idle_sound);

	self.ad_pain_sound = "demon/dpain1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound ("demon/ddeath.wav");

	precache_sound ("demon/dhit2.wav");
	precache_sound ("demon/djump.wav");
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");

	self.ad_sight_sound = "demon/sight2.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		self.ad_exactskin = 1;
		self.ad_gib1skin = self.ad_gib2skin = self.ad_gib3skin = 1;
	}
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	// Original ID size -32 -32 -24, 32 32 64
	if (ad_CheckZeroVector(self.ad_idmins)) self.ad_idmins = ad_VEC_HULL2_MIN;
	if (ad_CheckZeroVector(self.ad_idmaxs)) self.ad_idmaxs = ad_VEC_HULL2_MAX;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	if (self.health < 1) self.health = ad_HP_MONDEMON1;
	self.ad_gibhealth = -80;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 200;				// takes alot to pain
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_pain_timeout = 2;				// High pain threshold
	self.ad_steptype = ad_FS_TYPESLOW;		// Tiny feet/nails
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_meleeoffset = '32 0 10';		// Claw attack offset
	self.ad_deathstring = " was eviscerated by a Fiend\n";

	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '600 0 250';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPDEMONNEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPDEMONFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_DemonCheckAttack;
	self.ad_th_stand = ad_demon1_stand1;
	self.ad_th_walk = ad_demon1_walk1;
	self.ad_th_run = ad_demon1_run1;
	self.ad_th_melee = ad_demon1_atta1;		// one of two attacks
	self.ad_th_jump = ad_demon1_jump1;		// jump attack
	self.ad_th_jumpexit = ad_demon1_jump11;
	self.ad_th_pain = ad_demon1_pain;
	self.ad_th_die = ad_demon1_die;

	self.ad_classtype = ad_CT_MONDEMON;
	self.ad_classgroup = ad_CG_DEMON;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
