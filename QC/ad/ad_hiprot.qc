/*======================================================================
 Rotate QuickC program by Jim Dose'  10/17/96
 Copyright (c)1996 Hipnotic Interactive, Inc.
 
 * All the functions and defs are self contained in this file
 * Should make it easier to distribute as no other qc file required
 * Collapsed and condensed this QC file as much as possible
 * Renamed all the constants so they don't conflict
 * It was a cool idea for its time (1996) but a horrible solution nowadays
   It would be much better to do this in the engine (rotation collision)
   Unfortunately most popular quake clients (QS/Fitz) refuse to add it
 * Added target2 to func_rotate_door to allow alternative start positions
 
------------------------------------------------------------------------
//QUAKED info_rotate (0 0.5 0) (-4 -4 -4) (4 4 4)
Used as the point of rotation for rotatable objects.
 
//QUAKED func_rotate_entity (0 .5 .8) (-8 -8 -8) (8 8 8) TOGGLE START_ON
Creates an entity that continually rotates.  Can be toggled on and
off if targeted.
 
//QUAKED path_rotate (0.5 0.3 0) (-8 -8 -8) (8 8 8) ROTATION ANGLES STOP NO_ROTATE DAMAGE MOVETIME SET_DAMAGE
 Path for rotate_train.
 
//QUAKED func_rotate_train (0 .5 .8) (-8 -8 -8) (8 8 8) x
Trains are moving platforms that players can ride.
If the train is the target of a button or trigger, it will not begin 
moving until activated.
The func_rotate_train entity is the center of rotation of all objects 
targeted by it.

//QUAKED func_movewall (0 .5 .8) ? VISIBLE TOUCH NONBLOCKING
Used to emulate collision on rotating objects.

//QUAKED rotate_object (0 .5 .8) ?
This defines an object to be rotated.
Used as the target of func_rotate_door.

//QUAKED func_rotate_door (0 .5 .8) (-8 -8 -8) (8 8 8) STAYOPEN
Creates a door that rotates between two positions around a point of
rotation each time it's triggered.

------------------------------------------------------------------------
Most modern compilers will expect the rotate_object to always
target a info_rotate (entity) so that it can sort out texture offset
All func_rotating objects DO NOT start at 0,0,0 like other bmodels

------------------------------------------------------------------------
Explaination of func_rotating objects (by Mechtech)

func_rotating_train (controller for rotation)
targetname -> trigger to start/activate train
target -> rotate_object (bmodel) AND rotate_movewall (bmodel)
path-> path_rotate (entity chain)

rotate_object (train brushwork)
target -> info_rotate (entity, center point for rotation)

rotate_movewall (pretends to do collision)

path_rotate (entity chain for train to follow)
targetname -> Used for reference
target -> next entity in chain to follow

------------------------------------------------------------------------
Func rotating doors cannot be moved on start so extra key added

func_rotate_door (controller for rotation)
targetname -> trigger to start/activate two state door
target -> rotate_object (bmodel) AND rotate_movewall (bmodel)
target2 -> info_rotate (entity) starting location for bmodel

======================================================================*/

// from hipdefs.qc in hipnotic/ritual source qc files
.vector ad_neworigin;
.vector rotate;
.float  ad_endtime;
.float  ad_rotate_type;
.string path;
.string ad_group;
.string event;
.float  ad_duration;
.vector ad_dest;	// Could not find this in the source, added

//----------------------------------------------------------------------
// from hipsubs.qc in hipnotic/ritual source qc files
vector ( vector ad_ang ) ad_SUB_NormalizeAngles =
{
   while( ad_ang_x > 360 ) ad_ang_x = ad_ang_x - 360;
   while( ad_ang_x < 0 ) ad_ang_x = ad_ang_x + 360;
   while( ad_ang_y > 360 ) ad_ang_y = ad_ang_y - 360;
   while( ad_ang_y < 0 ) ad_ang_y = ad_ang_y + 360;
   while( ad_ang_z > 360 ) ad_ang_z = ad_ang_z - 360;
   while( ad_ang_z < 0 ) ad_ang_z = ad_ang_z + 360;
   return ad_ang;
};

//----------------------------------------------------------------------
// from triggers.qc in hipnotic/ritual source qc files
void( entity ad_ent, float ad_amount ) ad_hurt_setdamage =
{
   ad_ent.dmg = ad_amount;
   if ( !ad_amount ) ad_ent.solid = ad_SOLID_NOT;
   else ad_ent.solid = ad_SOLID_TRIGGER;
   ad_ent.nextthink = -1;
};

//======================================================================
// Renamed all the constants so they don't conflict with anything else
// They were mostly setup as single words (which is not a good idea)
//======================================================================
float ad_RSTATE_ACTIVE      = 0;
float ad_RSTATE_INACTIVE    = 1;
float ad_RSTATE_SPEEDINGUP  = 2;
float ad_RSTATE_SLOWINGDOWN = 3;

float ad_RSTATE_CLOSED   = 4;
float ad_RSTATE_OPEN     = 5;
float ad_RSTATE_OPENING  = 6;
float ad_RSTATE_CLOSING  = 7;

float ad_RSTATE_WAIT = 0;
float ad_RSTATE_MOVE = 1;
float ad_RSTATE_STOP = 2;
float ad_RSTATE_FIND = 3;
float ad_RSTATE_NEXT = 4;

float ad_OBJECT_ROTATE = 0;
float ad_OBJECT_MOVEWALL  = 1;
float ad_OBJECT_SETORIGIN = 2;

float ad_ROTENTITY_TOGGLE   = 1;
float ad_ROTENTITY_START_ON = 2;

float ad_TRAIN_ROTATION = 1;
float ad_TRAIN_ANGLES   = 2;
float ad_TRAIN_STOP     = 4;
float ad_TRAIN_NO_ROTATE = 8;
float ad_TRAIN_DAMAGE   = 16;
float ad_TRAIN_MOVETIME = 32;
float ad_TRAIN_SET_DAMAGE = 64;

float ad_MOVEWALL_VISIBLE = 1;
float ad_MOVEWALL_TOUCH = 2;
float ad_MOVEWALL_NONBLOCKING = 4;

float ad_DOOR_STAYOPEN = 1;

//======================================================================
/*ad:QUAKED info_rotate (0 0.5 0) (-4 -4 -4) (4 4 4) x
center point for rotatable objects
-------- KEYS --------
-------- SPAWNFLAGS --------
-------- NOTES --------
center point for rotatable objects
Removes self 5s after spawning
*/
//======================================================================

void() ad_info_rotate =
{
	// remove self after a little while, to make sure that entities that
	// have targeted it have had a chance to spawn
	// Not sure why this entity is removed, maybe there was entity
	// limits in the old days, but that is long gone!
	// Leaving entity in map, no advantage to removal anymore
	//self.nextthink = time + 5;
	//self.think = SUB_Remove;
};

//----------------------------------------------------------------------
void() ad_RotateTargets =
{
   local entity ad_ent;
   local vector ad_vx;
   local vector ad_vy;
   local vector ad_vz;
   local vector ad_org;

   makevectors (self.angles);

	ad_ent = find( world, targetname, self.target);
	while( ad_ent ) {
		if ( ad_ent.ad_rotate_type == ad_OBJECT_SETORIGIN ) {
			ad_org = ad_ent.oldorigin;
			ad_vx = ( v_forward * ad_org_x );
			ad_vy = ( v_right   * ad_org_y );
			ad_vy = ad_vy * -1;
			ad_vz = ( v_up      * ad_org_z );
			ad_ent.ad_neworigin = ad_vx + ad_vy + ad_vz;
			setorigin( ad_ent, ad_ent.ad_neworigin + self.origin );
		}
		else if ( ad_ent.ad_rotate_type == ad_OBJECT_ROTATE ) {
			ad_ent.angles = self.angles;
			ad_org = ad_ent.oldorigin;
			ad_vx = ( v_forward * ad_org_x );
			ad_vy = ( v_right   * ad_org_y );
			ad_vy = ad_vy * -1;
			ad_vz = ( v_up      * ad_org_z );
			ad_ent.ad_neworigin = ad_vx + ad_vy + ad_vz;
			setorigin( ad_ent, ad_ent.ad_neworigin + self.origin );
		}
		else {
			ad_org = ad_ent.oldorigin;
			ad_vx = ( v_forward * ad_org_x );
			ad_vy = ( v_right   * ad_org_y );
			ad_vy = ad_vy * -1;
			ad_vz = ( v_up      * ad_org_z );
			ad_ent.ad_neworigin = ad_vx + ad_vy + ad_vz;
			ad_ent.ad_neworigin = self.origin - self.oldorigin + (ad_ent.ad_neworigin - ad_ent.oldorigin);
			ad_ent.velocity = (ad_ent.ad_neworigin-ad_ent.origin)*25;
		}
		ad_ent = find( ad_ent, targetname, self.target);
	}
};

//----------------------------------------------------------------------
void() ad_RotateTargetsFinal =
{
	local entity ad_ent;

	ad_ent = find( world, targetname, self.target);
	while( ad_ent ) {
		ad_ent.velocity = '0 0 0';
		if ( ad_ent.ad_rotate_type == ad_OBJECT_ROTATE ) ad_ent.angles = self.angles;
		ad_ent = find( ad_ent, targetname, self.target);
	}
};

//----------------------------------------------------------------------
void() ad_SetTargetOrigin =
{
	local entity ad_ent;

	ad_ent = find( world, targetname, self.target);
	while( ad_ent ) {
		if ( ad_ent.ad_rotate_type == ad_OBJECT_MOVEWALL ) {
			setorigin( ad_ent, self.origin - self.oldorigin +
			(ad_ent.ad_neworigin - ad_ent.oldorigin) );
		}
		else {
			setorigin( ad_ent, ad_ent.ad_neworigin + self.origin );
		}
		ad_ent = find( ad_ent, targetname, self.target);
	}
};

//----------------------------------------------------------------------
void() ad_LinkRotateTargets =
{
	local entity ad_ent;
	local vector ad_tempvec;

	self.oldorigin = self.origin;
	ad_ent = find( world, targetname, self.target);
	while( ad_ent ) {
		if ( ad_ent.classname == "rotate_object" ) {
			ad_ent.ad_rotate_type = ad_OBJECT_ROTATE;
			ad_ent.oldorigin = ad_ent.origin - self.oldorigin;
			ad_ent.ad_neworigin = ad_ent.origin - self.oldorigin;
			ad_ent.owner = self;
		}
		else if ( ad_ent.classname == "func_movewall" ) {
			ad_ent.ad_rotate_type = ad_OBJECT_MOVEWALL;
			ad_tempvec = ( ad_ent.absmin + ad_ent.absmax ) * 0.5;
			ad_ent.oldorigin = ad_tempvec - self.oldorigin;
			ad_ent.ad_neworigin = ad_ent.oldorigin;
			ad_ent.owner = self;
		}
		else {
			ad_ent.ad_rotate_type = ad_OBJECT_SETORIGIN;
			ad_ent.oldorigin = ad_ent.origin - self.oldorigin;
			ad_ent.ad_neworigin = ad_ent.origin - self.oldorigin;
		}
		ad_ent = find (ad_ent, targetname, self.target);
	}
};

//----------------------------------------------------------------------
void( float ad_amount ) ad_SetDamageOnTargets =
{
	local entity ad_ent;

	ad_ent = find( world, targetname, self.target);
	while( ad_ent ) {
		if ( ad_ent.classname == "trigger_hurt" ) ad_hurt_setdamage( ad_ent, ad_amount );
		else if ( ad_ent.classname == "func_movewall" ) ad_ent.dmg = ad_amount;
		ad_ent = find( ad_ent, targetname, self.target);
	}
};


//----------------------------------------------------------------------
// Simple continual rotatation
//----------------------------------------------------------------------
void() ad_rotate_entity_think =
{
	local float ad_t;

	ad_t = time - self.ltime;
	self.ltime = time;

	if ( self.state == ad_RSTATE_SPEEDINGUP ) {
		self.count = self.count + self.cnt * ad_t;
		if ( self.count > 1 ) self.count = 1;

		// get rate of rotation
		ad_t = ad_t * self.count;
	}
	else if ( self.state == ad_RSTATE_SLOWINGDOWN ) {
		self.count = self.count - self.cnt * ad_t;
		if ( self.count < 0 ) {
			ad_RotateTargetsFinal();
			self.state = ad_RSTATE_INACTIVE;
			self.think = ad_SUB_Null;
			return;
		}

		// get rate of rotation
		ad_t = ad_t * self.count;
	}

	self.angles = self.angles + ( self.rotate * ad_t );
	self.angles = ad_SUB_NormalizeAngles( self.angles );
	ad_RotateTargets();
	self.nextthink = time + 0.02;
};

//----------------------------------------------------------------------
void() ad_rotate_entity_use =
{
	// change to alternate textures
	self.frame = 1 - self.frame;

	if ( self.state == ad_RSTATE_ACTIVE ) {
		if ( self.spawnflags & ad_ROTENTITY_TOGGLE ) {
			if ( self.speed ) {
				self.count = 1;
				self.state = ad_RSTATE_SLOWINGDOWN;
			}
			else {
				self.state = ad_RSTATE_INACTIVE;
				self.think = ad_SUB_Null;
			}
		}
	}
	else if ( self.state == ad_RSTATE_INACTIVE ) {
		self.think = ad_rotate_entity_think;
		self.nextthink = time + 0.02;
		self.ltime = time;
		if ( self.speed ) {
			self.count = 0;
			self.state = ad_RSTATE_SPEEDINGUP;
		}
		else {
			self.state = ad_RSTATE_ACTIVE;
		}
	}
	else if ( self.state == ad_RSTATE_SPEEDINGUP ) {
		if ( self.spawnflags & ad_ROTENTITY_TOGGLE ) {
			self.state = ad_RSTATE_SLOWINGDOWN;
		}
	}
	else {
		self.state = ad_RSTATE_SPEEDINGUP;
	}
};

//----------------------------------------------------------------------
void() ad_rotate_entity_firstthink =
{
	ad_LinkRotateTargets();
	if ( self.spawnflags & ad_ROTENTITY_START_ON ) {
		self.state = ad_RSTATE_ACTIVE;
		self.think = ad_rotate_entity_think;
		self.nextthink = time + 0.02;
		self.ltime = time;
	}
	else {
		self.state = ad_RSTATE_INACTIVE;
		self.think = ad_SUB_Null;
	}
	self.use = ad_rotate_entity_use;
};

//======================================================================
/*ad:QUAKED func_rotate_entity (0 .5 .8) (-8 -8 -8) (8 8 8) TOGGLE STARTON
Basic rotating object
-------- KEYS --------
target : points to center of rotation entity
rotate : The rate of rotation in degrees
speed  : time taken to go from zero to full speed and vice-versa
-------- SPAWNFLAGS --------
TOGGLE  : allows the rotation to be toggled on/off
STARTON : whether the entity is spinning when spawned.  
If TOGGLE is 0, entity can be turned on, but not off.
-------- NOTES --------
Basic rotating object
*/
//======================================================================
void() ad_func_rotate_entity =
{
	self.solid    = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;

	setmodel (self, self.model);
	setsize( self, self.mins, self.maxs );

	if ( self.speed != 0 ) self.cnt = 1 / self.speed;

	self.think = ad_rotate_entity_firstthink;
	self.nextthink = time + 0.1;
	self.ltime = time;
};

//======================================================================
/*ad:QUAKED path_rotate (0.5 0.3 0) (-8 -8 -8) (8 8 8) ROTATION ANGLES STOP NO_ROTATE DAMAGE MOVETIME SET_DAMAGE
Corner Path for rotate_train
-------- KEYS --------
event  : is a target to trigger when train arrives at path_rotate
noise  : contains the name of the sound to play when train stops
noise1 : contains the name of the sound to play when train moves
speed  : set speed to be the new speed of the train after it reaches
  the path change.  If speed is -1, the train will warp directly to the next
  path change after the specified wait time.  If MOVETIME is set on the
  path_rotate, the train to interprets "speed" as the length of time to
  take moving from one corner to another.
-------- SPAWNFLAGS --------
ROTATION  : Rotate train at rate specified by 'rotate', use '0 0 0' to stop
ANGLES    : Rotate to the angles specified by 'angles'
  while traveling to this path_rotate.  Use values < 0 or > 360 to 
  guarantee that it turns in a certain direction.  Having this flag 
  set automatically clears any rotation
STOP      : stop train and wait to be retriggered
NO_ROTATE : stop train rotating when waiting to be triggered
DAMAGE    : Cause damage based on 'dmg'
MOVETIME  : Interpret 'speed' as the length of time to take moving
SET_DAMAGE: Set all targets damage to 'dmg'
-------- NOTES --------
Corner Path for rotate_train
*/
//======================================================================
void() ad_rotate_train;
void() ad_rotate_train_next;
void() ad_rotate_train_find;

//----------------------------------------------------------------------
void() ad_path_rotate =
{
	if ( self.noise ) precache_sound( self.noise );
	if ( self.noise1 ) 	precache_sound( self.noise1 );
};

//----------------------------------------------------------------------
void() ad_rotate_train_think =
{
	local float ad_t;
	local float ad_timeelapsed;

	ad_t = time - self.ltime;
	self.ltime = time;

	if ( ( self.ad_endtime ) && ( time >= self.ad_endtime ) ) {
		self.ad_endtime = 0;
		if ( self.state == ad_RSTATE_MOVE ) {
			setorigin(self, self.ad_finaldest);
			self.velocity = '0 0 0';
		}

		if (self.ad_think1) self.ad_think1();
	}
	else {
		ad_timeelapsed = (time - self.cnt) * self.ad_duration;
		if ( ad_timeelapsed > 1 ) ad_timeelapsed = 1;
		setorigin( self, self.dest1 + ( self.dest2 * ad_timeelapsed ) );
	}

	self.angles = self.angles + ( self.rotate * ad_t );
	self.angles = ad_SUB_NormalizeAngles( self.angles );
	ad_RotateTargets();

	self.nextthink = time + 0.02;
};

//----------------------------------------------------------------------
void() ad_rotate_train_use =
{
	if (self.ad_think1 != ad_rotate_train_find) {
		if ( self.velocity != '0 0 0' ) return;		// already activated
		if ( self.ad_think1 ) self.ad_think1();
	}
};

//----------------------------------------------------------------------
void() ad_rotate_train_wait =
{
	self.state = ad_RSTATE_WAIT;

	if ( self.goalentity.noise ) {
		sound (self, ad_CHAN_VOICE, self.goalentity.noise, 1, ad_ATTN_NORM);
	}
	else sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);

	if ( self.goalentity.spawnflags & ad_TRAIN_ANGLES ) {
		self.rotate = '0 0 0';
		self.angles = self.finalangle;
	}
	
	if ( self.goalentity.spawnflags & ad_TRAIN_NO_ROTATE ) self.rotate = '0 0 0';

	self.ad_endtime = self.ltime + self.goalentity.wait;
	self.ad_think1 = ad_rotate_train_next;
};

//----------------------------------------------------------------------
void() ad_rotate_train_stop =
{
	self.state = ad_RSTATE_STOP;

	if ( self.goalentity.noise ) {
		sound (self, ad_CHAN_VOICE, self.goalentity.noise, 1, ad_ATTN_NORM);
	}
	else sound (self, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);

	if ( self.goalentity.spawnflags & ad_TRAIN_ANGLES ) {
		self.rotate = '0 0 0';
		self.angles = self.finalangle;
	}
	if ( self.goalentity.spawnflags & ad_TRAIN_NO_ROTATE ) self.rotate = '0 0 0';

	self.dmg = 0;
	self.ad_think1 = ad_rotate_train_next;
};

//----------------------------------------------------------------------
void() ad_rotate_train_next =
{
	local entity ad_targ;
	local entity ad_current;
	local vector   ad_vdestdelta;
	local float    ad_len, ad_traveltime, ad_div;
	local string ad_temp;

	self.state = ad_RSTATE_NEXT;

	ad_current = self.goalentity;
	ad_targ = find (world, targetname, self.path );
	if ( ad_targ.classname != "path_rotate" )
		dprint("\b[ROT TRAIN]\b Next target is not path_rotate\n");

	if ( self.goalentity.noise1 ) self.noise1 = self.goalentity.noise1;
	sound (self, ad_CHAN_VOICE, self.noise1, 1, ad_ATTN_NORM);

	self.goalentity = ad_targ;
	self.path = ad_targ.target;
	if (!self.path ) dprint("\b[ROT TRAIN]\b No next target\n");

	if ( ad_targ.spawnflags & ad_TRAIN_STOP ) self.ad_think1 = ad_rotate_train_stop;
	else if (ad_targ.wait) self.ad_think1 = ad_rotate_train_wait;
	else self.ad_think1 = ad_rotate_train_next;

	if ( ad_current.event ) {
		// Trigger any events that should happen at the corner.
		ad_temp = self.target;
		self.target = ad_current.event;
		self.message = ad_current.message;
		ad_SUB_UseTargets();
		self.target = ad_temp;
		self.message = ad_string_null;
	}

	if ( ad_current.spawnflags & ad_TRAIN_ANGLES ) {
		self.rotate = '0 0 0';
		self.angles = self.finalangle;
	}

	if ( ad_current.spawnflags & ad_TRAIN_ROTATION ) self.rotate = ad_current.rotate;
	if ( ad_current.spawnflags & ad_TRAIN_DAMAGE ) self.dmg = ad_current.dmg;
	if ( ad_current.spawnflags & ad_TRAIN_SET_DAMAGE ) ad_SetDamageOnTargets( ad_current.dmg );

	if ( ad_current.speed == -1 ) {
		// Warp to the next path_corner
		setorigin( self, ad_targ.origin );
		self.ad_endtime = self.ltime + 0.01;
		ad_SetTargetOrigin();

		if ( ad_targ.spawnflags & ad_TRAIN_ANGLES ) self.angles = ad_targ.angles;

		self.ad_duration = 1;         // 1 / duration
		self.cnt = time;           // start time
		self.dest2 = '0 0 0';      // delta
		self.dest1 = self.origin;  // original position
		self.ad_finaldest = self.origin;
	}
	else {
		self.state = ad_RSTATE_MOVE;

		self.ad_finaldest = ad_targ.origin;
		if (self.ad_finaldest == self.origin) {
			self.velocity = '0 0 0';
			self.ad_endtime = self.ltime + 0.1;

			self.ad_duration = 1;        // 1 / duration
			self.cnt = time;          // start time
			self.dest2 = '0 0 0';     // delta
			self.dest1 = self.origin; // original position
			self.ad_finaldest = self.origin;
			return;
		}
		// set destdelta to the vector needed to move
		ad_vdestdelta = self.ad_finaldest - self.origin;

		// calculate length of vector
		ad_len = vlen (ad_vdestdelta);

		if ( ad_current.spawnflags & ad_TRAIN_MOVETIME ) ad_traveltime = ad_current.speed;
		else {
			// check if there's a speed change
			if (ad_current.speed>0) self.speed = ad_current.speed;
			if (!self.speed) dprint("\b[ROT TRAIN]\b No speed is defined!\n");

			// divide by speed to get time to reach dest
			ad_traveltime = ad_len / self.speed;
		}

		if (ad_traveltime < 0.1) {
			self.velocity = '0 0 0';
			self.ad_endtime = self.ltime + 0.1;
			if ( ad_targ.spawnflags & ad_TRAIN_ANGLES ) self.angles = ad_targ.angles;
			return;
		}

		// qcc won't take vec/float
		ad_div = 1 / ad_traveltime;

		if ( ad_targ.spawnflags & ad_TRAIN_ANGLES ) {
			self.finalangle = ad_SUB_NormalizeAngles( ad_targ.angles );
			self.rotate = ( ad_targ.angles - self.angles ) * ad_div;
		}

		// set endtime to trigger a think when dest is reached
		self.ad_endtime = self.ltime + ad_traveltime;

		// scale the destdelta vector by the time spent traveling to get velocity
		self.velocity = ad_vdestdelta * ad_div;

		self.ad_duration = ad_div;      // 1 / duration
		self.cnt = time;          // start time
		self.dest2 = ad_vdestdelta;  // delta
		self.dest1 = self.origin; // original position
	}
};

//----------------------------------------------------------------------
void() ad_rotate_train_find =
{
	local entity ad_targ;

	self.state = ad_RSTATE_FIND;
	ad_LinkRotateTargets();

	// the first target is the point of rotation.
	// the second target is the path.
	ad_targ = find ( world, targetname, self.path);
	if ( ad_targ.classname != "path_rotate" )
		dprint("\b[ROT TRAIN]\b Next target is not path_rotate\n");

	// Save the current entity
	self.goalentity = ad_targ;

	if ( ad_targ.spawnflags & ad_TRAIN_ANGLES ) {
		self.angles = ad_targ.angles;
		self.finalangle = ad_SUB_NormalizeAngles( ad_targ.angles );
	}

	self.path = ad_targ.target;
	setorigin (self, ad_targ.origin );
	ad_SetTargetOrigin();
	ad_RotateTargetsFinal();
	self.ad_think1 = ad_rotate_train_next;
	if (!self.targetname) {
		// not triggered, so start immediately
		self.ad_endtime = self.ltime + 0.1;
	}
	else self.ad_endtime = 0;

	self.ad_duration = 1;        // 1 / duration
	self.cnt = time;          // start time
	self.dest2 = '0 0 0';     // delta
	self.dest1 = self.origin; // original position
};

//======================================================================
/*ad:QUAKED func_rotate_train (0 .5 .8) (-8 -8 -8) (8 8 8) x
Trains are moving platforms that players can ride
-------- KEYS --------
path   : Starts at'path_rotate' position
speed  : travel speed (def=100)
dmg    : blocking damage (def=0)
sounds : 0=Silent, 1=ratchet metal
noise  : sound to play when train stops
noise1 : sound to play when train moves
-------- SPAWNFLAGS --------
-------- NOTES --------
Trains are moving platforms that players can ride
If the train is the target of a button or trigger, it will for trigger
The func_rotate_train entity is the center of rotation of all objects 
targeted by it.

*/
//======================================================================
void() ad_rotate_train =
{
	dprint("\b[ROTATE]\b rotate_train not supported anymore!\n");
};

//----------------------------------------------------------------------
void() ad_func_rotate_train =
{
	if (!self.speed) self.speed = 100;
	if (!self.target) dprint("\b[ROT TRAIN]\b missing target!\n");

	if ( !self.noise ) {
		if (self.sounds == 0) self.noise = ad_SOUND_EMPTY;
		if (self.sounds == 1) self.noise = "plats/train2.wav";
	}
	if ( !self.noise1 ) {
		if (self.sounds == 0) self.noise1 = ad_SOUND_EMPTY;
		if (self.sounds == 1) self.noise1 = "plats/train1.wav";
	}

	precache_sound( self.noise );
	precache_sound( self.noise1 );

	self.cnt = 1;
	self.solid    = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_STEP;
	self.use = ad_rotate_train_use;

	setmodel (self, self.model);
	setsize (self, self.mins, self.maxs);
	setorigin (self, self.origin);

	// start trains on the second frame, to make sure their 
	// targets have had a chance to spawn
	self.ltime = time;
	self.nextthink = self.ltime + 0.1;
	self.ad_endtime = self.ltime + 0.1;
	self.think = ad_rotate_train_think;
	self.ad_think1 = ad_rotate_train_find;
	self.state = ad_RSTATE_FIND;

	self.ad_duration = 1;        // 1 / duration
	self.cnt = 0.1;           // start time
	self.dest2 = '0 0 0';     // delta
	self.dest1 = self.origin; // original position

	self.flags = self.flags | ad_FL_ONGROUND;
};

//----------------------------------------------------------------------
// Moving clip walls
//----------------------------------------------------------------------
void() ad_rotate_door_reversedirection;
void() ad_rotate_door_group_reversedirection;

void() ad_movewall_touch =
{
	if (time < self.owner.ad_attack_finished) return;

	if ( self.dmg ) {
		ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);
		self.owner.ad_attack_finished = time + 0.5;
	}
	else if ( self.owner.dmg ) {
		ad_T_Damage (other, self, self.owner, self.owner.dmg, ad_DAMARMOR);
		self.owner.ad_attack_finished = time + 0.5;
	}
};

//----------------------------------------------------------------------
void() ad_movewall_blocked =
{
	local entity ad_temp;

	if (time < self.owner.ad_attack_finished) return;

	self.owner.ad_attack_finished = time + 0.5;

	if ( self.owner.classname == "func_rotate_door" ) {
		ad_temp = self;
		self = self.owner;
		ad_rotate_door_group_reversedirection();
		self = ad_temp;
	}

	if ( self.dmg ) {
		ad_T_Damage (other, self, self.owner, self.dmg, ad_DAMARMOR);
		self.owner.ad_attack_finished = time + 0.5;
	}
	else if ( self.owner.dmg ) {
		ad_T_Damage (other, self, self.owner, self.owner.dmg, ad_DAMARMOR);
		self.owner.ad_attack_finished = time + 0.5;
	}
};

//----------------------------------------------------------------------
void() ad_movewall_think =
{
	self.ltime = time;
	self.nextthink = time + 0.02;
};

//======================================================================
/*ad:QUAKED func_movewall (0 .5 .8) ? VISIBLE TOUCH NONBLOCKING
Emulate collision on rotating objects
-------- KEYS --------
dmg : damage to cause when touched or blocked
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
-------- SPAWNFLAGS --------
VISIBLE     : Causes brush to be displayed
TOUCH       : Cause damage when touched by player
NONBLOCKING : makes the brush non-solid,  This is useless if VISIBLE is set
-------- NOTES --------
Emulate collision on rotating objects
*/
//======================================================================
void() ad_func_movewall =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	self.angles = '0 0 0';
	self.movetype = ad_MOVETYPE_PUSH;
	
	if ( self.spawnflags & ad_MOVEWALL_NONBLOCKING ) self.solid = ad_SOLID_NOT;
	else {
		self.solid = ad_SOLID_BSP;
		self.blocked = ad_movewall_blocked;
	}
	
	if ( self.spawnflags & ad_MOVEWALL_TOUCH ) {
		self.touch = ad_movewall_touch;
	}
	
	setmodel (self,self.model);
	if ( !( self.spawnflags & ad_MOVEWALL_VISIBLE ) ) self.model = ad_string_null;

	self.think = ad_movewall_think;
	self.nextthink = time + 0.02;
	self.ltime = time;
};

//======================================================================
/*ad:QUAKED rotate_object (0 .5 .8) ?
Defines a bmodel object to be rotated
-------- KEYS --------
targetname : name of bmodel object
target     : rotating point entities to link too
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
-------- SPAWNFLAGS --------
-------- NOTES --------
Defines a bmodel object to be rotated
Used as the target of func_rotate_door
*/
//======================================================================
void() ad_rotate_object_move =
{
	local entity ad_ent;
	
	ad_ent = find( world, targetname, self.ad_target2);
	if (ad_ent.classname == "info_rotate") {
		// Move origin to new location
		self.oldorigin = ad_ent.origin;
		setorigin( self, self.oldorigin );
	}
};

//----------------------------------------------------------------------
void() ad_rotate_object =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	self.classname = "rotate_object";
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	self.ad_bsporigin = ad_TRUE;		// bmodel origin 0,0,0
	setmodel (self,self.model);
	setsize( self, self.mins, self.maxs );
	
	// Check for a target (info_rotate) to move the object
	if (self.ad_target2 != "") {
		self.think = ad_rotate_object_move;
		self.nextthink = time + 1;
	}
	else self.think = ad_SUB_Null;
};

//----------------------------------------------------------------------
void() ad_rotate_door_think2 =
{
	local float ad_t;

	ad_t = time - self.ltime;
	self.ltime = time;

	// change to alternate textures
	self.frame = 1 - self.frame;
	self.angles = self.ad_dest;

	if ( self.state == ad_RSTATE_OPENING ) self.state = ad_RSTATE_OPEN;
	else {
		if ( self.spawnflags & ad_DOOR_STAYOPEN ) {
			ad_rotate_door_group_reversedirection();
			return;
		}
		self.state = ad_RSTATE_CLOSED;
	}

	sound(self, ad_CHAN_VOICE, self.noise3, 1, ad_ATTN_NORM);
	self.think = ad_SUB_Null;

	ad_RotateTargetsFinal();
};

//----------------------------------------------------------------------
void() ad_rotate_door_think =
{
	local float ad_t;

	ad_t = time - self.ltime;
	self.ltime = time;

	if ( time < self.ad_endtime ) {
		self.angles = self.angles + ( self.rotate * ad_t );
		ad_RotateTargets();
	}
	else {
		self.angles = self.ad_dest;
		ad_RotateTargets();
		self.think = ad_rotate_door_think2;
	}

	self.nextthink = time + 0.01;
};

//----------------------------------------------------------------------
void() ad_rotate_door_reversedirection =
{
	local vector ad_start;

	// change to alternate textures
	self.frame = 1 - self.frame;

	if ( self.state == ad_RSTATE_CLOSING ) {
		ad_start = self.dest1;
		self.ad_dest = self.dest2;
		self.state = ad_RSTATE_OPENING;
	}
	else {
		ad_start = self.dest2;
		self.ad_dest = self.dest1;
		self.state = ad_RSTATE_CLOSING;
	}

	sound(self, ad_CHAN_VOICE, self.noise2, 1, ad_ATTN_NORM);

	self.rotate = ( self.ad_dest - ad_start ) * ( 1 / self.speed );
	self.think = ad_rotate_door_think;
	self.nextthink = time + 0.02;
	self.ad_endtime = time + self.speed - ( self.ad_endtime - time );
	self.ltime = time;
};

//----------------------------------------------------------------------
void() ad_rotate_door_group_reversedirection =
{
	local string ad_name;

	// tell all associated rotaters to reverse direction
	if ( self.ad_group ) {
		ad_name = self.ad_group;
		self = find( world, ad_group, ad_name);
		while( self ) {
			ad_rotate_door_reversedirection();
			self = find( self, ad_group, ad_name);
		}
	}
	else ad_rotate_door_reversedirection();
};

//----------------------------------------------------------------------
void() ad_rotate_door_use =
{
	// local entity t;
	local vector ad_start;

	if ( ( self.state != ad_RSTATE_OPEN ) && ( self.state != ad_RSTATE_CLOSED ) ) return;

	if ( !self.cnt ) {
		self.cnt = 1;
		ad_LinkRotateTargets();
	}

	// change to alternate textures
	self.frame = 1 - self.frame;

	if ( self.state == ad_RSTATE_CLOSED ) {
		ad_start = self.dest1;
		self.ad_dest = self.dest2;
		self.state = ad_RSTATE_OPENING;
	}
	else {
		ad_start = self.dest2;
		self.ad_dest = self.dest1;
		self.state = ad_RSTATE_CLOSING;
	}

	sound(self, ad_CHAN_VOICE, self.noise2, 1, ad_ATTN_NORM);

	self.rotate = ( self.ad_dest - ad_start ) * ( 1 / self.speed );
	self.think = ad_rotate_door_think;
	self.nextthink = time + 0.01;
	self.ad_endtime = time + self.speed;
	self.ltime = time;
};

//======================================================================
/*ad:QUAKED func_rotate_door (0 .5 .8) (-8 -8 -8) (8 8 8) STAYOPEN
Rotating door moving around a point of rotation
-------- KEYS --------
target  : Points to the rotate_object bmodel entity
target2 : Move on spawn to this entity (info_rotate) location
dmg     : Damage caused when blocked (def=2) negative numbers =no damage
speed   : Time taken to rotate open/close
sounds  : 1=medieval 2=metal 3=base 4=Silent (def=1)
-------- SPAWNFLAGS --------
STAYOPEN : Reopen after closing, stops a once only door from closing if blocked
-------- NOTES --------
Rotating door moving around a point of rotation
*/
//======================================================================
void() ad_func_rotate_door =
{
	if (!self.target) dprint("\b[ROT DOOR]\b missing target!\n");

	self.dest1 = '0 0 0';
	self.dest2 = self.angles;
	self.angles = self.dest1;

	// default to 2 seconds
	if ( !self.speed ) self.speed = 2;
	self.cnt = 0;

	if (!self.dmg) self.dmg = 2;
	else if ( self.dmg < 0 ) self.dmg = 0;

	if (self.sounds == 0) self.sounds = 1;
	if (self.sounds == 1) {
		self.noise1 = "doors/latch2.wav";
		self.noise2 = "doors/winch2.wav";
		self.noise3 = "doors/drclos4.wav";
	}
	if (self.sounds == 2) {
		self.noise2 = "doors/airdoor1.wav";
		self.noise1 = "doors/airdoor2.wav";
		self.noise3 = "doors/airdoor2.wav";
	}
	if (self.sounds == 3) {
		self.noise2 = "doors/basesec1.wav";
		self.noise1 = "doors/basesec2.wav";
		self.noise3 = "doors/basesec2.wav";
	}
	if (self.sounds == 4) {
		self.noise1 = ad_SOUND_EMPTY;
		self.noise2 = ad_SOUND_EMPTY;
		self.noise3 = ad_SOUND_EMPTY;
	}
	
	precache_sound (self.noise1);
	precache_sound (self.noise2);
	precache_sound (self.noise3);

	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	setmodel (self, self.model);
	setorigin( self, self.origin );
	setsize( self, self.mins, self.maxs );
	self.state = ad_RSTATE_CLOSED;
	self.use = ad_rotate_door_use;
	self.think = ad_SUB_Null;
};
