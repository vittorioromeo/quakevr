// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
/*ad:QUAKED func_insidevolume (0 .5 .8) ? PLAYER MONSTER ITEM PUSHABLE x x STARTOFF x Not_Easy Not_Normal Not_Hard Not_DM
Function to test if an entity bounding box is inside of this volume
-------- KEYS --------
targetname : trigger entity (works with entity state system)
target  : Name of target(s) to trigger when fully INSIDE (fires every 0.1s)
target2 : Name of target(s) to trigger when partial INSIDE (fires every 0.1s)
message : Name of target(s) to trigger when exit VOLUME (fires on exit only)
wait    : -1 = Fire the fully/exit volume target(s) once
delay   : Delay time before volume controller becomes active
message2: Name of the only entity that can interact with this volume
no_deadbody : 1 = Monster dead bodies don't work with volume test
-------- SPAWNFLAGS --------
PLAYER    : Will react to player(s)
MONSTER   : Will react to monster(s)
ITEM      : Will react to item(s)
PUSHABLE  : Will react to pushable(s)
STARTOFF  : Starts off and waits for trigger
-------- NOTES --------
Function to test if an entity bounding box is inside of this volume

======================================================================*/

float ad_FUNC_INSVOLPLAYER = 1;
float ad_FUNC_INSVOLMONSTER = 2;
float ad_FUNC_INSVOLITEM = 4;
float ad_FUNC_INSVOLPUSHABLE = 8;

//----------------------------------------------------------------------
float(entity ad_targ) ad_func_insvolume_check =
{
	local vector ad_targ_mins, ad_targ_maxs;
	
	// Is the touching entity linked to anthing?
	if (ad_targ.ad_touching == world) return ad_TRUE;
	
	// Is the touching entity linked to this inside volume?
	// Don't reset the touching entity, its being tested by something else
	if (ad_targ.ad_touching != self.owner) return ad_TRUE;

	// Has the touching entity been switch off/disabled
	if (ad_targ.ad_estate & ad_ESTATE_BLOCK) { ad_targ.ad_touching = world; return ad_TRUE; }
	
	// Check for dead monsters and removed them from entity list
	if (ad_targ.flags & ad_FL_MONSTER) {
		if (self.owner.ad_no_deadbody == 1 && ad_targ.health < 1) { 
			ad_targ.ad_touching = world; 
			return ad_TRUE;
		}
	}

	// Find entity origin
	if (ad_targ.ad_bsporigin) {
		// Bmodel origin is stored differently
		self.owner.ad_pos3 = ad_bmodel_origin(ad_targ);
		// Min/max are only updated when spawned, use size instead
		ad_targ_mins = self.owner.ad_pos3 - (ad_targ.size*0.5);
		ad_targ_maxs = self.owner.ad_pos3 + (ad_targ.size*0.5);
	}
	else {
		// Point entity uses origin key
		self.owner.ad_pos3 = ad_targ.origin;
		// Min/max are created when spawned
		ad_targ_mins = self.owner.ad_pos3 + ad_targ.mins;
		ad_targ_maxs = self.owner.ad_pos3 + ad_targ.maxs;
	}

	// Test OUTSIDE space (targ max < trigger min)
	if (ad_targ_maxs_x < self.owner.dest1_x || ad_targ_maxs_y < self.owner.dest1_y ||
		ad_targ_maxs_z < self.owner.dest1_z) {
		//dprint("ENT outside MINS\n");
		ad_targ.ad_touching = world; 
		self.owner.ad_targetnumber = ad_NEGATIVE;
		return ad_TRUE;
	}
	// Test OUTSIDE space (targ min > trigger max)
	if (ad_targ_mins_x > self.owner.dest2_x || ad_targ_mins_y > self.owner.dest2_y ||
		ad_targ_mins_z > self.owner.dest2_z) {
		//dprint("ENT outside MAXS\n");
		ad_targ.ad_touching = world; 
		self.owner.ad_targetnumber = ad_NEGATIVE;
		return ad_TRUE;
	}

	// Test INSIDE space (targ min < trigger min)
	if (ad_targ_mins_x < self.owner.dest1_x) return ad_FALSE;
	if (ad_targ_mins_y < self.owner.dest1_y) return ad_FALSE;
	if (ad_targ_mins_z < self.owner.dest1_z) return ad_FALSE;
	
	// Test INSIDE space (targ max > trigger max)
	if (ad_targ_maxs_x > self.owner.dest2_x) return ad_FALSE;
	if (ad_targ_maxs_y > self.owner.dest2_y) return ad_FALSE;
	if (ad_targ_maxs_z > self.owner.dest2_z) return ad_FALSE;
	
	// Finally something INSIDE the volume!
	self.owner.ad_targetnumber = ad_TRUE;
	return ad_FALSE;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_func_insvolume_add =
{
	if (self.ad_tno1 == world) { self.ad_tno1 = ad_targ; ad_targ.ad_touching = self; }
	else if (self.ad_tno2 == world) { self.ad_tno2 = ad_targ; ad_targ.ad_touching = self; }
	else if (self.ad_tno3 == world) { self.ad_tno3 = ad_targ; ad_targ.ad_touching = self; }
	else if (self.ad_tno4 == world) { self.ad_tno4 = ad_targ; ad_targ.ad_touching = self; }
	else if (self.ad_tno5 == world) { self.ad_tno5 = ad_targ; ad_targ.ad_touching = self; }
	else {
		// A warning message for mappers to ignore! :P
		if (self.ad_pain_finished < time) {
			self.ad_pain_finished = time + 3;
			dprint("\b[INSVOL]\b More than 5 entities touching!\n");
		}
	}
};

//----------------------------------------------------------------------
void() ad_func_insvolume_touch =
{
	// Block functionality if state wrong
	if (self.ad_estate & ad_ESTATE_BLOCK) return;
	
	// Already checking this (other) entity?
	if (other.ad_touching == self) return;

	// Check for an exact entity condition
	if (self.ad_message2 != "") { 
		// Is the touching entity the correct entity?
		if (self.ad_message2 != other.targetname) return;
	}
	
	// Default = no touch
	self.lefty = ad_FALSE;
	
	// Test for all the different entity types
	if (self.spawnflags & ad_FUNC_INSVOLPLAYER && other.flags & ad_FL_CLIENT)
		self.lefty = ad_TRUE;
	else if (self.spawnflags & ad_FUNC_INSVOLMONSTER && other.flags & ad_FL_MONSTER) {
		// Test for dead/living monsters?
		if (self.ad_no_deadbody == 0) self.lefty = ad_TRUE;
		else if (self.ad_no_deadbody == 1 && other.health > 0) 
			self.lefty = ad_TRUE;
	}
	else if (self.spawnflags & ad_FUNC_INSVOLITEM && other.flags & ad_FL_ITEM)
		self.lefty = ad_TRUE;
	else if (self.spawnflags & ad_FUNC_INSVOLPUSHABLE && other.ad_classtype == ad_CT_FUNCPUSHABLE)
		self.lefty = ad_TRUE;
	
	// If wrong type touching volume?
	if (self.lefty == ad_FALSE) return;

	// Add entity to volume list to keep checking
	if (other.ad_touching == world) 
		ad_func_insvolume_add(other);
};

//----------------------------------------------------------------------
void() ad_func_insvolume_on =
{
	// Stop re-triggering ON state
	if (self.ad_estate == ad_ESTATE_ON) return;

	// No longer need this spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_ENT_STARTOFF);
	
	self.ad_estate = ad_ESTATE_ON;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_TRIGGER;
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
};

//----------------------------------------------------------------------
void() ad_func_insvolume_off =
{
	// Stop re-triggering OFF state
	if (self.ad_estate == ad_ESTATE_OFF) return;

	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setsize (self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
};

//----------------------------------------------------------------------
void() ad_func_insvolume_controller_think =
{
	// Keep the controller looping
	self.think = ad_func_insvolume_controller_think;
	self.nextthink = time + 0.1;
	self.owner.ad_targetnumber = ad_FALSE;
	
	// If switched off/disabled
	if (self.owner.ad_estate & ad_ESTATE_BLOCK) return;

	// If no entities touching volume, do nothing
	// This is a way to slow down the constant triggering
	if (self.owner.ad_tno1 != world || self.owner.ad_tno2 != world ||
		self.owner.ad_tno3 != world || self.owner.ad_tno4 != world ||
		self.owner.ad_tno5 != world) {
	
		// Go through the entities touching this volume
		if (ad_func_insvolume_check(self.owner.ad_tno1) == ad_TRUE) self.owner.ad_tno1 = world;
		if (ad_func_insvolume_check(self.owner.ad_tno2) == ad_TRUE) self.owner.ad_tno2 = world;
		if (ad_func_insvolume_check(self.owner.ad_tno3) == ad_TRUE) self.owner.ad_tno3 = world;
		if (ad_func_insvolume_check(self.owner.ad_tno4) == ad_TRUE) self.owner.ad_tno4 = world;
		if (ad_func_insvolume_check(self.owner.ad_tno5) == ad_TRUE) self.owner.ad_tno5 = world;
		
		// Any entities pass the volume test? (FULL, PARTIAL and EXIT)
		if (self.owner.ad_targetnumber == ad_TRUE) {
			// FULLY inside the volume
			if (self.owner.target != "") {
				ad_trigger_strs(self.owner.target, self.owner);
				if (self.owner.wait < 0) self.owner.target = "";
			}
		}
		else if (self.owner.ad_targetnumber == ad_NEGATIVE) {
			// Just EXIT the volume
			if (self.owner.message != "") {
				ad_trigger_strs(self.owner.message, self.owner);
				if (self.owner.wait < 0) self.owner.message = "";
			}
		}
		else {
			// PARTIALLY inside the volume
			if (self.owner.ad_target2 != "") {
				ad_trigger_strs(self.owner.ad_target2, self.owner);
			}
		}
	}
};

//----------------------------------------------------------------------
void() ad_func_insvolume_controller_setup =
{
	// Check if controller entity been setup
	if (!self.ad_attachment) self.ad_attachment = spawn();

	// Setup link back to inside volume
	self.ad_attachment.owner = self;
	self.ad_attachment.ad_classtype = ad_CT_CONTROL;
	self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	self.ad_attachment.solid = ad_SOLID_NOT;
	
	// Setup controller above model origin location
	self.oldorigin = ad_bmodel_origin(self);
	setorigin(self.ad_attachment, self.oldorigin + '0 0 32');
	setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	
	// Start controller think loop
	self.ad_attachment.think = ad_func_insvolume_controller_think;
	self.ad_attachment.nextthink = time + 0.1 + self.delay;
};

//======================================================================
void() ad_func_insidevolume =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors

	// No trigger/movement angles
	self.angles = '0 0 0'; self.movedir = '0 0 0';

	self.ad_classtype = ad_CT_FUNCINSVOLUME;
	self.ad_nodebuginfo = ad_TRUE;
	
	// Setup like a trigger in the map
	ad_InitTrigger ();
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	
	// Work out actual world origin coordinates
	self.pos1 = self.size * 0.5;
	self.pos2 = ad_bmodel_origin(self);
	
	// Setup trigger boundary edges
	self.dest1 = self.pos2 - self.pos1;
	self.dest2 = self.pos2 + self.pos1;
	
	// Block all trigger extra parameters (not needed)
	self.health = self.max_health = 0;
	self.takedamage = ad_DAMAGE_NO;
	if (self.delay < 0) self.delay = 0;
	
	// Reset all touch entities to monitor
	self.ad_tno1 = self.ad_tno2 = self.ad_tno3 = self.ad_tno4 = self.ad_tno5 = world;

	// Check for spawning conditions (nightmare, coop)
	// Needs to exist after entity has been added to work for BSPorigin
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_func_insvolume_on;
	self.ad_estate_off = ad_func_insvolume_off;
	self.touch = ad_func_insvolume_touch;
	
	// Check for starting off or default=on
	if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
	else self.ad_estate_on();
	
	// Setup volume controller (tests volumes)
	self.think = ad_func_insvolume_controller_setup;
	self.nextthink = time + 0.2;	
};
