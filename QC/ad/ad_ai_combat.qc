// AD's readme and docs/vr-port/CREDITS.md), my_progs/ai_combat.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 COMBAT FUNCTIONS

 Returns true if the inflictor can directly damage the target.  
 Used for explosions and melee attacks.
======================================================================*/
void(entity ad_targ, entity ad_attacker) ad_ClientObituary;

//-----------------------------------------------------------
float(entity ad_targ, entity ad_inflictor) ad_CanDamage =
{
	// Any entity marked with no damage is automatically excluded
	if (ad_targ.takedamage == ad_DAMAGE_NO) return ad_FALSE;
	
	// bmodels need special checking because their origin is 0,0,0
	// Not all bmodels use push movetype, use bsporigin instead
	//	if (targ.movetype == MOVETYPE_PUSH) {
	if (ad_targ.ad_bsporigin == ad_TRUE) {
		traceline(ad_inflictor.origin, 0.5 * (ad_targ.absmin + ad_targ.absmax), ad_TRUE, ad_inflictor);
		if (trace_fraction == 1) return ad_TRUE;
		if (trace_ent == ad_targ) return ad_TRUE;
		return ad_FALSE;
	}
	
	// Trace around the target to see if it can hit
	traceline(ad_inflictor.origin, ad_targ.origin, ad_TRUE, ad_inflictor);
	if (trace_fraction == 1) return ad_TRUE;
	traceline(ad_inflictor.origin, ad_targ.origin + '15 15 0', ad_TRUE, ad_inflictor);
	if (trace_fraction == 1) return ad_TRUE;
	traceline(ad_inflictor.origin, ad_targ.origin + '-15 -15 0', ad_TRUE, ad_inflictor);
	if (trace_fraction == 1) return ad_TRUE;
	traceline(ad_inflictor.origin, ad_targ.origin + '-15 15 0', ad_TRUE, ad_inflictor);
	if (trace_fraction == 1) return ad_TRUE;
	traceline(ad_inflictor.origin, ad_targ.origin + '15 -15 0', ad_TRUE, ad_inflictor);
	if (trace_fraction == 1) return ad_TRUE;

	return ad_FALSE;
};

//-----------------------------------------------------------
void(entity ad_targ, entity ad_attacker) ad_Killed =
{
	local entity ad_oself;

	// Switch self for death functions
	ad_oself = self; self = ad_targ;
	self.ad_activate = ad_attacker;		// Always keep track of what did damage

	// func bmodels, triggers, breakables etc
	// Horrible hack for pushables; They switch movetype, hard to catch
	if (self.movetype == ad_MOVETYPE_PUSH || (self.movetype == ad_MOVETYPE_NONE && !(self.flags & ad_FL_MONSTER)) ||
		self.ad_classtype == ad_CT_FUNCPUSHABLE) {	
		self.ad_th_die ();
	}
	else {
		if (!self.deadflag && (self.flags & ad_FL_MONSTER || self.flags & ad_FL_CLIENT) ) {
			// Object is dying, stop re-triggering
			self.deadflag = ad_DEAD_DYING;
			self.enemy = ad_attacker;	// Enemy dealing final blow
			if (self.enemy.ad_classtype == ad_CT_WORLD) self.enemy = self;
		
			// bump the monster counter
			if (self.flags & ad_FL_MONSTER) {
				// If a monster marked with no monster count dies
				// update HUD totals to reflect death properly
				if (self.ad_nomonstercount) {
					total_monsters = total_monsters + 1;
					ad_update_hud_totals(ad_HUD_MONSTERS);
				}	
				// Update global monster death totals
				killed_monsters = killed_monsters + 1;
				WriteByte (ad_MSG_ALL, ad_SVC_KILLEDMONSTER);
			}
		
			ad_ClientObituary(self, ad_attacker);
			self.touch = ad_SUB_Null;
	
			if (self.flags & ad_FL_MONSTER) ad_monster_death_use();
			VR_AD_Dying(ad_attacker);
			self.ad_th_die ();
			VR_AD_Died();
		}
		// Completely fuckup setup for the oldone boss with a weird target
		// field and mess of triggers around it! This elseif is just an
		// exception so it works, anyway no one fights the oldone!
		else if (!self.deadflag && self.ad_classtype == ad_CT_MONIDSHUB) {
			self.deadflag = ad_DEAD_DEAD;
			killed_monsters = killed_monsters + 1;
			WriteByte (ad_MSG_ALL, ad_SVC_KILLEDMONSTER);
			self.ad_th_die ();
		}
	}		
	// Restore self
	self = ad_oself;
};

/*======================================================================
 T_Damage
  The damage is coming from inflictor, but get mad at attacker
	This should be the only function that ever reduces health.
	Parameters:
	targ = entity receiving damage (monster)
	inflictor = entity causing damage (bullets)
	attacker = parent entity of inflictor (player firing bullets)
	damage = quantity (before modifiers, quad etc)
	checkarmor = can bypass armour (DAMARMOR, NOARMOR, DAMSPLASH)
	DAMARMOR    - Typical damage to health + armour
	NOARMOR     - Ingnores armour for damage reduction
	DAMSPLASH   - Splash damage only
======================================================================*/
void(entity ad_targ, entity ad_inflictor, entity ad_attacker, float ad_damage, float ad_checkarmor) ad_T_Damage =
{
	local vector ad_dir;
	local entity ad_oldself;
	local float ad_save, ad_take, ad_flinch, ad_noarmordmg;
	if (VR_AD_DamageOurs(ad_targ, ad_inflictor, ad_attacker, ad_damage, ad_checkarmor)) return;

	// Cannot hurt the world or enemy targets (fake flying markers)
	if (ad_targ.ad_classtype == ad_CT_WORLD) return;
	if (ad_targ.ad_classtype == ad_CT_ENEMYTARGET) return;

	// Is the monster dying and going through death animation?
	if (ad_targ.flags & ad_FL_MONSTER && ad_targ.health < 1) {
		if (ad_targ.health > ad_targ.ad_gibhealth) {
			// SSG projectiles need to do more damage (higher chance of gib)
			if (ad_inflictor.ad_classtype == ad_CT_PROJ_SSG) ad_take = 1 + random()*0.25;
			// Lowered the chance of extra gibs from other weapons
			// way to much gibbing was happening to all monsters
			else ad_take = 1;
			
			// Keep taking health off after death
			ad_targ.health = ad_targ.health - (ceil(ad_damage)*ad_take);
		}
		return;
	}

	// If target cannot take damage, no point doing damage
	if (ad_targ.takedamage == ad_DAMAGE_NO) return;
	
	// Check for breakable/pushables being immune to monster damage
	// This check is present in all projectiles functions instead
	// Its not really necessary here because its about monsters
	// if (ai_immunebreakable(attacker, targ)) return;
	
	// used by buttons and triggers to set activator for target firing
	ad_damage_attacker = ad_attacker;

	// check for quad damage powerup on the attacker
	if (ad_attacker.super_damage_finished > 0) ad_damage = ceil(ad_damage * 4);

	// co-op team play damage avoidance
	if ( (teamplay == 1) && (ad_targ.team > 0) && (ad_targ.team == ad_attacker.team) ) return;

	// Poor zombies, they have so many exceptional ways to die!
	if (ad_targ.ad_classgroup == ad_CG_ZOMBIE) {
		// If a zombie falls into slime or lava, instant death
		if (ad_targ.watertype == ad_CONTENT_SLIME || ad_targ.watertype == ad_CONTENT_LAVA) {
			// gib health is usually negative, hence the fabs
			ad_damage = fabs(ad_targ.ad_gibhealth * 4);
			//dprint("\b[T_DAMAGE]\b Instant death, in slime or lava\n");
		}
		// Exploding boils always destroy zombies
		if (ad_attacker.ad_classtype == ad_CT_MONBOIL) ad_damage = fabs(ad_targ.ad_gibhealth * 2);
	}
	
	// Are monsters infighting and is there a damage modifier active?
	if (ad_attacker.ad_infightextra && ad_targ.flags & ad_FL_MONSTER)
		ad_damage = ceil(ad_damage * ad_attacker.ad_infightextra);

	//----------------------------------------------------------------------
	// Check for plasma burn/explosion on fatal hit
	if (ad_inflictor.ad_classtype == ad_CT_PROJ_PLASMA && ad_attacker.flags & ad_FL_CLIENT) {
		if ((ad_targ.health-ad_damage < 0) && ad_attacker.ad_plasma_burn < time && random() < 0.2) {
			// Stop the plasma burn effect not happening alot at once
			ad_attacker.ad_plasma_burn = time + 4 + random()*4;
			// Don't add anymore damage if quad active
			if (ad_attacker.super_damage_finished == 0) 
				ad_damage = (ad_targ.health - ad_targ.ad_gibhealth);
			// Big blue sprite explosion + particles
			ad_particle_explode(ad_targ.origin-'0 0 16', 50+random()*50, 2, ad_PARTICLE_BURST_BLUE, ad_PARTICLE_BURST_UPWARD);
			ad_SpawnExplosion(ad_EXPLODE_PLASMA_BIG, ad_inflictor.origin+'0 0 8', ad_SOUND_REXP3);
		}
	}
	
	//----------------------------------------------------------------------
	// Check for monster/breakable extra damage key condition
	// The key is usually checked with ai_damagebreakable function
	// Needs to be checked with projectiles as well
	if (ad_targ.ad_classgroup == ad_CG_BREAKABLE && ad_attacker.flags & ad_FL_MONSTER) {
		if (ad_targ.ad_brkmondmg > 0) ad_damage = ceil(ad_damage + ad_targ.ad_brkmondmg);
	}
	
	// Blast Belt resistance prevents armour being decreased
	if (ad_checkarmor == ad_DAMSPLASH && ad_targ.flags & ad_FL_CLIENT 
		&& ad_targ.ad_moditems & ad_IT_ARTBLASTBELT) ad_noarmordmg = ad_TRUE;
	// Default for any kind of damage through this function
	else ad_noarmordmg = ad_FALSE;

	//----------------------------------------------------------------------
	// Special artifact combo setups for extra abilities 
	//----------------------------------------------------------------------
	// Blast Belt + Quad reduces incoming damage by 50%
	if (ad_targ.flags & ad_FL_CLIENT && ad_targ.ad_moditems & ad_IT_ARTBLASTBELT
		&& ad_targ.items & ad_IT_QUAD) ad_damage = ceil(ad_damage * 0.5);

	// Lava Shield + Pentagram prevents armour from being damaged
	if (ad_targ.flags & ad_FL_CLIENT && ad_targ.ad_moditems & ad_IT_ARTLAVASHIELD
		&& ad_targ.items & ad_IT_INVULNERABILITY) ad_noarmordmg = ad_TRUE;

	//----------------------------------------------------------------------
	// Work out damage reduction based on armor level
	// This is why the pentagram of protection loses armour
	//----------------------------------------------------------------------
	ad_save = 0;
	if (ad_checkarmor == ad_DAMARMOR || ad_checkarmor == ad_DAMSPLASH) {
		ad_save = ceil(ad_targ.armortype*ad_damage);
		// Run out of amour?
		if (ad_save >= ad_targ.armorvalue) {
			// Use remaining armour
			ad_save = ad_targ.armorvalue;
			// If no armour block, remove armour
			if (ad_noarmordmg == ad_FALSE) {
				ad_targ.armortype = 0;	// lost all armor
				ad_targ.items = ad_targ.items - (ad_targ.items & (ad_IT_ARMOR1 | ad_IT_ARMOR2 | ad_IT_ARMOR3));
			}
		}
		// Reduce armour based on save forumla above
		if (ad_noarmordmg == ad_FALSE) ad_targ.armorvalue = ad_targ.armorvalue - ad_save;
		// CEIL function will round up any fractional damage
		// TBH it is better to round up than round down
		ad_take = ceil(ad_damage-ad_save);
	}
	else ad_take = ad_damage;

	//----------------------------------------------------------------------
	// add to the damage total for clients, which will be sent as a single
	// message at the end of the frame
	// FIXME: remove after combining shotgun blasts?
	//----------------------------------------------------------------------
	if (ad_targ.flags & ad_FL_CLIENT) {
		ad_targ.dmg_take = ad_targ.dmg_take + ad_take;
		ad_targ.dmg_save = ad_targ.dmg_save + ad_save;
		ad_targ.dmg_inflictor = ad_inflictor;
	}

	// figure momentum add
	// This is what gives Rocket Jumps its Velocity!
	if ( (ad_inflictor != world) && (ad_targ.movetype == ad_MOVETYPE_WALK) ) {
		ad_dir = ad_targ.origin - (ad_inflictor.absmin + ad_inflictor.absmax) * 0.5;
		ad_dir = normalize(ad_dir);
		ad_targ.velocity = ad_targ.velocity + ad_dir*ad_damage*8;
	}

	// Check for Blast Belt 100% splashdamage resistance
	if (ad_checkarmor == ad_DAMSPLASH && ad_targ.flags & ad_FL_CLIENT 
		&& ad_targ.ad_moditems & ad_IT_ARTBLASTBELT) {
		ad_PlayBlastBeltSound(ad_targ);
		return;
	}

	// check for godmode or pentagram / invincibility
	if (ad_targ.flags & ad_FL_GODMODE || ad_targ.ad_invincible_finished >= time) {
		ad_PlayPentagramSound(ad_targ);
		return;
	}
	
	//----------------------------------------------------------------------
	// do the damage
	//----------------------------------------------------------------------
	VR_AD_KdSave(ad_targ, ad_inflictor);
	ad_targ.health = ad_targ.health - ad_take;
	VR_AD_Splash(ad_checkarmor == ad_DAMSPLASH);
	VR_AD_Hit(ad_targ, ad_inflictor, ad_attacker, ad_take);
	VR_AD_Splash(0);
	
	//----------------------------------------------------------------------
	// Changed the turret code to allow for monster % HP triggers
	// The turret movespeed is no longer a pre-condition
	// Can have trigger events for larger HP monsters like shamblers
	// Greater opportunity to keep the pacing insync with the player
	// With any monster having this trigger, need a check for bosses
	//
	// Check monster turret is to be released based on % health
	// Fire any targets (once only) when this condition is met
	//----------------------------------------------------------------------
	if (ad_targ.ad_turrethealth > 0) {
		// Warning/reset about trying to % HP trigger a boss monster
		if (ad_targ.ad_bossflag > 0) {
			dprint("\b[MONSTER]\b Cannot add HP triggers to bosses!\n");
			ad_targ.ad_turrethealth = ad_targ.ad_turrethealth2 = 0;
			ad_targ.ad_turrettarget = ad_targ.ad_turrettarget2 = "";
		}
		// HP % trigger's only work for monsters
		else if (ad_targ.flags & ad_FL_MONSTER) {
			// Check if HP % trigger should happen? (less than = event)
			if (ad_targ.health < (ad_targ.max_health * ad_targ.ad_turrethealth)) {
				// Trigger HP debug info (developer 1 mode)
				dprint("Target ("); dprint(ad_targ.classname);
				dprint(") HP ("); dprint(ftos(ad_targ.health));
				dprint(") % ("); dprint(ftos(ad_targ.ad_turrethealth));
				dprint(") Trig ("); dprint(ad_targ.ad_turrettarget);
				dprint(")\n");
				// Fire all targets if string exists
				if (ad_targ.ad_turrettarget != "") ad_trigger_strs(ad_targ.ad_turrettarget, ad_attacker);
				// Release turret, free movement
				if (ad_targ.ad_movespeed < 0) ad_targ.ad_movespeed = 1;
				
				// Is there a second HP % event?
				if (ad_targ.ad_turrethealth2 > 0) {
					if (ad_targ.ad_turrethealth2 >= ad_targ.ad_turrethealth) {
						dprint("\b[MONSTER]\b Second HP % trigger high than first!\n");
						// Reset health + target fields
						ad_targ.ad_turrethealth = ad_targ.ad_turrethealth2 = 0;
						ad_targ.ad_turrettarget = ad_targ.ad_turrettarget2 = "";
					}
					else {
						// Copy over targets
						ad_targ.ad_turrethealth = ad_targ.ad_turrethealth2;
						ad_targ.ad_turrettarget = ad_targ.ad_turrettarget2;
						ad_targ.ad_turrethealth2 = 0; // Reset					
					}
				}
				else {
					// Reset health + target fields
					ad_targ.ad_turrethealth = 0;
					ad_targ.ad_turrettarget = "";
				}
			}
		}
	}

	//----------------------------------------------------------------------
	// When the SG projectile system is active each monster needs to keep
	// track of cumulative damage so that pain flinches work correctly
	// AmmoShells classgroup is only active when SG projectiles are fired
	//----------------------------------------------------------------------
		// Is the Shotguns projectile system active?
	if (ad_inflictor.ad_classgroup == ad_CG_PROJSHELLS) {
		// Does the frame damage acculator need to be reset?
		if (ad_targ.ad_dmgtimeframe <= time) {
			ad_targ.ad_dmgtimeframe = time + 0.1;
			ad_targ.ad_dmgcombined = 0;
		}
		// Accumulate damage until next fromae
		ad_targ.ad_dmgcombined = ad_targ.ad_dmgcombined + ad_take;
	}
	
	//----------------------------------------------------------------------
	// When the SG projectile system is active ZOMBIES need to know if
	// there has been enough damage over a single frame to die or not
	// AmmoShells classgroup is only active when SG projectiles are fired
	//----------------------------------------------------------------------
	if (ad_targ.ad_classgroup == ad_CG_ZOMBIE) {
		// Zombies MUST ALWAYS RUN their pain function!?!
		self.ad_pain_finished = 0;
		// Horrible Hack - Launch_Bullet sets the weapon flag on projectiles
		// Only register damage against zombies if SSG upgrade or Quad!
		if (ad_inflictor.ad_classgroup == ad_CG_PROJSHELLS && ad_inflictor.weapon) {
			// Has the accumulator gone over the max health?
			if (ad_targ.ad_dmgcombined > ad_targ.max_health) {
				ad_targ.health = ad_targ.ad_gibhealth;
			}
		}
	}

	/*----------------------------------------------------------------------
	// Axe upgrade will gib enemies if they are killed with the axe
	// A bit excessive on the gibbing, disabled for the moment
	if (attacker.moditems & IT_SHADAXE && attacker.weapon == IT_AXE) {
		if (targ.health < 1 && targ.gibhealth) targ.health = targ.gibhealth;
	} */

	//----------------------------------------------------------------------
	// Has the monster died?
	//----------------------------------------------------------------------
	if (ad_targ.health < 1) {
		ad_Killed (ad_targ, ad_attacker);
		return;
	}
	
	//----------------------------------------------------------------------
	// Switch self (foundtarget and pain function need self correct)
	// self restored before end of function
	ad_oldself = self;
	self = ad_targ;
	//----------------------------------------------------------------------
	// react to the damage - only if a monster
	// No reaction if attacker is world (env trap, door, etc) 
	//----------------------------------------------------------------------
	if ( (self.flags & ad_FL_MONSTER) && ad_attacker != world) {
		// Is the current attacker not self and not current enemy target?
		if (self != ad_attacker && ad_attacker != ad_SUB_entEnemyTarget()) {
			if ( self.ad_noinfighting == ad_TRUE && ad_attacker.flags & ad_FL_MONSTER 
				|| ad_attacker.ad_noinfighting == ad_TRUE) {
				// Prevent monsters from infighting
				// but let them react to the player
			}
			else {
				// If previous switch target dead, focus on new target
				if (self.ad_switchattacker.health < 1) self.ad_switchtimer = 0;
				// Is the attacker a different classgroup and switching target available?
				if ( self.ad_classgroup != ad_attacker.ad_classgroup && self.ad_switchtimer < time) {
					// Prevent the monster from rapidily switching targets
					if (self.ad_switchattacker != ad_attacker) self.ad_switchtimer = time + self.ad_switchoverride;
					else self.ad_switchtimer = time + ( (self.ad_switchoverride + random()) * 0.5);
					// Switch to new target
					self.ad_switchattacker = ad_attacker;

					// Shift previous enemy to old enemy ready for new target
					// Only switch if the new enemy is the player! (id logic)
					// Check for new enemy target system before switching
					if (ad_SUB_flagsEnemyTarget(ad_FL_CLIENT)) self.ad_oldenemy = ad_SUB_entEnemyTarget();
					if (self.enemy.ad_classtype == ad_CT_ENEMYTARGET) ad_SUB_switchEnemyTarget();
					self.enemy = ad_attacker;		// attack the attacker!
					ad_FoundTarget ();				// Run+turn towards new enemy
				}
			}
		}
	}
	self = ad_oldself;

	if (VR_AD_PainDown(ad_targ)) return;
	//----------------------------------------------------------------------
	// Check for ammo type resistance and immunity to pain
	// Targetdummies rely on the pain function to display stats
	if (ad_targ.ad_classtype != ad_CT_TARGETDUMMY) {
		if (ad_targ.ad_resist_shells > 0 && ad_inflictor.ad_classgroup == ad_CG_PROJSHELLS) return;
		else if (ad_targ.ad_resist_nails > 0 && ad_inflictor.ad_classgroup == ad_CG_PROJNAILS) return;
		// Rocket ammo resistance needs to cope with grenades and rockets (+homing)
		else if (ad_targ.ad_resist_rockets > 0 && ad_inflictor.ad_classgroup == ad_CG_PROJROCKETS) return;
		else if (ad_targ.ad_resist_rockets > 0 && ad_inflictor.ad_classgroup == ad_CG_PROJGRENADES) return;
		else if (ad_targ.ad_resist_cells > 0 && ad_inflictor.ad_classgroup == ad_CG_PROJCELLS) return;
	}
	
	//----------------------------------------------------------------------
	// Switch self (foundtarget and pain function need self correct)
	// self restored before end of function
	ad_oldself = self;
	self = ad_targ;
	//----------------------------------------------------------------------

	if (self.ad_th_pain && self.ad_pain_finished < time) {
		// Save pain finished state for later		
		self.ad_pain_finstate = self.ad_pain_finished;

		// The damage from projectile shotguns trinkle at the monster
		// which means it cannot trigger the flinch function
		// Let the combined damage over 1 frame accumulate first
		// Exception - Zombies don't flinch, they must run pain function
		if (ad_inflictor.ad_classgroup == ad_CG_PROJSHELLS && ad_targ.ad_classgroup != ad_CG_ZOMBIE) {
			// Demon, Shambler, Shalrath and Wizard all have high flinch values
			if (self.ad_pain_flinch > 40) ad_flinch = 40;
			else ad_flinch = self.ad_pain_flinch + 1;
			if (self.ad_dmgcombined < ad_flinch) {self = ad_oldself; return;}
		}

		// Block pain re-trigger event
		self.ad_pain_finished = time + self.ad_pain_timeout;
		
		// Ignoring pain from other monsters? (infighting)
		if (self.ad_pain_ignore && ad_attacker.flags & ad_FL_MONSTER)
			self.ad_pain_finished = self.ad_pain_finished + 1 + random();
		else {
			// If accumulated pain is higher, use that instead
			// Added classgroup exception otherwise damage qty is wrong
			if (ad_inflictor.ad_classgroup == ad_CG_PROJSHELLS && ad_take < self.ad_dmgcombined)
				self.ad_th_pain (ad_inflictor, ad_attacker, self.ad_dmgcombined);
			else self.ad_th_pain (ad_inflictor, ad_attacker, ad_take);
	
			// nightmare mode monsters don't go into pain frames often
			if (ad_skill == ad_SKILL_NIGHTMARE && ad_targ.ad_classgroup != ad_CG_ZOMBIE) self.ad_pain_finished = time + 5;

			// Exceptions to pain not being blocked (even nightmare!)
			// If the monster is in slime or lava always go into pain
			if (self.watertype == ad_CONTENT_SLIME || self.watertype == ad_CONTENT_LAVA)
				self.ad_pain_finished = time + 0.3;
		}
	}
	self = ad_oldself;
};

/*======================================================================
	T_RadiusDamage
	
	inflictor -(self) = projectile
	attacker - (self.owner) = monster/player OR (self) = direct attack
	ignore   - (other) = Original target OR (world) = no exceptions
======================================================================*/
void(entity ad_inflictor, entity ad_attacker, float ad_damage, entity ad_ignore, float ad_checkclass) ad_T_RadiusDamage =
{
	local	float 	ad_points;
	local	entity	ad_head;
	local	vector	ad_org, ad_imporg;

	// Cannot hurt the world or enemy targets (fake flying markers)
	if (ad_attacker.ad_noradiusdmg) return;
	if (ad_attacker.ad_classtype == ad_CT_WORLD) return;
	if (ad_attacker.ad_classtype == ad_CT_ENEMYTARGET) return;

	// check if inflictor is a bmodel (different origin location)
	if (ad_inflictor.ad_bsporigin) ad_imporg = ad_bmodel_origin(ad_inflictor);
	else ad_imporg = ad_inflictor.origin;
		
	ad_head = findradius(ad_imporg, ad_damage+40);
	
	while (ad_head) {
		if (ad_head != ad_ignore) {
			// This is used mostly for wraiths so when they die they don't
			// kill each other, can't get the code logic to work so its
			// setup as a dead exception path
			if (ad_checkclass == ad_IGNORECLASS && ad_head.ad_classtype == ad_ignore.ad_classtype) { }
			else {
				// Check for breakable/pushable monster immunity
				// Do nothing, radius damage has no miss effect
				if (ad_ai_immunebreakable(ad_attacker, ad_head)) {
				}
				// Check for any breakables which are prone to explosive damage
				else if (ad_ai_foundbreakable(ad_attacker, ad_head,ad_TRUE) && ad_head.ad_brktrigmissile !=0) {
					ad_trigger_ent(ad_head, ad_attacker);
				}
				else {
					// Can be damaged and NOT immune to radius (splash) damage
					if (ad_head.takedamage > 0 && ad_head.ad_noradiusdmg == 0) {
						// This formula is using bounding box size which means
						// the damage amount is lower if the monster is larger
						// It should really be based on bounding box edge
						// not monster origin
						ad_org = ad_head.origin + (ad_head.mins + ad_head.maxs)*0.5;
						ad_points = 0.5*vlen (ad_imporg - ad_org);
						if (ad_points < 0) ad_points = 0;
						ad_points = ad_damage - ad_points;
						
						// Half damage if caught by own explosion
						if (ad_head == ad_attacker) ad_points = ad_points * 0.5;

						if (ad_points > 0 && ad_head.health > 0) {
							// Need CanDamage to check for anything blocking LoS
							// It will do several traces (source->target) to check
							// for any blocking entities (lifts, doors, walls etc)
							if (ad_CanDamage (ad_head, ad_inflictor)) {
								// Two types of splash damage (rocket / cell)
								if (ad_inflictor.ad_classgroup == ad_CG_PROJCELLS) {
									// Does target have cell resistance?
									if (ad_head.ad_resist_cells != 0)
										ad_points = ad_Resist_Damage(ad_head, ad_IT_CELLS, ad_points);
								}
								else {
									// Does target have rocket resistance?
									if (ad_head.ad_resist_rockets != 0)
										ad_points = ad_Resist_Damage(ad_head, ad_IT_ROCKETS, ad_points);
								}

								// Zombies should really be blown from explosives
								// especially from ogre grenades right under their feet
								// Check for glancing damage or if too far away
								if (ad_head.ad_classgroup == ad_CG_ZOMBIE && ad_points > (ad_head.health*0.25))
									ad_points = ad_DAMAGE_ZOMBIECLASS;
								// Any damage left? Check for poison as well
								if (ad_points > 0) ad_T_Damage (ad_head, ad_inflictor, ad_attacker, ad_points, ad_DAMSPLASH);
								if (ad_attacker.ad_poisonous) ad_PoisonDeBuff(ad_head);
							}
						}
					}
				}
			}
		}
		ad_head = ad_head.chain;
	}
};

/*======================================================================
	T_BeamDamage (never used, leftover dev crap!)
======================================================================
void(entity attacker, float damage) T_BeamDamage =
{
	local float points;
	local entity head;
	
	// Cannot hurt the world or enemy targets (fake flying markers)
	if (attacker.classtype == CT_WORLD) return;
	if (attacker.classtype == CT_ENEMYTARGET) return;

	head = findradius(attacker.origin, damage+40);
	
	while (head) {
		if (head.takedamage) {
			points = 0.5*vlen (attacker.origin - head.origin);
			if (points < 0) points = 0;
			points = damage - points;
			if (head == attacker) points = points * 0.5;
			if (points > 0) {
				if (CanDamage (head, attacker)) {
					if (head.resist_rockets > 0) 
						points = points * head.resist_rockets;
					T_Damage (head, attacker, attacker, points,DAMARMOR);
				}
			}
		}
		head = head.chain;
	}
}; */

