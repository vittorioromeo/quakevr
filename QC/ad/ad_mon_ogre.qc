//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_ogre_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			self.lip = random();
			if (self.lip < 0.25) ad_ogre_pain1 ();
			else if (self.lip < 0.5) ad_ogre_painb1 ();
			else if (self.lip < 0.75) ad_ogre_painc1 ();
			else if (self.lip < 0.88) {
				// Fall down to the ground
				ad_ogre_paind1 ();
				self.ad_pain_finished = time + 2;
			}
			else {
				// Stagger backwards
				ad_ogre_paine1 ();
				self.ad_pain_finished = time + 2;
			}
		}
		if (self.ad_pain_check == 2) {
			self.ad_axhitme = 0;
			if (random() < 0.5) {
				self.ad_pain_finished = time + 1.6;
				ad_ogre_paind1 ();	// Fall to ground
			}
			else {
				self.ad_pain_finished = time + 1.5;
				ad_ogre_paine1 ();	// Stagger backwards
			}
		}
	}
};

