void() ad_ogre_melee =
{
	sound (self, ad_CHAN_WEAPON, "ogre/ogsawatk.wav", 1, ad_ATTN_NORM);
	if (random() > 0.5) ad_ogre_smash1 ();
	else ad_ogre_swing1 ();
};

/*======================================================================
 Range - Grenades (uses generic attack function in projectiles.qc)
 Nail - Alternative firemode (based on nail ogre from Marcher Fortress)
======================================================================*/
void() ad_OgreFireNails =
{
	if (VR_AimCone_Wait(ad_OgreFireNails, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_org, ad_dir, ad_vec;
	local float ad_loopvar;
	
	// Check for death?
	if (self.health < 1) return;
	ad_loopvar = 0;

	// Light up face, setup projectile speed and play fire sound
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_NAILOGREPROJ + (ad_skill * ad_SPEED_NAILOGRESKILL);
	sound(self, ad_CHAN_WEAPON, "ogre/nail_fire.wav", 1, ad_ATTN_NORM);

	// turn and face your enemy!
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	
	// Loop through the nail burst (all at once)
	while (ad_loopvar < self.ad_attack_count) {
		// Random circle spread pattern
		ad_vec = (ad_crandom()*20)*v_right + (ad_crandom()*20)*v_up;
		ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
		// Generate a red hot nail projectile
		ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_MONNG, self.ad_attack_speed);
		ad_loopvar = ad_loopvar + 1;
	}
};

