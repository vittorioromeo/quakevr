/*======================================================================
 MELEE - Chainsaw
======================================================================*/
void(float ad_side, float ad_dmgmultipler) ad_chainsaw =
{
	local float ad_ldmg;
	
	if (!self.enemy) return;
	if (self.health < 1) return;

	ad_ai_damagebreakable(20);							// Damage any breakables
	if (!(ad_ai_checkmelee(self.ad_meleerange,ad_FALSE) && VR_MeleeArc_Hits(!vr_melee_ahead))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed? - generate blood
	if (!ad_CanDamage (self.enemy, self)) return;
	
	// Damage 1-12
	ad_ldmg = (random() + random() + random()) * (4*ad_dmgmultipler);
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	ad_SpawnMeatSpray (self, self.enemy, ad_side);
};

