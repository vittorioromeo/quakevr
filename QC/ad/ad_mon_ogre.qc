void() ad_ogre_shoot1 =[ $shoot1, ad_ogre_shoot2 ] {
	ad_ai_face();
	ad_MonsterGrenadeSound(); 
	self.ad_attack_speed = ad_MonsterGrenadeSpeed();
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.enemy.origin, self.ad_attack_speed);
};
void() ad_ogre_shoot2 =[ $shoot2, ad_ogre_shoot3 ] {
	ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, self.ad_attack_speed);
};
void() ad_ogre_shoot3 =[ $shoot2, ad_ogre_shoot4 ] {
	ad_ai_face();
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, self.ad_attack_speed);
};
void() ad_ogre_shoot4 =[ $shoot3, ad_ogre_shoot5 ] {
	if (VR_AimCone_Wait(ad_ogre_shoot4, VR_AIM_WIDE)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	ad_ai_face();
	ad_MonsterFireGrenade(self.origin, self.enemy.origin);
};
void() ad_ogre_shoot5 =[ $shoot4, ad_ogre_shoot6 ] {};
