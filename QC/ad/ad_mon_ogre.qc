void()	ad_ogre_bdie3	=[	$bdeath3,	ad_ogre_bdie4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT; if (!self.ad_gibbed) ad_DropBackpack();};
void()	ad_ogre_bdie4	=[	$bdeath4,	ad_ogre_bdie5	] {ad_ai_forward(1);};
void()	ad_ogre_bdie5	=[	$bdeath5,	ad_ogre_bdie6	] {ad_ai_forward(3);};
void()	ad_ogre_bdie6	=[	$bdeath6,	ad_ogre_bdie7	] {ad_ai_forward(7);};
void()	ad_ogre_bdie7	=[	$bdeath7,	ad_ogre_bdie8	] {ad_ai_forward(25);};
void()	ad_ogre_bdie8	=[	$bdeath8,	ad_ogre_bdie9	] {};
void()	ad_ogre_bdie9	=[	$bdeath9,	ad_ogre_bdie10	] {ad_monster_death_postcheck();};
void()	ad_ogre_bdie10	=[	$bdeath10,	ad_ogre_bdie10	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_ogre_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		self.lip = random();
		if (self.lip < 0.5) ad_ogre_die1();
		else ad_ogre_bdie1();
	}
};

//----------------------------------------------------------------------
// Special wakeup animation for attacking/breaking something infront
// The monster should be setup facing the right direction before call
// Starts in large overhead swing downwards (no damage checks)
//----------------------------------------------------------------------
void() ad_ogre_wakeup1	=[	$smash7,	ad_ogre_wakeup2] {ad_monster_sightsound();};
void() ad_ogre_wakeup2	=[	$smash6,	ad_ogre_wakeup3] {};
void() ad_ogre_wakeup3	=[	$smash8,	ad_ogre_wakeup4] {};
void() ad_ogre_wakeup4	=[	$smash9,	ad_ogre_wakeup5 ] {};
void() ad_ogre_wakeup5	=[	$smash10,	ad_ogre_wakeup6 ] {};
void() ad_ogre_wakeup6	=[	$smash11,	ad_ogre_wakeup7 ] {};
void() ad_ogre_wakeup7	=[	$smash12,	ad_ogre_wakeup8 ] {};
void() ad_ogre_wakeup8	=[	$smash13,	ad_ogre_wakeup9 ] {};
void() ad_ogre_wakeup9	=[	$smash14,	ad_ogre_run1	] {};

//======================================================================
// Special wakeup animation for fishing ogre (re-using painD)
//======================================================================
void()	ad_ogre_fishd6	=[ $paind6,	ad_ogre_fishd7	] {};
void()	ad_ogre_fishd7	=[ $paind7,	ad_ogre_fishd8	] {};
void()	ad_ogre_fishd8	=[ $paind8,	ad_ogre_fishd9	] {};
void()	ad_ogre_fishd9	=[ $paind9,	ad_ogre_fishd10 ] {};
void()	ad_ogre_fishd10=[ $paind10, ad_ogre_fishd11 ] {ad_monster_footstep(ad_FALSE);};
void()	ad_ogre_fishd11=[ $paind11, ad_ogre_fishd12 ] {};
void()	ad_ogre_fishd12=[ $paind12, ad_ogre_fishd13 ] {ad_monster_footstep(ad_FALSE);};
void()	ad_ogre_fishd13=[ $paind13, ad_ogre_fishd14 ] {};
void()	ad_ogre_fishd14=[ $paind14, ad_ogre_fishd15 ] {};
void()	ad_ogre_fishd15=[ $paind15, ad_ogre_fishd16 ] {};
void()	ad_ogre_fishd16=[ $paind16, ad_ogre_run1 ] {
	// Restore pain/damage functionality
	self.flags = self.flags | ad_FL_MONSTER;
	self.health = self.max_health;
	
	// Fishing ogre is wearing a grenade bounce shirt!
	self.takedamage = ad_DAMAGE_YES;
	self.ad_noradiusdmg = ad_FALSE;
	self.use = ad_monster_use;
	
	// Does not feel much pain and attacks more often
	self.ad_pain_flinch = 200;
	self.ad_pain_timeout = 3;
	
	// Restore animation/game logic
	self.ad_th_stand = ad_ogre_stand1;
	self.ad_th_walk = ad_ogre_walk1;
	self.ad_th_run = ad_ogre_run1;
	self.ad_th_melee = ad_ogre_melee;
	self.ad_th_missile = ad_ogre_shoot1;
	self.ad_th_pain = ad_ogre_pain;
	self.ad_th_die = ad_ogre_die;
};
//----------------------------------------------------------------------
void() ad_ogre_fishwakeup = {
	self.use = ad_SUB_Null;	// Stop re-triggering
	ad_monster_sightsound();	// Classic wakeup sound

	// Make sure no more pain or damage
	self.takedamage = ad_DAMAGE_NO;
	self.ad_pain_finished = time + 2;
	
	// Check for model in original ogre position
	// This is to save the space for the returning ogre
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
	}
	
	// Check for any wakeup triggers
	if (self.ad_target2 != "") {
		ad_trigger_strs(self.ad_target2, self);
		self.ad_target2 = "";
	}
	
	// Shift ogre into pain (on floor) state
	setmodel(self, self.mdl);
	self.frame = $paind6;	// Has to be set after model change
	setorigin(self, self.pos1);
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	ad_ogre_fishd6();
};

/*======================================================================
 QUAKED monster_ogre (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_ogre_precache =
{
	self.mdl = "progs/mon_ogre.mdl";		// ID + Rogue Ogre
	self.ad_headmdl = "progs/h_ogre.mdl";
	self.ad_gib1mdl = "progs/w_chainsaw.mdl";	// Chainsaw
	self.ad_gib2mdl = "progs/gib_ogfoot1.mdl";	// Left foot
	self.ad_gib3mdl = "progs/gib_ogfoot2.mdl";	// Right foot
	self.ad_gib4mdl = "progs/w_ogregl.mdl";	// Grenade Launcher

	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_GRENADE);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);

	// Randomly swap in GL instead of Chainsaw
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	if (random() < 0.5) self.ad_gib1mdl = self.ad_gib4mdl; 
	self.ad_gib4mdl = "";

	self.ad_idle_sound = "ogre/ogidle.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_idle_soundcom = "ogre/ogidle2.wav";
	precache_sound (self.ad_idle_soundcom);

	self.ad_pain_sound = "ogre/ogpain1.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "ogre/ogdth.wav";
	precache_sound (self.ad_death_sound);
	
	precache_sound ("ogre/ogdrag.wav");
	precache_sound ("ogre/ogsawatk.wav");

	self.ad_sight_sound = "ogre/ogwake.wav";
	precache_sound (self.ad_sight_sound);

	// Load additional models/sounds for nail ogre
	if (self.spawnflags & ad_MON_OGRE_NAIL) {
		// Default attack - red glowing nails
		precache_model (ad_MODEL_PROJ_NGRED);
		precache_sound("ogre/nail_fire.wav");
		// Default amount of nails to burst fire (5x9=45dmg)
		if (self.ad_attack_count < 1) self.ad_attack_count = 5;
	}
	
	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_GRENADEGRN);
	}
};

//----------------------------------------------------------------------
void() ad_monster_ogre =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	// Precache basic ogre models and sounds
	ad_monster_ogre_precache();

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	// Original ID size -32 -32 -24, 32 32 64
	if (ad_CheckZeroVector(self.ad_idmins)) self.ad_idmins = ad_VEC_HULL2_MIN;
	if (ad_CheckZeroVector(self.ad_idmaxs)) self.ad_idmaxs = ad_VEC_HULL2_MAX;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	self.ad_gibhealth = -80;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 30;				// Low pain flinch
	self.ad_pain_longanim = ad_TRUE;			// Can be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPESLOW;		// Small sounding feet
	self.ad_attack_explosive = ad_TRUE;		// Has explosive attack
	self.ad_meleerange = ad_MONAI_MELEEOGRE;	// Chainsaw range
	self.ad_no_zaware = ad_TRUE;				// Always NOT zware
	self.ad_attack_offset = '24 0 20';		// Run + Gun vector
	self.ad_deathstring = " was destroyed by an Ogre\n";

	// Standard ogre health 200 with green+ option
	if (self.health < 1) self.health = ad_HP_MONOGRE;
	if (self.spawnflags & ad_MON_OGRE_GREEN) {
		self.health = self.health + ad_MON_OGRE_GRNUPG;
		self.skin = 1;
	}
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_OgreCheckAttack;
	self.ad_th_stand = ad_ogre_stand1;
	self.ad_th_walk = ad_ogre_walk1;
	self.ad_th_run = ad_ogre_run1;
	self.ad_th_melee = ad_ogre_melee;
	self.ad_th_missile = ad_ogre_shoot1;
	self.ad_th_pain = ad_ogre_pain;
	self.ad_th_die = ad_ogre_die;
	self.ad_th_wakeup = ad_ogre_wakeup1;
	
	// Switch attack types and ammo drops
	if (self.spawnflags & ad_MON_OGRE_NAIL) {
		if (self.ammo_nails < 0) self.ammo_nails = 0;
		else if (self.ammo_nails == 0) self.ammo_nails = 5;
		self.ad_th_missile = ad_ogre_nail1;
	}
	else {
		if (self.ammo_rockets < 0) self.ammo_rockets = 0;
		else if (self.ammo_rockets == 0) self.ammo_rockets = 2;
		self.ad_th_missile = ad_ogre_shoot1;
	}
		
	self.ad_classtype = ad_CT_MONOGRE;		// Old style ogre
	self.ad_classgroup = ad_CG_OGRE;			// One big happy ogre family!
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
};

//----------------------------------------------------------------------
void() ad_monster_ogre_marksman = { ad_monster_ogre (); };

//----------------------------------------------------------------------
// Re-direct Quoth - Nail Ogre
void() ad_monster_ogre_flak = { 
	self.spawnflags = self.spawnflags | ad_MON_OGRE_NAIL;
	ad_monster_ogre (); 
};
