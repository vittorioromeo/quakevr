// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/func_plats.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// PLATFORM FUNCTIONS
//======================================================================
float ad_PLAT_LOW_TRIGGER = 1;
float ad_PLAT_MIN_TRIGGER = 4;
float ad_PLAT_START_LOWER = 8;
float ad_PLAT_START_OPEN = 16;
float ad_PLAT_STARTDIS = 32;		// Platform starts in disabled state

//======================================================================
/*ad:QUAKED func_plat (0 .5 .8) ? LOW_TRIGGER x MIN_TRIGGER START_LOWER START_OPEN x STARTOFF x
A Platform (bmodel) with 2 states
-------- KEYS --------
targetname : = "" plat start low, != "" plat starts high and reqs trigger to work
if using entity state system set START_LOWER spawnflags to fix this problem
speed  : moving speed (def=150)
height : determines the distance to move, instead of bmodel bounds
sounds : 1=Base, 0 or 2=Medieval (def), 4=Silent, 5=Custom sounds
noise  : custom sound - moving (looping)
noise1 : custom sound - Stopped
volume : Volume for all custom sounds played (def=1, range=0-1)
_dirt       : -1 = will be excluded from dirtmapping
_minlight   : Minimum light level for any surface of the brush model
_mincolor   : Minimum light color for any surface (def='1 1 1' RGB)
_shadow     : Will cast shadows on other models and itself
_shadowself : Will cast shadows on itself
-------- SPAWNFLAGS --------
LOW_TRIGGER : touch trigger will not keep the platform at the top, will reset
MIN_TRIGGER : uses the min bounding box (instead of max) to calculate trigger
START_LOWER : will start the platform lower regardless of targetname
START_OPEN : Used for lighting issues, place at bottom position
STARTOFF : Starts off and waits for trigger
-------- NOTES --------
Platforms are always created in the upper position, so they can be lit better.
If targetname is defined the func_plat starts high and is locked until triggered
Once the func_plat has been triggered, it will become a normal platform.

======================================================================*/

void() ad_func_plat_hit_bottom =
{
	if (self.ad_estate == ad_ESTATE_OFF) return;
	self.state = ad_STATE_BOTTOM;
	sound (self, ad_CHAN_VOICE, self.noise1, self.volume, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
void() ad_func_plat_go_down =
{
	if (self.ad_estate == ad_ESTATE_OFF) return;
	self.state = ad_STATE_DOWN;
	sound (self, ad_CHAN_VOICE, self.noise, self.volume, ad_ATTN_NORM);
	ad_SUB_CalcMove (self.pos2, self.speed, ad_func_plat_hit_bottom);
};

//----------------------------------------------------------------------
void() ad_func_plat_hit_top =
{
	if (self.ad_estate == ad_ESTATE_OFF) return;
	self.state = ad_STATE_TOP;
	sound (self, ad_CHAN_VOICE, self.noise1, self.volume, ad_ATTN_NORM);
	self.think = ad_func_plat_go_down;
	self.nextthink = self.ltime + 3;
};

//----------------------------------------------------------------------
void() ad_func_plat_go_up =
{
	if (self.ad_estate == ad_ESTATE_OFF) return;
	self.state = ad_STATE_UP;
	sound (self, ad_CHAN_VOICE, self.noise, self.volume, ad_ATTN_NORM);
	ad_SUB_CalcMove (self.pos1, self.speed, ad_func_plat_hit_top);
};

//----------------------------------------------------------------------
void() ad_func_plat_trigger_touch =
{
	if (self.owner.ad_estate & ad_ESTATE_BLOCK) return;
	if (self.owner.state == ad_STATE_DISABLED) return;
	if (!(other.flags & ad_FL_CLIENT)) return;
	if (other.health <= 0) return;

	// Switch the platform entity
	self = self.owner;
	if (self.state == ad_STATE_BOTTOM) ad_func_plat_go_up ();
	else if (self.state == ad_STATE_TOP)
		self.nextthink = self.ltime + 1;	// delay going down
};

//----------------------------------------------------------------------
void() ad_func_plat_trigger_spawn =
{
	local entity ad_trigger;
	local vector ad_tmin, ad_tmax;

	ad_trigger = spawn();
	ad_trigger.owner = self;
	ad_trigger.touch = ad_func_plat_trigger_touch;
	ad_trigger.movetype = ad_MOVETYPE_NONE;
	ad_trigger.solid = ad_SOLID_TRIGGER;
	
	ad_tmin = self.mins + '25 25 0';
	ad_tmax = self.maxs - '25 25 -8';

	// The ID method is to take the maximum size of the platform
	// and subtract the height. This fails if the platform
	// is moving around a central height point. The Alternative
	// method uses the min bounding box value instead of max
	// This is not 100% capatible with id maps, so hence extra option!
	if (self.spawnflags & ad_PLAT_MIN_TRIGGER) ad_tmin_z = ad_tmin_z - (self.height + 8);
	else ad_tmin_z = ad_tmax_z - (self.pos1_z - self.pos2_z + 8);

	if (self.spawnflags & ad_PLAT_LOW_TRIGGER) ad_tmax_z = ad_tmin_z + 8;
	
	if (self.size_x <= 50) {
		ad_tmin_x = (self.mins_x + self.maxs_x) / 2;
		ad_tmax_x = ad_tmin_x + 1;
	}
	if (self.size_y <= 50) {
		ad_tmin_y = (self.mins_y + self.maxs_y) / 2;
		ad_tmax_y = ad_tmin_y + 1;
	}
	
	setsize (ad_trigger, ad_tmin, ad_tmax);
};

//----------------------------------------------------------------------
void() ad_func_plat_use =
{
	// Deal with START OFF functionality first
	if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_on();
	else {
		// Block USE functionality if state wrong
		if (self.ad_estate & ad_ESTATE_BLOCK) return;
		if (self.state == ad_STATE_DISABLED) ad_func_plat_go_down();
	}
};

//----------------------------------------------------------------------
void() ad_func_plat_on =
{
	// Stop re-triggering ON state
	if (self.ad_estate == ad_ESTATE_ON) return;

	// No longer need this spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_ENT_STARTOFF);
	
	self.ad_estate = ad_ESTATE_ON;
	self.movetype = ad_MOVETYPE_PUSH;
	self.solid = ad_SOLID_BSP;
	setmodel (self, self.mdl);

	if (self.state != ad_STATE_DISABLED) {
		// Reset health, state and frame back to default
		setorigin(self, self.pos2);
		self.state = ad_STATE_BOTTOM;
		self.think = ad_SUB_Null;
	}

	// If platform started disable, release to lower position
	if (self.spawnflags & ad_PLAT_STARTDIS) {
		// No longer need this spawnflag, remove it
		self.spawnflags = self.spawnflags - (self.spawnflags & ad_PLAT_STARTDIS);
		if (self.state == ad_STATE_DISABLED) ad_func_plat_go_down();
	}	
};

//----------------------------------------------------------------------
void() ad_func_plat_off =
{
	// Stop re-triggering OFF state
	if (self.ad_estate == ad_ESTATE_OFF) return;

	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel (self, "");
	
	// Stop all movement sounds
	sound (self, ad_CHAN_VOICE, ad_SOUND_EMPTY, self.volume, ad_ATTN_NORM);

	if (self.state != ad_STATE_DISABLED) {
		// Reset health, position and frame back to default
		setorigin(self, self.pos2);
		self.state = ad_STATE_BOTTOM;
		self.think = ad_SUB_Null;
	}
};

//----------------------------------------------------------------------
void() ad_func_plat_disable =
{
	// Lock platform in current location
	self.ad_estate = ad_ESTATE_DISABLE;
};

//----------------------------------------------------------------------
void() ad_func_plat_blocked =
{
	ad_T_Damage (other, self, self, 1, ad_DAMARMOR);
	
	if (self.state == ad_STATE_UP) ad_func_plat_go_down ();
	else if (self.state == ad_STATE_DOWN) ad_func_plat_go_up ();
};

//----------------------------------------------------------------------
void() ad_func_plat =
{
	if (ad_check_bmodel_keys()) return;	// Check for bmodel errors
	
	// default sound = medieval
	if (self.sounds == 0) self.sounds = 2;

	if (self.sounds == 1) {
		self.noise = "plats/plat1.wav";
		self.noise1 = "plats/plat2.wav";
	}
	else if (self.sounds == 2) {
		self.noise = "plats/medplat1.wav";
		self.noise1 = "plats/medplat2.wav";
	}
	else {
		// sounds 4 = silent, sounds 5 = custom
		if (self.noise == "" || self.sounds == 4) self.noise = ad_SOUND_EMPTY;
		if (self.noise1 == "" || self.sounds == 4) self.noise1 = ad_SOUND_EMPTY;
	}
	precache_sound (self.noise);
	precache_sound (self.noise1);
	ad_trigger_bmodel_volume(1);
	
	self.ad_classtype = ad_CT_FUNCPLAT;
	self.ad_classgroup = ad_CG_FUNCMOVER;
	self.ad_bsporigin = ad_TRUE;
	self.mdl = self.model;
	// angles has to be 0 0 0 otherwise brush model is twisted
	// save angles to mangle for use later by movement code
	self.mangle = self.angles;
	self.angles = '0 0 0';

	// This is not used anywhere, old code ideas from ID
	if (!self.t_length) self.t_length = 80;
	if (!self.t_width) self.t_width = 10;
	if (!self.speed) self.speed = 150;
	self.state = ad_STATE_BOTTOM;	// Default state (lower)

	self.solid = ad_SOLID_BSP;
	self.movetype = ad_MOVETYPE_PUSH;
	setorigin (self, self.origin);	
	setmodel (self, self.mdl);
	setsize (self, self.mins , self.maxs);

	// Check for any entity state setups (OFF/DISABLE)
	// Need targetname defined (can't active bmodel otherwise)
	if (self.targetname != "" && self.ad_estate > 0) {
		if (self.ad_estate == ad_ESTATE_OFF) 
			self.spawnflags = self.spawnflags | ad_ENT_STARTOFF;
		if (self.ad_estate == ad_ESTATE_DISABLE)
			self.spawnflags = self.spawnflags | ad_PLAT_STARTDIS;
	}
	// Default state
	else self.ad_estate = ad_ESTATE_ON;
	
	// Cannot have a platform start off or disabled
	// with no targetname, how can it be actived!?!
	if (self.spawnflags & ad_PLAT_STARTDIS && self.targetname == "") {
		dprint("\b[PLAT]\b Starting DISABLED with no targetname!\n");
		self.oldorigin = ad_bmodel_origin(self);
		ad_spawn_marker(self.oldorigin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}	
	if (self.spawnflags & ad_ENT_STARTOFF && self.targetname == "") {
		dprint("\b[PLAT]\b Starting OFF with no targetname!\n");
		self.oldorigin = ad_bmodel_origin(self);
		ad_spawn_marker(self.oldorigin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}	

	// Check for spawning conditions (nightmare, coop)
	// Needs to exist after entity has been added to work for BSPorigin
	if (ad_check_nightmare() == ad_TRUE) return;
	if (ad_check_coop() == ad_TRUE) return;
	
	// Move the platform up to open position (lighting issues)
	// Need to update mins/maxs so that spawn trigger is correct
	// otherwise it will be in original position and spawn low
	if (self.spawnflags & ad_PLAT_START_OPEN) {
		self.origin_z = self.origin_z + self.height;
		self.mins_z = self.mins_z + self.height;
		self.maxs_z = self.maxs_z + self.height;
	}

	// pos1 is the top position, pos2 is the bottom
	self.pos1 = self.pos2 = self.origin;
	// self.height cannot be a negative, min/maxs will be back-to-front
	if (self.height) self.pos2_z = self.origin_z - fabs(self.height);
	else self.pos2_z = self.origin_z - self.size_z + 8;

	// Setup touch trigger and block function
	ad_func_plat_trigger_spawn ();
	self.blocked = ad_func_plat_blocked;
	
	// Damn annoying that the targetname is being used like this because
	// there could have been a better way to do this type of functionality
	// == "" Platform starts in lower position (default)
	// != "" Platform starts in upper position and requires trigger to work
	//
	if (self.targetname != "" && !(self.spawnflags & ad_PLAT_START_LOWER) )
		self.state = ad_STATE_DISABLED;
	else setorigin (self, self.pos2);	// Start in lower position

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_func_plat_on;
	self.ad_estate_off = ad_func_plat_off;
	self.ad_estate_use = ad_func_plat_use;
	self.ad_estate_disable = ad_func_plat_disable;
	
	// Check for the easy way to start a platform disabled
	if (self.spawnflags & ad_PLAT_STARTDIS) self.ad_estate_disable();
	// Check for starting override for entity state
	else if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
	else self.ad_estate_on();
};

//----------------------------------------------------------------------
// Re-direction for map hacks (not used normally)
//----------------------------------------------------------------------
void() ad_plat_hit_bottom = { ad_func_plat_hit_bottom(); };
