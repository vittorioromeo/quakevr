/*======================================================================
 ZOMBIE PAIN
 * All damage must come through pain function to reset health
 * Be careful blocking zombie pain function with pain_finished
 * zombies react in 2 ways, minor pain (a,c,d) and full knockdown (b,e)
======================================================================*/
void(entity ad_inflictor, entity ad_attacker, float ad_take) ad_zombie_pain =
{
	// Is the zombie in the process of dying?
	if (self.deadflag > ad_DEAD_NO) return;
	// Always reset health
	self.health = self.max_health;

	// Check for invulnerability frames and shadow axe
	if (self.ad_inpain > 0 && self.ad_axhitme == 2) {
		self.ad_axhitme = 0;				// Reset axe
		self.health = self.ad_gibhealth;	// Reset Health
		ad_Killed (self, ad_attacker);		// Gib time
		return;
	}
	else self.ad_axhitme = 0;	// Reset axe

	//----------------------------------------------------------------------
	// Pain/damage too low OR down on ground, totally ignore
	//----------------------------------------------------------------------
	if (ad_take < ad_MONAI_ZOMBIELOW_DAM || self.ad_inpain == 2) return;

	//----------------------------------------------------------------------
	// Damage 29-60, drop straight away to ground (SSG, Quad NG)
	// This has to be a single large hit over 0.1 frame
	//----------------------------------------------------------------------
	if (ad_take > ad_MONAI_ZOMBIEHGH_DAM) {
		ad_zombie_paine1();
		return;
	}

	//----------------------------------------------------------------------
	// Projectile shotguns pellets don't all hit at same time
	// they accumulate over time and can distort damage values
	// Need to block damage over time to detect second hit
	// Cannot use pain_finished because it blocks the pain function
	// and the health needs to be reset all the time
	// Using 'lefty' because zombies don't use it for anything
	if (self.lefty < time && self.ad_inpain == 1) {
		// Second hit, drop to ground
		ad_zombie_paine1 ();
		return;
	}

	//----------------------------------------------------------------------
	// Damage 9-25 random pain animation (random chance of knockdown painb)
	//----------------------------------------------------------------------
	if (self.ad_inpain) return;	// Already in minor pain
	self.ad_inpain = 1;			// Minor pain active
	self.lefty = time + 0.5;	// Wait for second hit
	self.lip = random();
	if (self.lip < 0.25) ad_zombie_paina1 ();		// 12 frames (bent over, short)
	else if (self.lip < 0.5) ad_zombie_painb1 ();	// 28 frames (9 = on ground)
	else if (self.lip < 0.75) ad_zombie_painc1 ();	// 18 frames (bent over, long)
	else ad_zombie_paind1 ();						// 13 frames (slight hit)
};

/*=============================================================================
 ZOMBIE WAKEUP (check if can get up)
=============================================================================*/
void() ad_zombie_wakeup	= {
	if (self.ad_gibbed || self.deadflag) return;	// Do nothing dead (QVR: or killed whole, beheaded)
	
	self.use = ad_SUB_Null;				// No more using at this point
	if (!self.enemy) ad_FindTarget();		// If no enemy, look around?

	// Make sure bounding box is correct, if blocked can be set 0,0,0
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	// Turn monster collision on and test if can walk forward
	self.solid = ad_SOLID_SLIDEBOX;
	if (!ad_walkmove (0, 0))
	{
		self.ad_inpain = 2;				// On ground
		self.nextthink = time + 0.1;	// Keep checking
		self.think = self.ad_th_wakeup;	// Same function
		self.solid = ad_SOLID_NOT;			// No world interaction yet
		// Check if something has been blocking the zombie from getting up
		// This is a check for weird world/bmodel geo or monster/players
		// standing on zombies while on the ground trying to get up!
		self.count = self.count + 1;
		if (self.count > ad_MONAI_ZOMBGRDBLOCK) {
			self.health = self.ad_gibhealth;	// Gib time
			ad_Killed(self, self);				// Register death
			return;
		}
	}
	else {
		self.ad_bodyonflr = "";			// Body is chop proof!
		self.ad_inpain = 2;				// Animation not finished
		ad_zombie_sound(6);				// Wake up sound
		self.nextthink = time + 0.1;
		self.use = ad_monster_use;			// Just in case interruption
		if (self.ad_zombieflr == ad_MONAI_ZOMBIEUPB) self.think = ad_zombie_painb10;
		else self.think = ad_zombie_paine13;
	}
};

//----------------------------------------------------------------------
// Puts the zombie on the floor with a random Yaw rotation
// paintype = 0 Setup on floor with use trigger
// paintype > 0 On floor and waiting to get back up
//----------------------------------------------------------------------
void(float ad_frameno) ad_zombie_onground = {
	self.health = self.max_health;	// reset health
	self.ad_inpain = 2;				// Lying on floor, no pain
	self.count = 0;					// Reset get up tries
	self.solid = ad_SOLID_NOT;			// No world interaction
	self.ad_bodyonflr = ad_MON_ONFLR;		// mark body for the chop

	// Does the zombie start on the ground?
	if (ad_frameno == ad_MONAI_ZOMBIEFLR) {
		// Do nothing else while on the floor
		self.nextthink = self.ad_pausetime;
		self.think = ad_SUB_Null;

		// Check for spawning onfloor orientation flag
		// aflag = 1 Forward = 2 Backward
		if (self.aflag < 1 || self.aflag > 2) {
			if (random() < 0.5) self.aflag = 1;
			else self.aflag = 2;
		}

		// Pick random starting pose
		if (self.aflag == 1) {
			self.ad_zombieflr = ad_MONAI_ZOMBIEUPB;
			self.frame = $painb9;
		}
		else {
			self.ad_zombieflr = ad_MONAI_ZOMBIEUPE;
			self.frame = $paine12;
		}
		// If no angle set, Random fall direction
		if (self.angles_y < 1) self.angles_y = rint(random()*359);
		self.use = self.ad_th_wakeup;
		self.fixangle = ad_TRUE;
		// Reset onspawn fall down angle (only used once)
		self.aflag = 0;
	}
	else {
		self.ad_zombieflr = ad_frameno;	// Wakeup pose for later
		// Keep zombies on the ground and check again later
		self.nextthink = self.nextthink + ad_MONAI_ZOMBGRDTIMER;
		self.think = self.ad_th_wakeup;
	}
};

/*============================================================================
 All sounds used
 1 = sticking around, crucified
 2 = strutting the stuff (walking)
 3 = running (in slow motion)
 4 = all pain routines (zombie_paina1, _painb1, _painc1, _paind1, _paine1)
 5 = its a knockout!
 6 = get up and moan about it
 7 = fire zombie gib
============================================================================*/
void(float ad_type) ad_zombie_sound =
{
	// check for gibbed or idle sound block
	if (self.health < 1) return;
	if (self.spawnflags & ad_MON_SPAWN_NOIDLE && ad_type < 3) return;
	
	// Random sound check
 	self.lip = random();
	if (ad_type == 1) {
		if (self.lip < 0.1) 
			sound (self, ad_CHAN_VOICE, "zombie/idle_w2.wav", 1, ad_ATTN_STATIC);
	}
	else if (ad_type == 2 && self.ad_idletimer < time) {
	 	self.ad_idletimer = time + 1 + (random()*2);
		if (self.lip < 0.2)
			sound (self, ad_CHAN_VOICE, "zombie/z_idle.wav", 1, ad_ATTN_IDLE);
	}
	else if (ad_type == 3 && self.ad_idletimer < time) {
	 	self.ad_idletimer = time + 1 + (random()*2);
		if (self.lip < 0.2) sound (self, ad_CHAN_VOICE, "zombie/z_idle.wav", 1, ad_ATTN_IDLE);
		if (self.lip > 0.8) sound (self, ad_CHAN_VOICE, "zombie/z_idle1.wav", 1, ad_ATTN_IDLE);
	}
	else if (ad_type == 4) {
		if (self.lip < 0.25) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else if (self.lip < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
	}
	else if (ad_type == 5) {
		sound (self, ad_CHAN_BODY, "zombie/z_fall.wav", 1, ad_ATTN_NORM);
	}
	else if (ad_type == 6) {
		if (self.lip < 0.5) sound (self, ad_CHAN_VOICE, "zombie/z_idle.wav", 1, ad_ATTN_IDLE);
		else sound (self, ad_CHAN_VOICE, "zombie/z_idle1.wav", 1, ad_ATTN_IDLE);
	}
	else if (ad_type == 7) {
		sound (self, ad_CHAN_WEAPON, "zombie/z_shot1.wav", 1, ad_ATTN_NORM);
	}
};

//============================================================================
void() ad_zombie_die =
{
	self.health = self.ad_gibhealth; // Force gib
	ad_monster_death_precheck();
};

//============================================================================
void() ad_zombie_cruc1	= [$cruc_1,ad_zombie_cruc2] {ad_zombie_sound(1);};
void() ad_zombie_cruc2	= [$cruc_2,ad_zombie_cruc3] {self.nextthink = time + 0.1 + random()*0.1;};
void() ad_zombie_cruc3	= [$cruc_3,ad_zombie_cruc4] {self.nextthink = time + 0.1 + random()*0.1;};
void() ad_zombie_cruc4	= [$cruc_4,ad_zombie_cruc5] {self.nextthink = time + 0.1 + random()*0.1;};
void() ad_zombie_cruc5	= [$cruc_5,ad_zombie_cruc6] {self.nextthink = time + 0.1 + random()*0.1;};
void() ad_zombie_cruc6	= [$cruc_6,ad_zombie_cruc1] {self.nextthink = time + 0.1 + random()*0.1;};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_zombie_cruc_pain =
{
	self.health = self.max_health;				// reset health	
	// Any pain to moan about?
	if (self.ad_pain_finished < time) ad_zombie_sound(4);
	self.ad_pain_finished = time + 1 + random();
};

//----------------------------------------------------------------------
void() ad_zombie_cruc_spawn =
{
	self.use = ad_SUB_Null;				// No more triggers
	self.solid = ad_SOLID_BBOX;			// Interact with objects
	self.movetype = ad_MOVETYPE_FLY;		// Cannot be movetype_none
	setmodel(self, self.mdl);			// Nail to cross
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);

	// Setup exact/randon skin choices
	self.ad_randomskin = 4;
	if (self.ad_exactskin > 0) self.skin = rint(self.ad_exactskin);
	else self.skin = rint(random()*(self.ad_randomskin-1));
	if (self.skin < 0) self.skin = 0;	// Double check no negatives	
	
	self.takedamage = ad_DAMAGE_AIM;		// Can receive damage
	self.velocity = '0 0 0';			// Make sure stationary
	self.deadflag = ad_DEAD_NO;			// used to stop death re-triggering
	self.view_ofs = '0 0 -24';			// Standard setup
	self.ad_pain_timeout = 1;				// Default
	
	ad_zombie_cruc1 ();					// Time to do some moaning
};

//----------------------------------------------------------------------
void() ad_zombie_cruc_setup =
{
	// Setup AI functions
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_zombie_cruc1;
	self.ad_th_pain = ad_zombie_cruc_pain; self.ad_th_die = ad_zombie_die;
	
	self.ad_gibbed = ad_FALSE;				// Still in one piece
	self.health = self.max_health = 60;	// Save for later
	self.ad_gibhealth = 0 - self.health;	// Work out damage trigger
	self.ad_pain_flinch = 10;				// Always in pain
	self.ad_nomonstercount = ad_TRUE;			// Don't include in initial total
	// make sure angle field is within range (0-360)
	// interestingly, if angles_y is negative the engine will ignore it
	if (self.angles_y < 0) self.angles_y = 0;
	if (self.angles_y > 360) self.angles_y = 360;

	// Zombies cannot be crucified and on the floor at once!
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_ONFLOOR);
	
	self.flags = ad_FL_MONSTER;			// Always reset this flag
	self.effects = 0;					// Always reset
	self.oldorigin = self.origin;		// Save origin
	self.ad_bbmins = '-8 -8 -24';			// Narrow pole
	self.ad_bbmaxs = '8 8 32';

	if (self.spawnflags & ad_MON_SPAWN_DELAY) {
		setmodel(self, ad_string_null);
		self.solid = ad_SOLID_NOT;				// No world interaction
		self.use = ad_zombie_cruc_spawn;		// Wait for trigger
	}
	else {
		// Variable start delay on all monsters to reduce packet errors
		self.nextthink = time + 0.1 + random()*0.4;
		self.think = ad_zombie_cruc_spawn;
	}
};

/*======================================================================
 QUAKED monster_zombie (1 0 0) (-16 -16 -24) (16 16 32) Crucified ambush FLOOR
If crucified, stick the bounding box 12 pixels back into a wall to look right.
======================================================================*/
void() ad_monster_zombie =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	// Stupid ID getting the crucified and ambush back to front on zombies
	// Lets fix the problem and reverse the flags to match everything else
	if (self.ad_classtype != ad_CT_MONMUMMY) {
		if (self.spawnflags & ad_MON_ZOMCRUCIFIED || self.spawnflags & ad_MON_ZOMBAMBUSH) {
			self.health = 0;		// Temporarily use this variable
			if (self.spawnflags & ad_MON_ZOMCRUCIFIED) self.health = self.health + ad_MON_CRUCIFIED;
			if (self.spawnflags & ad_MON_ZOMBAMBUSH) self.health = self.health + ad_MON_AMBUSH;
			
			// Removed the old bits and then add the new one's
			self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_ZOMIDHACK);
			self.spawnflags = self.spawnflags + self.health;
		}
	}

	self.mdl = "progs/mon_zombie.mdl";
	self.ad_headmdl = "progs/h_zombie.mdl";
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_FLESH); 	// Also in world.qc

	precache_sound ("zombie/z_idle.wav");	// Idle A
	precache_sound ("zombie/z_idle1.wav");	// Idle B
	precache_sound ("zombie/idle_w2.wav");	// Crucified

	self.ad_pain_sound = "zombie/z_pain.wav";
	self.ad_pain_sound2 = "zombie/z_pain1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	precache_sound ("zombie/z_shot1.wav");	// Swipe sound
	precache_sound ("zombie/z_fall.wav");	// Impact - floor
	precache_sound ("zombie/z_miss.wav");	// Impact - miss
	precache_sound ("zombie/z_hit.wav");	// Impact - hit
	precache_sound ("zombie/z_gib.wav");	// Death sound

	self.ad_sight_sound = "zombie/z_idle.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();				// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;		// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_FLESHP);	// Green flesh!?!
	}

	self.solid = ad_SOLID_NOT;					// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;			// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (!self.ad_classtype) self.ad_classtype = ad_CT_MONZOMBIE;
	self.ad_classgroup = ad_CG_ZOMBIE;			// One big happy zombie family!
	self.ad_classmove = ad_MON_MOVEWALK;
	if (!self.ad_exactskin) self.ad_randomskin = 4;
	if (self.ad_deathstring == "")
		self.ad_deathstring = " joins the Zombies\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	// Setup crucified zombies
	if (self.spawnflags & ad_MON_CRUCIFIED) ad_zombie_cruc_setup();
	else {
		// Setup zombie ready for placement
		self.health = ad_HP_MONZOMBIE;				// Basic health (cannot override)
		self.ad_gibhealth = -60;					// Gib value, not used
		self.ad_gibbed = ad_FALSE;					// In one piece
		self.ad_pain_flinch = ad_MONAI_ZOMBIEHGH_DAM;
		self.ad_steptype = ad_FS_TYPESLOW;			// Small leg
		self.ad_altsteptype = ad_FS_TYPEDRAG;			// Clubfoot
		self.ad_pain_timeout = -5;					// Always go into pain (health reset)
		if (!self.ad_movespeed) self.ad_movespeed = 1;// Adjustable speed via skill level
		self.ad_inpain = 0;						// Zombie starts with no pain lock
		self.count = 0;							// Reset get up timer

		// Check for random rotation setup and angle limits
		if (self.angles_y < 0) self.angles_y = rint(random()*359);
		if (self.angles_y > 360) self.angles_y = 360;

		self.ad_th_stand = ad_zombie_stand1;
		self.ad_th_walk = ad_zombie_walk1;
		self.ad_th_run = ad_zombie_run1;
		self.ad_th_pain = ad_zombie_pain;
		self.ad_th_die = ad_zombie_die;
		self.ad_th_missile = ad_zombie_missile;
		self.ad_th_wakeup = ad_zombie_wakeup;			// Get off floor
		
		ad_monster_start();
	}
};

/*======================================================================
 QUAKED monster_mummy (1 0 0) (-16 -16 -24) (16 16 32) ambush x FLOOR
Poisonous Zombie that explodes poisonous gibs on death
======================================================================*/
void() ad_monster_mummy =
{
	self.ad_classtype = ad_CT_MONMUMMY;			// Special poison zombie
