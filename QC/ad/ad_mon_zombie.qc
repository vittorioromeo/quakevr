//======================================================================
// Zombie Range Attack
//======================================================================
void(vector ad_st) ad_ZombieThrowFlesh =
{
	local vector ad_org, ad_dir, ad_ang, ad_avel;

	if (self.health < 0) return;
	
	// Throw the flesh missle from the hand above the head
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(ad_st);

	// Is Z aware enabled (AI track player much better)
	if ( ad_query_configflag(ad_SVR_ZAWARE) || self.ad_no_zaware ) {
		ad_dir = normalize(self.enemy.origin - ad_org);
		ad_dir = ad_dir * ad_SPEED_ZOMBFLESH;
		ad_dir_z = ad_ELEV_ZAXIS;
	}
	else {
		// One final angle adjustment (based on actual projectile origin)
		self.ad_attack_speed = ad_SPEED_ZOMBFLESH + (ad_skill * ad_SPEED_ZOMBIESKILL);
		self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, ad_org, self.enemy.origin, self.ad_attack_speed);
		ad_ang = vectoangles(self.enemy.origin - ad_org);
		ad_ang_x = -self.ad_attack_elev;
		makevectors (ad_ang);
 		ad_dir = v_forward * self.ad_attack_speed;
	}

	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_FLESH);
};

