//----------------------------------------------------------------------
void() ad_zombie_missile =
{
	self.lip = self.ad_meleeattack;
	// Don't pick the same attack twice in a row
	while (self.lip == self.ad_meleeattack) {
		self.lip = rint(random()*3);
	}

	self.ad_meleeattack = self.lip;
	if (self.ad_meleeattack == 1) ad_zombie_atta1 ();
	else if (self.ad_meleeattack == 2) ad_zombie_attb1 ();
	else ad_zombie_attc1 ();
};

