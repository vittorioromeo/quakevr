void() ad_zombie_atta11	=[	$atta11,	ad_zombie_atta12	] {ad_ai_face();
	self.ad_attack_speed = ad_SPEED_ZOMBFLESH + (ad_skill * ad_SPEED_ZOMBIESKILL);
