// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_jim.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
Jim (Heavily inspired by bob from Quoth - Kell/Necros/Preach)
New models, skins and animations, code
==============================================================================*/
// Slight movement of wings
$frame idle1 idle2 idle3 idle4 idle5 idle6

// Twist wings backward and evil eyes
$frame idle7 idle8 idle9 idle10 idle11 idle12

// Wobble gun (+/- 5 degrees) and evil eyes
$frame idle13 idle14 idle15 idle16 idle17 idle18

// Idle while gun is point left or right
$frame idleleft1 idleleft2 idleleft3 idleleft4 idleleft5 idleleft6
$frame idleright1 idleright2 idleright3 idleright4 idleright5 idleright6

// Idle and turn gun left or right 30 degrees
$frame idleturnl1 idleturnl2 idleturnl3 idleturnl4 idleturnl5 idleturnl6
$frame idleturnr1 idleturnr2 idleturnr3 idleturnr4 idleturnr5 idleturnr6

// Custom wing movements for combat
$frame movedn1 movedn2 movedn3 movedn4 movedn5 movedn6
$frame moveup1 moveup2 moveup3 moveup4 moveup5 moveup6

// Flap wings and get angry eyes
$frame pain1 pain2 pain3 pain4 pain5 pain6

// Downward spiral with twisted wings
$frame zdeath1 zdeath2 zdeath3 zdeath4 zdeath5 zdeath6

float ad_JS_IDLE = 0;		// Default state
float ad_JS_IDLE2 = 1;		// Special idle (stationary)
float ad_JS_IDLE3 = 2;		// Special idle (stationary)
float ad_JS_IDLELEFT = 3;	// Looking left
float ad_JS_IDLERIGHT = 4;	// Looking right
float ad_JS_TURNLEFT = 5;	// Turning left (not looped)
float ad_JS_TURNRIGHT = 6;	// Turning right (not looped)
float ad_JS_DOWN = 7;		// Combat move
float ad_JS_UP = 8;		// Combat move
float ad_JS_PAIN = 9;		// Resets current animation
float ad_JS_DYING = 10;	// Final animation

// Size of each animation block
float ad_JS_ANIMBLOCK = 6;

//======================================================================
// Update Jim every frame with skin/sound updates
// fstate (see above for animation block details)
//======================================================================
void(float ad_fstate) ad_jim_update = 
{
	// If jim is dead, no more updates
	if (self.health < 1) return;

	// Update ther gun idle (buzzing) sound
	if (self.t_width < time) {
		self.t_width = time + 0.9;
		// Play on auto channel so it overlaps with existing sound
		sound (self, ad_CHAN_AUTO, "jim/gunidle2.wav", 0.3, ad_ATTN_WEAPON);
	}

	// Time for an idle sound?
	if (self.ad_idletimer < time) ad_monster_idle_sound();

	// Jim has a glowing gun and eye skin feature!
	if (self.t_length < time) {
		self.t_length = time + 0.2;
		self.ad_exactskin = self.ad_exactskin + 1;
		if (self.ad_exactskin > 2) self.ad_exactskin = 0;
		self.skin = self.ad_exactskin;
	}

	// In combat?
	if (self.enemy) {
		self.ad_idlebusy = ad_FALSE;
		if (ad_fstate == ad_JS_IDLE) {
			if (self.origin_z > self.oldorigin_z) ad_fstate = ad_JS_UP;
			else if (self.origin_z < self.oldorigin_z) ad_fstate = ad_JS_DOWN;
		}
	}
	else {
		// At beginning of frame block and reversing?
		if (self.count == 0 && self.ad_idlereverse) {
			if (self.ad_idlebusy == ad_JS_TURNLEFT || self.ad_idlebusy == ad_JS_TURNRIGHT) {
				self.ad_idlebusy = ad_JS_IDLE;
				self.ad_idlereverse = ad_FALSE;
				self.waitmin = time + 2 + random() * 4;
			}
		}
		// At end of frame block and going forward?
		else if (self.count == ad_JS_ANIMBLOCK-1 && !self.ad_idlereverse) {
			// Staring forward, doing nothing
			if (self.ad_idlebusy == ad_JS_IDLE && self.waitmin < time) {
				// Only start idle animations if stationary
				if (self.velocity_x == 0 && self.velocity_y == 0) {
					if (self.ad_idletimer < time) ad_monster_idle_sound();
					self.lip = random();
					if (self.lip < 0.3) self.ad_idlebusy = ad_JS_TURNLEFT;
					else if (self.lip < 0.6) self.ad_idlebusy = ad_JS_TURNRIGHT;
					else if (self.lip < 0.8) self.ad_idlebusy = ad_JS_IDLE2;
					else self.ad_idlebusy = ad_JS_IDLE3;
				}
			}
			// Return from wing flex, gun swing idle animations
			else if (self.ad_idlebusy == ad_JS_IDLE2 || self.ad_idlebusy == ad_JS_IDLE3) {
				self.ad_idlebusy = ad_JS_IDLE;
				self.waitmin = time + 2 + random() * 4;
			}
			// Turning eyes/gun in left direction
			else if (self.ad_idlebusy == ad_JS_TURNLEFT) {
				self.ad_idlebusy = ad_JS_IDLELEFT;
				self.waitmin = time + 2 + random() * 4;
			}
			// Turning eyes/gun to right direction
			else if (self.ad_idlebusy == ad_JS_TURNRIGHT) {
				self.ad_idlebusy = ad_JS_IDLERIGHT;
				self.waitmin = time + 2 + random() * 4;
			}
			// Looking left and randomly think about returning
			else if (self.ad_idlebusy == ad_JS_IDLELEFT) {
				if (self.waitmin < time && random() < 0.5) {
					self.ad_idlebusy = ad_JS_TURNLEFT;
					self.ad_idlereverse = ad_TRUE;
				}
			}
			// Looking right and randomly think about returning
			else if (self.ad_idlebusy == ad_JS_IDLERIGHT) {
				if (self.waitmin < time && random() < 0.5) {
					self.ad_idlebusy = ad_JS_TURNRIGHT;
					self.ad_idlereverse = ad_TRUE;
				}
			}
		}
		
		// Change the movement type so that jim can easily move up/down
		// using velocity, forced origin movement is really jerky!
		if (self.velocity_x == 0 && self.velocity_y == 0) {
			if (self.ad_attack_timer < time) {
				self.ad_attack_timer = time + 1;
				if (self.lip < 1) self.lip = 1;
				else self.lip = -1;
				self.velocity_z = 2 * self.lip;
			}
		}
		else {
			// Slowdown the velocity (movement = no friction)
			self.velocity = self.velocity * self.ad_velocityfriction;
			if (self.velocity_x > -5 && self.velocity_x < 5) self.velocity_x = 0;
			if (self.velocity_y > -5 && self.velocity_y < 5) self.velocity_y = 0;
			if (self.velocity_z > -5 && self.velocity_z < 5) self.velocity_z = 0;
			// Don't go into attack straight away when velocity is active
			self.ad_attack_finished = time + 0.5;
		}
	}

	// Check frame direction and update counter
	if (self.ad_idlereverse) self.count = self.count - 1;
	else self.count = self.count + 1;
	if (self.count >= ad_JS_ANIMBLOCK) self.count = 0;
	if (self.count < 0) self.count = ad_JS_ANIMBLOCK-1;
	
	// Busy with an idle animation?
	if (self.ad_idlebusy > 0) ad_fstate = self.ad_idlebusy;
	// Update frame animation block with frame counter
	self.frame = ad_fstate * ad_JS_ANIMBLOCK + self.count;
	// Store current origin position
	self.oldorigin = self.origin;
};

//======================================================================
// All stand, walk and run functions are condensed down to one entry
// because the robot has a constant skin/sound update that has to
// happen at specific intervals
//
void()	ad_jim_stand1	=[	$idle1,	ad_jim_stand1 ] {
	// Standing idle has gentle bobbing up and down
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_FLY;
	ad_jim_update(ad_JS_IDLE); ad_ai_stand();
};
void()	ad_jim_walk1	=[	$idle1,	ad_jim_walk1 ] {
	// Movement is steps, not velocity
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	self.velocity = '0 0 0';
	ad_jim_update(ad_JS_IDLE); ad_ai_walk(8);
};
void()	ad_jim_run1	=[	$idle1,	ad_jim_run1 ] {
	// Movement is steps, only velocity when firing weapon
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	self.velocity = '0 0 0';
	ad_jim_update(ad_JS_IDLE);
	ad_ai_run(16);
	if (self.ad_movespeed != 0) ad_ai_face();
};

//======================================================================
// Range (LASERS or ROCKETS)
//======================================================================
void() ad_jim_laser =
{
	local vector ad_org, ad_dir, ad_vec;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	// Always make sure there is no monster or obstacle in the way
	// Cannot use enemy entity direct, enemytarget will be active
	if ( !ad_visxray(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 12', ad_FALSE) ) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	// Aim high to catch jumping players
	ad_dir = ad_SUB_orgEnemyTarget() + '0 0 12';
	ad_vec = normalize(ad_dir - ad_org);
	// Variable laser speed, original unit was just 800 every skill
	self.ad_attack_speed = ad_SPEED_JIMPROJ + (ad_skill * ad_SPEED_JIMPROJSKILL);
	ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_LASER, self.ad_attack_speed);
};

//----------------------------------------------------------------------
// Straight aim rocket, no pre-calculation or steering (skill based speed)
//----------------------------------------------------------------------
void() ad_jim_rocket =
{
	local vector ad_org, ad_dir, ad_vec;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	// Always make sure there is no monster or obstacle in the way
	// Cannot use enemy entity direct, enemytarget will be active
	if ( !ad_visxray(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 -12', ad_FALSE) ) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "jim/rocket_fire.wav", 1, ad_ATTN_NORM);	

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	// Aim low to catch players with splash damage
	ad_dir = ad_SUB_orgEnemyTarget() - '0 0 12';
	ad_vec = normalize(ad_dir - ad_org);
	
	// Variable rocket speed, matching laser (very nasty)
	self.ad_attack_speed = ad_SPEED_JIMPROJ + (ad_skill * ad_SPEED_JIMPROJSKILL);
	ad_Launch_Missile (ad_org, ad_vec, '0 0 0', ad_CT_PROJ_JIM2, self.ad_attack_speed);
};

//----------------------------------------------------------------------------
void(float ad_vspeed) ad_jim_vel = { 
	// Turn and face enemy and update attack velocity
	ad_ai_face(); 
	if (self.ad_movespeed == 0) 
		self.velocity = self.ad_attack_track * ad_vspeed;
};

//----------------------------------------------------------------------------
// Calculate new attack vector for firing lasers at the player
//----------------------------------------------------------------------------
void() ad_jim_attack =
{
	self.solid = ad_SOLID_SLIDEBOX;
	if (self.ad_movespeed == 0) self.movetype = ad_MOVETYPE_FLY;
	makevectors(self.angles);
	// Always fly upwards away from the player
	self.pos1 = v_up * (50 + random() * 100);
	// Randomly pick a left or right strafe direction
	self.pos2 = v_right * (ad_crandom() * 200);
	// Always try to back away from the player
	self.ad_pos3 = v_forward * (random() * 100);
	
	// Merge all the randomness together
	self.ad_attack_track = self.pos1 + self.pos2 + self.ad_pos3;
	// Check nothing is in the way, estimate vector of attack
	traceline(self.origin, self.origin+self.ad_attack_track, ad_FALSE, self);
};

//----------------------------------------------------------------------------
void() ad_jim_fire1 =[ $idle1, ad_jim_fire2 ] {ad_jim_update(ad_JS_IDLE);
	if (self.ad_classtype == ad_CT_MONJIM) 
		sound (self, ad_CHAN_WEAPON, "jim/laser_load.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "jim/rocket_load.wav", 1, ad_ATTN_NORM);
};
void() ad_jim_fire2 =[ $idle1, ad_jim_fire3 ] {ad_jim_update(ad_JS_IDLE);ad_jim_attack();
	if (ad_skill < ad_SKILL_HARD) ad_jim_vel(0.4);
	else ad_jim_vel(1.5);
};
void() ad_jim_fire3 =[ $idle1, ad_jim_fire4 ] {
	ad_jim_update(ad_JS_IDLE); if (ad_skill < ad_SKILL_HARD) ad_jim_vel(0.6);};
void() ad_jim_fire4 =[ $idle1, ad_jim_fire5 ] { ad_jim_update(ad_JS_IDLE); 
	if (ad_skill < ad_SKILL_HARD) ad_jim_vel(0.8);};
void() ad_jim_fire5 =[ $idle1, ad_jim_fire6 ] {ad_jim_update(ad_JS_IDLE);ad_jim_vel(1.0);};
void() ad_jim_fire6 =[ $idle1, ad_jim_fire7 ] {
	ad_jim_update(ad_JS_IDLE); if (ad_skill < ad_SKILL_HARD) ad_jim_vel(1.2);
	if (self.ad_classtype == ad_CT_MONJIM) ad_jim_laser();
	else ad_jim_rocket();
};
void() ad_jim_fire7 =[ $idle1, ad_jim_fire8 ] {ad_jim_update(ad_JS_IDLE);
	if (ad_skill < ad_SKILL_HARD) ad_jim_vel(1.4);
	if (self.ad_classtype == ad_CT_MONJIM) ad_jim_laser();
};
void() ad_jim_fire8 =[ $idle1, ad_jim_fire9 ] {ad_jim_update(ad_JS_IDLE);
	if (ad_skill < ad_SKILL_HARD) ad_jim_vel(1.3);
	if (self.ad_classtype == ad_CT_MONJIM && ad_skill >= ad_SKILL_NORMAL) ad_jim_laser();
};
void() ad_jim_fire9 =[ $idle1, ad_jim_fire10] {ad_jim_update(ad_JS_IDLE);
	if (ad_skill < ad_SKILL_HARD) ad_jim_vel(1.1);
	if (self.ad_classtype == ad_CT_MONJIM && ad_skill >= ad_SKILL_HARD) ad_jim_laser();
};
void() ad_jim_fire10 =[ $idle1, ad_jim_fire11]{ad_jim_update(ad_JS_IDLE);ad_jim_vel(0.5);};
void() ad_jim_fire11 =[ $idle1, ad_jim_run1 ] {ad_jim_update(ad_JS_IDLE);
	// Chance of bob instantly firing again
	if (random() < 0.8) ad_SUB_AttackFinished( 1 + random() );
	else ad_SUB_AttackFinished( 1 + random()*0.5 );
};

//============================================================================
// ROBOT PAIN!?!
//============================================================================
void() ad_jim_inpain =
{
	// Keep cycling the pain animation
	self.think = ad_jim_inpain;
	self.nextthink = time + 0.1;
	
	// Start of pain cycle
	if (self.ad_inpain ==  0) {
		// Spawn a pile of sparks and dust falling down
		ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
		self.pos1 = '0 0 0';
		self.pos1_x = random() * self.lefty;	// Pitch away from dmg
		self.pos1_z = ad_crandom() * -10;			// Roll left / right
	}
	// Finished, back to combat
	else if (self.ad_inpain >= 5) {
		// reset pitch/roll
		self.angles_x = self.angles_z = 0;
		self.think = self.ad_th_run;
	}
	else {
		// Keep moving in the pitch/roll direction
		self.pos1 = self.pos1 * 1.2;
		self.angles = self.angles + self.pos1;
	}
	
	// Update pain frame
	ad_jim_update(ad_JS_PAIN);
	// Next pain animation
	self.ad_inpain = self.ad_inpain + 1;
};

//----------------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_jim_pain = 
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);
	
	// Stop any ai_run velocity and reset movetype
	self.velocity = '0 0 0';
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
	self.ad_inpain = 0;
	
	// Work out which direction the damage came from (enemy)
	if (ad_infront(ad_attacker)) self.lefty = 10;	// Hit from infront
	else self.lefty = -10;					// Hit from behind
	
	// Always do pain, no flinch
	ad_jim_inpain();
};

//============================================================================
// SLOW DYING ROBOT!?!
//============================================================================
void() ad_jim_dying2;
void() ad_jim_is_dead;

//----------------------------------------------------------------------------
void() ad_jim_dying1 = 
{
	// Setup correct death frame
	self.frame = ad_JS_DYING + self.cnt;
	self.cnt = self.cnt + 1;
	
	// Start spinning the robot out of control
	// This update works with avelocity to create spiral effect
	makevectors(self.angles);
	self.velocity = (v_forward * 300) + (v_up * -30);
	// Keep spinning out of control (constant direction)
	if (self.lefty == 1) self.angles_y = (self.angles_y + 10);
	else self.angles_y = (self.angles_y - 10);

	// Spawn some extra smoke trails
	if (random() < 0.3) ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);

	// Keep looping round
	self.think = ad_jim_dying1;
	self.nextthink = time + 0.1;

	// Next frame/function?
	if (self.cnt > 3) { 
		self.think = ad_jim_dying2;	// Next function
		self.waitmin = time + 1;	// Setup timer for next part
		self.cnt = 0; 				// Reset death animation
	}
};

//----------------------------------------------------------------------------
void() ad_jim_dying2 = 
{
	// Setup correct death frame
	self.frame = ad_JS_DYING + self.cnt;
	self.cnt = self.cnt + 1;
	if (self.cnt > 5) self.cnt = 0;

	// Medium explosion + sound OR smoke projectile trail
	if (random() > 0.7) ad_SpawnExplosion(ad_EXPLODE_MED, self.origin, "jim/explode_minor.wav");
	else if (random() < 0.3) ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);

	// Turn down towards the ground
	makevectors(self.angles);
	self.solid = ad_SOLID_BBOX;	// Collision + touch
	// Slow down the velocity to accent the spinning
	self.velocity = (self.velocity * 0.2) + ((v_forward * 100) * 0.8);
	self.velocity = normalize(self.velocity) * 300;
	self.velocity_z = self.velocity_z - 200;
	// Keep spinning out of control (constant direction)
	if (self.lefty == 1) self.angles_y = (self.angles_y + 10);
	else self.angles_y = (self.angles_y - 10);

	// Keep looping round
	self.nextthink = time + 0.1;
	if (self.waitmin < time) self.think = ad_jim_is_dead;
	else self.think = ad_jim_dying2;
};

//----------------------------------------------------------------------------
void() ad_jim_is_dead = 
{
	self.think = self.touch = ad_SUB_Null;
	
	// Final fireworks!
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, "jim/explode_major.wav");

	// Goto final resting place
	ad_entity_hide(self);
};


//----------------------------------------------------------------------------
void() ad_jim_die = 
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Flush every sound channel to kill gun buzzing sound
	sound(self, ad_CHAN_WEAPON, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	sound(self, ad_CHAN_VOICE, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	sound(self, ad_CHAN_ITEM, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	sound(self, ad_CHAN_FEET, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	sound(self, ad_CHAN_EXTRA1, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);
	sound(self, ad_CHAN_EXTRA2, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);

	// Special explosive death event 
	// First function creates the upward spiral (negative avelocity)
	// Second function accents the spiral (1s forward movement)
	// Third final impact (touch function goes here as well)
	//
	sound (self, ad_CHAN_VOICE, "jim/death1.wav", 1, ad_ATTN_NORM);
	self.solid = ad_SOLID_NOT;			// No world colision
	self.movetype = ad_MOVETYPE_FLY;	// Free velocity movement
	self.touch = ad_jim_is_dead;		// still can touch stuff
	self.cnt = 0;					// Death frame 0
	self.ad_movespeed = 0;				// Make sure turret mode off
	// The avelocity works better when negative (twisting upward)
	self.avelocity_x = (random() * 50) - 100;
	self.avelocity_y = (random() * 50) - 100;
	self.avelocity_z = (random() * 50) - 100;
	
	// Decide which direction to spin
	if (random() < 0.5) self.lefty = 1;
	else self.lefty = 0;

	// Spawn dust and sprite explosion
	ad_particle_dust(self.origin, 10+random()*10, 16, ad_PARTICLE_BURST_YELLOW);
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, "jim/explode_minor.wav");
	ad_SpawnProjectileSmoke(self.origin, 150, 50, 150);

	ad_jim_dying1();
};

//======================================================================
/*ad:QUAKED monster_jim (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_monster_jim =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	// Allow for different models so mappers can change the skins
	if (self.spawnflags & ad_MON_JIM_ROCKET) {
		if (self.mdl == "") self.mdl = "progs/mon_jimrock.mdl";
	}
	else {
		if (self.mdl == "") self.mdl = "progs/mon_jim.mdl";
	}
	precache_model (self.mdl);
	
	// death/pain/attack sounds
	precache_sound("jim/death1.wav");
	self.ad_pain_sound = "jim/pain1.wav";
	self.ad_pain_sound2 = "jim/pain2.wav";
	precache_sound(self.ad_pain_sound);
	precache_sound(self.ad_pain_sound2);
	
	precache_sound("jim/explode_minor.wav");
	precache_sound("jim/explode_major.wav");
	precache_sound("jim/gunidle2.wav");		// Long buzzing sound

	self.ad_sight_sound = "jim/sight1.wav";
	precache_sound (self.ad_sight_sound);
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Special explosion death
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 30;				// Sometimes flinch
	self.ad_steptype = ad_FS_FLYING;			// Silent feet
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	self.oldorigin = self.origin;		// Used for wing angles
	if (self.ad_velocityfriction <= 0) self.ad_velocityfriction = 0.8 + (random() * 0.1);
	self.ad_idlebusy = 0;					// Rotate gun idle states
	self.ad_idlereverse = ad_FALSE;			// Reverse direction for idle
	self.ad_attack_offset = '20 0 -10';	// front of laser/rocket
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_JimCheckAttack;
	self.ad_th_stand = ad_jim_stand1;
	self.ad_th_walk = ad_jim_walk1;
	self.ad_th_run = ad_jim_run1;
	self.ad_th_pain = ad_jim_pain;
	self.ad_th_die = ad_jim_die;
	self.ad_th_missile = ad_jim_fire1;

	self.ad_classgroup = ad_CG_ROBOT;
	self.ad_classmove = ad_MON_MOVEFLY;
	
	if (self.spawnflags & ad_MON_JIM_ROCKET) {
		self.ad_classtype = ad_CT_MONJIMROCKET;
		if (self.health < 1) self.health = 50;
		self.ad_deathstring = " was blown away by Jim\n";
		self.ad_attack_explosive = ad_TRUE;			// Has explosive attack

		// Classic idle sound + new variant
		self.ad_idle_sound = "jim/idle1.wav";
		self.ad_idle_sound2 = "jim/idle3.wav";
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);

		// Projectile fire and impact (used in projectiles)
		precache_sound("jim/rocket_load.wav");		// Wind up
		precache_sound("jim/rocket_fire.wav");		// Fire
		precache_sound("jim/rocket_hit.wav");		// Impact	
	}
	else {
		self.ad_classtype = ad_CT_MONJIM;
		if (self.health < 1) self.health = 100;
		self.ad_deathstring = " was cauterized by Jim\n";
		
		// Classic idle sound + new variant
		self.ad_idle_sound = "jim/idle1.wav";
		self.ad_idle_sound2 = "jim/idle2.wav";
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);

		// Projectile fire and impact (used in projectiles)
		precache_model (ad_MODEL_PROJ_LASER);		// Enforcer laser model
		precache_sound("jim/laser_load.wav");	// Wind up
		precache_sound (ad_SOUND_LASER_FIRE);		// Fire
		precache_sound (ad_SOUND_LASER_HIT);		// Impact
	}
	
	ad_monster_start();
};

//----------------------------------------------------------------------
// Re-direct all Quoth Bob requests to Jim!
void() ad_monster_bob = { ad_monster_jim(); }
