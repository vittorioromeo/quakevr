/*======================================================================
 CLIENT FUNCTIONS
======================================================================*/
// Vanilla Quake Inventory reset combined flag
// IT_SUPERHEALTH, IT_KEY1, IT_KEY2 
// IT_INVISIBILITY, IT_INVULNERABILITY, IT_SUIT, IT_QUAD
float ad_IT_ITEMRESET = 8323072;		// 65536++
float ad_IT_MODRESET = 8380416;		// 8192++
float ad_ALL_WEAPONS = 255;
float ad_NO_WEAPONS = 4351;			// 1-128 + 4096

// client_camera.qc
void() ad_SetupIntermissionCamera;
void() ad_CycleIntermissionCamera;

// client_debuff.qc AND client_power.qc
void() ad_ClientDeBuff;
void() ad_ClientPowerups;
void(entity ad_targ, float ad_powtimer, float ad_novania) ad_ResetPowerSystem;
void(entity ad_targ) ad_ResetDebuffSystem;

// client_advinfo.qc
void() ad_CheckSecretCamera;

// player.qc
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_player_pain;
void() ad_player_death;
void() ad_player_stand1;

// triggers.qc
void() ad_trigger_changelevel_finish;
void() ad_trigger_cdtrack_change;
void(entity ad_targ) ad_trigger_skybox_change;

// misc_camera.qc
float(float ad_cam_angle1, float ad_cam_angle2) ad_camera_check_anglezero;
float(float ad_baxis_start, float ad_baxis_control, float ad_baxis_end, float ad_baxis_time) ad_bezier_axis;
vector(vector ad_bez_start, vector ad_bez_control, vector ad_bez_end, float ad_bez_timemax, float ad_bez_timeleft) ad_bezier_curve;
void() ad_misc_camera_filewrite;

/*======================================================================
 USED : Load (map command) NEW MAP or NEW GAME
 * This is a function called via the engine for new games
 * Resets all parm data back to default values, followed by Decode
 * Cannot use any self keys in this functions, its called by engine
   BEFORE any client setup or insertion into the map!
======================================================================*/
void() ad_SetNewParms =
{
	dprint("\b[CLIENT]\b SetNewParms\n");

	// Brand new game/map, reset start position settings
	ad_update_configflag(ad_SVR_SPAWN_BIT1, ad_FALSE);
	ad_update_configflag(ad_SVR_SPAWN_BIT2, ad_FALSE);
	ad_update_configflag(ad_SVR_SPAWN_BIT3, ad_FALSE);
	ad_fog_active = ad_FALSE;
	ad_skyfog_active = ad_FALSE;
	
	parm1 = ad_IT_SHOTGUN | ad_IT_AXE;	// Default ID weapon start
	// Check for Evil NM+ skill level (Lower HP max)
	if (ad_Client_QueryEvilmode()) parm2 = ad_HEAL_EVILMAX;
	else parm2 = ad_HEAL_PLAYMAX;		// Starting Health (def=100)
	parm3 = 0;  parm9 = 0;			// Armourtype and value
	parm4 = 25;	parm5 = 0;			// Ammo qty (shell/nail/rocket/cells)
	parm6 = 0;	parm7 = 0;
	parm8 = ad_IT_SHOTGUN;				// Current selected weapon (shotgun)
	parm10 = 0;						// AD MOD items
	
	// Update new player inventory based on config flag (quake.rc file)
	if (ad_query_configflag(ad_SVR_UPDAXE)) {
		parm1 = parm1 | ad_IT_AXE;
		parm10 = parm10 | ad_IT_UPGRADE_AXE;
		// Shadow axe and grapple do not exist together
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_GHOOK);
		parm8 = ad_IT_AXE;
	}
	if (ad_query_configflag(ad_SVR_UPDGHOOK)) {
		parm1 = parm1 | ad_IT_AXE;
		parm10 = parm10 | ad_IT_UPGRADE_GHOOK;
		// Shadow axe and grapple do not exist together
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_AXE);
		parm8 = ad_IT_AXE;
	}
	if (ad_query_configflag(ad_SVR_UPDSSG)) {
		parm1 = parm1 | ad_IT_SUPER_SHOTGUN;
		parm10 = parm10 | ad_IT_UPGRADE_SSG;
		parm8 = ad_IT_SUPER_SHOTGUN;
	}
	if (ad_query_configflag(ad_SVR_UPDLG)) {
		parm1 = parm1 | ad_IT_LIGHTNING;
		parm10 = parm10 | ad_IT_UPGRADE_LG;
		parm8 = ad_IT_LIGHTNING;
	}
	
	// Skill 4 always starts with Shadow Axe!
	if (ad_Client_QueryEvilmode()) { 
		parm1 = parm1 | ad_IT_AXE;
		parm10 = parm10 | ad_IT_UPGRADE_AXE;
		// Shadow axe and grapple do not exist together
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_GHOOK);
		parm8 = ad_IT_AXE;
	}
	// If a map wants NO axe start, then its likely been designed for it!
	// World entity is readable at this point. The No Axe start is also a
	// NO WEAPONS at all !?! (including any from previous map)
	else if (world.ad_no_axestart == ad_TRUE) { 
		parm1 = parm8 = 0;
	}
	
	// Are map variables live?
	if (ad_mapvar_cvar) dprint("\b[CLIENT]\b LIVE Map Variables Detected\n");
	else {
		dprint("\b[CLIENT]\b RESETTING Map Variables\n");
		// Reset map variables ready for use
		parm11 = parm12 = parm13 = parm14 = parm15 = parm16 = 0;
		ad_mapvar_reset();
	}
};

/*======================================================================
// USED : trigger CHANGE LEVEL
// Stores a copy of the parm data ready for death/level reset
======================================================================*/
void() ad_SetChangeParms =
{
	dprint("\n\b[CLIENT]\b SetChangeParms\n");
	// If player dead, do not update level parameters
	if (self.health < 1) { ad_SetNewParms (); return;	}

	// remove temporary items (keys and powerups)
	self.items = self.items - (self.items & ad_IT_ITEMRESET);
	parm1 = self.items;
	self.ad_moditems = self.ad_moditems - (self.ad_moditems & ad_IT_MODRESET);
	parm10 = self.ad_moditems;
	dprint("\b[CLIENT]\b MOD weapons ("); dprint(ftos(parm10)); dprint(")\n");
	
	// Make sure player HP is within Max range and not less 50%
	ad_Client_CheckMaxHP(self, ad_TRUE);
	// Save HP max
	parm2 = self.health;

	parm3 = self.armorvalue;
	parm9 = self.armortype * 100;

	// Always make sure the player has 25 shells
	if (self.ammo_shells < ad_DEF_SHELLS) parm4 = ad_DEF_SHELLS;
	else parm4 = self.ammo_shells;
	parm5 = self.ammo_nails;
	parm6 = self.ammo_rockets;
	parm7 = self.ammo_cells;

	if (self.items & ad_NO_WEAPONS) parm8 = 0;
	else parm8 = self.weapon;
	
	dprint("\b[CLIENT]\b SAVING Map Variables\n");
	// Save map variables (22 bits per parm, 132 total)
	parm11 = ad_mapvar[0]; parm12 = ad_mapvar[1]; parm13 = ad_mapvar[2];
	parm14 = ad_mapvar[3]; parm15 = ad_mapvar[4]; parm16 = ad_mapvar[5];
};

/*======================================================================
 USED : Load NEW MAP or trigger CHANGE LEVEL
 Not used when loading a saved file or quickload
======================================================================*/
void() ad_DecodeWorldParms =
{
	local float ad_parm_items;
	ad_parm_items = parm1;

	dprint("\b[CLIENT]\b Decode Worldspawn Inv Parms\n");
	//----------------------------------------------------------------------
	// Show developer feedback on player inventory update
	// no axe start is no weapons at all !?!
	if (world.ad_no_axestart) dprint("\b[CLIENT]\b No Axe start detected\n");
	if (world.ad_give_weapons) {
		dprint("\b[CLIENT]\b Weapon Give ( ");
		if (world.ad_give_weapons & ad_IT_SHOTGUN) dprint("SG ");
		if (world.ad_give_weapons & ad_IT_SUPER_SHOTGUN) dprint("SSG ");
		if (world.ad_give_weapons & ad_IT_NAILGUN) dprint("NG ");
		if (world.ad_give_weapons & ad_IT_SUPER_NAILGUN) dprint("SNG ");
		if (world.ad_give_weapons & ad_IT_GRENADE_LAUNCHER) dprint("GL ");
		if (world.ad_give_weapons & ad_IT_ROCKET_LAUNCHER) dprint("RL ");
		if (world.ad_give_weapons & ad_IT_LIGHTNING) dprint("LG ");
		dprint(")\n");
	}
	if (world.ad_take_weapons) {
		dprint("\b[CLIENT]\b Weapon Take ( ");
		if (world.ad_take_weapons & ad_IT_SHOTGUN) dprint("SG ");
		if (world.ad_take_weapons & ad_IT_SUPER_SHOTGUN) dprint("SSG ");
		if (world.ad_take_weapons & ad_IT_NAILGUN) dprint("NG ");
		if (world.ad_take_weapons & ad_IT_SUPER_NAILGUN) dprint("SNG ");
		if (world.ad_take_weapons & ad_IT_GRENADE_LAUNCHER) dprint("GL ");
		if (world.ad_take_weapons & ad_IT_ROCKET_LAUNCHER) dprint("RL ");
		if (world.ad_take_weapons & ad_IT_LIGHTNING) dprint("LG ");
		dprint(")\n");
	}
	
	//----------------------------------------------------------------------
	// Check for no axe/weapons start
	// Skill 4 always starts with Shadow Axe!
	if (world.ad_no_axestart == ad_TRUE && ad_Client_QueryEvilmode() == ad_FALSE) {
		// Remove all weapons, a no axe start is nothing!
		ad_parm_items = ad_parm_items - (ad_parm_items & ad_NO_WEAPONS);
		// Remove all AD upgrades
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_AXE);
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_SSG);
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_LG);
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_GHOOK);
	}
	else {
		//----------------------------------------------------------------------
		// Adding weapons to existing inventory
		if (world.ad_give_weapons) {
			ad_parm_items = ad_parm_items | (world.ad_give_weapons & ad_ALL_WEAPONS);		
		}
		//----------------------------------------------------------------------
		// Player always has the axe, it cannot be removed!
		if (world.ad_take_weapons > 0) {
			if (world.ad_take_weapons & ad_IT_SHOTGUN && ad_parm_items & ad_IT_SHOTGUN) 
				ad_parm_items = ad_parm_items - ad_IT_SHOTGUN; 
			if (world.ad_take_weapons & ad_IT_SUPER_SHOTGUN && ad_parm_items & ad_IT_SUPER_SHOTGUN) {
				ad_parm_items = ad_parm_items - ad_IT_SUPER_SHOTGUN;
				// Player cannot have upgrades without base item
				parm10 = parm10 - (parm10 & ad_IT_UPGRADE_SSG);
			}
			if (world.ad_take_weapons & ad_IT_NAILGUN && ad_parm_items & ad_IT_NAILGUN) 
				ad_parm_items = ad_parm_items - ad_IT_NAILGUN; 
			if (world.ad_take_weapons & ad_IT_SUPER_NAILGUN && ad_parm_items & ad_IT_SUPER_NAILGUN) 
				ad_parm_items = ad_parm_items - ad_IT_SUPER_NAILGUN; 
			if (world.ad_take_weapons & ad_IT_GRENADE_LAUNCHER && ad_parm_items & ad_IT_GRENADE_LAUNCHER) 
				ad_parm_items = ad_parm_items - ad_IT_GRENADE_LAUNCHER; 
			if (world.ad_take_weapons & ad_IT_ROCKET_LAUNCHER && ad_parm_items & ad_IT_ROCKET_LAUNCHER) 
				ad_parm_items = ad_parm_items - ad_IT_ROCKET_LAUNCHER; 
			if (world.ad_take_weapons & ad_IT_LIGHTNING && ad_parm_items & ad_IT_LIGHTNING) {
				ad_parm_items = ad_parm_items - ad_IT_LIGHTNING; 
				// Player cannot have upgrades without base item
				parm10 = parm10 - (parm10 & ad_IT_UPGRADE_LG);
			}
		}
	}
	
	// Store result back to global variable
	parm1 = ad_parm_items;
	
	// Check for Evil NM+ skill? (No changes allowed)
	if (ad_Client_QueryEvilmode() == ad_FALSE) {
		//----------------------------------------------------------------------
		// Update player health (RESET / MINimum value)
		if (world.ad_reset_health > 0 && world.ad_reset_health <= ad_HEAL_PLAYMAX) {
			dprint("\b[CLIENT]\b Reset Health ("); dprint(ftos(parm2)); dprint(") To (");
			parm2 = world.ad_reset_health;
			dprint(ftos(parm2)); dprint(")\n");	
		}
		else if (world.max_health > 0 && parm2 < world.max_health) {
			dprint("\b[CLIENT]\b Min Health ("); dprint(ftos(parm2)); dprint(") To (");
			if (parm2 < world.max_health) parm2 = world.max_health;
			dprint(ftos(parm2)); dprint(")\n");	
		}
		// Make sure RESET / MIN health does not exceed MAX health
		if (parm2 > self.max_health && self.max_health > 0) {
			dprint("\b[CLIENT]\b Max Health ("); dprint(ftos(parm2)); dprint(") To (");
			parm2 = self.max_health;
			dprint(ftos(parm2)); dprint(")\n");	
		}
	}
	
	//----------------------------------------------------------------------
	// Update the inventory ammo quantities
	// currentammo = 1 to reset the inventory to worldspawn values
	// currentammo = 0 to use the worldspawn values as a minimum quantity
	if (world.ammo_shells || (world.currentammo && parm4 > 0)) {
		dprint("\b[CLIENT]\b Ammo Shells ("); dprint(ftos(parm4)); dprint(") To (");
		if (world.currentammo) parm4 = world.ammo_shells;
		else if (parm4 < world.ammo_shells) parm4 = world.ammo_shells;
		if (parm4 > ad_AMMO_MAXSHELLS) parm4 = ad_AMMO_MAXSHELLS;
		else if (parm4 < 0) parm4 = 0;
		dprint(ftos(parm4)); dprint(")\n");	
	}
	if (world.ammo_nails || (world.currentammo && parm5 > 0)) {
		dprint("\b[CLIENT]\b Ammo Spikes ("); dprint(ftos(parm5)); dprint(") To (");
		if (world.currentammo) parm5 = world.ammo_nails;
		else if (parm5 < world.ammo_nails) parm5 = world.ammo_nails;
		if (parm5 > ad_AMMO_MAXNAILS) parm5 = ad_AMMO_MAXNAILS;
		else if (parm5 < 0) parm5 = 0;
		dprint(ftos(parm5)); dprint(")\n");	
	}
	if (world.ammo_rockets || (world.currentammo && parm6 > 0)) {
		dprint("\b[CLIENT]\b Ammo Rockets ("); dprint(ftos(parm6)); dprint(") To (");
		if (world.currentammo) parm6 = world.ammo_rockets;
		else if (parm6 < world.ammo_rockets) parm6 = world.ammo_rockets;
		if (parm6 > ad_AMMO_MAXROCKETS) parm6 = ad_AMMO_MAXROCKETS;
		else if (parm6 < 0) parm6 = 0;
		dprint(ftos(parm6)); dprint(")\n");	
	}
	if (world.ammo_cells || (world.currentammo && parm7 > 0)) {
		dprint("\b[CLIENT]\b Ammo Cells ("); dprint(ftos(parm7)); dprint(") To (");
		if (world.currentammo) parm7 = world.ammo_cells;
		else if (parm7 < world.ammo_cells) parm7 = world.ammo_cells;
		if (parm7 > ad_AMMO_MAXROCKETS) parm7 = ad_AMMO_MAXROCKETS;
		else if (parm7 < 0) parm7 = 0;
		dprint(ftos(parm7)); dprint(")\n");	
	}

	//----------------------------------------------------------------------
	// Update player armour type and quantity
	if (world.armortype > 0) {
		// Remove any previous armour types from the HUD
		parm1 = parm1 - (parm1 & (ad_IT_ARMOR1 | ad_IT_ARMOR2 | ad_IT_ARMOR3));
		// Setup any armour quantity first, limit check with armour type
		if (world.armorvalue > 0) parm3 = world.armorvalue;

		// Work through the different armour types, resetting armour quantity
		if (world.armortype == 1) {
			parm1 = parm1 | ad_IT_ARMOR1;	
			parm9 = ad_ARMOR_GRN_TYPE * 100;
			if (!world.armorvalue || parm3 > ad_ARMOR_GRN_VALUE) parm3 = ad_ARMOR_GRN_VALUE;
			dprint("\b[CLIENT]\b Green Armor ("); dprint(ftos(parm3)); dprint(")\n");
		}
		else if (world.armortype == 2) {
			parm1 = parm1 | ad_IT_ARMOR2;	
			parm9 = ad_ARMOR_YEL_TYPE * 100;
			if (!world.armorvalue || parm3 > ad_ARMOR_YEL_VALUE) parm3 = ad_ARMOR_YEL_VALUE;
			dprint("\b[CLIENT]\b Yellow Armor ("); dprint(ftos(parm3)); dprint(")\n");
		}
		else if (world.armortype == 3) {
			parm1 = parm1 | ad_IT_ARMOR3;	
			parm9 = ad_ARMOR_RED_TYPE * 100;
			if (!world.armorvalue || parm3 > ad_ARMOR_RED_VALUE) parm3 = ad_ARMOR_RED_VALUE;
			dprint("\b[CLIENT]\b Red Armor ("); dprint(ftos(parm3)); dprint(")\n");
		}
		// Default is no armour
		else parm3 = 0;
	}			
};

/*======================================================================
 USED : Load NEW MAP or trigger CHANGE LEVEL
 Double check the player inventory matches the server/config flags
 Check worldspawn for add/removal of upgrade items
======================================================================*/
void() ad_SyncModInventory =
{
	//----------------------------------------------------------------------
	// Shadow Axe
	//----------------------------------------------------------------------
	// Skill 4 has shadow axe, cannot be changed!
	if (ad_Client_QueryEvilmode() == ad_FALSE) {
		// Check worldspawn for upgrade_axe first, add/deny inventory
		if (world.ad_upgrade_axe < 0) {
			dprint("\b[MODINV]\b Worldspawn removing Axe Upgrade\n");
			parm10 = parm10 - (parm10 & ad_IT_UPGRADE_AXE);
			ad_update_configflag(ad_SVR_UPDAXE, ad_FALSE);
		}
		else if (world.ad_upgrade_axe > 0) {
			dprint("\b[MODINV]\b Worldspawn adding Axe Upgrade\n");
			parm10 = parm10 | ad_IT_UPGRADE_AXE;
			parm1 = parm1 | ad_IT_AXE;
			ad_update_configflag(ad_SVR_UPDAXE, ad_TRUE);
			// Cannot have Shadow Axe AND Grapple Hook
			if (parm10 & ad_IT_UPGRADE_GHOOK) {
				dprint ("\b[MODINV]\b Removing Grapple Hook!\n");
				parm10 = parm10 - (parm10 & ad_IT_UPGRADE_GHOOK);
				ad_update_configflag(ad_SVR_UPDGHOOK, ad_FALSE);
			}
		}
		// Finally syncing the player inventory to serverflags
		else if (parm10 & ad_IT_UPGRADE_AXE) {
			dprint("\b[MODINV]\b Inventory adding Axe Upgrade\n");
			ad_update_configflag(ad_SVR_UPDAXE, ad_TRUE);
		}
	}
	
	//----------------------------------------------------------------------
	// Grapple Hook
	//----------------------------------------------------------------------
	// Skill 4 has shadow axe, cannot have grapple hook!
	if (ad_Client_QueryEvilmode() == ad_FALSE) {
		// Check worldspawn for upgrade_ghook first, add/deny inventory
		if (world.ad_upgrade_ghook < 0) {
			dprint("\b[MODINV]\b Worldspawn removing Grapple Hook\n");
			// FIXME : removing the grapple hook without adding back the axe
			// is a dangerous situation because both use the same (axe) slot
			parm10 = parm10 - (parm10 & ad_IT_UPGRADE_GHOOK);
			ad_update_configflag(ad_SVR_UPDGHOOK, ad_FALSE);
		}
		else if (world.ad_upgrade_ghook > 0) {
			dprint("\b[MODINV]\b Worldspawn adding Grapple Hook\n");
			parm10 = parm10 | ad_IT_UPGRADE_GHOOK;
			parm1 = parm1 | ad_IT_AXE;
			ad_update_configflag(ad_SVR_UPDGHOOK, ad_TRUE);
			// Cannot have Shadow Axe AND Grapple Hook
			if (parm10 & ad_IT_UPGRADE_AXE) {
				dprint ("\b[MODINV]\b Removing Shadow Axe!\n");
				parm10 = parm10 - (parm10 & ad_IT_UPGRADE_AXE);
				ad_update_configflag(ad_SVR_UPDAXE, ad_FALSE);
			}
		}
		// Finally syncing the player inventory to serverflags
		else if (parm10 & ad_IT_UPGRADE_GHOOK) {
			dprint("\b[MODINV]\b Inventory adding Grapple Hook\n");
			ad_update_configflag(ad_SVR_UPDGHOOK, ad_TRUE);
		}
	}

	//----------------------------------------------------------------------
	// Widowmaker Shotgun
	//----------------------------------------------------------------------
	// Check worldspawn for upgrade_ssg first, add/deny inventory
	if (world.ad_upgrade_ssg < 0) {
		dprint("\b[MODINV]\b Worldspawn removing SSG Upgrade\n");
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_SSG);
		ad_update_configflag(ad_SVR_UPDSSG, ad_FALSE);
	}
	else if (world.ad_upgrade_ssg > 0) {
		dprint("\b[MODINV]\b Worldspawn adding SSG Upgrade\n");
		parm10 = parm10 | ad_IT_UPGRADE_SSG;
		parm1 = parm1 | ad_IT_SUPER_SHOTGUN;
		ad_update_configflag(ad_SVR_UPDSSG, ad_TRUE);
	}
	// Syncing the player inventory to serverflags
	else if (parm10 & ad_IT_UPGRADE_SSG) {
		dprint("\b[MODINV]\b Inventory adding SSG Upgrade\n");
		ad_update_configflag(ad_SVR_UPDSSG, ad_TRUE);
	}

	//----------------------------------------------------------------------
	// Projectile Shotgun
	//----------------------------------------------------------------------
	// Check for worldspawn feature to turn off projectiles + casing
	if (world.ad_no_sgprojectile > 0) 
		ad_update_configflag(ad_SVR_SHOTGPROJ, ad_TRUE);
	if (world.ad_no_sgcasing > 0)
		ad_update_configflag(ad_SVR_SHOTGCASE, ad_TRUE);

	//----------------------------------------------------------------------
	// Plasma Gun
	//----------------------------------------------------------------------
	// Check worldspawn for upgrade_lg first, add/deny inventory
	if (world.ad_upgrade_lg < 0) {
		dprint("\b[MODINV]\b Worldspawn removing LG Upgrade\n");
		parm10 = parm10 - (parm10 & ad_IT_UPGRADE_LG);
		ad_update_configflag(ad_SVR_UPDLG, ad_FALSE);
	}
	else if (world.ad_upgrade_lg > 0) {
		dprint("\b[MODINV]\b Worldspawn adding LG Upgrade\n");
		parm10 = parm10 | ad_IT_UPGRADE_LG;
		parm1 = parm1 | ad_IT_LIGHTNING;
		ad_update_configflag(ad_SVR_UPDLG, ad_TRUE);
	}
	// Finally syncing the player inventory to serverflags
	else if (parm10 & ad_IT_UPGRADE_LG) {
		dprint("\b[MODINV]\b Inventory adding LG Upgrade\n");
		ad_update_configflag(ad_SVR_UPDLG, ad_TRUE);
	}
};

/*======================================================================
 USED : Load NEW MAP or trigger CHANGE LEVEL
 Not used when loading a saved file or quickload
======================================================================*/
void() ad_DecodeLevelParms =
{
	dprint("\b[CLIENT]\b Decode (Level) Parms\n");
	// Map Variables are active (do not reset)
	ad_mapvar_cvar = ad_TRUE;
	// Found any runes? going back to start map? reset inventory
	if (serverflags & ad_SVR_RUNE_ALL) {
		// take away all stuff on starting new episode
		if (world.model == "maps/start.bsp") ad_SetNewParms ();
	}
	
	// Most Quake Engines resets the skill level to 0-3 only
	// Make sure skill level/console variable are updated on load
	ad_Client_SyncPrevEvilmode();

	ad_DecodeWorldParms();		// Decode worldspawn client inv updates
	ad_sync_serverflags();		// update/sync serverflags to worldspawn
	ad_SyncModInventory();		// update/sync mod inventory items

	// Read all current params into client variables
	self.items = parm1;
	self.health = parm2;
	// Always make sure the HP read from parm2 is within range!
	// Parm2 is re-used when map restart command is issued
	ad_Client_CheckMaxHP(self, ad_FALSE);

	self.ammo_shells = parm4;
	self.ammo_nails = parm5;
	self.ammo_rockets = parm6;
	self.ammo_cells = parm7;
	
	// Double check there is weapons in the inventory
	if (self.items & ad_NO_WEAPONS) self.weapon = 0;
	else self.weapon = parm8;
	
	self.armortype = parm9 * 0.01;
	self.armorvalue = parm3;

	self.ad_moditems = parm10;
	// The AD inventory is reset with parm10 (could lose Shadow axe)
	// Check for evil skill and add shadow axe + make current weapon!
	ad_Client_CheckEvilInv(self);
	
	dprint("\b[CLIENT]\b Reading Map Variables\n");
	// Read/Setup map variables (22 bits per parm, 132 total)
	ad_mapvar[0] = parm11; ad_mapvar[1] = parm12; ad_mapvar[2] = parm13;
	ad_mapvar[3] = parm14; ad_mapvar[4] = parm15; ad_mapvar[5] = parm16;
	
	// Check for any worldspawn map variable settings
	if (ad_CheckZeroVector(world.ad_mapvar_update) == ad_FALSE)
		ad_mapvar_range(world.ad_mapvar_update);
};

//----------------------------------------------------------------------
void() ad_GotoNextMap =
{
	// if samelevel is set, stay on same level
	if (cvar("samelevel")) changelevel (mapname);
	else changelevel (ad_nextmap);
};

/*======================================================================
 NextLevel (DM ONLY)
 - A special function designed for MP only, will cycle around
   the first map of each episode until someone quits
   gives the player runes as well to tell which to load
======================================================================*/
void() ad_NextLevel =
{
	local entity ad_o;

	if (mapname == "start") {
		if (!cvar("registered")) mapname = "e1m1";
		else if (ad_query_configflag(ad_SVR_RUNE_KEY1) == ad_FALSE) {
			mapname = "e1m1";
			ad_update_configflag(ad_SVR_RUNE_KEY1, ad_TRUE);
		}
		else if (ad_query_configflag(ad_SVR_RUNE_KEY2) == ad_FALSE) {
			mapname = "e2m1";
			ad_update_configflag(ad_SVR_RUNE_KEY1, ad_TRUE);
		}
		else if (ad_query_configflag(ad_SVR_RUNE_KEY3) == ad_FALSE) {
			mapname = "e3m1";
			ad_update_configflag(ad_SVR_RUNE_KEY1, ad_TRUE);
		}
		else if (ad_query_configflag(ad_SVR_RUNE_KEY4) == ad_FALSE) {
			mapname = "e4m1";
			ad_update_configflag(ad_SVR_RUNE_KEY1, ad_FALSE);
			ad_update_configflag(ad_SVR_RUNE_KEY2, ad_FALSE);
			ad_update_configflag(ad_SVR_RUNE_KEY3, ad_FALSE);
		}

		ad_o = spawn();
		ad_o.map = mapname;
	}
	else {
		// find a trigger changelevel
		ad_o = find(world, classname, "trigger_changelevel");

		// go back to start if no trigger_changelevel
		if (!ad_o) {
			mapname = "start";
			ad_o = spawn();
			ad_o.map = mapname;
		}
	}

	ad_nextmap = ad_o.map;
	ad_gameover = ad_TRUE;
	
	if (ad_o.nextthink < time) {
		ad_o.think = ad_trigger_changelevel_finish;
		ad_o.nextthink = time + 0.1;
	}
};

/*======================================================================
 CheckRules (DM ONLY)
 - Check death timers (time/frag limits)
   and decide if to load a new map or not
======================================================================*/
void() ad_CheckRules =
{
	local float ad_timelimit, ad_fraglimit;

	if (deathmatch == 0) return;	// Playing SP?
	if (ad_gameover) return;			// someone else quit the game already
		
	ad_timelimit = cvar("timelimit") * 60;
	ad_fraglimit = cvar("fraglimit");
	
	if (ad_timelimit && time >= ad_timelimit) ad_NextLevel();
	else if (ad_fraglimit && self.frags >= ad_fraglimit) ad_NextLevel();
};

//----------------------------------------------------------------------
void() ad_SetupSpawnCoopLocations =
{
	local entity ad_cooploc, ad_prevloc;
	
	// The first spawn for coop is always the SP start location
	ad_cooploc = find (world, classname, "info_player_coop");
	ad_prevloc = world;
	
	// Any coop spawns exist?
	if (ad_cooploc) {
		// Create a list
		while(ad_cooploc) {
			// first spawn in chain? setup first and previous spawns
			if (!ad_prevloc) { 
				ad_coop_ent = ad_cooploc; 
				ad_coop_ent.count = 0;
			}
			else ad_prevloc.owner = ad_cooploc;

			// Save current spawn location to previous ready for loop
			ad_prevloc = ad_cooploc;
			ad_coop_ent.count = ad_coop_ent.count + 1;
				
			ad_cooploc = find(ad_cooploc, classname, "info_player_coop");
		}
		// Close the chain
		ad_prevloc.owner = ad_coop_ent;
		dprint("\b[COOP]\b Spawn locations found (");
		dprint(ftos(ad_coop_ent.count)); dprint(")\n");
	}
	else {
		// No coop spawns, use start location
		dprint("\b[COOP]\b Spawn locations Missing!\n");
		ad_coop_ent = find (world, classname, "info_player_start");
		// no start location, WTF!?!
		if (!ad_coop_ent) ad_coop_ent = ad_client_ent;
		ad_coop_ent.owner = ad_coop_ent;
	}
};

//----------------------------------------------------------------------
// Find a location for the player to spawn at
//----------------------------------------------------------------------
entity() ad_SelectSpawnPoint =
{
	local entity ad_spot, ad_thing;
	local float  ad_pcount, ad_start2, ad_runeactive;
	
	// Always use a player start as default position
	if (!ad_lastspawn) ad_lastspawn = find (world, classname, "info_player_start");

	// Test this first because its such a restrictive set of condition
	if (ad_developer > 0 && coop == 0 && deathmatch == 0) {
		ad_spot = find( world, classname, "info_player_startdev");
		if (ad_spot) {
			dprint ("\b[CLIENT_SPAWN]\b Developer only start!\n");
			return ad_spot;
		}
	}
	
	// Cycle through list of info_player_coop location
	if (coop > 0) {
		// Check for coop spawn list
		if (!ad_coop_ent) return ad_lastspawn;
		// If first entry of coop list start player then its broken
		else if (ad_coop_ent.ad_classtype == ad_CT_SPAWNSP) return ad_lastspawn;
		else {
			// Setup coop list if last location isstart player
			if (ad_lastspawn.ad_classtype == ad_CT_SPAWNSP) ad_lastspawn = ad_coop_ent;
			// Move forward in coop spawn location list
			ad_lastspawn = ad_lastspawn.owner;
			// Check if spawn location is active?
			if (ad_lastspawn.ad_estate & ad_ESTATE_BLOCK) {
				ad_pcount = ad_coop_ent.count;
				while(ad_pcount > 0) {
					ad_lastspawn = ad_lastspawn.owner;
					if (ad_lastspawn.ad_estate == ad_ESTATE_ON) ad_pcount = -1;
					else ad_pcount = ad_pcount - 1;
				}
			}
			// Double check if spawn location free?
			if (ad_lastspawn.ad_estate & ad_ESTATE_BLOCK) {
				// Default back to player start if not available
				ad_lastspawn = find (world, classname, "info_player_start");
			}
			return ad_lastspawn;
		}
	}
	// choose a info_player_deathmatch point
	else if (deathmatch > 0) {
		ad_spot = ad_lastspawn;
		while (1) {
			ad_spot = find(ad_spot, classname, "info_player_deathmatch");
			if (ad_spot == world) ad_spot = find (world, classname, "info_player_start");
			if (ad_spot != world) {
				if (ad_spot == ad_lastspawn) return ad_lastspawn;
				ad_pcount = 0;
				ad_thing = findradius(ad_spot.origin, 32);
				while(ad_thing) {
					if (ad_thing.flags & ad_FL_CLIENT) ad_pcount = ad_pcount + 1;
					ad_thing = ad_thing.chain;
				}
				if (ad_pcount == 0) {
					ad_lastspawn = ad_spot;
					return ad_spot;
				}
			}
		}
	}

	// Check for any info_player_start2 special spawn locations
	if (ad_query_configflag(ad_SVR_SPAWN_BIT1) > 0) ad_start2 = 1;
	else ad_start2 = 0;
	if (ad_query_configflag(ad_SVR_SPAWN_BIT2) > 0) ad_start2 = ad_start2 + 2;
	if (ad_query_configflag(ad_SVR_SPAWN_BIT3) > 0) ad_start2 = ad_start2 + 4;
	if (ad_start2 > 0) dprint("\b[CLIENT]\b Unique Info_Player_Start2 Active\n");
	
	// Check for any runes active
	ad_runeactive = ad_query_configflag(ad_SVR_RUNE_ALL);
	
	// have a rune or new spawnflag option?
	if ( ad_runeactive > 0 || ad_start2 > 0 ) {
		// Find second spawn locations (can have several)
		ad_spot = find (world, classname, "info_player_start2");
		while (ad_spot) {
			// Check for rune only start 2 setup
			if (ad_runeactive > 0 && ad_spot.ad_startspawn2 == 0)
				return ad_spot;
			// Check for special spawn2 location
			else if (ad_spot.ad_startspawn2 == ad_start2)
				return ad_spot;
			// Keep searching for start2 positions
			ad_spot = find(ad_spot, classname, "info_player_start2");
		}
	}
	
	// Last chance to find a spawn location before giving up!
	ad_spot = find (world, classname, "info_player_start");
	if (!ad_spot) dprint ("\b[CLIENT_SPAWN]\b missing info_player_start!\n");
	
	return ad_spot;
};

//----------------------------------------------------------------------
// PutClientInServer - called each time a player is spawned
//----------------------------------------------------------------------
void() ad_PutClientInServer =
{
	local entity ad_spot;

	dprint("\b[CLIENT]\b PutClientInServer\n");
	ad_client_ent = self;
	self.classname = "player";
	self.ad_classtype = ad_CT_PLAYER;
	self.ad_classgroup = ad_CG_PLAYERS;
	self.flags = ad_FL_CLIENT;
	// This entity can never be switched off
	self.ad_estate = ad_ESTATE_ON;
	self.ad_estate_off = ad_SUB_Null;

	// Reset intermission/cinematic stuff
	ad_intermission_running = ad_cinematic_running = 0;
	
	// Check for Evil NM+ skill level (Lower HP max)
	if (ad_Client_QueryEvilmode()) ad_Client_SetupEvilmode();
	// Update health/mega max and leave weapons alone
	else ad_Client_ResetEvilmode(-1);

	// Setup entity chains for coop, dm and intermission
	ad_SetupSpawnCoopLocations();
	ad_SetupIntermissionCamera();

	// Find a spawn location in the map
	ad_spot = ad_SelectSpawnPoint ();
	// Fire any targets on spawn location
	if (ad_spot.target) self.ad_target2 = ad_spot.target;
	else self.ad_target2 = "";
	// Copy over any cinematic camera start sequences
	if (ad_spot.ad_cameratarget) self.ad_cameratarget = ad_spot.ad_cameratarget;

	self.ad_headmdl = ad_MODEL_PLAYER_HEAD;
	self.takedamage = ad_DAMAGE_AIM;
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_WALK;
	self.ad_classmove = ad_MON_MOVEWALK;
	self.ad_show_hostile = 0;
	self.ad_gibhealth = -40;
	self.ad_gibbed = ad_FALSE;
	self.ad_air_finished = time + ad_WATER_AIR;
	self.dmg = ad_WATER_DAMAGE;
	self.effects = 0;
	self.ad_steplast = 1;
	self.jump_flag = 0;
	self.ad_oldgravity = 0;				// Reset gravity effects
	
	self.ad_steptype = ad_FS_TYPEMEDIUM;		// Standard feet sounds
	self.ad_suppressCenterPrint = ad_FALSE;	// No centerprint active

	// Check if Arcane Key Inventory message is blocked/suppressed
	if (world.ad_ckeyhint == ad_TRUE) self.ad_ckeyhint = ad_TRUE;
	
	ad_ResetPowerSystem(self,0,ad_FALSE);		// Remove powerup effects (not vania)
	ad_ResetDebuffSystem(self);			// Reset/initialize debuff system

	self.enemy = world;
	ad_DecodeLevelParms ();
	// Evil Mode should always start with the AXe!
	if (ad_Client_QueryEvilmode()) self.weapon = ad_IT_AXE;
	else self.weapon = ad_W_BestWeapon (self);	// Pick best weapon from inventory
	ad_W_SetCurrentAmmo (self);			// Update hud icons and v_model

	self.ad_attack_finished = time;
	self.ad_th_pain = ad_player_pain;
	self.ad_th_die = ad_player_death;
	
	self.deadflag = ad_DEAD_NO;			// The player is alive!
	self.ad_pausetime = 0;					// make sure player has 0 velocity when spawning

	ad_update_hud_totals(ad_HUD_MONSTERS);	// Make screen total is correct
	ad_update_hud_totals(ad_HUD_SECRETS);		// Update monsters and secrets

	// Reset randomizer counters
	self.ad_randomshells = self.ad_randomcells = 0;
	
	//	spot = SelectSpawnPoint ();
	self.origin = ad_spot.origin + '0 0 1';
	if (ad_spot.mangle) self.angles = ad_spot.mangle;
	else self.angles = ad_spot.angles;
	self.v_angle = self.angles;
	self.fixangle = ad_TRUE;				// turn this way immediately

	// oh, this is a hack!
	setmodel (self, ad_MODEL_PLAYER_EYES);
	ad_modelindex_eyes = self.modelindex;

	setmodel (self, ad_MODEL_PLAYER);
	ad_modelindex_player = self.modelindex;

	self.ad_bbmins = ad_VEC_HULLSHORT_MIN;	// -16 -16 -24, 16 16 32
	self.ad_bbmaxs = ad_VEC_HULLSHORT_MAX;
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
	// Where the feet are! 22 units below!
	self.view_ofs = '0 0 22';
	ad_player_stand1 ();

	// Check for cinematic system startup (NO COOP!!!)
	if (self.ad_cameratarget != "" && coop == 0) {
		// Find first camera
		self.enemy = find(world, targetname, self.ad_cameratarget);
		if (self.enemy.ad_classtype == ad_CT_MISCCAM) {
			ad_cam_focus = self.enemy;			// Camera
			ad_cam_client = self;				// Player
			ad_cam_startup = ad_TRUE;				// Special start
			ad_cam_active = ad_CINECAM_SETUP;		// Lets begin!
		}
	}
	// Default
	else {
		// gib anything in the way
		if (deathmatch || coop) {
			makevectors(self.angles);
			ad_spawn_tfog (self.origin + v_forward*20);
		}
		// Teleport effect + sound
		ad_spawn_tdeath (self.origin, self);
	}	
};

// Forward compiler links
void() ad_PlayerJump;
void() ad_WaterMove;
void() ad_CheckWaterJump;
void() ad_ClientDeath;

//----------------------------------------------------------------------
void(entity ad_targ) ad_Client_LadderSounds =
{
	local float ad_rndsound;
	if (ad_query_configflag(ad_SVR_FOOTSTEP) == ad_TRUE) return;
	if (ad_targ.ad_entladder.sounds == 4) return;
	
	ad_rndsound = random();
	if (ad_rndsound < 0.25 && ad_targ.ad_entladder.noise1) 
		sound (ad_targ, ad_CHAN_BODY, ad_targ.ad_entladder.noise1, 1, ad_ATTN_NORM);
	else if (ad_rndsound < 0.5 && ad_targ.ad_entladder.noise2) 
		sound (ad_targ, ad_CHAN_BODY, ad_targ.ad_entladder.noise2, 1, ad_ATTN_NORM);
	else if (ad_rndsound < 0.75 && ad_targ.ad_entladder.noise3) 
		sound (ad_targ, ad_CHAN_BODY, ad_targ.ad_entladder.noise3, 1, ad_ATTN_NORM);
	else if (ad_targ.ad_entladder.noise4) 
		sound (ad_targ, ad_CHAN_BODY, ad_targ.ad_entladder.noise4, 1, ad_ATTN_NORM);
};

//----------------------------------------------------------------------
// PlayerPreThink - Called every frame before physics are run
//----------------------------------------------------------------------
void() ad_PlayerPreThink =
{
	//----------------------------------------------------------------------
	// This is just a fucked up messy situation ...
	// The savegame data is not live until after frame 0 has finished
	// The only variable read from a savegame early is skill level!
	// So instead of detecting Chaos mode changes at frame 0 and fixing them
	// have to wait for savegame data to be live and client/server stable
	// This function also detects savegames (framecount>0)
	if (ad_chaoscount <= 2) {
		// Increase counter early because of return later
		ad_chaoscount = ad_chaoscount + 1;
		// Save games don't usually start at framecount 0
		if (ad_framecount > ad_RND_FRAMECOUNT) {
			// Catch quickload (read 'oskill') and reset skill level
			ad_Client_SyncPrevEvilmode();

			// Detect skill 4 + Chaos savegame!
			// Cannot kill player here, client is not properly setup
			if (ad_rnd_CheckNoQuickLoad()) {
				dprint("\b[RND_SYNC]\b FC ("); dprint(ftos(ad_framecount));
				dprint(") Skill 4 death detected!\n");
				// Stop this function and wait for postclient
				ad_chaoscount = 10;
				// Make sure death happens in PostClient check
				ad_framecount = ad_framecount + ad_RND_FRAMECOUNT;
			}
			else {
				// Save game found, highlight on dev console
				dprint("\b[RND_SYNC]\b FC ("); dprint(ftos(ad_framecount));
				dprint(") Save Game Found!\n");
			}
		}
		// Wait for frame1 to validate current/savegame chaos setup
		// The Restart command cannot be done on frame 0
		// It will break the client/server setup sequence
		if (ad_chaoscount == 2) {
			// Returns true if restart required
			if (ad_rnd_CheckSaveGameReboot()) {
				// Works better if restart here instead of above function
				// Cannot use map or changelevel command because of savegame
				localcmd ("restart\n");
				// Block any pre/post functions
				ad_prethink = ad_postthink = ad_TRUE;
				// Finish PlayerPreThink function
				return;
			}
		}
	}
	
	//----------------------------------------------------------------------
	// Once the map has loaded (frame>0) set loadflag (never saved)
	if (ad_prethink == ad_FALSE) {
		ad_prethink = ad_TRUE;			// prethink flag complete
		ad_postthink = ad_FALSE;			// postthink flag reset
		ad_sync_configflag();			// Setup and sync serverflag
		// Some clients load faster, prevent player gasping for air
		self.ad_air_finished = time + ad_WATER_AIR;

		// Double check which engine is active?
		// A DP/FTE Quickload could be happening and the
		// Particle system needs to cope with the change
		ad_ext_active = cvar("pr_checkextension");
		if (!ad_ext_active) {
			// Revert to default = Fitz engine setup
			ad_engine = ad_ENG_FITZ;
			ad_ext_dppart = ad_ext_dpfog = ad_ext_dpsurf = ad_FALSE;
			ad_ext_dprain = ad_ext_dpsnow = ad_FALSE;
		}
		
		// Check for trigger CD track/Skybox change
		// Load/Quickload does not keep track of these changes
		// Use a new global variable instead
		if (ad_trig_cdtrack > 0) ad_trigger_cdtrack_change();
		if (ad_trig_skybox != "") ad_trigger_skybox_change(self);
		
		// Check for server gravity changes
		if (ad_map_gravity != ad_DEF_GRAVITY) {
			cvar_set("sv_gravity", ftos(ad_map_gravity));
		}		
	}

	//----------------------------------------------------------------------
	// If Intermission system active check for button0-2 keys
	if (ad_intermission_running > 0) { ad_impulse_notvalid(); ad_CycleIntermissionCamera(); return; }
	// If secret location camera active check for button0-2 keys
	if (ad_secloc_running > 0) { ad_impulse_notvalid(); ad_CheckSecretCamera(); return; }
	// Update particle emitter origin attached to the player
	// Cinematic camera uses player and this should be before it
	if (self.ad_entactive && self.ad_entattachment) 
		setorigin(self.ad_entattachment, self.origin);
	// If cinematic camera system active
	if (ad_cinematic_running > 0) { ad_impulse_notvalid(); return; }

	//----------------------------------------------------------------------
	// Skill 4 - Detect ANY skill changes (player console)
	//----------------------------------------------------------------------
	if (ad_skill != ad_oskill) {
		// Check if Evil skill enabled? (check skill NOT cvar)
		if (ad_Client_QueryEvilskill()) {
			// Reset HP + Max/Mega and give Shadow Axe
			ad_Client_SetupEvilmode();
			ad_Client_DispEvilmsg();
		}
		// Reset HP/Max (check worldspawn for override)
		else ad_Client_ResetEvilmode(ad_oskill);
		// Sync old and new skill variables
		ad_oskill = ad_skill;
	}
	
	//----------------------------------------------------------------------
	makevectors (self.v_angle);	
	ad_CheckRules ();
	ad_WaterMove ();
	
	// Hacky way to make the player move out of water
	if (self.waterlevel == 2) ad_CheckWaterJump ();
	// Start dying process
	if (self.deadflag >= ad_DEAD_DEAD) {
		ad_ClientDeath ();
		return;
	}
	// dying, so do nothing
	if (self.deadflag == ad_DEAD_DYING) return;

	//----------------------------------------------------------------------
	// The jump boots can be setup to work a limited amount of uses before
	// having to be reset by landing on the ground.
	// The starting (1st jump) sequence for the boots is always with a jump,
	// but the player can fall off ledges without jumping.
	// Unfortunately Quake does not let the player jump if falling, but
	// the jump boots should override this behaviour.
	// The engine will reset the fl_onground flag when the player falls
	// off a ledge and this flag is used to determine the starting sequence
	// for the jump boots.
	// This check is outside of the jump function so that the jump
	// boots can always be reset regardless if jump starts the sequence.
	//----------------------------------------------------------------------
	if (self.ad_moditems & ad_IT_ARTJUMPBOOTS && self.flags & ad_FL_ONGROUND) 
		self.ad_jumpboots_onground = ad_TRUE;
	
	// Check Grapple Hook (release/beam/jump)
	ad_GrappleHook_Client();

	//----------------------------------------------------------------------
	// Rubicon Ladder Code - johnfitz
	// Modified by me to support diff climb sounds and on/off/toggle states
	//----------------------------------------------------------------------
	if (self.ad_onladder == ad_LADDER_JUMP) {
		// Reset ladder touch function
		self.ad_onladder = ad_LADDER_NONE;
		if (ad_ext_fteskin && self.ad_entladder.skin == -16) {
			// Only do the ladder sound if the player is moving (X/Y)
			if (self.ad_timeladder < time && self.velocity_x != 0 && self.velocity_y != 0) {
				// Reset timer for next sound to play
				self.ad_timeladder = time + self.ad_entladder.waitmin;
				// Check for any sounds and query if footsteps are active
				ad_Client_LadderSounds(self);
			}
		}
		// Is jump key being pressed?
		else if (self.button2) {
			// Reset velocity upwards and all sideways movement
			// so that the player stays on the ladder and climbs
			// straight up with very little sidways movement
			self.velocity = '0 0 0';
			self.velocity_z = self.ad_entladder.speed;
			self.gravity = 0.0000001;

			if (self.ad_timeladder < time) {
				// Reset timer for next sound to play
				self.ad_timeladder = time + self.ad_entladder.waitmin;
				// Check for any sounds and query if footsteps are active
				ad_Client_LadderSounds(self);
			}
		}
		else {
			// Jump key released, stay floating on the ladder
			self.flags = self.flags | ad_FL_JUMPRELEASED;
			self.velocity = 0.9 * self.velocity;
			self.velocity_z = 0;
		}
	}
	else if (self.ad_onladder == ad_LADDER_VEL) {
		// Is jump key being pressed?
		if (self.button2) {
			self.ad_blockladder = time + 0.1;
			self.flags = self.flags - ad_FL_ONGROUND;
			ad_PlayerJump ();
		}
		else self.flags = self.flags | ad_FL_JUMPRELEASED;
		// Reset ladder touch function
		self.ad_onladder = ad_LADDER_NONE;
	}
	else {
		// Reset any ladder gravity settings
		if (self.ad_oldgravity > 0) self.gravity = self.ad_oldgravity;
		else self.gravity = 1;

		// Original jump conditions
		if (self.button2) ad_PlayerJump ();
		else self.flags = self.flags | ad_FL_JUMPRELEASED;
	}
	
	//----------------------------------------------------------------------
	// When the player/client starts in the map they don't want any velocity	
	if (time < self.ad_pausetime) self.velocity = '0 0 0';
};
	
//----------------------------------------------------------------------
// PlayerPostThink - Called every frame after physics are run
//----------------------------------------------------------------------
void() ad_PlayerPostThink =
{
	if (ad_prethink == ad_TRUE && ad_postthink == ad_FALSE) {
		// Check for the player? 
		// - first couple of frames the player is not setup correctly
		if (self.flags & ad_FL_CLIENT) {
			ad_postthink = ad_TRUE;			// postthink flag complete
			ad_mapvar_cvar = ad_TRUE;			// Map Variable are live

			// Cannot load skill 4 + Chaos save games!
			// Only kill the player once the client/server is setup
			// This also catches the savegame resetting Chaos mode
			if (ad_rnd_CheckNoQuickLoad() && ad_framecount > ad_RND_FRAMECOUNT) {
				// Classic death message
				self.deathtype = "loadingevil";
				ad_centerprint(self,"Cannot resurrect EVIL mode!?!\n");
				ad_T_Damage(self, world, world, ad_MEGADEATH, ad_NOARMOR);
				return;
			}

			// Reset any screen cshift parameters, eng often leaves them
			if (!self.ad_cshift_upd) self.ad_cshift_time = -1;
			
			// Check worldspawn water alpha parameters?
			// liquid alpha is used by the monster visible system
			if (world.ad_water_alpha) {
				ad_liquid_alpha = world.ad_water_alpha;
				stuffcmd(self, "\nr_wateralpha ");
				ad_lftos(self, ad_liquid_alpha ,1,3, ad_BUFFER_STUFFCMD);
				stuffcmd(self, "\n");
				dprint("\b[CLIENT]\b Water Alpha (");
				ad_lftos(self, ad_liquid_alpha ,1,3, ad_BUFFER_DPRINT);
				dprint(")\n");
				
			}
			else ad_liquid_alpha = cvar("r_wateralpha");	

			// Check engine for actual autoaim setting
			// Always reset with newgame and quickload
			ad_autoaim_cvar = cvar("sv_aim");
			
			// AD 1.8 removed SVR_NOFOGCMDS (winquake idea)
			// Create fog controller and/or update engine fog
			if (ad_fog_active) ad_change_fog(self);
			else ad_setup_fog_controller();
			// Sky fog is a different system (only density)
			if (ad_skyfog_active) ad_change_skyfog(self);
			else ad_setup_skyfog_controller();
			
			// Update console with MOD settings
			//showbits_configflag();
			ad_display_configflag();
			ad_display_version();	
			
			// Warn about chaos mode
			ad_warning_chaosmode();
		}
	}

	// Special systems that pause the QC/Game
	if (ad_intermission_running > 0) return;
	if (ad_secloc_running > 0) return;
	if (ad_cinematic_running > 0) {
		// The focalpoint system is about tracking an entity while the camera
		// is stationary or moving and updating the player viewing angle.
		// The current (2019) community client engines default protocol's are
		// 15 or 666, which unfortunately do not support smooth angle updates.
		// The ideal solution is protocol 999 with higher FP resolution,
		// but this has to be set before the map is loaded and manually
		// via the console which is not user friendly.
		//
		// The updates to player angle/origin were tested in both pre/post
		// QC functions and no difference in visuals could be detected
		// Some engines (QSS/FTE/DP) cope with angle updates better than
		// others (Fitz/QS/MakV) and using protocol 999 certainly helps
		//
		if (ad_cam_client == self && ad_cam_locked) {
			// Camera tracking system?
			if (ad_cam_movement) {
				// Finished moving the tracking entity?
				if (ad_cam_track.ad_attack_finished < time) {
					// Don't reset origin if at 0,0,0 (usually error)
					if (!ad_CheckZeroVector(ad_cam_track.enemy.origin))
						setorigin(self, ad_cam_track.enemy.origin);
					ad_cam_movement = ad_FALSE;
				}
				// Update camera (player) origin
				else {
					// Bezier Curve movement
					if (ad_cam_bezier) {
						ad_cam_track.delay = ad_cam_track.wait - (ad_cam_track.ad_attack_finished - time);
						ad_cam_track.origin = ad_bezier_curve(ad_cam_track.ad_pos4, ad_cam_track.ad_pos5, ad_cam_track.ad_pos6, ad_cam_track.wait, ad_cam_track.delay);
						// Don't reset origin if at 0,0,0 (usually error)
						if (!ad_CheckZeroVector(ad_cam_track.origin))
							setorigin(self, ad_cam_track.origin);
					}
					// Linear movement
					else {
						// Don't reset origin if at 0,0,0 (usually error)
						if (!ad_CheckZeroVector(ad_cam_track.origin))
							setorigin(self, ad_cam_track.origin);
					}
				}
			}

			// Does the camera have to focus on angletarget?
			// validation of angletarget done in misc_cam function
			if (ad_cam_focus.ad_focalpoint > 0) {
				// Move camera angletarget to player(camera) entity
				// Targetmovedir function uses (self) for comparision
				self.ad_angletarget = ad_cam_focus.ad_angletarget;
				// Update movedir, movetarget and dest1
				ad_TargetMovedir(self, ad_TRUE);
				
				// Convert direction vector to angles
				// This function returns integers! (engine code bug)
				ad_cam_newangle = vectoangles(self.movedir);

				//---------------------------------------------------------------------
				// Camera Angle Smoothing V2 by Eric Wasylishen
				//---------------------------------------------------------------------
				// Initialize last angle (snap to the initial angle)
				if (!ad_cam_lastanglevalid) {
					ad_cam_lastanglevalid = ad_TRUE;
					ad_cam_lastangle = ad_cam_newangle;
				}

				// Clamp angles to 0-360
				ad_cam_newangle = ad_vectormod(ad_cam_newangle);
				ad_cam_lastangle = ad_vectormod(ad_cam_lastangle);

				// Need to check every axis (XYZ) for 0 boundary issues
				// function stored in misc_camera.qc (only used for camera's)
				if (ad_camera_check_anglezero(ad_cam_newangle_x, ad_cam_lastangle_x)) {
					// To avoid breaking the interpolation,
					// shift the larger number so it's negative
					if (ad_cam_newangle_x > ad_cam_lastangle_x) ad_cam_newangle_x -= 360;
					else ad_cam_lastangle_x -= 360;
				}
				if (ad_camera_check_anglezero(ad_cam_newangle_y, ad_cam_lastangle_y)) {
					if (ad_cam_newangle_y > ad_cam_lastangle_y) ad_cam_newangle_y -= 360;
					else ad_cam_lastangle_y -= 360;
				}
				if (ad_camera_check_anglezero(ad_cam_newangle_z, ad_cam_lastangle_z)) {
					if (ad_cam_newangle_z > ad_cam_lastangle_z) ad_cam_newangle_z -= 360;
					else ad_cam_lastangle_z -= 360;
				}
				// Blend the last frame's angle with the target.
				// This controls how much of the target is mixed in, closer to 0 is slower.
				ad_cam_focus.ad_angleblend = ad_CINECAM_ANGLEBLEND;
				ad_cam_angle = (ad_cam_newangle * ad_cam_focus.ad_angleblend) + (ad_cam_lastangle * (1 - ad_cam_focus.ad_angleblend));
				// Clamp angles to 0-360
				ad_cam_angle = ad_vectormod(ad_cam_angle);

				// Store history of cam_angle for next frame's smoothing
				ad_cam_lastangle = ad_cam_angle;
				//---------------------------------------------------------------------
				// End of Camera Angle smoothing
				//---------------------------------------------------------------------
				
				// Got to reverse the pitch angle because the player angles
				// and v_angle are upside down (special carmack code)
				ad_cam_angle_x = -ad_cam_angle_x;
				self.angles = self.v_angle = ad_cam_angle;
			}
			else {
				// Update the player model/view angles
				self.angles = self.v_angle = ad_cam_angle;
				// Reduce drunk camera effect
				self.angles_z = 0;
			}
			// Force engine to update immediately
			self.fixangle = ad_TRUE;			
		}
		return;
	}
	
	if (self.deadflag) return;

	// Any spawn targets to update?
	if (self.ad_target2 != "") { 
		ad_trigger_strs(self.ad_target2, self); self.ad_target2 = "";
	}
	// Impulse commands and Quad updates
	ad_W_WeaponFrame ();

	// Show the player fall speed/velocity to the console
	// Useful for showing what map unit heights affect damage values
	if (ad_map_fallspeeddebug == ad_TRUE && ad_developer == 1 && self.jump_flag != 0) {
		dprint(ftos(self.jump_flag)); dprint(" ");
	}
	
	// Is the player sliding on top of an entity? (not on ground)
	// Need postthink check bec player starts at 0,0,0 floating :P
	if (self.velocity_z == 0 && !(self.flags & ad_FL_ONGROUND) && ad_postthink) {
		// Block players who jump and then noclip around!?!
		if (self.ad_jumptimer < time && self.movetype != ad_MOVETYPE_NOCLIP ) {
			// Slow down function, its running pre/post timing
			self.ad_jumptimer = time + 0.1;
			// Create a really small radius list, this is expensive!
			self.ad_jumptouch = findradius(self.origin, 96);
			while (self.ad_jumptouch) {
				// Found a breakable model?
				if (self.ad_jumptouch.ad_classtype == ad_CT_FUNCBREAKMDL) {
					// Check for nodamage spawnflag exception!
					if (self.ad_jumptouch.spawnflags & ad_BREAK_NOSHOOT) {
						// Slow down console message
						self.ad_jumptimer = time + 2;
						dprint("[SLIDING] Unbreakable obj at ");
						dprint(vtos(self.ad_jumptouch.origin));
						dprint("\n");
					}
					else {
						// From the player origin down to the feet is 22 (def) units
						// The breakable bbox edge (maxs) should be below feet
						if ( (self.ad_jumptouch.origin_z + self.ad_jumptouch.ad_bbmaxs_z) < self.origin_z-self.view_ofs_z &&
							vlen(self.ad_jumptouch.origin - self.origin) <= 64) {
							// Spawn a debug marker to show affected breakables
							//spawn_marker(self.jumptouch.origin + self.jumptouch.bbmaxs, 0);
							// Squash the contents (monsters) of this breakable
							self.ad_jumptouch.ad_jumpsquash = ad_TRUE;
							// Force trigger break object! (no debug info)
							self.ad_jumptouch.ad_nodebuginfo = ad_TRUE;
							ad_trigger_ent(self.ad_jumptouch, self);
						}
					}
				}
				// Keep cycling through radius list
				self.ad_jumptouch = self.ad_jumptouch.chain;
			}
		}
	}
	
	// check to see if player landed and play landing sound	
	// land.wav  = light huh sound (floor impact and no damage)
	// land2.wav = heavy huh sound and nasty bone crunching sound
	if ((self.jump_flag < ad_map_fallspeedlow) && (self.flags & ad_FL_ONGROUND) && (self.health > 0)) {
		// Landed deep (waist high) in water
		if (self.watertype == ad_CONTENT_WATER) {
			// Player hits water surface
			sound (self, ad_CHAN_BODY, "player/h2ojump.wav", 1, ad_ATTN_NORM);
			// Check if damage can be applied after hitting water surface
			// Cannot check jump flag velocity because player hit water
			if (ad_map_falldmgwater > 0) {
				ad_T_Damage (self, world, world, ad_map_falldmgwater, ad_DAMARMOR);
				// Play on different channel so it does not conflict
				sound (self, ad_CHAN_VOICE, "player/land.wav", 1, ad_ATTN_NORM);
				self.deathtype = "falling";
			}
		}
		else if (self.jump_flag < ad_map_fallspeedhigh) {
			if (ad_map_falldmg > 0) {
				ad_T_Damage (self, world, world, ad_map_falldmg, ad_DAMARMOR);
				sound (self, ad_CHAN_VOICE, "player/land2.wav", 1, ad_ATTN_NORM);
				self.deathtype = "falling";
			}
			else sound (self, ad_CHAN_VOICE, "player/land.wav", 1, ad_ATTN_NORM);
		}
		else
			sound (self, ad_CHAN_VOICE, "player/land.wav", 1, ad_ATTN_NORM);

		self.jump_flag = 0;
	}

	// Check for any fake water exit sounds
	if (self.ad_touchedliquid < time && self.ad_touchedsound != "") {
		sound (self, ad_CHAN_BODY, self.ad_touchedsound, 1, ad_ATTN_NORM);
		self.ad_touchedsound = "";
	}

	// If flying through the air, store player Z velocity in jump flag
	// This is a negative number because the player is falling downward
	if (!(self.flags & ad_FL_ONGROUND)) self.jump_flag = self.velocity_z;
	// The jump flag should be reset if the player is on the ground
	// It is only used by the player (client) in this function
	// the jump flag is used by jumping monsters (different entity type)
	else self.jump_flag = 0;

	// Check for any player powerups and debuffs updates
	ad_ClientPowerups ();
	ad_ClientDeBuff ();
};

//----------------------------------------------------------------------
void() ad_PlayerJump =
{
	if (self.flags & ad_FL_WATERJUMP) return;

	if (self.waterlevel >= 2) {
		if (self.watertype == ad_CONTENT_WATER) self.velocity_z = 100;
		else if (self.watertype == ad_CONTENT_SLIME) self.velocity_z = 80;
		else self.velocity_z = 50;

		// play swiming sound
		if (self.ad_swim_flag < time) {
			self.ad_swim_flag = time + 1;
			if (random() < 0.5) sound (self, ad_CHAN_BODY, "misc/water1.wav", 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_BODY, "misc/water2.wav", 1, ad_ATTN_NORM);
		}
		return;
	}

	//----------------------------------------------------------------------
	// The jump boots idea by Jose Carlos Rodriguez (JCR) from modjam1
	// This code was originally by JCR and modified by me to fit AD layout
	// Switched over all the variables to constants and entity options
	// Does the player have the jump boot powerup?
	//----------------------------------------------------------------------
	if (self.ad_moditems & ad_IT_ARTJUMPBOOTS) {
		// On the ground and starting to jump upward
		// Reset jump counter and start sequence
		if(self.flags & ad_FL_ONGROUND) {
			// Stop constant re-jump, got to press key again
			if (!(self.flags & ad_FL_JUMPRELEASED)) return;
			self.flags = self.flags - (self.flags & ad_FL_JUMPRELEASED);
			// Clear button as jump is happening
			self.button2 = 0;
			// Reset 'out of jump power' sound
			self.ad_jumpboots_sound = ad_FALSE;
			// Reset onground and jump boots ground flags, not needed anymore
			self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
			self.ad_jumpboots_onground = ad_FALSE;
			// Reset maximum amount of air jumps (for level 1-4 item)
			self.ad_jumpboots_airlvl = self.ad_jumpboots_airmax;
			// Combination sound of original jump + jump boots
			sound (self, ad_CHAN_BODY, ad_SOUND_ARTJUMPBOOTS3A, 1, ad_ATTN_NORM);
			// Jumps boots don't really work until in the air
			// Start with original jump height
			self.velocity_z = self.velocity_z + ad_map_jumpheight;
		}
		// Still in the air (no ground contact)
		// Allow for infinite jumps (airmax = -1)
		// Check for more jumps (1-4) and reset velocity
		// Allow for players falling of ledges (jumpboots_onground)
		else {	
			if(self.ad_jumpboots_airmax == -1 || self.ad_jumpboots_airlvl >= 1 || self.ad_jumpboots_onground) {
				// Stop constant re-jump, got to press key again
				if (!(self.flags & ad_FL_JUMPRELEASED)) return;
				self.flags = self.flags - (self.flags & ad_FL_JUMPRELEASED);
				// Clear button as jump is happening
				self.button2 = 0;
				// Reset 'out of jump power' sound
				self.ad_jumpboots_sound = time + 0.4;
				// If the player is falling, allow for air jumps and reset level
				if (self.ad_jumpboots_onground) self.ad_jumpboots_airlvl = self.ad_jumpboots_airmax;
				self.ad_jumpboots_onground = ad_FALSE;
				// Count down on maximum jump level
				self.ad_jumpboots_airlvl = self.ad_jumpboots_airlvl - 1;
				// Whoosh, more power
				sound (self, ad_CHAN_BODY, ad_SOUND_ARTJUMPBOOTS3B, 1, ad_ATTN_NORM);
				// Add jump boot height, different from basic jump
				self.velocity_z = self.ad_jumpboots_height;
			}
			// No more power!
			else {
				// played sound already?
				if (self.ad_jumpboots_sound < time) {
					// Don't play the sound constantly
					self.ad_jumpboots_sound = time + 0.2;
					// clickty click
					sound (self, ad_CHAN_BODY, ad_SOUND_ARTJUMPBOOTS3C, 1, ad_ATTN_NORM);
				}
			}
		}
		
		// Is there any additional forward motion?
		if (self.ad_jumpboots_forward > 0) {
			// Work out what speed the player is going forward
			// Flatten vectors by removing Z element
			self.pos1 = self.origin;
			self.pos2 = self.velocity;
			self.pos1_z = self.pos2_z = 0;
			// Add velocity to origin to create future position
			// Use vector length function to calc distance
			self.ad_pos3 = self.pos1 + self.pos2;
			self.t_length = vlen(self.ad_pos3 - self.pos1);
			// Check for min/max velocity first
			if (self.t_length < self.ad_jumpboots_forward) {
				// Use the forward/right/up vector system
				makevectors (self.v_angle);
				// Normalize the result because its a multiplier
				self.finalangle = normalize(v_forward);
				// Never increase the forward velocity beyond limit
				// Otherwise the velocity could grow too fast
				self.velocity = self.velocity + (self.finalangle * (self.ad_jumpboots_forward - self.t_length));
			}
		}
	}
	//----------------------------------------------------------------------
	// Velocity ladder jump logic
	// Can't block onground or jumprelease flag conditions
	// Jump direction should be v_angle and not just up!
	//----------------------------------------------------------------------
	else if (self.ad_onladder == ad_LADDER_VEL) {
		// Very precise order for this, Jumprelease and then onground
		self.flags = self.flags - (self.flags & ad_FL_JUMPRELEASED);
		self.flags = self.flags - ad_FL_ONGROUND;	// don't stairwalk
		self.button2 = 0;
		
		// player jumping sound
		sound (self, ad_CHAN_BODY, ad_SOUND_PLAYER_JUMP, 1, ad_ATTN_NORM);
		makevectors(self.v_angle);
		self.velocity = v_forward * (ad_map_jumpheight*1);
	}
	//----------------------------------------------------------------------
	// Original ID1 jump logic
	//----------------------------------------------------------------------
	else {
		if (!(self.flags & ad_FL_ONGROUND)) return;
		if (!(self.flags & ad_FL_JUMPRELEASED)) return;	// don't pogo stick

		// Very precise order for this, Jumprelease and then onground
		self.flags = self.flags - (self.flags & ad_FL_JUMPRELEASED);
		self.flags = self.flags - ad_FL_ONGROUND;	// don't stairwalk
		self.button2 = 0;
		
		// player jumping sound
		sound (self, ad_CHAN_BODY, ad_SOUND_PLAYER_JUMP, 1, ad_ATTN_NORM);
		self.velocity_z = self.velocity_z + ad_map_jumpheight;
	}
};

//----------------------------------------------------------------------
// Deals with water, slime and lava
//----------------------------------------------------------------------
void() ad_WaterMove =
{
	//dprint (ftos(self.waterlevel));
	// Fix noclip water gasping bug by giving air to the player
	if (self.movetype == ad_MOVETYPE_NOCLIP) {
		if (self.ad_air_finished < time + 2) self.ad_air_finished = time + 2; 
		return;
	}
	if (self.health < 0) return;

	if (self.waterlevel != 3) {
		if (self.ad_air_finished < time)
			sound (self, ad_CHAN_VOICE, "player/gasp2.wav", 1, ad_ATTN_NORM);
		else if (self.ad_air_finished < time + (ad_WATER_AIR-3))
			sound (self, ad_CHAN_VOICE, "player/gasp1.wav", 1, ad_ATTN_NORM);
		self.ad_air_finished = time + ad_WATER_AIR;
		self.dmg = ad_map_hazarddmg_x;
	}
	else if (self.ad_air_finished < time) {	// drown!
		if (self.ad_pain_finished < time) {
			// Keep increasing drowning damage
			self.dmg = self.dmg + ad_map_hazarddmg_x;
			// Cap the drowning damage if it gets too high
			if (self.dmg > 15) self.dmg = 10;
			ad_T_Damage (self, world, world, self.dmg, ad_DAMARMOR);
			self.ad_pain_finished = time + 1;
		}
	}
	
	if (!self.waterlevel) {
		if (self.flags & ad_FL_INWATER) {	
			// play leave water sound
			sound (self, ad_CHAN_BODY, "misc/outwater.wav", 1, ad_ATTN_NORM);
			self.flags = self.flags - ad_FL_INWATER;
		}
		return;
	}

	if (self.watertype == ad_CONTENT_LAVA) {
		// Check for lava shield and play reminder it exists
		if (self.ad_moditems & ad_IT_ARTLAVASHIELD) ad_PlayLavaShieldSound(self);
		else {
			// Check for lava damage timer
			if (self.ad_dmgtime < time) {
				// Unknown feature : env suit gives lava protection
				if (self.ad_radsuit_finished > time) self.ad_dmgtime = time + 1;
				else self.ad_dmgtime = time + 0.2;
				// Lava damage is crazy high the deeper you go
				ad_T_Damage (self, world, world, ad_map_hazarddmg_z*self.waterlevel, ad_DAMARMOR);
			}
		}
	}
	else if (self.watertype == ad_CONTENT_SLIME) {	// do damage
		if (self.ad_dmgtime < time && self.ad_radsuit_finished < time) {
			self.ad_dmgtime = time + 1;
			ad_T_Damage (self, world, world, ad_map_hazarddmg_y*self.waterlevel, ad_DAMARMOR);
		}
	}
	
	if ( !(self.flags & ad_FL_INWATER) ) {	 // player enter water sound
		if (self.watertype == ad_CONTENT_LAVA)
			sound (self, ad_CHAN_BODY, "player/inlava.wav", 1, ad_ATTN_NORM);
		if (self.watertype == ad_CONTENT_WATER)
			sound (self, ad_CHAN_BODY, "player/inh2o.wav", 1, ad_ATTN_NORM);
		if (self.watertype == ad_CONTENT_SLIME)
			sound (self, ad_CHAN_BODY, "player/slimbrn2.wav", 1, ad_ATTN_NORM);

		self.flags = self.flags + ad_FL_INWATER;
		self.ad_dmgtime = 0;
	}
	
	if (! (self.flags & ad_FL_WATERJUMP) )
		self.velocity = self.velocity - 0.8*self.waterlevel*frametime*self.velocity;
};

//----------------------------------------------------------------------
void() ad_CheckWaterJump =
{
	local vector ad_start, ad_end;

	// check for a jump-out-of-water
	makevectors (self.angles);
	ad_start = self.origin;
	ad_start_z = ad_start_z + 8; 
	v_forward_z = 0;
	normalize(v_forward);
	ad_end = ad_start + v_forward*24;
	traceline (ad_start, ad_end, ad_TRUE, self);
	
	if (trace_fraction < 1) {	// solid at waist
		ad_start_z = ad_start_z + self.maxs_z - 8;
		ad_end = ad_start + v_forward*24;
		self.movedir = trace_plane_normal * -50;
		traceline (ad_start, ad_end, ad_TRUE, self);
		if (trace_fraction == 1) {	// open at eye level
			self.flags = self.flags | ad_FL_WATERJUMP;
			self.velocity_z = 225;
			self.flags = self.flags - (self.flags & ad_FL_JUMPRELEASED);
			self.teleport_time = time + 2;	// safety net
			return;
		}
	}
};

/*======================================================================
 CLIENT GAME EDGE FUNCTIONS
======================================================================*/
// This function cannot be move, ref an exact frame in players model
void() ad_set_suicide_frame;		// In player.qc

//----------------------------------------------------------------------
void() ad_ClientRespawn =
{
	// CLIENT DIED = Reset randomizer seed
	ad_rnd_ResetRandomSeed(ad_RND_NORESETDEATH);
	
	if (coop) {
		ad_CopyToBodyQue (self);	// make a copy of the dead body for appearances sake
		setspawnparms (self);	// get the spawn parms as they were at level start
		ad_PutClientInServer ();	// respawn
	}
	else if (deathmatch) {
		ad_CopyToBodyQue (self);	// make a copy of the dead body for appearances sake
		ad_SetNewParms ();			// set default spawn parms
		ad_PutClientInServer ();	// respawn
	}
	// Its the infamous restart command debacle of 1996!
	else localcmd ("restart\n");
};

//----------------------------------------------------------------------
void() ad_ClientDeath =
{
	local float ad_forward;

	if ((self.flags & ad_FL_ONGROUND)) {
		ad_forward = vlen (self.velocity);
		ad_forward = ad_forward - 20;
		if (ad_forward <= 0)
			self.velocity = '0 0 0';
		else	
			self.velocity = ad_forward * normalize(self.velocity);
	}

	// wait for all buttons released
	if (self.deadflag == ad_DEAD_DEAD) {
		if (self.button2 || self.button1 || self.button0) return;
		self.deadflag = ad_DEAD_RESPAWNABLE;
		return;
	}

	// wait for any button down
	if (!self.button2 && !self.button1 && !self.button0) return;
	self.button0 = self.button1 = self.button2 = 0;
	ad_ClientRespawn();
};

//----------------------------------------------------------------------
// Player entered the suicide command
//----------------------------------------------------------------------
void() ad_ClientKill =
{
	bprint (self.netname);
	bprint (" suicides\n");
	ad_set_suicide_frame ();
	self.modelindex = ad_modelindex_player;
	self.frags = self.frags - 2;	// extra penalty
	ad_ClientRespawn ();
};

//----------------------------------------------------------------------
// Called when a player connects to a server
//----------------------------------------------------------------------
void() ad_ClientConnect =
{
	bprint (self.netname);
	bprint (" entered the game\n");
	
	// a client connecting during an intermission can cause problems
	if (ad_intermission_running > 0) ad_GotoNextMap ();
};

//----------------------------------------------------------------------
// Called when a player disconnects from a server
//----------------------------------------------------------------------
void() ad_ClientDisconnect =
{
	if (ad_gameover) return;
	// if the level end trigger has been activated, just return
	// since they aren't *really* leaving

	// let everyone else know
	bprint (self.netname);
	bprint (" left the game with ");
	bprint (ftos(self.frags));
	bprint (" frags\n");
	sound (self, ad_CHAN_BODY, "player/tornoff2.wav", 1, ad_ATTN_NONE);
	ad_set_suicide_frame ();
};

//----------------------------------------------------------------------
// Called when a player dies, deals with all death messages
//----------------------------------------------------------------------
void(entity ad_targ, entity ad_attacker) ad_ClientObituary =
{
	local	float ad_rnum;
	local	string ad_clientstring, ad_clientstring2;
	ad_rnum = random();

	if (ad_targ.flags & ad_FL_CLIENT) {
		if (ad_attacker.classname == "teledeath") {
			bprint (ad_targ.netname);
			bprint (" was telefragged by ");
			bprint (ad_attacker.owner.netname);
			bprint ("\n");

			ad_attacker.owner.frags = ad_attacker.owner.frags + 1;
			return;
		}

		if (ad_attacker.classname == "teledeath2") {
			bprint ("Satan's power deflects ");
			bprint (ad_targ.netname);
			bprint ("'s telefrag\n");

			ad_targ.frags = ad_targ.frags - 1;
			return;
		}

		if (ad_attacker.flags & ad_FL_CLIENT) {
			if (ad_targ == ad_attacker) {
				// killed self
				ad_attacker.frags = ad_attacker.frags - 1;
				bprint (ad_targ.netname);
				
				if (ad_targ.weapon == 64 && ad_targ.waterlevel > 1) {
					bprint (" discharges into the water.\n");
					return;
				}
				if (ad_targ.weapon == ad_IT_GRENADE_LAUNCHER) 
					bprint (" tries to put the pin back in\n");
				else
					bprint (" becomes bored with life\n");
				return;
			}
			else if ( (teamplay == 2) && (ad_targ.team > 0)&&(ad_targ.team == ad_attacker.team) ) {
				if (ad_rnum < 0.25) ad_clientstring = " mows down a teammate\n";
				else if (ad_rnum < 0.50) ad_clientstring = " checks his glasses\n";
				else if (ad_rnum < 0.75) ad_clientstring = " gets a frag for the other team\n";
				else ad_clientstring = " loses another friend\n";
				bprint (ad_attacker.netname);
				bprint (ad_clientstring);
				ad_attacker.frags = ad_attacker.frags - 1;
				return;
			}
			else {
				ad_attacker.frags = ad_attacker.frags + 1;

				ad_rnum = ad_attacker.weapon;
				if (ad_rnum == ad_IT_AXE) {
					ad_clientstring = " was ax-murdered by ";
					ad_clientstring2 = "\n";
				}
				if (ad_rnum == ad_IT_SHOTGUN) {
					ad_clientstring = " chewed on ";
					ad_clientstring2 = "'s boomstick\n";
				}
				if (ad_rnum == ad_IT_SUPER_SHOTGUN) {
					ad_clientstring = " ate 2 loads of ";
					ad_clientstring2 = "'s buckshot\n";
				}
				if (ad_rnum == ad_IT_NAILGUN) {
					ad_clientstring = " was nailed by ";
					ad_clientstring2 = "\n";
				}
				if (ad_rnum == ad_IT_SUPER_NAILGUN) {
					ad_clientstring = " was punctured by ";
					ad_clientstring2 = "\n";
				}
				if (ad_rnum == ad_IT_GRENADE_LAUNCHER) {
					ad_clientstring = " eats ";
					ad_clientstring2 = "'s pineapple\n";
					if (ad_targ.health < -40) {
						ad_clientstring = " was gibbed by ";
						ad_clientstring2 = "'s grenade\n";
					}
				}
				if (ad_rnum == ad_IT_ROCKET_LAUNCHER) {
					ad_clientstring = " rides ";
					ad_clientstring2 = "'s rocket\n";
					if (ad_targ.health < -40) {
						ad_clientstring = " was gibbed by ";
						ad_clientstring2 = "'s rocket\n" ;
					}
				}
				if (ad_rnum == ad_IT_LIGHTNING) {
					ad_clientstring = " accepts ";
					if (ad_attacker.waterlevel > 1) ad_clientstring2 = "'s discharge\n";
					else ad_clientstring2 = "'s shaft\n";
				}
				bprint (ad_targ.netname);
				bprint (ad_clientstring);
				bprint (ad_attacker.netname);
				bprint (ad_clientstring2);
			}
			return;
		}
		else {
			ad_targ.frags = ad_targ.frags - 1;
			bprint (ad_targ.netname);

			//-----------------------------------------------------------------
			// All the monster death messages are now defined in the monster QC
			// It is much easier to remember to add these with creating the
			// QC for each new monster than find/edit them here!
			//-----------------------------------------------------------------
				
			// Check for boss or monster flags
			if (ad_attacker.ad_bossflag > 0 || ad_attacker.flags & ad_FL_MONSTER) {
				if (ad_attacker.ad_deathstring != "") bprint (ad_attacker.ad_deathstring);
				else bprint(" was killed by Quake!\n");
				return;
			}

			// tricks and traps
			if (ad_attacker.solid == ad_SOLID_BSP && ad_attacker != world) bprint (" was squished\n");
			else if (ad_attacker.ad_classtype == ad_CT_EXPLO_BOX) bprint (" blew up\n");
			else if (ad_attacker.ad_classtype == ad_CT_SPIKESHOOTER) bprint (" did not stick around\n");
			else if (ad_attacker.ad_classtype == ad_CT_GRENADESHOOTER) bprint (" was pineappled\n");
			else if (ad_attacker.ad_classtype == ad_CT_ROCKETSHOOTER) bprint (" was blasted\n");
			else if (ad_attacker.ad_classtype == ad_CT_LIGHTSHOOTER) bprint (" was struck down\n");
			else if (ad_attacker.ad_classtype == ad_CT_GASSHOOTER) bprint (" was burnt to a crisp\n");
			else if (ad_attacker.ad_classtype == ad_CT_PENDULUM) bprint (" was cleaved in two\n");
			else if (ad_attacker.ad_classtype == ad_CT_SAWBLADE) bprint (" was sliced to pieces\n");
			else if (ad_attacker.ad_classtype == ad_CT_FIREBALL) bprint (" ate a lavaball\n");
			else if (ad_attacker.ad_classtype == ad_CT_TRIGLEVEL) bprint (" tried to leave\n");

			// in-water deaths
			else if (ad_targ.watertype == -3) {
				if (random() < 0.5) bprint (" sleeps with the fishes\n");
				else bprint (" sucks it down\n");
			}
			else if (ad_targ.watertype == -4) {
				if (random() < 0.5) bprint (" gulped a load of slime\n");
				else bprint (" can't exist on slime alone\n");
			}
			else if (ad_targ.watertype == -5) {
				if (ad_targ.health < -15) bprint (" burst into flames\n");
				else if (random() < 0.5) bprint (" turned into hot slag\n");
				else bprint (" visits the Volcano God\n");
			}

			// Debuff deaths
			else if (ad_targ.ad_burning) bprint (" was burnt to a crisp\n");
			else if (ad_targ.ad_poisoned) bprint (" was poisoned\n");
			else if (ad_targ.ad_bleeding) bprint (" bled to death\n");

			// Special blocking of evil skill savegames
			else if(ad_targ.deathtype == "loadingevil") {
				ad_targ.deathtype = ad_string_null;
				bprint (" is too EVIL to live again!\n");
			}
			
			// fell to their death?
			else if (ad_targ.deathtype == "falling") {
				ad_targ.deathtype = ad_string_null;
				bprint (" fell to his death\n");
			}
			else if (ad_targ.ad_touchedvoid) {
				ad_targ.deathtype = ad_string_null;
				bprint (" touched the void\n");
			}
			else 
				// hell if I know; he's just dead!!!
				bprint (" is dead Jim!\n");
		}
	}
};
