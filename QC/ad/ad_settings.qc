/*======================================================================
 Require DEVELOPER mode to be active
======================================================================*/
//----------------------------------------------------------------------
void(float ad_hpshift) ad_togglehpmax =
{
	local entity ad_playent;
	
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_impulse_devonlymode()) return;		// Dev mode only
	if (ad_impulse_skill03only()) return;		// skill 0-3 only
	
	self.impulse = 0;
	
	// Setup default
	if (self.ad_tog_health <= 0) self.ad_tog_health = 1;

	// Update visuals
	sprint(self, "\b[Impulse]\b Max HP/Mega ("); 
	sprint(self, ftos(ad_HEAL_PLAYMAX * self.ad_tog_health));
	// Update toggle health values + check for errors
	self.ad_tog_health = self.ad_tog_health - ad_hpshift;
	if (self.ad_tog_health <= 0) self.ad_tog_health = 1;
	// Update visuals
	sprint(self, ") - ("); 
	sprint(self, ftos(ad_HEAL_PLAYMAX * self.ad_tog_health));
	sprint(self, ")\n");
	
	// Find first client
	ad_playent = find(world, classname, "player");
	while (ad_playent) {
		ad_playent.ad_tog_health = self.ad_tog_health;
		// Have to work from default constants
		ad_playent.max_health = ad_HEAL_PLAYMAX * ad_playent.ad_tog_health;
		ad_playent.ad_mega_health = ad_HEAL_MEGAMAX * ad_playent.ad_tog_health;
		// Double check max is not negative or zero
		if (ad_playent.max_health <= 0) ad_playent.max_health = ad_HEAL_PLAYMAX;
		if (ad_playent.ad_mega_health <= 0) ad_playent.ad_mega_health = ad_HEAL_MEGAMAX;
		// Cap health with new/current maximum
		if (ad_playent.health > ad_playent.max_health) {
			// Tiny damage to trigger client animation/sound
			ad_T_Damage(ad_playent, world, world, 1, ad_NOARMOR);
			ad_playent.health = ad_playent.max_health;	
		}			
		// Find more (coop) player/clients
		ad_playent = find(ad_playent, classname, "player");
	}	
};

//----------------------------------------------------------------------
void() ad_toggleupgradeaxe =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_impulse_devonlymode()) return;		// Dev mode only
	if (ad_impulse_skill03only()) return;		// skill 0-3 only
	
	self.impulse = 0;
	if (self.ad_moditems & ad_IT_UPGRADE_AXE) {
		dprint("\b[Impulse]\b Shadow Axe Removed\n"); 
		self.ad_moditems = self.ad_moditems - ad_IT_UPGRADE_AXE;
		ad_update_configflag(ad_SVR_UPDAXE, ad_FALSE);
	}
	else {
		// Cannot have Shadow Axe AND Grapple Hook
		if (self.ad_moditems & ad_IT_UPGRADE_GHOOK) {
			dprint ("\b[Impulse]\b Removing Grapple Hook!\n");
			self.ad_moditems = self.ad_moditems - (self.ad_moditems & ad_IT_UPGRADE_GHOOK);
			ad_update_configflag(ad_SVR_UPDGHOOK, ad_FALSE);
		}
		dprint("\b[Impulse]\b Shadow Axe Added\n"); 
		self.ad_moditems = self.ad_moditems | ad_IT_UPGRADE_AXE;
		ad_update_configflag(ad_SVR_UPDAXE, ad_TRUE);
		// Switch to new weapon
		self.weapon = ad_IT_AXE;
	}
		
	if (self.weapon == ad_IT_AXE) ad_W_SetCurrentAmmo(self);
};

// Forward compiler reference
void() ad_GrappleHook_Setup;
void() ad_GrappleHook_Display;
//----------------------------------------------------------------------
void() ad_toggleupgradehook =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_impulse_devonlymode()) return;		// Dev mode only
	if (ad_impulse_skill03only()) return;		// skill 0-3 only
	
	self.impulse = 0;
	// Does the hook entity exist?
	if (!self.ad_hookent) ad_GrappleHook_Setup();
	
	// Have grapple hook already?
	if (self.ad_moditems & ad_IT_UPGRADE_GHOOK) {
		if (self.ad_gh_hookstyle == ad_GNC_HOOKLINE) {
			self.ad_gh_hookstyle = ad_GNC_HOOKBOOST;
			dprint("\b[Impulse]\b BOOST Grapple Hook Style\n"); 
		}
		// Trick version not implemented, cycle around instead
		/*else if (self.gh_hookstyle == GNC_HOOKBOOST) {
			self.gh_hookstyle = GNC_HOOKTRICK;
			dprint("\b[Impulse]\b TRICK Grapple Hook Style\n"); 
		} */
		else {
			dprint("\b[Impulse]\b Grapple Hook Removed!\n"); 
			self.ad_moditems = self.ad_moditems - ad_IT_UPGRADE_GHOOK;
			ad_update_configflag(ad_SVR_UPDGHOOK, ad_FALSE);
		}
	}
	else {
		// Cannot have Shadow Axe AND Grapple Hook
		if (self.ad_moditems & ad_IT_UPGRADE_AXE) {
			dprint("\b[Impulse]\b Removing Shadow Axe!\n");
			self.ad_moditems = self.ad_moditems - (self.ad_moditems & ad_IT_UPGRADE_AXE);
			ad_update_configflag(ad_SVR_UPDAXE, ad_FALSE);
		}
		dprint("\b[Impulse]\b LINE Grapple Hook Added\n"); 
		self.ad_moditems = self.ad_moditems | ad_IT_UPGRADE_GHOOK;
		self.ad_gh_hookstyle = ad_GNC_HOOKLINE;
		ad_update_configflag(ad_SVR_UPDGHOOK, ad_TRUE);
		// Switch to new weapon
		self.weapon = ad_IT_AXE;
	}
		
	// Display Hook stats and update v_model
	ad_GrappleHook_Display();
	ad_W_SetCurrentAmmo(self);
};

