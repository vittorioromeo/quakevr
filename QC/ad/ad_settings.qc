/*======================================================================
 Show MOD name and version
======================================================================*/
void() ad_display_version =
{
	if (ad_impulse_playeronly()) return;		// Player only
	
	self.impulse = 0;
	sprint(self,"\b[INFO]\b Arcane Dimensions V");
	ad_lftos(self, ad_mod_version, 1, 2, ad_BUFFER_SPRINT);
	if (ad_mod_patch > 0) {
		sprint(self, " Patch ");
		sprint(self, ftos(rint(ad_mod_patch)));
	}
	if (ad_mod_beta > 0) {
		sprint(self, " (Beta");
		sprint(self, ftos(rint(ad_mod_beta)));
		sprint(self, ")");
	}
	sprint(self, " \n");
};

/*======================================================================
 Prints origin and mangle to console screen
 Useful for creating good locations for intermission camera's
 ** Been replaced with viewpos and setview console commands **
======================================================================*/
void() ad_display_playinfo =
{
	if (ad_impulse_playeronly()) return;		// Player only
	
	self.impulse = 0;
	sprint(self,"\b[INFO]\b Org ("); sprint(self,vtos(self.origin));
	sprint(self,") Ang ("); sprint(self,vtos(self.v_angle));
	sprint(self,")\n");
};


/*======================================================================
 Prints which custom keys the player has in their inventory
======================================================================*/
void() ad_display_customkeys =
{
	local string ad_ckey_str1, ad_ckey_str2, ad_ckey_str3, ad_ckey_str4;
	local float ad_ckey_count;
	
	if (ad_impulse_playeronly()) return;		// Player only

	self.impulse = 0;	
	// Check for any custom keys in player inventory
	if (self.ad_moditems & ad_IT_CKEYALL) {
		// Always reset key count
		ad_ckey_count = 0;
		
		if (self.ad_moditems & ad_IT_CKEY1) {
			ad_ckey_str1 = self.ad_ckeyname1;
			ad_ckey_count = ad_ckey_count + 1;
		}
		if (self.ad_moditems & ad_IT_CKEY2) {
			if (ad_ckey_count == 1) ad_ckey_str2 = self.ad_ckeyname2;
			else ad_ckey_str1 = self.ad_ckeyname2;
			ad_ckey_count = ad_ckey_count + 1;
		}
		if (self.ad_moditems & ad_IT_CKEY3) {
			if (ad_ckey_count == 2) ad_ckey_str3 = self.ad_ckeyname3;
			else if (ad_ckey_count == 1) ad_ckey_str2 = self.ad_ckeyname3;
			else ad_ckey_str1 = self.ad_ckeyname3;
			ad_ckey_count = ad_ckey_count + 1;
		}
		if (self.ad_moditems & ad_IT_CKEY4) {
			if (ad_ckey_count == 3) ad_ckey_str4 = self.ad_ckeyname4;
			else if (ad_ckey_count == 2) ad_ckey_str3 = self.ad_ckeyname4;
			else if (ad_ckey_count == 1) ad_ckey_str2 = self.ad_ckeyname4;
			else ad_ckey_str1 = self.ad_ckeyname4;
			ad_ckey_count = ad_ckey_count + 1;
		}
		
		// if 4 keys are present, then squash the last two key names together
		// The maximum amount of strings that centerprint can handle is 7
		// A bit of shame, because only needed one more string!
		if (ad_ckey_count == 4)
			ad_centerprint7 (self, "-[ \bArcane Key Inventory\b ]-\nYou have the following\n\n", ad_ckey_str1, "\n", ad_ckey_str2, "\n", ad_ckey_str3, ad_ckey_str4);
		else
			// Space out title and keys (does not print key 4)
			ad_centerprint7 (self, "-[ \bArcane Key Inventory\b ]-\nYou have the following\n\n", ad_ckey_str1, "\n", ad_ckey_str2, "\n", ad_ckey_str3, "\n");
	}
	else 
		// Should always say the state of the inventory
		ad_centerprint(self, "-[ \bArcane Key Inventory\b ]-\n\nIs Empty!\n"); 
};

/*======================================================================
 Cycle through all custom HUDs using scratch1 cvar
======================================================================*/
void() ad_CycleThroughHuds =
{
	local float ad_hudact;
	if (ad_impulse_playeronly()) return;		// Player only
	// Is the CSQC functionality enabled/disabled?
	// This entity key is updated (on client) by CSQC when active
	// spike has broken this check in qss dev builds :(
	if (self.ad_ext_csqc == ad_FALSE) {
		sprint(self, "[IMPULSE] Custom HUDS not supported!\n");
		return;
	}
	// Have the HUDs been disabled on purpose?
	if (cvar("cl_nocsqc") == 1 || cvar("scratch1") < 0) {
		sprint(self, "[IMPULSE] Custom HUDS are disabled!\n");
		return;
	}
	// Reset input buffer
	self.impulse = 0;	
	// Read current custom hud
	ad_hudact = cvar("scratch1");
	// Move forward 1 hud and check range
	ad_hudact = ad_hudact + 1;
	if (ad_hudact > 9) ad_hudact = 0;
	cvar_set("scratch1", ftos(ad_hudact));
	// Let the player know what hud is active
	if (ad_hudact == 1) ad_centerprint(self, "1 = Inventory Around middle\n");
	else if (ad_hudact == 2) ad_centerprint(self, "2 = Inventory on Screen Sides\n");
	else if (ad_hudact == 3) ad_centerprint(self, "3 = Blank\n");
	else if (ad_hudact == 4) ad_centerprint(self, "4 = Classic Doom Inspired!\n");
	else if (ad_hudact == 5) ad_centerprint(self, "5 = Quake Champions Inspired!\n");
	else if (ad_hudact == 6) ad_centerprint(self, "6 = Extra Wide Single Bar\n");
	else if (ad_hudact == 7) ad_centerprint(self, "7 = Clustered Around Crosshair\n");
	else if (ad_hudact == 8) ad_centerprint(self, "8 = Blank\n");
	else if (ad_hudact == 9) ad_centerprint(self, "9 = Blank\n");
	else ad_centerprint(self, "0 = Classic Quake HUD!\n");
};

/*======================================================================
 Standard error reporting
======================================================================*/
float() ad_impulse_playeronly =
{
	if (!(self.flags & ad_FL_CLIENT)) {
		// Message goes to console, no client available!
		dprint("[Impulse ");
		dprint(ftos(self.impulse));
		dprint("] only works for \bThe Player!\b\n");
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
float() ad_impulse_devonlymode =
{
	if (ad_developer == ad_FALSE) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] only works in \bDeveloper\b mode!\n");
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
void() ad_impulse_notvalid =
{
	if (!(self.flags & ad_FL_CLIENT)) return;
	if (self.impulse > 0) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] does not work at the moment!\n");
		self.impulse = 0;
	}
};

//----------------------------------------------------------------------
float() ad_impulse_activecameras =
{
	// no console feedback
	if (ad_intermission_running > 0) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] cannot work, \bIntermission\b active!\n");
		return ad_TRUE;
	}
	else if (ad_cinematic_running > 0) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] cannot work, \bCinematic\b active!\n");
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
float() ad_impulse_dmcoopmode =
{
	if (deathmatch > 0 || coop > 0) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] does not work in \bDM\b or \bCoop\b mode!\n");
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
float() ad_impulse_cooponlymode =
{
	if (coop == ad_FALSE) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] only works in \bCoop\b mode!\n");
