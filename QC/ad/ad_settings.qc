	sprint(self, ")\n");
};


/*======================================================================
 IMPULSE 9
 Gives the player certain weapons and ammo (CHEAT COMMAND)
======================================================================*/
void() ad_CheatCommand =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_impulse_dmcoopmode()) return;		// No Dm/Coop mode
	if (ad_impulse_skill03only()) return;		// skill 0-3 only
	
	// Should be a dev only command, but everyone knows about it!	
	dprint("\b[Impulse 9]\b Weapon Cheat Command\n");
	dprint("- Use Impulse 245 to get silver/gold keys!\n");
	self.impulse = 0;
	self.ammo_rockets = 75;
	self.ammo_nails = 150;
	self.ammo_shells = 150;
	self.ammo_cells = 150;
	self.items = self.items | ad_IT_AXE | ad_IT_SHOTGUN | ad_IT_SUPER_SHOTGUN | ad_IT_NAILGUN |
				ad_IT_SUPER_NAILGUN | ad_IT_GRENADE_LAUNCHER | ad_IT_ROCKET_LAUNCHER | ad_IT_LIGHTNING;
	self.items = self.items | ad_IT_ARMOR1;
	self.weapon = ad_IT_LIGHTNING;
	ad_W_SetCurrentAmmo (self);
};

