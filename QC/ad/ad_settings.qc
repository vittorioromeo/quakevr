};

//----------------------------------------------------------------------
float() ad_impulse_skill03only =
{
	if (ad_skill < 0 || ad_skill > ad_SKILL_NIGHTMARE) {
		sprint(self, "[Impulse ");
		sprint(self, ftos(self.impulse));
		sprint(self, "] skill lvl out of range!\n");
		return ad_TRUE;
	}
	else return ad_FALSE;
};

/*======================================================================
 ImpulseCommands
======================================================================*/
void() ad_ImpulseCommands =
{
	if (self.impulse >= 1 && self.impulse <= 8) ad_W_ChangeWeapon (self);
	else if (self.impulse == 10) ad_CycleWeaponCommand();
	else if (self.impulse == 12) ad_CycleWeaponReverseCommand();

	// Only these MOD options can be changed via the console
	else if (self.impulse == 100) ad_toggleautoaim();		// Toggle auto aim
	else if (self.impulse == 105) ad_toggleprojsize();		// Toggle player proj size
	else if (self.impulse == 110) ad_togglezaware();		// Toggle Z aware monsters
	else if (self.impulse == 115) ad_togglepixels();		// Toggle texture modes
	else if (self.impulse == 120) ad_togglefootstep();		// Toggle footstep sound
	else if (self.impulse == 125) ad_toggleliquiddmg();	// Toggle liquid damage
	else if (self.impulse == 130) ad_toggleshotgunproj();	// Toggle SG Projectile
	else if (self.impulse == 135) ad_toggleshotguncase();	// Toggle SG Casing
	else if (self.impulse == 137) ad_toggletrackmissile();	// Toggle tracking missiles on death
	else if (self.impulse == 140) ad_display_version();	// Display MOD config flag
	else if (self.impulse == 142) ad_display_playinfo();	// Display Player information
	else if (self.impulse == 145) ad_StartIntermissionCamera();

	else if (self.impulse == 150) ad_togglecoopartifacts();// Toggle COOP can drop artifacts
	else if (self.impulse == 152) ad_togglecoopweapons();	// Toggle COOP weapons to respawn
	else if (self.impulse == 154) ad_togglecoophealth();	// Toggle COOP health to respawn
	else if (self.impulse == 156) ad_togglecoopammoboxes();// Toggle COOP ammo boxes to respawn
	else if (self.impulse == 158) ad_togglecooppowerups();	// Toggle COOP powerups to respawn

	else if (self.impulse == 160) ad_toggleweather();		// Toggle Weather Systems
	else if (self.impulse == 162) ad_togglehpmax(0.25);	// Toggle HP Max 0.25/0.5/0.75/1.0
	else if (self.impulse == 164) ad_togglehpmax(0.50);	// Toggle HP Max between 0.5/1.0
	else if (self.impulse == 166) ad_togglenotargetblock();// Toggle notarget block on items
	else if (self.impulse == 168) ad_togglenomwheelskip(); // Toggle no mouse wheel skip
	else if (self.impulse == 170) ad_togglebodyremoval();	// Toggle monster body fade/removal
	else if (self.impulse == 175) ad_display_customkeys();	// Display Custom Key inventory
	else if (self.impulse == 178) ad_CycleThroughHuds();	// Cycle through different custom HUDS

	else if (self.impulse == 180) ad_display_secrets();	// Display a list of secret locations
	else if (self.impulse == 182) ad_display_secretlocs();	// Display secret locations
	else if (self.impulse == 184) ad_display_monsleft();	// Display a list of monsters left
	else if (self.impulse == 185) ad_display_monsqty();	// Display a table of monster type/qty
	else if (self.impulse == 186) ad_display_ammostats();	// Display a list of Ammo Stats

	else if (self.impulse == 190) ad_display_randomizer();	// Display current random seed
	else if (self.impulse == 192) ad_display_randflags();	// Display current settings
	else if (self.impulse == 194) ad_display_randupgrade();// Display weapon upgrades
	else if (self.impulse == 196) ad_reset_randomizer();	// Reset seed for Chaos system
	
	// Only works developer only)
	else if (self.impulse == 200) ad_toggleupgradeaxe();	// Toggle Axe Upgrade
	else if (self.impulse == 202) ad_toggleupgradehook();	// Toggle GrappleHook Upgrade
	else if (self.impulse == 205) ad_toggleupgradessg();	// Toggle Shotgun Upgrade
	else if (self.impulse == 210) ad_toggleupgradelg();	// Toggle Lightning Upgrade
	else if (self.impulse == 220) ad_display_configflag();	// Display MOD config flag
	else if (self.impulse == 222) ad_showbits_configflag();// Show exact values of flag
	else if (self.impulse == 225) ad_display_mapvar();		// Display all map variables
	else if (self.impulse == 230) ad_toggledevhelpers();	// Toggle Dev Helpers (mark/arrow)
	else if (self.impulse == 235) ad_CycleParticleDebug();	// Cycle particle debug

	else if (self.impulse == 240) ad_givesigil(ad_SVR_RUNE_ALL);	// Give all sigils to player
	else if (self.impulse == 241) ad_givesigil(ad_SVR_RUNE_KEY1);	// Give various sigil to player
	else if (self.impulse == 242) ad_givesigil(ad_SVR_RUNE_KEY2);	// Will be reset on map load
	else if (self.impulse == 243) ad_givesigil(ad_SVR_RUNE_KEY3);	// Mainly used for testing
	else if (self.impulse == 244) ad_givesigil(ad_SVR_RUNE_KEY4);

	else if (self.impulse == 245) ad_givekey(ad_IT_KEY1 + ad_IT_KEY2);	// Both

	// The classic all weapons+ammo cheat (should be developer=1)
	else if (self.impulse == 9) ad_CheatCommand();
	// All artifact cheat commands
	else if (self.impulse == 246) ad_LavaShieldCheat();
	else if (self.impulse == 247) ad_AirTankCheat();
	else if (self.impulse == 248) ad_BlastBeltCheat();
	else if (self.impulse == 249) ad_JumpBootsCheat();
	else if (self.impulse == 250) ad_SharpshooterCheat();
	else if (self.impulse == 251) ad_NailPiercerCheat();
	else if (self.impulse == 252) ad_EnvSuitCheat();
	else if (self.impulse == 253) ad_PentagramCheat();
	else if (self.impulse == 254) ad_InvisibleCheat();
	else if (self.impulse == 255) ad_QuadDamageCheat();

	self.impulse = 0;
};

/*======================================================================
 The MOD can be customizied from three different source:
 quake.rc < worldspawn < impulse commands (top priority)
 
 The serverflags is the ONLY variable that is passed between MAP loads
 and that variable is not available straightaway! Once the worldspawn
 is loaded (first thing to happen) the serverflags is still empty
 and the functions have to cope with it 'out of sync' until later.
 
 after worldspawn is loaded, the combination of the quake.rc (TEMP1)
 is merged with the keys on worldspawn and all spawning functions
 use the configflags until it can be sync'd with serverflags.
 
 The configflags is setup to be temporary so that any previous value
 from a quickload does not interfere with it.
 
======================================================================*/
// Assume that serverflags not setup yet, merge worldspawn with configflag
// Once serverflags available, then sync everything together
void(float ad_regbitflag, float ad_worldvalue) ad_update_worldspawn =
{
	// Is the bit value TRUE?
	if (ad_worldvalue > 0) ad_configflag = ad_configflag | ad_regbitflag;
	// Only take about a bit value from configflag if bit value is present
	else if (ad_worldvalue < 0) {
		if (ad_configflag & ad_regbitflag) ad_configflag = ad_configflag - ad_regbitflag;
	}
};

//----------------------------------------------------------------------
// The worldspawn key values always override the quake.rc values and
// should be merged with the console variable when loading a map
// serverflags is not available before spawn functions
void() ad_sycn_worldspawn =
{
	// Check console variables defined in quake.rc file
	if (cvar("saved1") > 0) ad_update_worldspawn(ad_SVR_SPRPARTON, ad_TRUE);
	if (cvar("saved2") > 0) ad_update_worldspawn(ad_SVR_FOOTSTEP, ad_TRUE);
	if (cvar("saved3") > 0) ad_update_worldspawn(ad_SVR_SHOTGCASE, ad_TRUE);
	if (cvar("saved4") > 0) ad_update_worldspawn(ad_SVR_SHOTGPROJ, ad_TRUE);
	if (cvar("scratch4") > 0) cvar_set("skill", ftos(ad_SKILL_EVIL));
	
	// Check for worldspawn settings
	ad_update_worldspawn(ad_SVR_ITEMOFFSET, self.ad_no_item_offset);
	ad_update_worldspawn(ad_SVR_UPDAXE, self.ad_upgrade_axe);
	ad_update_worldspawn(ad_SVR_UPDGHOOK, self.ad_upgrade_ghook);
	ad_update_worldspawn(ad_SVR_UPDSSG, self.ad_upgrade_ssg);
	ad_update_worldspawn(ad_SVR_UPDLG, self.ad_upgrade_lg);
	ad_update_worldspawn(ad_SVR_ZAWARE, self.ad_no_zaware);
	ad_update_worldspawn(ad_SVR_LIQDAM, self.ad_no_liquiddmg);
};

//----------------------------------------------------------------------
// Reset the serverflag to console + worldspawn settings
// This only needs to be done when loading a new map or changelevel
// quickload cannot run this function it will damage inventory
void() ad_sync_serverflags =
{
	local float ad_checkflag;
	
	if (serverflags & ad_SVR_LIVE) {
		dprint("\b[SERVERFLAG]\b MAP LOAD reset/sync\n");
		// Take 1-8 runes, 9-16 worldspawn merge, 17-23 mod/console options
		ad_checkflag = (serverflags & ad_SVR_RUNEFLAG) + (ad_temp1flag & ad_SVR_WORLDFLAG) + (ad_configflag & ad_SVR_HIGHFLAG);
		// Update the serverflags ready for future updates
		serverflags =  ad_configflag = ad_checkflag;	
	}
};

//----------------------------------------------------------------------
// Update configflag and if the serverflags is active, update that as well!
void(float ad_regbitflag, float ad_regbitvalue) ad_update_configflag =
{
	// Is the bit value TRUE?
	if (ad_regbitvalue == ad_TRUE) {
		ad_configflag = ad_configflag | ad_regbitflag;
		if (serverflags & ad_SVR_LIVE) serverflags = serverflags | ad_regbitflag;
	}
	// If the bit value FALSE
	else {
		ad_configflag = ad_configflag - (ad_configflag & ad_regbitflag);
		if (serverflags & ad_SVR_LIVE) {
			serverflags = serverflags - (serverflags & ad_regbitflag);
		}
	}
		
	// Only the top 8 bits of TEMP1 flag can be updated
	// Some options should not be changed easily, causes problems
	if (ad_regbitflag & ad_SVR_HIGHFLAG) {
		// Re-fresh the console variable 
		dprint("\b[TEMP1]\b Changing ("); dprint(ftos(ad_regbitflag));
		dprint(")\n");
		ad_temp1flag = cvar("temp1");
		if (ad_regbitvalue > 0) ad_temp1flag = ad_temp1flag | ad_regbitflag;
		else ad_temp1flag = ad_temp1flag - (ad_temp1flag & ad_regbitflag);
		// Write any changes to the console variable (TEMP1)
		cvar_set("temp1", ftos(ad_temp1flag));
	}		
};

//----------------------------------------------------------------------
float(float ad_regbitflag) ad_query_configflag =
{
	// Return bitflag value so multiple bits can be tested together
	return (ad_configflag & ad_regbitflag);
};

//----------------------------------------------------------------------
float(float ad_regbitflag) ad_query_temp1flag =
{
	// Return bitflag value so multiple bits can be tested together
	return (ad_temp1flag & ad_regbitflag);
};

//----------------------------------------------------------------------
void() ad_showbits_configflag =
{
	local float ad_loopcnt, ad_bitcnt;
	
	dprint("\n\b[CONFIG]\b Configflag (");
	dprint(ftos(ad_configflag)); dprint(")\n");
	dprint("--------------------------------------\n");
	dprint("\bBitflag V Description\b\n");
	//        4194304 x x-------------------x 
	ad_loopcnt = 0;
	while (ad_loopcnt < 23) {
		if (ad_loopcnt == 0) ad_bitcnt = 1;
		else ad_bitcnt = ad_mathlib_powbit(ad_loopcnt,2);
		ad_lftos(self, ad_bitcnt, 7, 0, ad_BUFFER_DPRINT);
		if (ad_configflag & ad_bitcnt) dprint(" 1 ");
		else dprint(" 0 ");
		if (ad_loopcnt == 0) dprint("Rune 1\n");
		else if (ad_loopcnt == 1) dprint("Rune 2\n");
		else if (ad_loopcnt == 2) dprint("Rune 3\n");
		else if (ad_loopcnt == 3) dprint("Rune 4\n");
		else if (ad_loopcnt == 4) dprint("Spawn bit 1\n");
		else if (ad_loopcnt == 5) dprint("Spawn bit 2\n");
		else if (ad_loopcnt == 6) dprint("Spawn bit 3\n");
		else if (ad_loopcnt == 7) dprint("Serverflag has active data\n\n");
		else if (ad_loopcnt == 8) dprint("Ammo/HP item are offset\n");
		else if (ad_loopcnt == 9) dprint("Always use sprite particles\n");
		else if (ad_loopcnt == 10) dprint("Turn ON particle system\n");
		else if (ad_loopcnt == 11) dprint("Turn OFF Dev helpers\n\n");
		else if (ad_loopcnt == 12) dprint("Shadow Axe\n");
		else if (ad_loopcnt == 13) dprint("Widowmaker\n");
		else if (ad_loopcnt == 14) dprint("Plasma Gun\n");
		else if (ad_loopcnt == 15) dprint("Grapple Hook\n\n");
		else if (ad_loopcnt == 16) dprint("--\n");
		else if (ad_loopcnt == 17) dprint("Shotgun projectiles\n");
		else if (ad_loopcnt == 18) dprint("Shotgun casings\n");
		else if (ad_loopcnt == 19) dprint("Z aware monsters\n");
		else if (ad_loopcnt == 20) dprint("Enemy/player footsteps\n");
		else if (ad_loopcnt == 21) dprint("MWheel NG/SNG Skip\n");
		else if (ad_loopcnt == 22) dprint("Monster Liquid damage\n");
		else if (ad_loopcnt == 23) dprint("--\n");
		ad_loopcnt = ad_loopcnt + 1;
	}
	dprint("-----------------------------------\n");
};

//----------------------------------------------------------------------
// Once global variables are available (client/server is setup)
// Sync the serverflag with the configflag
//----------------------------------------------------------------------
void() ad_sync_configflag =
{
	local float ad_checkflag;
	
	// At this point the live data is all over the place and needs to be merged
	// The serverflag can contain (rune keys and console options) if quickload
	// and the configflag contains default + worldspawn keys
	if (serverflags & ad_SVR_LIVE) {
		dprint("\b[SERVERFLAG]\b LIVE data detected\n");
		// Take 1-16 runes & spawn options, 17-23 mod/console options
		ad_checkflag = (serverflags & ad_SVR_LOWFLAG) + (ad_configflag & ad_SVR_HIGHFLAG);

		// Make sure all flags are in sync with each other
		ad_configflag = serverflags = ad_checkflag | ad_SVR_LIVE;
	}
	else {
		dprint("\b[SERVERFLAG]\b new game detected\n");
		// Update the serverflags ready for future updates
		serverflags =  ad_configflag | ad_SVR_LIVE;	
	}
};

//----------------------------------------------------------------------
void() ad_display_configflag =
{
	// No warning message, called from client.qc
	if (ad_developer == ad_FALSE) return;

	dprint("\n\b[CONFIG]\b MOD Settings ("); 
	if (ad_configflag & ad_SVR_LIVE) dprint(ftos(ad_configflag-ad_SVR_LIVE));
	else dprint(ftos(ad_configflag));
	if (ad_configflag & ad_SVR_LIVE) dprint(") L\n");
	else dprint(")\n");
	dprint("--------------------------------------\n");

	// Particle system
	if (ad_query_configflag(ad_SVR_PARTICLES)) dprint("+ Particle System enabled\n");
	else dprint("- Particle System disabled\n");
	if (ad_query_configflag(ad_SVR_SPRPARTON) || world.ad_sprite_particles == ad_TRUE) 
		dprint("* Sprite/Dot particles ONLY\n");
	if (ad_query_weathersystem() == ad_TRUE) dprint("+ Weather System enabled\n");
	else dprint("- Weather System disabled\n");
	
	// Advanced engines active?
	if (ad_ext_active) {
		// Check for CSQC disabled console variable?
		if (cvar("cl_nocsqc") == 1) dprint("- Client Server QC HUD disabled\n");
		else if (self.ad_ext_csqc > 0) dprint("+ Client Server QC HUD enabled\n");
	}
	// Default = CSQC not supported
	else dprint("* Server side engine HUD active\n");

	// Check for scratch1-4 variables
	if (cvar("scratch1") > 0) {
		dprint("+ Scratch1 CSQC Hud ("); 
		dprint(ftos(cvar("scratch1")));
		dprint(") active\n");
	}
	if (cvar("scratch2") > 0) {
		dprint("+ Scratch2 Seed (");
		dprint(ftos(cvar("scratch2")));
		dprint(") active\n");
	}
	if (cvar("scratch3") > 0) {
		dprint("+ Scratch3 Chaos mode (");
		dprint(ftos(cvar("scratch3")));
		dprint(") active\n");
	}
	if (cvar("scratch4") > 0) dprint("+ Scratch4 Skill 4 (EVIL) enabled\n");
	if (cvar("saved1") > 0) dprint("- Saved1 Sprite Particles enabled\n");
	if (cvar("saved2") > 0) dprint("- Saved2 Enemy/player footsteps off\n");
	if (cvar("saved3") > 0) dprint("- Saved3 Shotgun casings disabled\n");
	if (cvar("saved4") > 0) dprint("- Saved4 Shotgun Projectiles disabled\n");
	
	// All new MOD weapons
	if (world.ad_upgrade_axe < 0) dprint("W Axe Upg Removed on Worldspawn\n");
	else if (world.ad_upgrade_axe > 0) dprint("W Axe Upg Added on Worldspawn\n");
	else if (ad_query_temp1flag(ad_SVR_UPDAXE)) dprint("* Axe Upgrade in quake.rc\n");
	else if (ad_query_configflag(ad_SVR_UPDAXE)) dprint("+ Axe Upgrade from inventory\n");
	else dprint("- NO Axe upgrade detected\n");

	if (world.ad_upgrade_ghook < 0) dprint("W GHook Removed on Worldspawn\n");
	else if (world.ad_upgrade_ghook > 0) dprint("W GHook Added on Worldspawn\n");
	else dprint("- NO Grapple Hook detected\n");

	if (world.ad_upgrade_ssg < 0) dprint("W SSG Upg Removed on Worldspawn\n");
	else if (world.ad_upgrade_ssg > 0) dprint("W SSG Upg Added on Worldspawn\n");
	else if (ad_query_temp1flag(ad_SVR_UPDSSG)) dprint("* SSG Upgrade in quake.rc\n");
	else if (ad_query_configflag(ad_SVR_UPDSSG)) dprint("+ SSG Upgrade from inventory\n");
	else dprint("- NO SSG upgrade detected\n");

	if (world.ad_upgrade_lg < 0) dprint("W LG Upg Removed on Worldspawn\n");
	else if (world.ad_upgrade_lg > 0) dprint("W LG Upg Added on Worldspawn\n");
	else if (ad_query_temp1flag(ad_SVR_UPDLG)) dprint("* LG Upgrade in quake.rc\n");
	else if (ad_query_configflag(ad_SVR_UPDLG)) dprint("+ LG Upgrade from inventory\n");
	else dprint("- NO LG upgrade detected\n");

	// New Shotgun bullet projectile/casing system
	if (world.ad_no_sgprojectile > 0) dprint("W SG Projs Disabled on worldspawn\n");
	else if (ad_query_configflag(ad_SVR_SHOTGPROJ)) dprint("- Shotgun hitscan system\n");
	else dprint("+ Shotgun projectiles system\n");
	if (world.ad_no_sgcasing > 0) dprint("W SG Casing Disabled on worldspawn\n");
	else if (ad_query_configflag(ad_SVR_SHOTGCASE)) dprint("- Shotgun casing disabled\n");
	else dprint("+ Shotgun casing enabled\n");
	if (ad_playerprojsize == 0) dprint("+ Large Projectile Collision\n");
	else dprint("- Small Projectile Collision\n");
	if (!ad_CheckZeroVector(world.ad_plasmagun_dmg)) {
		dprint("+ Plasma gun damage ("); dprint(ftos(rint(ad_map_plasmagundmg_x)));
		dprint(" "); dprint(ftos(rint(ad_map_plasmagundmg_y)));
		dprint(" "); dprint(ftos(rint(ad_map_plasmagundmg_z)));
		dprint(")\n");
	}
	if (!ad_CheckZeroVector(world.ad_player_health)) {
		dprint("+ Player Max HP ("); dprint(ftos(rint(world.ad_player_health_x)));
		dprint(" "); dprint(ftos(rint(world.ad_player_health_y)));
		dprint(") Skill ("); dprint(ftos(rint(world.ad_player_health_z)));
		dprint(")\n");
	}
	if (!ad_CheckZeroVector(world.ad_bleeding_dmg)) {
		dprint("+ Bleeding %/HoT/Pause ("); 
		ad_lftos(self, world.ad_bleeding_dmg_x, 1, 2, ad_BUFFER_DPRINT);
		dprint(" "); dprint(ftos(world.ad_bleeding_dmg_y));
		dprint(" "); dprint(ftos(world.ad_bleeding_dmg_z));
		dprint(")\n");
	}

	// Items updates; origin points and random rotation
	if (ad_query_configflag(ad_SVR_ITEMOFFSET)) dprint("+ All items use center origin\n");
	else dprint("- All items use corner origin\n");
	dprint("+ All items are randomly rotated\n");

	// General MOD settings
	if (ad_autoaim_cvar >= 1) dprint("+ Player weapon autoaim disabled\n");
	else dprint("- Player weapon autoaim enabled\n");
	if (ad_query_configflag(ad_SVR_ZAWARE)) dprint("- Z Aware Monster combat disabled\n");
	else dprint("+ Z Aware Monster combat enabled\n");
	if (ad_query_configflag(ad_SVR_FOOTSTEP)) dprint("- footstep sounds disabled\n");
	else dprint("+ footstep sounds enabled\n");
	if (ad_query_configflag(ad_SVR_LIQDAM)) dprint("- monster liquid damage disabled\n");
	else dprint("+ monster liquid damage enabled\n");
	if (ad_query_configflag(ad_SVR_DEVHELPER)) dprint("- Dev helpers (mark/arrow) disabled\n");
	else dprint("+ Dev helpers (mark/arrow) enabled\n");
	if (ad_query_configflag(ad_SVR_MWHEELSKIP)) dprint("- MWheel ng/sng skip disabled\n");
	else dprint("+ MWheel ng/sng skip enabled\n");
	
	// Body fade/floor checks
	if (ad_map_bodyfadeaway > 0) dprint("+ Monster dead body fade away\n");
	else dprint("- No fade away for monster bodies\n");
	if (ad_map_bodyflrcheck > 0) dprint("+ Monster dead body check floor\n");
	else dprint("- No floor checks for monster bodies\n");

	// All monster passive state mode
	if (ad_map_passivestate > 0) dprint("+ All monsters start in passive mode\n");

	// Arcane Key Inventory suppressed
	if (world.ad_ckeyhint == ad_TRUE) dprint("- Arcane Key Inventory Msg disabled\n");
	else dprint("+ Arcane Key Inventory Msg enabled\n");
	
	// Show Homing Missile on death system
	if (ad_map_notrackondeath == ad_TRUE) dprint("+ No missile tracking on death\n");
	else dprint("- Missile tracking uses default\n");

	// Show Hazard damage if defaults been changed
	if (!ad_CheckZeroVector(world.ad_hazard_dmg)) {
		dprint("+ Hazard dmg Wa ("); dprint(ftos(ad_map_hazarddmg_x));
		dprint(") Sl ("); dprint(ftos(ad_map_hazarddmg_y));
		dprint(") La ("); dprint(ftos(ad_map_hazarddmg_z));
		dprint(")\n");
	}
	
	// Player jump height changes
	if (ad_map_jumpheight != ad_DEF_JUMPHEIGHT) {
		dprint("+ Player jump height (");
		dprint(ftos(ad_map_jumpheight)); dprint(")\n");
	}

	// Player fall damage modifiers
	if (world.ad_fall_speedlow) {
		dprint("+ Player Fall Speed Low ("); 
		dprint(ftos(ad_map_fallspeedlow)); dprint(")\n");
	}
	if (world.ad_fall_speedhigh) {
		dprint("+ Player Fall Speed High ("); 
		dprint(ftos(ad_map_fallspeedhigh)); dprint(")\n");
	}
	if (world.ad_fall_dmg) {
		dprint("+ Player Fall Damage ("); 
		dprint(ftos(ad_map_falldmg)); dprint(")\n");
	}
	if (world.ad_fall_dmgwater) {
		dprint("+ Player Fall Water Damage ("); 
		dprint(ftos(ad_map_falldmgwater)); dprint(")\n");
	}
	
	// Visual settings - fog / wateralpha / gravity
	// AD 1.8 removed SVR_NOFOGCMDS (winquake idea)
	if (ad_fog_active && ad_fog_control) {
		dprint("+ Gfog ("); 
		ad_lftos(self, ad_fog_control.ad_fog_currden, 2,3, ad_BUFFER_DPRINT); dprint(")(");
		ad_lftos(self, ad_fog_control.ad_fog_currcol_x, 1,3, ad_BUFFER_DPRINT); dprint(" ");
		ad_lftos(self, ad_fog_control.ad_fog_currcol_y, 1,3, ad_BUFFER_DPRINT); dprint(" ");
		ad_lftos(self, ad_fog_control.ad_fog_currcol_z, 1,3, ad_BUFFER_DPRINT); dprint(")\n");
	}
	else dprint("* Global fog default not defined\n");
	
	if (ad_skyfog_active && ad_skyfog_control) {
		dprint("+ Skyfog density changed ("); 
		ad_lftos(self, ad_skyfog_control.ad_skyfog_currden, 1,3, ad_BUFFER_DPRINT); 
		dprint(")\n");
	}
	else dprint("* Sky fog default not defined\n");
	
	if (ad_liquid_alpha != 1) { 
		dprint("+ Water Alpha has changed ("); 
		ad_lftos(self, ad_liquid_alpha, 0,3, ad_BUFFER_DPRINT); dprint(")\n");
	}
	if (ad_map_gravity != ad_DEF_GRAVITY) { 
		dprint("+ Map gravity has changed ("); 
		dprint(ftos(ad_map_gravity)); dprint(")\n");
	}

	// Always show compiler lightstyle boundary start point
	dprint("+ Lightstyle compiler lights at ("); 
	dprint(ftos(ad_mapstyle_start)); dprint(")\n");
	
	// DP compatible visual settings
	if (ad_engine == ad_ENG_DPEXT) {
		dprint("+ DP features ( ");
		// Show all active features
		if (ad_ext_dpfog) dprint("FOG ");
		if (ad_ext_dpsurf) dprint("SURF ");
		if (ad_ext_dprain) dprint("RAIN ");
		if (ad_ext_dpsnow) dprint("SNOW ");
		dprint(")\n");
	}
	// FTE only features
	if (ad_engine == ad_ENG_DPEXT && ad_ext_fteskin) {
		dprint("+ FTE features ( ");
		// Show all active features
		if (ad_ext_fteskin) dprint("SKIN/LADDER ");
		dprint(")\n");
	}

	// Show the coop respawn options
	if (coop > 0) {
		if (ad_coop_weapons == ad_FALSE) dprint("+ COOP weapons respawn TRUE\n");
		else dprint("- COOP weapons respawn FALSE\n");
		if (ad_coop_ammoboxes == ad_FALSE) dprint("- COOP ammo boxes respawn FALSE\n");
		else dprint("+ COOP ammo boxes respawn TRUE\n");
		if (ad_coop_health == ad_FALSE) dprint("- COOP health packs respawn FALSE\n");
		else dprint("+ COOP health packs respawn TRUE\n");
		if (ad_coop_powerups == ad_FALSE) dprint("- COOP powerups respawn FALSE\n");
		else dprint("+ COOP powerups respawn TRUE\n");
	}
	
	dprint("--------------------------------------\n");
};

/*======================================================================
 Give the player various sigils (serverflag)
 Give the player silver/gold keys
======================================================================*/
void(float ad_sigil_bit) ad_givesigil =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_impulse_devonlymode()) return;		// Dev mode only

	dprint("\b[SIGIL]\b Server updated ("); 
	dprint(ftos(ad_sigil_bit)); dprint(")\n");
	if (ad_sigil_bit & ad_SVR_RUNE_KEY1) ad_update_configflag(ad_SVR_RUNE_KEY1,ad_TRUE);
	if (ad_sigil_bit & ad_SVR_RUNE_KEY2) ad_update_configflag(ad_SVR_RUNE_KEY2,ad_TRUE);
	if (ad_sigil_bit & ad_SVR_RUNE_KEY3) ad_update_configflag(ad_SVR_RUNE_KEY3,ad_TRUE);
	if (ad_sigil_bit & ad_SVR_RUNE_KEY4) ad_update_configflag(ad_SVR_RUNE_KEY4,ad_TRUE);
};

//----------------------------------------------------------------------
void(float ad_key_bit) ad_givekey =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	if (ad_impulse_devonlymode()) return;		// Dev mode only

	dprint("\b[KEYS]\b Inventory updated ("); 
	dprint(ftos(ad_key_bit)); dprint(")\n");
	if (ad_key_bit & ad_IT_KEY1) self.items = self.items | ad_IT_KEY1;
	if (ad_key_bit & ad_IT_KEY2) self.items = self.items | ad_IT_KEY2;
};

/*======================================================================
 TOGGLE MOD features
======================================================================*/
void() ad_toggleautoaim =
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	
	self.impulse = 0;	
	// Toggle the state of the console variable
	if (ad_autoaim_cvar >= 1) ad_autoaim_cvar = 0.93;
	else ad_autoaim_cvar = 1;
	cvar_set("sv_aim", ftos(ad_autoaim_cvar));
	
	sprint(self, "\b[Impulse]\b Auto aim state ("); 
	if (ad_autoaim_cvar < 1) sprint(self, "ON)\n");
	else sprint(self, "OFF)\n");
};

//----------------------------------------------------------------------
void() ad_toggleprojsize = 
{
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	
	self.impulse = 0;	
	// Toggle the state of the global variable
	if (ad_playerprojsize == 1) ad_playerprojsize = 0;
	else ad_playerprojsize = 1;
	
	sprint(self, "\b[Impulse]\b Player proj size ("); 
	if (ad_playerprojsize == 1) sprint(self, "SMALL)\n");
	else sprint(self, "LARGE)\n");
};

//----------------------------------------------------------------------
void() ad_togglezaware =
{	
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	
	self.impulse = 0;	
	// Toggle the state of the console variable using the server flag
	if (ad_query_configflag(ad_SVR_ZAWARE)) ad_update_configflag(ad_SVR_ZAWARE, ad_FALSE);
	else ad_update_configflag(ad_SVR_ZAWARE, ad_TRUE);

	sprint(self, "\b[Impulse]\b Z Aware Monsters ("); 
	if (ad_query_configflag(ad_SVR_ZAWARE)) sprint(self, "Disabled)\n");
	else sprint(self, "Enabled)\n");
};

//----------------------------------------------------------------------
void() ad_togglepixels =
{	
	if (ad_impulse_activecameras()) return;	// Are cameras active
	if (ad_impulse_playeronly()) return;		// Player only
	
	self.impulse = 0;	
	sprint(self, "\b[SETTINGS]\b texture filtering ("); 
	if (ad_pixelmode == ad_TRUE) {
		ad_pixelmode = ad_FALSE;
		stuffcmd(self, "\ngl_texturemode GL_LINEAR_MIPMAP_LINEAR\n");
		sprint(self, "blurry)\n");
	}
	else {
		ad_pixelmode = ad_TRUE;
		stuffcmd(self, "\ngl_texturemode GL_NEAREST_MIPMAP_LINEAR\n");
		sprint(self, "crispy)\n");
	}
};

