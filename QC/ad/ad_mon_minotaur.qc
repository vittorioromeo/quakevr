	ad_minotaur_hands('20 0 48','20 2 46',4);ad_minotaur_fire('20 0 47',0);};
void() ad_mino_magic11 =[ $magic21, ad_mino_magic12 ] {ad_ai_forward(4);ad_monster_footstep(ad_FALSE);
	ad_minotaur_hands('28 0 50','28 2 48',3);ad_minotaur_fire('28 0 49',1);};
