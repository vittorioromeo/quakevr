//----------------------------------------------------------------------
void() ad_mino_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	ad_minotaur_remove_attachment();
	//delete_minionspace();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "minotaur/death.wav", 1, ad_ATTN_NORM);
		ad_mino_death1 ();
	}
};

/*======================================================================
QUAKED monster_minotaur (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_minotaur =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_minotaur.mdl";
	self.ad_headmdl = "progs/h_minotaur.mdl";		// Large head
	self.ad_gib1mdl = "progs/gib_minoclaw1.mdl";	// Left claw
	self.ad_gib2mdl = "progs/gib_minoclaw2.mdl";	// Right claw
	self.ad_gib3mdl = "progs/gib_minoleg1.mdl";	// foot
	self.ad_gib4mdl = "progs/gib_minoleg2.mdl";	// foot

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_MBALL);		// Creating attachment
	precache_model (ad_MODEL_PROJ_MPLASMA);	// Plasma bolt
	precache_model (ad_MODEL_PROJ_MPOISON);	// Poison bolt
	precache_model (ad_MODEL_PROJ_MBLOOD);		// Blood bolt
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);

	// Randomly swap claws and legs around
	self.lip = random();
	if (self.lip < 0.25) self.ad_gib1mdl = self.ad_gib4mdl;
	else if (self.lip < 0.5) self.ad_gib2mdl = self.ad_gib4mdl;
	else if (self.lip < 0.75) self.ad_gib3mdl = self.ad_gib4mdl;

	self.ad_idle_sound = "minotaur/idle1.wav";
	self.ad_idle_sound2 = "minotaur/idle2.wav";
	self.ad_idle_soundcom = "minotaur/idle1com.wav";
	self.ad_idle_soundcom2 = "minotaur/idle2com.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);
	precache_sound (self.ad_idle_soundcom2);

	precache_sound ("minotaur/swipe.wav");		// claw misses
	precache_sound ("minotaur/strike1.wav");	// claw hit1
	precache_sound ("minotaur/strike2.wav");	// claw hit2

	precache_sound ("minotaur/attack1start.wav");	// Short roar
	precache_sound ("minotaur/attack1end.wav");		// Short roar
	precache_sound ("minotaur/attack1long.wav");	// Enter rage mode
	precache_sound ("minotaur/bolt_fire.wav");		// fire projectile
	precache_sound (ad_SOUND_PLASMA_HIT);				// impact sounds

	precache_sound ("minotaur/death.wav");
	self.ad_pain_sound = "minotaur/pain1.wav";
	self.ad_pain_sound2 = "minotaur/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	self.ad_sight_sound = "minotaur/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_GIANT;
	if (self.health < 1) self.health = 500;
	self.ad_gibhealth = -60;			// Same as Shambler
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_flinch = 200;			// Demon level
	self.ad_pain_longanim = ad_TRUE;		// can be chopped with shadow axe
	self.ad_pain_timeout = 2;			// Does not repeat pain
	// Double damage to other monsters
	if (!self.ad_infightextra) self.ad_infightextra = 2;
	self.ad_steptype = ad_FS_TYPELARGE;	// Giant sound
	self.ad_blockudeath = ad_TRUE;		// No humanoid death
	self.ad_deathstring = " was gored by a Minotaur\n";
	
	// Default jump forward/up distance
	if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '450 0 250';
	if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPMINONEAR;
	if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPMINOFAR;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = 0; self.ad_resist_cells = 0.5;
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles

	self.ad_th_checkattack = ad_MinotaurCheckAttack;
	self.ad_th_stand = ad_mino_stand1;
	self.ad_th_walk = ad_mino_walk1;
	self.ad_th_run = ad_mino_run;
	self.ad_th_melee = ad_mino_melee;
	self.ad_th_missile = ad_mino_magic;
	self.ad_th_pain = ad_mino_pain;
	self.ad_th_die = ad_mino_die;
	self.ad_th_jump = ad_mino_jump1;
	self.ad_th_jumpexit = ad_mino_jump10;
	self.ad_th_charge = ad_mino_howl1;
	
	// Update Minotaur based on minions spawnflag
	if (self.spawnflags & ad_MON_MINOTAUR_MINIONS) {
		if (self.ad_poisonous < 0) {
			self.ad_poisonous = ad_FALSE;			// Special version (blood/fire)
			//precache_bloodgibs();			// precache gibs (in world.qc)
			self.ad_gibtype = ad_GIBTYPE_BLOOD;	// blood trails
			self.ad_part_style = ad_PARTICLE_BURST_RED;
		}
		else {
			self.ad_poisonous = ad_TRUE;			// Poison version (default)
			ad_precache_poisongibs();			// precache gibs
			self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
			self.ad_part_style = ad_PARTICLE_BURST_GREEN;
		}
		self.ad_exactskin = 1;				// Black skin + yellow eyes
		self.ad_gib1skin = self.ad_gib2skin = self.ad_gib3skin = 1;
		// Reduce minions down to 3, gargoyles are tougher to kill
		if (!self.ad_minion_maxcount) self.ad_minion_maxcount = 3;
	}
	else {
		self.ad_poisonous = ad_FALSE;			// Default White version
		//precache_bloodgibs();			// precache gibs (in world.qc)
		self.ad_gibtype = ad_GIBTYPE_BLOOD;	// blood trails
		self.ad_part_style = ad_PARTICLE_BURST_BLUE;
	}

	self.ad_classtype = ad_CT_MONMINOTAUR;
	self.ad_classgroup = ad_CG_DEMON;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
