//============================================================================
// MELEE ATTACK (claws)
//============================================================================
void(float ad_side) ad_mino_claw =
{
	local float ad_ldmg;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	VR_MeleeArc_TurnBegin(); ad_ai_face (); VR_MeleeArc_TurnEnd(); // AD support: melee arc: the swing's turn held (fight.qc)						// Turn towards enemy target
	ad_ai_damagebreakable(50);			// Damage any breakables

	if (!(ad_ai_checkmelee(ad_MONAI_MELEEMINOTAUR, ad_MONAI_MELEEZTALL) && VR_MeleeArc_Hits(ad_side != 0)) || !self.enemy.takedamage) { // AD support: melee arc (fight.qc VR_MeleeArc_Hits)
		// Melee claw miss sound
		sound (self, ad_CHAN_WEAPON, "minotaur/swipe.wav", 1, ad_ATTN_NORM);
	}
	else {
		// Melee claw hit sound
		if (self.lefty) sound (self, ad_CHAN_WEAPON, "minotaur/strike1.wav", 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_WEAPON, "minotaur/strike2.wav", 1, ad_ATTN_NORM);
		self.lefty = 1 - self.lefty;
		ad_ldmg = 12 + 6*random();
		// Rage attack is once per animation frame, more deadly
		if (self.ad_attack_rage) ad_ldmg = ad_ldmg*2;
		ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);		
		ad_SpawnMeatSpray (self, self.enemy, ad_side);
	}
};

