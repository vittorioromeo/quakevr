void() ad_mino_magic16 =[ $magic31, ad_mino_run ] {ad_ai_face();};

//----------------------------------------------------------------------
// Spawn particles from body that float upwards during summons
//----------------------------------------------------------------------
void() ad_mino_sumeffect = 
{ ad_particle_debuff(self.origin+'0 0 64', 16, rint(4+random()*4), self.ad_part_style);};

//----------------------------------------------------------------------
// Display a ball where the gargoyle is spawning
//----------------------------------------------------------------------
void(float ad_dbframe) ad_mino_sumball =
{
	// Double check the space checks worked
	if (self.aflag == ad_FALSE) return;
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_dbframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.pos2);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.skin = ad_minotaur_skin_type(self);
	}
	
	// rotate and fade the ball as it grows
	self.ad_attachment.angles_y = rint(random()*359);
	self.ad_attachment.frame = ad_dbframe;
	self.ad_attachment.lip = 0.3 + ((7-ad_dbframe) * 0.1);
	self.ad_attachment.alpha = self.ad_attachment.lip;
	ad_particle_explode(self.pos2, 5+random()*10, 3, self.ad_part_style, ad_PARTICLE_BURST_MINOTAUR);
};

//----------------------------------------------------------------------
// Raise up head and howl at the sky and spawn green particles from body
// Always check if there is space to spawn a gargoyle first
// Block monster pain function so that the summons is completed
//----------------------------------------------------------------------
void() ad_mino_summon1 =[ $howl1, ad_mino_summon2 ] {ad_ai_face();self.ad_pain_finished = time + 2;};
void() ad_mino_summon2 =[ $howl3, ad_mino_summon3 ] {ad_ai_face();};
void() ad_mino_summon3 =[ $howl5, ad_mino_summon4 ] {ad_ai_face();ad_mino_sumeffect();
	sound (self, ad_CHAN_BODY, "minotaur/attack1long.wav", 1, ad_ATTN_NORM);};
void() ad_mino_summon4 =[ $howl7, ad_mino_summon5 ] {ad_mino_sumeffect();};
void() ad_mino_summon5 =[ $howl9, ad_mino_summon6 ] {ad_mino_sumeffect();};
void() ad_mino_summon6 =[ $howl11, ad_mino_summon7 ] {ad_mino_sumeffect();};
void() ad_mino_summon7 =[ $howl13, ad_mino_summon8 ] {ad_mino_sumeffect();
	// Find out if there is enough space to spawn a gargoyle
	// Findradius version
	makevectors(self.angles);
	self.pos1 = self.origin + self.view_ofs + v_forward*64 + v_up*32;
	self.aflag = ad_find_minionspace(self.pos1);
	
	// If the spawn locaiton all clear, spawn something!
	if (self.aflag == ad_TRUE) {
		ad_minion_gargoyle(self.pos1, self.enemy);
		self.pos2 = self.pos1 - '0 0 16';	// Origin of gargoyle
		ad_mino_sumball(0);
	}
};
void() ad_mino_summon8 =[ $howl15, ad_mino_summon9 ] {ad_mino_sumeffect();ad_mino_sumball(1);};
void() ad_mino_summon9 =[ $howl17, ad_mino_summon10 ] {ad_mino_sumeffect();ad_mino_sumball(2);};
void() ad_mino_summon10 =[ $howl19, ad_mino_summon11 ] {ad_mino_sumeffect();ad_mino_sumball(3);};
void() ad_mino_summon11 =[ $howl21, ad_mino_summon12 ] {ad_mino_sumeffect();ad_mino_sumball(4);};
void() ad_mino_summon12 =[ $howl23, ad_mino_summon13 ] {ad_mino_sumeffect();ad_mino_sumball(5);};
void() ad_mino_summon13 =[ $howl25, ad_mino_summon14 ] {ad_mino_sumeffect();ad_mino_sumball(6);};
void() ad_mino_summon14 =[ $howl27, ad_mino_summon15 ] {ad_mino_sumeffect();ad_mino_sumball(7);};
void() ad_mino_summon15 =[ $howl29, ad_mino_summon16 ] {ad_minotaur_finish_attachment();
	if (self.aflag == ad_TRUE) ad_particle_explode(self.pos1, 50, 3, self.ad_part_style, ad_PARTICLE_BURST_MINOTAUR);};
void() ad_mino_summon16 =[ $howl31, ad_mino_summon17 ] {};
void() ad_mino_summon17 =[ $howl33, ad_mino_summon18 ] {ad_ai_face();};
void() ad_mino_summon18 =[ $howl35, ad_mino_run ] {ad_ai_face();ad_SUB_AttackFinished (1 + 2*random());};

//----------------------------------------------------------------------
// Both type of minotaurs go through the same magic function
//----------------------------------------------------------------------
void() ad_mino_magic =
{
	local entity ad_miniondef;
	
	// Make sure the attachments are setup ready
	ad_minotaur_create_attachment();

	if (self.spawnflags & ad_MON_MINOTAUR_MINIONS && !self.ad_minion_active) {
		// Check for minion template first
		ad_miniondef = find(world,classname,"monster_minotaurminion");
		if (ad_miniondef.ad_classtype == ad_CT_CACHEGARGOYLE) ad_setup_minionsupport();
		else {
			// If template no available, warn and remove feature
			dprint("\b[MINOTAUR]\b Cannot find minion template!\n");
			self.spawnflags = self.spawnflags - ad_MON_MINOTAUR_MINIONS;
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		}
	}
	
	// Is the target the player or monster?
	if (self.enemy.flags & ad_FL_CLIENT) {
		if (self.spawnflags & ad_MON_MINOTAUR_MINIONS) {
			// has the gargoyle limit been reached?
			if (ad_query_minionactive(self) == ad_TRUE) ad_mino_summon1();
			else {
				if (self.ad_minion_baseattack > 0 ) ad_mino_magic1();
				else ad_mino_run();
			}
		}
		// White Minotaur attacks with plasma
		else ad_mino_magic1();
		
	}
	// Always attack monsters with plasma/poison projectiles
	else ad_mino_magic1();
};

//============================================================================
// CHARGE ATTACK - just been hit with a long pain animation (pre-rage only)
//============================================================================
void(float ad_dist) ad_mino_chargecheck =
{
	// turn, face and pursue enemy
	ad_ai_charge(ad_dist);
	// Close enough for melee combat?
	if (ad_ai_checkmelee(ad_MONAI_MELEEMINOTAUR, ad_MONAI_MELEEZTALL)) self.ad_th_melee();
	// Enemy dead? run out of stamina or enemy not infront?
	if (self.enemy.health < 1) self.think = ad_mino_run;
	else if (self.ad_attack_finished < time) self.think = ad_mino_run;
	else if (!ad_infront(self.enemy)) self.think = ad_mino_run;
};

//----------------------------------------------------------------------
void() ad_mino_charge1 =[ $charge1, ad_mino_charge2 ] {ad_mino_chargecheck(34);};
void() ad_mino_charge2 =[ $charge3, ad_mino_charge3 ] {ad_mino_chargecheck(28);ad_monster_footstep(ad_FALSE);};
void() ad_mino_charge3 =[ $charge5, ad_mino_charge4 ] {ad_mino_chargecheck(26);};
void() ad_mino_charge4 =[ $charge7, ad_mino_charge5 ] {ad_mino_chargecheck(34);};
void() ad_mino_charge5 =[ $charge9, ad_mino_charge6 ] {ad_mino_chargecheck(28);ad_monster_footstep(ad_FALSE);};
void() ad_mino_charge6 =[ $charge11, ad_mino_charge1 ] {ad_mino_chargecheck(26);};

//----------------------------------------------------------------------
void() ad_mino_charge =
{
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
	self.ad_attack_finished = time + 2 + random();
	ad_mino_charge1();
};

//============================================================================
// (133) Quick pain flinch backward
void() ad_mino_pain1 = [ $pain1, ad_mino_pain2 ] {};
void() ad_mino_pain2 = [ $pain2, ad_mino_pain3 ] {};
void() ad_mino_pain3 = [ $pain3, ad_mino_pain4 ] {};
void() ad_mino_pain4 = [ $pain4, ad_mino_pain5 ] {};
void() ad_mino_pain5 = [ $pain5, ad_mino_pain6 ] {};
void() ad_mino_pain6 = [ $pain6, ad_mino_pain7 ] {};
void() ad_mino_pain7 = [ $pain7, ad_mino_pain8 ] {};
void() ad_mino_pain8 = [ $pain8, ad_mino_run ] {};

//----------------------------------------------------------------------
// (141) Stationary - shake head/arms
// Block the pain and then start charging like crazy
void() ad_mino_shake1 = [ $shake1, ad_mino_shake2 ] {self.ad_pain_finished = time + 2;};
void() ad_mino_shake2 = [ $shake3, ad_mino_shake3 ] {};
void() ad_mino_shake3 = [ $shake5, ad_mino_shake4 ] {};
void() ad_mino_shake4 = [ $shake7, ad_mino_shake5 ] {};
void() ad_mino_shake5 = [ $shake9, ad_mino_shake6 ] {};
void() ad_mino_shake6 = [ $shake11, ad_mino_shake7 ] {};
void() ad_mino_shake7 = [ $shake13, ad_mino_shake8 ] {};
void() ad_mino_shake8 = [ $shake15, ad_mino_shake9 ] {};
void() ad_mino_shake9 = [ $shake17, ad_mino_shake10 ] {};
void() ad_mino_shake10 = [ $shake19, ad_mino_run ] {
	// If pre-rage and can see enemy, start chasing
	if (self.ad_attack_rage == ad_FALSE && ad_infront(self.enemy)) self.think = ad_mino_charge;
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_mino_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);
	ad_minotaur_finish_attachment();

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		self.lip = random();
		if (self.lip < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);

		if (self.ad_pain_check == 1) {
			// Minion spawning minotaur always goes short pain cycle
			if (self.spawnflags & ad_MON_MINOTAUR_MINIONS) ad_mino_pain1();
			else {
				if (self.lip < 0.4) ad_mino_pain1();
				else ad_mino_shake1();
			}
		}
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.8;
			self.ad_axhitme = 0;
			ad_mino_pain1();
		}
	}
};

