void() ad_mino_slapL1 =[ $bwalk19, ad_mino_slapL2 ] {ad_ai_charge(10);ad_monster_footstep(ad_FALSE);};
void() ad_mino_slapL2 =[ $bwalk21, ad_mino_slapL3 ] {ad_ai_charge(4);};
void() ad_mino_slapL3 =[ $bwalk23, ad_mino_slapL4 ] {ad_ai_charge(9);};
void() ad_mino_slapL4 =[ $bwalk1, ad_mino_slapL5 ] {ad_ai_charge(12);ad_mino_claw(-250);};
void() ad_mino_slapL5 =[ $bwalk3, ad_mino_slapL6 ] {ad_ai_charge(12);};
void() ad_mino_slapL6 =[ $bwalk5, ad_mino_slapR1 ] {ad_ai_charge(9);};

void() ad_mino_slapR1 =[ $bwalk7, ad_mino_slapR2 ] {ad_ai_charge(10);ad_monster_footstep(ad_FALSE);};
void() ad_mino_slapR2 =[ $bwalk9, ad_mino_slapR3 ] {ad_ai_charge(4);};
void() ad_mino_slapR3 =[ $bwalk11, ad_mino_slapR4 ] {ad_ai_charge(9);};
void() ad_mino_slapR4 =[ $bwalk13, ad_mino_slapR5 ] {ad_ai_charge(12);ad_mino_claw(250);};
void() ad_mino_slapR5 =[ $bwalk15, ad_mino_slapR6 ] {ad_ai_charge(12);};
void() ad_mino_slapR6 =[ $bwalk17, ad_mino_run ] {ad_ai_charge(9);
	// Check if enemy is close, alive and visible before doing more melee
	if (random() < 0.5 && ad_ai_checkmelee(ad_MONAI_MELEEMINOTAUR, ad_MONAI_MELEEZTALL) && 
		self.enemy.health > 0 && ad_visible(self.enemy)) self.think = ad_mino_slapL1;
};

