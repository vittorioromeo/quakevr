void() ad_mino_gore6 =[ $gore12, ad_mino_run ] {ad_ai_charge(26);};

//----------------------------------------------------------------------
void() ad_mino_melee =
{
	// Switch to a faster more deadly melee attack if in rage mode
	if (self.ad_attack_rage) ad_mino_gore1();
	else {
		// Randomly start left or right and then loop
		if (random() < 0.5) ad_mino_slapR1();
		else ad_mino_slapL1();
	}
};

//============================================================================
// JUMP ATTACK - pre-rage only
//============================================================================
void() ad_mino_JumpTouch =
{
	local float ad_ldmg;

	if (self.health < 1) return;
	ad_ai_jumpbreakable(30);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame

	// Keep track of how many times touched the same object
	if (self.ad_jumptouch == other) self.jump_flag = time + ad_MONAI_JUMPTIMEOUT;
	self.ad_jumptouch = other;			// Keep track of touch target

	if ( ad_CanDamage(other, self) ) {
		if ( vlen(self.velocity) > 300 ) {
		  ad_ldmg = 20 + 10*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
		}
	}

	// Is the minotaur floating in the air?
	if (!checkbottom(self)) {
		// Is the minotaur standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_mino_jump1 =[ $jump1, ad_mino_jump2 ] {
	self.jump_flag = time + ad_MONAI_JUMPMINOTIME;
	// Use combat idle grunt sounds (can get annoying otherwise)
	if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_idle_soundcom, 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, self.ad_idle_soundcom2, 1, ad_ATTN_NORM);
};
void() ad_mino_jump2 =[ $jump3, ad_mino_jump3 ] {ad_ai_face();};
void() ad_mino_jump3 =[ $jump5, ad_mino_jump4 ] {ad_ai_face();};
void() ad_mino_jump4 =[ $jump7, ad_mino_jump5 ] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPMINOTIME;
	self.touch = ad_mino_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};

// Flying through the air waiting to touch something!
void() ad_mino_jump5 =[ $jump9, ad_mino_jump6 ] {ad_ai_face();};
void() ad_mino_jump6 =[ $jump11, ad_mino_jump7 ] {};
void() ad_mino_jump7 =[ $jump13, ad_mino_jump8 ] {ad_ai_face();};
void() ad_mino_jump8 =[ $jump15, ad_mino_jump8 ] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; 	//random jump angle
		self.think = ad_mino_jump4;			// Keep jumping
	}
	self.oldorigin = self.origin;
};
//----------------------------------------------------------------------
void() ad_mino_jump10 =[ $jump19, ad_mino_jump12 ] {ad_ai_charge(8);ad_monster_footstep(ad_FALSE);};
void() ad_mino_jump12 =[ $jump23, ad_mino_run ] {ad_ai_charge(10);ad_ai_resetangles();
	// If close enough start melee ELSE return to run cycle
	if (ad_ai_checkmelee(ad_MONAI_MELEEMINOTAUR, ad_MONAI_MELEEZTALL) && self.enemy.health > 0) 
		self.think = ad_mino_melee;
};

//============================================================================
// RANGE ATTACK - Plasma Bolts (rocket)
//============================================================================
float(entity ad_targ) ad_minotaur_skin_type = 
{
	// Switch skin around for spawning effect
	if (ad_targ.spawnflags & ad_MON_MINOTAUR_MINIONS) {
		if (ad_targ.ad_poisonous) return ad_MINO_GREEN;
		else return ad_MINO_RED;
	}
	// Default = blue version
	return ad_MINO_BLUE;
};

//----------------------------------------------------------------------
void() ad_minotaur_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.mdl = ad_MODEL_PROJ_MBALL;
	}
	if (!self.ad_attachment2) {
		self.ad_attachment2 = spawn();
		self.ad_attachment2.owner = self;
		self.ad_attachment2.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment2.mdl = ad_MODEL_PROJ_MBALL;
	}
};

//----------------------------------------------------------------------
void() ad_minotaur_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
	if (self.ad_attachment2) {
		setmodel(self.ad_attachment2, "");
		self.ad_attachment2.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_minotaur_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
	if (self.ad_attachment2) {
		self.ad_attachment2.think = ad_SUB_Remove;
		self.ad_attachment2.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
void(entity ad_handent, vector ad_orgofs, float ad_dbframe) ad_minotaur_handball =
{
	local vector ad_org;
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_dbframe == 0) {
		ad_handent.state = ad_STATE_ON;
		setorigin(ad_handent, self.origin);
		setmodel(ad_handent, ad_handent.mdl);
		setsize (ad_handent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_handent.movetype = ad_MOVETYPE_NONE;
		ad_handent.solid = ad_SOLID_NOT;
		// Switch skin around for spawning effect
		ad_handent.skin = ad_minotaur_skin_type(self);
		ad_handent.alpha = 0.85;
	}
	
	// Generate attachment in hand (left)
	// makevectors set in previous function (minotaur_hands)
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	setorigin(ad_handent, ad_org);
	ad_handent.angles_y = rint(random()*359);
	ad_handent.frame = ad_dbframe;
};

//----------------------------------------------------------------------
// There is a ball for each hand with different origins
//----------------------------------------------------------------------
void(vector ad_leftofs, vector ad_rightofs, float ad_dbframe) ad_minotaur_hands =
{
	if (self.health < 1) return;
	
	// Keep turning towards enemy
	ad_ai_face();
	makevectors(self.angles);
	
	// Generate a ball in each hand
	ad_minotaur_handball(self.ad_attachment, ad_leftofs, ad_dbframe);
	ad_minotaur_handball(self.ad_attachment2, ad_rightofs, ad_dbframe);
};

//----------------------------------------------------------------------
// Fire a volley of plasma/poison bolts at the enemy
//----------------------------------------------------------------------
void(vector ad_orgofs, float ad_angofs) ad_minotaur_fire =
{
	local vector ad_org, ad_dir;

	if (!self.enemy) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_MINOBOLT + (ad_skill * ad_SPEED_MINOSKILL);
	
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	ad_dir = (self.enemy.origin - ad_org) + (v_right*(ad_angofs*30));
	ad_dir = normalize (ad_dir);

	// The DARK minotaur (spawner) has two types of spikes
	if (self.spawnflags & ad_MON_MINOTAUR_MINIONS) {
		if (self.ad_poisonous) ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_MPOISON, self.ad_attack_speed);
		else ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_MBLOOD, self.ad_attack_speed);
	}
	else {
		// Projectile behaves like plasma (light/trail/impact effects)
		// The correct projectile model is switched in launch function
		ad_launch_plasma(ad_org, ad_dir, ad_CT_MONMINOTAUR, self.ad_attack_speed);
	}
};

