/*======================================================================
 AI (monster) FUNCTIONALITY
  =====================================================================*/

/*======================================================================
 check_liquidblock
 - Checks pointcontents of source+target because traceline parms
   are not 100% reliable for flagging water/air content
 - One function check for all the different visibility functions
 - Designed to work with the new liquidblock entity flag
======================================================================*/
float(vector ad_org_source, vector ad_org_targ) ad_check_liquidblock =
{
	local float ad_pc_source, ad_pc_targ;
	
	// Is r_wateralpha set or monsters forced to check liquid surfaces?
	if (ad_liquid_alpha == 1 || self.ad_liquidblock) {
		// Check point contents first
		ad_pc_source = pointcontents(ad_org_source);
		ad_pc_targ = pointcontents(ad_org_targ);
		// Are point content different? (like water/air)
		if (ad_pc_source != ad_pc_targ) return ad_TRUE;
		
		// Standard traceline check (not 100% reliable)
		if (trace_inopen && trace_inwater) return ad_TRUE;
	}
	
	// No liquid check required
	return ad_FALSE;
};

/*======================================================================
 visible (target entity)
 Conditions added to water surface check
 - most maps are compiled with transparent water nowadays
======================================================================*/
float(entity ad_targ) ad_visible =
{
	local vector ad_spot1, ad_spot2;
	
	ad_spot1 = self.origin + self.view_ofs;
	ad_spot2 = ad_targ.origin + VR_AD_ViewOfs(ad_targ);
	traceline (ad_spot1, ad_spot2, ad_TRUE, self);	// see through other monsters
	
	// Debug system (enabled via axe) uses funcs from subs_soc.qc
	// This will draw a diamond model where the AI is looking
	if (self.ad_debuglvl) {
		if (!ad_debugent1) ad_debugent1 = ad_spawn_devmarker(self.origin);
		ad_spot1 = vectoangles(self.origin - trace_endpos);
		makevectors(ad_spot1);
		ad_spot2 = trace_endpos + (v_up * -16) + (v_forward * 50);
		setorigin(ad_debugent1,'0 0 0');
		setorigin(ad_debugent1, ad_spot2);
	}

	// Check for liquid surface block condition
	if (ad_check_liquidblock(ad_spot1, ad_spot2) == ad_TRUE) return ad_FALSE;

	if (trace_fraction == 1) return ad_TRUE;
	return ad_FALSE;
};

/*======================================================================
 visxray (variable options)
  Returns TRUE if there is no blocking, FALSE if something in the way
  Custom options for variable source/target offsets and monster blocking
  (nomonsters) TRUE = no block, FALSE = blocked
  self is excluded from any trace starting points
======================================================================*/
float(entity ad_targ, vector ad_s_offset, vector ad_t_offset, float ad_nomonsters) ad_visxray =
{
	local vector ad_spot1, ad_spot2;

	// Bmodels don't have proper origins
	if (self.ad_bsporigin) ad_spot1 = ad_bmodel_origin(self) + ad_s_offset;
	else ad_spot1 = self.origin + ad_s_offset;

	ad_spot2 = ad_targ.origin + ad_t_offset;
	traceline (ad_spot1, ad_spot2, ad_nomonsters, self);	// custom options
	
	// Check for liquid surface block condition
	if (ad_check_liquidblock(ad_spot1, ad_spot2) == ad_TRUE) return ad_FALSE;

	// monster blocking changes which test to use
	if (ad_nomonsters) {
		// Has the traceline gone from source>target without anything blocking?
		if (trace_fraction == 1) return ad_TRUE;
		return ad_FALSE;
	}
	else {
		// Is the entity hit by the traceline the targ destination?
		if (trace_ent == ad_targ) return ad_TRUE;
		return ad_FALSE;
	}
};

/*======================================================================
 visang (works similar to visxray function)
  The enemy location is based on the source facing angles
  Returns TRUE if there is no blocking, FALSE if something in the way
  Custom options for variable source offsets and monster blocking
  (nomonsters) TRUE = no block, FALSE = blocked
  self is excluded from any trace starting points
======================================================================*/
float(entity ad_targ, vector ad_s_offset, vector ad_targang, float ad_nomonsters) ad_visang =
{
	local vector ad_spot1, ad_spot2;

	// Bmodels don't have proper origins
	if (self.ad_bsporigin) ad_spot1 = ad_bmodel_origin(self) + ad_s_offset;
	else ad_spot1 = self.origin + ad_s_offset;

	// Use supplied ang + v_forward for direction
	makevectors(ad_targang);
	ad_spot2 = ad_spot1 + (v_forward * 4096);
	
	// Trace a line using angle vector instead of enemy origin
	traceline (ad_spot1, ad_spot2, ad_nomonsters, self);
	
	// Check for liquid surface block condition
	if (ad_check_liquidblock(ad_spot1, ad_spot2) == ad_TRUE) return ad_FALSE;

	// monster blocking changes which test to use
	if (ad_nomonsters) {
		// Has the traceline gone from source>target without anything blocking?
		if (trace_fraction == 1) return ad_TRUE;
		return ad_FALSE;
	}
	else {
		// Is the entity hit by the traceline the targ destination?
		if (trace_ent == ad_targ) return ad_TRUE;
		return ad_FALSE;
	}
};

/*======================================================================
 visblocked (target entity)
 check to see if sightline is blocked by other monsters
 Really only used in CheckAttack functions (was in org ID code)
======================================================================*/
float(entity ad_targ) ad_visblocked =
{
	local vector ad_spot1, ad_spot2;
	
	ad_spot1 = self.origin + self.view_ofs;
	ad_spot2 = ad_targ.origin + VR_AD_ViewOfs(ad_targ);
	traceline (ad_spot1, ad_spot2, ad_FALSE, self);	// blocked by monsters
	
	// Check for liquid surface block condition
	if (ad_check_liquidblock(ad_spot1, ad_spot2) == ad_TRUE) return ad_FALSE;

	// Original ID behaviour for this type of function
	// Traceline entity hit = enemy?
	if (trace_ent == ad_targ) return ad_FALSE;
	return ad_TRUE;
};

/*======================================================================
 viswide (target entity)
  check to see if sightline is blocked by other monsters
  extra wide check using 3 traces, +/- 16 left/right and origin
  All three traces have to complete for a positive result
======================================================================*/
float (entity ad_targ, vector ad_s_ofset, vector ad_t_ofset) ad_visblocked_wide =
{
	local vector ad_spot1, ad_spot2, ad_spot3, ad_tr_line;
	local float ad_tr_leftmon, ad_tr_rightmon, ad_tr_result;

	ad_tr_line = '0 0 0';
	ad_tr_leftmon = ad_tr_rightmon = 0;
	makevectors(self.angles);

	//------------------------------------------------------------------
	// Traceline 1 - MIDDLE
	ad_spot1 = self.origin + ad_s_ofset_x * v_forward + ad_s_ofset_y * v_right + ad_s_ofset_z * v_up;
	ad_spot2 = ad_targ.origin + ad_t_ofset;
	traceline (ad_spot1, ad_spot2, ad_FALSE, self);
	
	// Is trace entity the same as the target entity?
	if (trace_ent == ad_targ) ad_tr_line_x = 1;
	// Check for liquid surface block condition
	// Only need to do this once for the central traceline
	// If this fails then the left/right should as well
	if (ad_check_liquidblock(ad_spot1, ad_spot2) == ad_TRUE) ad_tr_line_x = 0;
	
	//------------------------------------------------------------------
	// Traceline 2 - 32 units LEFT
	ad_spot3 = ad_spot1 - (v_right * 16);
	traceline (ad_spot3, ad_spot2, ad_FALSE, self);
	// Work out if clear shot, hit world or another entity
	if (trace_ent == ad_targ) ad_tr_line_y = 1;
	else if (trace_ent != world) ad_tr_leftmon = 1;

	if (self.ad_debuglvl) {
		if (!ad_debugent2) ad_debugent2 = ad_spawn_devmarker(self.origin);
		setorigin(ad_debugent2, trace_endpos);
	}
		
	//------------------------------------------------------------------
	// Traceline 3 - 32 units RIGHT
	ad_spot3 = ad_spot1 + (v_right * 16);
	traceline (ad_spot3, ad_spot2, ad_FALSE, self);
	// Work out if clear shot, hit world or another entity
	if (trace_ent == ad_targ) ad_tr_line_z = 1;
	else if (trace_ent != world) ad_tr_rightmon = 1;

	if (self.ad_debuglvl) {
		if (!ad_debugent3) ad_debugent3 = ad_spawn_devmarker(self.origin);
		setorigin(ad_debugent3, trace_endpos);
	}

	//------------------------------------------------------------------
	// Default = no clear shot (keep aim/moving)
	ad_tr_result = ad_TRUE;
	// SIMPLE 3 complete traces = nothing blocking visibility
	if (ad_tr_line_x + ad_tr_line_y + ad_tr_line_z == 3) ad_tr_result = ad_FALSE;
	// Central trace is good but either side has hit something?
	else if (ad_tr_line_x) {
		// Hit a monster on either side = always fail!
		if (ad_tr_leftmon || ad_tr_rightmon) ad_tr_result = ad_TRUE;
		// The crssbow bolt is fired from the LEFT side, only right can be clear
		else if (self.ad_classtype == ad_CT_MONDCROSS) {
			if (ad_tr_line_y == 0 && ad_tr_line_z == 1) ad_tr_result = ad_FALSE;
		}
		// Default - space available on either side
		else if (ad_tr_line_y + ad_tr_line_z == 1) ad_tr_result = ad_FALSE;
	}

	//------------------------------------------------------------------
	if (self.ad_debuglvl) {
		dprint("Trace ("); dprint(ftos(ad_tr_line_x));
		dprint(" "); dprint(ftos(ad_tr_line_y));
		dprint(" "); dprint(ftos(ad_tr_line_z));
		dprint(") Ent ("); dprint(ftos(ad_tr_leftmon));
		dprint(" "); dprint(ftos(ad_tr_rightmon));
		dprint(") = ("); dprint(ftos(ad_tr_result));
		dprint(")\n");	
	}
	return ad_tr_result;
};

/*======================================================================
 infront (target entity)
 - relies on self being set correctly before entering this function
 - returns 1 if the entity is in front (in sight) of self
======================================================================*/
float(entity ad_targ) ad_infront =
{
	local vector ad_vec;
	local float ad_dot;
	
	makevectors (self.angles);	// sets v_forward, etc globals
	ad_vec = normalize (ad_targ.origin - self.origin);
	ad_dot = ad_vec * v_forward;
	
	if ( ad_dot > 0.3) return ad_TRUE;
	else return ad_FALSE;
};

/*======================================================================
 range (target entity)
  returns the range catagorization of an entity reletive to self
  uses constants defined in defs.qc
======================================================================*/
float(entity ad_targ) ad_range =
{
	local vector	ad_spot1, ad_spot2;
	local float		ad_r;
		
	ad_spot1 = self.origin + self.view_ofs;
	ad_spot2 = ad_targ.origin + VR_AD_ViewOfs(ad_targ);
	ad_r = vlen (ad_spot1 - ad_spot2);
	
	if (ad_r < ad_MON_RANGE_MELEE) return ad_RANGE_MELEE;		// <120 = MELEE
	else if (ad_r < ad_MON_RANGE_NEAR) return ad_RANGE_NEAR;		// <500 = NEAR
	else if (ad_r < ad_MON_RANGE_MID) return ad_RANGE_MID;		// <1000 = MID
	return ad_RANGE_FAR;																	// >1000 = FAR
};

/*======================================================================
 range_distance (target entity)
 	returns the vector distance between two points
======================================================================*/
float(entity ad_targ, float ad_flat2d) ad_range_distance =
{
	local vector	ad_spot1, ad_spot2;
	local float		ad_r;
		
	ad_spot1 = self.origin + self.view_ofs;
	ad_spot2 = ad_targ.origin + VR_AD_ViewOfs(ad_targ);
	if (ad_flat2d) { ad_spot1_z = ad_spot2_z = 0; }
	ad_r = vlen (ad_spot1 - ad_spot2);
	
	return ad_r;
};

/*======================================================================
 rangeattack_check
  check to see if (source) can get a clear shot at (targ)
  Ignores any water/air content checks
======================================================================*/
float (entity ad_source, entity ad_targ) ad_rangeattack_check =
{
	local vector	ad_spot1, ad_spot2;
	local float ad_r;

	// origin+offset, otherwise cannot see player up/down slopes
	ad_spot1 = ad_source.origin + ad_source.view_ofs;
	ad_spot2 = ad_targ.origin + VR_AD_ViewOfs(ad_targ);
	ad_r = vlen(ad_spot1 - ad_spot2);
	
	// Maximum range attack (was 600 taken from shambler, changed to 1000)
	if (ad_r > ad_MON_RANGE_MID) return ad_FALSE;

	// Monsters without melee should always range anything really close
	if (!ad_source.ad_th_melee && ad_r < ad_MON_RANGE_MELEE) return ad_TRUE;

	traceline (ad_spot1, ad_spot2, ad_FALSE, ad_source);	// trace hits monsters (infighting)
	if (trace_ent != ad_targ) return ad_FALSE;		// don't have a clear shot

	// Does the world define any water transparency
	if (ad_liquid_alpha == 1 || ad_source.ad_liquidblock) {	
		// sight line crossed contents
		if (trace_inopen && trace_inwater) return ad_FALSE;
	}

	return ad_TRUE;
};

/*======================================================================
 targangle
  Returns what angle the target entity is relative to the source entity
  Useful for checking where the player is located.
  source, targ = entity origins to create vector angle
  reverse = the creation of the vector can be reversed
  offset = shift the final angle clockwise. (frontal sight cone 315-45)
======================================================================*/
float(entity ad_source, entity ad_targ, float ad_offset, float ad_reverse) ad_targangle =
{
	local float ad_targ_dir, ad_targ_ang;

	// Calculate vector angle between two points (source, target)
	if (ad_reverse) ad_targ_dir = vectoyaw(ad_source.origin - ad_targ.origin);
	else ad_targ_dir = vectoyaw(ad_targ.origin - ad_source.origin);

	ad_targ_ang = ad_anglemod( (ad_source.angles_y - ad_targ_dir) + ad_offset );
	return ad_targ_ang;
};

// Modified version of targangle not using entities but supplied origins
// Targets Y angles needs to be supplied as no entity reference available
float(vector ad_source, vector ad_targ, float ad_offset, float ad_reverse, float ad_dst_ang) ad_viewangle =
{
	local float ad_targ_dir, ad_targ_ang;

	// Calculate vector angle between two points (source, target)
	if (ad_reverse) ad_targ_dir = vectoyaw(ad_source - ad_targ);
	else ad_targ_dir = vectoyaw(ad_targ - ad_source);

	ad_targ_ang = ad_anglemod( (ad_dst_ang - ad_targ_dir) + ad_offset );
	return ad_targ_ang;
};

/*======================================================================
 targzone (source entity, target entity)
 - Checks which zone the target enemy is located in relation to source (self)
  0 = Behind (315-45), 1 = Left (45-135), 2 = Front (135-225), Right = (225-315)
======================================================================*/
float(entity ad_source, entity ad_targ) ad_targzone =
{
	local float ad_target_ang;
	
	// Work out angle the angle of the player based on the monster (source)
	// Add 45 degree offset to shift clockwise the frontal sight cone
	ad_target_ang = ad_targangle(ad_source, ad_targ, 45, ad_TRUE);

	if (ad_target_ang > 270) return ad_TARGET_RIGHT;
	else if (ad_target_ang > 180) return ad_TARGET_FRONT;
	else if (ad_target_ang > 90) return ad_TARGET_LEFT;
	else return ad_TARGET_BACK;
};


/*======================================================================
 HuntTarget
  Main routine - constantly running/turning towards the enemy
======================================================================*/
void() ad_HuntTarget =
{
	if (self.health < 1) return;	// Dead monsters don't hunt!
	
	self.oldorigin = self.origin;	// Save origin
	self.goalentity = self.enemy;	// Focus on enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
	
	// Some monsters have special wakeup animations before attacking
	self.nextthink = time + 0.1;
	self.think = self.ad_th_run;
	// Default 1s wait (NM adjusted) before attacking
	if (!self.ad_attack_instant) ad_SUB_AttackFinished (1);
};

/*======================================================================
 FoundTarget
 - An enemy target has been found, wakeup and hunt target
 - Used by FindTarget once an enemy target has been found
 - used by T_Damage (combat.qc) for infighting
======================================================================*/
void() ad_FoundTarget =
{
	if (self.health < 1) return ad_FALSE;	// Dead monsters don't hunt!
	VR_AD_StealthHostile();
	
	// Check for Liquid surface block entity key
	// if the monster has range attack, can NOW see through liquid surface
	if (self.ad_liquidblock == ad_TRUE && self.ad_th_missile)
		self.ad_liquidblock = ad_FALSE;

	//----------------------------------------------------------------------
	// If current enemy is alive and can take damage then wakeup
	// the rest of the groupsight group using global entity
	//----------------------------------------------------------------------
	if (self.ad_sightgroup != "") {
		if (self.enemy.health > 0 && self.enemy.takedamage > ad_DAMAGE_NO) {
			ad_sightgroup_entity = self;		// Highlight target for others
			ad_sightgroup_entity_time = time;	// reset wakeup timer
			if (self.enemy.flags & ad_FL_CLIENT) ad_monster_sightsound();
			ad_HuntTarget ();					// Keep running after enemy
			return;
		}
	}
	//----------------------------------------------------------------------
	// DEFAULT wakeup method for all monsters
	//----------------------------------------------------------------------
	else {
		if (self.enemy.flags & ad_FL_CLIENT) {
			ad_sight_entity = self;			// angry monster for others
			ad_sight_entity_time = time;		// reset wakeup timer
		}
	}
	
	//----------------------------------------------------------------------
	// This will cause a group of monsters to all attack the same target
	// Using the global sight enemy system which works with FindTarget()
	// Always check for an empty sighttarget first because the
	// the global sight entity could have an empty targetname
	//----------------------------------------------------------------------
	if (self.ad_sighttarget != "") {
		if (self.enemy.targetname == self.ad_sighttarget) {
			// Make sure the sight target is alive before chasing it
			self.ad_oldenemy = find(world, targetname, self.ad_sighttarget);
			if (self.ad_oldenemy.health > 0) {
				if (self.ad_oldenemy.takedamage > ad_DAMAGE_NO) {
					ad_sight_entity = self.enemy;		// Highlight target for others
					ad_sight_entity_time = time;		// reset wakeup timer
					ad_monster_sightsound();			// Always make wakeup noise!
				}
			}
			self.ad_oldenemy = world;
		}
	}

	self.ad_show_hostile = time + 1;		// wake up other monsters
	// Only play wakeup sound if player, not for other monsters
	if (self.enemy.flags & ad_FL_CLIENT) ad_monster_sightsound();
	ad_HuntTarget ();						// Keep running after enemy
};

/*======================================================================
 FoundHuntTarget
 - This is a combination of FoundTarget and HuntTarget
 - Does not do any sight sound, needs to be done outside this func
 - Does not pause or wait for any monster, straight to combat
 - Has no end funtion state, can decide this afterwards
======================================================================*/
void(float ad_wakeupothers) ad_FoundHuntTarget =
{
	if (self.health < 1) return;	// Dead monsters don't hunt!
	if (!self.enemy) return;
	
	// Passive mode active and about to switch state?
	if (ad_check_passivestate_switch(self)) return;
	VR_AD_StealthHostile();
	
	// Check for Liquid surface block entity key
	// if the monster has range attack, can NOW see through liquid surface
	if (self.ad_liquidblock == ad_TRUE && self.ad_th_missile)
		self.ad_liquidblock = ad_FALSE;

	if (self.enemy.flags & ad_FL_CLIENT && ad_wakeupothers == ad_TRUE) {
		if (self.ad_sightgroup != "") {
			ad_sightgroup_entity = self;		// Angry monster for others
			ad_sightgroup_entity_time = time;	// reset wakeup timer
		}
		else {
			ad_sight_entity = self;		// Angry monster for others
			ad_sight_entity_time = time;	// reset wakeup timer
		}
	}
	
	self.ad_show_hostile = time + 1;		// wake up other monsters
	self.oldorigin = self.origin;		// Save origin
	self.goalentity = self.enemy;		// Focus on enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
	ad_SUB_AttackFinished (1);				// wait a while before first attack
};

/*======================================================================
 FindTarget
 - Main routine for finding a PLAYER target
 - Returns TRUE if an enemy was sighted
======================================================================*/
float() ad_FindTarget =
{
	local entity ad_client, ad_playtarg;

	if (self.health < 1) return ad_FALSE;	// Dead monsters don't hunt!
	
	// If intermission/cinematic is running, no sight checks
	if (ad_intermission_running > 0) return ad_FALSE;
	if (ad_cinematic_running > 0) return ad_FALSE;
	
	// Reset any combat exit conditions
	self.ad_enemyexit = ad_FALSE;
	if (VR_AD_StealthTick()) return ad_TRUE;

	//----------------------------------------------------------------------
	// SIGHT TARGET CHECK
	// Does the global sight entity match the enemy sight group?
	// Always check for an empty sighttarget first because the
	// the global sight entity could have an empty targetname
	//----------------------------------------------------------------------
	if (self.ad_sighttarget != "") {
		if (ad_sight_entity.targetname == self.ad_sighttarget) {
			// Make sure the sight target is alive before chasing it
			if (ad_sight_entity.health < 0) self.ad_sighttarget = "";
			else {
				// If using enerytarget system, switch off tracking entity first
				if (self.enemy.ad_classtype == ad_CT_ENEMYTARGET) ad_SUB_switchEnemyTarget();
				self.enemy = ad_sight_entity;	// Switch to new enemy
				self.ad_passive_state = ad_MON_PASSIVESTATE_OFF;
				ad_FoundTarget ();				// Run+turn towards new enemy
				return ad_TRUE;
			}
		}
	}
	//----------------------------------------------------------------------
	// SIGHT GROUP CHECK
	// This is designed to co-ordination wakeup and attack as a group
	// Check the gobal entity has the same sightgroup string (trigger)
	// sightgroup + NO Ambush = ALL wake up when sight of combat/fire/player
	// sightgroup + Ambush = All wake up when sight of player
	// sightgroup + passive + No Ambush = All wake up sight of combat/fire
	// sightgroup + passive + Ambush = All wake up with direct damage ONLY
	//----------------------------------------------------------------------
	if (self.ad_sightgroup != "") {
		// Let ambush still override wakeup (ambush=req direct damage)
		if (ad_sightgroup_entity_time >= time - 0.1) {
			if (self.ad_sightgroup == ad_sightgroup_entity.ad_sightgroup) {
				self.enemy = ad_sightgroup_entity.enemy;	// Monster who wokeup
				self.ad_passive_state = ad_MON_PASSIVESTATE_OFF;
				ad_FoundTarget ();							// Run+turn at new enemy
				return ad_TRUE;
			}
		}
	}
	//----------------------------------------------------------------------
	// PASSIVE SYSTEM CHECK
	// passive_state + NO ambush = wake up when sight of combat/fire
	// passive_state + Ambush = wake up from direct damage ONLY
	//----------------------------------------------------------------------
	if (ad_check_passivestate_switch(self)) return ad_FALSE;

	//----------------------------------------------------------------------
	// if the first spawnflag bit is set, the monster will only wake up on
	// really seeing the player, not another monster getting angry
	// Zombies have their ambush/crucified spawnflag mix up fixed
	//----------------------------------------------------------------------
	if (ad_sight_entity_time >= time - 0.1 && !(self.spawnflags & ad_MON_AMBUSH) ) {
		ad_client = ad_sight_entity;		// Global variable
		if (ad_client.enemy == self.enemy) return ad_TRUE;
	}
	else {
		ad_client = checkclient ();	// Find a client in current PVS
		if (!ad_client) return ad_FALSE;	// If no client found, return
	}

	//----------------------------------------------------------------------
	// Checkclient is *suppose* to find ONLY players in the current PVS
	// but it seems the code does something slightly different
	// Checkclient will return other 'objects' (monsters) who are mad
	// at the player, which is suppose to be caught with sight_enemy
	// Find the player entity (client,.enemy,world) for specific checks
	//----------------------------------------------------------------------
	if (ad_client.flags & ad_FL_CLIENT) ad_playtarg = ad_client;
	else {
		if (ad_client.enemy) ad_playtarg = ad_client;
		else ad_playtarg = find(world,targetname,"player");
	}

	//----------------------------------------------------------------------
	// If current enemy = client (player), already got *that* target
	//----------------------------------------------------------------------
	if (ad_client == self.enemy) return ad_FALSE;

	//----------------------------------------------------------------------
	// Check for debug mode, invis artifact, menu system active
	//----------------------------------------------------------------------
	if (ad_playtarg.flags & ad_FL_NOTARGET) return ad_FALSE;
	// Boss monsters can see invisible players!
	if (ad_playtarg.items & ad_IT_INVISIBILITY && self.ad_bossflag == ad_FALSE) return ad_FALSE;

	//----------------------------------------------------------------------
	// Is the client/player >1000 = FAR do nothing, too far away
	//----------------------------------------------------------------------
	if (VR_AD_StealthSight(ad_client)) return VR_AD_StealthSee(ad_client);
	ad_enemy_range = ad_range (ad_client);
	if (ad_enemy_range == ad_RANGE_FAR && !self.ad_attack_sniper) return ad_FALSE;
		
	//----------------------------------------------------------------------
	// Do not wake up unless the client (player/monster) is visible
	//----------------------------------------------------------------------
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return ad_FALSE;

	//----------------------------------------------------------------------
	// (Distance >128 && < 500) Is client infront+side and hostile?
	// show_hostile flag is set when the player fires a weapon
	//----------------------------------------------------------------------
	if (ad_enemy_range == ad_RANGE_NEAR) {
		if (ad_client.ad_show_hostile < time) {
				if (self.ad_sight_nofront == ad_FALSE && !ad_infront (ad_client))
					return ad_FALSE;
		}
	}
	//----------------------------------------------------------------------
	// (Distance 500+) Is client infront?
	//----------------------------------------------------------------------
	else if (ad_enemy_range > ad_RANGE_NEAR) {
			if (self.ad_sight_nofront == ad_FALSE && !ad_infront (ad_client)) 
				return ad_FALSE;
	}

	// At this point if the enemy is <120 (melee range) the enemy
	// will always wake up and turn around towards the player

	//----------------------------------------------------------------------
	// Finally got a target, check if its a player
	// This is an odd sitation because at this point client *should* be
	// the player/client and this code tries to fix the problem by
	// searching through enemy of enemy chains
	//----------------------------------------------------------------------
	self.enemy = ad_client;
	if ( !(ad_client.flags & ad_FL_CLIENT) ) {
		// Is the enemy of the enemy a player?
		self.enemy = self.enemy.enemy;
		if ( !(ad_client.enemy.flags & ad_FL_CLIENT) ) {
			self.enemy = world;
			return ad_FALSE;
		}
	}			
	ad_FoundTarget ();			// Run+turn towards new enemy
	return ad_TRUE;			// stop previous routine got a target

};


//======================================================================
// ai_face (generic)
//----------------------------------------------------------------------
void() ad_ai_face =
{
	if (self.health < 1) return;// Unusual check, caught elsewhere
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
	ChangeYaw (); 				// Done in code
};

//----------------------------------------------------------------------
// ai_forward
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_forward =
{
	ad_walkmove (self.angles_y, ad_dist);
};

//----------------------------------------------------------------------
// ai_forward + ai_face
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_faceforward =
{
	ad_ai_face();
	ad_walkmove (self.angles_y, ad_dist);
};

//----------------------------------------------------------------------
// ai_back + backface
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_back =
{
	ad_walkmove ( (self.angles_y+180), ad_dist);
};

void(float ad_dist) ad_ai_backface =
{
	ad_ai_face();
	ad_ai_back(ad_dist);
};

//----------------------------------------------------------------------
// ai_pain (does nothing, just uses ai_back instead)
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_pain =
{
	ad_ai_back (ad_dist);
};

//----------------------------------------------------------------------
// ai_painforward
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_painforward =
{
	ad_walkmove (self.angles_y, ad_dist);
	// Not sure why Id used ideal_yaw when other functions use angles_y
//	walkmove (self.ideal_yaw, dist);
};

//----------------------------------------------------------------------
// ai_turn (Very costly function, re-using FindTarget again)
//----------------------------------------------------------------------
void() ad_ai_turn =
{
	if (ad_FindTarget ()) return;
	ChangeYaw ();			// Code function
};


//----------------------------------------------------------------------
// FacingIdeal
//----------------------------------------------------------------------
float() ad_FacingIdeal =
{
	local	float	ad_delta;
	
	ad_delta = ad_anglemod(self.angles_y - self.ideal_yaw);
	if (ad_delta > 45 && ad_delta < 315) return ad_FALSE;
	else return ad_TRUE;
};

//----------------------------------------------------------------------
// ai_trackenemy
//----------------------------------------------------------------------
float() ad_ai_trackenemy =
{
	if (ad_visible(self.enemy)) {
		self.ad_attack_track = ad_SUB_orgEnemyTarget();
		ad_ai_face();
		return ad_TRUE;
	}
	else return ad_FALSE;
};

//----------------------------------------------------------------------
// ai_resetangles
//----------------------------------------------------------------------
void() ad_ai_resetangles =
{
	// There is a chance when finished a monster jump that some
	// of the angles (X/Z) values are wrong and need resetting
	// Should only be used after jump functions
	self.angles_x = self.angles_z = 0;
};

//----------------------------------------------------------------------
// ai_charge (generic)
//  - The monster is in a melee attack, 
//   so get as close as possible to .enemy
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_charge =
{
	self.vr_melee_time = time; // QVR: kept out of the player's head meanwhile (vr_enemy_melee_space)
	ad_ai_face ();
	local vector ad_before = self.origin; // QVR: (VR_MeleeSpace_Step: fight.qc)
	ad_movetogoal (ad_dist);
	VR_MeleeSpace_Step(ad_before);
};

//----------------------------------------------------------------------
// ai_chargenoturn (generic)
//----------------------------------------------------------------------
void(float ad_dist) ad_ai_chargenoturn =
{
	self.vr_melee_time = time; // QVR: kept out of the player's head meanwhile (vr_enemy_melee_space)
	local vector ad_before = self.origin;
	ad_movetogoal (ad_dist);
	VR_MeleeSpace_Step(ad_before);
};

//----------------------------------------------------------------------
// ai_charge_side (generic)
//----------------------------------------------------------------------
void() ad_ai_charge_side =
{
	self.vr_melee_time = time; // QVR: kept out of the player's head meanwhile (vr_enemy_melee_space)
	local	vector	ad_dtemp;
	local	float	ad_heading;
	
	// aim to the left of the enemy for a flyby
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
	ChangeYaw ();

	makevectors (self.angles);
	ad_dtemp = self.enemy.origin - (30 * v_right);
	ad_heading = vectoyaw(ad_dtemp - self.origin);
	
	ad_dtemp = self.origin; // QVR: (VR_MeleeSpace_Step: fight.qc)
	ad_walkmove(ad_heading, 20);
	VR_MeleeSpace_Step(ad_dtemp);
};

//----------------------------------------------------------------------
// ai_charge_front (generic)
//----------------------------------------------------------------------
void() ad_ai_charge_front =
{
	self.vr_melee_time = time; // QVR: kept out of the player's head meanwhile (vr_enemy_melee_space)
	local	float	ad_heading;
	
	ad_ai_face();			// Turn towards enemy first

	makevectors (self.angles);
	ad_heading = vectoyaw(self.enemy.origin - self.origin);
	
	local vector ad_before = self.origin; // QVR: (VR_MeleeSpace_Step: fight.qc)
	ad_walkmove(ad_heading, 10);
	VR_MeleeSpace_Step(ad_before);
};

/*======================================================================
 ai_run_melee
 - Turn and close until within an angle to launch a melee attack
======================================================================*/
void() ad_ai_run_melee =
{
	self.ideal_yaw = ad_enemy_yaw;		// This is defined in ai_run
	ChangeYaw ();					// Code function

	//----------------------------------------------------------------------
	// Facing towards the ENEMY target? (ideal_yaw)
	//----------------------------------------------------------------------
	if (ad_FacingIdeal()) {
		self.ad_th_melee ();
		self.ad_attack_state = ad_AS_STRAIGHT;
	}
};

/*======================================================================
 ai_run_missile
 - Turn in place until within an angle to launch a missile attack
======================================================================*/
void() ad_ai_run_missile =
{
	self.ideal_yaw = ad_enemy_yaw;		// This is defined in ai_run
	ChangeYaw ();					// Code function
	
	//----------------------------------------------------------------------
	// Facing towards the ENEMY target? (ideal_yaw)
	//----------------------------------------------------------------------
	if (ad_FacingIdeal()) {
		self.ad_th_missile ();
		self.ad_attack_state = ad_AS_STRAIGHT;
	}
};

/*======================================================================
 ai_run_jump
 - Turn in place until within an angle to jump attack
======================================================================*/
void() ad_ai_run_jump =
{
	self.ideal_yaw = ad_enemy_yaw;		// This is defined in ai_run
	ChangeYaw ();					// Code function
	
	//----------------------------------------------------------------------
	// Facing towards the ENEMY target? (ideal_yaw)
	//----------------------------------------------------------------------
	if (ad_FacingIdeal()) {
		self.ad_th_jump ();
		self.ad_attack_state = ad_AS_STRAIGHT;
	}
};

/*======================================================================
 ai_run_slide
 - Strafe sideways, but stay at aproximately the same range
======================================================================*/
void(float ad_dist) ad_ai_run_slide =
{
	local float	ad_ofs;

	// It is better to re-calcuate this than wait for ai_run to update
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);	
	// self.ideal_yaw = enemy_yaw;		// This is defined in ai_run
	ChangeYaw ();						// Code function
	if (self.lefty > 0) ad_ofs = 90;
	else ad_ofs = -90;
	
	// Tests if monsters can strafe or not by moving the monster
	if (ad_walkmove (self.ideal_yaw + ad_ofs, ad_dist)) return;
	
	// Switch strafe sides for later use	
	self.lefty = rint(1 - self.lefty);
	if (ad_walkmove (self.ideal_yaw - ad_ofs, ad_dist)) return;
	
	// Try moving backwards if both sides are blocked
	ad_walkmove (self.ideal_yaw - 180, ad_dist);
};

/*======================================================================
 ai_run_sidestep
 - Turn 90 degrees and move to the side
======================================================================*/
void(float ad_dist) ad_ai_run_sidestep =
{
	local float	ad_ofs;

	if (self.ad_attack_sidestep < time) {
		self.ad_attack_sidestep = time + 4 + random()*4;
		self.lefty = rint(1 - self.lefty);
	}
	if (self.lefty > 0) ad_ofs = 85;
	else ad_ofs = -85;

	// Work out angle to face for enemy and then turn +/- 90 degrees
	// so that the monster is moving sideways to the enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin) + ad_ofs;	
	ChangeYaw ();
	
	// Tests if monsters can move sideways
	if (ad_walkmove (self.ideal_yaw, ad_dist)) return;
	// Switch strafe sides for later use
	self.ad_attack_sidestep = -1;
};

/*======================================================================
 ai_run_backwards
 - Turn 180 degrees and move backwards
======================================================================*/
void(float ad_dist) ad_ai_run_backward =
{
	// Work out angle to face for enemy and then turn +/- 90 degrees
	// so that the monster is moving sideways to the enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin) + 180;	
	ChangeYaw ();
	
	// Tests if monsters can move backwards
	if (ad_walkmove (self.ideal_yaw, ad_dist)) return;
	// Cannot walk backwards, move sideways instead
	self.ad_attack_state = ad_AS_SIDESTEP;
};

/*======================================================================
 ai_foundbreakable
  Check if the monster is allowed to break the breakable!?!
======================================================================*/
float(entity ad_source, entity ad_targ, float ad_ignorenoshoot) ad_ai_foundbreakable =
{
	// Found a breakable in the way?
	if (ad_targ.ad_classtype == ad_CT_FUNCBREAK || ad_targ.ad_classtype == ad_CT_FUNCBREAKMDL) {
		// Check if a monster and nomonster damage/trigger allowed?
		if (ad_source.flags & ad_FL_MONSTER && ad_targ.spawnflags & ad_BREAK_NOMONSTER) return ad_FALSE;
		// Ignoring noshoot spawnflag? (designed for jump/missile events)
		else if (ad_ignorenoshoot == ad_TRUE) return ad_TRUE;
		// is breakable explosive damage only and attacker can use explosives?
		else if (ad_targ.ad_brktrigmissile && ad_source.ad_attack_explosive) return ad_TRUE;
		// Can the breakable be damaged?
		else if (ad_targ.spawnflags & ad_BREAK_NOSHOOT) return ad_FALSE;
		// Its a breakable that breaks!
		else return ad_TRUE;
	}
	return ad_FALSE;
};

/*======================================================================
 ai_tracebreakable
  Check if the monster (self) can see any breakables infront (target)
  Triple trace infront (self.angles) origin, +upward and +downward
======================================================================*/
float ad_BRKTRACE_DIST = 128;
float ad_BRKTRACE_ANG = 0.35;

float(float ad_tracedist, float ad_traceang) ad_ai_tracebreakable =
{
	local vector ad_spot1, ad_spot2;
	local float ad_mon_height;
	
	// Take current facing angle of monster
	makevectors(self.angles);
	ad_spot1 = self.origin;

	// Work out look up/down height for additional tracelines
	ad_mon_height = (self.maxs_z - self.mins_z) * ad_traceang;
	
	// Trace directly infront of entity using angles
	ad_spot2 = ad_spot1 + (v_forward * ad_tracedist);
	traceline (ad_spot1, ad_spot2, ad_FALSE, self);
	if (ad_ai_foundbreakable(self, trace_ent, ad_FALSE)) return ad_TRUE;

	// Trace from origin and look UP!
	ad_spot2 = ad_spot1 + (v_forward * ad_tracedist) + (v_up * ad_mon_height);
	traceline (ad_spot1, ad_spot2, ad_FALSE, self);
	if (ad_ai_foundbreakable(self, trace_ent, ad_FALSE)) return ad_TRUE;

	// Trace from origin and look DOWN!
	ad_spot2 = ad_spot1 + (v_forward * ad_tracedist) - (v_up * ad_mon_height);
	traceline (ad_spot1, ad_spot2, ad_FALSE, self);
	if (ad_ai_foundbreakable(self, trace_ent, ad_FALSE)) return ad_TRUE;

	// No breakable found
	return ad_FALSE;
};

/*======================================================================
 ai_immunebreakable
  Check if a breakable/pushable is immune to damage from monsters
======================================================================*/
float(entity ad_source, entity ad_targ) ad_ai_immunebreakable =
{
	// Found a breakable? (BSP or model)
	if (ad_targ.ad_classtype == ad_CT_FUNCBREAK || ad_targ.ad_classtype == ad_CT_FUNCBREAKMDL) {
		// Check no damage spawnflag?
		if (ad_source.flags & ad_FL_MONSTER && ad_targ.spawnflags & ad_BREAK_NOMONSTER)
			return ad_TRUE;
	}
	// Found a pushable?
	else if (ad_targ.ad_classtype == ad_CT_FUNCPUSHABLE) {
		// Check no damage spawnflag?
		if (ad_source.flags & ad_FL_MONSTER && ad_targ.spawnflags & ad_PUSH_NOMONSTER)
			return ad_TRUE;
	}
	return ad_FALSE;
};

/*======================================================================
 ai_damagebreakable
  If any breakables found, damage them to see if they will break
  Use the triple trace forward, upward and dowward to find breakables
======================================================================*/
void(float ad_brkdmg) ad_ai_damagebreakable =
{
	local float ad_ldmg;
	
	// Setup damage modifier
	ad_ldmg = (random() + random() + random()) * ad_brkdmg;

	// Triple trace directly infront of monster using angles
	if (ad_ai_tracebreakable(ad_BRKTRACE_DIST, ad_BRKTRACE_ANG)) {
		// Check for any monster damage modifier on breakable
		if (self.flags & ad_FL_MONSTER && trace_ent.ad_brkmondmg > 0)
			ad_ldmg = ad_ldmg * trace_ent.ad_brkmondmg;
		// Apply damage to breakable
		ad_T_Damage (trace_ent, self, self, ad_ldmg, ad_DAMARMOR);
	}
};

/*======================================================================
 ai_jumpbreakable
  Check if the monster can trigger a breakable from jump attack
  Expecting SELF = monster and OTHER = breakable
======================================================================*/
void(float ad_brkdmg) ad_ai_jumpbreakable =
{
	if (ad_ai_foundbreakable(self, other, ad_TRUE) && other.ad_brktrigjump != 0) {
		// Found a breakable which is prone to jump damage
		ad_trigger_ent(other, self);
	}
	else ad_ai_damagebreakable(ad_brkdmg);	// Damage any breakables
};

/*======================================================================
 CheckBlockedBreakable
  See if any breakables are in the way (running forward)
======================================================================*/
void() ad_CheckBlockedBreakable =
{
	local float ad_brklen;

	// Still busy attacking? do nothing	
	if (time < self.ad_attack_finished) return;

	// Double check a DEFAULT melee range exist, use knights
	if (self.ad_th_melee && !self.ad_meleerange)
		self.ad_meleerange = ad_MONAI_MELEEKNIGHT;

	// Triple trace directly infront of monster using angles
	if (ad_ai_tracebreakable(ad_BRKTRACE_DIST, ad_BRKTRACE_ANG)) {
		if (ad_ai_foundbreakable(self, trace_ent, ad_FALSE)) {
			// Find out exactly how far away breakable bounding box is
			ad_brklen = fabs(vlen(self.origin - trace_endpos));
			
			// Check breakable within melee/missile range?
			// Added extra check for explosive damage on breakbles (1.8)
			if (self.ad_attack_explosive && trace_ent.ad_brktrigmissile) {
				ad_SUB_AttackFinished (1+random());
				self.ad_attack_state = ad_AS_MISSILE;
			}
			else if (ad_brklen < self.ad_meleerange && self.ad_th_melee) {
				ad_SUB_AttackFinished (1+random());
				self.ad_attack_state = ad_AS_MELEE;
			}
			else if (self.ad_th_missile) {
				ad_SUB_AttackFinished (1+random());
				self.ad_attack_state = ad_AS_MISSILE;
			}
		}
	}
};

/*======================================================================
 ai_checkmelee
  Check if the monster (self) can attack enemy (target)
  and returns TRUE if the monster is within XYZ range
======================================================================*/
float(float ad_attackdist, float ad_attackzaxis) ad_ai_checkmelee =
{
	local vector	ad_spot1, ad_spot2;
	local float 	ad_delta, ad_zdiff;

	// Setup default
	if (ad_attackzaxis <= 0) ad_attackzaxis = ad_MONAI_MELEEZAXIS;
	
	// Calculate distance and z axis difference seperate
	ad_spot1 = ad_SUB_orgEnemyTarget();
	ad_spot2 = self.origin;
	ad_zdiff = fabs(ad_spot1_z - ad_spot2_z);
	ad_spot1_z = ad_spot2_z = 0;				// Flatten Z axis before vector length
	ad_delta = vlen(ad_spot1 - ad_spot2);		// Calculate vector distance

	// Is the enemy too far away and the zaxis is wrong (too low/high)
	if (ad_delta <= ad_attackdist && ad_zdiff <= ad_MONAI_MELEEZAXIS) return ad_TRUE;
	else return ad_FALSE;
};

/*======================================================================
 ai_melee (generic)
 - slashing type of damage facing forward
   really assuming the monster is stationary while attacking
======================================================================*/
void() ad_ai_melee =
{
	self.vr_melee_time = time; // QVR: kept out of the player's head meanwhile (vr_enemy_melee_space)
	local float ad_ldmg;

	if (!self.enemy) return;			// removed before stroke
	ad_ai_damagebreakable(10);				// Damage any breakables
	if (!ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) return;	// Too far away

	// Can the target bleed? - no blood/damage, quick exit
	// This candamage test not in origina id code (sync'd to melee_side)
	if (!ad_CanDamage (self.enemy, self)) return;

	// 1-9 damage
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Only spawn blood/gore/sound every second
	if (self.ad_meleetimer < time) {
		self.ad_meleetimer = time + 1;
		ad_SpawnMeatSpray (self, self.enemy, random() * 100);
	}
	
	// Check for poisonous blades!
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Some melee weapons have swing and hit as separate sounds
	// This is trigger_once per melee combat swing
	// No check if meleehitsound is defined or not
	if (self.ad_meleecontact) {
		self.ad_meleecontact = ad_FALSE;
		sound (self, ad_CHAN_WEAPON, self.ad_meleehitsound, 1, ad_ATTN_NORM);
	}
};

/*======================================================================
 ai_meleesmash (generic)
 - large smashing damage overhead attack, usually a single strike
   really assuming the monster is stationary while attacking
======================================================================*/
void(float ad_dmg_multiplier) ad_ai_meleesmash =
{
	self.vr_melee_time = time; // QVR: kept out of the player's head meanwhile (vr_enemy_melee_space)
	local float ad_ldmg;

	if (!self.enemy) return;						// removed before stroke
	ad_ai_damagebreakable(3*ad_dmg_multiplier);			// Damage any breakables
	// Is the enemy too far away, ++ extra Z height
	if (!ad_ai_checkmelee(self.ad_meleerange, ad_MONAI_MELEEZTALL)) return;

	// Can the target bleed? - no blood/damage, quick exit
	// This candamage test not in origina id code (sync'd to melee_side)
	if (!ad_CanDamage (self.enemy, self)) return;

	// This function is designed for monsters attacking players or infighting
	// If this is infighting do more damage as it will look more impressive
	// Also if this damage is enough to kill in a single blow, gib for effect
	if (self.enemy.flags & ad_FL_MONSTER) ad_dmg_multiplier = ad_dmg_multiplier * 2;

	// 1-9 damage
	ad_ldmg = (random() + random() + random()) * ad_dmg_multiplier;
	if (ad_ldmg < 1) ad_ldmg = 1;
	if (self.enemy.health < ad_ldmg) ad_ldmg = ad_ldmg*3;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Lots of blood and gore
	ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
	ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
	
	// Check for poisonous blades!
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Some melee weapons have swing and hit as separate sounds
	// This is trigger_once per melee combat swing
	if (self.ad_meleecontact) {
		self.ad_meleecontact = ad_FALSE;
		if (self.ad_meleehitsound) sound (self, ad_CHAN_WEAPON, self.ad_meleehitsound, 1, ad_ATTN_NORM);
	}
};

/*======================================================================
 ai_melee_side (generic)
 - move forward/side and attack (can cause animation sliding errors)
   this is really designed for glancing blows and monsters which are
   moving fast like they are charging at the player
======================================================================*/
void() ad_ai_melee_side =
{
	local float ad_ldmg;

	if (!self.enemy) return;	// removed before stroke
	ad_ai_damagebreakable(10);		// Damage any breakables
	ad_ai_charge_side();			// move (20 units) to the side of enemy
	if (!ad_ai_checkmelee(ad_MONAI_MELEESIDE,ad_FALSE)) return;	// Too far away

	// Can the target bleed? - no blood/damage, quick exit
	if (!ad_CanDamage (self.enemy, self)) return;

	// 1-9 damage
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	ad_SpawnMeatSpray (self, self.enemy, random() * 50);
	
	// Check for poisonous blades!
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Some melee weapons have swing and hit as separate sounds
	// This is trigger_once per melee combat swing
	// No check if meleehitsound is defined or not
	if (self.ad_meleecontact) {
		self.ad_meleecontact = ad_FALSE;
		sound (self, ad_CHAN_WEAPON, self.ad_meleehitsound, 1, ad_ATTN_NORM);
	}
};

/*======================================================================
 ai_shockwave
 - produce a large ground slam/shockwave effect
 - Used by hammer ogres, golems and barons
======================================================================*/
void() ad_ai_shockwave_think =
{
	self.wait = rint((time - self.ltime)*10);
	if (self.wait > 6) ad_SUB_Remove();
	else {
		self.frame = self.wait;
		if (self.wait > 4) {
			if (!self.delay) {self.delay = time;}
			self.alpha = 1-((time - self.delay)*5);
		}
		self.angles_y = ad_anglemod(self.angles_y + rint(random()*20));
    self.nextthink = time + ad_TIME_MINTICK;
	}
};

//----------------------------------------------------------------------
void(vector ad_imp_vec, float ad_imp_damage, float ad_imp_radius, float ad_imp_forward, float ad_imp_up) ad_ai_shockwave =
{
	local entity ad_swave, ad_sjump;
	local vector ad_impact, ad_fvel;
	local float ad_vdist, ad_vpercent, ad_vdamage, ad_vpart, ad_impzdiff;
	
	// Big impact, flash effect
	self.effects = self.effects | ad_EF_MUZZLEFLASH;

	// Play impact sound and work out where the impact is going to happen
	sound (self, ad_CHAN_WEAPON, self.ad_meleehitsound, 1, ad_ATTN_IDLE);
	makevectors (self.angles);
	// Replaced this crazy mess with function attack_vector
	//impact = self.origin + v_forward*imp_vec_x + v_right*imp_vec_y + v_up*imp_vec_z;
	ad_impact = self.origin + ad_attack_vector(ad_imp_vec);

	// Push all entities within a certain radius outwards
	// Do this find search before spawning ring and particles
	// findradius will find ALL entities regardless of type
	ad_sjump = findradius(ad_impact, ad_imp_radius);
	while(ad_sjump) {
		// Ignore monster (self)
		if (ad_sjump != self) {
			// Check for player + blast belt? - play active sound
			if (ad_sjump.flags & ad_FL_CLIENT && ad_sjump.ad_moditems & ad_IT_ARTBLASTBELT)
				ad_PlayBlastBeltSound(ad_sjump);
			// Only affect players and other monsters AND breakables (BSP+model)
			else if (ad_sjump.flags & ad_FL_CLIENT || ad_sjump.flags & ad_FL_MONSTER || ad_sjump.ad_classgroup == ad_CG_BREAKABLE) {
				// Exclude breakable/pushable immune to monster damage
				// This does not catch breakables excluded from player damage
				if (ad_ai_immunebreakable(self, ad_sjump)) {
					dprint("[SHOCKWAVE] Breakable (");
					dprint(ftos(ad_sjump.ad_classtype));
					dprint(") spnflg ("); dprint(ftos(ad_sjump.spawnflags));
					dprint(") Immune\n");
				}
				// Exclude statues, stone/heavy monsters and bosses!
				else if (ad_sjump.ad_classgroup != ad_CG_STONE && ad_sjump.ad_bossflag == ad_FALSE) {
					// Is the entity on the ground or a breakable?
					// The test for breakables exceptions is done earlier
					// Breakable bmodel/model don't have onground flag set
					// The onground test is really to catch player/monsters
					if (ad_sjump.flags & ad_FL_ONGROUND || ad_sjump.ad_classgroup == ad_CG_BREAKABLE) {
						// Is the entity too far above or below the impact?
						ad_impzdiff = fabs(ad_sjump.origin_z - ad_impact_z);
						if (ad_impzdiff < ad_MONAI_IMPACTZAXIS) {
							// Distance between impact and enemy/entity
							ad_vdist = vlen(ad_sjump.origin - ad_impact);
							// Percentage of impact force
							ad_vpercent = 1 - (ad_vdist / ad_imp_radius);
							ad_vdamage = rint(ad_imp_damage * ad_vpercent);
							// Impact damage radius is half for breakables
							// Otherwise whole rooms would be destroyed!
							if (ad_sjump.ad_classgroup == ad_CG_BREAKABLE) {
								if (ad_vdist > (ad_imp_radius * 0.5)) ad_vdamage = 0;
							}
							// Only apply impact damage to players (not monsters)
							// The damage was previously a meleerange with +/- 48 zaxis
							// Been changed to a radius damage as its radius impact!
							// Percentage (distance) of the impact damaged specified
							// This will STILL not apply if blast belt or jumping :P
							// Breakable's need source (self) for impact direction
							// to spawn breakable pieces away from impact location
							if (ad_vdamage > 0) {
								if (ad_sjump.ad_classgroup == ad_CG_BREAKABLE)
									ad_T_Damage (ad_sjump, self, self, ad_imp_damage*ad_vpercent, ad_DAMARMOR);
								else
									ad_T_Damage (ad_sjump, world, world, ad_imp_damage*ad_vpercent, ad_DAMARMOR);
							}
							
							// Monsters have less impact
							if (ad_sjump.flags & ad_FL_MONSTER) ad_vpercent = ad_vpercent * 0.75;
							// Attacker facing angle
							makevectors(self.angles);									
							// Combine forward/up force with existing velocity
							ad_fvel = (v_forward * (ad_imp_forward * ad_vpercent)) + (v_up * (ad_imp_up * ad_vpercent));
							ad_sjump.velocity = ad_sjump.velocity + ad_fvel;
							ad_sjump.flags = ad_sjump.flags - (ad_sjump.flags & ad_FL_ONGROUND);
						}
					}
				}
			}
		}
		ad_sjump = ad_sjump.chain;
	}

	// Spawn impact model ring on the ground
	ad_swave = spawn();
	ad_swave.mdl = ad_MODEL_PROJ_RINGSHOCK;	
	setmodel(ad_swave,ad_swave.mdl);
	setsize(ad_swave, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	setorigin(ad_swave, ad_impact);		// on floor, slight up (2 pixels)
	ad_swave.solid = ad_SOLID_NOT;		// No interaction with world
	ad_swave.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	ad_swave.think = ad_ai_shockwave_think;
	ad_swave.nextthink = time + ad_TIME_MINTICK;	// High time loop
	ad_swave.ltime = ad_swave.nextthink;
	
	// Spawn particle explosion where impact is located
	ad_vpart = 64 + rint(random()*64);
	ad_particle_explode(ad_impact, ad_vpart, 0.5, ad_PARTICLE_BURST_FIRE, ad_PARTICLE_BURST_SHOCKWAVE); 
};
