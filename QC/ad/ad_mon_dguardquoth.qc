//============================================================================
// Melee attack (over head attack)
//----------------------------------------------------------------------
void() ad_dguardq_smashforward = { ad_ai_face(); ad_ai_forward(1); };

//----------------------------------------------------------------------
void() ad_dguardq_meleesmash =
{
	local float ad_melee_dmg;

	ad_melee_dmg = 30;
	// Always Damage any breakables
	ad_ai_damagebreakable(ad_melee_dmg * 3);
	
	// Check range and can damage? (bleed)
	if ((ad_ai_checkmelee(ad_MONAI_MELEEDGUARDQ,ad_FALSE) && VR_MeleeArc_Hits(ad_FALSE)) && ad_CanDamage (self.enemy, self)) { // AD support: melee arc (fight.qc VR_MeleeArc_Hits)
		// If the enemy health is less than the melee damage, gib them
		if (self.enemy.health < ad_melee_dmg) ad_melee_dmg = ad_melee_dmg * 3;
		ad_T_Damage (self.enemy, self, self, ad_melee_dmg, ad_DAMARMOR);
		
		// Lots of blood and gore
		ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
		ad_SpawnMeatSpray (self, self.enemy, ad_crandom() * 100);
		
		// Check for poisonous blades!
		if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

		// Hit something, impact noise
		sound(self, ad_CHAN_WEAPON, "dguard/slhit.wav", 1, ad_ATTN_NORM);
	}
	else {
		// Missed enemy - clang!
		if (random() < 0.5) 
			sound(self, ad_CHAN_WEAPON, "dguard/slmiss1.wav", 1, ad_ATTN_NORM);
		else sound(self, ad_CHAN_WEAPON, "dguard/slmiss2.wav", 1, ad_ATTN_NORM);
	}
};

//----------------------------------------------------------------------
void()	ad_dguardq_smash1 =[	$magica1,	ad_dguardq_smash2	] {
	// Always reset state (prevents double melee attack)
	self.ad_attack_state = ad_AS_STRAIGHT;
	sound(self, ad_CHAN_VOICE, "dguard/slash.wav", 1, ad_ATTN_NORM);
	ad_dguardq_smashforward();
};
