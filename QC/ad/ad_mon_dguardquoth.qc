//============================================================================
// RANGE - FIREBALL (Slow and high damage)
//============================================================================
void() ad_dguardq_fireball =
{
	if (VR_AimCone_Wait(ad_dguardq_fireball, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_org, ad_dir, ad_vec;
	
	if (!self.enemy) return;
	if (self.health < 1) return;

	// If cannot see enemy, instantly go back to run animation
	if ( !ad_visxray(ad_SUB_entEnemyTarget(), self.ad_attack_offset, '0 0 -16', ad_FALSE) ) {
		self.think = self.ad_th_run;
	}
	
	// Light up knight and work out attack angle
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	// Aim low to catch players with splash damage
	ad_dir = self.ad_attack_track - '0 0 16';
	ad_vec = normalize(ad_dir - ad_org);
	
	// Variable rocket speed ( hard = baseline )
	self.ad_attack_speed = ad_SPEED_DGQFB + (ad_skill * ad_SPEED_DGQFBSKILL);
	ad_Launch_Missile (ad_org, ad_vec, '0 0 0', ad_CT_PROJ_DGUARDQ, self.ad_attack_speed);
};
