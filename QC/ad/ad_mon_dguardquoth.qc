//----------------------------------------------------------------------
void() ad_dguardq_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	
	// regular death
	if (!self.ad_gibbed) {
	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dguardq_die1 ();	// Forward - standard
		else ad_dguardq_dieb1 ();					// Backward - standard
	}
};

//============================================================================
void() ad_dguardq_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

/*======================================================================
 QUAKED monster_death_guard (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_death_guard =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dguardq.mdl";			// dguard.mdl (quoth)
	self.ad_headmdl = "progs/h_dguardq.mdl";		// h_dguard.mdl (quoth)
	self.ad_gib1mdl = "progs/w_hknightsword.mdl";	// Unique sword
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";	// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";	// right foot
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_DGUARDQ);		// fireball.mdl (quoth)
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib2mdl = ad_string_null;
	if (random() < 0.5) self.ad_gib3mdl = ad_string_null;

	self.ad_idle_sound = "dguard/idle.wav";
	precache_sound (self.ad_idle_sound);

	// precache sight, pain and death (changes on type)
	self.ad_sight_count = 4;
	self.ad_sight_sound = "dguard/sight1.wav";
	self.ad_sight_sound2 = "dguard/sight2.wav";
	self.ad_sight_sound3 = "dguard/sight3.wav";
	self.ad_sight_sound4 = "dguard/sight4.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_sight_sound2);
	precache_sound (self.ad_sight_sound3);
	precache_sound (self.ad_sight_sound4);

	// Pain and Death and Taxes!
	self.ad_pain_sound = "dguard/pain1.wav";
	self.ad_pain_sound2 = "dguard/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	self.ad_death_sound = "dguard/death1.wav";
	self.ad_death_sound2 = "dguard/death2.wav";
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);

	// New fireball fire/impact sound
	precache_sound ("dguard/fire.wav");
	precache_sound ("dguard/hit.wav");

	// New sword sweep/slash sounds
	precache_sound ("dguard/slash.wav");
	precache_sound ("dguard/slhit.wav");
	precache_sound ("dguard/slmiss1.wav");
	precache_sound ("dguard/slmiss2.wav");

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");
		
	self.solid = ad_SOLID_NOT;					// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;			// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 125;
	self.ad_gibhealth = -40;					// Not easy to gib
	self.ad_gibbed = ad_FALSE;					// Still in one piece
	self.ad_pain_flinch = 40;					// Medium pain threshold
	self.ad_pain_timeout = 1.25;				// Higher than a knight
	self.ad_pain_longanim = ad_TRUE;				// can be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPEMEDIUM;			// Lighter than Hell Knight
	self.ad_attack_explosive = ad_TRUE;			// Has explosive attack
	self.ad_attack_offset = '20 0 24';			// End of sword
	self.ad_poisonous = ad_FALSE;					// No support for this
	self.ad_deathstring = " was slaughtered by a Death Guard\n";
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	// Using alt magic and charge attacks
	self.ad_th_checkattack = ad_DGuardQCheckAttack;
	self.ad_th_stand = ad_dguardq_stand1;		// Idling on feet
	self.ad_th_walk = ad_dguardq_walk1;		// Walking
	self.ad_th_run = ad_dguardq_run1;			// Running
	self.ad_th_melee = ad_dguardq_smash1;		// Sword attack
	self.ad_th_charge = ad_dguardq_char_b1;	// Charge attack
	self.ad_th_missile = ad_dguardq_magicb1;	// Fireball
	self.ad_th_pain = ad_dguardq_pain;		// Stumble and pain
	self.ad_th_die = ad_dguardq_die;			// Face meets floor
	
	self.ad_classtype = ad_CT_MONDGUARDQ;
	self.ad_classgroup = ad_CG_DKNIGHT;		// Classic tincan!
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();
};
