// Classic death pose! Dead Boggy!
//============================================================================
void() ad_bogl_death1  =[ $death1,  ad_bogl_death2  ] {};
void() ad_bogl_death2  =[ $death2,  ad_bogl_death3  ] {ad_monster_check_gib();};
void() ad_bogl_death3  =[ $death3,  ad_bogl_death4  ] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_bogl_death4  =[ $death4,  ad_bogl_death5  ] {};
void() ad_bogl_death5  =[ $death5,  ad_bogl_death6  ] {};
void() ad_bogl_death6  =[ $death6,  ad_bogl_death7  ] {};
void() ad_bogl_death7  =[ $death7,  ad_bogl_death8  ] {};
void() ad_bogl_death8  =[ $death8,  ad_bogl_death9  ] {};
void() ad_bogl_death9  =[ $death9,  ad_bogl_death10 ] {};
void() ad_bogl_death10 =[ $death10, ad_bogl_death11 ] {ad_monster_death_postcheck();};
void() ad_bogl_death11 =[ $death11, ad_bogl_death11 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_bogl_die =
{
	// Finish and remove all attachments
	ad_bogl_finish_attachment();
	ad_bogl_remove_attachment();

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "boglord/death1.wav", 1, ad_ATTN_NORM);
		ad_bogl_death1 ();
	}
	else {
		//Explosion for gib death!
		ad_T_RadiusDamage (self, self, self.dmg, world, ad_DAMAGEALL);
		// Sprite/Particle based explosion
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		// Play original explosion sound or replacement
		ad_SpawnExplosion(ad_EXPLODE_SMALL, self.origin, ad_SOUND_REXP3);
	}
};

