//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_bogl_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.alpha = 0.85;
	}
	if (!self.ad_attachment2) {
		self.ad_attachment2 = spawn();
		self.ad_attachment2.owner = self;
		self.ad_attachment2.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment2.alpha = 0.85;
	}

	if (!self.ad_attachment3) {
		self.ad_attachment3 = spawn();
		self.ad_attachment3.owner = self;
		self.ad_attachment3.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment3.alpha = 1.0;
	}
};

//----------------------------------------------------------------------
void() ad_bogl_finish_attachment =
{
	if (self.ad_attachment) setmodel(self.ad_attachment, "");
	if (self.ad_attachment2) setmodel(self.ad_attachment2, "");
	if (self.ad_attachment3) setmodel(self.ad_attachment3, "");
};

//----------------------------------------------------------------------
void() ad_bogl_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
	if (self.ad_attachment2) {
		self.ad_attachment2.think = ad_SUB_Remove;
		self.ad_attachment2.nextthink = time + 0.1;
	}
	if (self.ad_attachment3) {
		self.ad_attachment3.think = ad_SUB_Remove;
		self.ad_attachment3.nextthink = time + 0.1;
	}
};

//======================================================================
// RANGE ATTACK 1 - overhead SMASH/slime
//======================================================================
void(vector ad_leftofs, vector ad_rightofs) ad_bogl_throwslime =
{
	local vector ad_org, ad_btarg, ad_dir, ad_avel;
	
	// Finished with growing balls of slime
	ad_bogl_finish_attachment();

	if (!self.enemy) return;
	if (self.health < 1) return;

	ad_ai_face();
	makevectors(self.angles);
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_BLORDBALL + (ad_skill * ad_SPEED_BLORDSKILL);

	// Fire left hand off center and at players feet
	ad_org = self.origin + ad_attack_vector(ad_leftofs);
	ad_btarg =self.enemy.origin + v_right*8 - v_up*8;
	ad_dir = normalize(ad_btarg - ad_org);
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Missile (ad_org, ad_dir, ad_avel, ad_CT_PROJ_BLORD, self.ad_attack_speed);

	// Fire right hand off center and at players feet
	ad_org = self.origin + ad_attack_vector(ad_rightofs);
	ad_btarg =self.enemy.origin - v_right*8 - v_up*8;
	ad_dir = normalize(ad_btarg - ad_org);
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Missile (ad_org, ad_dir, ad_avel, ad_CT_PROJ_BLORD, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void(vector ad_leftofs, vector ad_rightofs, float ad_sbframe, float ad_chfeet) ad_bogl_slimeball =
{
	local vector ad_org;
	if (self.health < 1) return;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_bogl_create_attachment();
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_sbframe == 0) {
		setorigin(self.ad_attachment, self.origin);
		if (self.spawnflags & ad_MON_BOGL_STRONG) 
			setmodel(self.ad_attachment, ad_MODEL_PROJ_BLORD2B);
		else setmodel(self.ad_attachment, ad_MODEL_PROJ_BLORD1B);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		
		setorigin(self.ad_attachment2, self.origin);
		if (self.spawnflags & ad_MON_BOGL_STRONG) 
			setmodel(self.ad_attachment2, ad_MODEL_PROJ_BLORD2B);
		else setmodel(self.ad_attachment2, ad_MODEL_PROJ_BLORD1B);
		setsize (self.ad_attachment2, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment2.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment2.solid = ad_SOLID_NOT;
	}
	
	// Move+Turn towards enemy and make vector
	ad_ai_charge(ad_chfeet);
	makevectors(self.angles);
	
	// Generate attachment in hand (left)
	ad_org = self.origin + ad_attack_vector(ad_leftofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles_y = rint(random()*359);
	self.ad_attachment.frame = ad_sbframe;

	// Generate attachment in hand (right)
	ad_org = self.origin + ad_attack_vector(ad_rightofs);
	setorigin(self.ad_attachment2, ad_org);
	self.ad_attachment2.angles_y = rint(random()*359);
	self.ad_attachment2.frame = ad_sbframe;
};

//----------------------------------------------------------------------
void() ad_bogl_smash1  =[ $smash1,  ad_bogl_smash2 ] { ad_ai_charge(2);
	// Cycle around the melee sounds
	self.ad_meleeattack = self.ad_meleeattack + 1;
	if (self.ad_meleeattack > 2) self.ad_meleeattack = 0;
	// Never play the same melee sound twice
	if (self.ad_meleeattack == 0) {
		sound (self, ad_CHAN_VOICE, "boglord/melee1.wav", 1, ad_ATTN_NORM);}
	else if (self.ad_meleeattack == 1) {
		sound (self, ad_CHAN_VOICE, "boglord/melee2.wav", 1, ad_ATTN_NORM);}
	else {sound (self, ad_CHAN_VOICE, "boglord/melee3.wav", 1, ad_ATTN_NORM);}
};
void() ad_bogl_smash2  =[ $smash2,  ad_bogl_smash3 ] {ad_monster_footstep(ad_FALSE);
	ad_bogl_slimeball('21 70 60','32 -53 64',0,6);};
void() ad_bogl_smash3  =[ $smash3,  ad_bogl_smash4 ] {
	ad_bogl_slimeball('-5 66 102','2 -58 104',1,6);};
void() ad_bogl_smash4  =[ $smash4,  ad_bogl_smash5 ] {
	ad_bogl_slimeball('-34 48 122','-34 -48 124',2,5);};
void() ad_bogl_smash5  =[ $smash5,  ad_bogl_smash6 ] {
	ad_bogl_slimeball('-58 30 114','-60 -30 114',3,4);};
void() ad_bogl_smash6  =[ $smash6,  ad_bogl_smash7 ] {
	ad_bogl_slimeball('-58 20 109','-62 -17 110',4,1);};
void() ad_bogl_smash7  =[ $smash7,  ad_bogl_smash8 ] {
	ad_bogl_slimeball('-24 20 114','-26 -14 124',5,0);};
void() ad_bogl_smash8  =[ $smash8,  ad_bogl_smash9 ] {
