/*======================================================================
QUAKED monster_boglord (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_boglord =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	// One model, two different skins
	self.mdl = "progs/mon_bossboglord.mdl";

	// Detect version types
	if (self.spawnflags & ad_MON_BOGL_STRONG) {
		// Unique models for blood trail on model flag
		self.ad_headmdl = "progs/h_boglordb.mdl";		// +2 skins
		self.ad_gib1mdl = "progs/gib_blclaw1b.mdl";	// Left claw
		self.ad_gib2mdl = "progs/gib_blclaw2b.mdl";	// Right claw
		self.ad_gib3mdl = "progs/gib_blfoot1b.mdl";	// foot
		self.ad_gib4mdl = "progs/gib_blfoot2b.mdl";	// foot
		self.ad_part_style = ad_PARTICLE_BURST_RED;
		self.ad_part_life = ad_EXPLODE_MED;
		if (self.health < 1) self.health = 2000;
		self.ad_exactskin = 1;			// Dark red/purple
		self.ad_poisonous = ad_FALSE;		// Cannot be poisonous
		self.ad_deathstring = " was toasted by a Fire Shambler\n";
	}
	else {
		// Unique models for wizard trail on model flags
		self.ad_headmdl = "progs/h_boglord.mdl";		// +2 skins
		self.ad_gib1mdl = "progs/gib_blclaw1.mdl";		// Left claw
		self.ad_gib2mdl = "progs/gib_blclaw2.mdl";		// Right claw
		self.ad_gib3mdl = "progs/gib_blfoot1.mdl";		// foot
		self.ad_gib4mdl = "progs/gib_blfoot2.mdl";		// foot
		self.ad_part_style = ad_PARTICLE_BURST_YELLOW;
		self.ad_part_life = ad_EXPLODE_POISON_MED;
		if (self.health < 1) self.health = 1200;
		self.ad_exactskin = 0;				// Swampy green
		
		ad_precache_poisongibs();			// precache gibs
		self.ad_poisonous = ad_TRUE;			// Green vulcan blood!
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Liquid Poison
		self.ad_deathstring = " was obliterated by The Bog Lord\n";
	}

	// Precache model + unique particle trail
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);
	
	// All extra/projectiles (both types)
	precache_model (ad_MODEL_PROJ_BLORD1B);	// Slime ball
	precache_model (ad_MODEL_PROJ_BLORD2B);	// Fire ball
	precache_model (ad_MODEL_PROJ_BLORD1S);	// Floor blobs
	precache_model (ad_MODEL_PROJ_BLORDBEAM1);	// Lightning between hands
	precache_model (ad_MODEL_PROJ_BLORDBEAM2);
	precache_model (ad_MODEL_PROJ_BLORDBOLT1);	// Large Bolt Projectile
	precache_model (ad_MODEL_PROJ_BLORDBOLT2);
	
	self.ad_idle_sound = "boglord/idle1.wav";
	self.ad_idle_sound2 = "boglord/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	precache_sound ("boglord/death1.wav");
	self.ad_pain_sound = "boglord/pain1.wav";
	self.ad_pain_sound2 = "boglord/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	precache_sound ("boglord/melee1.wav");
	precache_sound ("boglord/melee2.wav");
	precache_sound ("boglord/melee3.wav");
	precache_sound ("boglord/bolt_fire.wav");
	
	// Slime arc attack (not used anymore)
	precache_sound ("boglord/attack2.wav");
	precache_sound ("boglord/slime_explode.wav");
	precache_sound ("boglord/slime_miss.wav");
	
	// Melee attacks no longer used anymore
	//self.meleehitsound = "boglord/smack.wav";
	//precache_sound (self.meleehitsound);

	self.ad_sight_sound = "boglord/sight.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound ("boglord/thud.wav");
	precache_sound ("boglord/bangdoor1.wav");
	precache_sound ("boglord/bangdoor2.wav");

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	self.ad_bbmins = '-32 -32 -24';	// Special Size
	self.ad_bbmaxs = '32 32 80';
	self.ad_bboxtype = ad_BBOX_CUSTOM;	// Custom size
	// Boglord and Fire Shamblers are really just monsters with HP++
	// They don't need bossflag protection, their combat is standard stuff
	//self.bossflag = TRUE;			// Boss flag (like FL_MONSTER)

	self.ad_gibhealth = -60;			// Shambler gibness!
	self.ad_gibbed = ad_FALSE;			// Starts complete
	self.ad_pain_flinch = 400;			// Really low chance of pain
	self.ad_pain_timeout = 2;			// long pause on pain
	if (self.ad_infightextra <= 0) self.ad_infightextra = 8;
	self.ad_steptype = ad_FS_TYPELARGE;	// Large stomping feet
	self.ad_blockudeath = ad_TRUE;		// No player gib sound
	self.ad_pain_longanim = ad_FALSE;		// cannot be chopped with shadow axe
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	self.ad_tetherturn = ad_TRUE;			// Always turn towards enemy
	self.ad_tetherpause = 0.9;			// Rarely pauses to attacks
	self.dmg = 40;					// Radius dmg for gibondeath
	
	// Special Rage attack mode ( >0 = enabled )
	// Closer to 0 = Lightning attack, Closer to 1 = Ball attack
	// Make sure percentage chance within range of 0-1
	if (self.ad_attack_rage <= 0) self.ad_attack_rage = 0;
	if (self.ad_attack_rage >= 1) self.ad_attack_rage = 1;
	
	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	// Always reset Ammo Resistance to be consistent
	if (self.classname == "monster_gug") {
		self.ad_resist_shells = self.ad_resist_nails = 0;
		self.ad_resist_rockets = 0.5; self.ad_resist_cells = 0;
	}
	else {
		self.ad_resist_shells = self.ad_resist_nails = 0;
		self.ad_resist_rockets = self.ad_resist_cells = 0.75;
		self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
		self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles
	}
	
	self.ad_th_checkattack = ad_BogLordCheckAttack;
	self.ad_th_stand = ad_bogl_stand1;
	self.ad_th_walk = ad_bogl_walk1;
	self.ad_th_run = ad_bogl_run1;
	self.ad_th_melee = ad_bogl_smash1;
	self.ad_th_missile = ad_bogl_magic1;
	self.ad_th_pain = ad_bogl_pain;
	self.ad_th_die = ad_bogl_die;
	self.ad_th_wakeup = ad_bogl_wakeup1;
	self.ad_th_tether = ad_bogl_tetherattack;

	self.ad_classtype = ad_CT_MONBOGLORD;
	self.ad_classgroup = ad_CG_DEMON;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};

//----------------------------------------------------------------------
// Re-direct all Quoth Gug requests to Boglord!
void() ad_monster_gug = { 
	self.ad_attack_rage = 0.8;
	if (self.health <= 0) self.health = 2000;
	self.spawnflags = self.spawnflags | ad_MON_BOGL_STRONG;
	ad_monster_boglord(); 
}
