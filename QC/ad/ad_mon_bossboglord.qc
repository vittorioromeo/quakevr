//======================================================================
// RANGE ATTACK 2 - Projectile Lightning attack
//======================================================================
void() ad_bogl_lightning = 
{
	local vector ad_org, ad_dir, ad_vec;
	if (self.health < 1) return;
	
	ad_ai_face ();
	self.effects = self.effects | ad_EF_MUZZLEFLASH;

	// Setup skill based attack speed
	self.ad_attack_speed = ad_SPEED_BLORDBOLT + (ad_skill * ad_SPEED_BLORDSKILL);
	sound (self, ad_CHAN_WEAPON, "boglord/bolt_fire.wav", 1, ad_ATTN_NORM);	

	// Aim around player
	makevectors (self.angles);
	ad_org = self.ad_pos3 + ad_vecrand(10,10,1);
	ad_vec = v_right*(ad_crandom()*(20+random()*50));
	ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
	ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_BLBOLT, self.ad_attack_speed);	

	ad_org = self.ad_pos3 + ad_vecrand(10,10,1);
	ad_vec = v_right*(ad_crandom()*(20+random()*50));
	ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
	ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_BLBOLT, self.ad_attack_speed);	
};

//----------------------------------------------------------------------
void(vector ad_leftofs, vector ad_rightofs, float ad_sbframe) ad_bogl_casting =
{
	local vector ad_dir, ad_tang;
	local float ad_midpoint;
	if (self.health < 1) return;

	// Check if attachment has been setup yet
	if (!self.ad_attachment) ad_bogl_create_attachment();

	// Frame 0 is start of the sequence (move everything into place)
	if (ad_sbframe == 0) {
		setorigin(self.ad_attachment, self.origin);
		if (self.spawnflags & ad_MON_BOGL_STRONG) 
			setmodel(self.ad_attachment, ad_MODEL_PROJ_BLORDBEAM2);
		else setmodel(self.ad_attachment, ad_MODEL_PROJ_BLORDBEAM1);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.frame = 1;

		setorigin(self.ad_attachment2, self.origin);
		if (self.spawnflags & ad_MON_BOGL_STRONG) 
			setmodel(self.ad_attachment2, ad_MODEL_PROJ_BLORDBEAM2);
		else setmodel(self.ad_attachment2, ad_MODEL_PROJ_BLORDBEAM1);
		setsize (self.ad_attachment2, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment2.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment2.solid = ad_SOLID_NOT;
		self.ad_attachment2.frame = 1;

		setorigin(self.ad_attachment3, self.origin);
		if (self.spawnflags & ad_MON_BOGL_STRONG) 
			setmodel(self.ad_attachment3, ad_MODEL_PROJ_BLORD2B);
		else setmodel(self.ad_attachment3, ad_MODEL_PROJ_BLORD1B);
		setsize (self.ad_attachment3, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment3.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment3.solid = ad_SOLID_NOT;
	}
	
	// Turn toward enemy
	ad_ai_face();
	makevectors(self.angles);

	// Work out each hand position
	self.pos1 = self.origin + ad_attack_vector(ad_leftofs);
	self.pos2 = self.origin + ad_attack_vector(ad_rightofs);
	ad_dir = normalize(self.pos2 - self.pos1);
	ad_tang = vectoangles(ad_dir);
	// Calculate the mid point between the hands for the orb
	ad_midpoint = vlen(self.pos2 - self.pos1) * 0.5;
	self.ad_pos3 = self.pos1 + (ad_dir*ad_midpoint);

	// Move beam sections into place along vector
	setorigin(self.ad_attachment, self.pos1+(ad_dir*16));
	setorigin(self.ad_attachment2, self.pos2-(ad_dir*16));
	self.ad_attachment.angles = self.ad_attachment2.angles = ad_tang;
	
	// Place orb in the center of the electricity
	setorigin(self.ad_attachment3, self.ad_pos3);
	self.ad_attachment3.angles_y = rint(random()*359);
	self.ad_attachment3.frame = ad_sbframe+8;
	
	ad_particle_explode(self.pos1, 5+random()*5, 1, self.ad_part_style, ad_PARTICLE_BURST_LOSTUP);
	ad_particle_explode(self.pos2, 5+random()*5, 1, self.ad_part_style, ad_PARTICLE_BURST_LOSTUP);	
};

