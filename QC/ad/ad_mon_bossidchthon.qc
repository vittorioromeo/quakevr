//----------------------------------------------------------------------
void() ad_lightning_fire =
{
	local vector ad_p1, ad_p2;
	
	// done here, put the terminals back up
	if (time >= ad_lightning_end) {
		self = ad_le1;
		ad_func_door_go_down ();
		self = ad_le2;
		ad_func_door_go_down ();
		return;
	}
	
	ad_p1 = (ad_le1.mins + ad_le1.maxs) * 0.5;
	ad_p1_z = ad_le1.absmin_z - 16;
	
	ad_p2 = (ad_le2.mins + ad_le2.maxs) * 0.5;
	ad_p2_z = ad_le2.absmin_z - 16;
	
	// compensate for length of bolt
	ad_p2 = ad_p2 - normalize(ad_p2-ad_p1)*100;

	self.nextthink = time + 0.1;
	self.think = ad_lightning_fire;

	WriteByte (ad_MSG_ALL, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_ALL, ad_TE_LIGHTNING3);
	WriteEntity (ad_MSG_ALL, world); WriteByte (ad_MSG_ALL, 0);
	WriteCoord (ad_MSG_ALL, ad_p1_x);
	WriteCoord (ad_MSG_ALL, ad_p1_y);
	WriteCoord (ad_MSG_ALL, ad_p1_z);
	WriteCoord (ad_MSG_ALL, ad_p2_x);
	WriteCoord (ad_MSG_ALL, ad_p2_y);
	WriteCoord (ad_MSG_ALL, ad_p2_z);
};

//----------------------------------------------------------------------
void() ad_lightning_use =
{
	if (ad_lightning_end >= time + 1) return;

	ad_le1 = find( world, target, "lightning");
	ad_le2 = find( ad_le1, target, "lightning");
	if (!ad_le1 || !ad_le2) {
		dprint ("\b[CHTHON]\b missing lightning targets\n");
		return;
	}
	
	// Check for lightning block alignment
	if (
	 (ad_le1.state != ad_STATE_TOP && ad_le1.state != ad_STATE_BOTTOM)
	|| (ad_le2.state != ad_STATE_TOP && ad_le2.state != ad_STATE_BOTTOM)
	|| (ad_le1.state != ad_le2.state) )
	{ return; }

	// don't let the electrodes go back up until the bolt is done
	ad_le1.nextthink = -1;
	ad_le2.nextthink = -1;
	ad_lightning_end = time + 1;

	sound (self, ad_CHAN_VOICE, "misc/power.wav", 1, ad_ATTN_NORM);
	ad_lightning_fire ();		

	// advance the boss pain if down
	self = find (world, classname, "monster_boss");
	if (!self) return;
	self.enemy = ad_activator;
	if (ad_le1.state == ad_STATE_TOP && self.health > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		self.health = self.health - 1;
		if (self.health >= 2) ad_idchthon_shocka1();
		else if (self.health == 1) ad_idchthon_shockb1();
		else if (self.health == 0) ad_idchthon_shockc1();
	}	
};

