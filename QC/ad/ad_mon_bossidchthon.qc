Flying ball needed to teleport kill Shub-Niggurath
Originallu used bmodel train functions, setup to work like
the shalrath homing missile

======================================================================*/
void() ad_teleporttrain_next;
void() ad_teleporttrain_target =
{
	local vector ad_dir;

	if (self.target != "") {
		// Find next target entity
		self.enemy = find (world, targetname, self.target);
		if (self.enemy) {
			// Work out distance and angle to turn towards
			ad_dir = normalize(self.enemy.origin - self.origin);
			self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
			self.velocity = ad_dir * self.speed;
	
			// Shift target to next target in the entity chain
			self.target = self.enemy.target;
			self.nextthink = time + 0.1;
			self.think = ad_teleporttrain_next;
			return;
		}
	}
	// No target or entity to follow, full stop
	self.velocity = '0 0 0';
	self.enemy = world;
};

//----------------------------------------------------------------------
void() ad_teleporttrain_next =
{
	if (!self.enemy) return;

	// Work out how close to the next target (self.enemy)		
	self.t_length = vlen(self.enemy.origin - self.origin);
	if (self.t_length < 64) ad_teleporttrain_target();
	else {
		// Keep checking
		self.nextthink = time + 0.1;
		self.think = ad_teleporttrain_next;
	}		
};

//----------------------------------------------------------------------
void() ad_misc_teleporttrain =
{	
	self.mdl = "progs/teleport.mdl";
	precache_model (self.mdl);

	self.solid = ad_SOLID_TRIGGER;
	// Push movetype cannot rotate, fly can
	//	self.movetype = MOVETYPE_PUSH;
	self.movetype = ad_MOVETYPE_FLY;
	self.use = ad_teleporttrain_target;
	self.avelocity = ad_vecrand(50,250,ad_FALSE);

	setmodel (self, self.mdl);
	setsize (self, ad_VEC_ORIGIN , ad_VEC_ORIGIN);

	if (!self.speed) self.speed = 100;
	if (self.target == "") {
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
	}
};
