//============================================================================
// freddie has a run while firing and can switch seamless
// between the two if the player is within sight
//============================================================================
void() ad_fred_runframe =
{
	// If dead, no more updates
	if (self.health < 1) return;
	// If enemy is dead or missing no firing
	if (!self.enemy || self.enemy.health < 1) self.ad_attack_timer = ad_FALSE;

	if (self.ad_attack_timer) self.frame = $rfire1 + self.ad_walkframe;
	else self.frame = $run1 + self.ad_walkframe;

	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	else if (self.ad_walkframe == 1) ad_monster_footstep(ad_FALSE);
	else if (self.ad_walkframe == 10) ad_monster_footstep(ad_FALSE);

	if (self.ad_walkframe == 0) {self.distance = 24;self.ad_attack_offset = '50 -20 32';}
	else if (self.ad_walkframe == 1) {self.distance = 19;self.ad_attack_offset = '43 -18 33';}
	else if (self.ad_walkframe == 2) {self.distance = 1;self.ad_attack_offset = '53 -20 27';}
	else if (self.ad_walkframe == 3) {self.distance = 2;self.ad_attack_offset = '47 -19 31';}
	else if (self.ad_walkframe == 4) {self.distance = 5;self.ad_attack_offset = '54 -17 29';}
	else if (self.ad_walkframe == 5) {self.distance = 10;self.ad_attack_offset = '47 -17 35';}
	else if (self.ad_walkframe == 6) {self.distance = 5;self.ad_attack_offset = '53 -15 32';}
	else if (self.ad_walkframe == 7) {self.distance = 5;self.ad_attack_offset = '47 -15 36';}
	else if (self.ad_walkframe == 8) {self.distance = 24;self.ad_attack_offset = '50 -13 32';}
	else if (self.ad_walkframe == 9) {self.distance = 19;self.ad_attack_offset = '46 -15 33';}
	else if (self.ad_walkframe == 10) {self.distance = 1;self.ad_attack_offset = '51 -14 33';}
	else if (self.ad_walkframe == 11) {self.distance = 2;self.ad_attack_offset = '47 -14 32';}
	else if (self.ad_walkframe == 12) {self.distance = 5;self.ad_attack_offset = '52 -14 33';}
	else if (self.ad_walkframe == 13) {self.distance = 10;self.ad_attack_offset = '47 -14 36';}
	else if (self.ad_walkframe == 14) {self.distance = 5;self.ad_attack_offset = '49 -14 35';}
	else if (self.ad_walkframe == 15) {self.distance = 5;self.ad_attack_offset = '45 -15 34';}

	// Run + Fire time?
	if (self.ad_attack_timer) {
		// Keep turning towards the enemy
		ad_ai_face();
		// Fire a small burst at the enemy
		self.cnt = self.cnt + 1;
		if (self.cnt > 2) self.ad_attack_timer = ad_FALSE;
		else ad_fred_fireweapon(self.ad_attack_offset);
	}
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 15) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_fred_runframe;

	ad_ai_run(self.distance);
};

//----------------------------------------------------------------------
void() ad_fred_run = { self.ad_walkframe = 0; ad_fred_runframe(); };

//===========================================================================
// MELEE ATTACK - Various back and forth blade arm attacks
//===========================================================================
void(float ad_side) ad_fred_blade =
{
	local float ad_ldmg;
	
	if (!self.enemy) return;
	if (self.health < 1) return;

	ad_ai_damagebreakable(20);							// Damage any breakables
	if (!ad_ai_checkmelee(self.ad_meleerange, ad_MONAI_MELEEZTALL)) return;	// Too far away

	// Can the target bleed? - generate blood
	if (!ad_CanDamage (self.enemy, self)) return;
	
	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	sound (self, ad_CHAN_WEAPON, "freddie/mangle.wav", 1, ad_ATTN_NORM);
	// 1-45 (3x15) damage
	ad_ldmg = (random() + random() + random()) * 15;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);
	ad_SpawnMeatSpray (self, self.enemy, ad_side);
	ad_SpawnMeatSpray (self, self.enemy, ad_side);
};

