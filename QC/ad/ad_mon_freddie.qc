//===========================================================================
// RANGE ATTACK - Fires spikes or laser bolts
//===========================================================================
void(vector ad_weapofs) ad_fred_fireweapon =
{
	local vector ad_org, ad_dir, ad_vec;
	
	// Check for death?
	if (self.health < 1) return;

	// Lit up that barrel
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	// Nail and laser use the same firing speed
	self.ad_attack_speed = ad_SPEED_FREDDIEPROJ + (ad_skill * ad_SPEED_FREDDIESKILL);
	// turn and face your enemy!
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(ad_weapofs);
	
	// The mini burst mode (run+fire) can do tracking
	if (self.ad_attack_timer && ad_skill > ad_SKILL_NORMAL) {
		// More precise fire, track player velocity
		// Reset the tracking on first shot, get better over time
		if (self.cnt == 1) 
			self.ad_attack_track = ad_SUB_Tracking(self.enemy.origin, ad_weapofs, self.enemy, self.ad_attack_speed);
		else self.ad_attack_track = ad_SUB_Tracking(self.ad_attack_track, ad_weapofs, self.enemy, self.ad_attack_speed);
		ad_dir = normalize(self.ad_attack_track - ad_org);
	}
	else {
		// Standard mode spray bullets at player
		ad_vec = v_right*(ad_crandom()*(20+random()*50));
		ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
	}

	// Switch projectile type based on spawnflag
	if (self.spawnflags & ad_MON_FREDDIE_LASER) {
		sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);	
		ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_LASER, self.ad_attack_speed);
	}
	else {
		sound (self, ad_CHAN_WEAPON, "weapons/rocket1i.wav", 1, ad_ATTN_NORM);
		ad_launch_projectile(ad_org, ad_dir, ad_CT_PROJ_MONNG, self.ad_attack_speed);
	}
};

// Start the initial wind up of the weapon first
//----------------------------------------------------------------------
void() ad_fred_sfire1 = [ $sfire1, ad_fred_sfire2 ] {ad_ai_face();
	self.ad_pain_finished = time + 0.5 + (ad_skill*0.5);
	sound (self, ad_CHAN_WEAPON, "freddie/stfire.wav", 1, ad_ATTN_NORM);};
void() ad_fred_sfire2 = [ $sfire2, ad_fred_sfire3 ] {ad_ai_face();};
void() ad_fred_sfire3 = [ $sfire3, ad_fred_sfire4 ] {ad_ai_face();};
void() ad_fred_sfire4 = [ $sfire4, ad_fred_sfire5 ] {ad_ai_face();};
void() ad_fred_sfire5 = [ $sfire5, ad_fred_sfire6 ] {ad_ai_face();ad_monster_footstep(ad_FALSE);};
void() ad_fred_sfire6 = [ $sfire6, ad_fred_sfire7 ] {ad_ai_face();};
void() ad_fred_sfire7 = [ $sfire7, ad_fred_sfire8 ] {ad_ai_face();};
void() ad_fred_sfire8 = [ $sfire8, ad_fred_sfire9 ] {ad_ai_face();
	self.cnt = 0;
	// Vary bullet burst based on skill
	self.ad_attack_chance = 4 + ad_skill*2;
};

// Fire the weapon in bursts
//----------------------------------------------------------------------
void(vector ad_weapofs) ad_fred_standfire =
{
	// Always check AI health before locking in function
	if (self.health < 1) return;
	
	// Turn before offset check
	ad_ai_face();

	// If no enemy or enemy dead then stop attack
	if (!self.enemy || self.enemy.health < 1) self.cnt = 10;
	// Check if can see enemy? (use weapon offset)
	else if (ad_visxray(self.enemy, ad_weapofs, '0 0 0', ad_FALSE))
		self.cnt = self.cnt + 1;
	// Reset counter and keep firing
	else self.cnt = 0;
	
	// If fired a burst of bullets at enemy, stop loop
	if (self.cnt > self.ad_attack_chance) self.think = self.ad_th_charge;
	else ad_fred_fireweapon(ad_weapofs);
};

// Cycle through barrel firing
// Easy = 7 shots, Normal = 11 shots, Hard/NM = 15 shots
//----------------------------------------------------------------------
void() ad_fred_sfire9 = [ $sfire9, ad_fred_sfire10 ] {ad_fred_standfire('45 -10 20');};
