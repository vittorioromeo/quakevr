void() ad_fred_fswing10 = [ $fswing10, ad_fred_fswing11 ] {ad_ai_faceforward(2);};
void() ad_fred_fswing11 = [ $fswing11, ad_fred_fswinge1 ] {
	// Always check for enemy and health before changing think
	if (self.enemy && self.enemy.health > 1 && self.health > 0) {
		// Check if within range to do a second (back) swing attack
		if (ad_ai_checkmelee(self.ad_meleerange, ad_MONAI_MELEEZTALL)) self.think = ad_fred_bswing1;
	}
};

