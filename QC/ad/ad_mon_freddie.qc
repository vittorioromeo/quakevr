//----------------------------------------------------------------------
void() ad_fred_explode =
{
	// no more FREDDIE!
	ad_entity_hide (self);
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// ID style explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	
	// Sprite + Dust (+ explosion death sound)
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound2);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);

	// Regular blood like gibs
	ad_ThrowGib(4, 2 + rint(random()*4));
	ad_ThrowGib(5, 2 + rint(random()*4));
	ad_ThrowGib(25, 1);
	// Metal and custom body parts
	self.ad_gibtype = ad_GIBTYPE_METAL;
	ad_ThrowGib(11, 1 + rint(random()*2));
	ad_ThrowGib(12, 2 + rint(random()*2));
	ad_ThrowGib(13, 2 + rint(random()*2));
};

//----------------------------------------------------------------------
void() ad_fred_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		ad_fred_death1 ();
	}
};

/*======================================================================
QUAKED monster_freddie (1 0 0) (-32 -32 -24) (32 32 64) Ambush
======================================================================*/
void() ad_monster_freddie =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_freddie.mdl";			// was edie.mdl
	self.ad_headmdl = "progs/h_ogre.mdl";			// ID ogre
	self.ad_gib1mdl = "progs/gib_freddiejunk.mdl";	// wreckage.mdl
	self.ad_gib2mdl = "progs/gib_metal1.mdl";		// Breakable metal
	self.ad_gib3mdl = "progs/gib_metal3.mdl";		// Breakable metal

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);		// ID Ogre head	
	// Gib Junk - 0=Axle, 1=bolt, 2=chip, 3=wing
	precache_model (self.ad_gib1mdl);		// Multiple chunks of junk
	self.ad_gib1frame = 3;					// 4 frames choose from
	precache_model (self.ad_gib2mdl);		// Generic metal1_2
	precache_model (self.ad_gib3mdl);		// Generic metal1_2
	
	self.ad_idle_sound = "freddie/idle1.wav";
	precache_sound (self.ad_idle_sound);

	// Melee sounds, swing and impact
	precache_sound("freddie/sawstart.wav");
	precache_sound("freddie/mangle.wav");

	// Default attack - red glowing nails
	precache_model (ad_MODEL_PROJ_NGRED);
	precache_sound("freddie/stfire.wav");

	// Alternative attack - lasers!?!
	if (self.spawnflags & ad_MON_FREDDIE_LASER) {
		precache_model (ad_MODEL_PROJ_LASER);
		precache_sound (ad_SOUND_LASER_FIRE);
		precache_sound (ad_SOUND_LASER_HIT);
	}

	self.ad_death_sound = "freddie/death.wav";
	self.ad_death_sound2 = "freddie/explode_major.wav";
	precache_sound (self.ad_death_sound);
	precache_sound (self.ad_death_sound2);
	self.ad_pain_sound = "freddie/pain.wav";
	self.ad_pain_sound2 = "freddie/painshrt.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	
	self.ad_sight_sound = "freddie/sight.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_GIANT;
	if (self.health < 1) self.health = 500;
	self.ad_gibhealth = -80;				// Hard to gib
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 200;				// takes alot to pain
	self.ad_pain_longanim = ad_FALSE;			// cannot be chopped with shadow axe
	if (!self.ad_infightextra) self.ad_infightextra = 2;	// 2x infighting dmg
	self.ad_meleerange = ad_MONAI_MELEEFREDDIE;	// Blade range
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_FREDDIE;
	self.ad_pain_timeout = 2;				// High pain threshold
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_attack_offset = '0 0 0';		// Run + Gun vector
	self.ad_poisonous = ad_FALSE;				// Robots are not poisonous
	self.ad_deathstring = " was exterminated by Freddie\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	// Custom feet sounds (specific order)
	self.ad_stepc1 = "freddie/step.wav";
	self.ad_stepc2 = "freddie/step2.wav";
	self.ad_stepc3 = "freddie/step.wav";
	self.ad_stepc4 = "freddie/step2.wav";
	self.ad_stepc5 = "freddie/step3.wav";
	precache_sound (self.ad_stepc1);
	precache_sound (self.ad_stepc2);
	precache_sound (self.ad_stepc5);
	self.ad_steptype = ad_FS_TYPECUSTOM;

	self.ad_th_checkattack = ad_FreddieCheckAttack;
	self.ad_th_stand = ad_fred_stand1;
	self.ad_th_walk = ad_fred_walk1;
	self.ad_th_run = ad_fred_run;
	self.ad_th_melee = ad_fred_fswing1;		// Blade arm
	self.ad_th_missile = ad_fred_sfire1;		// Spike/Laser bolts
	self.ad_th_charge = ad_fred_sfire24;		// End of barrel weapon
	self.ad_th_pain = ad_fred_pain;
	self.ad_th_die = ad_fred_die;
	self.ad_th_gibdie = ad_fred_explode;

	self.ad_classtype = ad_CT_MONFREDDIE;
	self.ad_classgroup = ad_CG_OGRE;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};

// Re-direct all Quoth Edie requests to Freddie!
void() ad_monster_edie = { ad_monster_freddie(); }
