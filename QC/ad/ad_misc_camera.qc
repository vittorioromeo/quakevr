// Arcane Dimensions 1.80 patch 1 (Simon "sock" O'Callaghan and team; GPL-2.0-or-later, see
// AD's readme and docs/vr-port/CREDITS.md), my_progs/misc_camera.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// Cinematic Camera System
//======================================================================
// Camera spawnflags
float ad_CINECAM_FUNC_PLAYER = 1;	// Setup fake player model
float ad_CINECAM_FUNC_SKIPABLE = 2;// Allow cinematic to be skipable
float ad_CINECAM_FUNC_FADEOUT = 4;	// Fade OUT pevious camera
float ad_CINECAM_FUNC_FADEIN = 8;	// Fade IN next camera
float ad_CINECAM_FUNC_FIXEDANGLE = 16;	// First camera defines fixed angle
float ad_CINECAM_FUNC_ENDCAMERA = 32;	// Fade in/out only, no org/ang

// v_cshift min/max values
float ad_CINECAM_MINSHIFT = 0;		// Minimun value for density
float ad_CINECAM_MAXSHIFT = 255;	// Maximm value for density 
float ad_CINECAM_FADEUP = 1;		// Fading directions
float ad_CINECAM_FADEDOWN = 2;

// Camera Controller loop/tick speed
float ad_CINECAM_CONTIME = 0.05;	// Controller tick rate (speed)

// Camera System states
float ad_CINECAM_OFF = 0;			// Waiting for a camera

float ad_CINECAM_STARTUP = 4;		// Save client info and start sequence
float ad_CINECAM_FADEOUT = 6;		// Start fading out current view
float ad_CINECAM_NEXTCAM = 8;		// Switch camera and focus
float ad_CINECAM_FADEIN = 10;		// Start fading in current camera

float ad_CINECAM_MESSAGE = 14;		// Show messages and setup timers
float ad_CINECAM_WAIT = 16;		// Waiting player input
float ad_CINECAM_EXIT = 20;		// Back to player position
float ad_CINECAM_FADE = 25;		// Fade in or out camera

// Camera Sequence number
float ad_CINECAM_SEQ_FIRST = 1;	// Starting with the player camera
float ad_CINECAM_SEQ_ACTIVE = 2;	// Camera sequence now active
float ad_CINECAM_SEQ_LAST = 4;		// Going back to player camera

// Camera Skip conditions
float ad_CINECAM_SKIP_OFF = 0;		// No skip function available
float ad_CINECAM_SKIP_ACTIVE = 1;	// Waiting for buttons (fire/jump)
float ad_CINECAM_SKIP_DONE = 2;	// Cinematic finished, exit Asasp

float ad_CINECAM_FIXANGLE_OFF = 0;		// Always reset camera angle
float ad_CINECAM_FIXANGLE_ACTIVE = 1;	// Read first angle only
float ad_CINECAM_FIXANGLE_DONE = 2;	// First angle read and done

/*======================================================================
Cinematic camera control functions

camera_controller_cshift	- Updates console with new cshift parameters
camera_tracking_finish		- Finish camera tracking movement 
camera_controller_think		- Main cinematic controller loop
camera_controller_setup		- Setup controller, movement and fakeplay ents
misc_camera_use				- Trigger function for camera's
misc_camera_colcheck		- Way to validate RGB background colours
misc_camera					- Spawning function for camera system

======================================================================*/
void(entity ad_targ, vector ad_cs_col, float ad_cs_den) ad_camera_controller_cshift = 
{
	stuffcmd(ad_targ, "v_cshift ");
	stuffcmd(ad_targ, ftos(rint(ad_cs_col_x))); stuffcmd(ad_targ, " ");
	stuffcmd(ad_targ, ftos(rint(ad_cs_col_y))); stuffcmd(ad_targ, " ");
	stuffcmd(ad_targ, ftos(rint(ad_cs_col_z))); stuffcmd(ad_targ, " ");
	stuffcmd(ad_targ, ftos(rint(ad_cs_den))); stuffcmd(ad_targ, "\n");	
};

//----------------------------------------------------------------------
void() ad_camera_tracking_finish =
{
	self.ad_attack_finished = 0;
	self.velocity = '0 0 0';
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_camera_reset_buttons = 
{ 
	if (ad_targ.flags & ad_FL_CLIENT) {
		ad_targ.button0 = ad_targ.button1 = ad_targ.button2 = 0;
	}
};

//----------------------------------------------------------------------
float(entity ad_targ) ad_camera_check_buttons =
{
	// Check client + buttons
	if (ad_targ.flags & ad_FL_CLIENT) {
		if (ad_targ.button0 || ad_targ.button1 || ad_targ.button2) return ad_TRUE;
	}
	// Default
	return ad_FALSE;
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_camera_check_skip =
{
	// Is cinematic skip function enabled?
	if (ad_cam_exit == ad_CINECAM_SKIP_ACTIVE) {
		// Check for exit condition buttons (fire/jump)
		if (ad_camera_check_buttons(ad_targ)) {
			// Don't need buttons anymore
			ad_camera_reset_buttons(ad_targ);
			// Start to exit cinematic ASAP
			ad_cam_exit = ad_CINECAM_SKIP_DONE;
		}
	}
};

//----------------------------------------------------------------------
float(float ad_cam_angle1, float ad_cam_angle2) ad_camera_check_anglezero =
{
	// Smallest / Largest camera angle
	local float ad_cam_anglesmall, ad_cam_anglelarge;
	// Camera small/large angle distance and wrap distance
	local float ad_cam_angledist, ad_cam_anglewrap;
	
	// Guard against interpolating across the 360<->0 discontinuity
	ad_cam_anglelarge = ad_mathlib_max(ad_cam_angle1, ad_cam_angle2);
	ad_cam_anglesmall = ad_mathlib_min(ad_cam_angle1, ad_cam_angle2);

	// This is the distance between the yaws if we don't cross 360.
	ad_cam_angledist = ad_cam_anglelarge - ad_cam_anglesmall;
	// This is the distance if we do cross 360. i.e. "359" and "1" would
	// have an angle_wrap of "2" and direct_dist of "358".
	ad_cam_anglewrap = (360 - ad_cam_anglelarge) + ad_cam_anglesmall;

	// Is it shorter to cross the 360<->0 boundary?
	if (ad_cam_anglewrap < ad_cam_angledist) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
float(float ad_baxis_start, float ad_baxis_control, float ad_baxis_end, float ad_baxis_time) ad_bezier_axis =
{
	local float ad_baxis_1, ad_baxis_2, ad_baxis_3, ad_baxis_return;
	
	// Work out bezier curve position 
	ad_baxis_1 = ((1 - ad_baxis_time) * (1 - ad_baxis_time)) * ad_baxis_start;
	ad_baxis_2 = ((2 * ad_baxis_time) * (1 - ad_baxis_time)) * ad_baxis_control;
	ad_baxis_3 = (ad_baxis_time * ad_baxis_time) * ad_baxis_end;
	// Add up parts and return result
	ad_baxis_return = ad_baxis_1 + ad_baxis_2 + ad_baxis_3;
	return ad_baxis_return;
};

//----------------------------------------------------------------------
vector(vector ad_bez_start, vector ad_bez_control, vector ad_bez_end, float ad_bez_timemax, float ad_bez_timeleft) ad_bezier_curve =
{
	local vector ad_bez_result;
	local float ad_bez_time;
	
	// Normalize (0-1) the time value 
	ad_bez_time = ad_bez_timeleft / ad_bez_timemax;
	// Make sure time is within normalized range (0-1)
	if (ad_bez_time <= 0) ad_bez_time = 0;
	if (ad_bez_time >= 1) ad_bez_time = 1;

	// Work out each vector (XYZ) axis
	ad_bez_result_x = ad_bezier_axis(ad_bez_start_x, ad_bez_control_x, ad_bez_end_x, ad_bez_time);
	ad_bez_result_y = ad_bezier_axis(ad_bez_start_y, ad_bez_control_y, ad_bez_end_y, ad_bez_time);
	ad_bez_result_z = ad_bezier_axis(ad_bez_start_z, ad_bez_control_z, ad_bez_end_z, ad_bez_time);
	
	return ad_bez_result;
};

//----------------------------------------------------------------------
// Bezier curve debug system (developer = 1 only)
// Display the curve with yellow diamonds
//----------------------------------------------------------------------
void() ad_misc_camera_bezier_debug =
{
	// Block debug info regardless (help reduce ents)
	if (self.ad_nodebuginfo == ad_TRUE) return;
	
	// Find the bezier curve CONTROL point
	self.ad_attachment2 = find(world, targetname, self.ad_controltarget);
	// Find the bezier curve END point
	self.ad_attachment3 = find(world, targetname, self.target);

	// Display debug markers for start/control/end locations
	ad_spawn_marker(self.origin, ad_SPNMARK_RED);
	ad_spawn_marker(self.ad_attachment2.origin, ad_SPNMARK_GREEN);
	ad_spawn_marker(self.ad_attachment3.origin, ad_SPNMARK_RED);
	
	// Loop through 10 points on each bezier curve
	self.cnt = 0.1;
	while (self.cnt < 1) {
		// Work out bezier curve vector position
		self.finalangle = ad_bezier_curve(self.origin, self.ad_attachment2.origin, self.ad_attachment3.origin, 1, self.cnt);
		// Spawn debug marker (yellow is wrong colour!)
		ad_spawn_marker(self.finalangle, ad_SPNMARK_YELLOW);
		self.cnt = self.cnt + 0.1;
	}
};

//======================================================================
// Main loop for cinematic controller (all states)
//======================================================================
void() ad_camera_controller_think =
{
	self.think = ad_camera_controller_think;
	self.nextthink = time + ad_CINECAM_CONTIME;

	//---------------------------------------------------------------------
	// Check first if camera/client are setup
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_SETUP) {
		// Check there is a camera to focus on
		if (ad_cam_focus.ad_classtype != ad_CT_MISCCAM) ad_cam_active = ad_CINECAM_OFF;
		else if (!(ad_cam_client.flags & ad_FL_CLIENT)) ad_cam_active = ad_CINECAM_OFF;
		else ad_cam_active = ad_CINECAM_STARTUP;
	}
	
	//---------------------------------------------------------------------
	// Save player details and start cinematic system
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_STARTUP) {
		// Cinematic time!
		ad_cinematic_running = ad_TRUE;
		ad_cam_locked = ad_FALSE;		// No angle update
		ad_cam_movement = ad_FALSE;	// No movement tracking
		ad_cam_fakeplay = ad_FALSE;	// The invisible man
		ad_cam_angle = '0 0 0';	// Reset angles
		ad_cam_lastanglevalid = ad_FALSE;	// Reset angle smoothing
		
		// Reset player location markers
		self.ad_attachment = self.ad_attachment2 = world;
		
		// Check for fake player model on first camera in chain
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_PLAYER) {
			// fake player model active
			ad_cam_fakeplay = ad_TRUE;
			// Check for special player location entity
			if (ad_cam_focus.ad_modeltarget != "") {
				self.ad_attachment = find(world, targetname, ad_cam_focus.ad_modeltarget);
				// Found the target entity?
				if (self.ad_attachment) {
					// Spawn a dev marker (can be blocked)
					if (ad_developer > 0 && !self.ad_nodebuginfo) 
						ad_spawn_marker(self.ad_attachment.origin, ad_SPNMARK_RED);
					// Info_teleport_destination are fined tuned for trig_teleport
					if (self.ad_attachment.ad_classtype == ad_CT_MISCTELEPORT) {
						self.ad_attachment.origin = self.ad_attachment.origin - '0 0 27';
						self.ad_attachment.angles = self.ad_attachment.mangle;
					}
				}
			}
		}

		// Check for any special returning position for the player
		if (ad_cam_focus.ad_returntarget != "") {
			self.ad_attachment2 = find(world, targetname, ad_cam_focus.ad_returntarget);
			// Found the target entity?
			if (self.ad_attachment2) {
				// Spawn a dev marker (can be blocked)
				if (ad_developer > 0 && !self.ad_nodebuginfo) 
					ad_spawn_marker(self.ad_attachment2.origin, ad_SPNMARK_RED);
				// Info_teleport_destination are fined tuned for trig_teleport
				if (self.ad_attachment2.ad_classtype == ad_CT_MISCTELEPORT) {
					self.ad_attachment2.origin = self.ad_attachment2.origin - '0 0 27';
					self.ad_attachment2.angles = self.ad_attachment2.mangle;
				}
			}
		}
		
		// Check for any exit/finished cinematic trigger(s)
		if (ad_cam_focus.ad_deathtarget == "") self.ad_deathtarget = "";
		else self.ad_deathtarget = ad_cam_focus.ad_deathtarget;

		// Check for cinematic skip functionality
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_SKIPABLE)
			ad_cam_exit = ad_CINECAM_SKIP_ACTIVE;		// Chck for button inputs
		else ad_cam_exit = ad_CINECAM_SKIP_OFF;		// No skip function

		// Check for constant fixed angles on all cameras
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_FIXEDANGLE) 
			ad_cam_fixangle = ad_CINECAM_FIXANGLE_ACTIVE;	// Read first camera
		else ad_cam_fixangle = ad_CINECAM_FIXANGLE_OFF;	// Reset everytime

		// Save the current HUD settings for later
		ad_cam_hudsize = cvar("viewsize");
		ad_cam_crosshair = cvar("crosshair");
		
		// Save player parameters
		self.ad_pos4 = ad_cam_client.origin;			// Model/entity location
		self.ad_pos5 = ad_cam_client.view_ofs;		// Origin offset
		self.ad_pos6 = ad_cam_client.velocity;		// Movement (Not used)
		self.finalangle = ad_cam_client.angles;	// Model angle
		self.ad_finaldest = ad_cam_client.v_angle;	// Viewing angle
		self.weapon = ad_cam_client.weapon;		// Current weapon
		self.currentammo = ad_cam_client.currentammo;
		self.weaponmodel = ad_cam_client.weaponmodel;
		self.weaponframe = ad_cam_client.weaponframe;

		// Stop player falling/interacting with world
		ad_cam_client.takedamage = ad_DAMAGE_NO;
		ad_cam_client.solid = ad_SOLID_NOT;
		ad_cam_client.movetype = ad_MOVETYPE_NONE;
		setsize(ad_cam_client, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		// Stop any further movement (will translate to cinematics)
		ad_cam_client.velocity = ad_cam_client.avelocity = '0 0 0';
		
		// Fade out of first camera (player)
		ad_cam_sequence = ad_CINECAM_SEQ_FIRST;
		// Skip the fade out from player camera for spawning players
		if (ad_cam_startup) ad_cam_active = ad_CINECAM_NEXTCAM;
		// Start with fading out current player camera
		else ad_cam_active = ad_CINECAM_FADEOUT;
	}

	//---------------------------------------------------------------------
	// Sort out wait timers, centerprint messages and sounds
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_MESSAGE) {
		// Is cinematic skip done?
		if (ad_cam_exit != ad_CINECAM_SKIP_DONE) {
			// Check for any wait parameters (-1=wait for trigger)
			if (ad_cam_focus.wait < 0) self.ad_attack_finished = -1;
			else if (ad_cam_focus.wait == 0) self.ad_attack_finished = 0;
			else self.ad_attack_finished = time + ad_cam_focus.wait;
			
			// Center print message to display?
			if (ad_cam_focus.message) {
				ad_centerprint(ad_cam_client, ad_cam_focus.message);
				// Default talk sound (using sounds entity key)
				sound (ad_cam_client, ad_CHAN_VOICE, ad_cam_focus.noise, 1, ad_ATTN_NORM);
			}
		}
		// Wait for player input or timer
		self.ad_pain_finished = ad_FALSE;
		ad_cam_active = ad_CINECAM_WAIT;
	}

	//---------------------------------------------------------------------
	// Wait for timer or player input
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_WAIT) {
		// Is cinematic skip in progress?
		if (ad_cam_exit == ad_CINECAM_SKIP_DONE) {
			// Exit as quick as possible (no fading)
			ad_cam_active = ad_CINECAM_NEXTCAM;
			ad_cam_sequence = ad_CINECAM_SEQ_LAST;
		}
		else {
			// Waiting for a key press (jump/fire/use)
			// This has to be done before camera_check_skip
			// Otherwise the button values are reset
			if (self.ad_attack_finished == -1) {
				// Any buttons pressed? (fire/jump)
				if (ad_camera_check_buttons(ad_cam_client)) {
					ad_camera_reset_buttons(ad_cam_client);
					self.ad_pain_finished = ad_TRUE;
				}
			}
			// Has the wait timer expired?
			else if (self.ad_attack_finished < time) self.ad_pain_finished = ad_TRUE;
			// Check for skip functionality
			else ad_camera_check_skip(ad_cam_client);
		
			// Time to exit current camera?
			if (self.ad_pain_finished) {
				// fade out current camera view angle
				ad_cam_active = ad_CINECAM_FADEOUT;
				self.ad_pain_finished = ad_FALSE;
				
				// Is there another camera?
				if (ad_cam_focus.target == "") {
					// End of sequence, back to player
					ad_cam_sequence = ad_CINECAM_SEQ_LAST;
				}
				else {
					// search for target camera
					self.enemy = find(world, targetname, ad_cam_focus.target);
					// Found a misc camera?
					if (self.enemy.ad_classtype == ad_CT_MISCCAM) {
						self.enemy.ad_movetarget3 = ad_cam_focus;
						ad_cam_focus = self.enemy;
					}
					// Next target is not a camera!?!
					else ad_cam_sequence = ad_CINECAM_SEQ_LAST;
				}
			}
		}
	}

	//---------------------------------------------------------------------
	// Fade OUT camera (player if first camera)
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_FADEOUT) {
		// Check if fade out is active (spawnflags)
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_FADEOUT) {
			// Start fading player view out to solid colour
			// Work out cshift density steps
			self.lip = ad_CINECAM_MAXSHIFT / (ad_cam_focus.waitmin / ad_CINECAM_CONTIME);
			ad_cam_colour = ad_cam_focus.pos1;		// Fade In background
			self.count = ad_CINECAM_MINSHIFT;		// Initial density
			self.cnt = ad_CINECAM_FADEUP;			// Fade direction
			self.state = ad_CINECAM_NEXTCAM;		// Next function
			ad_cam_active = ad_CINECAM_FADE;			// Start fade process
		}
		else ad_cam_active = ad_CINECAM_NEXTCAM;
	}
	
	//---------------------------------------------------------------------
	// Switch to next camera (player if last camera)
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_NEXTCAM) {
		// If fading IN active, update background colour before switch
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_FADEIN)
			ad_camera_controller_cshift(ad_cam_client, ad_cam_focus.pos1, ad_CINECAM_MAXSHIFT);

		// Check for end of camera chain functionality
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_ENDCAMERA)
			ad_cam_sequence = ad_CINECAM_SEQ_LAST;
		
		// Check for last camera (back to player)
		if (ad_cam_sequence == ad_CINECAM_SEQ_LAST) {
			// Restore hud (saved in startup section)
			cvar_set("viewsize", ftos(ad_cam_hudsize));
			cvar_set("crosshair", ftos(ad_cam_crosshair));
			
			// Hide fake player entity
			ad_cam_player.state = ad_FALSE;
			setmodel(ad_cam_player, ad_MODEL_EMPTY);
			setsize(ad_cam_player, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
			ad_cam_player.frame = 0;

			// Restore player core parameters
			setmodel (ad_cam_client, ad_MODEL_PLAYER);
			ad_modelindex_player = ad_cam_client.modelindex;
			setsize (ad_cam_client, ad_cam_client.ad_bbmins, ad_cam_client.ad_bbmaxs);
			ad_cam_client.solid = ad_SOLID_SLIDEBOX;
			ad_cam_client.movetype = ad_MOVETYPE_WALK;
		
			// Check for return location entity
			if (self.ad_attachment2) {
				// Read target entity (often has angle key)
				self.dest2 = self.ad_attachment2.origin;
				self.ad_dest3 = self.ad_attachment2.angles;
			}
			else {
				// read origin/angles from player
				self.dest2 = self.ad_pos4;
				self.ad_dest3 = self.ad_finaldest;
			}

			// Restore player origin/ofset parameters
			setorigin(ad_cam_client, self.dest2);
			ad_cam_client.view_ofs = self.ad_pos5;
			// Do not restore the player with velocity as it can lead
			// to some unexpected deaths and chance of being stuck
			// Better to zero velocity so that the player can adjust
			ad_cam_client.velocity = ad_cam_client.avelocity = '0 0 0';
			// Restore weapon/ammo HUD stuff
			ad_cam_client.weapon = self.weapon;
			ad_cam_client.currentammo = self.currentammo;
			ad_cam_client.weaponmodel = self.weaponmodel;
			ad_cam_client.weaponframe = self.weaponframe;

			// Update player angles
			ad_cam_angle = self.ad_dest3;
			ad_cam_client.angles = ad_cam_client.v_angle = ad_cam_angle;
			ad_cam_client.angles_z = 0;	// No drunk camera angles
			ad_cam_client.fixangle = ad_TRUE;
			
			// Let the player move around before the fade has finished
			// Otherwise it will feel like the controls are broken
			ad_cam_locked = ad_FALSE;
			ad_cam_movement = ad_FALSE;
			ad_cam_bezier = ad_FALSE;
		}
		else {
			// Switch to Next cinematic camera
			setorigin(ad_cam_client, ad_cam_focus.origin);
			ad_cam_client.view_ofs = ad_cam_focus.view_ofs;

			// Setup Camera angle blend fraction
			if (ad_cam_focus.ad_angleblend <= 0 || ad_cam_focus.ad_angleblend >= 1) 
				ad_cam_focus.ad_angleblend = ad_CINECAM_ANGLEBLEND;
			
			// Lock player viewing angle (done via PlayerPreThink)
			// Stops the player moving the cursor/head around
			ad_cam_locked = ad_TRUE;
			
			// Movement of Camera (Bezier)
			if (ad_cam_focus.ad_controltarget != "") {
				// search for Control Point entity (info_target)
				self.enemy = find(world, targetname, ad_cam_focus.ad_controltarget);
				// Need to know next camera location for bezier maths
				self.ad_oldenemy = find(world, targetname, ad_cam_focus.target);
				
				// Found a control AND next camera entity?
				// Must find both of these because of the math formula
				if (self.enemy && self.ad_oldenemy) {
					// Show movement tracking entity
					if (ad_developer > 0) {
						// Use the yellow diamond model
						setmodel(ad_cam_track, ad_MODEL_BROKEN);
						setsize(ad_cam_track, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
					}

					// Reset movement origin to starting position
					ad_cam_track.origin = ad_cam_focus.origin;
					
					// Is the time or movement is too small?
					if (ad_cam_focus.ad_waitmin3 <= 0.1 || self.enemy.origin == ad_cam_focus.origin) {
						// Move directly to movement location
						setorigin(ad_cam_client, ad_cam_focus.origin);
						ad_cam_movement = ad_FALSE;
					}
					else {
						// Setup camera tracking entity to start at client
						setorigin(ad_cam_track, ad_cam_focus.origin);
						ad_cam_track.angles = ad_cam_focus.angles;
						// Keep track of bezier curve start/control/end
						ad_cam_track.ad_pos4 = ad_cam_focus.origin;
						ad_cam_track.ad_pos5 = self.enemy.origin;
						ad_cam_track.ad_pos6 = self.ad_oldenemy.origin;
						ad_cam_track.wait = ad_cam_focus.ad_waitmin3;
						ad_cam_track.velocity = '0 0 0';
						
						// The exact position of where the camera should be on
						// the bezier curve can be calculated. Just need to move
						// the origin instead of relying on velocity movement
						ad_cam_track.ad_attack_finished = time + ad_cam_track.wait;
						ad_cam_track.think = ad_camera_tracking_finish;
						ad_cam_track.nextthink = time + ad_cam_track.wait;
						
						// Allow for updates (done via PlayerPreThink)
						ad_cam_movement = ad_TRUE;
						ad_cam_bezier = ad_TRUE;
					}
				}
			}
			// Movement of Camera (Linear)
			else if (ad_cam_focus.ad_sighttarget != "") {
				// search for target entity (info_target)
				self.enemy = find(world, targetname, ad_cam_focus.ad_sighttarget);
				
				// Found a target?
				if (self.enemy) {
					// Show movement tracking entity
					if (ad_developer > 0) {
						// Use the yellow diamond model
						setmodel(ad_cam_track, ad_MODEL_BROKEN);
						setsize(ad_cam_track, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
					}

					// Is the time or movement is too small?
					if (ad_cam_focus.ad_waitmin3 <= 0.1 || self.enemy.origin == ad_cam_focus.origin) {
						// Move directly to movement location
						setorigin(ad_cam_client, ad_cam_focus.origin);
						ad_cam_movement = ad_FALSE;
					}
					else {
						// Setup camera tracking entity to start at client
						setorigin(ad_cam_track, ad_cam_focus.origin);
						ad_cam_track.angles = ad_cam_focus.angles;
						// Keep track of direction target entity
						ad_cam_track.enemy = self.enemy;
						
						// Find out vector difference between two points
						ad_cam_track.pos1 = ad_cam_track.enemy.origin - ad_cam_focus.origin;
						// velocity = vector difference * traveltime (waitmin3)
						ad_cam_track.velocity = ad_cam_track.pos1 * (1 / ad_cam_focus.ad_waitmin3);
						
						// Setup switch off functionality
						// The camera tracking entity is set to noclip movetype
						// which means the velocity needs to be stopped otherwise
						// the entity will just keep moving forward
						ad_cam_track.ad_attack_finished = time + ad_cam_focus.ad_waitmin3;
						ad_cam_track.think = ad_camera_tracking_finish;
						ad_cam_track.nextthink = time + ad_cam_focus.ad_waitmin3;
						
						// Allow for updates (done via PlayerPreThink)
						ad_cam_movement = ad_TRUE;
						ad_cam_bezier = ad_FALSE;
					}
				}
			}
			
			// Has the camera angletarget been setup?
			if (ad_cam_fixangle != ad_CINECAM_FIXANGLE_DONE) {
				// Only update angles once per camera chain
				if (ad_cam_fixangle == ad_CINECAM_FIXANGLE_ACTIVE)
					ad_cam_fixangle = ad_CINECAM_FIXANGLE_DONE;
				
				// Check for any special angle target setup?
				if (ad_cam_focus.ad_angletarget != "") {
					// Find angle target of camera and return results
					// movetarget = angletarget entity
					// dest1 = angletarget.origin
					// movedir = vector movement direction
					ad_TargetMovedir(ad_cam_focus, ad_TRUE);
					// Angle target found?
					if (self.ad_movetarget) {
						// Convert direction vector to angles
						ad_cam_focus.angles = vectoangles(self.movedir);
						// Spawn a debug arrow if devmode (only once)
						if (!ad_cam_focus.ad_cam_debugarrow && !self.ad_nodebuginfo) {
							ad_spawn_arrow(ad_cam_focus.origin, ad_cam_focus.angles, 3);
							ad_cam_focus.ad_cam_debugarrow = ad_TRUE;
						}
						// Got to reverse the pitch angle because 
						// v_angle is upside down (special carmack code)
						ad_cam_focus.angles_x = -ad_cam_focus.angles_x;
					}
					// Cannot have a focalpoint if no angletarget
					else ad_cam_focus.ad_focalpoint = 0;

				}
				
				// Update camera from existing angles key
				ad_cam_angle = ad_cam_focus.angles;
			}
			
			// First camera? Hide player and HUD
			if (ad_cam_sequence == ad_CINECAM_SEQ_FIRST) {
				ad_cam_sequence = ad_CINECAM_SEQ_ACTIVE;	// Move forward in seq
				cvar_set("viewsize", "120");		// Hide HUD
				cvar_set("crosshair", "0");			// No crosshair
				// This is SUPER important, the entity has to have a model!
				// If this is blank, the engine will not update the entity
				// when moving around by the cinematic system
				setmodel(ad_cam_client, ad_MODEL_EMPTY);	// Empty model
				ad_cam_client.frame = 0;				// reset frame
				ad_cam_client.weaponmodel = "";		// Remove weapon
				ad_cam_client.weaponframe = 0;
				
				// Create fake player model for cinematics
				if (ad_cam_fakeplay) {
					// Check for fake player location
					if (self.ad_attachment) {
						// Read target entity (often has angle key)
						self.dest2 = self.ad_attachment.origin;
						self.ad_dest3 = self.ad_attachment.angles;
					}
					else {
						// read origin/angles from player
						self.dest2 = self.ad_pos4;
						self.ad_dest3 = self.finalangle;
					}
					
					ad_cam_player.solid = ad_SOLID_NOT;
					ad_cam_player.movetype = ad_MOVETYPE_NONE;
					setorigin(ad_cam_player, self.dest2);
					setmodel(ad_cam_player, ad_MODEL_PLAYER);
					setsize(ad_cam_player, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
					ad_cam_player.angles = self.ad_dest3;
					ad_cam_player.fixangle = ad_TRUE;
					// Setup animation loop
					ad_cam_player.state = ad_TRUE;
					ad_cam_player.ad_walkframe = ad_cam_player.frame = 12;
					ad_cam_player.think = ad_cam_player.ad_th_altstand;
					ad_cam_player.nextthink = time + 0.1;
				}
			}
		}
		
		// Check for any trigger events when viewing the camera
		// The screen can be solid background colour at this point
		// Anything could be spawned and would not be seen!
		// If the mapper wants stuff to trigger once, its best to
		// use wait = -1 on trigger_relays instead.
		//
		// Must use cam_seq check because can have single cam setup
		// Otherwise the triggers will be fired twice (camera exit)
		//
		if (ad_cam_sequence != ad_CINECAM_SEQ_LAST && ad_cam_focus.ad_target2 != "")
			ad_trigger_strs(ad_cam_focus.ad_target2, ad_cam_client);
		
		// Fade IN function
		ad_cam_active = ad_CINECAM_FADEIN;
	}
		
	//---------------------------------------------------------------------
	// Fade IN camera (player if last camera)
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_FADEIN) {
		// Check if fade IN is active (spawnflags)
		if (ad_cam_focus.spawnflags & ad_CINECAM_FUNC_FADEIN) {
			// Start fading player view out to solid colour
			// Work out cshift density steps
			self.lip = ad_CINECAM_MAXSHIFT / (ad_cam_focus.ad_waitmin2 / ad_CINECAM_CONTIME);
			ad_cam_colour = ad_cam_focus.pos2;	// Fade In background
			self.count = ad_CINECAM_MAXSHIFT;	// Initial density
			self.cnt = ad_CINECAM_FADEDOWN;	// Fade direction
			// Check for exit condition from cinematic system
			if (ad_cam_sequence == ad_CINECAM_SEQ_LAST) self.state = ad_CINECAM_EXIT;
			else self.state = ad_CINECAM_MESSAGE;	// Next function
			ad_cam_active = ad_CINECAM_FADE;		// Start fade process
		}
		// Skip over fade IN
		else {
			// Reset cshift, otherwise screen could be background colour
			ad_camera_controller_cshift(ad_cam_client, ad_cam_focus.pos2, ad_CINECAM_MINSHIFT);
			
			// Last camera in sequence?
			if (ad_cam_sequence == ad_CINECAM_SEQ_LAST) ad_cam_active = ad_CINECAM_EXIT; 
			else ad_cam_active = ad_CINECAM_MESSAGE;
		}
	}

	//---------------------------------------------------------------------
	// Exit and back to previous player position
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_EXIT) {
		// Let player be damaged again
		ad_cam_client.takedamage = ad_DAMAGE_AIM;
		// Clear keys so no esc/jump/shoot functions are triggered
		ad_camera_reset_buttons(ad_cam_client);
		// Make sure no weapon frame for 0.1s after cinematic
		ad_cam_client.ad_attack_finished = time + 0.1;
		// Restore air timer (>3s viewing camera and will get gasp sounds)
		ad_cam_client.ad_air_finished = time + ad_WATER_AIR;
		// Remove onground flag to make sure engine resets properly
		ad_cam_client.flags = ad_cam_client.flags - (ad_cam_client.flags & ad_FL_ONGROUND);
		// Finally switch off cinematic system
		ad_cinematic_running = ad_FALSE;
		ad_cam_active = ad_CINECAM_OFF;
		
		// Check for any exit/finished cinematic triggers
		if (self.ad_deathtarget != "")
			ad_trigger_strs(self.ad_deathtarget, ad_cam_client);

		// Make sure player animation restarts
		ad_cam_client.think = ad_player_stand1;
		ad_cam_client.nextthink = time + 0.1;
	}
	
	//---------------------------------------------------------------------
	// Main fade in/out loop for active camera
	//---------------------------------------------------------------------
	if (ad_cam_active == ad_CINECAM_FADE) {
		// Check for skip function
		ad_camera_check_skip(ad_cam_client);
		
		// Is cinematic skip done?
		if (ad_cam_exit == ad_CINECAM_SKIP_DONE) {
			// Setup max/min values to trigger end of fade
			if (self.cnt == ad_CINECAM_FADEUP) self.count = ad_CINECAM_MAXSHIFT;
			else self.count = ad_CINECAM_MINSHIFT;
		}
		// Increase/Decrease the screen density
		if (self.cnt == ad_CINECAM_FADEUP) self.count = self.count + self.lip;
		else self.count = self.count - self.lip;
		
		// Check for min/max values (exit condition)
		if (self.count >= ad_CINECAM_MAXSHIFT) {
			self.count = ad_CINECAM_MAXSHIFT;
			ad_cam_active = self.state;
		}
		else if (self.count <= ad_CINECAM_MINSHIFT) {
			self.count = ad_CINECAM_MINSHIFT;
			ad_cam_active = self.state;
		}

		// Update v_cshift
		ad_camera_controller_cshift(ad_cam_client, ad_cam_colour, self.count);
	}
};

//======================================================================
// When the fake player is displayed via the camera system
// This function keeps the model animated like the real player
//----------------------------------------------------------------------
void() ad_camera_player_animate =
{
	// Stop animating if disabled
	if (!self.state) return;
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 16) self.ad_walkframe = 12;
	self.frame = self.ad_walkframe;
	self.think = ad_camera_player_animate;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
// Check if the camera controller entity is setup and running
//----------------------------------------------------------------------
void() ad_camera_controller_setup = 
{
	// Does controller exist?
	if (!ad_cam_control) {
		// Default state is off
		ad_cam_active = ad_CINECAM_OFF;
		
		// The Controller
		ad_cam_control = spawn();					// Create an entity
		ad_cam_control.owner = self;				// Link back to client
		ad_cam_control.ad_classtype = ad_CT_CONTROL;
		ad_cam_control.solid = ad_SOLID_NOT;			// No world interaction
		ad_cam_control.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
		setorigin(ad_cam_control, '0 0 0');
		setmodel(ad_cam_control, ad_MODEL_EMPTY);
		setsize(ad_cam_control, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

		// Setup Fake Player Model
		// The player entity is moved around between camera's
		// For cinematics that require the player this placeholder
		// entity will create the illusion of the player
		ad_cam_player = spawn();
		ad_cam_player.state = ad_FALSE;
		ad_cam_player.solid = ad_SOLID_NOT;
		ad_cam_player.movetype = ad_MOVETYPE_NONE;
		setorigin(ad_cam_player, ad_cam_control.origin);
		setmodel(ad_cam_player, ad_MODEL_EMPTY);
		setsize(ad_cam_player, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_cam_player.angles = '0 0 0';
		ad_cam_player.view_ofs = '0 0 0';
		ad_cam_player.ad_th_altstand = ad_camera_player_animate;

		// Setup Camera Tracking entity
		// To prevent the player moving the camera while the cinematic
		// is active, a simple entity does the camera movement and
		// the player entity mirrors this origin instead
		ad_cam_track = spawn();
		ad_cam_track.owner = ad_cam_control;
		ad_cam_track.ad_classtype = ad_CT_CONTROL;
		ad_cam_track.solid = ad_SOLID_NOT;
		ad_cam_track.movetype = ad_MOVETYPE_FLY;
		setorigin(ad_cam_track, '0 0 0');
		setmodel(ad_cam_track, ad_MODEL_EMPTY);
		setsize(ad_cam_track, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_cam_track.velocity = '0 0 0';

		// Setup controller into loop
		ad_cam_control.think = ad_camera_controller_think;
		ad_cam_control.nextthink = time + ad_CINECAM_CONTIME;
	}
};

//======================================================================
/*ad:QUAKED misc_camera (1 0.5 0.5) (-16 -16 -16) (16 16 16) PLAYER SKIPABLE FADEOUT FADEIN FIXEDANGLE ENDCAMERA x x Not_Easy Not_Normal Not_Hard Not_DM
In game cinematic camera (Does not work in coop/dm mode)
-------- KEYS --------
targetname   : Camera name for linking into target chains
target       : Points to the next camera in a chain/sequence
angletarget  : Direction the camera will face (use info_target)
angles       : Direction the camera will face (Pitch Yaw Roll setup)
focalpoint   : Always focus the camera on angletarget (=1 enabled)
angleblend   : Blend between current/last camera angles (def=0.03 range=0-1)
target2      : Additional target(s) to trigger when camera VIEWED
deathtarget  : Additional target(s) to trigger when cinematic FINISHED
modeltarget  : Location of fake player mdl (use info_camera_destination)
returntarget : Location of returning player (use info_camera_destination)
pos1         : Camera starting BACKGROUND colour (R/G/B)
pos2         : Camara finishing BACKGROUND colour (R/G/B)
waitmin      : Fade OUT previous camera, time (def=1s, minimum=0.1s)
waitmin2     : Fade IN this camera, time (def=1s, minimum=0.1s)
waitmin3     : Speed at which camera moves towards sighttarget
sighttarget  : Position the camera will travel towards (use info_target)
controltarget: Bezier Curve control point (has angletarget defaults)
wait         : Time to wait while showing camera (-1 = wait for key)
message      : message to centerprint when camera is viewed
message2     : message to centerprint to client if coop is active
sounds       : 1=Secret,2=talk(def),3=switch,4=silent,5=custom,6=secret2
noise        : custom sound to play when messaged is centerprinted
nodebuginfo  : All debug info displayed via developer=1 is blocked
-------- SPAWNFLAGS --------
PLAYER       : Show the player model when starting cinematics
SKIPABLE     : Allow the cinematic to be skipped (exit after fade)
FADEOUT      : Fade OUT previous camera (time = waitmin)
FADEIN       : Fade IN this camera (time = waitmin2)
FIXEDANGLE   : All cameras in a chain will use the first camera angle
ENDCAMERA	 : Only the fade in/out work, the origin/angle are ignored
-------- NOTES --------
In game cinematic camera will fade/move based on times in seconds.
The first fade (out) is from previous camera to background colour.
The second fade (in) is to current camera view. The linear movement
will start at the same time as the fade in process.
Start -> Fade Out(waitmin1) -> Fade In(waitmin2) / Movement (waitmin3)
Once 'Fade in' has finshed then the pause timer (wait) starts.
Waitmin3 = Waitmin2 + Wait (Sync everything to finish together)
To sync the final camera to a player start, finish 22 map units above
angles = up/down, angle, tilt left/right 'pitch roll yaw'
up/left = negative value, down/right = positive value
deathtarget, modeltarget & returntarget have to be defined on first camera
Be aware that coop is not supported, so be careful of trigger events
and decide on a coop "not working" message2.

======================================================================*/
void() ad_misc_camera_use = 
{
	// Cannot use camera's during intermission
	if (ad_intermission_running > 0) return;
	// Stop if cinematic running already
	if (ad_cinematic_running > 0) return;
	
	// Find client first
	self.enemy = world;
	if (other.flags & ad_FL_CLIENT) self.enemy = other;
	else if (ad_activator.flags & ad_FL_CLIENT) self.enemy = ad_activator;
	
	// No player available or is dead?
	if (!self.enemy) return;
	if (self.enemy.health < 1) return;

	// Cinematics don't work with COOP, let the players know
	// There is a default message, but really this is something
	// the mapper should (override) setup on the first camera
	if (coop > 0) {
		ad_centerprint(self.enemy, self.ad_message2);
		// Default talk sound (using sounds entity key)
		sound (self.enemy, ad_CHAN_VOICE, self.noise, 1, ad_ATTN_NORM);
		return;
	}

	// Start camera controller
	ad_cam_focus = self;
	ad_cam_client = self.enemy;
	ad_cam_active = ad_CINECAM_SETUP;
};

//----------------------------------------------------------------------
float(float ad_cc_value) ad_misc_camera_colrange =
{
	// Make sure cshift colours are in range (0-255)
	if (ad_cc_value < 0) return 0;
	else if (ad_cc_value > ad_CINECAM_MAXSHIFT) return ad_CINECAM_MAXSHIFT;
	else return ad_cc_value;
};

//----------------------------------------------------------------------
void(vector ad_cc_check) ad_misc_camera_colcheck =
{
	// Make sure RBG colour ranges are correct
	ad_cc_check_x = ad_misc_camera_colrange(ad_cc_check_x);
	ad_cc_check_y = ad_misc_camera_colrange(ad_cc_check_y);
	ad_cc_check_z = ad_misc_camera_colrange(ad_cc_check_z);
};

//----------------------------------------------------------------------
void() ad_misc_camera =
{
	// Cinematics will not work in DM mode
	if (deathmatch) { remove(self); return; }
	
	// Setup up class and movetypes
	self.ad_classtype = ad_CT_MISCCAM;
	self.ad_estate = ad_ESTATE_ON;
	setsize (self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel(self, ad_MODEL_EMPTY);
	self.owner = self;

	// Precache any sounds for centerprint
	if (self.sounds < 1) self.sounds = 2;	// DEF=talktalk
	ad_trigger_bmodel_sounds();
	
	// Cannot have a fade IN/OUT timer less than 0.1s
	// The fade IN/OUT function is done via spawnflags
	if (self.waitmin < 0.1) self.waitmin = 1;
	if (self.ad_waitmin2 < 0.1) self.ad_waitmin2 = 1;
	// Check colour fade parameters are in range
	ad_misc_camera_colcheck(self.pos1);
	ad_misc_camera_colcheck(self.pos2);
	// Time to move (linear) towards sighttarget, no angle change
	if (self.ad_waitmin3 < 0.1) self.ad_waitmin3 = 2;
	// Default warning for cinematics and COOP mode
	if (self.ad_message2 == "") self.ad_message2 = "Cinematics don't work in COOP!\n";

	// Found bezier curve setup
	if (self.ad_controltarget != "") {
		// If no angle target setup, use next camera
		if (self.ad_angletarget == "") {
			self.ad_angletarget = self.target;
			// Focus on next camera instead
			self.ad_focalpoint = ad_TRUE;
		}
	}
	
	// Cannot have a focalpoint if no angletarget is defined
	if (self.ad_angletarget == "" && self.ad_focalpoint) {
		dprint("\b[MISC_CAM]\b No focalpoint entity defined!\n");
		self.ad_focalpoint = 0; 
	}
	
	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.use = ad_misc_camera_use;
	
	// Create camera controller
	ad_camera_controller_setup();
	
	// Check for bezier debug mode (display curves)
	// Can block debug info (start/control/end/arrows)
	if (self.ad_controltarget != "" && !self.ad_nodebuginfo) {
		self.think = ad_misc_camera_bezier_debug;
		self.nextthink = time + 0.2;
	}
};

/*======================================================================
 Write a config/text file
 
 * generates file in the DATA subdirectory under MOD folder
 * Uses currently loaded map file with _cam extension added
 * requires the FRIK file system extensions (advanced engine only)
 * requires advanced FTE string commands (included in QSS/DP as well)
 
 // Example use of sprintf
 string = sprintf("\"%s\" \"%s\"\n", entityfieldname(entno), getentityfieldstring(entno, self));

======================================================================*/
void(float ad_filehandle, string ad_entkey, string ad_entval) ad_misc_camera_str =
{
	local string ad_expstr;
	if (ad_entval == "") return;
	ad_expstr = ad_strcat("\"", ad_entkey, "\" \"", ad_entval, "\"\n");
	ad_fputs(ad_filehandle, ad_expstr);
};

//----------------------------------------------------------------------
void(float ad_filehandle, string ad_entkey, float ad_entval) ad_misc_camera_float =
{
	if (ad_entval == 0) return;
	ad_misc_camera_str(ad_filehandle, ad_entkey, ftos(ad_entval));
};

//----------------------------------------------------------------------
void(float ad_filehandle, string ad_entkey, vector ad_entval) ad_misc_camera_vec =
{
	local string ad_expstr;
	if (ad_CheckZeroVector(ad_entval) == ad_TRUE) return;
	ad_expstr = ad_strcat(ftos(ad_entval_x), " ", ftos(ad_entval_y), " ", ftos(ad_entval_z));
	ad_misc_camera_str(ad_filehandle, ad_entkey, ad_expstr);
};

//----------------------------------------------------------------------
void() ad_misc_camera_filewrite =
{
	local string ad_camfile;
	local entity ad_cament;
	local float ad_camfilelen, ad_charpos, ad_camfh;

	// Check for advanced engine support
	if (!ad_ext_active) return;		// Check for advanced engines
	if (!ad_ext_frikfile) return;		// Check for Frik file system
	if (!ad_ext_ftestrings) return;	// Check for advanced string functions
	//if (!ext_sprintf) return;		// Check for C code sprintf exposure
	if (world.model == "") return;	// Check for map name
	
	// Find out current map name
	ad_camfile = world.model;
	ad_camfilelen = strlen(ad_camfile);
	// Search at beginning for directory prefix
	ad_charpos = strstrofs(ad_camfile, "/", 0);
	// Any prefix detected? (Cut directory)
	if (ad_charpos > 0) ad_camfile = substring(ad_camfile, ad_charpos+1, ad_camfilelen);

	// Search for .bsp extension
	ad_camfilelen = strlen(ad_camfile);
	ad_charpos = strstrofs(ad_camfile, ".", 0);
	// Any model (.bsp) extensions? (Cut it!)
	if (ad_charpos > 0) ad_camfile = substring(ad_camfile, 0, ad_charpos);

	// Add new file extension and file type
	ad_camfile = ad_strcat(ad_camfile, "_cam.txt");
	// Open new (overwrite) file ready for export
	ad_camfh = ad_fopen(ad_camfile, ad_FILE_WRITE);

	// Search for any misc_camera entities
	ad_cament = find(world, classname, "misc_camera");
	while(ad_cament) {
		// Open entity definition
		ad_fputs(ad_camfh, "{\n");
		// Write all relevant fields to file
		ad_misc_camera_str(ad_camfh, "classname", ad_cament.classname);
		ad_misc_camera_vec(ad_camfh, "origin", ad_cament.origin);
		ad_misc_camera_float(ad_camfh, "spawnflags", ad_cament.spawnflags);
		ad_misc_camera_str(ad_camfh, "targetname", ad_cament.targetname);
		ad_misc_camera_str(ad_camfh, "target", ad_cament.target);
		ad_misc_camera_str(ad_camfh, "angletarget", ad_cament.ad_angletarget);
		ad_misc_camera_vec(ad_camfh, "angles", ad_cament.angles);
		ad_misc_camera_float(ad_camfh, "focalpoint", ad_cament.ad_focalpoint);
		ad_misc_camera_float(ad_camfh, "angleblend", ad_cament.ad_angleblend);
		ad_misc_camera_str(ad_camfh, "target2", ad_cament.ad_target2);
		ad_misc_camera_str(ad_camfh, "deathtarget", ad_cament.ad_deathtarget);
		ad_misc_camera_str(ad_camfh, "modeltarget", ad_cament.ad_modeltarget);
		ad_misc_camera_str(ad_camfh, "returntarget", ad_cament.ad_returntarget);
		ad_misc_camera_vec(ad_camfh, "pos1", ad_cament.pos1);
		ad_misc_camera_vec(ad_camfh, "pos2", ad_cament.pos2);
		ad_misc_camera_float(ad_camfh, "waitmin", ad_cament.waitmin);
		ad_misc_camera_float(ad_camfh, "waitmin2", ad_cament.ad_waitmin2);
		ad_misc_camera_float(ad_camfh, "waitmin3", ad_cament.ad_waitmin3);
		ad_misc_camera_str(ad_camfh, "sighttarget", ad_cament.ad_sighttarget);
		ad_misc_camera_str(ad_camfh, "controltarget", ad_cament.ad_controltarget);
		ad_misc_camera_float(ad_camfh, "wait", ad_cament.wait);
		ad_misc_camera_str(ad_camfh, "message", ad_cament.message);
		ad_misc_camera_str(ad_camfh, "message2", ad_cament.ad_message2);
		ad_misc_camera_float(ad_camfh, "sounds", ad_cament.sounds);
		ad_misc_camera_str(ad_camfh, "noise", ad_cament.noise);
		ad_misc_camera_float(ad_camfh, "nodebuginfo", ad_cament.ad_nodebuginfo);
		
		// Extra fields that could be generated
		ad_misc_camera_float(ad_camfh, "classtype", ad_cament.ad_classtype);
		ad_misc_camera_float(ad_camfh, "estate", ad_cament.ad_estate);
		ad_misc_camera_str(ad_camfh, "model", ad_cament.model);
		ad_misc_camera_vec(ad_camfh, "absmin", ad_cament.absmin);
		ad_misc_camera_vec(ad_camfh, "absmax", ad_cament.absmax);
		ad_misc_camera_vec(ad_camfh, "mins", ad_cament.mins);
		ad_misc_camera_vec(ad_camfh, "maxs", ad_cament.maxs);
		ad_misc_camera_vec(ad_camfh, "size", ad_cament.size);
		ad_misc_camera_str(ad_camfh, "noise", ad_cament.noise);
		ad_misc_camera_float(ad_camfh, "volume", ad_cament.volume);
		// This is a void() not a string
		//misc_camera_str(camfh, "use", cament.use);
		
		// Close entity definition
		ad_fputs(ad_camfh, "}\n");
		// Next camera entity
		ad_cament = find(ad_cament, classname, "misc_camera");
	}
	
	// Close file
	ad_fclose(ad_camfh);
};


