// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_lostsoul.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
LOST SOUL
==============================================================================*/

// moving jaw up and down (talking)
$frame idle1 idle2 idle3 idle4 idle5 idle6

// Tilt head backwards to look up
$frame idleB1 idleB2 idleB3 idleB4 idleB5 idleB6

// Tilt head downwards to look below
$frame idleF1 idleF2 idleF3 idleF4 idleF5 idleF6

// Keep looking left or right
$frame idleleft1 idleleft2 idleleft3 idleleft4 idleleft5 idleleft6
$frame idleright1 idleright2 idleright3 idleright4 idleright5 idleright6

// Turn head left or right 30 degrees
$frame idleturnl1 idleturnl2 idleturnl3 idleturnl4 idleturnl5 idleturnl6
$frame idleturnr1 idleturnr2 idleturnr3 idleturnr4 idleturnr5 idleturnr6

// mouth wide open and head tilted back
$frame charge1 charge2 charge3 charge4 charge5 charge6

// obvious chewing motion
$frame chew1 chew2 chew3 chew4 chew5 chew6

// mouth open and rotated Backward or Forward
$frame pain1 pain2 pain3 pain4 pain5 pain6
$frame pain7 pain8 pain9 pain10 pain11 pain12

// Spawning from nothing
$frame grow1 grow2 grow3 grow4 grow5 grow6 grow7 grow8 grow9 grow10

float ad_LOST_IDLE = 0;		// Default state
float ad_LOST_IDLEB = 1;		// Looking UP
float ad_LOST_IDLEF = 2;		// Looking DOWN
float ad_LOST_IDLELEFT = 3;	// Looking left
float ad_LOST_IDLERIGHT = 4;	// Looking right
float ad_LOST_TURNLEFT = 5;	// Turning left (not looped)
float ad_LOST_TURNRIGHT = 6;	// Turning right (not looped)
float ad_LOST_CHARGE = 7;		// Mouth wide open and charging
float ad_LOST_MELEE = 8;		// Mouth chomping open/close
float ad_LOST_PAINB = 9;		// Roll backwards
float ad_LOST_PAINF = 10;		// Roll forward

// Size of each animation block
float ad_LOST_ANIMBLOCK = 6;

// Different states and fire particle quantity
float ad_LOST_STATE_STAND = 2;
float ad_LOST_STATE_WALK = 4;
float ad_LOST_STATE_GUARD = 3;
float ad_LOST_STATE_RUN = 5;
float ad_LOST_STATE_PAIN = 6;

//======================================================================
// Update Lost Souls every frame with velocity movements and glow eyes!
// fstate (see above for animation block details)
//======================================================================
void(float ad_fstate) ad_lost_update = 
{
	// If Lost is dead, no more updates
	if (self.health < 1) return;

	// Time for an idle sound? (run only)
	if (self.ad_idletimer < time && self.state == ad_LOST_STATE_RUN) 
		ad_monster_idle_sound();

	// Update glowing eyes! (skin types = 0,1,2,3,2,1)
	if (self.t_length < time) {
		// fire particle quantity linked to AI state
		ad_particle_explode(self.origin+'0 0 12', self.state, 1, ad_PARTICLE_BURST_YELLOW, ad_PARTICLE_BURST_LOSTUP);
		self.t_length = time + 0.2;
		self.ad_exactskin = self.ad_exactskin + 1;
		if (self.ad_exactskin > 5) self.ad_exactskin = 0;
		self.skin = self.ad_exactskin;
	}

	// While standing still or guarding, gently float up and down
	if (self.state == ad_LOST_STATE_STAND || self.state == ad_LOST_STATE_GUARD) {
		// While standing around idle, gently move up and down
		// using velocity, forced origin movement is really jerky!
		if (self.velocity_x == 0 && self.velocity_y == 0) {
			if (self.ad_attack_timer < time) {
				self.ad_attack_timer = time + 1;
				if (self.lip < 1) self.lip = 1;
				else self.lip = -1;
				self.velocity_z = 2 * self.lip;
			}
		}
		else {
			// Slowdown the velocity (movement = no friction)
			self.velocity = self.velocity * self.ad_velocityfriction;
			if (self.velocity_x > -5 && self.velocity_x < 5) self.velocity_x = 0;
			if (self.velocity_y > -5 && self.velocity_y < 5) self.velocity_y = 0;
			if (self.velocity_z > -5 && self.velocity_z < 5) self.velocity_z = 0;
		}
	}

	// Lost sight of enemy during combat, wait and look around
	if (self.state == ad_LOST_STATE_GUARD) {
		if (self.ad_meleeattack < time) {
			self.ad_meleeattack = time + 4 + (random() + random() + random() * 4);
			if (random() < 0.5) self.lefty = 1;
			else self.lefty = -1;
			self.avelocity = '0 0 0';
			self.avelocity_y = self.lefty*50;
			self.ad_attack_sidestep = 0;
			self.ad_attack_sidedeny = rint(4 + random()*4);
		}
		
		// Keep increasing rotation angle velocity
		self.ad_attack_sidestep = self.ad_attack_sidestep + 1;
		if (self.ad_attack_sidestep > self.ad_attack_sidedeny) self.avelocity = '0 0 0';
		else self.avelocity_y = self.avelocity_y * 1.25;
		
		// Check lost idle timer after combat
		if (self.ad_lostenemy && self.ad_losttimer < time) {
			self.ad_losttimer = ad_LARGE_TIMER;
			if (self.ad_lostenemy.health < 0) self.ad_lostenemy = world;
			else {
				// Restore previous enemy and start hunting
				self.enemy = self.ad_lostenemy;
				self.think = self.ad_th_run;
				self.state = ad_LOST_STATE_RUN;
				// Setup goals and DO NOT warn other monsters
				ad_FoundHuntTarget(ad_FALSE);
			}
		}
	}
		
	// Work through all the different AI states
	if (self.state == ad_LOST_STATE_STAND || self.state == ad_LOST_STATE_WALK) {
		// At beginning of frame block and reversing?
		if (self.count == 0 && self.ad_idlereverse) {
			if (self.ad_idlebusy == ad_LOST_TURNLEFT || self.ad_idlebusy == ad_LOST_TURNRIGHT) {
				self.ad_idlebusy = ad_LOST_IDLE;
				self.ad_idlereverse = ad_FALSE;
				self.waitmin = time + 2 + random() * 4;
			}
		}
		// At end of frame block and going forward?
		else if (self.count == ad_LOST_ANIMBLOCK-1 && !self.ad_idlereverse) {
			// Always reset turn left/right animation while walking
			if (self.state == ad_LOST_STATE_WALK) {
				if (self.ad_idlebusy == ad_LOST_IDLELEFT) {
					self.ad_idlebusy = ad_LOST_TURNLEFT;
					self.ad_idlereverse = ad_TRUE;
				}
				else if (self.ad_idlebusy == ad_LOST_IDLERIGHT) {
					self.ad_idlebusy = ad_LOST_TURNRIGHT;
					self.ad_idlereverse = ad_TRUE;
				}
				// Return from all other idle animations
				else {
					self.ad_idlebusy = ad_LOST_IDLE;
					self.waitmin = time + 2 + random() * 4;
				}
			}
			// Idle animation designed for standing around
			else {
				if (self.ad_idlebusy == ad_LOST_IDLE && self.waitmin < time) {
					// Randonly pick an idle animation (difference stand/walk)
					self.lip = random();
					if (self.lip < 0.4) self.ad_idlebusy = ad_LOST_TURNLEFT;
					else if (self.lip < 0.6) self.ad_idlebusy = ad_LOST_TURNRIGHT;
					else if (self.lip < 0.8) self.ad_idlebusy = ad_LOST_IDLEB;
					else self.ad_idlebusy = ad_LOST_IDLEF;
				}
				// Return from opening/closing mouth idle animations
				else if (self.ad_idlebusy == ad_LOST_IDLEB || self.ad_idlebusy == ad_LOST_IDLEF) {
					self.ad_idlebusy = ad_LOST_IDLE;
					self.waitmin = time + 2 + random() * 4;
				}
				// Turning head left direction
				else if (self.ad_idlebusy == ad_LOST_TURNLEFT) {
					self.ad_idlebusy = ad_LOST_IDLELEFT;
					self.waitmin = time + 2 + random() * 4;
				}
				// Turning head right direction
				else if (self.ad_idlebusy == ad_LOST_TURNRIGHT) {
					self.ad_idlebusy = ad_LOST_IDLERIGHT;
					self.waitmin = time + 2 + random() * 4;
				}
				// Looking left and randomly think about returning
				else if (self.ad_idlebusy == ad_LOST_IDLELEFT) {
					if (self.waitmin < time && random() < 0.5) {
						self.ad_idlebusy = ad_LOST_TURNLEFT;
						self.ad_idlereverse = ad_TRUE;
					}
				}
				// Looking right and randomly think about returning
				else if (self.ad_idlebusy == ad_LOST_IDLERIGHT) {
					if (self.waitmin < time && random() < 0.5) {
						self.ad_idlebusy = ad_LOST_TURNRIGHT;
						self.ad_idlereverse = ad_TRUE;
					}
				}
			}
		}
	}
	else {
		// All other states (RUN, PAIN, GUARD)
		// Reset any previous idle animations
		self.ad_idlereverse = ad_FALSE;
		self.ad_idlebusy = ad_FALSE;
	}
	
	// Check frame direction and update counter
	if (self.ad_idlereverse) self.count = self.count - 1;
	else self.count = self.count + 1;
	if (self.count >= ad_LOST_ANIMBLOCK) self.count = 0;
	if (self.count < 0) self.count = ad_LOST_ANIMBLOCK-1;
	
	// Busy with an idle animation?
	if (self.ad_idlebusy > 0) ad_fstate = self.ad_idlebusy;
	// Update frame animation block with frame counter
	self.frame = ad_fstate * ad_LOST_ANIMBLOCK + self.count;
	// Store current origin position
	self.oldorigin = self.origin;
};	

//----------------------------------------------------------------------------
void() ad_lost_flymode =
{
	self.solid = ad_SOLID_SLIDEBOX;	// Reset just in case
	self.movetype = ad_MOVETYPE_FLY;	// Turn body into projectile
	// make sure onground is not set, cannot use velocity otherwise
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
};

//----------------------------------------------------------------------------
void() ad_lost_stepmode =
{
	self.velocity = '0 0 0';			// Back to regular movement
	self.avelocity = '0 0 0';			// Cancel any rotation velocity
	self.angles_x = self.angles_z = 0;	// Reset any X/Y angles
	self.solid = ad_SOLID_SLIDEBOX;		// Always reset
	self.movetype = ad_MOVETYPE_STEP;		// Back to discreet movement
};

//======================================================================
// All stand, walk and run functions are condensed down to one entry
// so that the lost souls can move dynamic and have skin updates
//
void()	ad_lost_stand1 = [ $idle1, ad_lost_stand1 ] {
	if (self.state != ad_LOST_STATE_GUARD) self.state = ad_LOST_STATE_STAND;	
	ad_lost_flymode();				// allow velocity updates
	ad_lost_update(ad_LOST_IDLE);		// Update skin + velocity
	ad_ai_stand();
};
void()	ad_lost_guard1 = { self.state = ad_LOST_STATE_GUARD; ad_lost_stand1(); };

void()	ad_lost_walk1 = [ $idle1, ad_lost_walk1 ] {
	self.state = ad_LOST_STATE_WALK;
	ad_lost_stepmode();			// back to discreet step mode
	ad_lost_update(ad_LOST_IDLE); 	// Update skin
	ad_ai_walk(8);
};
void()	ad_lost_run1 = [ $idle1, ad_lost_run1 ] {
	self.state = ad_LOST_STATE_RUN;
	ad_lost_stepmode();			// back to discreet step mode
	ad_lost_update(ad_LOST_IDLE);		// Update skin
	ad_ai_run(8);
};

//============================================================================
// Range Charge attack
//============================================================================
void() ad_lost_charge_touch =
{
	// Stop anymore touching
	self.touch = ad_SUB_Null;
	self.think = self.ad_th_run;
	
	// Do not damage other souls with charge attacks
	// Prevents packs from killing themselves
	if (self.ad_classtype != other.ad_classtype && other.takedamage) {
		ad_T_Damage (other, self, self, ad_DAMAGE_LOSTCHARGE, ad_DAMARMOR);
		ad_spawn_touchblood (self, other, ad_DAMAGE_LOSTCHARGE*3);

		// If touched a player, nudge them backwards
		if (other.flags & ad_FL_CLIENT) {
			self.ad_lostsearch = ad_FALSE;
			makevectors (self.angles);
			other.velocity = other.velocity + (v_forward * 200 + '0 0 50');
		}
	}
};

//----------------------------------------------------------------------------
void()	ad_lost_charge1 =
{
	// Play hiss sound, sighted enemy, charging
	sound (self, ad_CHAN_WEAPON, "lostsoul/charge.wav", 1, ad_ATTN_NORM);	
	
	self.count = 0;				// reset start of animation block
	ad_lost_flymode();				// allow velocity updates
	ad_lost_update(ad_LOST_CHARGE);	// Update skin
	// Stop tracking if easy/normal skill 
	if (ad_skill < ad_SKILL_HARD) self.ad_lostsearch = ad_FALSE;

	self.cnt = 0;									// reset speed updates
	self.ad_attack_speed = ad_SPEED_LOSTSTART;			// Initial speed
	self.pos1 = ad_SUB_orgEnemyTarget() + '0 0 12';	// Aim towards head
	self.pos2 = normalize(self.pos1 - self.origin);	// Vector direction
	self.touch = ad_lost_charge_touch;					// Damage/end function
	self.velocity = self.pos2 * self.ad_attack_speed;	// Launch body missile!
	self.angles = vectoangles(self.velocity);		// Turn straight away
	
	self.think = self.ad_th_charge;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_lost_charge2 =
{
	if (self.health < 1) return;
	ad_lost_update(ad_LOST_CHARGE);
	self.nextthink = time + 0.1;
	
	self.cnt = self.cnt + 1;						// speed updates
	if (self.cnt > 12) self.think = self.ad_th_run;	// End of charge attack
	// Keep travelling forward regardless of enemy
	else {
		// Keep increasing speed every 0.1s (check for max speed)
		if (self.ad_attack_speed < ad_SPEED_LOSTMAX)
			self.ad_attack_speed = self.ad_attack_speed + ad_SPEED_LOSTCHARGE;
		self.velocity = self.pos2 * self.ad_attack_speed;
		self.think = self.ad_th_charge;
	}
};

//======================================================================
// MELEE ATTACK - Biting
//======================================================================
void() ad_lost_bite =
{
	local float ad_ldmg;
	local entity ad_enemy_targ;
	
	ad_enemy_targ = ad_SUB_entEnemyTarget();

	if (!ad_enemy_targ) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);							// Get closer for extra bite
	ad_ai_damagebreakable(10);					// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEELOSTSOUL,ad_FALSE) && VR_MeleeArc_Hits(FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (ad_enemy_targ.takedamage < 1) return;

	sound (self, ad_CHAN_WEAPON, "lostsoul/bite.wav", 1, ad_ATTN_NORM);

	// Lost Soul bite is very weak
	ad_ldmg = (random() + random() + random()) * 3;
	ad_T_Damage (ad_enemy_targ, self, self, ad_ldmg, ad_DAMARMOR);

	// Check for poisonous attribute (new poison version)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);

	// Spawn blood at mouth of Lost Soul
	ad_spawn_touchblood (self, ad_enemy_targ, ad_ldmg*3);
};

//----------------------------------------------------------------------------
void() ad_lost_melee2 = 
{
	if (self.health < 1) return;
	ad_lost_update(ad_LOST_MELEE);	// Update skin
	self.cnt = self.cnt + 1;	// Next frame
	
	// Check for bite attack
	if (self.cnt == 3) ad_lost_bite();

	// End of melee attack?
	if (self.cnt >= 5) {
		// One chop of the jaws and then fly away time
		self.think = self.ad_th_run;
		
		// Check if enemy is still within range for another chop!
//		if (ai_checkmelee(MONAI_MELEELOSTSOUL,FALSE) && SUB_healthEnemyTarget() > 0)
//			self.think = self.th_melee;
//		else self.think = self.th_run;
	}
	else self.think = ad_lost_melee2;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_lost_melee1 =
{
	self.count = 0;				// reset start of animation block
	self.cnt = 0;				// Reset bite frame counter
	ad_lost_flymode();				// stay in flymode just in case collison probs
	ad_lost_update(ad_LOST_MELEE);	// Update skin

	self.think = ad_lost_melee2;
	self.nextthink = time + 0.1;
};

//======================================================================
// MINION - Grow and spin up from nothing
//======================================================================
void() ad_lost_growangle = {self.angles_y = self.angles_y + self.lefty;};
void() ad_lost_grow1 = [ $grow1, ad_lost_grow2 ] {};
void() ad_lost_grow2 = [ $grow2, ad_lost_grow3 ] {ad_lost_growangle();};
void() ad_lost_grow3 = [ $grow3, ad_lost_grow4 ] {ad_lost_growangle();};
void() ad_lost_grow4 = [ $grow4, ad_lost_grow5 ] {ad_lost_growangle();};
void() ad_lost_grow5 = [ $grow5, ad_lost_grow6 ] {ad_lost_growangle();};
void() ad_lost_grow6 = [ $grow6, ad_lost_grow7 ] {ad_lost_growangle();};
void() ad_lost_grow7 = [ $grow7, ad_lost_grow8 ] {ad_lost_growangle();};
void() ad_lost_grow8 = [ $grow8, ad_lost_grow9 ] {ad_lost_growangle();};
void() ad_lost_grow9 = [ $grow9, ad_lost_grow10] {ad_lost_growangle();};
void() ad_lost_grow10= [ $grow10, ad_lost_run1 ] {
	// Is the lost stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		self.state = ad_LOST_STATE_RUN;
		self.count = 0;
		ad_lost_update(ad_LOST_IDLE);		// Update skin

		// Finally spin back to original position
		self.angles_y = self.angles_y + self.lefty;
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);

		// Restore all think state functions
		self.ad_th_stand = ad_lost_stand1;
		self.ad_th_altstand = ad_lost_guard1;
		self.ad_th_walk = ad_lost_walk1;
		self.ad_th_run = ad_lost_run1;
		self.ad_th_melee = ad_lost_melee1;
		self.ad_th_missile = ad_lost_charge1;
		self.ad_th_charge = ad_lost_charge2;
		
		// Start charging at player if not dead and got an enemy
		if (self.health > 0 && self.enemy) {
			ad_ai_face();
			self.think = self.ad_th_missile;
		}
	}
};

//----------------------------------------------------------------------------
void() ad_lost_grow =
{
	// Only call wakeup function once
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run  = ad_SUB_Null;
	if (random() < 0.5) self.lefty = 36;
	else self.lefty = -36;
	ad_monster_sightsound();
	ad_lost_stepmode();
	ad_lost_grow1();
};

//============================================================================
// PAIN in the head!
//============================================================================
void() ad_lost_inpain =
{
	// Update pain frame
	ad_lost_update(self.ad_attack_rage);
	
	// Next pain animation
	self.ad_inpain = self.ad_inpain + 1;
	if (self.ad_inpain >= 5) self.think = self.ad_th_run;
	else self.think = ad_lost_inpain;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_lost_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	if (self.state != ad_LOST_STATE_PAIN) {
		// Stop all velocity and reset movetype
		ad_lost_stepmode();
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	}

	// Work out which direction the damage came from (enemy)
	if (ad_infront(ad_attacker)) self.ad_attack_rage = ad_LOST_PAINB;	// Hit from infront
	else self.ad_attack_rage = ad_LOST_PAINF;						// Hit from behind
	
	self.state = ad_LOST_STATE_PAIN;
	// Reset pain and current frame counter
	self.ad_inpain = self.count = 0;
	// Always do pain, no flinch
	ad_lost_inpain();
};

//============================================================================
void() ad_lost_die1 = [ $pain1, ad_lost_die2 ] {};
void() ad_lost_die2 = [ $pain2, ad_lost_die2 ] {
	// Lost souls explode when they die
	ad_T_RadiusDamage (self, self, ad_DAMAGE_LOSTSOUL, world, ad_DAMAGEALL);
	if (random() < 0.5) self.lip = ad_EXPLODE_SMALL;
	else if (random() < 0.9) self.lip = ad_EXPLODE_MED;
	else self.lip = ad_EXPLODE_BIG;
	ad_SpawnExplosion(self.lip, self.origin, "lostsoul/death.wav");
	// Goto final resting place
	ad_entity_remove(self, 0.1);
};

//----------------------------------------------------------------------
void() ad_lost_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Make sure body does not drop to the ground
	self.flags = self.flags | ad_FL_FLY;
	self.takedamage = ad_DAMAGE_NO;
	ad_lost_die1();
};

/*======================================================================
QUAKED monster_lostsoul (1 0.2 0) (-16 -16 -24) (16 16 24)
======================================================================*/
void() ad_setup_lostsoul;
void() ad_monster_lostsoul =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_lostsoul.mdl";
	precache_model (self.mdl);

	self.ad_idle_sound = "lostsoul/idle1.wav";
	self.ad_idle_sound2 = "lostsoul/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	
	precache_sound ("lostsoul/charge.wav");		// charge hiss/scream
	precache_sound ("lostsoul/bite.wav");		// chomp with teeth

	self.ad_pain_sound = "lostsoul/pain1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound ("lostsoul/death.wav");
	
	// Cache lost soul is a special class used for precache only
	if (self.ad_classtype != ad_CT_CACHELOSTSOUL) ad_setup_lostsoul();
};

//----------------------------------------------------------------------------
void() ad_monster_skullwizminion = { 
	self.ad_classtype = ad_CT_CACHELOSTSOUL; 
	ad_monster_lostsoul();
};

//----------------------------------------------------------------------------
void() ad_setup_lostsoul =
{
	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	if (self.health < 1) self.health = 30;
	self.yaw_speed = 35;			// Really fast at turning
	self.ad_gibhealth = ad_MON_NEVERGIB;	// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_flinch = 10;			// Always go into pain
	self.ad_blockudeath = ad_TRUE;		// no humanoid death sound
	self.ad_steptype = ad_FS_FLYING;		// Silent feet
	self.ad_pain_longanim = ad_FALSE;		// No long pain animation
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	self.ad_meleeattack = time + 4;	// no rotation at spawn
	self.mangle = self.angles;		// idle rotate left/right
	self.ad_idlebusy = 0;				// Tilt/turn head animations
	self.ad_idlereverse = ad_FALSE;		// Reverse direction for idle
	if (self.ad_velocityfriction <= 0) self.ad_velocityfriction = 0.8 + (random() * 0.1);
	self.ad_exactskin = rint(random()*5);	// Randomize eye glow
	self.ad_lostenemy = world;				// Setup old enemy
	self.ad_losttimer = ad_LARGE_TIMER;		// Stop lost timer
	self.ad_lostsearch = ad_FALSE;			// Not searching for an enemy
	self.ad_deathstring = " was found by a Lost Soul\n";
	
	// I can understand lost souls being the perfect candidate for
	// poison attacks, but they are tricky already! default = disabled.
	self.ad_poisonous = ad_FALSE;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_LostCheckAttack;
	self.ad_th_pain = ad_lost_pain;
	self.ad_th_die = ad_lost_die;
	
	//----------------------------------------------------------------------
	// Special spawning minion need to start spinning
	if (self.ad_classtype == ad_CT_MINIONLOSTSOUL) {
		self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_lost_grow;
		self.ad_th_missile = ad_SUB_Null;
	}
	//----------------------------------------------------------------------
	// Default lost soul setup
	else {
		self.ad_th_stand = ad_lost_stand1;
		self.ad_th_altstand = ad_lost_guard1;
		self.ad_th_walk = ad_lost_walk1;
		self.ad_th_run = ad_lost_run1;
		self.ad_th_melee = ad_lost_melee1;
		self.ad_th_missile = ad_lost_charge1;
		self.ad_th_charge = ad_lost_charge2;
	}
		
	self.ad_classtype = ad_CT_MONLOSTSOUL;
	self.ad_classgroup = ad_CG_WIZARD;
	self.ad_classmove = ad_MON_MOVEFLY;

	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn lost souls (requires monster_skullwizminion entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_lostsoul =
{
	local entity ad_minion;

	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	// Self = skull wizard, there is no egg 
	ad_update_minioncount(self, 1);			// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_lostsoul";	// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self;					// Spawner Parent Link
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_classtype = ad_CT_MINIONLOSTSOUL;	// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.spawnflags = 0;
	ad_minion.ad_classgroup = ad_CG_WIZARD;			// Don't turn on master
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	ad_minion.mdl = "progs/mon_lostsoul.mdl";

	ad_minion.ad_pain_sound = "lostsoul/pain1.wav";
	ad_minion.ad_idle_sound = "lostsoul/idle1.wav";
	ad_minion.ad_idle_sound2 = "lostsoul/idle2.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_lostsoul;
};
