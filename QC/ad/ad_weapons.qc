/*======================================================================
 Weapon ammo run out and switching to next best weapon
======================================================================*/
void(float ad_wait_time) ad_forceweaponswitch =
{
	local float ad_nextweap;
	
	// has the player run out of ammo? work out next best weapon
	ad_nextweap = ad_W_BestWeapon (self);
	// Does the player need to switch weapons?
	if (self.weapon != ad_nextweap) {
		self.weapon = ad_nextweap;
		ad_W_SetCurrentAmmo (self);
	}
};

/*======================================================================
 W_FireAxe
======================================================================*/
void() ad_W_FireAxe =
{
	local vector ad_source, ad_org, ad_vec;
	local float ad_src_dist, ad_dotprod, ad_axedmg;
	local entity ad_onflr;

	makevectors (self.v_angle);				// Player forward angle
	ad_source = self.origin + '0 0 16';		// Move source point up body

	if (self.flags & ad_FL_GODMODE && self.flags & ad_FL_NOTARGET) {
		traceline (ad_source, ad_source + (v_forward* ad_RANGE_PLAYAXE), ad_FALSE, self);
		if (trace_fraction < 1.0) {
			if (trace_ent.flags & ad_FL_MONSTER && trace_ent.health > 0) {
				dprint("\n\b[DEBUG]\b system active, changing monster\n");
				trace_ent.ad_debuglvl = 1 - trace_ent.ad_debuglvl;
			}
		}
		return;
	}		 

	if (self.ad_moditems & ad_IT_UPGRADE_AXE) {
		// See if there are any bodies lying around
		ad_onflr = find(world, ad_bodyonflr, ad_MON_ONFLR);
		while (ad_onflr) {
			ad_src_dist = vlen(ad_source - ad_onflr.origin);
			if (ad_src_dist < ad_RANGE_CHOPAXE) {			// Is the body close to the player?
				ad_org = ad_onflr.origin - '0 0 16';		// move origin close to floor
				makevectors (self.v_angle);			// Calculate viewing angle
				ad_vec = normalize (ad_org - self.origin);
				ad_dotprod = ad_vec * v_forward;
				if (ad_dotprod > 0.6) {				// Is the body infront of the player
					ad_onflr.origin = ad_org;				// Move gib closer to floor
					// Now a function in ai_gibs, used by boil explosion as well
					ad_monster_flrbody_gib(ad_onflr, ad_axedmg*4);
					return;
				}
			}
			// See if there are anymore bodies close by
			ad_onflr = find(ad_onflr,ad_bodyonflr, ad_MON_ONFLR);
		}
	}

	// Trace forward and see if the axe has hit anything?	
	traceline (ad_source, ad_source + (v_forward* ad_RANGE_PLAYAXE), ad_FALSE, self);
	if (trace_fraction == 1.0) return;	// No contact, no hit
	
	ad_org = trace_endpos - v_forward*4;	// Back 4 units to spawn blood

	//----------------------------------------------------------------------
	// REFLECTION stuff like blue shields
	if (trace_ent.ad_reflectaxe) ad_Resist_Axe(self, ad_org);
	//----------------------------------------------------------------------
	// BLEEDING/DAMAGE stuff with unique impact sounds
	else if (trace_ent.takedamage) {
		// Mark the monster with type of axe used and change damage
		if (self.ad_moditems & ad_IT_UPGRADE_AXE) {
			ad_axedmg = ad_DAMAGE_PLAYAXE2; trace_ent.ad_axhitme = 2; }
		else {
			ad_axedmg = ad_DAMAGE_PLAYAXE1; trace_ent.ad_axhitme = 1; }
		
		// Spamn blood always up so player can see it
		ad_SpawnBlood (trace_ent, ad_org, '0 0 1', ad_axedmg);
		ad_T_Damage (trace_ent, self, self, ad_axedmg, ad_DAMARMOR);
		
		// Monster impact sounds (fleshy stuff)
		if (trace_ent.flags & ad_FL_MONSTER) {
			if (random() < 0.5) sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_HEAVY, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_HEAVY2, 1, ad_ATTN_NORM);
		}
		// Breakable impact sounds (def=stone/brick)
		else if (trace_ent.ad_classtype == ad_CT_FUNCBREAK) {
			if (trace_ent.style == ad_BTYPE_WOOD) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_WOOD, 1, ad_ATTN_NORM);
			else if (trace_ent.style == ad_BTYPE_GLASS) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_GLASS, 1, ad_ATTN_NORM);
			else if (trace_ent.style == ad_BTYPE_METAL) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_METAL, 1, ad_ATTN_NORM);
			else if (trace_ent.style == ad_BTYPE_FLESH) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_FLESH, 1, ad_ATTN_NORM);
			else
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_STONE, 1, ad_ATTN_NORM);
		}
		// Pushable impact sounds (def=stone/brick)
		else if (trace_ent.ad_classtype == ad_CT_FUNCPUSHABLE) {
			if (trace_ent.style == ad_PTYPE_WOOD) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_WOOD, 1, ad_ATTN_NORM);
			else if (trace_ent.style == ad_PTYPE_GLASS) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_GLASS, 1, ad_ATTN_NORM);
			else if (trace_ent.style == ad_PTYPE_METAL) 
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_METAL, 1, ad_ATTN_NORM);
			else
				sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_STONE, 1, ad_ATTN_NORM);
		}
	}
	//----------------------------------------------------------------------
	// WORLD (probably) does not bleed, play stone hitting sound
	else {
		sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_STONE, 1, ad_ATTN_NORM);
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
		WriteCoord (ad_MSG_BROADCAST, ad_org_x);
		WriteCoord (ad_MSG_BROADCAST, ad_org_y);
		WriteCoord (ad_MSG_BROADCAST, ad_org_z);
	}
};

/*======================================================================
 OLD STYLE BULLET SYSTEM (HITSCAN)
======================================================================*/
void() ad_ClearMultiDamage =
{
	ad_multi_ent = world;
	ad_multi_damage = 0;
};

//----------------------------------------------------------------------
void() ad_ApplyMultiDamage =
{
	local float ad_temp_classgroup;
	
	// Return if no target entity
	if (!ad_multi_ent) return;
	
	// Check for bullet/shell resistance
	if (ad_multi_ent.ad_resist_shells > 0) 
		ad_multi_damage = ad_Resist_Damage(ad_multi_ent, ad_IT_SHELLS, ad_multi_damage);

	// Need to fool T_Damage that damage is coming from a shell
	ad_temp_classgroup = self.ad_classgroup;
	self.ad_classgroup = ad_CG_PROJSHELLS;
	ad_T_Damage (ad_multi_ent, self, self, ad_multi_damage, ad_DAMARMOR);
	self.ad_classgroup = ad_temp_classgroup;
};

//----------------------------------------------------------------------
void(entity ad_hit, float ad_damage) ad_AddMultiDamage =
{
	if (!ad_hit) return;
	
	if (ad_hit != ad_multi_ent) {
		ad_ApplyMultiDamage ();
		ad_multi_damage = ad_damage;
		ad_multi_ent = ad_hit;
	}
	else ad_multi_damage = ad_multi_damage + ad_damage;
};

//----------------------------------------------------------------------
void(vector ad_org, float ad_marker_time) ad_MarkAttack =
{
	ad_newmis = spawn();
	ad_newmis.ad_classtype = ad_CT_DEVMARKER;
	ad_newmis.movetype = ad_MOVETYPE_NONE;
	ad_newmis.solid = ad_SOLID_NOT;
	setmodel(ad_newmis, ad_MODEL_IMPACT);
	ad_newmis.skin = rint(random()*7);
	setorigin(ad_newmis, ad_org);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_newmis.think = ad_SUB_Remove;
	ad_newmis.nextthink = time + ad_marker_time;
};

//----------------------------------------------------------------------
void(float ad_damage, vector ad_dir) ad_TraceAttack =
{
	local vector ad_vel, ad_org;
	
	ad_vel = normalize(ad_dir + v_up*ad_crandom() + v_right*ad_crandom());
	ad_vel = ad_vel + 2*trace_plane_normal;
	ad_vel = ad_vel * 200;

	ad_org = trace_endpos - ad_dir*4;

	// Check for sky content? skies don't impact or bleed
	if (!ad_check_skycontent(ad_org)) {
		if (trace_ent.takedamage) {
			// Show bullet resistance as small blood+gunshot+smoke
			if (trace_ent.ad_resist_shells > 0) 
				ad_Resist_Shells(trace_ent, ad_org, ad_vel, ad_damage);
			else {
				// Hitting monsters does twice the amount of blood effects
				if (trace_ent.flags & ad_FL_MONSTER) ad_SpawnBlood (trace_ent, ad_org, ad_vel*0.2, ad_damage*2);
				else ad_SpawnBlood (trace_ent, ad_org, ad_vel*0.2, ad_damage);
			}
			// Keep adding up the damage
			ad_AddMultiDamage (trace_ent, ad_damage);
			
			// Check for target dummy (manually create marker)
			if (trace_ent.ad_classtype == ad_CT_TARGETDUMMY) 
				ad_MarkAttack(ad_org, trace_ent.wait);
		}
		else {
			// Hit something that does not bleed (often world)
			WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
			WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
			WriteCoord (ad_MSG_BROADCAST, ad_org_x);
			WriteCoord (ad_MSG_BROADCAST, ad_org_y);
			WriteCoord (ad_MSG_BROADCAST, ad_org_z);
		}
	}
};

//----------------------------------------------------------------------
void(float ad_shotcount, vector ad_spread) ad_FireBullets =
{
	local	vector ad_direction, ad_src, ad_dir;
	
	if (self.flags & ad_FL_CLIENT) {
		makevectors(self.v_angle);
		ad_src = self.origin + v_forward*10;
		ad_src_z = self.absmin_z + self.size_z * 0.7;
		// Auto aim assist (builtin function 44)
		if (ad_autoaim_cvar < 1) ad_dir = aim(self, ad_SPEED_PLAYAIM);
		// Straight line forward where crosshair is pointing
		else ad_dir = normalize(v_forward * ad_SPEED_PLAYAIM);
	}
	else {
		makevectors(self.angles);
		ad_src = self.origin + ad_attack_vector(self.ad_attack_offset);
		// A monster attacking a monster will not dodge
		if (self.enemy.flags & ad_FL_MONSTER)
			ad_dir = normalize(self.enemy.origin - ad_src);
		else {
			// fire somewhat behind the player
			// so a dodging player is harder to hit
			ad_dir = self.enemy.origin - self.enemy.velocity*0.2;
			ad_dir = normalize (ad_dir - ad_src);
		}
	}

	ad_ClearMultiDamage ();
	while (ad_shotcount > 0) {
		ad_direction = ad_dir + ad_crandom()*ad_spread_x*v_right + ad_crandom()*ad_spread_y*v_up;
		traceline (ad_src, ad_src + ad_direction*2048, ad_FALSE, self);
		if (trace_fraction != 1.0) ad_TraceAttack (ad_DAMAGE_SHELL, ad_direction);
		ad_shotcount = ad_shotcount - 1;
	}
	ad_ApplyMultiDamage ();
};

/*======================================================================
W_FireShotgun
======================================================================*/
void() ad_W_FireShotgun =
{
	local vector ad_spread_pat;
	
	// Ran out of ammo, switch to next best weapon
	if (self.ad_attack_finished > time) return;
	if (self.ammo_shells < 1) { ad_forceweaponswitch(0.2); return;}
	
	// Change weapon sound if using Projectile Pellets
	// IMPORTANT - default for Projectile Pellets is ON = 0
	if (!ad_query_configflag(ad_SVR_SHOTGPROJ))
		sound (self ,ad_CHAN_WEAPON, "weapons/sg2.wav", 1, ad_ATTN_NORM);
	else
		sound (self ,ad_CHAN_WEAPON, "weapons/sg1.wav", 1, ad_ATTN_NORM);
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.5;
	self.punchangle_x = -2;
	ad_player_sgreset();			// reset weaponframe
	
	self.currentammo = self.ammo_shells = self.ammo_shells - 1;

	if (self.ad_moditems & ad_IT_ARTSHARP) ad_spread_pat = ad_SPREAD_SG2;
	else ad_spread_pat = ad_SPREAD_SG;
	
	// Choose between a projectile or hitscan system
	if (ad_query_configflag(ad_SVR_SHOTGPROJ)) {
		ad_FireBullets (ad_QUANTITY_SG, ad_spread_pat);
		ad_Launch_ShellCasing(1);	// Shell casings
	}
	else {
		ad_Launch_Shells(ad_QUANTITY_SG, ad_spread_pat, ad_CT_PROJ_SG);
		ad_Launch_ShellCasing(1);	// Shell casings
	}
};

/*======================================================================
W_FireSuperShotgun
======================================================================*/
void() ad_W_FireSuperShotgun =
{
	local float ad_ssg_qty, ad_shell_qty;
	local vector ad_spread_pat;
	
	// Ran out of ammo, switch to next best weapon
	if (self.ad_attack_finished > time) return;
	if (self.ammo_shells < 2) { ad_forceweaponswitch(0.2); return;}

	makevectors (self.v_angle);		// Special view angle for the player

	// if shot in the air - do Newton's 3rd law. (from zerstorer)
	if (!(self.flags & ad_FL_ONGROUND))
		self.velocity = self.velocity - (v_forward * 35);
	
	// Change weapon sound if using Shotgun Upgrade or Projectile Pellets
	// IMPORTANT - default for Projectile Pellets is ON = 0
	if (self.ad_moditems & ad_IT_UPGRADE_SSG || !ad_query_configflag(ad_SVR_SHOTGPROJ))
		sound (self ,ad_CHAN_WEAPON, "weapons/ssg2.wav", 1, ad_ATTN_NORM);
	else
		sound (self ,ad_CHAN_WEAPON, "weapons/ssg1.wav", 1, ad_ATTN_NORM);

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.7;
	self.punchangle_x = -4;
	ad_player_ssgreset();			// reset weaponframe
	ad_shell_qty = 2;				// Standard shell casings quantity

	// If the player has the Widowmaker, setup triple shot
	if (self.ad_moditems & ad_IT_UPGRADE_SSG) {
		// Only got 2 shells in the gun (reduced damage)
		if (self.ammo_shells < 3) {
			self.ammo_shells = 0;
			ad_ssg_qty = ad_QUANTITY_SSG;
		}
		else {
			// 150% damage
			ad_shell_qty = 3;
			self.ammo_shells = self.ammo_shells - 3;
			ad_ssg_qty = ad_QUANTITY_WM;
		}
	}
	else {
		// Default ID SSG damage
		self.ammo_shells = self.ammo_shells - 2;
		ad_ssg_qty = ad_QUANTITY_SSG;
	}

	self.currentammo = self.ammo_shells;
	if (self.ad_moditems & ad_IT_ARTSHARP) ad_spread_pat = ad_SPREAD_SSG2;
	else ad_spread_pat = ad_SPREAD_SSG;

	// Choose between a projectile or hit-scan system
	if (ad_query_configflag(ad_SVR_SHOTGPROJ)) {
		ad_FireBullets (ad_ssg_qty, ad_spread_pat);	// Hit-scan
		ad_Launch_ShellCasing(ad_shell_qty);
	}
	else {
		ad_Launch_Shells(ad_ssg_qty, ad_spread_pat, ad_CT_PROJ_SSG);
		ad_Launch_ShellCasing(ad_shell_qty);
	}
};

/*======================================================================
W_FireSpikes
======================================================================*/
void(float ad_oz, float ad_ox) ad_W_FireSpikes =
{
	local vector ad_org, ad_dir;
	
	// If run out of ammo, switch weapons to next best
	if (self.ammo_nails < 1) { ad_forceweaponswitch(0.2); return; }

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.2;
	self.punchangle_x = -2;
	makevectors (self.v_angle);

	// Check for auto aim state
	// Auto aim assist (builtin function 44)
	if (ad_autoaim_cvar < 1) ad_dir = aim(self, ad_SPEED_PLAYSPIKE);
	// Straight line forward where crosshair is pointing
	else ad_dir = normalize(v_forward * ad_SPEED_PLAYSPIKE);

	// SNG setup, sound and ammo change
	if (self.ammo_nails > 1 && self.weapon == ad_IT_SUPER_NAILGUN) {
		sound (self, ad_CHAN_WEAPON, "weapons/spike2.wav", 1, ad_ATTN_NORM);
		self.currentammo = self.ammo_nails = self.ammo_nails - 2;

		//-------------------------------------------------------------
		// Original setup - org = self.origin + '0 0 16';
		// - SNG projectile offset idea by Kinn
		// org = self.origin + dir*14 + v_right*ox;
		// org_z = org_z + oz;
		// The SNG offset idea was hiting far below the crosshair
		// which was causing impact problems.
		// Kept the barrel offset, removed the Z adjustment instead!
		//-------------------------------------------------------------
		ad_org = self.origin + '0 0 16' + v_right*ad_ox;
		ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_SNG, ad_SPEED_PLAYSPIKE);
	}
	// NG setup, sound and ammo change
	else {
		sound (self, ad_CHAN_WEAPON, "weapons/rocket1i.wav", 1, ad_ATTN_NORM);
		self.currentammo = self.ammo_nails = self.ammo_nails - 1;
		
		// Original setup - org = self.origin + '0 0 16' + v_right*ox;
		// - NG projectile offset idea by Kinn
		// org = self.origin + '0 0 8' + dir*14 + v_right*ox;
		ad_org = self.origin + '0 0 16' + v_right*ad_ox;
		ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_NG, ad_SPEED_PLAYSPIKE);
	}
};

/*======================================================================
GRENADES
======================================================================*/
void() ad_W_FireGrenade =
{
	local vector ad_dir, ad_avel;
	
	// Ran out of ammo, switch to next best weapon
	if (self.ad_attack_finished > time) return;
	if (self.ammo_rockets < 1) { ad_forceweaponswitch(0.2); return;}

	self.currentammo = self.ammo_rockets = self.ammo_rockets - 1;
	sound (self, ad_CHAN_WEAPON, "weapons/grenade.wav", 1, ad_ATTN_NORM);
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.6;
	self.punchangle_x = -2;
	ad_player_grenreset();			// reset weaponframe

	makevectors (self.v_angle);
	// Has the player aimed left/right? then no auto aim assist
	if (self.v_angle_x) {
		ad_dir = v_forward*ad_SPEED_PLAYGRENADE + v_up * ad_ELEV_ZAXIS + ad_crandom()*v_right*10 + ad_crandom()*v_up*10;
	}
	else {
		// Check for auto aim state
		if (ad_autoaim_cvar < 1) ad_dir = aim(self, ad_SPEED_PLAYAIM);
		else ad_dir = normalize(v_forward * ad_SPEED_PLAYGRENADE);
		// Work out default speed and elevation
		ad_dir = ad_dir * ad_SPEED_PLAYGRENADE;
		ad_dir_z = ad_ELEV_ZAXIS;
	}
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(self.origin, ad_dir, ad_avel, ad_CT_PROJ_GL);
};

/*======================================================================
 ROCKETS
======================================================================*/
void() ad_W_FireRocket =
{
	local vector ad_org, ad_dir;
	
	// Ran out of ammo, switch to next best weapon
	if (self.ad_attack_finished > time) return;
	if (self.ammo_rockets < 1) { ad_forceweaponswitch(0.2); return;}

	self.currentammo = self.ammo_rockets = self.ammo_rockets - 1;
	sound (self, ad_CHAN_WEAPON, "weapons/sgun1.wav", 1, ad_ATTN_NORM);
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.8;
	self.punchangle_x = -2;
	ad_player_rockreset();			// reset weaponframe

	makevectors (self.v_angle);
	ad_org = self.origin + v_forward * 8 + '0 0 16';

	// Auto aim assist (builtin function 44)
	if (ad_autoaim_cvar < 1) ad_dir = aim(self, ad_SPEED_RLPLAYER);
	// Straight line forward where crosshair is pointing
	else ad_dir = normalize(v_forward * ad_SPEED_RLPLAYER);
	
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_ROCKET, ad_SPEED_RLPLAYER);
};

/*======================================================================
PLASMA
======================================================================*/
void() ad_W_FirePlasma =
{
	local vector ad_org, ad_dir;
	local float ad_cells;
	
	// If run out of ammo, switch weapons to next best
	if (self.ad_attack_finished > time) return;
	if (self.ammo_cells < 1) { ad_forceweaponswitch(0.2); return; }

	// Do nothing if weapon is under water
	if (self.waterlevel > 1) {
		// Air tank vania item wil explode weapon instead
		if (self.ad_moditems & ad_IT_ARTAIRTANK) {
			// Use all cells
			ad_cells = self.ammo_cells;
			// Update inventory
			self.ammo_cells = 0;
			ad_W_SetCurrentAmmo (self);
			// Impact avoidance sound
			ad_PlayBlastBeltSound(self);
			// Death to everything around, except players!
			ad_T_RadiusDamage (self, self, 35*ad_cells, self, ad_IGNORECLASS);
			// Reduce player HP down to 50%, no armour saves!
			ad_T_Damage(self, world, world, self.health*0.5, ad_NOARMOR);
		}
		else {
			self.ad_attack_finished = time + 0.2;
			sound (self, ad_CHAN_WEAPON, ad_SOUND_MISFIRE, 1, ad_ATTN_NORM);
		}
		return;
	}
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.2;
	self.punchangle_x = -2;

	makevectors (self.v_angle);

	// Check for auto aim state
	// Auto aim assist (builtin function 44)
	if (ad_autoaim_cvar < 1) ad_dir = aim(self, ad_SPEED_PLAYPLASMA);
	// Straight line forward where crosshair is pointing
	else ad_dir = normalize(v_forward * ad_SPEED_PLAYPLASMA);

	sound (self, ad_CHAN_WEAPON, "weapons/plasma_fire.wav", 1, ad_ATTN_NORM);
	self.currentammo = self.ammo_cells = self.ammo_cells - 1;
	
	ad_org = self.origin + v_forward*8 + '0 0 16';
	ad_launch_plasma (ad_org, ad_dir, ad_CT_PLAYER, ad_SPEED_PLAYPLASMA);
};

/*======================================================================
LIGHTNING
======================================================================*/
void(vector ad_lstart, entity ad_lsource, float ad_ldamage) ad_LightningReflection;
//----------------------------------------------------------------------
// This is a general purpose lighting damage function
// Used by monsters and traps
//----------------------------------------------------------------------
void(vector ad_lstart, vector ad_lfinish, entity ad_lsource, float ad_ldamage) ad_LightningDamage =
{
	local vector ad_spot1, ad_spot2, ad_lightdir;
	local float ad_lighthit, ad_loffset;

	ad_lighthit = ad_FALSE;
	ad_loffset = 8;

	// Traceline 1 - Direct single line from source to target
	traceline (ad_lstart, ad_lfinish, ad_FALSE, ad_lsource);
	if (trace_ent.takedamage > ad_DAMAGE_NO) ad_lighthit = ad_TRUE;
	else {
		// Where out vector direction from source to target
		ad_lightdir = ad_lfinish - ad_lstart;
		makevectors(ad_lightdir);
		
		// Traceline 2 - Left and right of center
		ad_spot1 = ad_lstart + v_right * ad_loffset;
		ad_spot2 = ad_lfinish + v_right * ad_loffset;
		traceline (ad_spot1, ad_spot2, ad_FALSE, ad_lsource);
		if (trace_ent.takedamage > ad_DAMAGE_NO) ad_lighthit = ad_TRUE;
		else {
			ad_spot1 = ad_lstart - v_right * ad_loffset;
			ad_spot2 = ad_lfinish - v_right * ad_loffset;
			traceline (ad_spot1, ad_spot2, ad_FALSE, ad_lsource);
			if (trace_ent.takedamage > ad_DAMAGE_NO) ad_lighthit = ad_TRUE;
			else {
				// Traceline 3 - Up and down of center
				ad_spot1 = ad_lstart + v_up * ad_loffset;
				ad_spot2 = ad_lfinish + v_up * ad_loffset;
				traceline (ad_spot1, ad_spot2, ad_FALSE, ad_lsource);
				if (trace_ent.takedamage > ad_DAMAGE_NO) ad_lighthit = ad_TRUE;
				else {
					ad_spot1 = ad_lstart - v_up * ad_loffset;
					ad_spot2 = ad_lfinish - v_up * ad_loffset;
					traceline (ad_spot1, ad_spot2, ad_FALSE, ad_lsource);
					if (trace_ent.takedamage > ad_DAMAGE_NO) ad_lighthit = ad_TRUE;
				}
			}
		}
	}

	// Found a target to hit?
	if (ad_lighthit) {
		//----------------------------------------------------------------------
		// Check for breakable/pushable monster immunity
		if (ad_ai_immunebreakable(self, trace_ent)) {
			// This is resist lightning function without pain sound
			// Don't spawn smoke constantly (let the sprite finish)
			if (self.ad_lightning_timer < time) {
				self.ad_lightning_timer = time + 0.3;
				ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, trace_endpos, "");
			}
			ad_SpawnProjectileSmoke(trace_endpos, 200, 50, 150);
		}
		//----------------------------------------------------------------------
		// Check for any cell/lightning resistance
		else if (trace_ent.ad_resist_cells > 0) {
			ad_ldamage = ad_Resist_Damage(trace_ent, ad_IT_CELLS, ad_ldamage);
			ad_Resist_Lightning(trace_ent, trace_endpos);
			if (ad_ldamage > 0)
				// classic damage from source with armour saves
				ad_T_Damage (trace_ent, ad_lsource, ad_lsource, ad_ldamage, ad_DAMARMOR);
		}
		else {
			// Originally used 225 blood colour
			ad_SpawnBlood(trace_ent, trace_endpos, '0 0 100', ad_ldamage*4);
			ad_T_Damage (trace_ent, ad_lsource, ad_lsource, ad_ldamage, ad_DAMARMOR);
		}
		// Check for any lightning reflection abilitites
		if (trace_ent.ad_reflectlightning) {
			// Source = Lightning originally came from player
			ad_LightningReflection(trace_endpos, trace_ent, ad_ldamage*0.5);
		}
	}	
};

//----------------------------------------------------------------------
// New ability to spawn lighting strikes in random directions
//----------------------------------------------------------------------
void(vector ad_lstart, entity ad_lsource, float ad_ldamage) ad_LightningReflection =
{
	local vector ad_lfinish, ad_dir;

	// Setup a random XYZ direction (+/-)
	ad_lfinish = ad_lstart + ad_vecrand(0,1000,1);
	
	// Trace line in random direction
	traceline(ad_lstart, ad_lfinish, ad_FALSE, ad_lsource);
	
	// Random chance of a plasma/lightning bolt!
	if (random() < 0.5) {
		ad_dir = normalize(trace_endpos - ad_lstart);
		ad_launch_plasma(ad_lstart, ad_dir, ad_CT_REFLECTLIGHT, ad_SPEED_REFLECTION);
	}
	else {
		// Draw lighting beam (32 model unit chunks)
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
		WriteEntity (ad_MSG_BROADCAST, ad_lsource); WriteByte (ad_MSG_BROADCAST, 0);
		WriteCoord (ad_MSG_BROADCAST, ad_lstart_x);
		WriteCoord (ad_MSG_BROADCAST, ad_lstart_y);
		WriteCoord (ad_MSG_BROADCAST, ad_lstart_z);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
		WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);
		// Check for damage with new lightning beam
		ad_LightningDamage(ad_lstart, trace_endpos, world, ad_ldamage);
	}
};

//----------------------------------------------------------------------
// This lightning damage check is designed for the lightning gun
// with many modifiers designed for the player and MP combat
// This function should not be used for general lightning damage
//----------------------------------------------------------------------
void(vector ad_p1, vector ad_p2, entity ad_from, float ad_damage) ad_PlayerLightningDamage =
{
	local entity ad_e1, ad_e2;
	local vector ad_f;
	local float ad_lighthit, ad_temp_classgroup;
	
	ad_f = ad_p2 - ad_p1;
	normalize (ad_f);
	ad_f_x = 0 - ad_f_y;
	ad_f_y = ad_f_x;
	ad_f_z = 0;
	ad_f = ad_f*16;

	ad_e1 = ad_e2 = world;
	ad_lighthit = ad_FALSE;
	//	LightningDamage (org, trace_endpos, self, 10);
	//	dprint("Light ("); dprint(trace_ent.classname); dprint(")\n");
	traceline (ad_p1, ad_p2, ad_FALSE, self);
	if (trace_ent.takedamage) {
		ad_lighthit = ad_TRUE;
		// Some weird MP velocity hack!
		// The story about this code (from quakeworld.nu)
		//
		// This code appears to have been there for a long, long time.
		// It was there in Quake 1.06 Shareware release, and it may have
		// been there before that. Someone must have been experimenting
		// with something and forgot it there, but no one noticed because
		// in that function, the 'other' entity is not usually set to
		// anything in particular, and the code never worked.
		//
		// But then QW came along, and in the QW engine it turns out
		// that 'other' will be set to 'self' if the player is touching
		// a platform. And so the dormant code stared working! It was
		// discovered by players, and players started using it to their
		// advantage. Now it's an integral part of dm6 gameplay.
		//
		// The code was apparently discovered and removed when Quake QC 
		// code was cleaned up before being released to public, so you
		// won't normally see it in NQ mods. But it is there in the
		// progs.dat in pak0.pak; and it will work in QuakeWorld engines
		// supporting progs.dat (currently FTE and ZQuake).
		//
		if (self.ad_classtype == ad_CT_PLAYER) {
			if (other.ad_classtype == ad_CT_PLAYER)
				trace_ent.velocity_z = trace_ent.velocity_z + 400;
		}
	}
	else {
		ad_e1 = trace_ent;

		traceline (ad_p1 + ad_f, ad_p2 + ad_f, ad_FALSE, self);
		if (trace_ent != ad_e1 && trace_ent.takedamage) ad_lighthit = ad_TRUE;
		else {
			ad_e2 = trace_ent;

			traceline (ad_p1 - ad_f, ad_p2 - ad_f, ad_FALSE, self);
			if (trace_ent != ad_e1 && trace_ent != ad_e2 && trace_ent.takedamage)
				ad_lighthit = ad_TRUE;
		}
	}

	// Found a target to hit?
	if (ad_lighthit) {
		// Check for any cell/lightning resistance
		if (trace_ent.ad_resist_cells > 0) {
			ad_damage = ad_Resist_Damage(trace_ent, ad_IT_CELLS, ad_damage);
			ad_Resist_Lightning(trace_ent, trace_endpos);
			if (ad_damage > 0) {
				// Need to fool T_Damage that damage is coming from LG
				ad_temp_classgroup = ad_from.ad_classgroup;
				ad_from.ad_classgroup = ad_CG_PROJCELLS;
				ad_T_Damage (trace_ent, ad_from, ad_from, ad_damage, ad_DAMARMOR);
				ad_from.ad_classgroup = ad_temp_classgroup;
			}
		}
		else {
			// Originally used 225 blood colour
			ad_SpawnBlood(trace_ent, trace_endpos, '0 0 100', ad_damage*4);
			ad_T_Damage (trace_ent, ad_from, ad_from, ad_damage, ad_DAMARMOR);
		}
		// Check for any lightning reflection abilitites
		if (trace_ent.ad_reflectlightning) {
			// Source = Lightning originally came from player
			ad_LightningReflection(trace_endpos, trace_ent, ad_damage*0.5);
		}
	}	
};

//----------------------------------------------------------------------
void() ad_W_FireLightning =
{
	local vector ad_dir;
	local float ad_cells;

	// Ran out of ammo, switch to next best weapon
	if (self.ammo_cells < 1) { ad_forceweaponswitch(0.2); return; }

	// explode if under water
	if (self.waterlevel > 1) {
		// Use all cells
		ad_cells = self.ammo_cells;
		// Update inventory
		self.ammo_cells = 0;
		ad_W_SetCurrentAmmo (self);
		// Air tank vania item saves player from death
		if (self.ad_moditems & ad_IT_ARTAIRTANK) {
			// Impact avoidance sound
			ad_PlayBlastBeltSound(self);
			// Death to everything around, except players!
			ad_T_RadiusDamage (self, self, 35*ad_cells, self, ad_IGNORECLASS);
			// Reduce player HP down to 50%, no armour saves!
			ad_T_Damage(self, world, world, self.health*0.5, ad_NOARMOR);
		}
		// Default behaviour, death to everything!
		else ad_T_RadiusDamage (self, self, 35*ad_cells, world, ad_DAMAGEALL);
		return;
	}

	// Time for a new LG hit sound?
	if (self.t_width < time) {
		sound (self, ad_CHAN_WEAPON, "weapons/lhit.wav", 1, ad_ATTN_NORM);
		self.t_width = time + 0.6;
	}
	
	self.currentammo = self.ammo_cells = self.ammo_cells - 1;
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_finished = time + 0.2;
	self.punchangle_x = -2;

	ad_dir = self.origin + '0 0 16';
	traceline (ad_dir, ad_dir + v_forward*600, ad_TRUE, self);

	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_LIGHTNING2);
	WriteEntity (ad_MSG_BROADCAST, self); WriteByte (ad_MSG_BROADCAST, 0);
	WriteCoord (ad_MSG_BROADCAST, ad_dir_x);
	WriteCoord (ad_MSG_BROADCAST, ad_dir_y);
	WriteCoord (ad_MSG_BROADCAST, ad_dir_z);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_x);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_y);
	WriteCoord (ad_MSG_BROADCAST, trace_endpos_z);

	ad_PlayerLightningDamage (self.origin, trace_endpos + v_forward*4, self, ad_DAMAGE_LGPLAYER);
};

/*======================================================================
 PLAYER WEAPON UPDATES AND AMMO CHECKS
 
 W_SetCurrentAmmo   - Update HUD icons based on self.weapon value
 W_BestWeapon       - returns best weapon LG > SNG > SSG > NG > SG > Axe
                      interesting that the function does not return GL/RL
 W_CheckNoAmmo      - Ammo check for attack function
 W_Attack           - Main function that fire weapons (player animations)
                      Will automatically wakeup any nearby monsters
 W_ChangeWeapon     - Change weapon based on availabilty and ammo
 CycleWeaponCommand - Move forward or backward through active weapons
 CycleWeaponReverseCommand
 W_WeaponFrame      - Called every frame, catches impulse event
 SuperDamageSound   - Plays quad damage sound

======================================================================*/
void(entity ad_targ) ad_W_SetCurrentAmmo =
{
	if (VR_AD_SetCurrentAmmo(ad_targ)) return;
	if (ad_intermission_running > 0) return;	// intermission or finale
	if (ad_cinematic_running > 0) return;		// Remote camera active
	ad_remoteplayer_run (ad_targ);				// get out of any weapon firing states

	// Reset all Ammo types for gfx on sbar (engine code hack - sbar.c)
	ad_targ.items = ad_targ.items - ( ad_targ.items & (ad_IT_SHELLS | ad_IT_NAILS | ad_IT_ROCKETS | ad_IT_CELLS) );
		
	// Check for all weapon types
	if (ad_targ.weapon == ad_IT_AXE) {
		ad_targ.currentammo = 0;
		ad_targ.weaponframe = 0;	// reset before setting model
		if (ad_targ.ad_moditems & ad_IT_UPGRADE_GHOOK)
			ad_targ.weaponmodel = ad_MODEL_VWEAP_GHOOK;
		else if (ad_targ.ad_moditems & ad_IT_UPGRADE_AXE) 
			ad_targ.weaponmodel = ad_MODEL_VWEAP_UPAXE;
		else ad_targ.weaponmodel = ad_MODEL_VWEAP_AXE;
	}
	else if (ad_targ.weapon == ad_IT_SHOTGUN) {
		ad_targ.currentammo = ad_targ.ammo_shells;
		ad_targ.weaponframe = 0;	// reset before setting model
		ad_targ.weaponmodel = ad_MODEL_VWEAP_SG;
		ad_targ.items = ad_targ.items | ad_IT_SHELLS;
	}
	else if (ad_targ.weapon == ad_IT_SUPER_SHOTGUN) {
		ad_targ.currentammo = ad_targ.ammo_shells;
		ad_targ.weaponframe = 0;	// reset before setting model
		if (ad_targ.ad_moditems & ad_IT_UPGRADE_SSG) 
			ad_targ.weaponmodel = ad_MODEL_VWEAP_UPSSG;
		else ad_targ.weaponmodel = ad_MODEL_VWEAP_SSG;
		ad_targ.items = ad_targ.items | ad_IT_SHELLS;
	}
	else if (ad_targ.weapon == ad_IT_NAILGUN) {
		ad_targ.currentammo = ad_targ.ammo_nails;
		ad_targ.weaponframe = 0;	// reset before setting model
		ad_targ.weaponmodel = ad_MODEL_VWEAP_NG;
		ad_targ.items = ad_targ.items | ad_IT_NAILS;
	}
	else if (ad_targ.weapon == ad_IT_SUPER_NAILGUN) {
		ad_targ.currentammo = ad_targ.ammo_nails;
		ad_targ.weaponframe = 0;	// reset before setting model
		ad_targ.weaponmodel = ad_MODEL_VWEAP_SNG;
		ad_targ.items = ad_targ.items | ad_IT_NAILS;
	}
	else if (ad_targ.weapon == ad_IT_GRENADE_LAUNCHER) {
		ad_targ.currentammo = ad_targ.ammo_rockets;
		ad_targ.weaponframe = 0;	// reset before setting model
		ad_targ.weaponmodel = ad_MODEL_VWEAP_GL;
		ad_targ.items = ad_targ.items | ad_IT_ROCKETS;
	}
	else if (ad_targ.weapon == ad_IT_ROCKET_LAUNCHER) {
		ad_targ.currentammo = ad_targ.ammo_rockets;
		ad_targ.weaponframe = 0;	// reset before setting model
		ad_targ.weaponmodel = ad_MODEL_VWEAP_RL;
		ad_targ.items = ad_targ.items | ad_IT_ROCKETS;
	}
	else if (ad_targ.weapon == ad_IT_LIGHTNING) {
		ad_targ.currentammo = ad_targ.ammo_cells;
		ad_targ.weaponframe = 0;	// reset before setting model
		if (ad_targ.ad_moditems & ad_IT_UPGRADE_LG) 
			ad_targ.weaponmodel = ad_MODEL_VWEAP_UPLG;
		else ad_targ.weaponmodel = ad_MODEL_VWEAP_LG;
		ad_targ.items = ad_targ.items | ad_IT_CELLS;
	}
	else {
		// This is also a no axe startup option
		// no weapon found, reset viewmodel
		ad_targ.currentammo = 0;	// Used on hud as well
		ad_targ.weaponframe = 0;	// reset before setting model
		ad_targ.weaponmodel = "";	// no viewmodel
	}
};

/*======================================================================
 Return best weapon based on current ammo quantities
======================================================================*/
float(entity ad_targ) ad_W_BestWeapon =
{
	if (ad_targ.waterlevel < 2 && ad_targ.ammo_cells > 0 && (ad_targ.items & ad_IT_LIGHTNING) )
			return ad_IT_LIGHTNING;
	else if(ad_targ.ammo_nails > 1 && (ad_targ.items & ad_IT_SUPER_NAILGUN) )
		return ad_IT_SUPER_NAILGUN;
	else if(ad_targ.ammo_shells > 1 && (ad_targ.items & ad_IT_SUPER_SHOTGUN) )
		return ad_IT_SUPER_SHOTGUN;
	else if(ad_targ.ammo_nails > 0 && (ad_targ.items & ad_IT_NAILGUN) )
		return ad_IT_NAILGUN;
	else if(ad_targ.ammo_shells > 0 && (ad_targ.items & ad_IT_SHOTGUN) )
		return ad_IT_SHOTGUN;
	// No axe found, return nothing!
	else if(!(ad_targ.items & ad_IT_AXE)) return ad_FALSE;
	// Default is Axe
	else return ad_IT_AXE;
};

//----------------------------------------------------------------------
float(entity ad_targ) ad_W_CheckNoAmmo =
{
	if (ad_targ.currentammo > 0) return ad_TRUE;
	if (ad_targ.weapon == ad_IT_AXE) return ad_TRUE;
	
	ad_targ.weapon = ad_W_BestWeapon (ad_targ);
	ad_W_SetCurrentAmmo (ad_targ);
	
	// drop the weapon down
	return ad_FALSE;
};

/*======================================================================
W_Attack
======================================================================*/
void() ad_W_Attack =
{
	if (ad_intermission_running > 0) return;	// intermission or finale
	if (ad_cinematic_running > 0) return;		// Remote camera active
	if (self.weapon == 0) return;			// No weapons available
	if ( !ad_W_CheckNoAmmo(self) ) return;		// Out of ammo?

	makevectors	(self.v_angle);		// calculate forward angle for velocity
	self.ad_show_hostile = time + 1;	// wake monsters up

	//----------------------------------------------------------------------
	// Axe - Mighty chopper
	//----------------------------------------------------------------------
	if (self.weapon == ad_IT_AXE) {
		// Check grapple hook replacement first
		if (self.ad_moditems & ad_IT_UPGRADE_GHOOK) ad_player_grapple1();
		else {
			if (random() < 0.5) sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_SWIPE1, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_WEAPON, ad_SOUND_AXE_SWIPE2, 1, ad_ATTN_NORM);
			// Work out which axe swing to play (never play swing twice in a row)
			self.lip = self.ad_meleeattack;
			while (self.ad_meleeattack == self.lip) {
				self.lip = rint(random()*4.4);
			}
			self.ad_meleeattack = self.lip;
			if (self.ad_meleeattack == 0) ad_player_axe1();
			else if (self.ad_meleeattack == 1) ad_player_axeb1();
			else if (self.ad_meleeattack == 2) ad_player_axec1();
			else if (self.ad_meleeattack == 3) ad_player_axed1();
			else ad_player_axee1();	
			self.ad_attack_finished = time + 0.5;
		}
	}
	//----------------------------------------------------------------------
	else if (self.weapon == ad_IT_SHOTGUN) ad_player_sg1();
	else if (self.weapon == ad_IT_SUPER_SHOTGUN) ad_player_supersg1();
	else if (self.weapon == ad_IT_NAILGUN) ad_player_nail1();
	else if (self.weapon == ad_IT_SUPER_NAILGUN) ad_player_snail1();
	else if (self.weapon == ad_IT_GRENADE_LAUNCHER) ad_player_grenade1();
	else if (self.weapon == ad_IT_ROCKET_LAUNCHER) ad_player_rocket1();
	//----------------------------------------------------------------------
	else if (self.weapon == ad_IT_LIGHTNING) {
		if (self.ad_moditems & ad_IT_UPGRADE_LG) ad_player_plasma1();
		else {
			ad_player_light1(); 
			sound (self, ad_CHAN_AUTO, "weapons/lstart.wav", 1, ad_ATTN_NORM); 
		}
	}
};

/*======================================================================
 W_ChangeWeapon
 Check if got weapon and ammo and switch to relevant weapon
======================================================================*/
void(entity ad_targ) ad_W_ChangeWeapon =
{
	local float ad_it, ad_am, ad_fl;
	
	if (ad_intermission_running > 0) return;	// intermission or finale
	if (ad_cinematic_running > 0) return;		// Remote camera active
	ad_it = ad_targ.items;
	ad_am = ad_FALSE;
	
	if (ad_targ.impulse == 1) ad_fl = ad_IT_AXE;
	else if (ad_targ.impulse == 2) {
		ad_fl = ad_IT_SHOTGUN;
		if (ad_targ.ammo_shells < 1) ad_am = ad_TRUE;
	}
	else if (ad_targ.impulse == 3) {
		ad_fl = ad_IT_SUPER_SHOTGUN;
		if (ad_targ.ammo_shells < 2) ad_am = ad_TRUE;
	}		
	else if (ad_targ.impulse == 4) {
		ad_fl = ad_IT_NAILGUN;
		if (ad_targ.ammo_nails < 1) ad_am = ad_TRUE;
	}
	else if (ad_targ.impulse == 5) {
		ad_fl = ad_IT_SUPER_NAILGUN;
		if (ad_targ.ammo_nails < 2) ad_am = ad_TRUE;
	}
	else if (ad_targ.impulse == 6) {
		ad_fl = ad_IT_GRENADE_LAUNCHER;
		if (ad_targ.ammo_rockets < 1) ad_am = ad_TRUE;
	}
	else if (ad_targ.impulse == 7) {
		ad_fl = ad_IT_ROCKET_LAUNCHER;
		if (ad_targ.ammo_rockets < 1) ad_am = ad_TRUE;
	}
	else if (ad_targ.impulse == 8) {
		ad_fl = ad_IT_LIGHTNING;
		if (ad_targ.ammo_cells < 1) ad_am = ad_TRUE;
	}

	ad_targ.impulse = 0;		// Clear impulse
	
	//----------------------------------------------------------------------
	// FL = don't have the weapon
	// AM = out of ammo
	//----------------------------------------------------------------------
	if (!(ad_targ.items & ad_fl)) {
		if (ad_fl & ad_IT_AXE) sprint(ad_targ, "No Axe available\n");
		else if (ad_fl & ad_IT_SHOTGUN) sprint(ad_targ, "No Shotgun available\n");
		else if (ad_fl & ad_IT_SUPER_SHOTGUN) sprint(ad_targ, "No Super Shotgun available\n");
		else if (ad_fl & ad_IT_NAILGUN) sprint(ad_targ, "No Nailgun available\n");
		else if (ad_fl & ad_IT_SUPER_NAILGUN) sprint(ad_targ, "No Super Nailgun available\n");
		else if (ad_fl & ad_IT_GRENADE_LAUNCHER) sprint(ad_targ, "No Grenade Launcher available\n");
		else if (ad_fl & ad_IT_ROCKET_LAUNCHER) sprint(ad_targ, "No Rocket Launcher available\n");
		else if (ad_fl & ad_IT_LIGHTNING) sprint(ad_targ, "No Lightning Gun available\n");
	}
	else if (ad_am) sprint (ad_targ, "Not enough ammo\n");
	else {
		ad_targ.weapon = ad_fl;		// Switch to weapon (internal number)
		ad_W_SetCurrentAmmo (ad_targ);
	}
};

/*======================================================================
CycleWeaponCommand
======================================================================*/
void() ad_CycleWeaponCommand =
{
	local float ad_am;
	
	self.impulse = 0;						// reset impulse
	if (ad_intermission_running > 0) return;	// intermission or finale
	if (ad_cinematic_running > 0) return;		// Remote camera active
	if (self.weapon == 0) return;			// No weapons available

	// Keep cycling around weapon list until found a weapon with ammo
	while (1) {
		ad_am = 0;
		if (self.weapon == ad_IT_LIGHTNING) {
			self.weapon = ad_IT_AXE;
		}
		else if (self.weapon == ad_IT_AXE) {
			self.weapon = ad_IT_SHOTGUN;
			if (self.ammo_shells < 1) ad_am = 1;
		}
		else if (self.weapon == ad_IT_SHOTGUN) {
			self.weapon = ad_IT_SUPER_SHOTGUN;
			if (self.ammo_shells < 2) ad_am = 1;
		}		
		else if (self.weapon == ad_IT_SUPER_SHOTGUN) {
			// Check for configflag override of this feature
			if (ad_query_configflag(ad_SVR_MWHEELSKIP)) {
				self.weapon = ad_IT_NAILGUN;
				if (self.ammo_nails < 1) ad_am = 1;
			}
			else {
				// Only skip over the NG if the player has both!
				if (self.items & ad_IT_SUPER_NAILGUN && self.items & ad_IT_NAILGUN) {
					self.weapon = ad_IT_SUPER_NAILGUN;
					if (self.ammo_nails < 2) ad_am = 1;
				}
				else {
					self.weapon = ad_IT_NAILGUN;
					if (self.ammo_nails < 1) ad_am = 1;
				}
			}
		}
		else if (self.weapon == ad_IT_NAILGUN) {
			self.weapon = ad_IT_SUPER_NAILGUN;
			if (self.ammo_nails < 2) ad_am = 1;
		}
		else if (self.weapon == ad_IT_SUPER_NAILGUN) {
			self.weapon = ad_IT_GRENADE_LAUNCHER;
			if (self.ammo_rockets < 1) ad_am = 1;
		}
		else if (self.weapon == ad_IT_GRENADE_LAUNCHER) {
			self.weapon = ad_IT_ROCKET_LAUNCHER;
			if (self.ammo_rockets < 1) ad_am = 1;
		}
		else if (self.weapon == ad_IT_ROCKET_LAUNCHER) {
			self.weapon = ad_IT_LIGHTNING;
			if (self.ammo_cells < 1) ad_am = 1;
		}
	
		// Has the player got the weapons and ammo to switch?
		if ( (self.items & self.weapon) && !ad_am) {
			ad_W_SetCurrentAmmo (self);
			return;
		}
	}
};

/*======================================================================
CycleWeaponReverseCommand
======================================================================*/
void() ad_CycleWeaponReverseCommand =
{
	local float ad_am;
	
	self.impulse = 0;						// reset impulse
	if (ad_intermission_running > 0) return;	// intermission or finale
	if (ad_cinematic_running > 0) return;		// Remote camera active
	if (self.weapon == 0) return;			// No weapons available

	// Keep cycling around weapon list until found a weapon with ammo
	while (1) {
		ad_am = 0;
		if (self.weapon == ad_IT_LIGHTNING) {
			self.weapon = ad_IT_ROCKET_LAUNCHER;
			if (self.ammo_rockets < 1) ad_am = 1;
		}
		else if (self.weapon == ad_IT_ROCKET_LAUNCHER) {
			self.weapon = ad_IT_GRENADE_LAUNCHER;
			if (self.ammo_rockets < 1) ad_am = 1;
		}
		else if (self.weapon == ad_IT_GRENADE_LAUNCHER) {
			self.weapon = ad_IT_SUPER_NAILGUN;
			if (self.ammo_nails < 2) ad_am = 1;
		}
		else if (self.weapon == ad_IT_SUPER_NAILGUN) {
			// Check for configflag override of this feature
			if (ad_query_configflag(ad_SVR_MWHEELSKIP)) {
				self.weapon = ad_IT_NAILGUN;
				if (self.ammo_nails < 1) ad_am = 1;
			}
			else {
				// Only skip over the SNG if the player has it!
				if (self.items & ad_IT_SUPER_NAILGUN && self.items & ad_IT_SUPER_SHOTGUN) {
					// Skip over the nailgun and go straight to SSG
					self.weapon = ad_IT_SUPER_SHOTGUN;
					if (self.ammo_shells < 2) ad_am = 1;
				}
				else {
					self.weapon = ad_IT_NAILGUN;
					if (self.ammo_nails < 1) ad_am = 1;
				}
			}
		}
		else if (self.weapon == ad_IT_NAILGUN) {
			self.weapon = ad_IT_SUPER_SHOTGUN;
			if (self.ammo_shells < 2) ad_am = 1;
		}		
		else if (self.weapon == ad_IT_SUPER_SHOTGUN) {
			self.weapon = ad_IT_SHOTGUN;
			if (self.ammo_shells < 1) ad_am = 1;
		}
		else if (self.weapon == ad_IT_SHOTGUN) {
			self.weapon = ad_IT_AXE;
		}
		else if (self.weapon == ad_IT_AXE) {
			self.weapon = ad_IT_LIGHTNING;
			if (self.ammo_cells < 1) ad_am = 1;
		}
	
		if ( (self.items & self.weapon) && !ad_am) {
			ad_W_SetCurrentAmmo (self);
			return;
		}
	}
};

/*======================================================================
W_WeaponFrame
======================================================================*/
void() ad_W_WeaponFrame =
{
	ad_ImpulseCommands ();
	// Allow for impulse commands before weapon lockout
	if (time < self.ad_attack_finished) return;

	// check for attack
	if (self.button0) {
		// originally - SuperDamageSound
		// Only play one powerup sound at once
		if (self.super_damage_finished > 0 && self.ad_powerup_sound < time) {
			if (self.ad_super_sound < time) {
				self.ad_super_sound = time + 1;
				self.ad_powerup_sound = time + 1;
				sound (self, ad_CHAN_BODY, ad_SOUND_ARTQUAD3, 1, ad_ATTN_NORM);
			}
		}
		// Only play one powerup sound at once
		if (self.ad_sharpshoot_finished > 0 && self.ad_powerup_sound < time) {
			// Only works with the shotguns
			if (self.weapon == ad_IT_SHOTGUN || self.weapon == ad_IT_SUPER_SHOTGUN) {
				if (self.ad_sharpshooter_sound < time) {
					self.ad_sharpshooter_sound = time + 0.5;
					// Only play the sound every other shot
					self.ad_powerup_sound = time + 1;
					sound (self, ad_CHAN_BODY, ad_SOUND_ARTSHARP3, 1, ad_ATTN_NORM);
				}
			}
		}
		// Only play one powerup sound at once
		if (self.ad_nailpiercer_finished > 0 && self.ad_powerup_sound < time) {
			// Only works with nailgun + super nailgun
			if (self.weapon == ad_IT_NAILGUN || self.weapon == ad_IT_SUPER_NAILGUN) {
				if (self.ad_nailpiercer_sound < time) {
					self.ad_nailpiercer_sound = time + 0.5;
					self.ad_powerup_sound = time + 1;
					sound (self, ad_CHAN_BODY, ad_SOUND_ARTNAILP3, 1, ad_ATTN_NORM);
				}
			}
		}
		// Check for weapon updates
		ad_W_Attack ();
	}
};
