.float ad_movespeed;
.float ad_tetherlock;
float(float ad_yaw, float ad_dist) ad_walkmove = {
	if (self.ad_attack_state == ad_AS_TURRET) return ad_FALSE;
	if (self.ad_movespeed < 0) return ad_FALSE;
	if (self.ad_tetherlock == ad_TRUE) return ad_FALSE;
	return ad_walkmove_builtin(ad_yaw,ad_dist);
}
.vector ad_lastorigin;
void(float ad_step) ad_movetogoal = {
	// Save origin for cinematic camera angle interpolation
	// This does not cope with bmodel origins, only point entities
	self.ad_lastorigin = self.origin;
	if (self.ad_attack_state == ad_AS_TURRET) return;
	if (self.ad_movespeed < 0) return;
	if (self.ad_tetherlock == ad_TRUE) return;
	ad_movetogoal_builtin(ad_step);
}
.float ad_suppressCenterPrint;
void(entity ad_client, string ad_s1) ad_centerprint = {
	// Is the centerprint message being used by something else?
	if (!ad_client.ad_suppressCenterPrint)
		ad_centerprint_builtin(ad_client, ad_s1);
	else {
		// Send message to client console instead
		sprint(ad_client, "(centerprint) ");
		sprint(ad_client, ad_s1);
		sprint(ad_client, "\n");
	}
}
void(entity ad_client, string ad_s1, string ad_s2, string ad_s3) ad_centerprint3 = {
	// Is the centerprint message being used by something else?
	if (!ad_client.ad_suppressCenterPrint)
		ad_centerprint_msg3(ad_client, ad_s1, ad_s2, ad_s3);
	else {
		// Send message to client console instead
		sprint(ad_client, "(centerprint) ");
		sprint(ad_client, ad_s1);
		sprint(ad_client, ad_s2);
		sprint(ad_client, ad_s3);
		sprint(ad_client, "\n");
	}
}
void(entity ad_client, string ad_s1, string ad_s2, string ad_s3, string ad_s4, string ad_s5, string ad_s6, string ad_s7) ad_centerprint7 = {
	// Is the centerprint message being used by something else?
	if (!ad_client.ad_suppressCenterPrint)
		ad_centerprint_msg7(ad_client, ad_s1, ad_s2, ad_s3, ad_s4, ad_s5, ad_s6, ad_s7);
	else {
		// Send message to client console instead
		sprint(ad_client, "(centerprint) ");
		sprint(ad_client, ad_s1);
		sprint(ad_client, ad_s2);
		sprint(ad_client, ad_s3);
		sprint(ad_client, ad_s4);
		sprint(ad_client, ad_s5);
		sprint(ad_client, ad_s6);
		sprint(ad_client, ad_s7);
		sprint(ad_client, "\n");
	}
}
