void()	ad_hogreham_dieB9	=[	$deathB9,	ad_hogreham_dieB10	] {ad_hogreham_sound(3);};	// Hammer hits floor
void()	ad_hogreham_dieB10	=[	$deathB10,	ad_hogreham_dieB11	] {};
void()	ad_hogreham_dieB11	=[	$deathB11,	ad_hogreham_dieB12	] {};
void()	ad_hogreham_dieB12	=[	$deathB12,	ad_hogreham_dieB13	] {};
void()	ad_hogreham_dieB13	=[	$deathB13,	ad_hogreham_dieB14	] {ad_monster_death_postcheck();};
void()	ad_hogreham_dieB14	=[	$deathB14,	ad_hogreham_dieB14	] {ad_monster_deadbody_check();};
//----------------------------------------------------------------------
void() ad_hogreham_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		self.lip = random();
		if (self.lip < 0.5) ad_hogreham_dieA1();
		else ad_hogreham_dieB1();
	}
};

//============================================================================
void(float ad_soundtype) ad_hogreham_sound =
{
	if (ad_soundtype == 1) sound (self, ad_CHAN_VOICE, "ogre/ogdrag.wav", 1, ad_ATTN_IDLE);
	else if (ad_soundtype == 2) sound (self, ad_CHAN_WEAPON, "ogre/ogsawatk.wav", 1, ad_ATTN_NORM);
	else if (ad_soundtype == 3) sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_WOOD, 1, ad_ATTN_NORM);
	else if (ad_soundtype == 4) sound (self, ad_CHAN_VOICE, "ogre/ham_swipe.wav", 1, ad_ATTN_IDLE);
};

//----------------------------------------------------------------------
// Special wakeup animation for attacking/breaking something infront
// The monster should be setup facing the right direction before call
// Starts in large overhead swing downwards (no damage checks)
//----------------------------------------------------------------------
void() ad_hogreham_wakeup1a	=[	$smash7,		ad_hogreham_wakeup2a ] {ad_monster_sightsound();};
void() ad_hogreham_wakeup2a	=[	$smash6,		ad_hogreham_wakeup3a ] {};
void() ad_hogreham_wakeup3a	=[	$smash8,		ad_hogreham_wakeup4a ] {};
void() ad_hogreham_wakeup4a	=[	$smash9,		ad_hogreham_wakeup5a ] {};
void() ad_hogreham_wakeup5a	=[	$smash10,		ad_hogreham_wakeup6a ] {};
void() ad_hogreham_wakeup6a	=[	$smash11,		ad_hogreham_wakeup7a ] {};
void() ad_hogreham_wakeup7a	=[	$smash12,		ad_hogreham_wakeup8a ] {};
void() ad_hogreham_wakeup8a	=[	$smash13,		ad_hogreham_wakeup9a ] {};
void() ad_hogreham_wakeup9a	=[	$smash14,		ad_hogreham_run1	] {};

//======================================================================
/*ad:QUAKED monster_hogreham (0.5 0.75 0) (-32 -32 -24) (32 32 64) AMBUSH x METAL NOSIGHT NOIDLE NOGFX STARTOFF ANGRY Not_Easy Not_Normal Not_Hard Not_DM
{ model(":progs/mon_hogreham.mdl"); }
Ogre, 300 health points.
-------- KEYS --------
-------- SPAWNFLAGS --------
METAL : Full plate metal armour and +100HP
-------- NOTES --------

======================================================================*/
void() ad_monster_hogreham =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_hogreham.mdl";		// New Ogre Model
	self.ad_headmdl = "progs/h_hogreham.mdl";		// Large head
	self.ad_gib1mdl = "progs/w_ogreham.mdl";		// Ogre Hammer (3 skins)
	self.ad_gib2mdl = "progs/gib_ogfoot1.mdl";		// Left foot
	self.ad_gib3mdl = "progs/gib_ogfoot2.mdl";		// Right foot
	self.ad_gib4mdl = "progs/w_ogregl.mdl";		// Grenade Launcher

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_GRENADE);
	precache_model (ad_MODEL_PROJ_RINGSHOCK);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib4mdl);
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	
	self.ad_idle_sound = "ogre/ogidle.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_idle_soundcom = "ogre/ogidle2.wav";
	precache_sound (self.ad_idle_soundcom);

	precache_sound ("ogre/ogdrag.wav");		// Chainsaw scrap on floor sound
	self.ad_death_sound = "ogre/ogdth.wav";
	precache_sound (self.ad_death_sound);		// Death sound
	self.ad_pain_sound = "ogre/ogpain1.wav";
	precache_sound (self.ad_pain_sound);		// Pain
	
	precache_sound ("ogre/ogsawatk.wav");	// Attack
	precache_sound ("ogre/ham_swipe.wav");	// hammer swipe
	precache_sound ("ogre/ham_hit.wav");	// hammer hit ground
	precache_sound ("ogre/ham_wave.wav");	// hammer shockwave
	
	self.ad_meleehitsound = ad_GIB_SOUND_HEAVY;
	precache_sound (self.ad_meleehitsound);	// hammer hit

	self.ad_sight_sound = "ogre/ogwake.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	
	// Upgraded ogre health 300 with metal+ option
	if (self.health < 1) self.health = 300;
	if (self.spawnflags & ad_MON_HOGRE_METAL) {
		self.health = self.health + ad_MON_HOGRE_METUPG;
		// make sure correct skin for hammer
		self.ad_gib1skin = 1;
		self.skin = 1;
	}
	else {
		// Random chance to switch GL for hammer
		if (random() < 0.5) self.ad_gib1mdl = self.ad_gib4mdl;
	}
	self.ad_gib4mdl = "";
		
	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_GRENADEGRN);
	}

	self.ad_gibhealth = -80;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 100;
	self.ad_pain_timeout = 2;		// High pain resistance
	self.ad_pain_longanim = ad_FALSE;
	self.ad_steptype = ad_FS_TYPEHEAVY;
	self.ad_attack_explosive = ad_TRUE;			// Has explosive attack
	self.ad_meleecontact = ad_FALSE;				// Smash contact
	self.ad_meleerange = ad_MONAI_MELEEBLUNTOGRE;	// Hammer range
	self.ad_movespeed = 0;						// Cannot be turret
	self.ad_deathstring = " was pulverized by a Hammer Ogre\n";
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_OgreHamCheckAttack;
	self.ad_th_stand = ad_hogreham_stand1;
	self.ad_th_walk = ad_hogreham_walk1;
	self.ad_th_run = ad_hogreham_run1;
	self.ad_th_die = ad_hogreham_die;
	self.ad_th_melee = ad_hogreham_melee;
	self.ad_th_missile = ad_hogreham_shoot1;
	self.ad_th_pain = ad_hogreham_pain;
	self.ad_th_wakeup = ad_hogreham_wakeup1a;
	
	if (self.ammo_rockets < 0) self.ammo_rockets = 0;
	else if (self.ammo_rockets == 0) self.ammo_rockets = 4;
	self.ad_classtype = ad_CT_MONHOGREHAM;	// new style hunter ogre
	self.ad_classgroup = ad_CG_OGRE;			// One big happy ogre family!
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
};
