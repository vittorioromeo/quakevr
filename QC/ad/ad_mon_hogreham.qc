void() ad_hogreham_slam7	=[	$slam7,		ad_hogreham_slam8	] {ad_ai_face();};
void() ad_hogreham_slam8	=[	$slam8,		ad_hogreham_slam9	] {ad_ai_face();};
void() ad_hogreham_slam9	=[	$slam9,		ad_hogreham_slam10	] {ad_ai_charge(6);
	// Chance of ogre roar (sightsight) instead of weapon swipe
	if (random() < 0.2) sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_IDLE);
	else ad_hogreham_sound(4);
};
void() ad_hogreham_slam10	=[	$slam10,	ad_hogreham_slam11 ] {ad_ai_charge(8);};
void() ad_hogreham_slam11	=[	$slam11,	ad_hogreham_slam12 ] {ad_ai_charge(8);};
void() ad_hogreham_slam12	=[	$slam12,	ad_hogreham_slam13 ] {ad_ai_charge(4);};
void() ad_hogreham_slam13	=[	$slam13,	ad_hogreham_slam14 ] {
	ad_ai_chargenoturn(4); self.ad_meleehitsound = "ogre/ham_wave.wav";
	ad_ai_shockwave(ad_MONAI_HAMMERIMPACT, ad_MONAI_HAMMERDAMAGE, ad_MONAI_HAMMERRADIUS, ad_MONAI_HAMMERFORWARD, ad_MONAI_HAMMERUP);
};
void() ad_hogreham_slam14	=[	$slam14,	ad_hogreham_slam15 ] {ad_ai_chargenoturn(3);};
void() ad_hogreham_slam15	=[	$slam15,	ad_hogreham_slam16 ] {};
void() ad_hogreham_slam16	=[	$slam16,	ad_hogreham_slam17 ] {};
void() ad_hogreham_slam17	=[	$slam17,	ad_hogreham_run1 ] {
	// Double check enemy is still alive?
	if (self.enemy.health > 1) {
		// If the enemy is visible, quickly fire a grenade at them
		if (ad_visxray(self.enemy, self.view_ofs, self.enemy.view_ofs, ad_FALSE)) {
			self.ad_attack_state = ad_AS_MISSILE;
			self.think = self.ad_th_missile;
		}
	}
};

//----------------------------------------------------------------------
void() ad_hogreham_melee =
{
	// Hammer ogres don't get interrupted with pain for melee
	self.ad_pain_finished = time + 2;
	if (self.spawnflags & ad_MON_HOGRE_METAL) ad_hogreham_slam1();
	else {
		self.lip = random();
		if (self.lip < 0.5) ad_hogreham_smash1();
		else ad_hogreham_swing1();
	}
};

/*============================================================================
 OgreFireGrenade (use version in mon_ogre.qc)
============================================================================*/
void() ad_hogreham_shoot1	=[	$shoot1,		ad_hogreham_shoot2	] {ad_ai_face(); 
	ad_MonsterGrenadeSound(); self.ad_attack_speed = ad_MonsterGrenadeSpeed();
	self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.enemy.origin, self.ad_attack_speed); };
void() ad_hogreham_shoot2	=[	$shoot2,		ad_hogreham_shoot3	] {ad_ai_face(); 
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, self.ad_attack_speed); };
void() ad_hogreham_shoot3	=[	$shoot3,		ad_hogreham_shoot4	] {ad_ai_face(); 
	self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, self.ad_attack_speed); };
void() ad_hogreham_shoot4	=[	$shoot4,		ad_hogreham_shoot5	] {ad_ai_face();
	ad_MonsterFireGrenade(self.origin, self.enemy.origin);};
void() ad_hogreham_shoot5	=[	$shoot5,		ad_hogreham_shoot6	] {ad_ai_face();};
void() ad_hogreham_shoot6	=[	$shoot6,		ad_hogreham_shoot7	] {ad_ai_face();};
void() ad_hogreham_shoot7	=[	$shoot7,		ad_hogreham_run1	] {ad_ai_face();};

