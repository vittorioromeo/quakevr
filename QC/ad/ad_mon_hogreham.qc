void() ad_hogreham_smash6	=[	$smash6,	ad_hogreham_smash7	] {ad_ai_face();};
void() ad_hogreham_smash7	=[	$smash7,	ad_hogreham_smash8	] {ad_ai_face();};
void() ad_hogreham_smash8	=[	$smash8,	ad_hogreham_smash9	] {ad_ai_face();ad_monster_footstep(ad_FALSE);};
void() ad_hogreham_smash9	=[	$smash9,	ad_hogreham_smash10 ] {ad_ai_face();};
void() ad_hogreham_smash10	=[	$smash10,	ad_hogreham_smash11 ] {ad_ai_face();
	self.ad_meleehitsound = ad_GIB_SOUND_HEAVY;
	self.ad_meleecontact = ad_TRUE;ad_ai_meleesmash(30);self.ad_meleecontact = ad_FALSE;
	makevectors (self.angles);				// Put impact infront of ogre
	self.finalangle = self.origin + (v_forward * 56) + (-v_up * 22);
	ad_particle_explode(self.finalangle, 24, 0.5, ad_PARTICLE_BURST_FIRE, ad_PARTICLE_BURST_SHOCKWAVE); 
	sound (self, ad_CHAN_WEAPON, "ogre/ham_hit.wav", 1, ad_ATTN_IDLE);
};
