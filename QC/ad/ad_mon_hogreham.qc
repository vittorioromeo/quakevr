//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_hogreham_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
	
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			self.lip = random();
			if (self.lip < 0.65) ad_hogreham_painA1 ();
			else if (self.lip < 0.85) {
				self.ad_pain_finished = time + 2;
				// Stagger backwards
				ad_hogreham_painB1 ();
			}
			else {
				self.ad_pain_finished = time + 2;
				// Fall on the floor
				ad_hogreham_painC1 ();
			}
		}
		if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_axhitme = 0;
			if (random() < 0.5) {
				self.ad_pain_finished = time + 1.3;
				ad_hogre_painC1 ();	// Fall to ground
			}
			else {
				self.ad_pain_finished = time + 1.7;
				ad_hogre_painB1 ();	// Stagger backwards
			}
		}
	}
};

