void()	ad_dprince_stand1	=[	$stand1,	ad_dprince_stand2	] {ad_monster_idle_sound();ad_ai_stand();};
void()	ad_dprince_stand2	=[	$stand2,	ad_dprince_stand3	] {ad_ai_stand();};
void()	ad_dprince_stand3	=[	$stand3,	ad_dprince_stand4	] {ad_ai_stand();};
