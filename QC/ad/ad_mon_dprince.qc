void()	ad_dprince_char_a7	=[	$char_a7,	ad_dprince_char_a8	] {ad_ai_charge(21); ad_ai_melee(); ad_dprince_sword_sound();};
void()	ad_dprince_char_a8	=[	$char_a8,	ad_dprince_char_a9	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(13); ad_ai_melee();};
