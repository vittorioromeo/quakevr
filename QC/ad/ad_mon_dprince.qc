void()	ad_dprince_slice10	=[	$slice13,	ad_dprince_slice11	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(0);};
void()	ad_dprince_slice11	=[	$slice14,	ad_dprince_run1	] {ad_ai_charge(3);};

//----------------------------------------------------------------------
// Melee Attack 2 - Smash (chop overhead to ground)
// Hell Knight - 11 frames / Death Knight - 15 frames (skipped (1, 11, 14, 15)
// Death Knight frames trimmed down to match Hell Knight (damage ratio)

void()	ad_dprince_smash1	=[	$smash2,	ad_dprince_smash2	] {ad_ai_charge(1);};
