//============================================================================
// Cycle between 3 melee attacks
// Attack 1 - Slice (one hand slashing run attack)
// Attack 2 - Smash (chop overhead to ground)
// Attack 3 - W_Attack (two handed slashing attack)

//----------------------------------------------------------------------
void() ad_dprince_melee =
{
	// Do heavy overhead attack against other monsters
	if (self.enemy.flags & ad_FL_MONSTER) ad_dprince_smash1();
	else {
		// Cycle around 3 melee attacks against player
		self.ad_meleeattack = self.ad_meleeattack + 1;

		// Slice = Swing attack, Smash = Overhead down, Watk = long swing
		if (self.ad_meleeattack == 1) ad_dprince_slice1 ();
		else if (self.ad_meleeattack == 2) ad_dprince_smash1 ();
		else {
			ad_dprince_watk1 ();
			self.ad_meleeattack = 0;
		}
	}
};

//======================================================================
// Magic Attacks - Range Far = Rockets, Range Near = Hazard
//----------------------------------------------------------------------
void() ad_dprince_rocket =
{
	local vector ad_org, ad_dir, ad_avel;
	
	if (!self.enemy) return;
	if (self.enemy.health < 1) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;	
	sound (self, ad_CHAN_WEAPON, "hknight/attack1.wav", 1, ad_ATTN_NORM);

	// Re-use spike projectile speeds
	// Maximum speed, initial speed set in Launch_Missile
	self.ad_attack_speed = ad_SPEED_DPRINCEBOLT + (ad_skill * ad_SPEED_DPRINCESKILL);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = normalize(self.ad_attack_track - ad_org);
	ad_avel = ad_avel = ad_vecrand(100,200,ad_FALSE);
	
	// Colour type and trail selected in missile function
	ad_Launch_Missile(ad_org, ad_dir, ad_avel, ad_CT_PROJ_DPRINCE1, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void(float ad_offset) ad_dprince_hazard =
{
	local vector ad_org, ad_torg, ad_dir, ad_ang, ad_avel;
	local float ad_targetang, ad_haz_loop;
	
	if (!self.enemy) return;
	if (self.enemy.health < 1) return;
	if (self.health < 1) return;

	sound (self, ad_CHAN_WEAPON, "hknight/attack1.wav", 1, ad_ATTN_NORM);

	makevectors (self.angles);	
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	if (ad_skill <= ad_SKILL_NORMAL) ad_haz_loop = 1;
	else ad_haz_loop = 2;
	
	while(ad_haz_loop > 0) {
		// Keep looping
		ad_haz_loop = ad_haz_loop - 1;
		ad_torg = self.enemy.origin;
		// Last projectile (0) is direct at enemy
		if (ad_haz_loop > 0) {
			// Very large random area around target
			ad_torg_x = ad_torg_x + (ad_crandom() * 128);
			ad_torg_y = ad_torg_y + (ad_crandom() * 128);
		}
		// Work out elevation towards target origin
		ad_targetang = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, ad_torg, ad_SPEED_DPRINCE);
		ad_ang = vectoangles(ad_torg - ad_org);
		ad_ang_x = -ad_targetang;
		makevectors (ad_ang);
		// fire projectile in arc pattern (offset)
		ad_dir = ( (v_forward * (0.75 + random()*0.25)) + (v_right * (ad_offset*0.1)) ) * ad_SPEED_DPRINCE;	
		// Some random angle rotation
		ad_avel = ad_vecrand(100,200,ad_FALSE);
		ad_Launch_Hazard(ad_org, ad_dir, ad_avel, ad_CT_PROJ_DPRINCE2);
	}
};

//----------------------------------------------------------------------
void() ad_dprince_magicframe =
{
	if (self.health < 1) return;
	if (!self.enemy) return;
	
	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_dprince_magicframe;
	
	// 2=Rockets use direct tracking system
	if (self.ad_weaponstate == 2) {
		// check for enemy origin (based on sight test)
		// if cannot see enemy fire at last known location
		if (self.ad_walkframe == 0) self.ad_attack_track = self.enemy.origin;
		else ad_ai_trackenemy();
		
		// Start projectile attacks
		// Easy = 1, Normal = 2, Hard/NM = 3
		if (self.ad_walkframe == 4 && ad_skill >= ad_SKILL_NORMAL) ad_dprince_rocket();
		else if (self.ad_walkframe == 6) ad_dprince_rocket();
		else if (self.ad_walkframe == 8 && ad_skill >= ad_SKILL_HARD) ad_dprince_rocket();
	}
	else {
		// Hazard attack uses elevation tracking
		if (self.ad_walkframe <= 5) ad_ai_face();
		
		// Fine tune projectile elevation
		if (self.ad_walkframe == 0) 
			self.ad_attack_elev = ad_SUB_Elevation(ad_ELEV_DEFAULT, self.origin, self.enemy.origin, ad_SPEED_DPRINCE);
		else if (self.ad_walkframe > 0 && self.ad_walkframe < 5)
			self.ad_attack_elev = ad_SUB_Elevation(self.ad_attack_elev, self.origin, self.enemy.origin, ad_SPEED_DPRINCE);
		// Start projectile attacks (no facing)
		if (self.ad_walkframe == 5) ad_dprince_hazard(-2);
		else if (self.ad_walkframe == 6) ad_dprince_hazard(-1);
		else if (self.ad_walkframe == 7) ad_dprince_hazard(0);
		else if (self.ad_walkframe == 8) ad_dprince_hazard(1);
		else if (self.ad_walkframe == 9) ad_dprince_hazard(2);
		else if (self.ad_walkframe == 10) ad_dprince_hazard(3);
	}
		
	// Update frame and move forward
	self.frame = $magicc2 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 10) self.ad_th_run();
};

void() ad_dprince_range = { self.ad_walkframe = 0; ad_dprince_magicframe();};

