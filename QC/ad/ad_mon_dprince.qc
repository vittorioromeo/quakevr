//----------------------------------------------------------------------
void() ad_dprince_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dprince_die1 ();
		else ad_dprince_dieb1 ();
	}
};

//============================================================================
void() ad_dprince_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

/*======================================================================
QUAKED monster_dprince (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_dprince =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dprince.mdl";			// New Hell Knight
	self.ad_headmdl = "progs/h_dprince.mdl";
	self.ad_gib1mdl = "progs/w_dprincesword.mdl";	// Unique sword
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";	// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";	// right foot

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	precache_model (self.ad_gib1mdl);

	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib2mdl = "";
	if (random() < 0.5) self.ad_gib3mdl = "";

	if (self.spawnflags & ad_MON_DPRINCE_FIRE) {
		// red version (new)
		self.ad_exactskin = 1;						// Red armour
		self.ad_gib1skin = 1;						// Red sword
		self.ad_part_trstyle = ad_PARTICLE_TRAIL_RED;
		self.ad_attack_proj1 = ad_MODEL_PROJ_DPRINCE1R;	// Steering rocket
		self.ad_attack_proj2 = ad_MODEL_PROJ_DPRINCE2R;	// Red hazard plasma
	}
	else {
		// blue version (default)
		self.ad_part_trstyle = ad_PARTICLE_TRAIL_BLUE;
		self.ad_attack_proj1 = ad_MODEL_PROJ_DPRINCE1B;	// Steering rocket
		self.ad_attack_proj2 = ad_MODEL_PROJ_DPRINCE2B;	// Blue hazard plasma
	}
	precache_model (self.ad_attack_proj1);	
	precache_model (self.ad_attack_proj2);	
	
	self.ad_idle_sound = "hknight/idle.wav";
	precache_sound (self.ad_idle_sound);

	// Firing of magic spikes (first 0.1s must loop)
	precache_sound ("hknight/attack1.wav");

	// TE_KNIGHTSPIKE = Magic spike hitting the wall
	// Has got to be in this location because the
	// filename is hardcoded (engine.exe)
	precache_sound ("hknight/hit.wav");
	precache_sound ("dknight/dprince_miss.wav");

	self.ad_sight_sound = "hknight/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.ad_pain_sound = "hknight/pain1.wav";
	self.ad_death_sound = "hknight/death1.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_death_sound);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 400;

	self.ad_gibhealth = -50;
	self.ad_gibbed = ad_FALSE;				// Starts complete
	self.ad_pain_flinch = 400;				// Really low chance of pain
	self.ad_pain_longanim = ad_FALSE;			// cannot be chopped with shadow axe
	self.ad_pain_timeout = 2;				// High pain level
	if (self.ad_infightextra <= 0) self.ad_infightextra = 4; // High infighting damage
	self.ad_steptype = ad_FS_TYPEHEAVY;		// Heavy feet
	self.ad_poisonous = ad_FALSE;				// No Poison version
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	self.ad_meleecontact = ad_FALSE;			// Smash contact
	self.ad_meleerange = ad_MONAI_MELEEFRONT;	// Smash attack
	self.ad_attack_offset = '20 0 8';		// Middle of body (id location)
	self.ad_attack_count = 6;				// Default floor projectiles
	self.ad_deathstring = " was annihilated by a Dark Prince\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = self.ad_resist_rockets = 0;
	self.ad_resist_cells = 0.75;
	self.ad_reflectlightning = ad_TRUE;	// Reflect lightning strikes
	self.ad_reflectplasma = ad_TRUE;		// Reflect plasma projectiles

	self.ad_th_checkattack = ad_DPrinceCheckAttack;
	self.ad_th_stand = ad_dprince_stand1;
	self.ad_th_walk = ad_dprince_walk1;
	self.ad_th_run = ad_dprince_run1;
	self.ad_th_melee = ad_dprince_melee;
	self.ad_th_charge = ad_dprince_char_a1;
	self.ad_th_missile = ad_dprince_range;
	self.ad_th_pain = ad_dprince_pain;
	self.ad_th_die = ad_dprince_die;

	// randomize last melee attack
	self.ad_meleeattack = rint(random()*3);

	self.ad_classtype = ad_CT_MONDPRINCE;
	self.ad_classgroup = ad_CG_DCAPTAIN;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	// Start monster (default)
	ad_monster_start();
};
