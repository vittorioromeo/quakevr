// AD's readme and docs/vr-port/CREDITS.md), my_progs/mon_invsword.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*====================================================================
SWORD
======================================================================*/
$cd /qwork/xpack/models/sword
$origin 0 0 24
$base base
$skin badass3

// Upright
$frame stand1

// Running with sword out (stab action)
$frame run1 run2 run3 run4 run5 run6 run7 run8

// Overhead smash attack
$frame melee1 melee2 melee3 melee4 melee5 melee6 melee7 melee8
$frame melee9 melee10

$frame death1 death2 death3 death4 death5 death6 death7 death8
$frame death9 death10

$frame deathb1 deathb2 deathb3 deathb4 deathb5 deathb6 deathb7 deathb8
$frame deathb9 deathb10 deathb11

float ad_SWORD_STAND = 1;
float ad_SWORD_WALK = 5;
float ad_SWORD_RUN = 10;

//============================================================================
void() ad_invsword_sword_sound =
{
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

//======================================================================
void() ad_invsword_stand1 = [ $stand1, ad_invsword_stand1] {ad_ai_stand();};
void() ad_invsword_stand = { self.state = ad_SWORD_STAND; ad_invsword_stand1(); };

//======================================================================
// Walk and run use the same animations, but with different move speeds
// Model has no walk like animation (great shame)
void() ad_invsword_runframe =
{
	// Dead swords are dead!
	if (self.health < 1) return;
	
	// Pain Animation unblocked
	self.ad_attack_timer = ad_FALSE;
	// No more delays on wakeup
	self.delay = 0;

	// Keep looping
	self.nextthink = time + 0.1;
	self.think = ad_invsword_runframe;

	// animation block events
	if (self.ad_walkframe == 0) ad_invsword_sword_sound();
	if (self.ad_walkframe == 4 && self.state == ad_SWORD_RUN) 
		ad_invsword_sword_sound();

	// Update frame and move forward
	self.frame = $run1 + self.ad_walkframe;
	self.ad_walkframe = self.ad_walkframe + 1;
	// Finished animation set?
	if (self.ad_walkframe > 7) self.ad_walkframe = 0;
	
	// Walk/Run
	if (self.state == ad_SWORD_WALK) ad_ai_walk(7);
	else ad_ai_run(14);
};

//----------------------------------------------------------------------
void() ad_invsword_walk =  { 
	self.ad_walkframe = 0; self.state = ad_SWORD_WALK;
	ad_invsword_runframe();
};

//----------------------------------------------------------------------
void() ad_invsword_run =  { 
	self.ad_walkframe = 0; self.state = ad_SWORD_RUN;
	// Any wakeup delay?
	if (self.delay == 0) ad_invsword_runframe();
	else {
		self.think = ad_invsword_runframe;
		self.nextthink = time + self.delay;
	}
};

//----------------------------------------------------------------------
// MELEE attack - overhead swing
//----------------------------------------------------------------------
void() ad_invsword_atk1 =[ $melee1, ad_invsword_atk2] {
	ad_invsword_sword_sound(); ad_ai_charge(14);};
void() ad_invsword_atk2 =[ $melee2, ad_invsword_atk3] {ad_ai_charge(14);};
void() ad_invsword_atk3 =[ $melee3, ad_invsword_atk4] {ad_ai_charge(14);};
void() ad_invsword_atk4 =[ $melee4, ad_invsword_atk5] {ad_ai_charge(14);};
void() ad_invsword_atk5 =[ $melee5, ad_invsword_atk6] {
	ad_invsword_sword_sound(); ad_ai_melee();};
void() ad_invsword_atk6 =[ $melee6, ad_invsword_atk7] {ad_ai_melee();};
void() ad_invsword_atk7 =[ $melee7, ad_invsword_atk8] {ad_ai_melee();};
void() ad_invsword_atk8 =[ $melee8, ad_invsword_atk9] {
	ad_invsword_sword_sound(); ad_ai_charge(14);};
void() ad_invsword_atk9 =[ $melee9, ad_invsword_atk10] {ad_ai_charge(14);};
void() ad_invsword_atk10 =[ $melee10,ad_invsword_run] {ad_ai_charge(14);};

//======================================================================
void() ad_invsword_pain1 =[ $melee2, ad_invsword_pain2] {ad_ai_back(3);}
void() ad_invsword_pain2 =[ $melee3, ad_invsword_pain3] {ad_ai_back(3);}
void() ad_invsword_pain3 =[ $melee4, ad_invsword_pain4] {ad_ai_back(2);}
void() ad_invsword_pain4 =[ $melee5, ad_invsword_run] {}

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_invsword_pain =
{
	// Block pain on first combat wakeup
	if (self.ad_attack_timer == ad_TRUE) return;
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		// Only do pain animation if required
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2)
			ad_invsword_pain1();
	}
};

//======================================================================
void() ad_invsword_die1 =[ $death1, ad_invsword_die2] {};
void() ad_invsword_die2 =[ $death2, ad_invsword_die3] {ad_monster_check_gib();};
void() ad_invsword_die3 =[ $death3, ad_invsword_die4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_invsword_die4 =[ $death4, ad_invsword_die5] {};
void() ad_invsword_die5 =[ $death5, ad_invsword_die6] {};
void() ad_invsword_die6 =[ $death6, ad_invsword_die7] {};
void() ad_invsword_die7 =[ $death7, ad_invsword_die8] {
	sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_METALB, 1, ad_ATTN_NORM);};
void() ad_invsword_die8 =[ $death8, ad_invsword_die9] {};
void() ad_invsword_die9 =[ $death9, ad_invsword_die10] {ad_monster_death_postcheck();};
void() ad_invsword_die10 =[ $death10, ad_invsword_die10] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_invsword_dieb1 =[ $deathb1, ad_invsword_dieb2] {};
void() ad_invsword_dieb2 =[ $deathb2, ad_invsword_dieb3] {ad_monster_check_gib();};
void() ad_invsword_dieb3 =[ $deathb3, ad_invsword_dieb4] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_invsword_dieb4 =[ $deathb4, ad_invsword_dieb5] {};
void() ad_invsword_dieb5 =[ $deathb5, ad_invsword_dieb6] {};
void() ad_invsword_dieb6 =[ $deathb6, ad_invsword_dieb7] {};
void() ad_invsword_dieb7 =[ $deathb7, ad_invsword_dieb8] {
	sound (self, ad_CHAN_WEAPON, ad_GIB_SOUND_METALB, 1, ad_ATTN_NORM);};
void() ad_invsword_dieb8 =[ $deathb8, ad_invsword_dieb9] {};
void() ad_invsword_dieb9 =[ $deathb9, ad_invsword_dieb10] {};
void() ad_invsword_dieb10 =[ $deathb10, ad_invsword_dieb11] {ad_monster_death_postcheck();};
void() ad_invsword_dieb11 =[ $deathb11, ad_invsword_dieb11] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_invsword_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	sound (self, ad_CHAN_VOICE, self.ad_death_sound, 1, ad_ATTN_NORM);
	if (random() > 0.5) ad_invsword_die1 ();	// Forward
	else ad_invsword_dieb1 ();					// Backward
};

/*======================================================================
 QUAKED monster_sword (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_sword =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_sword.mdl";
	precache_model (self.mdl);
	
	self.ad_gib1sound = ad_GIB_IMPACT_METALA;
	if (random() < 0.5) self.ad_gib2mdl = "";
	if (random() < 0.5) self.ad_gib3mdl = "";

	self.ad_idle_sound = ad_SOUND_EMPTY;
	precache_sound (self.ad_idle_sound);
	
	// precache sight, pain and death!
	self.ad_sight_sound = "knight/ksight.wav";
	precache_sound (self.ad_sight_sound);
	self.ad_pain_sound = ad_SOUND_IMP_METAL2;
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = ad_SOUND_BRK_METAL;
	precache_sound (self.ad_death_sound);

	// Dead impact sound for sword on ground
	precache_sound (ad_GIB_SOUND_METALB);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = 75;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;				// Still in one peice
	self.ad_pain_flinch = 30;				// Low pain threshold
	self.ad_attack_timer = ad_TRUE;			// Pain blocked on wakeup
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_pain_longanim = ad_FALSE;			// No long stagger animation
	self.ad_bleedcolour = ad_MON_BCOLOR_WHITE;	// Grey dust
	self.ad_steptype = ad_FS_FLYING;			// Where's the tiny swordfeet!
	self.ad_deathstring = " was slit open by a Phantom Swordsman\n";

	// Short delay before combat?
	if (self.delay <= 0) self.delay = 0.1;
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_stand = ad_invsword_stand;		// Standing upright
	self.ad_th_walk = ad_invsword_walk;		// There is no walk
	self.ad_th_run = ad_invsword_run;			// Running
	self.ad_th_melee = ad_invsword_atk1;		// Sword attack
	self.ad_th_pain = ad_invsword_pain;		// No pain, just sound
	self.ad_th_die = ad_invsword_die;			// fall to floor
	
	self.ad_classtype = ad_CT_MONINVSWORD;
	self.ad_classtype = ad_CT_MONKNIGHT;
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();	
};

