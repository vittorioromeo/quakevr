// AD's readme and docs/vr-port/CREDITS.md), my_progs/part_generate.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 Generate PARTICLES

 PRIMARY SPRITE/MODE PARTICLE EMITTER FUNCTION
 - Designed for Fitz type engines (retro pixel goodness)

 DPP particle functions
 - float(string effectname) particleeffectnum
 - -void(entity ent, float effectnum, vector start, vector end) trailparticles
 - -void(float effectnum, vector org, vector vel, float howmany) pointparticles
 
======================================================================*/
void() ad_emit_particle;
float() ad_emit_checksource =
{
	// killtarget can easily destroy connections between entities
	// Some particle emitter types rely on the source entity connection
	// Quake maintains all entities in one list with a number as reference
	// If an entity is deleted the entity number can be given to any new
	// entity spawned. This is not a reference to the original entity but
	// it is just a location in a list. 
	// To get around this problem any entity that spawns a particle
	// emitter will generate an unique number which the emitter will
	// keep track of and compare to make sure the connection is valid.
	//
	// Particle effect was setup for static entity, leave it alone
	//if (self.part_static == TRUE) return FALSE;
	
	// If the connection is broken, destroy particle emitter
	if (self.ad_entno_unique != self.ad_pemit_source.ad_entno_unique)
		self.ad_part_style = ad_PARTICLE_STYLE_EMPTY;
		
	if (self.ad_part_style == ad_PARTICLE_STYLE_EMPTY) self.state = ad_STATE_OFF;
	// Exception - respawning particle are never blocked!
	else if (self.ad_part_style != ad_PARTICLE_STYLE_RESPAWN) {
		// Has the particle emitter SOURCE been switched off?
		if (self.ad_pemit_source.ad_estate & ad_ESTATE_BLOCK) self.state = ad_STATE_OFF;
	}
	
	// Final check to see if emitter is active or not?
	if (self.state == ad_STATE_OFF) { self.ad_estate = ad_ESTATE_OFF; return ad_TRUE; }
	else return ad_FALSE;
};

//----------------------------------------------------------------------
void() ad_emitdpp_particle = {
	
	// Check source entity and style type are valid
	if (ad_emit_checksource()) return;

	// Double check DP particles active? (quickload issues)
	// If not active, revert back to Fitz/particle system
	if (!ad_ext_dppart) {
		self.think = ad_emit_particle;
		self.nextthink = time + random();
		// Check if particle banks need extending
		ad_extend_particlechain();
		return;
	}
	
	if (self.ad_pemit_target) {
		// Easier solution for finding particle direction (velocity)
		// Subtract target from source and normalize (range 0-1)
		// Previous version was using vectoangles (was broken)
		self.ad_dpp_vel = normalize(self.ad_pemit_target.origin - self.ad_pemit_source.origin);
	}

	// Check for volume particle spawning
	if (!ad_CheckZeroVector(self.ad_part_vol)) {

		// Check if owner is a Bmodel? (different origin location)
		if (self.ad_pemit_source.ad_bsporigin)
			self.pos1 = self.ad_pemit_source.origin + ad_bmodel_origin(self.ad_pemit_source);
		else self.pos1 = self.ad_pemit_source.origin;

		self.pos1_x = self.pos1_x + ( (random()*(self.ad_part_vol_x*2)) - self.ad_part_vol_x);
		self.pos1_y = self.pos1_y + ( (random()*(self.ad_part_vol_y*2)) - self.ad_part_vol_y);
		self.pos1_z = self.pos1_z + ( (random()*(self.ad_part_vol_z*2)) - self.ad_part_vol_z);
	}
	else self.pos1 = self.ad_pemit_source.origin;
	// Make sure any offset is added to source origin
	self.pos1 = self.pos1 + self.ad_pemit_source.ad_part_ofs;

	// Generate particles (DP Engine)
	// DP particles are designed to go at origin, not origin+offset
	pointparticles(particleeffectnum(self.ad_dpp_name), self.pos1, self.ad_dpp_vel, 1);
	self.think = ad_emitdpp_particle;
	self.nextthink = time + self.ad_dpp_wait + (random() * self.ad_dpp_rnd);
};

//----------------------------------------------------------------------
// Custom setup for Floor Circle particle emitter
//----------------------------------------------------------------------
void() ad_emitdpp_fcircle =
{
	local float ad_loop_cnt;
	local vector ad_circle_vec, ad_circle_org;
	
	// Check source entity and style type are valid
	if (ad_emit_checksource()) return;
	
	// Double check DP particles active? (quickload issues)
	// If not active, revert back to Fitz/particle system
	if (!ad_ext_dppart) {
		self.think = ad_emit_particle;
		self.nextthink = time + random();
		return;
	}

	ad_loop_cnt = 4;
	while(ad_loop_cnt > 0) {
		ad_loop_cnt = ad_loop_cnt - 1;
	
		ad_circle_vec = '0 0 0';
		ad_circle_vec_y = ad_circle_vec_y + rint(random()*360);
		makevectors(ad_circle_vec);
		ad_circle_org = self.ad_pemit_source.origin + v_forward * self.ad_part_vol_x;
	
		// Generate particles (DP Engine) around circumference
		pointparticles(particleeffectnum(self.ad_dpp_name), ad_circle_org, self.ad_dpp_vel, 1);
	}

	// Draw bright pulse ring texture over the floor pattern
	// Only draw this if the circle is the original shape
	if (self.ad_part_vol_x == 56)
		pointparticles(particleeffectnum(ad_DPP_FCIRCLE_RING), self.ad_pemit_source.origin, '0 0 0', 1);
	
	self.think = ad_emitdpp_fcircle;
	self.nextthink = time + self.ad_dpp_wait + (random() * self.ad_dpp_rnd);
};

//======================================================================
// Particle weather system
//======================================================================
// splash animation (runs at 20fps)
void() ad_pe_splash1 = [0, ad_pe_splash2] {self.nextthink = time+0.05;};
void() ad_pe_splash2 = [1, ad_pe_splash3] {self.nextthink = time+0.05;};
void() ad_pe_splash3 = [2, ad_pe_splash4] {self.nextthink = time+0.05;};
void() ad_pe_splash4 = [3, ad_pe_splash5] {self.nextthink = time+0.05;};
void() ad_pe_splash5 = [4, ad_pe_splash6] {self.nextthink = time+0.05;};
void() ad_pe_splash6 = [5, ad_finish_particle] {self.nextthink = time+0.05;};

//----------------------------------------------------------------------
void() ad_emitepp_weather = 
{
	// Check for variable wind direction
	if (self.ad_attack_speed < time && self.speed > 0) {
		self.ad_attack_speed = time + self.speed + (random()*self.speed);
		self.ad_pos3_x = ad_crandom() * self.pos2_x;
		self.ad_pos3_y = ad_crandom() * self.pos2_y;
	}
		
	// Work out random colour range
	self.t_width = self.pos1_x + random()*self.pos1_z;
	// Vary the count by +/- 25% of total
	self.t_length = self.count * 0.75 + ((random() * 0.5) * self.count);
	// Vary the wind speed by +/- 25% of total
	self.ad_pos3_z = self.pos2_z * 0.75 + ((random() * 0.5) * self.pos2_z);

	// DP volume particle system parameters
	// vector mins     : minimum corner of the cube
	// vector maxs     : maximum corner of the cube
	// vector velocity : velocity of particles
	// short count     : number of particles
	// byte color      : 8bit palette color
	
	// Double check if engine weather systems are enabled
	if (ad_query_weathersystem() == ad_FALSE) {
		// Wait for any change, slow timer
		self.think = ad_emitepp_weather;
		self.nextthink = time + 2;
	}
	else {
		if (self.spawnflags & ad_PARTICLE_WEATHER_SNOW)
			te_particlesnow(self.ad_bbmins, self.ad_bbmaxs, self.ad_pos3, self.t_length, self.t_width);
		else te_particlerain(self.ad_bbmins, self.ad_bbmaxs, self.ad_pos3, self.t_length, self.t_width);
		self.think = ad_emitepp_weather;
		self.nextthink = time + 0.1;
	}

};

//----------------------------------------------------------------------
void() ad_emit_weather_think =
{
	if (self.origin_z < (self.pos2_z-4)) {
		self.movetype = ad_MOVETYPE_NONE;
		setorigin(self, self.pos2 + '0 0 12');
		setmodel(self, self.ad_headmdl);
		self.velocity = '0 0 0';
		ad_pe_splash1();
	}
	else {
		self.think = ad_emit_weather_think;
		self.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
void() ad_emit_weather =
{
	// Check source entity and style type are valid
	if (ad_emit_checksource()) return;
	if (!ad_ext_dppart) return;

	// Setup next particle (loop)
	self.think = ad_emit_weather;

	// make sure player distance check is available
	if (!self.enemy) self.enemy = find(world, classname, "player");
	if ( !(self.enemy.flags & ad_FL_CLIENT) ) {
		self.nextthink = time + 0.1;
		return;
	}

	// Is the particle emitter close to the player?
	if (ad_range_distance(self.enemy, ad_TRUE) < self.ad_wakeup_dist) {		
		
		// Normal think timer, player within range
		self.nextthink = time + self.ad_spawn_base + (random()*self.ad_spawn_rand);

		// Is there anymore particles left to spawn? 
		if (self.ad_pemit_tcount < self.ad_part_limit) {
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				self.ad_pemit_tcount = self.ad_pemit_tcount + 1;
				ad_part.movetype = self.ad_part_movetype;
				setmodel(ad_part, self.ad_spr_name1);
				ad_part.ad_headmdl = self.ad_spr_name2;
				setsize(ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
				ad_part.velocity_x = self.ad_part_velrand_x * random();
				ad_part.velocity_y = self.ad_part_velrand_y * random();
				ad_part.velocity_z = self.ad_part_velrand_z * random();
				ad_part.velocity = ad_part.velocity + self.ad_part_vel;
				ad_part.velocity_z = -ad_part.velocity_z;
			
				// Pick a random point across the top of volume
				ad_part.pos1_x = self.pos1_x * random();
				ad_part.pos1_y = self.pos1_y * random();
				ad_part.pos1_z = 0;
				ad_part.pos1 = ad_part.pos1 + self.pos2;
				setorigin(ad_part, ad_part.pos1);
				
				// trace down to find travel distance
				traceline (ad_part.pos1, ad_part.pos1 + '0 0 -4096', ad_TRUE, self);
				ad_part.pos2 = trace_endpos;
				
				// Find out if any liquid in the way
				if (trace_inwater) self.height = 8;
				else self.count = 0;

				// Binary divide the distance to find water surface
				while (self.height > 0) {
					// Break out early from loop if <8 from water surface
					if (fabs(ad_part.pos2_z-ad_part.pos1_z) < 8) self.height = 0;
					// Calculate midway point between origin and endtrace
					ad_part.ad_pos3 = ad_part.pos1;
					ad_part.ad_pos3_z = ad_part.pos1_z + ((ad_part.pos2_z - ad_part.pos1_z)*0.5);

					// Test which half has water and shift top/bottom positions
					traceline (ad_part.pos1, ad_part.ad_pos3, ad_TRUE, self);
					if (trace_inwater) ad_part.pos2 = ad_part.ad_pos3;
					else ad_part.pos1 = ad_part.ad_pos3;
					// Only loop a limited amount of times
					self.height = self.height - 1;
				}
				
				// Check travel distance
				ad_part.think = ad_emit_weather_think;
				ad_part.nextthink = time + 0.1;
				
			}
		}
	}
	else {
		// If no player within range of the emitter, slower think timer
		self.nextthink = time + self.ad_wakeup_timer + (random()*self.ad_spawn_rand);
	}
};

//----------------------------------------------------------------------
void() ad_emit_particle =
{
	local float ad_randno;
	local vector ad_angle_vec;

	// Check source entity and style type are valid
	if (ad_emit_checksource()) return;

	// Setup next particle (loop)
	self.think = ad_emit_particle;

	// make sure player distance check is available
	if (!self.enemy) self.enemy = find(world, classname, "player");
	if ( !(self.enemy.flags & ad_FL_CLIENT) ) {
		self.nextthink = time + 0.1;
		return;
	}

	// Is the particle emitter close to the player?
	if (ad_range_distance(self.enemy, ad_TRUE) < self.ad_wakeup_dist) {		
		
		// Normal think timer, player within range
		self.nextthink = time + self.ad_spawn_base + (random()*self.ad_spawn_rand);

		// Is there anymore particles left to spawn? 
		if (self.ad_pemit_tcount < self.ad_part_limit) {
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				self.ad_pemit_tcount = self.ad_pemit_tcount + 1;
				ad_part.movetype = self.ad_part_movetype;		// 6=Gravity, 8=Noclip, 10=Bounce
				
				// Select particle type
				ad_randno = random();
	
				//----------------------------------------------------------------------
				// Setup SPRITE particle (string and frame no)
				//----------------------------------------------------------------------
				if (ad_randno < 0.3) setmodel(ad_part, self.ad_spr_name1);
				else if (ad_randno < 0.6) setmodel(ad_part, self.ad_spr_name2);
				else setmodel(ad_part, self.ad_spr_name3);

				//----------------------------------------------------------------------
				// Sprite Frame style (1=LIGHT, 2=DARK, 3=ALL)
				//----------------------------------------------------------------------
				if (self.ad_spr_frame == 1) ad_part.frame = rint(random()*1.4);
				else if (self.ad_spr_frame == 2) ad_part.frame = rint(random()*2);
				else ad_part.frame = rint(random()*3.4);

				// Zero size and world interaction			
				setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

				//----------------------------------------------------------------------
				// STARTING POINT (Particle origin - uses MANGLE key)
				//
				// 0 = Randomly picked from a volume (X/Y/Z) - DEFAULT
				// 1 = Circular motion (radius/segment controlled)
				// 2 = Randomly pick a point on the circle circumference
				// 3 = Spiral in/out from circle circumference
				// 5 = Explosion from central point
				//----------------------------------------------------------------------
				// Circular motion around emitter (self)
				if (self.ad_part_veltype == ad_PARTICLE_ORIGIN_CIRCLE) {
					ad_angle_vec = '0 0 0';
					ad_angle_vec_y = ad_angle_vec_y + self.ad_circular_angle;
					makevectors(ad_angle_vec);
					ad_part.origin = self.origin + v_forward * self.ad_part_vol_x;
					setorigin (ad_part, ad_part.origin + self.ad_part_ofs);
					self.ad_circular_angle = ad_anglemod(self.ad_circular_angle + self.ad_part_vol_y);
				}
				// Random circumference point around emitter (self)
				else if (self.ad_part_veltype == ad_PARTICLE_ORIGIN_RANDCIRCLE) {
					ad_angle_vec = '0 0 0';
					ad_angle_vec_y = ad_angle_vec_y + rint(random()*360);
					makevectors(ad_angle_vec);
					ad_part.origin = self.origin + v_forward * self.ad_part_vol_x;
					setorigin (ad_part, ad_part.origin + self.ad_part_ofs);
				}
				// Spiral in/out around circumference point (self)
				else if (self.ad_part_veltype == ad_PARTICLE_ORIGIN_SPIRAL) {
					ad_angle_vec = '0 0 0';
					ad_angle_vec_y = ad_angle_vec_y + self.ad_circular_angle;
					makevectors(ad_angle_vec);
					if (self.lefty == 0) self.lefty = 1;
					self.ad_part_vol_z = self.ad_part_vol_z + self.lefty;
					if (self.ad_part_vol_z == 0) self.lefty = 1; 
					if (self.ad_part_vol_z == self.ad_part_vol_x) self.lefty = -1;
					ad_part.origin = self.origin + v_forward * self.ad_part_vol_z;
					setorigin (ad_part, ad_part.origin + self.ad_part_ofs);
					self.ad_circular_angle = ad_anglemod(self.ad_circular_angle + self.ad_part_vol_y);
				}
				// Explosion from central point (self)
				else if (self.ad_part_veltype == ad_PARTICLE_ORIGIN_CENTER) {
					// Always calculate from the center of original object
					ad_part.origin = self.ad_pemit_source.origin + self.ad_part_ofs;
					setorigin (ad_part, ad_part.origin);
				}
				// Random volume point around particle (part)
				else {
					// Check if owner is a Bmodel? (different origin location)
					if (self.ad_pemit_source.ad_bsporigin) {
						ad_part.pos1 = self.ad_pemit_source.origin + ad_bmodel_origin(self.ad_pemit_source);
						ad_part.origin = ad_part.pos1;
						// Double check the bmodel volume has been setup correctly (not zero)
						// Particle emitters can be started before bmodel has initialized
						if (ad_CheckZeroVector(self.ad_part_vol)) self.ad_part_vol = self.ad_pemit_source.size * 0.5;
					}
					else ad_part.origin = self.ad_pemit_source.origin + self.ad_part_ofs;

					ad_part.origin_x = ad_part.origin_x + ( (random()*(self.ad_part_vol_x*2)) - self.ad_part_vol_x);
					ad_part.origin_y = ad_part.origin_y + ( (random()*(self.ad_part_vol_y*2)) - self.ad_part_vol_y);
					ad_part.origin_z = ad_part.origin_z + ( (random()*(self.ad_part_vol_z*2)) - self.ad_part_vol_z);
					setorigin (ad_part, ad_part.origin);
				}
				
				//----------------------------------------------------------------------
				// VELOCITY (Particle speed/direction - uses ANGLES key)
				//
				// Initially setup linear velocity
				// if PART_VELRAND defined create extra wobble/randomness
				// if oldenemy (noise4) specified go towards specific target entity
				//----------------------------------------------------------------------
				if (self.ad_pemit_target) {
					// Check if finish target is a Bmodel? (different origin location)
					if (self.ad_pemit_target.ad_bsporigin) {
						ad_part.pos2 = self.ad_pemit_target.origin + ad_bmodel_origin(self.ad_pemit_target);
						ad_angle_vec = ad_part.pos2 - ad_part.origin;
					}
					else
						ad_angle_vec = self.ad_pemit_target.origin - ad_part.origin;		// Target -> Self

					ad_angle_vec = normalize(ad_angle_vec);									// vector unit scale
					ad_part.velocity = ad_angle_vec * ( (random()*self.ad_part_vel_x) + self.ad_part_vel_x);

					// Add extra wobble if part_velrand defined
					if (self.ad_part_velrand_x > 0 || self.ad_part_velrand_y > 0 || self.ad_part_velrand_z > 0) {
						ad_part.velocity_x = ad_part.velocity_x + (random()*(self.ad_part_velrand_x*2)) - self.ad_part_velrand_x;
						ad_part.velocity_y = ad_part.velocity_y + (random()*(self.ad_part_velrand_y*2)) - self.ad_part_velrand_y;
						ad_part.velocity_z = ad_part.velocity_z + (random()*(self.ad_part_velrand_z*2)) - self.ad_part_velrand_z;
					}
				}
				// Explosion from central point (self)
				else if (self.ad_part_veltype == ad_PARTICLE_ORIGIN_CENTER) {
					// Setup BASE + CRANDOM (+/-) velocity
					ad_part.velocity = '0 0 0';
					ad_part.velocity_x = self.ad_part_vel_x - (random()*(self.ad_part_vel_x*2));
					ad_part.velocity_y = self.ad_part_vel_y - (random()*(self.ad_part_vel_y*2));
					ad_part.velocity_z = self.ad_part_vel_z - (random()*(self.ad_part_vel_z*2));
					ad_part.velocity = ad_part.velocity + self.ad_part_velbase;
				}
				else {					
					// Setup BASE + RANDOM (+) velocity
					ad_part.velocity = '0 0 0';
					ad_part.velocity_x = random(self.ad_part_vel_x) + self.ad_part_vel_x;
					ad_part.velocity_y = random(self.ad_part_vel_y) + self.ad_part_vel_y;
					ad_part.velocity_z = random(self.ad_part_vel_z) + self.ad_part_vel_z;
					ad_part.velocity = ad_part.velocity + self.ad_part_velbase;
		
					// Add extra wobble if part_velrand defined
					if (self.ad_part_velrand_x > 0 || self.ad_part_velrand_y > 0 || self.ad_part_velrand_z > 0) {
						ad_part.velocity_x = ad_part.velocity_x + (random()*(self.ad_part_velrand_x*2)) - self.ad_part_velrand_x;
						ad_part.velocity_y = ad_part.velocity_y + (random()*(self.ad_part_velrand_y*2)) - self.ad_part_velrand_y;
						ad_part.velocity_z = ad_part.velocity_z + (random()*(self.ad_part_velrand_z*2)) - self.ad_part_velrand_z;
					}
				}				
				//----------------------------------------------------------------------
				// ROTATION (Y axis only - uses PART_VELROT key)
				// Random Y axis rotation
				//----------------------------------------------------------------------
				if (self.ad_part_velrot) {
					ad_part.angles = self.enemy.angles;		// Rotate the same way first
					ad_part.avelocity = '0 0 0';
					ad_part.avelocity_y = self.ad_part_velrot + (random()*self.ad_part_velrot);
				}

				// Setup time of death!
				ad_part.nextthink = time + random() + self.ad_part_life;
				ad_part.think = ad_finish_particle;
			}
			
		}
	}
	else {
		// If no player within range of the emitter, slower think timer
		self.nextthink = time + self.ad_wakeup_timer + (random()*self.ad_spawn_rand);
	}
};

//----------------------------------------------------------------------
// Pick a particle sprite based on type
//----------------------------------------------------------------------
void(entity ad_part_ent, float ad_part_style) ad_particle_style =
{
	local float ad_ring_rand;
	
	ad_ring_rand = random();
	if (ad_ring_rand < 0.4) {
		if (ad_part_style & ad_PARTICLE_BURST_YELLOW) setmodel (ad_part_ent, ad_PART_DOTSML_GOLD);
		else if (ad_part_style & ad_PARTICLE_BURST_GREEN) setmodel (ad_part_ent, ad_PART_DOTSML_LGREEN);
		else if (ad_part_style & ad_PARTICLE_BURST_RED) setmodel (ad_part_ent, ad_PART_DOTSML_GREY);
		else if (ad_part_style & ad_PARTICLE_BURST_BLUE) setmodel (ad_part_ent, ad_PART_DOTSML_BLUE);
		else if (ad_part_style & ad_PARTICLE_BURST_PURPLE) setmodel (ad_part_ent, ad_PART_DOTSML_PURP);
		else if (ad_part_style & ad_PARTICLE_BURST_FIRE) setmodel (ad_part_ent, ad_PART_TORCH1);
		else setmodel (ad_part_ent, ad_PART_DOTSML_WHITE);
	}
	else if (ad_ring_rand < 0.8) {
		//----------------------------------------------------------------------
		if (ad_part_style & ad_PARTICLE_BURST_YELLOW) setmodel (ad_part_ent, ad_PART_DOTSML_YELLOW);
		else if (ad_part_style & ad_PARTICLE_BURST_GREEN) setmodel (ad_part_ent, ad_PART_DOTSML_GREEN);
		else if (ad_part_style & ad_PARTICLE_BURST_RED) setmodel (ad_part_ent, ad_PART_DOTSML_RED);
		else if (ad_part_style & ad_PARTICLE_BURST_BLUE) setmodel (ad_part_ent, ad_PART_DOTSML_GREY);
		else if (ad_part_style & ad_PARTICLE_BURST_PURPLE) setmodel (ad_part_ent, ad_PART_DOTSML_GREY);
		else if (ad_part_style & ad_PARTICLE_BURST_FIRE) setmodel (ad_part_ent, ad_PART_DOTSML_GOLD);
		else setmodel (ad_part_ent, ad_PART_DOTSML_GREY);
	}
	else {
		//----------------------------------------------------------------------
		if (ad_part_style & ad_PARTICLE_BURST_YELLOW) setmodel (ad_part_ent, ad_PART_DOTMED_YELLOW);
		else if (ad_part_style & ad_PARTICLE_BURST_GREEN) setmodel (ad_part_ent, ad_PART_DOTMED_GREEN);
		else if (ad_part_style & ad_PARTICLE_BURST_RED) setmodel (ad_part_ent, ad_PART_DOTMED_RED);
		else if (ad_part_style & ad_PARTICLE_BURST_BLUE) setmodel (ad_part_ent, ad_PART_DOTMED_BLUE);
		else if (ad_part_style & ad_PARTICLE_BURST_PURPLE) setmodel (ad_part_ent, ad_PART_DOTMED_PURP);
		else if (ad_part_style & ad_PARTICLE_BURST_FIRE) setmodel (ad_part_ent, ad_PART_DOTMED_GREY);
		else setmodel (ad_part_ent, ad_PART_DOTMED_GREY);
	}
	// Random frame (sprite)
	ad_part.frame = rint(random()*3);
};

//----------------------------------------------------------------------
// Particle ring explosion (used for respawn function)
// ring_org		: center of particle ring
// ring_dir		: direction for particles to move
// ring_rdir	: random wobble for particle direction
// ring_rad		: starting point offset (grow/shrink ring size)
// ring_qty		: circle division (how many points around circumference)
// ring_time	: lifespan of particle (time + random()*time)
// ring_style	: particle ring colour (1=yellow, 2=green, 3=red, 4=white)
//----------------------------------------------------------------------
void(vector ad_ring_org, vector ad_ring_dir, vector ad_ring_rdir, float ad_ring_rad, float ad_ring_qty, float ad_ring_time, float ad_ring_style) ad_particle_ring = 
{
	local vector ad_circle_vec, ad_circle_org;
	local float ad_ring_loop, ad_ring_angle;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Setup DP particle style based on supplied style
	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		if (ad_ring_style & ad_PARTICLE_BURST_YELLOW) ad_dpp_string = ad_DPP_RINGPARTY;
		else if (ad_ring_style & ad_PARTICLE_BURST_GREEN) ad_dpp_string = ad_DPP_RINGPARTG;
		else if (ad_ring_style & ad_PARTICLE_BURST_RED) ad_dpp_string = ad_DPP_RINGPARTR;
		else if (ad_ring_style & ad_PARTICLE_BURST_BLUE) ad_dpp_string = ad_DPP_RINGPARTB;
		else if (ad_ring_style & ad_PARTICLE_BURST_PURPLE) ad_dpp_string = ad_DPP_RINGPARTP;
		else ad_dpp_string = ad_DPP_RINGPARTW;
	}
	else {
		// Are there any free particles?
		// Check for maximim amount of particles available
		if ( (ad_part_total+ad_ring_qty) >= ad_part_max - 1) return;
	}

	ad_ring_loop = 0;
	ad_ring_angle = 360 / ad_ring_qty;
	while (ad_ring_loop < ad_ring_qty) {
		// Is the DP particle system active?
		if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
			// Work out point on circle circumference using
			// the v_forward vector with incremental angles	
			ad_circle_vec = '0 0 0';
			ad_circle_vec_y = ad_circle_vec_y + (ad_ring_angle * ad_ring_loop);
			makevectors(ad_circle_vec);
			ad_circle_org = ad_ring_org + (v_forward * ad_ring_rad);

			// Generate particles (DP Engine)
			pointparticles(particleeffectnum(ad_dpp_string), ad_circle_org, '0 0 0', 1);
		}
		else {
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				ad_part.movetype = ad_MOVETYPE_NOCLIP;
				
				// Setup correct particle type (sprite/model) based on ring colour
				ad_particle_style(ad_part, ad_ring_style);
		
				// Work out point on circle circumference using
				// the v_forward vector with incremental angles	
				ad_circle_vec = '0 0 0';
				ad_circle_vec_y = ad_circle_vec_y + (ad_ring_angle * ad_ring_loop);
				makevectors(ad_circle_vec);
				ad_part.origin = ad_ring_org + (v_forward * ad_ring_rad);
				setorigin (ad_part, ad_part.origin);
				// Zero size and world interaction			
				setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
				
				// Setup particle velocity with random element
				ad_part.velocity_x = ad_ring_dir_x + ( (random()*(ad_ring_rdir_x*2)) - ad_ring_rdir_x);
				ad_part.velocity_y = ad_ring_dir_y + ( (random()*(ad_ring_rdir_y*2)) - ad_ring_rdir_y);
				ad_part.velocity_z = ad_ring_dir_z + (random()*ad_ring_rdir_z);
		
				// Setup time of death!
				ad_part.nextthink = time + (random()*ad_ring_time) + ad_ring_time;
				ad_part.think = ad_finish_particle;
			}
		}
		// Keep on loopin!
		ad_ring_loop = ad_ring_loop + 1;
	}
};

//----------------------------------------------------------------------
void(entity ad_part_ent, vector ad_part_org, float ad_expl_style) ad_explosion_style =
{
	local vector ad_org_volume, ad_expl_vel;
	
	// Ogre hammer is a flat floor explosion with particles bouncing
	if (ad_expl_style & ad_PARTICLE_BURST_SHOCKWAVE) {
		ad_org_volume = '0 0 0';
		ad_org_volume_x = ad_crandom()*16;
		ad_org_volume_y = ad_crandom()*16;
		ad_part_ent.origin = ad_part_org + ad_org_volume;
		setorigin (ad_part_ent, ad_part_ent.origin);

		// Random chance of dead particles that are
		// stationary on the ground
		if (random() < 0.3) {
			ad_part_ent.velocity = '0 0 0';
			if (random() < 0.5) setmodel (ad_part_ent, ad_PART_DOTSML_GREY);
			else setmodel (ad_part_ent, ad_PART_DOTMED_GREY);
			ad_part_ent.frame = rint(random()*3);
		}
		else {
			// Particles that explode up and out
			ad_expl_vel_x = ad_crandom() * 75;
			ad_expl_vel_y = ad_crandom() * 75;
			ad_expl_vel_z = 150 + random() * 150;
			ad_part_ent.velocity = ad_expl_vel;
			ad_part_ent.avelocity = ad_vecrand(100,200,ad_FALSE);
			ad_part_ent.movetype = ad_MOVETYPE_TOSS;
			ad_part_ent.gravity = 0.75;
			ad_part_ent.flags = 0;
		}
	}
	// Skull wizard teleporting = particle burst upwards
	else if (ad_expl_style & ad_PARTICLE_BURST_SKULLUP) {
		ad_part_ent.origin_x = ad_part_org_x + ad_crandom()*8;
		ad_part_ent.origin_y = ad_part_org_y + ad_crandom()*8;
		// If skull wizard dead, spawn particles from robes on floor
		// Otherwise the particles are being used for a teleport
		if (self.health < 0) ad_part_ent.origin_z = ad_part_org_z - ad_MON_VIEWOFS;
		else ad_part_ent.origin_z = ad_part_org_z - ad_crandom()*ad_MON_VIEWOFS;
		setorigin (ad_part_ent, ad_part_ent.origin);
		ad_part_ent.velocity_x = ad_crandom()*8;
		ad_part_ent.velocity_y = ad_crandom()*8;
		ad_part_ent.velocity_z = random()*25;
		ad_part_ent.avelocity = ad_vecrand(100,200,ad_FALSE);
		ad_part_ent.movetype = ad_MOVETYPE_FLY;
		ad_part_ent.flags = 0;
	}
	// Lost souls fire particles upwards
	else if (ad_expl_style & ad_PARTICLE_BURST_LOSTUP) {
		ad_part_ent.origin_x = ad_part_org_x + ad_crandom()*4;
		ad_part_ent.origin_y = ad_part_org_y + ad_crandom()*4;
		ad_part_ent.origin_z = ad_part_org_z;
		setorigin (ad_part_ent, ad_part_ent.origin);
		ad_part_ent.velocity_x = ad_crandom()*4;
		ad_part_ent.velocity_y = ad_crandom()*4;
		ad_part_ent.velocity_z = random()*10;
		ad_part_ent.avelocity = ad_vecrand(100,200,ad_FALSE);
		ad_part_ent.movetype = ad_MOVETYPE_FLY;
		ad_part_ent.flags = 0;
	}
	// Minotaur finished plasma attack
	else if (ad_expl_style & ad_PARTICLE_BURST_MINOTAUR) {
		ad_part_ent.origin_x = ad_part_org_x + ad_crandom()*8;
		ad_part_ent.origin_y = ad_part_org_y + ad_crandom()*8;
		ad_part_ent.origin_z = ad_part_org_z - ad_crandom()*ad_MON_VIEWOFS;
		setorigin (ad_part_ent, ad_part_ent.origin);
		ad_part_ent.velocity_x = ad_crandom()*8;
		ad_part_ent.velocity_y = ad_crandom()*8;
		ad_part_ent.velocity_z = random()*35;
		ad_part_ent.avelocity = ad_vecrand(100,200,ad_FALSE);
		ad_part_ent.movetype = ad_MOVETYPE_FLY;
		ad_part_ent.flags = 0;
	}
	// Generic particle burst drifting upward
	else if (ad_expl_style & ad_PARTICLE_BURST_UPWARD) {
		ad_part_ent.origin_x = ad_part_org_x + ad_crandom()*24;
		ad_part_ent.origin_y = ad_part_org_y + ad_crandom()*24;
		ad_part_ent.origin_z = ad_part_org_z + random()*64;
		setorigin (ad_part_ent, ad_part_ent.origin);
		ad_part_ent.velocity_x = ad_crandom()*16;
		ad_part_ent.velocity_y = ad_crandom()*16;
		ad_part_ent.velocity_z = 8+random()*16;
		ad_part_ent.movetype = ad_MOVETYPE_FLY;
		ad_part_ent.flags = 0;
	}
	else {
		// default = explode outwards in all directions
		ad_part_ent.origin = ad_part_org;
		setorigin (ad_part_ent, ad_part_ent.origin);
		ad_part_ent.velocity = ad_vecrand(0,16,ad_TRUE);
		ad_part_ent.avelocity = ad_vecrand(100,200,ad_FALSE);
		ad_part_ent.movetype = ad_MOVETYPE_FLY;
		ad_part_ent.flags = 0;
	}
};	

/*======================================================================
 Particle Implode
 
 e_org		: center of particle implode
 e_qty		: quantity of particle burst
 e_speed	: Particle speed towards center
 e_dist		: circumference of implosion circle
 p_style	: sprite style (check function particle_style above)
======================================================================*/
void(vector ad_e_org, float ad_e_qty, float ad_e_speed, float ad_e_dist, float ad_p_style) ad_particle_implode = 
{
	local float ad_e_loop, ad_e_len, ad_e_traveltime;
	local vector ad_e_dir, ad_e_vdestdelta, ad_e_finaldest;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Are there any free particles?
	// Check for maximim amount of particles available
	if ( (ad_part_total+ad_e_qty) >= ad_part_max - 1) return;

	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		// Setup DP particle style based on supplied style
		if (ad_p_style & ad_PARTICLE_BURST_YELLOW) ad_dpp_string = ad_DPP_BURSTPARTY;
		else if (ad_p_style & ad_PARTICLE_BURST_GREEN) ad_dpp_string = ad_DPP_BURSTPARTG;
		else if (ad_p_style & ad_PARTICLE_BURST_RED) ad_dpp_string = ad_DPP_BURSTPARTR;
		else if (ad_p_style & ad_PARTICLE_BURST_BLUE) ad_dpp_string = ad_DPP_BURSTPARTB;
		else if (ad_p_style & ad_PARTICLE_BURST_PURPLE) ad_dpp_string = ad_DPP_BURSTPARTP;
		else ad_dpp_string = ad_DPP_BURSTPARTW;
	}
	//	pointparticles(particleeffectnum(dpp_string), e_org, '0 0 0', e_qty);

	ad_e_loop = 0;
	while (ad_e_loop < ad_e_qty) {
		ad_e_loop = ad_e_loop + 1;	// Keep on loopin!
		ad_part = ad_fetch_particle();
		// Only preceed if a particle has been returned
		if (ad_part.ad_classtype == ad_CT_PARTICLE) {
			ad_part.owner = self;
			ad_particle_style(ad_part, ad_p_style);
			
			// Work out random direction from origin center
			ad_e_dir = normalize(ad_vecrand(0,50,ad_TRUE));
			ad_e_finaldest = ad_e_org + ad_e_dir * (ad_e_dist + random()*50);
			
			// Calculate distance and time travelled
			ad_e_vdestdelta = ad_e_org - ad_e_finaldest;
			ad_e_len = vlen(ad_e_vdestdelta);
			ad_e_traveltime = ad_e_len / (ad_e_speed + random()*50);
						
			// Move to outer edge of implosion circle
			setorigin(ad_part, ad_e_finaldest);
			setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
			ad_part.movetype = ad_MOVETYPE_NOCLIP;

			// Setup inward velocity and time to kill
			ad_part.velocity = ad_e_vdestdelta * (1/ad_e_traveltime);
			ad_part.nextthink = time + ad_e_traveltime;
			ad_part.think = ad_finish_particle;
		}
	}
};

/*======================================================================
 Particle explosion
 
 e_org		: center of particle explosion
 e_qty		: quantity of particle burst
 e_time		: lifespan of particle (time + random()*time)
 p_style	: sprite style (check function particle_style above)
 e_style	: explosion style (pre-defined in part_manage.qc)
======================================================================*/
void(vector ad_e_org, float ad_e_qty, float ad_e_time, float ad_p_style, float ad_e_style) ad_particle_explode = 
{
	local float ad_e_loop;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Can only have integer particle quantity
	ad_e_qty = rint(ad_e_qty);

	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		// DP hammer impact, 1=regular 2=shockwave
		if (ad_e_style & ad_PARTICLE_BURST_SHOCKWAVE) {
			if (ad_e_style & 1) pointparticles(particleeffectnum(ad_DPP_BURSTSHOCKWAVE1), ad_e_org, '0 0 0', 1);
			else pointparticles(particleeffectnum(ad_DPP_BURSTSHOCKWAVE1), ad_e_org, '0 0 0', 1);
		}
		else {
			// Setup DP particle style based on supplied style
			if (ad_p_style & ad_PARTICLE_BURST_YELLOW) ad_dpp_string = ad_DPP_BURSTPARTY;
			else if (ad_p_style & ad_PARTICLE_BURST_GREEN) ad_dpp_string = ad_DPP_BURSTPARTG;
			else if (ad_p_style & ad_PARTICLE_BURST_RED) ad_dpp_string = ad_DPP_BURSTPARTR;
			else if (ad_p_style & ad_PARTICLE_BURST_BLUE) ad_dpp_string = ad_DPP_BURSTPARTB;
			else if (ad_p_style & ad_PARTICLE_BURST_PURPLE) ad_dpp_string = ad_DPP_BURSTPARTP;
			else ad_dpp_string = ad_DPP_BURSTPARTW;
			pointparticles(particleeffectnum(ad_dpp_string), ad_e_org, '0 0 0', ad_e_qty);
		}
	}
	else {
		// Are there any free particles?
		// Check for maximim amount of particles available
		if ( (ad_part_total+ad_e_qty) >= ad_part_max - 1) return;
		ad_e_loop = 0;
		while (ad_e_loop < ad_e_qty) {
			ad_e_loop = ad_e_loop + 1;	// Keep on loopin!
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				ad_particle_style(ad_part, ad_p_style);
				ad_explosion_style(ad_part, ad_e_org, ad_e_style);
				// Zero size and world interaction			
				setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
				ad_part.nextthink = ((time + (random() * ad_e_time)) + ad_e_time);
				ad_part.think = ad_finish_particle;
			}
		}
	}
};

/*======================================================================
 Particle DP/QSS/FTE smoke
 
 e_org		: Starting point for DP smoke
 e_dest		: Velocity direction for smoke
 e_qty		: quantity of smoke particles
 e_volume	: size of cube to spawn smoke inside for origin and direction
 e_speedqty : Random smoke velocity speed multiplier
 e_colour   : Colour (Grey, Yellow, White, Toxic, Green, Purple, Red, Fire)
 =====================================================================*/
void(vector ad_e_org, vector ad_e_dest, float ad_e_qty, float ad_e_volume, float ad_e_speedqty, float ad_e_colour) ad_particle_DPsmoke = 
{
	local float ad_e_speed;
	local vector ad_e_vel, ad_rnd_vec;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Can only have integer particle quantity
	ad_e_qty = rint(ad_e_qty);

	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		if (ad_e_colour == 1) ad_dpp_string = ad_DPP_VELSMOKEGREY2;
		else if (ad_e_colour == 2) ad_dpp_string = ad_DPP_VELSMOKEWHITE;
		else if (ad_e_colour == 3) ad_dpp_string = ad_DPP_VELSMOKETOXIC;
		else if (ad_e_colour == 4) ad_dpp_string = ad_DPP_VELSMOKEGREEN;
		else if (ad_e_colour == 5) ad_dpp_string = ad_DPP_VELSMOKEPURPLE;
		else if (ad_e_colour == 6) ad_dpp_string = ad_DPP_VELSMOKERED;
		else if (ad_e_colour == 7) ad_dpp_string = ad_DPP_VELSMOKEFIRE;
		else ad_dpp_string = ad_DPP_VELSMOKEGREY1;
		// Create some random volume displacement at origin/destination
		ad_rnd_vec = ad_vecrand(0, ad_e_volume, ad_TRUE);
		// Make sure volume is consistent with org+dest
		ad_e_org = ad_e_org + ad_rnd_vec;
		ad_e_dest = ad_e_dest + ad_rnd_vec;
		// Random speed multiplier
		ad_e_speed = random() * ad_e_speedqty;
		// DP emiiter is setup with 64 velocity multiplier
		ad_e_vel = ((ad_e_dest - ad_e_org) * 0.015625) * ad_e_speed;
		pointparticles(particleeffectnum(ad_dpp_string), ad_e_org, ad_e_vel, ad_e_qty);
	}
};

/*======================================================================
 Particle stream
 
 e_org		: Starting point for particle stream
 e_dest		: Finishing point for particle stream
 e_qty		: quantity of particle burst
 e_time		: lifespan of particle (time + random()*time)
 e_volume	: size of cube to spawn sprites inside for origin and direction
 e_speedqty : Random particle velocity speed multiplier
 p_style	: sprite style (check function particle_style above)
 =====================================================================*/
void(vector ad_e_org, vector ad_e_dest, float ad_e_qty, float ad_e_time, float ad_e_volume, float ad_e_speedqty, float ad_p_style) ad_particle_stream = 
{
	local float ad_e_loop, ad_e_speed;
	local vector ad_e_vel, ad_rnd_vec;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Can only have integer particle quantity
	ad_e_qty = rint(ad_e_qty);

	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		// Setup DP particle style based on supplied style
		if (ad_p_style & ad_PARTICLE_BURST_YELLOW) ad_dpp_string = ad_DPP_BURSTPARTY;
		else if (ad_p_style & ad_PARTICLE_BURST_GREEN) ad_dpp_string = ad_DPP_BURSTPARTG;
		else if (ad_p_style & ad_PARTICLE_BURST_RED) ad_dpp_string = ad_DPP_BURSTPARTR;
		else if (ad_p_style & ad_PARTICLE_BURST_BLUE) ad_dpp_string = ad_DPP_BURSTPARTB;
		else if (ad_p_style & ad_PARTICLE_BURST_PURPLE) ad_dpp_string = ad_DPP_BURSTPARTP;
		else ad_dpp_string = ad_DPP_BURSTPARTW;
		// Create some random volume displacement at origin/destination
		ad_rnd_vec = ad_vecrand(0, ad_e_volume, ad_TRUE);
		ad_e_org = ad_e_org + ad_rnd_vec;
		ad_e_dest = ad_e_dest + ad_rnd_vec;
		ad_e_speed = random() * ad_e_speedqty;
		ad_e_vel = normalize(ad_e_dest - ad_e_org) * ad_e_speed;
		// Normalized velocity needs large extra boast! 
		pointparticles(particleeffectnum(ad_dpp_string), ad_e_org, ad_e_vel*64, ad_e_qty);
	}
	else {
		// Are there any free particles?
		// Check for maximim amount of particles available
		if ( (ad_part_total+ad_e_qty) >= ad_part_max - 1) return;
		ad_e_loop = 0;
		while (ad_e_loop < ad_e_qty) {
			ad_e_loop = ad_e_loop + 1;	// Keep on loopin!
			// Create some random volume displacement at origin/destination
			ad_rnd_vec = ad_vecrand(0, ad_e_volume, ad_TRUE);
			ad_e_speed = random() * ad_e_speedqty;
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				// Pick sprite sizes
				ad_particle_style(ad_part, ad_p_style);
				// Setup origin + direction
				ad_part.origin = ad_e_org + ad_rnd_vec;
				setorigin (ad_part, ad_part.origin);
				ad_part.velocity = ((ad_e_dest + ad_rnd_vec) - ad_e_org) * ad_e_speed;
				ad_part.avelocity = ad_vecrand(100,200,ad_FALSE);
				ad_part.movetype = ad_MOVETYPE_FLY;
				ad_part.flags = 0;
				// Zero size and world interaction			
				setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
				ad_part.nextthink = ((time + (random() * ad_e_time)) + ad_e_time);
				ad_part.think = ad_finish_particle;
			}
		}
	}
};

//----------------------------------------------------------------------
// Slowly rising cloud of particle dots
//----------------------------------------------------------------------
void(vector ad_debuff_center, float ad_debuff_volsize, float ad_debuff_qty, float ad_debuff_style) ad_particle_debuff =
{
	local float ad_debuff_loop, ad_debuff_time;
	local vector ad_debuff_org, ad_debuff_vol;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Setup DP particle style based on supplied style
	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		if (ad_debuff_style & ad_PARTICLE_BURST_YELLOW) ad_dpp_string = ad_DPP_RINGPARTY;
		else if (ad_debuff_style & ad_PARTICLE_BURST_GREEN) ad_dpp_string = ad_DPP_RINGPARTG;
		else if (ad_debuff_style & ad_PARTICLE_BURST_RED) ad_dpp_string = ad_DPP_RINGPARTR;
		else if (ad_debuff_style & ad_PARTICLE_BURST_BLUE) ad_dpp_string = ad_DPP_RINGPARTB;
		else if (ad_debuff_style & ad_PARTICLE_BURST_PURPLE) ad_dpp_string = ad_DPP_RINGPARTP;
		else ad_dpp_string = ad_DPP_RINGPARTW;
	}
	else {
		// Are there any free particles?
		// Check for maximim amount of particles available
		if ( (ad_part_total+ad_debuff_qty) >= ad_part_max - 1) return;
	}

	ad_debuff_loop = 0;
	ad_debuff_time = 2;
	
	while (ad_debuff_loop < ad_debuff_qty) {
		ad_debuff_vol = ad_vecrand(0,ad_debuff_volsize,ad_TRUE);
		ad_debuff_org = ad_debuff_center + ad_debuff_vol;

		// Is the DP particle system active?
		if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE)
			pointparticles(particleeffectnum(ad_dpp_string), ad_debuff_org, '0 0 0', 1);
		else {
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				ad_part.movetype = ad_MOVETYPE_NOCLIP;
				
				// Setup correct particle type (sprite/model) based on ring colour
				ad_particle_style(ad_part, ad_debuff_style);
				setorigin (ad_part, ad_debuff_org);
				// Zero size and world interaction			
				setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

				// Setup particle velocity with random element
				ad_part.velocity = ad_vecrand(0,2,ad_TRUE);
				ad_part.velocity_z = 8 + random()*24;
		
				// Setup time of death!
				ad_part.nextthink = time + (random()*ad_debuff_time) + ad_debuff_time;
				ad_part.think = ad_finish_particle;
			}
		}
		// Keep on loopin!
		ad_debuff_loop = ad_debuff_loop + 1;
	}
};

//----------------------------------------------------------------------
// Falling particle dust/dots
//----------------------------------------------------------------------
void(vector ad_dust_center, float ad_dust_qty, float ad_dust_volsize, float ad_dust_style) ad_particle_dust =
{
	local float ad_dust_loop, ad_dust_time;
	local vector ad_dust_org, ad_dust_vol;
	local string ad_dpp_string;

	// Have particles been enabled via serverflags?
	if (ad_query_configflag(ad_SVR_PARTICLES) != ad_SVR_PARTICLES) return;

	// Setup DP particle style based on supplied style
	if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE) {
		if (ad_dust_style & ad_PARTICLE_BURST_YELLOW) ad_dpp_string = ad_DPP_RINGPARTY;
		else if (ad_dust_style & ad_PARTICLE_BURST_GREEN) ad_dpp_string = ad_DPP_RINGPARTG;
		else if (ad_dust_style & ad_PARTICLE_BURST_RED) ad_dpp_string = ad_DPP_RINGPARTR;
		else if (ad_dust_style & ad_PARTICLE_BURST_BLUE) ad_dpp_string = ad_DPP_RINGPARTB;
		else if (ad_dust_style & ad_PARTICLE_BURST_PURPLE) ad_dpp_string = ad_DPP_RINGPARTP;
		else ad_dpp_string = ad_DPP_RINGPARTW;
	}
	else {
		// Are there any free particles?
		// Check for maximim amount of particles available
		if ( (ad_part_total+ad_dust_qty) >= ad_part_max - 1) return;
	}

	ad_dust_loop = 0;
	ad_dust_time = 1;
	// Allowed this to be a parameter (1.7p2)
	//dust_volsize = 16;
	
	while (ad_dust_loop < ad_dust_qty) {
		ad_dust_vol = ad_vecrand(0,ad_dust_volsize,ad_TRUE);
		ad_dust_org = ad_dust_center + ad_dust_vol;

		// Is the DP particle system active?
		if (ad_ext_dppart && ad_query_configflag(ad_SVR_SPRPARTON) == ad_FALSE && world.ad_sprite_particles == ad_FALSE)
			pointparticles(particleeffectnum(ad_dpp_string), ad_dust_org, '0 0 0', 1);
		else {
			ad_part = ad_fetch_particle();
			// Only preceed if a particle has been returned
			if (ad_part.ad_classtype == ad_CT_PARTICLE) {
				ad_part.owner = self;
				ad_part.movetype = ad_MOVETYPE_NOCLIP;
				ad_part.solid = ad_SOLID_NOT;
				
				// Setup correct particle type (sprite/model) based on ring colour
				ad_particle_style(ad_part, ad_dust_style);
				setorigin (ad_part, ad_dust_org);
				// Zero size and world interaction			
				setsize (ad_part, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

				// Setup particle velocity with random element
				ad_part.velocity = ad_vecrand(0,35,ad_TRUE);
				ad_part.velocity_z = -100 - random()*100;
				ad_part.avelocity = '300 300 300';
		
				// Setup time of death!
				ad_part.nextthink = time + (random()*ad_dust_time) + ad_dust_time;
				ad_part.think = ad_finish_particle;
			}
		}
		// Keep on loopin!
		ad_dust_loop = ad_dust_loop + 1;
	}
};
