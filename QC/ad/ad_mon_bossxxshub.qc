/*==============================================================================
OLD ONE / Shub-Niggurath (ID software Version)
==============================================================================*/
$frame idle1 idle2 idle3 idle4 idle5 idle6 idle7 idle8
$frame idle9 idle10 idle11 idle12 idle13 idle14 idle15 idle16
$frame idle17 idle18 idle19 idle20 idle21 idle22 idle23 idle24
$frame idle25 idle26 idle27 idle28 idle29 idle30 idle31 idle32
$frame idle33 idle34 idle35 idle36 idle37 idle38 idle39 idle40
$frame idle41 idle42 idle43 idle44 idle45 idle46

$frame shake1 shake2 shake3 shake4 shake5 shake6 shake7 shake8
$frame shake9 shake10 shake11 shake12 shake13 shake14 shake15
$frame shake16 shake17 shake18 shake19 shake20

float ad_SHUB_PHASE1 = 1;  // Waiting for a trigger event
float ad_SHUB_PHASE2 = 2;  // Fighting
float ad_SHUB_PHASE3 = 3;  // Frenzy mode
float ad_SHUB_PHASE4 = 4;	// Death

//======================================================================
// Global functions
//======================================================================
// Special streamlined player find function
//----------------------------------------------------------------------
float() ad_xxshub_FindTarget =
{
	local entity ad_client;
	
	// Get the obvious exception(s) done first
	if (self.health < 1) return ad_FALSE;
	if (ad_intermission_running > 0) return ad_FALSE;
	if (ad_cinematic_running > 0) return ad_FALSE;
	
	// Find a client in current PVS
	ad_client = checkclient ();
	
	// Go through all the exception(s)
	if (!ad_client) return ad_FALSE;
	if (!(ad_client.flags & ad_FL_CLIENT)) return ad_FALSE;
	if (ad_client.flags & ad_FL_NOTARGET) return ad_FALSE;
	if (ad_client.items & ad_IT_INVISIBILITY) return ad_FALSE;
	
	// Check range and visibility of player
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return ad_FALSE;

	// Finally found something
	self.enemy = ad_client;
	self.goalentity = self.enemy;

	// We have a winner!
	return ad_TRUE;	
};

//----------------------------------------------------------------------
// Setup wave HP and trigger boundaries (one function to be consistent)
//----------------------------------------------------------------------
void() ad_xxshub_WaveSetupHP =
{
	// Is there anymore boss waves left?
	if (self.ad_bosswave >= self.ad_bosswavetotal) {
		// Only one wave left (death is final trigger)
		self.health = self.ad_bosswaveqty;
		self.ad_bosswavetrig = -1000;
	}
	else {
		// Multiple waves are still left (reset hp+trigger)
		// Always reset HP to stop high DPS weapons trashing waves boundaries
		self.health = ((self.ad_bosswavetotal - self.ad_bosswave) + 1) * self.ad_bosswaveqty;
		// The wave trigger is always one wave lower
		self.ad_bosswavetrig = self.health - self.ad_bosswaveqty;
	}
	// Debug messages for wave and health
	dprint("\b[BOSS]\b Wave ("); dprint(ftos(self.ad_bosswave));
	dprint(" / "); dprint(ftos(self.ad_bosswavetotal));
	dprint(") HP ("); dprint(ftos(self.health));
	dprint(") Trig ("); dprint(ftos(self.ad_bosswavetrig));
	dprint(")\n");
};

//----------------------------------------------------------------------
// Check if HP has reached next boss wave trigger event
//----------------------------------------------------------------------
float() ad_xxshub_WaveCheck =
{
	// Check for boss wave boundary event
	if (self.health > 1 && self.health < self.ad_bosswavetrig) {
		// Check for wave boundary triggers
		self.noise = "";
		if (self.ad_bosswave == 1) self.noise = self.noise1;
		else if(self.ad_bosswave == 2) self.noise = self.noise2;
		else if(self.ad_bosswave == 3) self.noise = self.noise3;
		else if(self.ad_bosswave == 4) self.noise = self.noise4;
		
		// Is there any trigger for the wave boundary?
		if (self.noise != "") ad_trigger_strs(self.noise, self);

		// Update Boss wave parameters (next wave!)
		self.ad_bosswave = self.ad_bosswave + 1;
		ad_xxshub_WaveSetupHP();		// Reset trigger/hp
		self.style = ad_SHUB_PHASE3;	// Frenzy mode
		return ad_TRUE;
	}
	return ad_FALSE;
};

//===========================================================================
// IDLE state - flailing arms (only state really)
//===========================================================================
void() ad_xxshub_idleframe =
{
	// Get the obvious exception(s) done first
	if (self.health < 1) return;
	
	// Beginning of animation block
	if (self.ad_walkframe == 0) ad_monster_idle_sound();
	else if (self.ad_walkframe == 12) ad_monster_idle_sound();
	else if (self.ad_walkframe == 24) ad_monster_idle_sound();
	else if (self.ad_walkframe == 36) ad_monster_idle_sound();
	
	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 45) self.ad_walkframe = 0;
	self.nextthink = time + 0.1;
	self.think = ad_xxshub_idleframe;
	
	// Setup current animation frame
	self.frame = $idle1 + self.ad_walkframe;

	// Check for HP trigger event
	if (ad_xxshub_WaveCheck() == ad_TRUE) self.ad_th_missile();
	
	// Check for combat event
	if (self.style == ad_SHUB_PHASE2) {
		// Check for any no combat conditions
		if (self.enemy.health < 1) self.enemy = world;
		else if (ad_intermission_running > 0) self.enemy = world;
		else if (ad_cinematic_running > 0) self.enemy = world;
		else if (self.enemy.flags & ad_FL_NOTARGET) self.enemy = world;
		else if (self.enemy.items & ad_IT_INVISIBILITY) self.enemy = world;

		// If no enemy, keep looking
		if (!self.enemy) ad_xxshub_FindTarget();
		// Check for attack 1 - Homing Missile
		if (self.enemy) self.ad_th_melee();
	}	
};

//----------------------------------------------------------------------
void() ad_xxshub_idle ={ self.ad_walkframe = 0; ad_xxshub_idleframe(); };

//============================================================================
// Attack 1 : Fire Shub Homing Missile
//============================================================================
void() ad_xxshub_attack1 =
{
	// Check sightline to player
	if (ad_visblocked(self.enemy)) return;
	if (time < self.ad_attack_finished) return;
	
	ad_SUB_AttackFinished (2 + 2*random());
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "shub/attack1.wav", 1, ad_ATTN_NORM);

	// Skill level adjustment
	self.ad_attack_speed = self.pos1_x + (ad_skill*self.pos1_y);
	// Spawn from front of Shub
	ad_Launch_HomingMissile (self.dest1, '0 0 10', ad_CT_PROJ_SHUB1, self.ad_attack_speed);
};

//============================================================================
// Attack 2 : shake and spam grenades (end of wave event)
//============================================================================
void() ad_xxshub_shakeattack = 
{
	local vector ad_org, ad_dir, ad_ang, ad_avel;
	
	// Custom grenade firing speed
	self.ad_attack_speed = self.ad_pos3_x;

	// Shoot grenades from top of shub
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(self.dest2);
	
	// Randomly shoot grenades in any directions
	ad_ang = '0 0 0';
	ad_ang_y = rint(random()*360);
	makevectors(ad_ang);
	ad_dir = v_forward * self.ad_attack_speed;
	ad_dir_z = self.ad_pos3_y;
	
	// Bit of random spin and fire grenade
	ad_avel = ad_vecrand(100,200,ad_FALSE);
	ad_Launch_Grenade(ad_org, ad_dir, ad_avel, ad_CT_PROJ_SHUB2);
};

//----------------------------------------------------------------------
void() ad_xxshub_shakeframe =
{
	// Randomnly fire grenades outward
	if (random() < 0.5) ad_xxshub_shakeattack();
	
	if (self.ad_walkframe == 0) {
		sound (self, ad_CHAN_WEAPON, "shub/attack2.wav", 1, ad_ATTN_NORM);
		self.effects = self.effects | ad_EF_MUZZLEFLASH;
	}
	
	// Keep on looping around
	self.nextthink = time + 0.1;
	self.think = ad_xxshub_shakeframe;

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 14) {
		self.ad_walkframe = 0;
		self.count = self.count + 1;

		// has shub looped around 3 times?
		if (self.count > 2) {
			// Slight attack pause after the shake
			self.ad_attack_finished = time + 2 + 2*random();
			ad_Resist_ChangeType(self, ad_FALSE);
			self.style = ad_SHUB_PHASE2;
			self.think = self.ad_th_stand;
		}
	}
	
	// Update frame and keep on shaking!
	else self.frame = $shake1 + self.ad_walkframe;	
};

//----------------------------------------------------------------------
void() ad_xxshub_attack2 =
{ 
	ad_Resist_ChangeType(self, ad_TRUE);
	self.ad_walkframe = self.count = 0; 
	ad_xxshub_shakeframe();
};

//============================================================================
// PAIN (ignored, just keeps on firing)
//============================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_xxshub_pain =
{
	// Shub been hit, wakeup and start attacking
	if (self.style == ad_SHUB_PHASE1) {self.use(); return;}
	self.ad_pain_finished = time + 2 + random()*2;

	// Check for boss wave trigger events
	if (ad_xxshub_WaveCheck() == ad_TRUE) {self.ad_th_missile(); return;}

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);
	
	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		// Spawn particle/smoke damage
		ad_SpawnProjectileSmoke(ad_inflictor.origin, 200, 50, 150);
		if (ad_damage > 30) ad_SpawnProjectileSmoke(ad_inflictor.origin, 200, 50, 250);
		// random pick sound
		if (random() < 0.5)
			sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
	}
};

//===========================================================================
// FINAL DEATH - shake it baby and explode
//===========================================================================
void() ad_xxshub_explode =
{
	// No more Boss!
	ad_entity_hide(self);
	
	// Blue ID particle explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	WriteByte (ad_MSG_BROADCAST, 35);
	WriteByte (ad_MSG_BROADCAST, 8);
	
	// Classic sprite/DP explosion
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, "shub/explode_death.wav");

	// Gib explosive fountain!?!
	ad_ThrowGib(11, 10 + rint(random()*10));	// large blobs
	ad_ThrowGib(4, 5 + rint(random()*3));		// Some flesh bits
	ad_ThrowGib(5, 10 + rint(random()*3));
};

//----------------------------------------------------------------------
void() ad_xxshub_deathframe =
{
	// Throw debris out from top of shub
	self.ad_pos3 = ad_vecrand(100,100,ad_TRUE);
	self.ad_pos3_z = 128 + random()*128;
	ad_SpawnProjectileSmoke(self.origin+self.ad_pos3, 200, 50, 150);
	// Random chance of gib + explosion
	if (random() < 0.25)	
		ad_SpawnExplosion(ad_EXPLODE_MED, self.origin+self.ad_pos3, ad_SOUND_REXP3);

	// Move frame forward, check for conditions
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 15 && self.count < 3) {
		self.ad_walkframe = 0;
		self.count = self.count + 1;
	}
	
	if (self.ad_walkframe > 19) ad_xxshub_explode();
	// Update frame and keep on shaking!
	else {
		self.frame = $shake1 + self.ad_walkframe;	
		// Keep on looping around
		self.nextthink = time + 0.1;
		self.think = ad_xxshub_deathframe;
	}
};

//----------------------------------------------------------------------
void() ad_xxshub_die =
{
	self.style = ad_SHUB_PHASE4;		// Game Over for Shub!
	self.deadflag = ad_DEAD_DEAD;		// the rock finally crashed
	self.effects = 0;				// Remove effects on death
	self.solid = ad_SOLID_NOT;			// no longer need to block
	self.max_health = ad_MON_GIBEXPLOSION;

	sound (self, ad_CHAN_VOICE, "shub/death1.wav", 1, ad_ATTN_NORM);
	self.ad_walkframe = self.count = 0;
	ad_xxshub_deathframe();
};

//----------------------------------------------------------------------
// Switch Shub into a fighting stance
//----------------------------------------------------------------------
void() ad_xxshub_wakeup =
{
	// Time to fight!
	self.use = ad_SUB_Null;			// No more triggers
	self.style = ad_SHUB_PHASE2;		// Start fighting

	ad_Resist_ChangeType(self, ad_FALSE);	// Default resistance

	// Wakeup sound
	sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_NORM);
	
	// Restore pain thresholds and timers
	self.ad_pain_flinch = 400;			// Shambler level
	self.ad_pain_timeout = 2;			// Stop constant pain
	
	// Wait for wakeup sound to finish before combat
	self.ad_pain_finished = time + 2 + random()*2;
	self.ad_attack_finished = time + 2;
	
	// Check for player (use activator)
	if (ad_activator.flags & ad_FL_CLIENT) self.enemy = ad_activator;
};	

//----------------------------------------------------------------------
// Setup Shub after trigger event
//----------------------------------------------------------------------
void() ad_xxshub_start =
{
	self.use = ad_SUB_Null;			// Suppress trigger events
	self.style = ad_SHUB_PHASE1;		// Waiting for combat trigger
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	if (self.spawnflags & ad_MON_SHUB_UPSIDE) self.flags = self.flags | ad_FL_FLY;
	else self.flags = self.flags | ad_FL_ONGROUND;

	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	
	self.yaw_speed = 0;				// No turning speed
	self.velocity = '0 0 0';		// Make sure stationary
	self.deadflag = ad_DEAD_NO;		// used to stop death re-triggering
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	self.ad_pain_longanim = ad_FALSE;		// No axe advantage
	self.takedamage = ad_DAMAGE_AIM;	// Can receive damage
	self.ad_pain_flinch = 1;			// Pain is a start trigger
	
	self.ad_movespeed = 1;				// Shub does not move!
	self.ad_noinfighting = ad_TRUE;		// No infighting
	self.ad_gibhealth = -1000;			// Special death sequence
	self.ad_pain_finished = self.ad_attack_finished = 0;

	ad_Resist_CheckRange(self);		// Double check values
	ad_Resist_Save(self);				// Save for Later
	// Allow for a damage trigger (spawnflag option only)
	if (!(self.spawnflags & ad_MON_SHUB_DMGTRIG))
		ad_Resist_ChangeType(self, ad_TRUE);

	// Setup boss waves and overall health
	if (self.ad_bosswave < 1) self.ad_bosswavetotal = 5;
	else self.ad_bosswavetotal = self.ad_bosswave;
	
	// Always start bosswave at 1
	self.ad_bosswave = 1;
	if (self.ad_bosswaveqty < 1) self.ad_bosswaveqty = 500;
	self.max_health = self.ad_bosswavetotal * self.ad_bosswaveqty;
	// Setup boss wave HP + trigger event
	ad_xxshub_WaveSetupHP();

	// Restore all think functions
	self.ad_th_stand = ad_xxshub_idle;
	self.ad_th_walk = ad_xxshub_idle;
	self.ad_th_run = ad_xxshub_idle;
	self.ad_th_melee = ad_xxshub_attack1;
	self.ad_th_missile = ad_xxshub_attack2;
	self.ad_th_pain = ad_xxshub_pain;
	self.ad_th_die = ad_xxshub_die;
	
	// Wait for trigger to start attacking
	self.use = ad_xxshub_wakeup;
	self.ad_th_stand();
};

/*============================================================================
 QUAKED monster_shub (1 0 0) (-128 -128 -24) (128 128 512)
============================================================================*/
void() ad_monster_shub =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/oldone.mdl";
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_SHUB1);		// Large Homing Missile
	precache_model (ad_MODEL_PROJ_SHUB2);		// Large blob of blood
	
	// Final explosionm and grenades for attack 2
	self.ad_gib1mdl = ad_MODEL_PROJ_SHUB2;
	self.ad_gib1frame = 9;
	
	self.ad_idle_sound = "shub/idle1.wav";
	self.ad_idle_sound2 = "shub/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	// Att1 : Homing missile
	// Att2 : Grenade spam
	precache_sound ("shub/attack1.wav");
	precache_sound ("shub/attack2.wav");
	precache_sound ("shub/bounce.wav");
	
	self.ad_pain_sound = "shub/pain1.wav";
	self.ad_pain_sound2 = "shub/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	precache_sound ("shub/death1.wav");
	precache_sound ("shub/explode_death.wav");
	
	self.ad_sight_sound = "shub/sight1.wav";
	precache_sound (self.ad_sight_sound);
	
	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	// Use to be 128 square, reduced size to help with
	// radius/splash damage being more effective
	self.ad_bbmins = '-96 -96 -24';	// has own entity setup
	self.ad_bbmaxs = '96 96 192';
	self.ad_bboxtype = ad_BBOX_CUSTOM;	// Custom BBox size
	self.flags = ad_FL_MONSTER;		// Reset flag (no user settings)
	self.ad_bossflag = ad_TRUE;			// Boss flag (like FL_MONSTER)
	self.health = self.max_health = ad_MEGADEATH;
	self.ad_pain_finished = ad_LARGE_TIMER;
	self.ad_no_liquiddmg = ad_TRUE;		// no slime/lava damage
	self.ad_idlemoreoften = ad_TRUE;		// More frequent idle sounds
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_poisonous = ad_FALSE;			// Cannot be poisonous
	self.ad_deathstring = " became one with Shub-Niggurath\n";
	self.ad_lastorigin = self.origin;	// Origin for camera interpolation

	// Check passive system for exceptions
	ad_setup_passivestate_boss(self);
	
	self.deadflag = ad_DEAD_NO;					// used to stop death re-triggering
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	self.takedamage = ad_DAMAGE_NO;				// Immune to damage

	// Attack 1 - Setup projectile speed (200 + 20*skill)
	if (ad_CheckZeroVector(self.pos1)) self.pos1 = '200 20 0';
	// Attack 1 - Setup projectile damage (Base + Random, Splash)
	if (ad_CheckZeroVector(self.pos2)) self.pos2 = ad_DAMAGE_HMSHUB;
	// Attack 2 - Setup projectile speed, splash damage
	if (ad_CheckZeroVector(self.ad_pos3)) self.ad_pos3 = '300 500 40';

	// Attack 1 - Spawn location (offset from origin)
	if (ad_CheckZeroVector(self.dest1)) self.dest1 = '0 0 128';
	// Attack 2 - Spawn location (offset from origin)
	if (ad_CheckZeroVector(self.dest2)) self.dest2 = '0 0 128';

	if (self.spawnflags & ad_MON_SHUB_UPSIDE) {
		self.ad_bbmins = '-96 -96 -192';	// up side down version
		self.ad_bbmaxs = '96 96 24';
	}	
	
	self.ad_classtype = ad_CT_MONXXSHUB;
	self.ad_classgroup = ad_CG_BOSS;
	self.style = 0;
	
	// No targetname = no trigger!
	if (self.targetname == "") {
		dprint("\b[SHUB]\b Missing trigger name!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		return;
	}
	
	// Does not go through monster spawn functions
	total_monsters = total_monsters + 1;
	
	// Default is no spawn delay, wait for trigger
	if (!(self.spawnflags & ad_MON_SPAWN_DELAY)) {
		self.nextthink = time + 0.1 + random()*0.4;
		self.think = ad_xxshub_start;
	}
	else self.use = ad_xxshub_start;
};

/*============================================================================
 QUAKED monster_shubupsd (1 0 0) (-128 -128 -24) (128 128 512)
============================================================================*/
void() ad_monster_shubupsd = 
{
	if (deathmatch) { remove(self); return; }

	// Attack 2 - Setup projectile speed, splash damage
	if (ad_CheckZeroVector(self.ad_pos3)) self.ad_pos3 = '600 0 40';
	self.angles_x = 180;
	self.angles_y = ad_anglemod(self.angles_y + 180);
	self.spawnflags = self.spawnflags | ad_MON_SHUB_UPSIDE;
	
	ad_monster_shub();
};