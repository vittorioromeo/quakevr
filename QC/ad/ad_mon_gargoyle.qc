//----------------------------------------------------------------------
// Sightsound and very quick animation while moving forward
void()	ad_garg_wakeup1	=[	$flyup2,	ad_garg_wakeup2	] {ad_ai_forward(1);};
void()	ad_garg_wakeup2	=[	$flyup4,	ad_garg_wakeup3	] {ad_ai_forward(4);};
void()	ad_garg_wakeup3	=[	$flyup6,	ad_garg_wakeup4	] {ad_ai_forward(8);};
void()	ad_garg_wakeup4	=[	$flyup14,	ad_garg_wakeup5	] {ad_ai_forward(8);ad_gargoylewings();};
void()	ad_garg_wakeup5	=[	$flyup16,	ad_garg_wakeup6	] {ad_ai_forward(4);};
void()	ad_garg_wakeup6	=[	$flyup20,	ad_garg_run1	] {
	ad_monster_targets();			// Find target (angry/path_corner)
	self.nextthink = time + 0.1;// Next frame
};

//----------------------------------------------------------------------
void() ad_gargoyle_wakeup =
{
	// Dead already?
	if (self.health < 1) return;

	// No longer perched on the ground
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_GARGOYLE_PERCH);
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_STATUE);
	self.ad_spawnstatue = ad_FALSE;	// No longer stationary
	
	self.takedamage = ad_DAMAGE_AIM;		// Can receive damage
	self.use = ad_SUB_Null;				// no re-trigger
	
	// Restore all think state functions
	self.ad_th_stand = ad_garg_idle1;
	self.ad_th_walk = ad_garg_walk1;
	self.ad_th_run = ad_garg_run1;
	self.ad_th_missile = ad_garg_fire1;

	// Allow gargoyle to fly up, no more ground checks
	self.flags = self.flags | ad_FL_FLY;
	self.movetype = ad_MOVETYPE_STEP;
	self.ad_pain_finished = time + 1.5;		// No pain
	self.ad_attack_finished = 1.5 + random();	// No skill adjustment
	ad_garg_wakeup1();
};

//----------------------------------------------------------------------
void() ad_gargoyle_statue =
{
	if (random() < ad_MON_IDLE_SOUND) sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
	
 	self.think = ad_gargoyle_statue;
 	self.nextthink = time + 5 + random()*5;
};

//======================================================================
// MINION - Grow and spin up from nothing
//======================================================================
void() ad_gargoyle_growangle = {self.angles_y = self.angles_y + self.lefty;};
void() ad_gargoyle_grow1 = [ $grow1, ad_gargoyle_grow2 ] {};
void() ad_gargoyle_grow2 = [ $grow2, ad_gargoyle_grow3 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow3 = [ $grow3, ad_gargoyle_grow4 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow4 = [ $grow4, ad_gargoyle_grow5 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow5 = [ $grow5, ad_gargoyle_grow6 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow6 = [ $grow6, ad_gargoyle_grow7 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow7 = [ $grow7, ad_gargoyle_grow8 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow8 = [ $grow8, ad_gargoyle_grow9 ] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow9 = [ $grow9, ad_gargoyle_grow10] {ad_gargoyle_growangle();};
void() ad_gargoyle_grow10= [ $grow10, ad_garg_run1 ] {
	// Is the gargoyle stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		// Finally spin back to original position
		self.angles_y = self.angles_y + self.lefty;
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);

		// Restore all think state functions
		self.ad_th_stand = ad_garg_idle1;
		self.ad_th_walk = ad_garg_walk1;
		self.ad_th_run = ad_garg_run1;
		self.ad_th_missile = ad_garg_fire1;
	}
};
//----------------------------------------------------------------------------
void() ad_gargoyle_grow =
{
	// Only call wakeup function once
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run  = ad_SUB_Null;
	if (random() < 0.5) self.lefty = 36;
	else self.lefty = -36;
	ad_monster_sightsound();
	ad_gargoyle_grow1();
};

//============================================================================
// The gargoyle does not have a specific pain animation
// - Kinn created one from the death animation (Marcher progs)
void()	ad_garg_pain1	=[	$death3,	ad_garg_pain2	] {};
void()	ad_garg_pain2	=[	$death4,	ad_garg_pain3	] {};
void()	ad_garg_pain3	=[	$death3,	ad_garg_pain4	] {};
void()	ad_garg_pain4	=[	$death2,	ad_garg_pain5	] {};
void()	ad_garg_pain5	=[	$death1,	ad_garg_run1	] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_garg_pain =
{
	// Check for perching gargoyles, need special wakeup
	if (self.spawnflags & ad_MON_GARGOYLE_PERCH) ad_gargoyle_wakeup();
	// Statues don't feel pain!
	else if (self.spawnflags & ad_MON_STATUE) return;
	else {
		// Check all pain conditions and set up what to do next
		ad_monster_pain_check(ad_attacker, ad_damage);

		// make sure any fireball is hidden
		if (self.ad_attachment) ad_garg_fbfinish();

		// Any pain animation/sound required?
		if (self.ad_pain_check > 0) {
			if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
			if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
				ad_garg_pain1 ();
			}
		}
	}
};

//============================================================================
void()	ad_garg_death1	=[	$death1,	ad_garg_death2	] {};
void()	ad_garg_death2	=[	$death3,	ad_garg_death3	] {ad_monster_check_gib();};
void()	ad_garg_death3	=[	$death5,	ad_garg_death4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void()	ad_garg_death4	=[	$death7,	ad_garg_death5	] {};
void()	ad_garg_death5	=[	$death9,	ad_garg_death6	] {};
void()	ad_garg_death6	=[	$death11,	ad_garg_death7	] {};
void()	ad_garg_death7	=[	$death13,	ad_garg_death8	] {ad_monster_death_postcheck();};
void()	ad_garg_death8	=[	$death14,	ad_garg_death8	] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_garg_die =
{
	// Statues don't die!
	if (self.spawnflags & ad_MON_STATUE) return;
	
	// Make sure any wings sound is silenced
	sound (self, ad_CHAN_ITEM, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);

	// Check for perching gargoyles, need to blow up in gibs
	// In an awkward pose that does not go well into death animations
	if (self.spawnflags & ad_MON_GARGOYLE_PERCH) self.ad_gibondeath = ad_TRUE;

	// If creating a Fireball, make it explode!
	if (self.ad_attachment) {
		if (self.ad_attachment.state == ad_STATE_ON) {
			self.ad_gibondeath = ad_TRUE;
			ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
			ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
			if (self.ad_poisonous) self.lip = ad_PARTICLE_BURST_GREEN;
			else self.lip = ad_PARTICLE_BURST_FIRE;
			ad_particle_explode(self.origin-'0 0 16', 50+random()*50, 2, self.lip, ad_PARTICLE_BURST_UPWARD);
			makevectors(self.angles);
			self.oldorigin = self.origin + v_forward*8;
			if (self.ad_poisonous) self.lip = ad_EXPLODE_POISON_BIG;
			else self.lip = ad_EXPLODE_BIG;
			ad_SpawnExplosion(self.lip, self.oldorigin, ad_SOUND_REXP3);
		}
		// make sure any fireball is hidden
		ad_garg_fbfinish();
	}

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	
	// If not gibbed, then drop to ground
	if (!self.ad_gibbed) { 
		sound (self, ad_CHAN_VOICE, "gargoyle/death1.wav", 1, ad_ATTN_NORM);
		self.flags = ad_FL_MONSTER;				// reset all flag conditions
		self.movetype = ad_MOVETYPE_TOSS;			// Affected by gravity
		self.velocity_x = -200 + 400*random();
		self.velocity_y = -200 + 400*random();
		self.velocity_z = 100 + 100*random();
		ad_garg_death1 ();
	}
};

/*======================================================================
QUAKED monster_gargoyle (0.8 0 0.2) (-16 -16 -24) (16 16 40) AMBUSH STATUE PERCH NOSIGHT NOIDLE NOGFX STARTOFF ANGRY Not_Easy Not_Normal Not_Hard Not_DM
{ model(":progs/mon_gargoyle.mdl"); }
Gargoyle, 120 health points.
-------- KEYS --------
-------- SPAWNFLAGS --------
STATUE : Stone statue until triggered (always starts in a perched position)
PERCH : Start in a sitting down, place 44 units out from perching edge, 4 units higher

======================================================================*/
void() ad_setup_gargoyle;
void() ad_monster_gargoyle =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_gargoyle.mdl";
	self.ad_headmdl = "progs/h_gargoyle.mdl";
	self.ad_gib1mdl = "progs/gib_gargwing1.mdl";	// Left wing
	self.ad_gib2mdl = "progs/gib_gargwing2.mdl";	// Right wing

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_GARGBALL);		// FB growing 8 frames
	precache_model (ad_MODEL_PROJ_GARGOYLE);		// red/smoke wiz projectile
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);

	self.ad_idle_sound = "gargoyle/idle1.wav";
	self.ad_idle_soundcom = "gargoyle/perch1.wav";
	self.ad_idle_soundcom2 = "gargoyle/perch2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_soundcom);
	precache_sound (self.ad_idle_soundcom2);

	precache_sound ("gargoyle/attack1.wav");	// Doom imp fireball!
	precache_sound ("gargoyle/swoop1.wav");
	precache_sound ("gargoyle/swoop2.wav");
	precache_sound ("gargoyle/swoop1hit.wav");
	precache_sound ("gargoyle/wings1.wav");
	
	self.ad_pain_sound = "gargoyle/pain75.wav";
	self.ad_pain_sound2 = "gargoyle/pain100.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	precache_sound ("gargoyle/death1.wav");

	self.ad_sight_sound = "gargoyle/sight1.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_GARGBALLGRN);	// Ball growing 8 frames
		precache_model (ad_MODEL_PROJ_GARGOYLEGRN);	// acid/smoke wiz projectile
	}
	
	// Cache gargoyle is a special class used for precache only
	if (self.ad_classtype != ad_CT_CACHEGARGOYLE) ad_setup_gargoyle();
};
	
//----------------------------------------------------------------------------
void() ad_monster_minotaurminion = { 
	self.ad_classtype = ad_CT_CACHEGARGOYLE; 
	self.ad_poisonous = ad_TRUE;	// Cache poison stuff for minotaur spawns
	ad_monster_gargoyle();
};

//----------------------------------------------------------------------------
void() ad_setup_gargoyle =
{
	// Randomize gib parts
	if (random() < 0.5) self.ad_gib1mdl = ad_string_null;
	else if (random() < 0.5) self.ad_gib2mdl = ad_string_null;

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 120;
	self.ad_gibhealth = -70;				// Need a powerful weapon to GIB
	self.ad_gibbed = ad_FALSE;				// no falling apart
	self.ad_pain_flinch = 70;				// High pain threshold
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_attack_explosive = ad_TRUE;		// Has explosive attack
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	self.ad_attack_offset = '16 28 22';	// fireball start location
	self.ad_deathstring = " was burned by a Gargoyle\n";
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_GargoyleCheckAttack;
	self.ad_th_pain = ad_garg_pain; 
	self.ad_th_die = ad_garg_die;
		
	if(!self.ad_classtype) self.ad_classtype = ad_CT_MONGARGOYLE;
	if (!self.ad_classgroup) self.ad_classgroup = ad_CG_WIZARD;
	self.ad_classmove = ad_MON_MOVEFLY;

	// Fix double spawnflags problem - default to statue
	if (self.spawnflags & ad_MON_STATUE && self.spawnflags & ad_MON_GARGOYLE_PERCH) {
		dprint("\b[GARGOYLE]\b Cannot be perch and statue!\n");
		self.spawnflags = self.spawnflags - ad_MON_GARGOYLE_PERCH;
	}	
	
	//----------------------------------------------------------------------
	// Perched Gargoyles have special idle animation + idle sounds
	// The AI needs to be setup 40 units forward and 24 units up
	// to be positioned feet flat on perch surface
	if (self.spawnflags & ad_MON_GARGOYLE_PERCH) {
		self.ad_th_stand = self.ad_th_walk = ad_garg_perch1;
		self.ad_th_run = self.ad_th_missile = ad_gargoyle_wakeup;
	}
	//----------------------------------------------------------------------
	// Statue Gargoyles setup in perch position with statue idle sounds
	// Randomly picks a frame position from perch animation set
	else if (self.spawnflags & ad_MON_STATUE) {
		// Setup stone idle sounds
		self.ad_idle_sound = "statue/idle1.wav";
		self.ad_idle_sound2 = "statue/idle2.wav";
		precache_sound (self.ad_idle_sound);
		precache_sound (self.ad_idle_sound2);
		
		self.ad_spawnstatue = ad_TRUE;			// Start as a statue
		self.ad_poisonous = ad_FALSE;				// Cannot be status + poison
		self.ad_th_stand = ad_gargoyle_statue;	// Stone idle pose
		self.ad_think1 = ad_gargoyle_wakeup;		// Wakeup statue angry at player
		self.skin = 1;						// Stone like skin
		self.ad_gib1skin = self.ad_gib2skin = 1;
		//self.resist_nails = 0.5;			// Stone resistance
		// Work out random starting pose
		self.pos1_x = $perch1;
		self.pos1_y = $perch24;
		self.pos1_z = fabs(self.pos1_y - self.pos1_x);
		self.frame = rint(self.pos1_x + random() * self.pos1_z);
	}
	//----------------------------------------------------------------------
	// Special spawning minion need to start spinning
	else if (self.ad_classtype == ad_CT_MINIONGARGOYLE) {
		self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_gargoyle_grow;
		self.ad_th_missile = ad_SUB_Null;
	}
	//----------------------------------------------------------------------
	// Default gargoyle setup
	else {
		self.ad_th_stand = ad_garg_idle1;
		self.ad_th_walk = ad_garg_walk1;
		self.ad_th_run = ad_garg_run1;
		self.ad_th_missile = ad_garg_fire1;
	}
	
	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn gargoyles (requires monster_minotaurminion entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_gargoyle =
{
	local entity ad_minion;

	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	// Self = minotaur, there is no egg 
	ad_update_minioncount(self, 1);			// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_gargoyle";	// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self;					// Spawner Parent Link
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_gibondeath = 1;					// Always gib on death
	ad_minion.ad_classtype = ad_CT_MINIONGARGOYLE;	// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.spawnflags = 0;
	ad_minion.ad_classgroup = ad_CG_DEMON;			// Don't turn on master
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	// Check for poison gibs being cached first
	if (ad_gibpoison && self.ad_poisonous == ad_TRUE) {
		ad_minion.ad_poisonous = self.ad_poisonous;	// carry over from host spawner 
		ad_minion.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}
	
	// Adopt parameters from host spawner
	ad_minion.ad_infightextra = self.ad_infightextra;
	
	ad_minion.mdl = "progs/mon_gargoyle.mdl";
	ad_minion.ad_headmdl = "progs/h_gargoyle.mdl";
	ad_minion.ad_gib1mdl = "progs/gib_gargwing1.mdl";	// Left wing
	ad_minion.ad_gib2mdl = "progs/gib_gargwing2.mdl";	// Right wing

	ad_minion.ad_pain_sound = "gargoyle/pain75.wav";
	ad_minion.ad_pain_sound2 = "gargoyle/pain100.wav";
	ad_minion.ad_idle_sound = "gargoyle/idle1.wav";
	ad_minion.ad_idle_soundcom = "gargoyle/perch1.wav";
	ad_minion.ad_idle_soundcom2 = "gargoyle/perch2.wav";
	ad_minion.ad_sight_sound = "gargoyle/sight1.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_gargoyle;
};