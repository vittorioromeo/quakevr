void()	ad_garg_run7	=[	$fly13,	ad_garg_run8	] {ad_ai_run(5);};
void()	ad_garg_run8	=[	$fly15,	ad_garg_run9	] {ad_ai_run(6);};
void()	ad_garg_run9	=[	$fly17,	ad_garg_run10	] {ad_ai_run(7);};
void()	ad_garg_run10	=[	$fly19,	ad_garg_run1	] {ad_ai_run(8);};

//============================================================================
// Range attack
//============================================================================
void() ad_garg_fbthrow =
{
	local vector ad_org, ad_dir;
	
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = normalize(ad_SUB_orgEnemyTarget() - ad_org);
	self.ad_attack_speed = ad_SPEED_GARGMISSILE + (ad_skill * ad_SPEED_GARGSKILL);
	
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_GARG, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_garg_fbfinish =
{
	setmodel(self.ad_attachment, "");
	self.ad_attachment.state = ad_STATE_OFF;
};

//----------------------------------------------------------------------
void(float ad_fbframe, vector ad_fbofs) ad_garg_fbupdate =
{
	if (self.health < 1) return;
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		if (self.ad_poisonous) self.ad_attachment.mdl = ad_MODEL_PROJ_GARGBALLGRN;
		else self.ad_attachment.mdl = ad_MODEL_PROJ_GARGBALL;
		self.ad_attachment.alpha = 0.85;
	}
	
	if (ad_fbframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		self.ad_pain_finished = time + 1.5;		//don't go into pain whilst firing
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		sound (self, ad_CHAN_WEAPON, "gargoyle/attack1.wav", 1, ad_ATTN_NORM);
	}

	ad_ai_face();					// Turn towards enemy
	makevectors(self.angles);
	self.ad_attachment.origin = self.origin + v_forward*ad_fbofs_x + v_right*ad_fbofs_y;
	self.ad_attachment.origin_z = self.ad_attachment.origin_z + ad_fbofs_z;
	setorigin(self.ad_attachment, self.ad_attachment.origin);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = ad_fbframe;
};

//----------------------------------------------------------------------
// Original offset position for gargoyle fireball (designed for a sprite)
// 10 16 0, 4 24 2, -7 28 15, -25 26 28, -38 12 45, -38 9 45, -17 36 30, 24 16 10
// Changed the offset to match the new model instead
// Positioned the fireball to match the hand orientation
//----------------------------------------------------------------------
void() ad_garg_fire1	=[ $attack2, ad_garg_fire2 ] {ad_garg_fbupdate(0,'10 16 -2');};
void() ad_garg_fire2	=[ $attack4, ad_garg_fire3 ] {ad_garg_fbupdate(2,'0 20 -2');};
void() ad_garg_fire3	=[ $attack6, ad_garg_fire4 ] {ad_garg_fbupdate(3,'-6 23 6');ad_gargoylewings();};
void() ad_garg_fire4	=[ $attack8, ad_garg_fire5 ] {ad_garg_fbupdate(4,'-16 26 18');};
void() ad_garg_fire5	=[ $attack10, ad_garg_fire6 ] {ad_garg_fbupdate(5,'-29 18 38');};
void() ad_garg_fire6	=[ $attack12, ad_garg_fire7 ] {ad_garg_fbupdate(4,'-34 9 45');};
void() ad_garg_fire7	=[ $attack14, ad_garg_fire8 ] {ad_garg_fbupdate(3,'-32 22 38');};
void() ad_garg_fire8	=[ $attack16, ad_garg_fire9 ] {ad_garg_fbfinish();ad_garg_fbthrow();};
void() ad_garg_fire9	=[ $attack18, ad_garg_fire10 ] {ad_ai_face();ad_monster_idle_sound();};
void() ad_garg_fire10	=[ $attack20, ad_garg_run1 ] {ad_ai_face();
	// If enemy really close, goto into a frenzy of fireball attacks
	self.ad_enemydist = ad_range_distance(ad_SUB_entEnemyTarget(), ad_FALSE);
	if (ad_SUB_healthEnemyTarget() > 0 && self.ad_enemydist < ad_MON_RANGE_CLOSE) self.think = ad_garg_fire1;
	else self.ad_attack_state = ad_AS_STRAIGHT;
};

