//======================================================================
void()	ad_garg_run1	=[	$fly1,	ad_garg_run2	] {ad_monster_idle_sound();
	if (self.ad_attachment && self.ad_attachment.state == ad_STATE_ON) ad_garg_fbfinish();
	// Switch direction of strafing (random duration)
	if (self.ad_meleeattack < time) {
		self.ad_meleeattack = time + 4 + (random() + random() + random() * 4);
		self.lefty = rint(1 - self.lefty);
	}
	ad_ai_run(4);
};
void()	ad_garg_run2	=[	$fly3,	ad_garg_run3	] {ad_ai_run(5);};
void()	ad_garg_run3	=[	$fly5,	ad_garg_run4	] {ad_gargoylewings(); ad_ai_run(6);};
void()	ad_garg_run4	=[	$fly7,	ad_garg_run5	] {ad_ai_run(7);};
void()	ad_garg_run5	=[	$fly9,	ad_garg_run6	] {ad_ai_run(8);};
