//===========================================================================
// FINISHING (STOP) - exit point for the range attack logic
// STOP  - lower crossbow and then run / hunt player
void()	ad_dcrossbow_stop1 =[	$tstop1,	ad_dcrossbow_stop2	] {self.ad_weaponstate = ad_CROSS_UP;};
void()	ad_dcrossbow_stop2 =[	$tstop2,	ad_dcrossbow_stop3	] {};
void()	ad_dcrossbow_stop3 =[	$tstop3,	ad_dcrossbow_stop4	] {};
void()	ad_dcrossbow_stop4 =[	$tstop4,	ad_dcrossbow_stop5	] {};
void()	ad_dcrossbow_stop5 =[	$tstop5,	ad_dcrossbow_stop6	] {};
void()	ad_dcrossbow_stop6 =[	$tstop6,	ad_dcrossbow_stop7	] {};
void()	ad_dcrossbow_stop7 =[	$tstop7,	ad_dcrossbow_run1 ] {self.ad_weaponstate = ad_CROSS_DOWN;};

//===========================================================================
void() ad_dcrossbow_shot =
{
	local	vector ad_org, ad_dir;

	if (!self.enemy) return;
	if (self.health < 1) return;

	// Flash effect to show where bolt is coming from	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "weapons/crossbow_fire.wav", 1, ad_ATTN_NORM);

	// Skill level adjustment
	self.ad_attack_speed = ad_SPEED_DCROSS + (ad_skill*ad_SPEED_BOLTSKILL);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);

	//It certainly was really cool to write the code for tracking and
	//lots of fun to watch how the AI adapts to the player movement,
	//but as a player it just feels cheap and unfair!
	//- The tracking feature is now just a spawnflag option
	if (self.spawnflags & ad_MON_DCROSSTRACK) ad_dir = normalize(self.ad_attack_track - ad_org);
	else ad_dir = normalize(self.enemy.origin - ad_org);
	
	// Fire projectile at player	
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_BOLT1, self.ad_attack_speed);
};

//----------------------------------------------------------------------------
// FIRE  - fires crossbow and reload
// Trimmed down from 32 frames to 20 (now 2s reload time)
// Removed - 4,6,8,10, 17,19,21,23, 25,27,29,31
//----------------------------------------------------------------------------
void()	ad_dcrossbow_fire1 =[	$tfire1,	ad_dcrossbow_fire2	] {ad_dcrossbow_shot();};
void()	ad_dcrossbow_fire2 =[	$tfire2,	ad_dcrossbow_fire3	] {ad_ai_face();};
void()	ad_dcrossbow_fire3 =[	$tfire3,	ad_dcrossbow_fire5	] {ad_ai_face();};
void()	ad_dcrossbow_fire5 =[	$tfire5,	ad_dcrossbow_fire7	] {};
void()	ad_dcrossbow_fire7 =[	$tfire7,	ad_dcrossbow_fire9	] {};
void()	ad_dcrossbow_fire9 =[	$tfire9,	ad_dcrossbow_fire11] {};
void()	ad_dcrossbow_fire11 =[	$tfire11,	ad_dcrossbow_fire12] {};
void()	ad_dcrossbow_fire12 =[	$tfire12,	ad_dcrossbow_fire13] {};
void()	ad_dcrossbow_fire13 =[	$tfire13,	ad_dcrossbow_fire14] {};
void()	ad_dcrossbow_fire14 =[	$tfire14,	ad_dcrossbow_fire15] {};
void()	ad_dcrossbow_fire15 =[	$tfire15,	ad_dcrossbow_fire16] {
	sound (self, ad_CHAN_WEAPON, self.ad_sight_sound, 1, ad_ATTN_NORM);};
void()	ad_dcrossbow_fire16 =[	$tfire16,	ad_dcrossbow_fire18] {};
void()	ad_dcrossbow_fire18 =[	$tfire18,	ad_dcrossbow_fire20] {};
void()	ad_dcrossbow_fire20 =[	$tfire20,	ad_dcrossbow_fire22] {};
void()	ad_dcrossbow_fire22 =[	$tfire22,	ad_dcrossbow_fire24] {};
void()	ad_dcrossbow_fire24 =[	$tfire24,	ad_dcrossbow_fire26] {};
void()	ad_dcrossbow_fire26 =[	$tfire26,	ad_dcrossbow_fire28] {ad_ai_face();};
void()	ad_dcrossbow_fire28 =[	$tfire28,	ad_dcrossbow_fire30] {ad_ai_face();};
void()	ad_dcrossbow_fire30 =[	$tfire30,	ad_dcrossbow_hold1] {ad_ai_face();
	self.ad_weaponswitch = time + ad_CROSS_TIMEOUT;			// Don't exit straight away
};

//===========================================================================
void() ad_dcrossbow_checkattack =
{
	local float ad_boltspeed;

	// Always return if monster is dead!
	if (self.health < 1) return;

	// Check to see if enemy is dead? back to run/hunt cycle
	if (self.enemy.health < 1) ad_dcrossbow_stop1();
	else {
		// is the enemy visible? (liquid check)
		if (ad_visible(self.enemy)) {
			self.ad_weaponswitch = time + ad_CROSS_TIMEOUT;
			// Is the enemy blocked by another enemy?
			if (!ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0')) {
				// Is the enemy within melee range?
				if (ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) self.ad_th_melee();
				else {
					// Skill level adjustment for bolt speed
					ad_boltspeed = ad_SPEED_DCROSS + (ad_skill*ad_SPEED_BOLTSKILL);
					self.ad_attack_track = ad_SUB_Tracking(self.ad_attack_track, self.ad_attack_offset, self.enemy, ad_boltspeed);
		
					// Chance of attack? start out low and get better chance+tracking over time	
					self.ad_attack_chance = self.ad_attack_chance + 0.2;
					if (random() < self.ad_attack_chance) ad_dcrossbow_fire1();
				}
			}
		}
		else {
			// Have not see player for a while, stop wating and hunt for them
			if (self.ad_weaponswitch < time+0.1) ad_dcrossbow_stop1();
			else {
				// If cannot see player try strafe side to side first before hunt mode
				if (self.ad_attack_state == ad_AS_MISSILE) self.think = ad_dcrossbow_slide1;
			}
		}
	}
};

//----------------------------------------------------------------------------
// SLIDE  - strafe side to side movement, crossbow up high
void()	ad_dcrossbow_slide1 =[	$tslide1,	ad_dcrossbow_slide2	] {ad_ai_run_slide(4);
	self.ad_attack_state = ad_AS_SLIDING;			// Update type of attack
	self.ad_attack_chance = 0.5;				// higher chance to attack because moving
	self.ad_attack_track = self.enemy.origin;	// reset enemy origin ready for tracking
	ad_dcrossbow_checkattack();				// Start tracking the player
};
void()	ad_dcrossbow_slide2 =[	$tslide2,	ad_dcrossbow_slide3	] {ad_ai_run_slide(6);ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_slide3 =[	$tslide3,	ad_dcrossbow_slide4	] {ad_ai_run_slide(4);ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_slide4 =[	$tslide4,	ad_dcrossbow_slide5	] {ad_ai_run_slide(2);ad_dcrossbow_checkattack();ad_monster_footstep(ad_FALSE);};
void()	ad_dcrossbow_slide5 =[	$tslide5,	ad_dcrossbow_slide6	] {ad_ai_run_slide(4);ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_slide6 =[	$tslide6,	ad_dcrossbow_slide7	] {ad_ai_run_slide(6);ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_slide7 =[	$tslide7,	ad_dcrossbow_slide8	] {ad_ai_run_slide(4);ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_slide8 =[	$tslide8,	ad_dcrossbow_slide1	] {ad_ai_run_slide(2);
	if (!ad_visblocked_wide(self.enemy, '0 0 28', '0 0 0')) self.think = ad_dcrossbow_hold1;
	else ad_dcrossbow_checkattack();
};

//----------------------------------------------------------------------------
// STARTING (SLIDE) - brings crossbow up to shoulder height
void()	ad_dcrossbow_slideup1 =[	$tready1,	ad_dcrossbow_slideup2	] {ad_ai_face();
	self.ad_weaponstate = ad_CROSS_DOWN;		// Crossbow animation state
	self.lefty = rint(random());		// Randomize strafe direction
};
void()	ad_dcrossbow_slideup2 =[	$tready2,	ad_dcrossbow_slideup3	] {};
void()	ad_dcrossbow_slideup3 =[	$tready3,	ad_dcrossbow_slideup4	] {ad_ai_face();};
