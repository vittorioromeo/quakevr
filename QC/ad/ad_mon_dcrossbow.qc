	self.ad_weaponswitch = time + ad_CROSS_TIMEOUT;	// Don't exit straight away
	self.ad_weaponstate = ad_CROSS_UP;				// Crossbow animation in correct state for slide/hold
};

//===========================================================================
// Cycle between melee attacks
// Attack 1 - Slice (stationary one hand slashing attack)
// Attack 2 - Smash (chop overhead to ground)
//----------------------------------------------------------------------
void()	ad_dcrossbow_slice1	=[	$slice2,	ad_dcrossbow_slice2	] {self.ad_weaponstate = ad_CROSS_DOWN;ad_ai_face();};
void()	ad_dcrossbow_slice2	=[	$slice3,	ad_dcrossbow_slice3	] {ad_ai_face(); ad_dcrossbow_crossbow_sound();};
void()	ad_dcrossbow_slice3	=[	$slice4,	ad_dcrossbow_slice4	] {ad_ai_face();};
void()	ad_dcrossbow_slice4	=[	$slice5,	ad_dcrossbow_slice5	] {ad_ai_melee();};
void()	ad_dcrossbow_slice5	=[	$slice6,	ad_dcrossbow_slice6	] {self.ad_meleecontact=ad_TRUE;ad_ai_meleesmash(15);};
void()	ad_dcrossbow_slice6	=[	$slice7,	ad_dcrossbow_slice7	] {ad_ai_melee();self.ad_meleecontact=ad_FALSE;};
void()	ad_dcrossbow_slice7	=[	$slice8,	ad_dcrossbow_slice8	] {};
