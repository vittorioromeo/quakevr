void()	ad_dcrossbow_stand1	=[	$stand1,	ad_dcrossbow_stand2	] {ad_monster_idle_sound();ad_ai_stand();};
void()	ad_dcrossbow_stand2	=[	$stand2,	ad_dcrossbow_stand3	] {ad_ai_stand();};
void()	ad_dcrossbow_stand3	=[	$stand3,	ad_dcrossbow_stand4	] {ad_ai_stand();};
