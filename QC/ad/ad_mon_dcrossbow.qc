void()	ad_dcrossbow_walk8	=[	$walk8,		ad_dcrossbow_walk9	] {ad_ai_walk(3); ad_monster_footstep(ad_FALSE);};
void()	ad_dcrossbow_walk9	=[	$walk9,		ad_dcrossbow_walk10] {ad_ai_walk(3);};
void()	ad_dcrossbow_walk10 =[ $walk10,	ad_dcrossbow_walk11] {ad_ai_walk(4);};
void()	ad_dcrossbow_walk11	=[	$walk11,	ad_dcrossbow_walk12	] {ad_ai_walk(3);};
void()	ad_dcrossbow_walk12	=[	$walk12,	ad_dcrossbow_walk13	] {ad_ai_walk(4);};
