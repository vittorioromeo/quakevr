	self.ad_weaponswitch = time + ad_CROSS_TIMEOUT;			// Don't exit straight away
	self.ad_weaponstate = ad_CROSS_UP;		// Crossbow animation in correct state for slide/hold
};

//----------------------------------------------------------------------------
void() ad_dcrossbow_checkslide =
{
	if (self.ad_weaponstate == ad_CROSS_DOWN) ad_dcrossbow_slideup1();
	else ad_dcrossbow_slide1();
};

//----------------------------------------------------------------------------
// HOLD  - keeps crossbow up high and wait to fire at player
// Random chance to slide to the side instead of being a stationary target
void()	ad_dcrossbow_hold1 =[	$thold1,	ad_dcrossbow_hold2	] {ad_ai_face();
	self.ad_attack_state = ad_AS_MISSILE;			// Update type of attack
	// Quick fire coming from melee attack, otherwise slow build up
	if (self.ad_attack_chance < 0) self.ad_attack_chance = 0.5;
	else self.ad_attack_chance = 0;			// Initial chance of attack is low
	self.ad_attack_track = self.enemy.origin;	// reset enemy origin ready for tracking
	ad_dcrossbow_checkattack();
};
void()	ad_dcrossbow_hold2 =[	$thold2,	ad_dcrossbow_hold3	] {ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_hold3 =[	$thold3,	ad_dcrossbow_hold4	] {ad_ai_face();ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_hold4 =[	$thold4,	ad_dcrossbow_hold5	] {ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_hold5 =[	$thold5,	ad_dcrossbow_hold6	] {ad_ai_face();ad_dcrossbow_checkattack();};
void()	ad_dcrossbow_hold6 =[	$thold6,	ad_dcrossbow_hold1	] {
	if (random() < 0.5) self.think = ad_dcrossbow_slide1;
	else ad_dcrossbow_checkattack();
};
		
//----------------------------------------------------------------------------
// STARTING (HOLD) - brings crossbow up to shoulder height
void()	ad_dcrossbow_ready1 =[	$tready1,	ad_dcrossbow_ready2	] {ad_ai_face();
	self.ad_weaponstate = ad_CROSS_DOWN;		// Crossbow animation state
	self.lefty = rint(random());		// Randomize strafe direction
};
