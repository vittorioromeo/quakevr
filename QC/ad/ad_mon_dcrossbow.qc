void()	ad_dcrossbow_painD8	=[	$painD8,		ad_dcrossbow_painD9	] {ad_monster_footstep(ad_FALSE);};
void()	ad_dcrossbow_painD9	=[	$painD9,		ad_dcrossbow_painD10	] {};
void()	ad_dcrossbow_painD10=[	$painD10,		ad_dcrossbow_painD11	] {};
void()	ad_dcrossbow_painD11=[	$painD11,		ad_dcrossbow_run1	] {};
//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage)	ad_dcrossbow_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			if (random() < 0.85) ad_dcrossbow_painA1 ();	// classic, body recoil
			else {
				ad_dcrossbow_painD1 ();			// Cool stumble, hand over mouth
				self.ad_pain_finished = time + 2;	// long animation
			}
		}
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 1.1;
			self.ad_axhitme = 0;
			ad_dcrossbow_painD1 ();
		}
	}
};

