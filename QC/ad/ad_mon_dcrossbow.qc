void()	ad_dcrossbow_walk1	=[	$walk1,		ad_dcrossbow_walk2	] {ad_monster_idle_sound(); 
	self.ad_idlebusy = ad_FALSE; ad_ai_walk(2);};
void()	ad_dcrossbow_walk2	=[	$walk2,		ad_dcrossbow_walk3	] {ad_monster_footstep(ad_FALSE);ad_ai_walk(5);};
