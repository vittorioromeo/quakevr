void()	ad_dcrossbow_walk14	=[	$walk14,	ad_dcrossbow_walk1	] {ad_ai_walk(2);};

//===========================================================================
// 6 frames instead of 8 frames (skipping 3rd/7th timing of original)

void()	ad_dcrossbow_run1	=[	$run1,	ad_dcrossbow_run2	] { ad_monster_idle_sound();
	self.ad_idlebusy = ad_FALSE; ad_ai_run (16);};
void()	ad_dcrossbow_run2	=[	$run2,	ad_dcrossbow_run3	] {ad_ai_run(20);};
void()	ad_dcrossbow_run3	=[	$run3,	ad_dcrossbow_run4	] {ad_ai_run(7);};
