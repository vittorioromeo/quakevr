void()	ad_dcrossbow_slice11	=[	$slice12,	ad_dcrossbow_slice1	] {ad_dcrossbow_checkmelee();};

//----------------------------------------------------------------------
// Knight - 11 frames (skipped (1, 11, 14, 15)
void()	ad_dcrossbow_smash1	=[	$smash2,	ad_dcrossbow_smash2	] {self.ad_weaponstate = ad_CROSS_DOWN;ad_ai_charge(1);};
void()	ad_dcrossbow_smash2	=[	$smash3,	ad_dcrossbow_smash3	] {ad_ai_charge(7);};
void()	ad_dcrossbow_smash3	=[	$smash4,	ad_dcrossbow_smash4	] {ad_monster_footstep(ad_FALSE); ad_ai_charge(4);};
void()	ad_dcrossbow_smash4	=[	$smash5,	ad_dcrossbow_smash5	] {ad_ai_face();};
void()	ad_dcrossbow_smash5	=[	$smash6,	ad_dcrossbow_smash6	] {ad_dcrossbow_crossbow_sound(); ad_ai_charge(3);};
void()	ad_dcrossbow_smash6	=[	$smash7,	ad_dcrossbow_smash7	] {ad_ai_charge(4);ad_ai_melee();};
void()	ad_dcrossbow_smash7	=[	$smash8,	ad_dcrossbow_smash8	] {ad_monster_footstep(ad_FALSE);self.ad_meleecontact=ad_TRUE;ad_ai_meleesmash(15);};
void()	ad_dcrossbow_smash8	=[	$smash9,	ad_dcrossbow_smash9	] {ad_ai_charge(3);ad_ai_melee();self.ad_meleecontact=ad_FALSE;};
void()	ad_dcrossbow_smash9	=[	$smash10,	ad_dcrossbow_smash10	] {ad_ai_charge(1);};
void()	ad_dcrossbow_smash10	=[	$smash12,	ad_dcrossbow_smash11	] {ad_ai_charge(1);};
void()	ad_dcrossbow_smash11	=[	$smash13,	ad_dcrossbow_smash1	] {ad_dcrossbow_checkmelee();};

//----------------------------------------------------------------------
void() ad_dcrossbow_melee =
{
	// Cycle between different melee attacks
	self.ad_meleeattack = self.ad_meleeattack + 1;
	if (self.ad_meleeattack == 1) ad_dcrossbow_slice1();
	else { ad_dcrossbow_smash1(); self.ad_meleeattack = 0; }
};

//----------------------------------------------------------------------
void() ad_dcrossbow_checkmelee =
{
	// Always return if monster is dead!
	if (self.health < 1) return;

	// Check to see if enemy is dead? back to run/hunt cycle
	if (self.enemy.health < 1) ad_ai_run(0);
	else {
		// Is the enemy within melee range?
		// If not then do a quick hipshot at the player
		if (!ad_ai_checkmelee(ad_MONAI_MELEEKNIGHT,ad_FALSE)) {
			self.ad_attack_chance = -1;	// Start with higher percentage
			ad_dcrossbow_ready1();			// Raise up crossbow ready
		}
		else ad_dcrossbow_melee();
	}
};

//============================================================================
void()	ad_dcrossbow_painA1	=[	$painA1,		ad_dcrossbow_painA2	] {self.ad_weaponstate = ad_CROSS_DOWN;};
