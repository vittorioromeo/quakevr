//----------------------------------------------------------------------
void() ad_dcrossbow_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// Clear weapon sound
	sound (self, ad_CHAN_WEAPON, ad_SOUND_EMPTY, 1, ad_ATTN_NORM);

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "knight/kdeath.wav", 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dcrossbow_die1 ();
		else ad_dcrossbow_dieb1 ();
	}
};

//============================================================================
void() ad_dcrossbow_crossbow_sound =
{
	sound (self, ad_CHAN_WEAPON, "weapons/crossbow_swipe.wav", 1, ad_ATTN_NORM);
};

/*======================================================================
QUAKED monster_dcrossbow (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_dcrossbow =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dcrossbow.mdl";			// crossbow guy
	self.ad_headmdl = "progs/h_dcrossbow.mdl";
	self.ad_gib1mdl = "progs/w_dcrossbow.mdl";			// Unique weapon
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";		// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";		// right foot
	
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_BOLT1);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	if (random() < 0.5) self.ad_gib2mdl = ad_string_null;
	if (random() < 0.5) self.ad_gib3mdl = ad_string_null;

	self.ad_idle_sound = "dknight/dcross_idle.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_idle_soundcom = "dknight/dcross_idlecom.wav";
	precache_sound (self.ad_idle_soundcom);

	self.ad_pain_sound = "knight/khurt.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound ("knight/kdeath.wav");

	// Crossbow and bolt sounds
	precache_sound ("weapons/bolt_hit1.wav");
	precache_sound ("weapons/bolt_hit2.wav");
	precache_sound ("weapons/bolt_hit3.wav");
	precache_sound ("weapons/bolt_hit4.wav");
	precache_sound ("weapons/crossbow_fire.wav");
	precache_sound ("weapons/crossbow_swipe.wav");

	// Heavy wood sound
	self.ad_meleehitsound = "weapons/crossbow_hit1.wav";
	precache_sound (self.ad_meleehitsound);

	self.ad_sight_sound = "weapons/crossbow_rdy.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_BOLT2);	// Green poison bolt
		self.skin = self.ad_exactskin = 1;		// Greener Green+++ Skin!?!
	}
		
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = 75;
	self.ad_gibhealth = -25;				// Can be gib from a rocket/grenade
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 40;
	self.ad_pain_longanim = ad_TRUE;
	self.ad_steptype = ad_FS_TYPEMEDIUM;
	self.ad_weaponstate = ad_CROSS_DOWN;		// Maintain crossbow state
	self.ad_meleecontact = ad_FALSE;			// Smash contact
	self.ad_meleerange = ad_MONAI_MELEEFRONT;	// Smash attack
	self.ad_attack_offset = '20 12 28';	// Where to fire bolt from
	self.ad_deathstring = " was skewered by a Crossbow Knight\n";
	
	// check for sniper mode, no distance checks for attacks
	if (self.spawnflags & ad_MON_DCROSSSNIPER)
		self.ad_enemymaxdist = ad_TRUE;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_DCrossCheckAttack;
	self.ad_th_stand = ad_dcrossbow_stand1;
	self.ad_th_walk = ad_dcrossbow_walk1;
	self.ad_th_run = ad_dcrossbow_run1;
	self.ad_th_melee = ad_dcrossbow_melee;
	self.ad_th_missile = ad_dcrossbow_ready1;
	self.ad_th_slide = ad_dcrossbow_checkslide;
	self.ad_th_pain = ad_dcrossbow_pain;
	self.ad_th_die = ad_dcrossbow_die;

	self.ad_classtype = ad_CT_MONDCROSS;
	self.ad_classgroup = ad_CG_KNIGHT;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
