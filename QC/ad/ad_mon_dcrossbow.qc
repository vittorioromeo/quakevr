void()	ad_dcrossbow_stand6	=[	$stand6,	ad_dcrossbow_stand7	] {ad_ai_stand();};
void()	ad_dcrossbow_stand7	=[	$stand7,	ad_dcrossbow_stand8	] {ad_ai_stand();};
void()	ad_dcrossbow_stand8	=[	$stand8,	ad_dcrossbow_stand9	] {ad_ai_stand();};
void()	ad_dcrossbow_stand9	=[	$stand9,	ad_dcrossbow_stand10	] {ad_ai_stand();};
void()	ad_dcrossbow_stand10	=[	$stand10,	ad_dcrossbow_stand1	] {
	self.ad_idlebusy = ad_FALSE; 
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.ad_idlebusy = ad_TRUE; 
		// Make sure the idle animations don't repeat in a row
		self.lefty = self.lip;
		while (self.lefty == self.lip) { self.lefty = rint(random()*6);}
		self.lip = self.lefty;
		if (self.lip < 1) self.think = ad_dcrossbow_standE1;		// Scratch back
		else if (self.lip < 2) self.think = ad_dcrossbow_standD1;	// Look at weapon
		else if (self.lip < 3) self.think = ad_dcrossbow_standC1;	// Ready, steady, hold!
		else if (self.lip < 4) self.think = ad_dcrossbow_standF1;	// Dust off crossbow
		else if (self.lip < 5) self.think = ad_dcrossbow_standA1;	// Look around
		else self.think = ad_dcrossbow_standB1;										// Hold crossbow up
	}
	ad_ai_stand();
};

