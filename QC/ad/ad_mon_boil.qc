//======================================================================
// NO PAIN
//======================================================================
void(entity ad_inflictor, entity ad_attacker, float ad_take) ad_boil_pain =
{
	// Spawn some grey particles and chunk of meat
	ad_SpawnProjectileSmoke(self.origin, self.ad_brkvelbase_x, self.ad_brkvelbase_y, self.ad_brkvelbase_z);
	ad_SpawnProjectileMeat(self,self.origin, self.ad_brkvelbase_x, self.ad_brkvelbase_y, self.ad_brkvelbase_z);
	// Random chance of more smokey meat
	if (random() < 0.5) {
		ad_SpawnProjectileSmoke(self.origin, self.ad_brkvelbase_x, self.ad_brkvelbase_y, self.ad_brkvelbase_z);
		ad_SpawnProjectileMeat(self,self.origin, self.ad_brkvelbase_x, self.ad_brkvelbase_y, self.ad_brkvelbase_z);
	}

	// No special animation
	return; 
};

//============================================================================
void() ad_boil_explode = {
	// Needs special version of radius damage function (T_RadiusDamage)
	// Boss monsters are always immune to this kind of damage
	// Needs to do infighting damage before T_Damage function
	// There is no rocket resistance to this kind damage!
	// Must pass on self.enemy so that any death triggers work properly
	//
	self.ad_enemytarget = findradius(self.origin, self.ad_death_dmg+40);
	// Loop through chain list
	while(self.ad_enemytarget) {
		// Ignore self and world and can never damage bosses
		if (self.ad_enemytarget != world && self.ad_enemytarget != self && self.ad_enemytarget.ad_bossflag == 0) {
			// Check for any breakables which are prone to explosive damage
			if (ad_ai_foundbreakable(self.enemy, self.ad_enemytarget,ad_TRUE) && 
			self.ad_enemytarget.ad_brktrigmissile != 0) {
				ad_trigger_ent(self.ad_enemytarget, self.enemy);
			}
			else {
				// Can be damaged and NOT immune to radius (splash) damage
				if (self.ad_enemytarget.takedamage > 0 && self.ad_enemytarget.ad_noradiusdmg == 0) {
					// Make sure monsters take more damage
					if (self.ad_enemytarget.flags & ad_FL_MONSTER)
						self.dmg = self.ad_death_dmg * self.ad_infightextra;
					else {
						// Use original radius formula for non monsters
						self.pos1 = self.ad_enemytarget.origin + (self.ad_enemytarget.mins + self.ad_enemytarget.maxs)*0.5;
						self.dmg = 0.5*vlen (self.origin - self.pos1);
						if (self.dmg < 0) self.dmg = 0;
						self.dmg = self.ad_death_dmg - self.dmg;
					}
					
					if (self.dmg > 0 && self.ad_enemytarget.health > 0) {
						// Need CanDamage to check for anything blocking LoS
						if (ad_CanDamage (self.ad_enemytarget, self))
							// Pass on self.enemy so death triggers fire correctly
							ad_T_Damage (self.ad_enemytarget, self, self.enemy, self.dmg, ad_DAMARMOR);
							// make sure to check for poisonous and apply debuff
							if (self.dmg > 0 && self.ad_poisonous == ad_TRUE) ad_PoisonDeBuff(self.ad_enemytarget);
					}
				}
			}
		}
		// Move forward in chain to next entity
		self.ad_enemytarget = self.ad_enemytarget.chain;
	}
	
	/*----------------------------------------------------------------------
	// I really liked this idea of the boil destroying any monster
	// bodies lying closeby, BUT this is a serious processor drain
	// on maps with a huge amount of monsters.
	// Every monster that dies is marked and left on the floor and
	// this function would search them all everytime a boil explodes!
	//
	// The code below works fine, BUT it should only be enabled
	// for maps with small amount of available monsters
	//----------------------------------------------------------------------
	
	// Check for any nearby dead/lying bodies
	self.enemytarget = find(world, bodyonflr, MON_ONFLR);
	self.dmg = self.death_dmg * self.infightextra;
	// restrict size of dead body search list
	self.count = 64;

	// Cycle through list of "marked" dead bodies
	// These entities cannot be found by a findradius command
	// They are setup nonsolid and have to be checked manually
	while (self.enemytarget) {
		// Work out how close the body is to the boil
		self.enemydist = vlen(self.origin - self.enemytarget.origin);
		if (self.enemydist < self.death_dmg+40) {
			// Use shadow axe gib function (moved to ai_gib)
			monster_flrbody_gib(self.enemytarget, self.dmg);
		}
		// Only check the first xx dead bodies in the list
		self.count = self.count - 1;
		if (self.count < 1) self.enemytarget = world;
		else self.enemytarget = find(self.enemytarget, bodyonflr, MON_ONFLR);
	}
	*/
	
	// Switch explosions effect based on poison flag
	if (self.ad_poisonous) {
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION2);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		WriteByte (ad_MSG_BROADCAST, 51);
		WriteByte (ad_MSG_BROADCAST, 8);
	}
	else {
		// Show classic grenade explosion effect
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	}
	// Can drop health packs! - randomizer
	if (self.healamount > 0) ad_DropHealthpack();
};

//----------------------------------------------------------------------
void() ad_boil_die =
{
	// Upward fountain of gibs
	self.max_health = ad_MON_GIBFOUNTAIN;
	ad_monster_death_precheck();
	// New gib + loud explosion sound
	sound (self, ad_CHAN_AUTO, "zombie/boil_explode.wav", 1, ad_ATTN_NORM);
	// Delay the t_radius explosion for one frame
	// Just in case several are standing next to each other
	// otherwise there will be a runaway crash loop
	self.think = ad_boil_explode;
	self.nextthink = time + 0.1;
};


/*======================================================================
 QUAKED monster_boil (1 0 0) (-16 -16 -24) (16 16 32)
======================================================================*/
void() ad_monster_boil =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_boil.mdl";
	precache_model (self.mdl);

	self.ad_idle_sound = "zombie/boil_idle1.wav";
	self.ad_idle_sound2 = "zombie/boil_idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	
	self.ad_sight_sound = "zombie/boil_sight.wav";
	precache_sound (self.ad_sight_sound);
	self.ad_pain_sound = ad_SOUND_EMPTY;
	precache_sound ("zombie/boil_squirt.wav");
	precache_sound ("zombie/boil_windup.wav");
	precache_sound ("zombie/boil_explode.wav");

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
	}
	
	// The randomizer drops health packs on death
	if (self.healamount > 0) ad_CacheHealthpacks();
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_SHORT;
	if (self.health < 1) self.health = 40;
	self.ad_gibhealth = -60;				// Never used
	self.ad_gibbed = ad_FALSE;				// In one piece
	self.ad_pain_flinch = 10;				// Has gib splash
	self.ad_steptype = ad_FS_TYPESLOW;		// Tiny feet
	self.ad_gibondeath = ad_TRUE;				// Always blow up!
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_BOIL;
	if (self.ad_infightextra < 1) self.ad_infightextra = 16;
	self.ad_attack_instant = 1;			// Start moving right away
	self.ad_deathstring = " was blown away by a Boil\n";
	
	// Setup timer for flesh gib squirting from body
	if (self.wait < 1) self.wait = 4;
	self.waitmin = time + self.wait + random() * self.wait;
	// Randomly pick one from the first four skins
	// 0=flesh, 1=brown, 2=green1, 3=green2, 4=flesh
	if (!self.ad_exactskin) self.ad_randomskin = 4;
	self.ad_brkvelbase = '200 50 150';

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	// All boils die the same way
	self.ad_th_checkattack = ad_BoilCheckAttack;
	self.ad_th_pain = ad_boil_pain;
	self.ad_th_die = ad_boil_die;

	self.ad_classtype = ad_CT_MONBOIL;
	self.ad_classgroup = ad_CG_SPAWN;
	self.ad_classmove = ad_MON_MOVEWALK;

	// Setup random hobble animation
	if (self.spawnflags & ( ad_MON_BOIL_HOBBLED | ad_MON_BOIL_HANGING)) {
		// A = Crossed legs, B = Straight legs
		if (random() < 0.5) {		
			self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_boil_hoba1;
			self.ad_th_melee = ad_boil_HexpA1;
		}
		else {
			self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_boil_hobb1;
			self.ad_th_melee = ad_boil_HexpB1;
		}
		// No movement, turret mode
		self.ad_movespeed = -1;
		// The stationary boil cannot start angry at anything
		self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_SPAWN_ANGRY);
		self.ad_angrytarget = "";
		// Instantly blow up when triggered
		self.ad_think1 = ad_boil_suicide;
		// Cannot have sight sound, its nailed to wall/floor!
		self.ad_sight_sound = ad_SOUND_EMPTY;
		// Allow for override on exploding trigger radius
		if (self.t_width < 1) self.t_width = ad_MONAI_HOBBLEBOIL;
	}
	
	// Hobbled hanging upside down on wall?
	if (self.spawnflags & ad_MON_BOIL_HANGING) {
		// Make sure angle is within range (0-360)
		if (self.angles_y < 0) self.angles_y = 360;
		// Calculate opposite facing direction
		self.movedir = '0 0 0';
		self.movedir_y = ad_anglemod(self.angles_y + 180);
		// Calculate upward vector and rotate monster
		makevectors(self.angles);
		self.angles = self.movedir + vectoangles(v_up);
		// Pull monster away from wall
		self.origin = self.origin + v_forward*10;
		// Allow monster to float and no ground check
		self.ad_classmove = ad_MON_MOVEFLY;
		self.flags = self.flags | ad_FL_FLY;
		// Setup squirt distance for blood
		self.ad_brkvelbase = '100 50 150';
	}
	// Hobbled legs with spikes (ground pose)
	else if (self.spawnflags & ad_MON_BOIL_HOBBLED) {
		// Check for random floor rotation and setup no movment
		if (self.angles_y < 0) self.angles_y = rint(random()*360);
		// Setup squirt distance for blood
		self.ad_brkvelbase = '100 300 100';
	}
	else {
		// Allow for override on exploding trigger radius
		if (self.t_width < 1) self.t_width = ad_MONAI_MELEEBOIL;
		// Default stand, walk & run
		self.ad_th_stand = ad_boil_stand1;
		self.ad_th_walk = ad_boil_walk1;
		self.ad_th_run = ad_boil_run1;
		self.ad_th_melee = ad_boil_expl1;
	}
	
	// Delay spawn randomized boils a couple of frame
	// To avoid telefrags issues of bad placement of HP packs
	if (self.ad_randomized > 0) {
		self.nextthink = time + 0.1 + (random()*0.2);
		self.think = ad_monster_start;
	}
	else ad_monster_start();
};
