//======================================================================
// Stationary Boil - Nailed to the floor or wall
//======================================================================
void() ad_boil_suicide =
{ 
	if (self.health < 1) return;
	self.use = ad_SUB_Null;
	// Make sure current enemy is the cause of the damage
	ad_T_Damage (self, self, self.enemy, self.health+1, ad_NOARMOR);
};

//----------------------------------------------------------------------
void() ad_boil_checktarget =
{
	local entity ad_client;
	
	// Should never have an active enemy
	self.enemy = self.goalentity = world;
	
	// Get the obvious exception(s) done first
	if (self.health < 1) return;
	if (ad_intermission_running > 0) return;
	if (ad_cinematic_running > 0) return;

	// Find a client in current PVS
	ad_client = checkclient ();

	// Go through all the exception(s)
	if (!ad_client) return ad_FALSE;
	if (!(ad_client.flags & ad_FL_CLIENT)) return;
	if (ad_client.flags & ad_FL_NOTARGET) return;
	if (ad_client.items & ad_IT_INVISIBILITY) return;

	// Check if the player is visible?
	ad_enemy_vis = ad_visible(ad_client);
	if (!ad_enemy_vis) return;
	
	// Store client/player for later damage
	self.enemy = ad_client;

	// Is the player within range to blow up?
	self.ad_enemydist = ad_range_distance(ad_client, ad_FALSE);
	if (self.ad_enemydist < self.t_width) self.ad_th_melee();
};

//----------------------------------------------------------------------
void() ad_boil_squirtblood =
{
	if (self.waitmin < time) {
		self.waitmin = time + self.wait + random() * self.wait;
		sound (self, ad_CHAN_WEAPON, "zombie/boil_squirt.wav", 1, ad_ATTN_IDLE);
		
		ad_SpawnProjectileMeat(self,self.origin,self.ad_brkvelbase_x, self.ad_brkvelbase_y, self.ad_brkvelbase_z);
		// Randomly spawn an extra gib of flesh
		if (random() < 0.25) ad_SpawnProjectileMeat(self,self.origin,self.ad_brkvelbase_x, self.ad_brkvelbase_y, self.ad_brkvelbase_z);
	}
};

