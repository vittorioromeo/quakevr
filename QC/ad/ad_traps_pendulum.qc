// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// TRAP PENDULUM
//======================================================================
float ad_PEND_MAXFRAME = 12;	// Frames 0-12
float ad_PEND_ANIMGROUP = 13;	// Size of animation group
float ad_PEND_MIDFRAME = 7;	// Fastest think frame

float ad_PEND_REVERSE = 1;		// Start at frame 12 instead of 0
float ad_PEND_ONESWING = 2;	// Do one swing cycle and stop (back+forth)
float ad_PEND_SHORT = 16;		// Short pole version (128 instead of 192)
float ad_PEND_XSWING = 32;		// Swing X axis (def=Y)

//----------------------------------------------------------------------
// The array is setup from world.qc before anything loads
//----------------------------------------------------------------------
vector ad_pend_X[26], ad_pend_Y[26], ad_pend_short[26];

//----------------------------------------------------------------------
// As the pendulum swings the bounding box is adjusted around the blade
// Some swings have the bbox ahead of the blade to catch impacts better
// bbox values taken from the original pendulum from Rogue mission pack
// Using view_ofs because the model has been rebuilt/reskinned
//----------------------------------------------------------------------
void() ad_pendulum_setuparray =
{
	local float ad_loopc, ad_loopd, ad_tempx;
	local vector ad_tbuffer;
	
	ad_pend_Y[0] = '-8 -176 48'; 		ad_pend_Y[1] = '8 -120 128';
	ad_pend_Y[2] = '-8 -172 12';		ad_pend_Y[3] = '8 -112 88';
	ad_pend_Y[4] = '-8 -160 -22';		ad_pend_Y[5] = '8 -96 50';
	ad_pend_Y[6] = '-8 -138 -51';		ad_pend_Y[7] = '8 -70 17';
	ad_pend_Y[8] = '-8 -110 -72';		ad_pend_Y[9] = '8 -38 -8';
	ad_pend_Y[10] = '-8 -76 -83';		ad_pend_Y[11] = '8 0 -23';
	ad_pend_Y[12] = '-8 -40 -88';		ad_pend_Y[13] = '8 40 -32';
	ad_pend_Y[14] = '-8 0 -83';		ad_pend_Y[15] = '8 76 -23';
	ad_pend_Y[16] = '-8 38 -72';		ad_pend_Y[17] = '8 100 -8';
	ad_pend_Y[18] = '-8 70 -51';		ad_pend_Y[19] = '8 138 17';
	ad_pend_Y[20] = '-8 96 -22';		ad_pend_Y[21] = '8 160 50';
	ad_pend_Y[22] = '-8 112 12';		ad_pend_Y[23] = '8 172 88';
	ad_pend_Y[24] = '-8 120 48';		ad_pend_Y[25] = '8 176 128';
	
	// 128 unit pendulum - Y Swing (default)
	ad_pend_short[0] = '0 64 -108';	ad_pend_short[1] = '0 56 -92';
	ad_pend_short[2] = '0 56 -76';		ad_pend_short[3] = '0 48 -60';
	ad_pend_short[4] = '0 36 -52';		ad_pend_short[5] = '0 16 -44';
	ad_pend_short[6] = '0 0 -44';		ad_pend_short[7] = '0 -16 -44';
	ad_pend_short[8] = '0 -32 -52';	ad_pend_short[9] = '0 -48 -60';
	ad_pend_short[10] = '0 -56 -76';	ad_pend_short[11] = '0 -56 -92';
	ad_pend_short[12] = '0 -64 -108';
	
	ad_loopc = ad_loopd = 0;
	
	while (ad_loopc < ad_PEND_ANIMGROUP) {
		// Generate X axis vector offset from Y axis data (short pendulum)
		ad_tbuffer = ad_pend_short[ad_loopc];		// Read vector offset
		ad_tempx = ad_tbuffer_x;					// Tempoary store
		ad_tbuffer_x = ad_tbuffer_y;				// Swap around
		ad_tbuffer_y = ad_tempx;					// Restore temp
		ad_pend_short[ad_PEND_ANIMGROUP + ad_loopc] = ad_tbuffer;
		
		// Generate X axis swing min/max vector from Y axis data
		ad_tbuffer = ad_pend_Y[ad_loopd];			// min bbox
		ad_tempx = ad_tbuffer_x;
		ad_tbuffer_x = ad_tbuffer_y;
		ad_tbuffer_y = ad_tempx;
		ad_pend_X[ad_loopd] = ad_tbuffer;		
		ad_tbuffer = ad_pend_Y[ad_loopd+1];			// max bbox
		ad_tempx = ad_tbuffer_x;
		ad_tbuffer_x = ad_tbuffer_y;
		ad_tbuffer_y = ad_tempx;
		ad_pend_X[ad_loopd+1] = ad_tbuffer;	
		
		ad_loopc = ad_loopc + 1;
		ad_loopd = ad_loopd + 2;
	}
};

//----------------------------------------------------------------------
// The original rogue pendulum adjusted the bbox every animation frame
// FTEQCC supports arrays and the previous method can now be done easier
// Also sets the nextthink time to adjust for swing momentum
//----------------------------------------------------------------------
void(float ad_frame_seq) ad_trap_pendsize = {
	self.cnt = ad_frame_seq * 2;
	
	// Short pendulum needs a different offset each frame
	if (self.spawnflags & ad_PEND_SHORT) {
		if (self.spawnflags & ad_PEND_XSWING) self.view_ofs = ad_pend_short[ad_PEND_ANIMGROUP+ad_frame_seq];
		else self.view_ofs = ad_pend_short[ad_frame_seq];
	}

	// X/Y swing axis have different bbox vectors
	if (self.spawnflags & ad_PEND_XSWING) {
		self.pos1 = ad_pend_X[self.cnt] + self.view_ofs;
		self.pos2 = ad_pend_X[self.cnt + 1] + self.view_ofs;
	}
	else {
		self.pos1 = ad_pend_Y[self.cnt] + self.view_ofs;
		self.pos2 = ad_pend_Y[self.cnt + 1] + self.view_ofs;
	}
	setsize( self, self.pos1, self.pos2 );
	
	if (self.think) {
		// Change nextthink time to simulate the pendulum going fast/slow from momentum
		self.cnt = 0.05 + (fabs(ad_PEND_MIDFRAME - (ad_frame_seq + 1)) * 0.02);
		self.nextthink = time + self.cnt;
	}
};

//----------------------------------------------------------------------
// Pendulum animation frames
//----------------------------------------------------------------------
$frame pend_frame1 pend_frame2 pend_frame3 pend_frame4 pend_frame5 pend_frame6 pend_frame7
$frame pend_frame8 pend_frame9 pend_frame10 pend_frame11 pend_frame12 pend_frame13

// Stationary idle for beginning and ending
void() ad_pend_idle1 =[ $pend_frame1, ad_pend_idle1 ] {};
void() ad_pend_idle21 =[ $pend_frame13, ad_pend_idle21 ] {};

//----------------------------------------------------------------------
// Pendulum Swing (one cycle is 26 frames)
//----------------------------------------------------------------------
void() ad_pend_swing1 =[ $pend_frame1, ad_pend_swing2 ] {
	// Stop the pendulum if state is OFF / DISABLED
	if (self.ad_estate & ad_ESTATE_BLOCK) self.think = ad_pend_idle1;
	else if (self.state == ad_STATE_OFF) self.think = ad_pend_idle1;
	else {
		self.count = self.count + 1;
		if (self.spawnflags & ad_PEND_ONESWING && self.count > 2) {
			self.state = ad_STATE_OFF;
			self.think = ad_pend_idle1;
		}
		else {
			ad_trap_pendsize(0);	// Move bbox to frame 0
			self.aflag = 1;		// Direction of pendulum blade (touch function)
		}
	}
};
void() ad_pend_swing2 =[ $pend_frame2, ad_pend_swing3 ] { ad_trap_pendsize(1);};
void() ad_pend_swing3 =[ $pend_frame3, ad_pend_swing4 ] { ad_trap_pendsize(2);}; 
void() ad_pend_swing4 =[ $pend_frame4, ad_pend_swing5 ] { ad_trap_pendsize(3);
sound ( self, ad_CHAN_VOICE, self.noise1, 0.5, ad_ATTN_NORM);};
void() ad_pend_swing5 =[ $pend_frame5,		ad_pend_swing6 ] {ad_trap_pendsize(4);};
void() ad_pend_swing6 =[ $pend_frame6,		ad_pend_swing7 ] {ad_trap_pendsize(5);};
void() ad_pend_swing7 =[ $pend_frame7,		ad_pend_swing8 ] {ad_trap_pendsize(6);};
void() ad_pend_swing8 =[ $pend_frame8,		ad_pend_swing9 ] {ad_trap_pendsize(7);};
void() ad_pend_swing9 =[ $pend_frame9,		ad_pend_swing10 ] {ad_trap_pendsize(8);};
void() ad_pend_swing10 =[ $pend_frame10,	ad_pend_swing11 ] {ad_trap_pendsize(9);};
void() ad_pend_swing11 =[ $pend_frame11,	ad_pend_swing12 ] {ad_trap_pendsize(10);};
void() ad_pend_swing12 =[ $pend_frame12,	ad_pend_swing13 ] {ad_trap_pendsize(11);};
// One extra frame pause at end of sequence
void() ad_pend_swing13 =[ $pend_frame13,	ad_pend_swing21 ] {ad_trap_pendsize(12);};

//----------------------------------------------------------------------
void() ad_pend_swing21 =[ $pend_frame13,	ad_pend_swing22 ] {
	// Stop the pendulum if state is OFF / DISABLED
	if (self.ad_estate & ad_ESTATE_BLOCK) self.think = ad_pend_idle21;
	else if (self.state == ad_STATE_OFF) self.think = ad_pend_idle21;
	else {
		self.count = self.count + 1;
		if (self.spawnflags & ad_PEND_ONESWING && self.count > 2) {
			self.state = ad_STATE_OFF;
			self.think = ad_pend_idle21;
		}
		else {
			ad_trap_pendsize(12);	// Move bbox to frame 12
			self.aflag = -1;		// Direction of pendulum blade (touch function)
		}
	}
};
void() ad_pend_swing22 =[ $pend_frame12,	ad_pend_swing23 ] {ad_trap_pendsize(11);};
void() ad_pend_swing23 =[ $pend_frame11,	ad_pend_swing24 ] {ad_trap_pendsize(10);};
void() ad_pend_swing24 =[ $pend_frame10,	ad_pend_swing25 ] {ad_trap_pendsize(9);
sound ( self, ad_CHAN_VOICE, self.noise1, 0.5, ad_ATTN_NORM);};
void() ad_pend_swing25 =[ $pend_frame9,	ad_pend_swing26 ] {ad_trap_pendsize(8);};
void() ad_pend_swing26 =[ $pend_frame8,	ad_pend_swing27 ] {ad_trap_pendsize(7);};
void() ad_pend_swing27 =[ $pend_frame7,	ad_pend_swing28 ] {ad_trap_pendsize(6);};
void() ad_pend_swing28 =[ $pend_frame6,	ad_pend_swing29 ] {ad_trap_pendsize(5);};
void() ad_pend_swing29 =[ $pend_frame5,	ad_pend_swing30 ] {ad_trap_pendsize(4);};
void() ad_pend_swing30 =[ $pend_frame4,	ad_pend_swing31 ] {ad_trap_pendsize(3);};
void() ad_pend_swing31 =[ $pend_frame3,	ad_pend_swing32 ] {ad_trap_pendsize(2);};
void() ad_pend_swing32 =[ $pend_frame2,	ad_pend_swing33 ] {ad_trap_pendsize(1);};
// One extra frame pause at end of sequence
void() ad_pend_swing33 =[ $pend_frame1,	ad_pend_swing1 ] {ad_trap_pendsize(0);};

//----------------------------------------------------------------------
// if something has touched the pendulum, damage and bounce away
//----------------------------------------------------------------------
void() ad_trap_pendulum_touch =
{
	// Blade can still hurt if touched, except when OFF = not visible
	if (self.ad_estate & ad_ESTATE_OFF) return;
	// Double check if dead monster body!
	if (ad_trigger_check_body(other,ad_DEAD_EXPLODE)) return;
	if (other.health < 1 || other.takedamage == ad_DAMAGE_NO) return;
	if (self.ad_attack_finished > time) return;
	if (self.waitmin > 0) self.ad_attack_finished = time + self.waitmin;

	// only play hit sound once per second
	if (self.ad_pain_finished < time) {
		sound ( self, ad_CHAN_VOICE, self.noise2, 1, ad_ATTN_NORM);
		self.ad_pain_finished = time + 1;
	}
	
	// Instant death for monsters, they can get knocked into wierd locations
	if (other.flags & ad_FL_MONSTER) 
		ad_T_Damage (other, self, self, other.max_health + 100, ad_DAMARMOR);
	else 
		// Small damage but can be lethal because of how often touch runs
		ad_T_Damage (other, self, self, self.dmg, ad_DAMARMOR);

	// Fling the player/object away from blade
	// Setting aflag in animation frame to specify direction
	if (self.spawnflags & ad_PEND_XSWING) other.velocity_x = self.aflag * 250;
	else other.velocity_y = self.aflag * 250;
	other.velocity_z = 200;		// Little upward lift
	
	// Blood and gore at object location not pendulum
	ad_SpawnMeatSpray (other, other, ad_crandom() * 200);
};

//----------------------------------------------------------------------
void() ad_trap_pendulum_fire =
{
	// Swing counter
	self.count = 0;
	// Make sure starting frame is start or finish
	if (self.frame != 0 && self.frame != ad_PEND_MAXFRAME)
		self.frame = self.ad_frame_override;
	
	// Setup next frame to update swing
	if (self.frame == 0) self.think = ad_pend_swing1;
	else self.think = ad_pend_swing13;
	self.nextthink = time + 0.01 + self.wait;
};

//----------------------------------------------------------------------
void() ad_trap_pendulum_use =
{
	// Deal with STARTOFF functionality first
	if (self.spawnflags & ad_ENT_STARTOFF) {
		// Remove spawnflag and switch ON entity
		self.spawnflags = self.spawnflags - ad_ENT_STARTOFF;
		self.state = ad_STATE_OFF;	// use toggle function
		self.ad_estate_on();		// switch on
	}

	// Block USE functionality if state wrong
	if (self.ad_estate & ad_ESTATE_BLOCK) return;

	// Toggle state of pendulum to start/stop
	if (self.state == ad_STATE_OFF) {
		self.state = ad_STATE_ON;
		ad_trap_pendulum_fire();
	}
	else self.state = ad_STATE_OFF;
};

//----------------------------------------------------------------------
void() ad_trap_pendulum_on =
{
	// Turn on model/world interaction
	self.ad_estate = ad_ESTATE_ON;	
	self.solid = ad_SOLID_TRIGGER;
	self.movetype = ad_MOVETYPE_NONE;
	setmodel (self, self.mdl);
	setsize (self, self.mins , self.maxs);
	ad_trap_pendsize(self.frame);
};

//----------------------------------------------------------------------
void() ad_trap_pendulum_off =
{
	self.ad_estate = ad_ESTATE_OFF;
	self.movetype = ad_MOVETYPE_NONE;
	self.solid = ad_SOLID_NOT;
	setmodel (self, "");
	self.frame = self.ad_frame_override;
	self.state = ad_STATE_OFF;
	self.think = ad_SUB_Null;
};

//----------------------------------------------------------------------
void() ad_trap_pendulum_disable =
{
	self.state = ad_STATE_OFF;
};

//----------------------------------------------------------------------
void() ad_trap_pendlong =
{
	// Short/long version of the model
	if (self.spawnflags & ad_PEND_SHORT) self.mdl = "progs/trap_pendshort.mdl";
	else self.mdl = "progs/trap_pendlong.mdl";
	precache_model (self.mdl);
	
	self.view_ofs = '0 0 -108';	// Offset bbox vectors (new model different location)
	self.oldorigin = '0 0 0';	// Entity is correct location

	self.noise1 = "traps/pend_swing.wav";
	self.noise2 = "traps/pend_hit.wav";
	precache_sound (self.noise1);
	precache_sound (self.noise2);

	self.ad_classtype = ad_CT_PENDULUM;
	if (self.dmg == 0) self.dmg = 5;	// Default touch damage
	if (self.dmg < 0) self.dmg = 0;		// Use -1 for no damage option
	if (self.wait <= 0) self.wait = 0;	// Default starting delay
	if (!self.waitmin) self.waitmin = 0.5;	// Damage throttle
	self.state = ad_STATE_OFF;

	// Error - Check for targetname for trigger event
	if (self.targetname == "") {
		dprint("\b[PENDULUM]\b missing targetname, cannot be triggered!\n");
	}
	
	// Rotate model and swing on X axis instead
	if (self.spawnflags & ad_PEND_XSWING) self.angles = '0 270 0';
	else self.angles = '0 0 0';

	// Start the opposite way around (frame 13 instead of 1)
	// This also affects one swing parameter
	if (self.spawnflags & ad_PEND_REVERSE) self.ad_frame_override = ad_PEND_MAXFRAME;
	else self.ad_frame_override = 0;
	self.frame = self.ad_frame_override;

	// Setup Entity State functionality
	if (self.targetname != "") self.use = ad_entity_state_use;
	self.ad_estate_on = ad_trap_pendulum_on;
	self.ad_estate_off = ad_trap_pendulum_off;
	self.ad_estate_use = ad_trap_pendulum_use;
	self.ad_estate_disable = ad_trap_pendulum_disable;
	self.touch = ad_trap_pendulum_touch;
	if (self.spawnflags & ad_ENT_STARTOFF) self.ad_estate_off();
	else self.ad_estate_on();
};

//----------------------------------------------------------------------
void() ad_trap_pendlongx =
{
	self.spawnflags = self.spawnflags | ad_PEND_XSWING;
	ad_trap_pendlong();
}

//----------------------------------------------------------------------
void() ad_trap_pendshort =
{
	self.spawnflags = self.spawnflags | ad_PEND_SHORT;
	ad_trap_pendlong();
}

//----------------------------------------------------------------------
void() ad_trap_pendshortx =
{
	self.spawnflags = self.spawnflags | ad_PEND_SHORT;
	self.spawnflags = self.spawnflags | ad_PEND_XSWING;
	ad_trap_pendlong();
}

