//============================================================================
// - Defender enforcer (ssg/gl attack)
//----------------------------------------------------------------------
void() ad_defender_ssg =
{
	if (VR_AimCone_Wait(ad_defender_ssg, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	if (!self.enemy) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "enforcer/def_ssg_fire.wav", 1, ad_ATTN_NORM);	
	
	// Choose between a projectile or hit-scan system
	if (ad_query_configflag(ad_SVR_SHOTGPROJ)) 
		ad_FireBullets (ad_QUANTITY_DEFENDER, ad_SPREAD_DEF);
	else {
		ad_Launch_Shells(ad_QUANTITY_DEFENDER, ad_SPREAD_DEF, ad_CT_PROJ_SG);
		ad_Launch_ShellCasing(2);
	}
};

