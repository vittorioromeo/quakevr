//----------------------------------------------------------------------
void() ad_enf_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "enforcer/death1.wav", 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_enf_die1 ();
		else ad_enf_fdie1 ();
	}
};

/*======================================================================
 QUAKED monster_enforcer (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_base_enforcer =
{
	self.mdl = "progs/mon_enforcer.mdl";
	self.ad_headmdl = "progs/h_enforcer.mdl";
	self.ad_gib1mdl = "progs/w_enforcergun.mdl";	// Unique weapon
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	precache_sound ("enforcer/death1.wav");
	self.ad_pain_sound = "enforcer/pain1.wav";
	self.ad_pain_sound2 = "enforcer/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	self.ad_gibhealth = -35;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 20;				// low pain threshold
	self.ad_pain_longanim = ad_TRUE;			// Long pain animation for axe
	self.ad_steptype = ad_FS_TYPEHEAVY;		// heavy player
	self.ad_attack_offset = '28 8.5 16';	// End of Gun
	if (self.ad_deathstring == "")
		self.ad_deathstring = " was blasted by an Enforcer\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	if (self.ad_classtype == ad_CT_MONELIMATOR) self.ad_resist_cells = 0.5;
	else if (self.ad_classtype == ad_CT_MONDEFENDER) self.ad_resist_rockets = 0.5;
	
	self.ad_th_stand = ad_enf_stand1;
	self.ad_th_walk = ad_enf_walk1;
	self.ad_th_run = ad_enf_run1;
	self.ad_th_pain = ad_enf_pain;
	self.ad_th_die = ad_enf_die;

	self.ad_classgroup = ad_CG_ENFORCER;
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();
};

//----------------------------------------------------------------------
void() ad_monster_enforcer =
{
	// Check for any random monster setups
	if (ad_monster_checkrandomizer() == ad_TRUE) return;
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.ad_classtype = ad_CT_MONENFORCER;
	precache_model (ad_MODEL_PROJ_LASER); // Originally - progs/laser.mdl
	
	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_LASERGRN);
	}
	
	if (self.health < 1) self.health = ad_HP_MONENFORCER;
	if (self.ammo_cells < 0) self.ammo_cells = 0;
	else if (self.ammo_cells == 0) self.ammo_cells = 3;
	self.ad_exactskin = rint((random()*3)-0.5);
	self.ad_gib1skin = 0;

	self.ad_idle_sound = "enforcer/idle1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_count = 4;
	self.ad_sight_sound = "enforcer/sight1.wav";
	self.ad_sight_sound2 = "enforcer/sight2.wav";
	self.ad_sight_sound3 = "enforcer/sight3.wav";
	self.ad_sight_sound4 = "enforcer/sight4.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound (self.ad_sight_sound2);
	precache_sound (self.ad_sight_sound3);
	precache_sound (self.ad_sight_sound4);

	// Projectile fire and impact (used in projectiles)
	precache_sound (ad_SOUND_LASER_FIRE);
	precache_sound (ad_SOUND_LASER_HIT);
	
	self.ad_th_missile = ad_enf_atk1;

	ad_monster_base_enforcer();
}
	
//----------------------------------------------------------------------
void() ad_monster_defender =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.ad_classtype = ad_CT_MONDEFENDER;
	precache_model (ad_MODEL_PROJ_GRENADE);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_GRENADEGRN);
	}
	
	if (self.health < 1) self.health = 100;
	if (self.ammo_shells < 0) self.ammo_shells = 0;
	else if (self.ammo_shells == 0) self.ammo_shells = 5;
	self.ad_exactskin = 3 + rint((random()*3)-0.5);
	self.ad_gib1skin = 1;

	self.ad_idle_sound = "enforcer/def_idle1.wav";
	self.ad_idle_sound2 = "enforcer/def_idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	self.ad_sight_sound = "enforcer/def_sight1.wav";
	precache_sound (self.ad_sight_sound);

	// Extra load/fire sounds (from Quoth MOD)
	precache_sound ("enforcer/def_ssg_load.wav");
	precache_sound ("enforcer/def_ssg_fire.wav");
	
	self.ad_th_missile = ad_def_atkgl1;
	self.ad_th_melee = ad_def_atkssg1;
	self.ad_th_checkattack = ad_DefenderCheckAttack;
	// Grenade bounce off body
	self.ad_bouncegrenade = ad_TRUE;
	self.ad_deathstring = " was destroyed by a Defender\n";

	ad_monster_base_enforcer();
};

//----------------------------------------------------------------------
void() ad_monster_eliminator =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.ad_classtype = ad_CT_MONELIMATOR;
	precache_model (ad_MODEL_PROJ_PLASMA);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_PLASMAGRN);
	}

	if (self.health < 1) self.health = 120;
	if (self.ammo_cells < 0) self.ammo_cells = 0;
	else if (self.ammo_cells == 0) self.ammo_cells = 5;
	self.ad_exactskin = 6 + rint((random()*3)-0.5);
	self.ad_gib1skin = 2;

	self.ad_idle_sound = "enforcer/elim_idle1.wav";
	self.ad_idle_sound2 = "enforcer/elim_idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	self.ad_sight_sound = "enforcer/elim_sight1.wav";
	precache_sound (self.ad_sight_sound);

	// Extra load/fire sounds (from Quoth MOD)
	precache_sound ("enforcer/elim_pg_load.wav");
	precache_sound (ad_SOUND_PLASMA_FIRE);
	precache_sound (ad_SOUND_PLASMA_HIT);
	
	self.ad_th_missile = ad_elim_atk1;
	self.ad_th_checkattack = ad_EliminatorCheckAttack;
	self.ad_deathstring = " was assasinated by a Eliminator\n";

	ad_monster_base_enforcer();
};