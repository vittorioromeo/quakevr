//============================================================================
// - Basic enforcer (laser attack)
//----------------------------------------------------------------------
void() ad_enforcer_fire =
{
	if (VR_AimCone_Wait(ad_enforcer_fire, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_org, ad_vec;

	if (!self.enemy) return;
	if (self.health < 1) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, ad_SOUND_LASER_FIRE, 1, ad_ATTN_NORM);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_vec = normalize(self.enemy.origin - self.origin);

	ad_launch_projectile(ad_org, ad_vec, ad_CT_PROJ_LASER, ad_SPEED_LASER);
};

