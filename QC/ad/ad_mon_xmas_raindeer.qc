void() ad_raind_idlefeet2 = [ $idlefeet2, ad_raind_idlefeet3 ] {ad_ai_stand();};
void() ad_raind_idlefeet3 = [ $idlefeet3, ad_raind_idlefeet4 ] {ad_monster_footstep(ad_FALSE);ad_ai_stand();};
void() ad_raind_idlefeet4 = [ $idlefeet4, ad_raind_idlefeet5 ] {ad_ai_stand();};
void() ad_raind_idlefeet5 = [ $idlefeet5, ad_raind_idlefeet6 ] {ad_ai_stand();};
void() ad_raind_idlefeet6 = [ $idlefeet6, ad_raind_idlefeet7 ] {ad_ai_stand();};
void() ad_raind_idlefeet7 = [ $idlefeet7, ad_raind_stand1 ] {ad_ai_stand();};

//----------------------------------------------------------------------
void() ad_raind_stand1 = [ $stand1, ad_raind_stand2 ] { ad_monster_idle_sound();ad_ai_stand();};
void() ad_raind_stand2 = [ $stand1, ad_raind_stand3 ] {ad_ai_stand();};
void() ad_raind_stand3 = [ $stand2, ad_raind_stand4 ] {ad_ai_stand();};
void() ad_raind_stand4 = [ $stand2, ad_raind_stand5 ] {ad_ai_stand();};
void() ad_raind_stand5 = [ $stand3, ad_raind_stand6 ] {ad_ai_stand();};
void() ad_raind_stand6 = [ $stand3, ad_raind_stand7 ] {ad_ai_stand();};
void() ad_raind_stand7 = [ $stand4, ad_raind_stand8 ] {ad_ai_stand();};
void() ad_raind_stand8 = [ $stand4, ad_raind_stand1 ] {
	self.ad_idlebusy = ad_FALSE; 
	if (random() < ad_MON_IDLE_ANIMATION) self.think = ad_raind_idlefeet1;
};

//======================================================================
void() ad_raind_walk1 = [ $run5, ad_raind_walk2 ] {ad_monster_idle_sound();ad_ai_walk(8);};
void() ad_raind_walk2 = [ $run6, ad_raind_walk3 ] {ad_ai_walk(5);};
void() ad_raind_walk3 = [ $run7, ad_raind_walk4 ] {ad_ai_walk(10);};
void() ad_raind_walk4 = [ $run8, ad_raind_walk5 ] {ad_monster_footstep(ad_FALSE);ad_ai_walk(5);};
void() ad_raind_walk5 = [ $run1, ad_raind_walk6 ] {ad_ai_walk(8);};
void() ad_raind_walk6 = [ $run2, ad_raind_walk7 ] {ad_ai_walk(13);};
void() ad_raind_walk7 = [ $run3, ad_raind_walk8 ] {ad_ai_walk(5);};
void() ad_raind_walk8 = [ $run4, ad_raind_walk1 ] {ad_monster_footstep(ad_FALSE);ad_ai_walk(8);};

