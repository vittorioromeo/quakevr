void() ad_raind_run1 = [ $run5, ad_raind_run2 ] {ad_monster_idle_sound();ad_ai_run(15);};
void() ad_raind_run2 = [ $run6, ad_raind_run3 ] {ad_ai_run(10);};
void() ad_raind_run3 = [ $run7, ad_raind_run4 ] {ad_ai_run(20);};
void() ad_raind_run4 = [ $run8, ad_raind_run5 ] {ad_monster_footstep(ad_FALSE);ad_ai_run(10);};
void() ad_raind_run5 = [ $run1, ad_raind_run6 ] {ad_ai_run(15);};
void() ad_raind_run6 = [ $run2, ad_raind_run7 ] {ad_ai_run(25);};
void() ad_raind_run7 = [ $run3, ad_raind_run8 ] {ad_ai_run(10);};
void() ad_raind_run8 = [ $run4, ad_raind_run1 ] {ad_monster_footstep(ad_FALSE);ad_ai_run(15);};

//======================================================================
// MELEE : Antler attack
//======================================================================
void() ad_raind_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);
	ad_ai_damagebreakable(20);
	if (!(ad_ai_checkmelee(ad_MONAI_MELEERAINDEER,ad_FALSE) && VR_MeleeArc_Hits(FALSE))) return; // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	sound(self, ad_CHAN_WEAPON, self.ad_pain_sound, ad_TRUE, ad_TRUE);

	// Antler attack is weak (1-9)
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Spawn blood at antlers
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

//----------------------------------------------------------------------
void() ad_raind_ram1 = [ $rattack1, ad_raind_ram2 ] {ad_ai_charge(10);};
void() ad_raind_ram2 = [ $rattack2, ad_raind_ram3 ] {ad_raind_melee();};
void() ad_raind_ram3 = [ $rattack3, ad_raind_ram4 ] {ad_ai_charge(5);};
void() ad_raind_ram4 = [ $rattack4, ad_raind_run1 ] {
	// Check if raindeer is within range to attack again
	if (ad_ai_checkmelee(ad_MONAI_MELEERAINDEER,ad_FALSE) && self.enemy.health > 0) {
		if (self.health > 0) self.think = ad_raind_ram1;
	}
};

//======================================================================
// RANGE : Rockets from backpack
//======================================================================
void(vector ad_sideofs) ad_raind_attack =
{
	local vector ad_org, ad_dir, ad_vec;
	
	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_RAINDROCK + (ad_skill * ad_SPEED_RAINDROCKSKILL);

	// Cycle between attack sounds
	if (self.lefty == 0) 
		sound (self, ad_CHAN_WEAPON, "xmas/raindeer/attack1.wav", 1, ad_ATTN_NORM);
	else
		sound (self, ad_CHAN_WEAPON, "xmas/raindeer/attack2.wav", 1, ad_ATTN_NORM);
	self.lefty = 1 - self.lefty;

	// turn and face your enemy!
	ad_ai_face();
	makevectors (self.angles);

	ad_org = self.origin + ad_attack_vector(ad_sideofs);
	// Fire rocket direction to match raindeer side
	ad_vec = v_right*(ad_sideofs_x+(random()*10));
	ad_dir = normalize((self.enemy.origin + ad_vec) - ad_org);
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_RAINDEER, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_raind_shoot1 = [ $rattack1, ad_raind_shoot2 ] {ad_ai_face();};
void() ad_raind_shoot2 = [ $rattack2, ad_raind_shoot3 ] {};
void() ad_raind_shoot3 = [ $rattack3, ad_raind_shoot4 ] {ad_ai_face();};
void() ad_raind_shoot4 = [ $rattack4, ad_raind_shoot5 ] {
	// Skills - EASY/NORMAL = 1 rocket, HARD/NM = 2 rockets
	if (ad_skill < ad_SKILL_HARD) {
		self.think = ad_raind_run1;
		// Randomize upper side (LEFT=-12 RIGHT=12)
		if (random() < 0.5) ad_raind_attack('-2 -12 12');
		else ad_raind_attack('-2 12 12');
	}
	else ad_raind_attack('-2 -12 12');
};
void() ad_raind_shoot5 = [ $rattack1, ad_raind_shoot6 ] {ad_ai_face();};
void() ad_raind_shoot6 = [ $rattack2, ad_raind_shoot7 ] {};
void() ad_raind_shoot7 = [ $rattack3, ad_raind_shoot8 ] {ad_ai_face();};
void() ad_raind_shoot8 = [ $rattack4, ad_raind_run1 ] {
	ad_raind_attack('-2 12 12');
};

//======================================================================
// PAIN : quick reflection
//======================================================================
void() ad_raind_pain1 = [ $rattack1, ad_raind_pain2 ] {};
void() ad_raind_pain2 = [ $rattack2, ad_raind_pain3 ] {ad_ai_pain(4);};
void() ad_raind_pain3 = [ $rattack3, ad_raind_pain4 ] {};
void() ad_raind_pain4 = [ $rattack4, ad_raind_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_raind_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) ad_raind_pain1 ();
		else if (self.ad_pain_check == 2) {
			// reset axe hit and setup short pain recovery
			self.ad_pain_finished = time + 0.6;
			self.ad_axhitme = 0;
			ad_raind_pain1 ();
		}
	}
};

//======================================================================
// DEATH : Its raining raindeer tonight!
//======================================================================
void() ad_raind_explode =
{
	// no more raindeer!
	ad_entity_hide (self);
	// Make sure gibs go flying up
	self.max_health = ad_MON_GIBFOUNTAIN;
	self.health = -100;

	// ID style explosion
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
	WriteCoord (ad_MSG_BROADCAST, self.origin_x);
	WriteCoord (ad_MSG_BROADCAST, self.origin_y);
	WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	if (self.ad_death_dmg > 0)
		ad_T_RadiusDamage (self, self, self.ad_death_dmg, world, ad_DAMAGEALL);
	
	// Sprite + Dust
	ad_SpawnExplosion(ad_EXPLODE_BIG, self.origin, self.ad_death_sound);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);
	ad_SpawnProjectileSmoke(self.origin, 200, 250, 100);

	// Regular blood like gibs
	ad_ThrowGib(4, 2 + rint(random()*4));
	ad_ThrowGib(5, 2 + rint(random()*4));
	ad_ThrowGib(25, 1);
	ad_ThrowGib(11, 2 + rint(random()*2));
	// Metal backpack
	self.ad_gibtype = ad_GIBTYPE_METAL;
	ad_ThrowGib(12, rint(random()*2));
};

//----------------------------------------------------------------------
void() ad_raind_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// There is no death animation
	sound (self, ad_CHAN_BODY, self.ad_death_sound, 1, ad_ATTN_NORM);
	ad_raind_explode();
};

//----------------------------------------------------------------------
void() ad_raind_deadbody =
{
	// Setup bounding box based on presets
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	ad_monster_bbox();

	// Sacrifice pose + skin
	self.frame = $altar1;
	self.ad_exactskin = self.skin = 1;
	self.ad_gib2mdl = self.ad_gib1mdl;
	if (random() < 0.5) self.ad_gib3mdl = self.ad_gib1mdl;
	if (random() < 0.5) self.ad_gib4mdl = self.ad_gib1mdl;
	ad_misc_deadbody_setup();
};

//=============================================================================
//QUAKED monster_xmas_raindeer (0.5 0.75 0) (-16 -16 -24) (16 16 40) Ambush
//=============================================================================
void() ad_monster_xmas_raindeer =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/xmas/mon_raindeer.mdl";		// Brown meat
	self.ad_headmdl = "progs/xmas/h_raindeer.mdl";		// Bloody meat
	self.ad_gib1mdl = "progs/xmas/gib_rdleg1.mdl";		// Bloody stump
	self.ad_gib2mdl = "progs/xmas/gib_rdrockpack.mdl";	// Rocket backpack

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_RAIND);	// Snowy Rockets
	precache_model (self.ad_gib1mdl);		// Legs
	precache_model (self.ad_gib2mdl);		// Rocket Packs

	self.ad_idle_sound = "xmas/raindeer/idle.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_sound = "xmas/raindeer/sight.wav";
	precache_sound (self.ad_sight_sound);

	// Alternating rocket firing sound
	precache_sound ("xmas/raindeer/attack1.wav");
	precache_sound ("xmas/raindeer/attack2.wav");
	
	self.ad_pain_sound = "xmas/raindeer/hit.wav";
	precache_sound (self.ad_pain_sound);
	self.ad_death_sound = "xmas/raindeer/death.wav";
	precache_sound (self.ad_death_sound);

	// Dead body version is setup different
	if (self.spawnflags & ad_MON_RAINDEER_DEAD) {
		ad_raind_deadbody(); return;
	}
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 200;
	if (self.ad_death_dmg < 1) self.ad_death_dmg = ad_DAMAGE_RAINDEER;
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_gibbed = ad_FALSE;				// Still in one piece
	self.ad_pain_flinch = 30;				// Light pain threshold
	self.ad_pain_longanim = ad_FALSE;			// No long pain animation
	self.ad_steptype = ad_FS_TYPESLOW;		// Small sounding feet
	self.ad_attack_explosive = ad_TRUE;		// Has explosive attack
	self.ad_poisonous = ad_FALSE;				// Not Supported
	self.ad_meleeoffset = '24 0 20';		// Antler attack offset
	self.lefty = 0;						// Cycle attack sounds
	self.ad_deathstring = " was trampled by a Raindeer\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_RaindeerCheckAttack;
	self.ad_th_stand = ad_raind_stand1;
	self.ad_th_walk = ad_raind_walk1;
	self.ad_th_run = ad_raind_run1;
	self.ad_th_melee = ad_raind_ram1;
	self.ad_th_missile = ad_raind_shoot1;
	self.ad_th_pain = ad_raind_pain;
	self.ad_th_die = ad_raind_die;
	
	self.ad_classtype = ad_CT_MONRAINDEER;
	self.ad_classgroup = ad_CG_XMAS;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};

