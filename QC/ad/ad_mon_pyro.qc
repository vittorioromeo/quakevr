//----------------------------------------------------------------------
void() ad_pyro_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	ad_pyro_soundreset();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "enforcer/death1.wav", 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_pyro_die1 ();
		else ad_pyro_fdie1 ();
	}
};

/*======================================================================
 QUAKED monster_pyro (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_pyro =
{
	if (deathmatch) { remove(self); return; }
	
	self.mdl = "progs/mon_pyro.mdl";
	self.ad_headmdl = "progs/h_pyro.mdl";
	self.ad_gib1mdl = "progs/w_enforcergun.mdl";	// Unique weapon
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	self.ad_gib1skin = 3;

	precache_sound ("enforcer/death1.wav");
	self.ad_pain_sound = "enforcer/pain1.wav";
	self.ad_pain_sound2 = "enforcer/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	self.ad_idle_sound = "enforcer/idle1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_sound = "enforcer/sight1.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound ("enforcer/sight2.wav");
	precache_sound ("enforcer/sight3.wav");
	precache_sound ("enforcer/sight4.wav");

	// Extra sound/sprite assets (from Rubicon2 MOD)
	self.noise3 = "enforcer/pyro_flameon.wav";
	self.noise4 = "enforcer/pyro_flameoff.wav";
	precache_sound (self.noise3);
	precache_sound (self.noise4);
	precache_model (ad_SBURST_FLAME);		// Flame on
	precache_model (ad_SBURST_SMOKE);		// Underwater
	precache_model (ad_SBURST_FLAMEDP);	// DP Collision
	
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 100;
	self.ad_gibhealth = -35;
	self.ad_gibbed = ad_FALSE;
	self.yaw_speed = 35;				// Can turn really fast
	self.ad_pain_flinch = 100;				// extremely high pain tolerance
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPEHEAVY;		// heavy feet
	self.ad_attack_offset = '24 8.5 16';	// End of Gun
	if (self.ammo_nails < 0) self.ammo_nails = 0;
	else if (self.ammo_nails == 0) self.ammo_nails = 5;
	if (!self.ad_exactskin) self.ad_randomskin = 4;
	self.ad_poisonous = ad_FALSE;				// Use Fumigator instead
	self.ad_deathstring = " was toasted by a Pyro\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = 0; self.ad_resist_nails = 0.5;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_PyroCheckAttack;
	self.ad_th_stand = ad_pyro_stand1;
	self.ad_th_walk = ad_pyro_walk1;
	self.ad_th_run = ad_pyro_run1;
	self.ad_th_pain = ad_pyro_pain;
	self.ad_th_die = ad_pyro_die;
	self.ad_th_melee = ad_pyro_atk1;
	self.ad_th_missile = ad_pyro_atk1;		// For monster_turret function

	self.ad_classtype = ad_CT_MONPYRO;
	self.ad_classgroup = ad_CG_ENFORCER;
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();
};

/*======================================================================
 QUAKED monster_fumigator (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_fumigator =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;
	
	self.mdl = "progs/mon_fumigator.mdl";
	self.ad_headmdl = "progs/h_pyro.mdl";
	self.ad_gib1mdl = "progs/w_enforcergun.mdl";	// Unique weapon
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (self.ad_gib1mdl);
	self.ad_gib1sound = ad_GIB_IMPACT_WOOD;
	self.ad_gib1skin = 4;

	precache_sound ("enforcer/death1.wav");
	self.ad_pain_sound = "enforcer/pain1.wav";
	self.ad_pain_sound2 = "enforcer/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	self.ad_idle_sound = "enforcer/idle1.wav";
	precache_sound (self.ad_idle_sound);
	self.ad_sight_sound = "enforcer/sight1.wav";
	precache_sound (self.ad_sight_sound);
	precache_sound ("enforcer/sight2.wav");
	precache_sound ("enforcer/sight3.wav");
	precache_sound ("enforcer/sight4.wav");

	// Extra sound/sprite assets (from Rubicon2 MOD)
	self.noise3 = "enforcer/fum_poisonon.wav";
	self.noise4 = "enforcer/fum_poisonoff.wav";
	precache_sound (self.noise3);
	precache_sound (self.noise4);
	precache_model (ad_SBURST_POISON);		// Poison on
	precache_model (ad_SBURST_POISONDP);	// DP Collision

	ad_precache_poisongibs();				// precache gibs
	self.ad_gibtype = ad_GIBTYPE_POISON;		// Poison gibs!
	self.ad_poisonous = ad_TRUE;				// Oh yeah! Always!
	
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 100;
	self.ad_gibhealth = -35;
	self.ad_gibbed = ad_FALSE;
	self.yaw_speed = 35;				// Can turn really fast
	self.ad_pain_flinch = 100;				// extremely high pain tolerance
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_steptype = ad_FS_TYPEHEAVY;		// heavy feet
	self.ad_attack_offset = '24 8.5 16';	// End of Gun
	self.ammo_shells = 4;				// drops armor shards instead
	self.ad_no_liquiddmg = ad_TRUE;			// Immune to slime/lava
	if (!self.ad_exactskin) self.ad_randomskin = 4;
	self.ad_deathstring = " was choked by a Fumigator\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = 0; self.ad_resist_nails = 0.5;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles

	self.ad_th_checkattack = ad_PyroCheckAttack;
	self.ad_th_stand = ad_pyro_stand1;
	self.ad_th_walk = ad_pyro_walk1;
	self.ad_th_run = ad_pyro_run1;
	self.ad_th_pain = ad_pyro_pain;
	self.ad_th_die = ad_pyro_die;
	self.ad_th_melee = ad_pyro_atk1;
	self.ad_th_missile = ad_pyro_atk1;		// For monster_turret function

	self.ad_classtype = ad_CT_MONFUMIGATOR;
	self.ad_classgroup = ad_CG_ENFORCER;
	self.ad_classmove = ad_MON_MOVEWALK;
	ad_monster_start();
};
