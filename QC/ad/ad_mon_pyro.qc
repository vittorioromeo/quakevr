//============================================================================
// - Pyro enforcer (FIRE FIRE FIRE!)
//----------------------------------------------------------------------
void() ad_pyroflame_touch =
{
	if (other == self.owner) return;
	if (other.solid == ad_SOLID_TRIGGER) return;
	if (other.health < 1) return;
	if (other.takedamage == ad_DAMAGE_NO) return;
	if (self.ad_attack_finished > time) return;
	if (other.ad_classtype == self.owner.ad_classtype) return; // Pyro proof!

	// Stop still if hit world, carry on if burning something
	if (other != world) self.velocity = self.movedir;
	else self.velocity = '0 0 0';
	
	// Block sprite burst from damage again
	self.ad_attack_finished = time + 1;
	
	// Check owner is a Pyro?
	if (self.owner.ad_classtype == ad_CT_MONPYRO) {
		// damage and debuff are same function
		ad_ApplyFireDmg(other, ad_DAMAGE_PYROFLAME, ad_DAMAGE_MONFLAME);
	}
	else {
		// Can only poison the player
		if (other.flags & ad_FL_CLIENT) {
			// Check if player is posioned already?
			if (other.ad_poisoned) ad_T_Damage (other, self, self, ad_DAMAGE_FUMPOISON, ad_DAMARMOR);
			// Make sure player is posioned
			else ad_PoisonDeBuff(other);
		}
		// Poison anything else (very quick death, high damage)
		else {
			ad_T_Damage (other, self, self, ad_DAMAGE_MONFLAME, ad_DAMARMOR);
			// Quake VR: poisoned for a while too, its green puffs (vr_ad_enemyguns.qc: the poison sprayer's, as the player's)
			if (other.flags & ad_FL_MONSTER) VR_ADGun_Poison(other, self, self.owner, cvar("vr_adgun_fumigator_poison"), cvar("vr_adgun_fumigator_poisontime"));
		}
	}
};

//----------------------------------------------------------------------
void() ad_pyroflame_think =
{
	self.cnt = self.cnt + 1;
	if (self.cnt > 6) remove(self);
	else {
		self.frame = self.cnt;
		// Randomly drift upwards and slow down forward movement
		self.velocity_z = self.velocity_z + 10 + (random() * 20);
		self.velocity = self.velocity - (self.movedir * 0.125);
		self.nextthink = time + 0.1;
		VR_ADGun_StreamFx(self, self.owner.ad_classtype != ad_CT_MONPYRO); // Quake VR: our fire with it (vr_ad_enemyguns.qc)
	}
}

//----------------------------------------------------------------------
void(vector ad_org, vector ad_dir) ad_pyroflame_spawn =
{
	local vector ad_variance;
	local float ad_roll, ad_pointc;
	
	ad_newmis = spawn();
	ad_newmis.ad_classtype = ad_CT_TEMPSTREAM;
	ad_newmis.classname = "PBurst";
	ad_newmis.owner = self;
	ad_newmis.frame = ad_newmis.cnt = 0;

	// Extra wide flame contact if fighting a monster
	if (self.enemy.flags & ad_FL_MONSTER) ad_newmis.movetype = ad_MOVETYPE_FLYMISSILE;
	else ad_newmis.movetype = ad_MOVETYPE_FLY;	// Standard flame size
	ad_newmis.solid = ad_SOLID_TRIGGER;			// collision, touch required

	// The Pyro and Fumigator have different flame types
	// Pyro = fire, Fum = Poison
	//-----------------------------------------------
	if (self.ad_classtype == ad_CT_MONPYRO) {
		// Switch particles between fire and smoke based on contents
		ad_pointc = pointcontents(self.origin);
		if (ad_pointc <= ad_CONTENT_WATER) {
			if (ad_ext_dppart) {
				// Use special DP smoke and empty sprite for collision
				pointparticles(particleeffectnum(ad_DPP_PYROFLAME2), ad_org, ad_dir, 1);
				setmodel (ad_newmis, ad_SBURST_FLAMEDP);
			}
			else setmodel (ad_newmis, ad_SBURST_SMOKE);
		}
		else {
			if (ad_ext_dppart) {
				// Use special DP flames and empty sprite for collision
				pointparticles(particleeffectnum(ad_DPP_PYROFLAME1), ad_org, ad_dir, 1);
				setmodel (ad_newmis, ad_SBURST_FLAMEDP);
			}
			else setmodel (ad_newmis, ad_SBURST_FLAME);
		}
	}
	else {
		if (ad_ext_dppart) {
			// Use special DP flames and empty sprite for collision
			pointparticles(particleeffectnum(ad_DPP_PYROFLAME3), ad_org, ad_dir, 1);
			setmodel (ad_newmis, ad_SBURST_POISONDP);
		}
		else setmodel (ad_newmis, ad_SBURST_POISON);
	}
	
	setorigin (ad_newmis, ad_org);
	setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

	// Work out forward speed (tweak based on skill level)
	ad_variance = ad_vecrand(0,10,ad_TRUE);	// +/- 10 on all axis
	ad_newmis.ad_attack_speed = ad_SPEED_PYROFLAME + ad_skill * ad_SPEED_PYROSKILL;
	ad_newmis.movedir = (ad_dir * ad_newmis.ad_attack_speed) + '0 0 -50' + ad_variance;
	ad_newmis.velocity = ad_newmis.movedir;
	
	// Roll the flames from side to side towards the target
	ad_roll = 350 + random() * 20;
	ad_newmis.angles_z = ad_anglemod(ad_roll);

	// If DP engine active remove particle shadow
	if (ad_engine == ad_ENG_DPEXT) ad_newmis.effects = ad_newmis.effects + ad_EF_NOSHADOW;

	ad_newmis.nextthink = time + 0.1;
	ad_newmis.think = ad_pyroflame_think;
	ad_newmis.touch = ad_pyroflame_touch;
	// Quake VR: see-through, our fire with it, its muzzle's fire and smoke (vr_ad_enemyguns.qc: as the player's)
	VR_ADGun_StreamFx(ad_newmis, self.ad_classtype != ad_CT_MONPYRO);
	VR_ADGun_StreamMuzzle(ad_org, ad_dir, self.ad_classtype != ad_CT_MONPYRO, pointcontents(ad_org) <= ad_CONTENT_WATER);
};

//----------------------------------------------------------------------
void() ad_pyro_fire =
{
	local vector ad_org, ad_dir, ad_targ_org;

	if (self.health < 1) return;
	
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	// point the flames at the feet of the player
	if (self.enemy.flags & ad_FL_CLIENT) ad_targ_org = self.enemy.origin - '0 0 20';
	else ad_targ_org = self.enemy.origin - self.enemy.view_ofs;
	ad_dir = normalize(ad_targ_org - self.origin);
	ad_pyroflame_spawn(ad_org, ad_dir);
};

//----------------------------------------------------------------------
void()	ad_pyro_atk1	=[	$attack1,	ad_pyro_atk2	] {ad_ai_face();};
void()	ad_pyro_atk2	=[	$attack3,	ad_pyro_atk3	] {ad_ai_face();};
void()	ad_pyro_atk3	=[	$attack5,	ad_pyro_atk4	] {ad_ai_face();
	sound (self, ad_CHAN_WEAPON, self.noise3, 1, ad_ATTN_NORM);	// ON
	ad_pyro_fire(); 
	self.ad_attack_finished = time + 0.3;
};
void()	ad_pyro_atk4	=[	$attack5,	ad_pyro_atk5	] {ad_ai_face();
	ad_pyro_fire();
	if (self.ad_attack_finished > time || 
		(ad_range(self.enemy) == ad_RANGE_MELEE && self.enemy.health > 0) )
		self.think = ad_pyro_atk4;
};
void()	ad_pyro_atk5	=[	$attack10,	ad_pyro_run1	] {ad_ai_face();
	sound (self, ad_CHAN_WEAPON, self.noise4, 1, ad_ATTN_NORM);	// OFF
	ad_SUB_CheckRefire (ad_pyro_atk1);
};

