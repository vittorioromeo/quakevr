// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 MONSTER AMMO RESISTANCE SYSTEM

======================================================================*/

float(entity ad_targ, float ad_resist_type, float ad_damage) ad_Resist_Damage =
{
	if (!VR_AD_FeatureScope(cvar("vr_ad_resistance"))) return ad_damage;
	local float ad_ret_damage;
	
	if (ad_resist_type == ad_IT_SHELLS) ad_ret_damage = ad_damage * (1 - ad_targ.ad_resist_shells);
	else if (ad_resist_type == ad_IT_NAILS) ad_ret_damage = ad_damage * (1 - ad_targ.ad_resist_nails);
	else if (ad_resist_type == ad_IT_ROCKETS) ad_ret_damage = ad_damage * (1 - ad_targ.ad_resist_rockets);
	else if (ad_resist_type == ad_IT_CELLS) ad_ret_damage = ad_damage * (1 - ad_targ.ad_resist_cells);

	return ad_ret_damage;
};

//----------------------------------------------------------------------
// Double check that all ammo resistance are within range
//----------------------------------------------------------------------
void(entity ad_targ) ad_Resist_CheckRange = 
{
	// Check Ammo resistance is within range
	if (ad_targ.ad_resist_shells < -1) ad_targ.ad_resist_shells = -1;
	else if (ad_targ.ad_resist_shells > 1) ad_targ.ad_resist_shells = 1;
	if (ad_targ.ad_resist_nails < -1) ad_targ.ad_resist_nails = -1;
	else if (ad_targ.ad_resist_nails > 1) ad_targ.ad_resist_nails = 1;
	if (ad_targ.ad_resist_rockets < -1) ad_targ.ad_resist_rockets = -1;
	else if (ad_targ.ad_resist_rockets > 1) ad_targ.ad_resist_rockets = 1;
	if (ad_targ.ad_resist_cells < -1) ad_targ.ad_resist_cells = -1;
	else if (ad_targ.ad_resist_cells > 1) ad_targ.ad_resist_cells = 1;
};

//----------------------------------------------------------------------
// Save current ammo resistance to ammo variables
// ** Ammo variables are used for backpack, use with caution
//----------------------------------------------------------------------
void(entity ad_targ) ad_Resist_Save =
{
	// Store the ammo resistance for switching later
	ad_targ.ammo_shells = ad_targ.ad_resist_shells;
	ad_targ.ammo_nails = ad_targ.ad_resist_nails;
	ad_targ.ammo_rockets = ad_targ.ad_resist_rockets;
	ad_targ.ammo_cells = ad_targ.ad_resist_cells;
};

//----------------------------------------------------------------------
// Switch resistance from FULL to monster default
// This works with Resist_Save system, use with caution
// Designed for bosses which don't drop things on death
//----------------------------------------------------------------------
void(entity ad_targ, float ad_artype) ad_Resist_ChangeType =
{
	if (ad_artype == ad_TRUE) {
		// Complete resistance to everything
		ad_targ.ad_resist_shells = ad_targ.ad_resist_nails = 1;
		ad_targ.ad_resist_rockets = ad_targ.ad_resist_cells = 1;
		ad_targ.ad_pain_finished = ad_LARGE_TIMER;
	}
	else {
		// Default ammo resist, rocket/cell immunnity
		ad_targ.ad_resist_shells = ad_targ.ammo_shells;
		ad_targ.ad_resist_nails = ad_targ.ammo_nails;
		ad_targ.ad_resist_rockets = ad_targ.ammo_rockets;
		ad_targ.ad_resist_cells = ad_targ.ammo_cells;
		ad_targ.ad_pain_finished = time + 1;
	}
	dprint("\b[AMMO RESIST]\b");
	dprint(" S="); dprint(ftos(ad_targ.ad_resist_shells));
	dprint(" N="); dprint(ftos(ad_targ.ad_resist_nails));
	dprint(" R="); dprint(ftos(ad_targ.ad_resist_rockets));
	dprint(" C="); dprint(ftos(ad_targ.ad_resist_cells));
	dprint("\n");
};

//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org) ad_Resist_Axe =
{
	// Default impact sound - stone
	sound (ad_targ, ad_CHAN_WEAPON, ad_SOUND_AXE_STONE, 1, ad_ATTN_NORM);
	// Particle impact
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	if (random() < 0.5) WriteByte (ad_MSG_BROADCAST, ad_TE_SPIKE);
	else WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
	WriteCoord (ad_MSG_BROADCAST, ad_org_x);
	WriteCoord (ad_MSG_BROADCAST, ad_org_y);
	WriteCoord (ad_MSG_BROADCAST, ad_org_z);
	// Random chance of smoke/dust projectile
	if (random() < 0.5) ad_SpawnProjectileSmoke(ad_org, 200, 50, 150);
};

//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org, vector ad_vel, float ad_damage) ad_Resist_Shells =
{
	if (ad_targ.health > 0 && ad_targ.ad_pain_finished < time) {
		ad_targ.ad_pain_finished = time + 0.3 + random();
		// All monsters should have a pain sound define, hence no check
		sound (ad_targ, ad_CHAN_VOICE, ad_targ.ad_pain_sound, 1, ad_ATTN_NORM);
	}
	
	// Drastically reduce blood particles
	if (ad_targ.ad_resist_shells < 1) {
		ad_SpawnBlood (ad_targ, ad_org, ad_vel*0.2, rint(ad_DAMAGE_SHELL*ad_targ.ad_resist_shells));
	}
	if (random() < 0.3) {
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		if (random() < 0.5) WriteByte (ad_MSG_BROADCAST, ad_TE_SPIKE);
		else WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
		WriteCoord (ad_MSG_BROADCAST, ad_org_x);
		WriteCoord (ad_MSG_BROADCAST, ad_org_y);
		WriteCoord (ad_MSG_BROADCAST, ad_org_z);
		if (random() < 0.5) ad_SpawnProjectileSmoke(ad_org, 200, 50, 150);
	}
};

//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org) ad_Resist_Nails =
{
	if (ad_targ.health > 0 && ad_targ.ad_pain_finished < time && ad_targ.ad_resist_nails < 1) {
		ad_targ.ad_pain_finished = time + 0.3 + random();
		// All monsters should have a pain sound define, hence no check
		sound (ad_targ, ad_CHAN_VOICE, ad_targ.ad_pain_sound, 1, ad_ATTN_NORM);
	}	
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	if (random() < 0.5) WriteByte (ad_MSG_BROADCAST, ad_TE_SPIKE);
	else WriteByte (ad_MSG_BROADCAST, ad_TE_GUNSHOT);
	WriteCoord (ad_MSG_BROADCAST, ad_org_x);
	WriteCoord (ad_MSG_BROADCAST, ad_org_y);
	WriteCoord (ad_MSG_BROADCAST, ad_org_z);
	if (random() < 0.5) ad_SpawnProjectileSmoke(ad_org, 200, 50, 150);
};

//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org) ad_Resist_Rockets =
{
	if (ad_targ.health > 0 && ad_targ.ad_pain_finished < time && ad_targ.ad_resist_rockets < 1) {
		ad_targ.ad_pain_finished = time + 0.3 + random();
		// All monsters should have a pain sound define, hence no check
		sound (ad_targ, ad_CHAN_VOICE, ad_targ.ad_pain_sound, 1, ad_ATTN_NORM);
	}
	ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE,ad_org,ad_SOUND_RESIST_ROCKET);
	ad_SpawnProjectileSmoke(ad_org, 200, 50, 150);
	ad_SpawnProjectileSmoke(ad_org, 200, 50, 250);
	ad_SpawnProjectileSmoke(ad_org, 300, 50, 150);
	// Can the target bleed?
	if (ad_targ.ad_resist_rockets < 1) {
		ad_SpawnProjectileMeat(ad_targ, ad_org, 200, 50, 150);
		ad_SpawnProjectileMeat(ad_targ, ad_org, 300, 50, 150);
	}
};

//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org) ad_Resist_Lightning =
{
	if (ad_targ.health > 0 && ad_targ.ad_pain_finished < time && ad_targ.ad_resist_cells < 1) {
		ad_targ.ad_pain_finished = time + 0.3 + random();
		// All monsters should have a pain sound define, hence no check
		sound (ad_targ, ad_CHAN_VOICE, ad_targ.ad_pain_sound, 1, ad_ATTN_NORM);
	}	
	// Don't spawn smoke constantly (let the sprite finish)
	if (self.ad_lightning_timer < time) {
		self.ad_lightning_timer = time + 0.3;
		ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, ad_org, "");
	}
	// Spawn a random smoke particle and chance of blood
	ad_SpawnProjectileSmoke(ad_org, 200, 50, 150);
	if (ad_targ.ad_resist_cells < 1 && random() < 0.4) 
		ad_SpawnProjectileMeat(ad_targ, ad_org, 200, 50, 150);
};

//----------------------------------------------------------------------
void(entity ad_targ, vector ad_org) ad_Resist_Plasma =
{
	if (ad_targ.health > 0 && ad_targ.ad_pain_finished < time && ad_targ.ad_resist_cells < 1) {
		ad_targ.ad_pain_finished = time + 0.3 + random();
		// All monsters should have a pain sound define, hence no check
		sound (ad_targ, ad_CHAN_VOICE, ad_targ.ad_pain_sound, 1, ad_ATTN_NORM);
	}	
	ad_SpawnExplosion(ad_EXPLODE_BURST_SMOKE, ad_org, ad_SOUND_PLASMA_HIT);
	ad_SpawnProjectileSmoke(ad_org, 200, 50, 150);
	ad_SpawnProjectileSmoke(ad_org, 200, 50, 250);
	ad_SpawnProjectileSmoke(ad_org, 300, 50, 150);
	// Can the target bleed?
	if (ad_targ.ad_resist_cells < 1 && random() < 0.3) 
		ad_SpawnProjectileMeat(ad_targ,ad_org, 200, 50, 150);
};
