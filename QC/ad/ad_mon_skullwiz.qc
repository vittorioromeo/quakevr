//============================================================================
// MELEE - Teleportation
//============================================================================
void() ad_skullw_tfin1 =[ $tele9, ad_skullw_tfin2 ] {
	self.velocity = '0 0 0';
	// Always phase in facing the enemy
	self.ideal_yaw = vectoyaw(self.enemy.origin - self.origin);
	self.angles_y = self.ideal_yaw;
	sound (self, ad_CHAN_AUTO, "skullwiz/blinkin.wav", 1, ad_ATTN_NORM);
};
void() ad_skullw_tfin2 =[ $tele7, ad_skullw_tfin3 ] {ad_ai_face();};
void() ad_skullw_tfin3 =[ $tele5, ad_skullw_tfin4 ] {ad_ai_face();};
void() ad_skullw_tfin4 =[ $tele3, ad_skullw_tfin5 ] {ad_ai_face();};
void() ad_skullw_tfin5 =[ $tele1, ad_skullw_run1 ] {ad_ai_face();
	self.ad_bodyphased = ad_MONAI_SKULLWSOLID;
	self.takedamage = ad_DAMAGE_AIM;
};

//----------------------------------------------------------------------
// Find new teleport location
//----------------------------------------------------------------------
void() ad_skullw_blink = {
	local float ad_dist, ad_edist, ad_blinkfinished, ad_blinkcount;
	local vector ad_org, ad_org_ofs, ad_angle_vec;

	ad_blinkfinished = ad_TRUE; ad_blinkcount = 0;
	ad_org = ad_angle_vec = ad_org_ofs = '0 0 0'; 
	ad_org_ofs_z = self.height;
	self.oldorigin = self.origin;
	
	// Trace upwards to find ceiling or maximum teleport height
	traceline(self.origin, self.origin+ad_org_ofs, ad_TRUE, self);
	ad_org_ofs = trace_endpos;
	
	// Loop around for possible locations
	while(ad_blinkfinished) {
		ad_blinkcount = ad_blinkcount + 1;		// next loop
		ad_angle_vec_y = random() * 360;		// Random direction
		makevectors(ad_angle_vec);				// make vector
		
		// Generate random angle and trace teleport direction
		ad_dist = self.ad_distmin + (random() * self.ad_distmax);
		ad_org = ad_org_ofs + (v_forward * ad_dist);
		traceline(ad_org_ofs, ad_org, ad_TRUE, self);
		
		// Check distance is far enough away from enemy
		// Move away from any walls (traceline is surface contact)
		ad_dist = vlen(trace_endpos - ad_org_ofs) - 32;
		ad_org = ad_org_ofs + (v_forward * ad_dist);
		ad_edist = vlen(self.enemy.origin - ad_org);

		// Is the enemy far enough away?
		if (ad_edist > ad_MONAI_MELEESKULLW) {
			// Trace down to floor below new point
			traceline(ad_org, ad_org - '0 0 512', ad_TRUE, self);
			ad_org = trace_endpos + self.view_ofs;
			
			// The teleport fuction is working with a radius command
			// and this will ignore walls and just find any position
			// in all directions. This can lead to the skull wizard
			// teleporting behind walls or other parts of the map!
			// This can be prevent in two ways:
			// 1) linesight between skull wizard and player
			// - can leads to less interesting locations (always insight)
			// 2) linesight between new location and old
			// - This allows skull wizard to teleport around corner
			//   and still be within the same area!
			//
			// Trace through monsters and check trace fraction
			traceline(ad_org, self.origin, ad_TRUE, self);
			if (trace_fraction == 1) ad_blinkfinished = ad_FALSE;
		}

		// Been looping too long, back to original location
		if (ad_blinkcount > 10) {
			ad_blinkfinished = ad_FALSE;
			ad_org = self.origin;
		}
	}
	
	// Move to new location
	self.solid = ad_SOLID_SLIDEBOX;				// Standard monster movement
	setmodel(self, self.mdl);					// Setup model
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	setorigin(self, ad_org);						// move to new location
	
	// Test if new location is solid?
	if (!ad_walkmove (0, 0)) {
		self.solid = ad_SOLID_NOT;					// No world interaction yet
		setmodel(self,"");						// Turn off model
		setorigin(self, self.oldorigin);		// restore original location
		self.nextthink = time + 1;				// Keep checking
		self.think = ad_skullw_blink;
	}
	else ad_skullw_tfin1();
};

//----------------------------------------------------------------------
// Cycle around teleport chain lists instead
//----------------------------------------------------------------------
void() ad_skullw_waitforlink =
{
	self.nextthink = time + 0.5 + random();
	self.think = ad_skullw_waitforlink;
	setorigin(self, self.ad_movelast.origin);	// move to new location
	self.ad_enemydist = ad_range_distance(self.enemy, ad_FALSE);

	// Is the enemy too close or dead?
	if (self.ad_enemydist > self.ad_movelast.distance || self.enemy.health < 1) {
		// Move to new location
		self.solid = ad_SOLID_SLIDEBOX;				// Standard monster movement
		setmodel(self, self.mdl);					// Setup model
		setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size
	
		// Test if new location is solid?
		if (!ad_walkmove (0, 0)) {
			self.solid = ad_SOLID_NOT;					// No world interaction yet
			setmodel(self,"");						// Turn off model
		}
		else ad_skullw_tfin1();
	}
};

//----------------------------------------------------------------------
void() ad_skullw_checkblinklist = {
		// Does the blink list exist already?
	if (self.ad_movelast.ad_classtype != ad_CT_SKULLTELEPORT) {
		self.ad_movelast = find(world,targetname,self.ad_target2);
		// Does the entity chain exist?
		if (self.ad_movelast.ad_classtype == ad_CT_SKULLTELEPORT)
			ad_skullw_waitforlink();
		else {
			// target2 is not valid, do regular teleport
			self.ad_target2 = "";
			ad_skullw_blink();
		}
	}
	else {
		// Move forward in chain and try next spawn location
		self.ad_movelast = self.ad_movelast.enemy;
		ad_skullw_waitforlink();
	}
};

//----------------------------------------------------------------------
// touch book and phase out
//----------------------------------------------------------------------
void() ad_skullw_tele1	=[ $spellB3,	ad_skullw_tele2    ] {
	self.ad_pain_finished = time + 1;				// no pain during teleportation
	if (random() < 0.5) sound (self, ad_CHAN_VOICE, "skullwiz/blinkspk1.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_VOICE, "skullwiz/blinkspk2.wav", 1, ad_ATTN_NORM);
};
void() ad_skullw_tele2	=[ $spellB5,	ad_skullw_tele3 ] {};
void() ad_skullw_tele3	=[ $spellB7,	ad_skullw_tele4 ] {};
void() ad_skullw_tele4	=[ $spellB9,	ad_skullw_tele6 ] {};
void() ad_skullw_tele6	=[ $spellB13,	ad_skullw_tele8 ] {};
void() ad_skullw_tele8	=[ $tele1,		ad_skullw_tele9 ] {
	self.takedamage = ad_DAMAGE_NO;	// No damage or impact, phasing out
	self.solid = ad_SOLID_NOT;
	self.ad_bodyphased = ad_MONAI_SKULLWINVIS;
	ad_particle_explode(self.origin, 100, 1, self.ad_part_style, ad_PARTICLE_BURST_SKULLUP);
	sound (self, ad_CHAN_VOICE, "skullwiz/blinkout.wav", 1, ad_ATTN_NORM);
};
void() ad_skullw_tele9	=[ $tele3,	ad_skullw_tele10 ] {};
void() ad_skullw_tele10=[ $tele5,	ad_skullw_tele11 ] {};
void() ad_skullw_tele11=[ $tele7,	ad_skullw_tele12 ] {};
void() ad_skullw_tele12=[ $tele9,	ad_skullw_tele13 ] {};
void() ad_skullw_tele13 = {
	setmodel(self,"");
	// Check if a chain list has been defined
	if (self.ad_target2 != "") ad_skullw_checkblinklist();
	else ad_skullw_blink();
};

//============================================================================
// Rocket Skull Attack (Regular)
//============================================================================
void(vector ad_orgofs) ad_skullw_fire =
{
	local vector ad_org, ad_dir;

	if (!self.enemy) return;
	if (self.health < 1) return;
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	if (random() < 0.5) sound (self, ad_CHAN_WEAPON, "skullwiz/skull1.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "skullwiz/skull2.wav", 1, ad_ATTN_NORM);

	ad_ai_face();
	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	ad_dir = normalize(self.enemy.origin - ad_org);

	self.ad_attack_speed = ad_SPEED_SWIZMISSILE + (ad_skill * ad_SPEED_SWIZSKILL);
	ad_Launch_Missile (ad_org, ad_dir, '0 0 0', ad_CT_PROJ_SKULLW, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_skullw_attack1	=[	$spellA3,	ad_skullw_attack2    ] {
sound (self, ad_CHAN_VOICE, "skullwiz/attack.wav", 1, ad_ATTN_NORM);};
void() ad_skullw_attack2	=[	$spellA5,	ad_skullw_attack3	] {ad_ai_face();};
void() ad_skullw_attack3	=[	$spellA7,	ad_skullw_attack4	] {ad_ai_face();};
void() ad_skullw_attack4	=[	$spellA10,	ad_skullw_attack5	] {ad_ai_face();};
void() ad_skullw_attack5	=[	$spellA11,	ad_skullw_attack6	] {ad_ai_face();};
void() ad_skullw_attack6	=[	$spellA12,	ad_skullw_attack7	] {
	if (VR_AimCone_Wait(ad_skullw_attack6, VR_AIM_WIDE)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)
ad_skullw_fire('30 0 16');};
void() ad_skullw_attack7	=[	$spellA13,	ad_skullw_attack8	] {};
void() ad_skullw_attack8	=[	$spellA15,	ad_skullw_run1		] {};

//============================================================================
// Poison Skull Attack (Guardians)
//============================================================================
void() ad_skullw_poison_touch =
{
	if (other.solid == ad_SOLID_TRIGGER) return;
	if (other.ad_classtype == ad_CT_TEMPSTREAM) return;
	if (other.health > 0) return;
	if (self.ad_attack_finished > time) return;

	self.ad_attack_finished = time + 1;
	self.modelindex = 0;			// Make sure no model
	self.model = "";
	self.think = ad_SUB_Remove;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_skullw_poison_think =
{
	// Randomly drift upwards and slow down forward movement
	self.velocity_z = self.velocity_z + 10 + (random() * 20);
	self.velocity = self.velocity - (self.velocity * 0.125);
	
	self.frame = self.frame + 1;
	if (self.frame > self.count) ad_SUB_Remove();
	else self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_skullw_guardian =
{
	local float ad_poison_loop;
	local vector ad_poison_angles, ad_org, ad_dir;
	
	// Double check the skull wizard has poisonous flag set
	if (!self.ad_poisonous) return;
	
	// Remove projectile
	ad_entity_remove(self, 1);
	// Play explosion sound
	sound (self, ad_CHAN_WEAPON, "skullwiz/poison_hit.wav", 1, ad_ATTN_NORM);
	
	// Apply any direct damage and poison effect
	if (other.takedamage) {
		ad_T_Damage (other, self, self.owner, ad_DAMAGE_SWIZPOISON, ad_DAMARMOR);
		if (other.flags & ad_FL_CLIENT) ad_PoisonDeBuff(other);
	}
	
	ad_poison_loop = 0;
	ad_poison_angles = '0 0 0';
	
	while (ad_poison_loop < 360) {
		ad_newmis = spawn();
		ad_newmis.ad_classtype = ad_CT_TEMPSTREAM;
		ad_newmis.movetype = ad_MOVETYPE_FLY;		// Fly, no gravity
		ad_newmis.solid = ad_SOLID_TRIGGER;
		setmodel(ad_newmis, ad_SBURST_POISON);

		ad_org = self.origin;
		ad_org_z = ad_org_z + (ad_crandom() * 24);
		setorigin(ad_newmis, ad_org);
		setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

		ad_poison_angles_y = ad_poison_loop;
		makevectors(ad_poison_angles);
		ad_dir = ad_vecrand(0,50,ad_FALSE);
		ad_dir = ad_dir + (v_forward * (400 + random() * 50));
		ad_newmis.velocity = ad_dir;
		ad_newmis.count = 6;
		ad_newmis.frame = rint(random()*2);

		// If DP engine active remove particle shadow
		if (ad_engine == ad_ENG_DPEXT) ad_newmis.effects = ad_newmis.effects + ad_EF_NOSHADOW;

		ad_newmis.think = ad_skullw_poison_think;
		ad_newmis.touch = ad_skullw_poison_touch;
		ad_newmis.nextthink = time + 0.1;
		
		ad_poison_loop = ad_poison_loop + rint(random()*15);
	}
};

//============================================================================
// SUMMON MINION - Purple magic ball
//============================================================================
void() ad_skullw_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.mdl = ad_MODEL_PROJ_SWBALL;
	}
};

//----------------------------------------------------------------------
void() ad_skullw_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
};

//----------------------------------------------------------------------
void() ad_skullw_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
// Display a purple ball in the hand of the skull wizard
//----------------------------------------------------------------------
void(vector ad_orgofs, float ad_dbframe) ad_skullw_sumball =
{
	local vector ad_org;

	// Frame 0 is start of the sequence (move everything into place)
	if (ad_dbframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.pos2);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.skin = 0;
		self.ad_attachment.alpha = 0.85;
	}

	// Generate attachment in hand (left)
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles_y = rint(random()*359);
	self.ad_attachment.frame = ad_dbframe;

	// Create particles inside of skull wizard robes floating up
	// once lost soul is spawning, then switch particle location
	if (self.aflag == ad_TRUE) ad_particle_explode(self.pos2, 3, 1, self.ad_part_style, ad_PARTICLE_BURST_MINOTAUR);
	// Need to cut down on particles, too much visual noise
	//	else particle_debuff(self.origin, 16, rint(4+random()*4), self.part_style);
};

//----------------------------------------------------------------------
// Raise hand up to the sky and spawn purple particles from body
// Always check if there is space to spawn a lost soul first
// Block monster pain function so that the summons is completed
//----------------------------------------------------------------------
void() ad_skullw_summon1 =[ $summon1, ad_skullw_summon2 ] {
	ad_ai_face();self.ad_pain_finished = time + 2;};
void() ad_skullw_summon2 =[ $summon3, ad_skullw_summon3 ] {
	ad_ai_face();ad_skullw_sumball('22 -2 6',0);};
void() ad_skullw_summon3 =[ $summon5, ad_skullw_summon4 ] {
	ad_ai_face(); ad_skullw_sumball('23 -3 7',1);
	sound (self, ad_CHAN_BODY, "skullwiz/summon.wav", 1, ad_ATTN_NORM);
	/* The touch trigger is created early (4 frames) so its gets
	// a chance for a client to touch its bounding box
	// This is a giant trigger area to catch speedy players
	makevectors(self.angles);
	self.pos1 = self.origin + self.view_ofs + v_forward*64 + v_up*16;
	setup_minionspace(self.pos1, '-32 -32 -32', '32 32 32'); */
};
void() ad_skullw_summon4 =[ $summon7, ad_skullw_summon5 ] {ad_skullw_sumball('24 -4 9',2);};
void() ad_skullw_summon5 =[ $summon9, ad_skullw_summon6 ] {ad_skullw_sumball('26 -4 10',3);};
void() ad_skullw_summon6 =[ $summon11, ad_skullw_summon7 ] {ad_skullw_sumball('26 -4 12',3);};
void() ad_skullw_summon7 =[ $summon13, ad_skullw_summon8 ] {
	// Find out if there is enough space to spawn a lost soul
	// This is really a tricky thing to test for ...
	// * pointcontents only checks against world space
	// * walkmove does not work properly on the lower plane face
	// * touch triggers only work when something touches not inside
	// * findradius will find a lot of entities depending on radius
	
	// Touch trigger version
	//self.aflag = test_minionspace();

	// Findradius version
	makevectors(self.angles);
	self.pos1 = self.origin + self.view_ofs + v_forward*64 + v_up*16;
	self.aflag = ad_find_minionspace(self.pos1);
	
	// If the spawn locaiton all clear, spawn something!
	if (self.aflag == ad_TRUE) {
		ad_minion_lostsoul(self.pos1, self.enemy);
		self.pos2 = self.pos1 - '0 0 16';	// Where to spawn particles
		ad_skullw_sumball('26 -4 14',4);
	}
};
void() ad_skullw_summon8 =[ $summon15, ad_skullw_summon9 ] {ad_skullw_sumball('26 -4 16',4);};
void() ad_skullw_summon9 =[ $summon17, ad_skullw_summon10 ] {ad_skullw_sumball('26 -4 19',4);};
void() ad_skullw_summon10 =[ $summon19, ad_skullw_summon11 ] {ad_skullw_sumball('26 -5 23',4);};
void() ad_skullw_summon11 =[ $summon21, ad_skullw_summon12 ] {ad_skullw_sumball('26 -6 30',3);};
void() ad_skullw_summon12 =[ $summon23, ad_skullw_summon13 ] {ad_skullw_sumball('19 -7 32',1);};
void() ad_skullw_summon13 =[ $summon25, ad_skullw_summon14 ] {ad_skullw_finish_attachment();
	if (self.aflag == ad_TRUE) ad_particle_explode(self.pos1, 15, 2, self.ad_part_style, ad_PARTICLE_BURST_MINOTAUR);};
void() ad_skullw_summon14 =[ $summon27, ad_skullw_summon15 ] {ad_ai_face();};
void() ad_skullw_summon15 =[ $summon29, ad_skullw_run1 ] {
	ad_ai_face();ad_SUB_AttackFinished (1 + 2*random());};

//----------------------------------------------------------------------
// Both type of skull wizards go through the same magic function
//----------------------------------------------------------------------
void() ad_skullw_magic =
{
	local entity ad_miniondef;
	
	// Make sure the attachments are setup ready
	ad_skullw_create_attachment();

	if (self.spawnflags & ad_MON_SKULLWIZ_MINIONS && !self.ad_minion_active) {
		// Check for minion template first
		ad_miniondef = find(world,classname,"monster_skullwizminion");
		if (ad_miniondef.ad_classtype == ad_CT_CACHELOSTSOUL) ad_setup_minionsupport();
		else {
			// If template no available, warn and remove feature
			dprint("\b[SKULLWIZ]\b Cannot find minion template!\n");
			self.spawnflags = self.spawnflags - ad_MON_SKULLWIZ_MINIONS;
		}
	}
	
	// Is the target the player or monster?
	if (self.enemy.flags & ad_FL_CLIENT) {
		if (self.spawnflags & ad_MON_SKULLWIZ_MINIONS) {
			// has the lost soul limit been reached?
			if (ad_query_minionactive(self) == ad_TRUE) ad_skullw_summon1();
			else {
				if (self.ad_minion_baseattack > 0 ) ad_skullw_attack1();
				else ad_skullw_run1();
			}
		}
		// Red Skull wizards attacks with skull rockets
		else ad_skullw_attack1();
		
	}
	// Always attack monsters with skull rockets
	else ad_skullw_attack1();
};
	
//============================================================================
void() ad_skullw_phased = { 
	self.nextthink = time + 0.1;	// Keep looking for player
	self.think = ad_skullw_phased;		// Keep looping
	if (random() < 0.02) 
		ad_particle_explode(self.origin, rint(10+random()*10), 1, self.ad_part_style, ad_PARTICLE_BURST_SKULLUP);
	ad_monster_idle_sound(); 			// High chance of idle sound
	ad_ai_stand(); 					// Keep looking
};

//----------------------------------------------------------------------
void() ad_skullw_wakeup =
{
	// Reset all monster state functions back to default
	self.ad_th_stand = ad_skullw_stand;
	self.ad_th_walk = ad_skullw_walk;
	self.ad_th_run = ad_skullw_run1;
	self.ad_th_missile = ad_skullw_magic;
	self.ad_th_melee = ad_skullw_tele1;
	self.ad_th_updmissile = ad_skullw_guardian;

	// Temporarily restore model/bound box
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setmodel(self, self.mdl);
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);
		
	// Can the skull wizard move?
	if (!ad_walkmove (0, 0)) {
		// Something blocking, teleport elsewhere
		self.solid = ad_SOLID_NOT;
		setmodel(self,"");
		self.nextthink = time + 0.1;
		self.think = ad_skullw_blink;
	}
	else ad_skullw_tfin1();
};

//============================================================================
// Short body recoil (6 frames)
void()	ad_skullw_painA1	=[	$painA2,	ad_skullw_painA2	] {};
void()	ad_skullw_painA2	=[	$painA4,	ad_skullw_painA3	] {};
void()	ad_skullw_painA3	=[	$painA6,	ad_skullw_painA4	] {};
void()	ad_skullw_painA4	=[	$painA8,	ad_skullw_painA5	] {};
void()	ad_skullw_painA5	=[	$painA10,	ad_skullw_painA6	] {};
void()	ad_skullw_painA6	=[	$painA12,	ad_skullw_run1	] 	{};

// Long expanded out version (10 frames)
void()	ad_skullw_painB1	=[	$painA2,	ad_skullw_painB3	] {};
void()	ad_skullw_painB3	=[	$painA3,	ad_skullw_painB4	] {};
void()	ad_skullw_painB4	=[	$painA4,	ad_skullw_painB5	] {};
void()	ad_skullw_painB5	=[	$painA5,	ad_skullw_painB6	] {};
void()	ad_skullw_painB6	=[	$painA6,	ad_skullw_painB7	] {};
void()	ad_skullw_painB7	=[	$painA7,	ad_skullw_painB8	] {};
void()	ad_skullw_painB8	=[	$painA8,	ad_skullw_painB9	] {};
void()	ad_skullw_painB9	=[	$painA9,	ad_skullw_painB10	] {};
void()	ad_skullw_painB10	=[	$painA10,	ad_skullw_painB11	] {};
void()	ad_skullw_painB11	=[	$painA11,	ad_skullw_run1	] 	{};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_skullw_pain =
{
	// Cannot feel pain when phased out
	if (self.ad_bodyphased == ad_MONAI_SKULLWINVIS) return;
	
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);
	ad_skullw_finish_attachment();

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
			if (random() < 0.85) ad_skullw_painA1();	// classic, body recoil
			else ad_skullw_painB1();					// Really long version
		}
	}
};

//============================================================================
void() ad_skullw_fadeaway =
{
	//	sound (self, CHAN_BODY, "skullwiz/fadeaway.wav", 1, ATTN_NORM);
	// Particle burst upwards as robes fade away
	ad_particle_explode(self.origin, 100, 3, self.ad_part_style, ad_PARTICLE_BURST_SKULLUP);
	self.think = ad_model_fade;
	self.nextthink = time + 0.1;
	self.ltime = self.nextthink;
};

//----------------------------------------------------------------------
void() ad_skullw_explode =
{
	self.health = ad_MON_NOGIBVELOCITY;	// Low gib directional modifier
	ad_particle_explode(self.origin, 100, 3, ad_PARTICLE_BURST_WHITE, ad_PARTICLE_BURST_SKULLUP);
	self.ad_gib2skin = self.ad_exactskin;		// Update book skin
	ad_ThrowGib(11,1); ad_ThrowGib(12,1);		// Throw head and book
};

//----------------------------------------------------------------------
void()	ad_skullw_death1	=[	$death2,	ad_skullw_death2	] {ad_ai_face();};
void()	ad_skullw_death2	=[	$death3,	ad_skullw_death3	] {ad_ai_face();};
void()	ad_skullw_death3	=[	$death4,	ad_skullw_death4	] {ad_ai_face();self.solid = ad_SOLID_NOT;};
void()	ad_skullw_death4	=[	$death5,	ad_skullw_death5	] {ad_ai_face();};
void()	ad_skullw_death5	=[	$death6,	ad_skullw_death6	] {ad_skullw_explode();};
void()	ad_skullw_death6	=[	$death7,	ad_skullw_death7	] {};
void()	ad_skullw_death7	=[	$death8,	ad_skullw_death8	] {};
void()	ad_skullw_death8	=[	$death9,	ad_skullw_death9	] {};
void()	ad_skullw_death9	=[	$death10,	ad_skullw_death10	] {};
void()	ad_skullw_death10	=[	$death11,	ad_skullw_death11	] {};
void()	ad_skullw_death11	=[	$death12,	ad_skullw_death12	] {};
void()	ad_skullw_death12	=[	$death13,	ad_skullw_death13	] {};
void()	ad_skullw_death13	=[	$death14,	ad_skullw_death14  ] {};
void()	ad_skullw_death14	=[	$death15,	ad_skullw_death14] {
	// Random timer for robes to fade away
	self.think = ad_skullw_fadeaway;
	self.nextthink = time + 8 + random() * 8;
};

//----------------------------------------------------------------------
void() ad_skullw_die =
{
	// Play fade away/death sound
	sound (self, ad_CHAN_VOICE, "skullwiz/death.wav", 1, ad_ATTN_NORM);

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	ad_skullw_remove_attachment();

	// Special death, Instantly vaporize cloak
	// This is really a gib death without the gibs!
	if (self.health < -40) {
		// Typical Grenade explosion
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
		ad_SpawnExplosion(ad_EXPLODE_MED, self.origin, ad_SOUND_REXP3);

		self.health = ad_MON_NOGIBVELOCITY;	// Low gib directional modifier
		self.ad_gib2skin = self.ad_exactskin;		// Update book skin
		ad_ThrowGib(11,1); ad_ThrowGib(12,1);		// Throw head and book
		ad_entity_hide(self);
	}
	// Regular death, collapse and fade away
	else {
		// Large particle explosion upwards
		ad_particle_explode(self.origin, 100, 3, self.ad_part_style, ad_PARTICLE_BURST_SKULLUP);
		ad_skullw_death1();
	}
};

//======================================================================
/*ad:QUAKED monster_skullwiz (0.5 0 1) (-16 -16 -24) (16 16 40)
======================================================================*/
void() ad_monster_skullwiz =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_skullwiz.mdl";
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_SWSKULL);		// explosive flaming skull
	precache_model (ad_MODEL_PROJ_SWSKULLP);		// explosive poison skull
	precache_model (ad_MODEL_PROJ_SWBALL);			// Purple minion ball
	precache_model (ad_SBURST_POISON);				// Poison explosion

	self.ad_gib1mdl = "progs/h_skullwiz.mdl";		// Skull head
	self.ad_gib2mdl = "progs/w_skullbook.mdl";		// Unique book item
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);

	self.ad_idle_sound = "skullwiz/idle1.wav";
	self.ad_idle_sound2 = "skullwiz/idle2.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);

	precache_sound ("skullwiz/death.wav");
	self.ad_pain_sound = "skullwiz/pain1.wav";
	self.ad_pain_sound2 = "skullwiz/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);

	precache_sound ("skullwiz/attack.wav");		// fire spell
	precache_sound ("skullwiz/skull1.wav");		// Screaming skull attack
	precache_sound ("skullwiz/skull2.wav");
	precache_sound ("skullwiz/summon.wav");
	precache_sound ("skullwiz/poison_hit.wav");	// Guardian Explosion

	precache_sound ("skullwiz/blinkspk1.wav");	// Talk casting blink spell
	precache_sound ("skullwiz/blinkspk2.wav");
	precache_sound ("skullwiz/blinkout.wav");	// Sound of blink animation
	precache_sound ("skullwiz/blinkin.wav");

	self.ad_sight_sound = "skullwiz/sight.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 120;
	self.ad_gibhealth = ad_MON_NEVERGIB;	// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_flinch = 50;			// Armour strength robes!
	self.ad_steptype = ad_FS_TYPEMEDIUM;	// Humanoid footsteps
	self.ad_pain_longanim = ad_FALSE;		// No long pain animation
	self.ad_poisonous = ad_FALSE;			// Only Guardians can be poisonous
	self.ad_deathstring = " was blown apart by a Skull Wizard\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	// Skull wizards have special animation movement sets
	// Need extra parameters for their teleporting ability
	// Can be setup to start phased out and surprise the player
	self.ad_idlebusy = ad_SKULLW_STAND;
	if (self.height <= 0) self.height = ad_SKULLW_HEIGHT;
	if (self.ad_distmin <= 0) self.ad_distmin = ad_SKULLW_DISTMIN;
	if (self.ad_distmax <= 0) self.ad_distmax = ad_SKULLW_DISTMAX;
	if (!self.ad_bodyphased) self.ad_bodyphased = ad_MONAI_SKULLWSOLID;
	else self.ad_bodyphased = ad_MONAI_SKULLWINVIS;

	self.ad_th_checkattack = ad_SkullWizCheckAttack;
	self.ad_th_updmissile = ad_skullw_guardian;
	self.ad_th_pain = ad_skullw_pain;
	self.ad_th_die = ad_skullw_die;

	// Does the skull wizard start phased out?
	// Need to intercept idle/combat functions
	if (self.ad_bodyphased == ad_MONAI_SKULLWINVIS) {
		self.ad_th_stand = ad_skullw_phased;
		self.ad_th_walk = ad_skullw_phased;
		self.ad_th_run = ad_skullw_wakeup;
		self.ad_th_missile = ad_skullw_wakeup;
		self.ad_th_melee = ad_skullw_wakeup;
	}
	else {
		self.ad_th_stand = ad_skullw_stand;
		self.ad_th_walk = ad_skullw_walk;
		self.ad_th_run = ad_skullw_run1;
		self.ad_th_missile = ad_skullw_magic;
		self.ad_th_melee = ad_skullw_tele1;
	}
	
	self.ad_classtype = ad_CT_MONSKULLW;
	self.ad_classgroup = ad_CG_WIZARD;
	self.ad_classmove = ad_MON_MOVEWALK;

	// Special black robes for skull spawner
	if (self.spawnflags & ad_MON_SKULLWIZ_MINIONS) {
		self.health = self.health * 1.5;			// 150% HP
		if (!self.ad_exactskin) self.ad_exactskin = 2;	// Black robes
	}
	// Special green robes for rune guardians
	else if (self.spawnflags & ad_MON_SKULLWIZ_GUARDIAN) {
		self.health = self.health * 2;				// 200% HP
		if (!self.ad_exactskin) self.ad_exactskin = 3;	// Green robes
		self.ad_poisonous = ad_TRUE;						// Explosive Poison
	}
	
	// Make sure the particles match the skin
	if (self.ad_exactskin == 1) self.ad_part_style = ad_PARTICLE_BURST_GREEN;
	else if (self.ad_exactskin == 2) self.ad_part_style = ad_PARTICLE_BURST_PURPLE;
	else if (self.ad_exactskin == 3) self.ad_part_style = ad_PARTICLE_BURST_GREEN;
	else if (self.ad_exactskin == 4) self.ad_part_style = ad_PARTICLE_BURST_WHITE;
	else self.ad_part_style = ad_PARTICLE_BURST_RED;
			
	ad_monster_start();
};

//======================================================================
/*ad:QUAKED info_skullwiz_destination (0.6 0 0.8) (-16 -16 -24) (16 16 40) x
Teleport destination for skull wizard ONLY
-------- KEYS --------
targetname : part of a chain group (required)
target   : next destination in the chain
distance : Minimum distance enemy needs to be before spawning
-------- SPAWNFLAGS --------
-------- NOTES --------
Teleport destination for skull wizard ONLY

======================================================================*/
void() ad_info_skullwiz_link =
{
	local entity ad_currlink, ad_master;
	local float ad_loopcondition;
	
	// Teleport destination already been linked
	if (self.enemy) return;
	
	// The master entity is the start of the chain
	// the currlink is a link in the chain
	ad_master = self;
	ad_loopcondition = ad_TRUE;
	
	while (ad_loopcondition) 
	{
		// Setup next link to master and find next link
		self.enemy = ad_master;
		ad_currlink = find(world, targetname, self.target);
		// reached end of list?
		if (!ad_currlink || ad_currlink == ad_master) 
			ad_loopcondition = ad_FALSE;
		else {
			// Move forward in the chain
			self.enemy = ad_currlink;
			self = ad_currlink;
		}
	}
};

//----------------------------------------------------------------------
void() ad_info_skullwiz_destination =
{
	// All teleportation points need to be part of a chain
	// Otherwise the skull Wizard would have to use findradius
	// which is expensive if lots of entities are around
	if (self.targetname == "" || self.target == "") {
		dprint("\b[SKULLWIZ_DEST]\b missing target or targetname\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	
	self.ad_classtype = ad_CT_SKULLTELEPORT;
	self.mangle = self.angles;
	// Setup minimum player spawn distance
	if (self.distance <=0) self.distance = ad_MONAI_MELEESKULLW;
	// Setup if the destination is active or not
	self.state = ad_FALSE;

	// Check for targetname->target loops
	if (self.targetname == self.target) {
		self.enemy = self;
		self.owner = self;
	}
	else {
		// Wait for all targets to spawn
		self.think = ad_info_skullwiz_link;
		self.nextthink = time + 0.2 + random();
	}
};

