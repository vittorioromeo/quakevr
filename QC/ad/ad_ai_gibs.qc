/*======================================================================
 precache_stonegibs, precache_poisongibs
  Only load extra gibs when there is a monster requiring them
  There are separate gib models because of particle trail colours
  These functions have to be called from monster spawn functions
  The gib system tests for the global variables defined below
  If the extra gibs are not active then default blood vers are used
======================================================================*/
void() ad_precache_stonegibs =
{
	ad_gibstone = ad_TRUE;
	precache_model (ad_GIB1_STONE);			// New gib - arm/leg
	precache_model (ad_GIB2_STONE);			// New gib - body
	precache_model (ad_GIB3_STONE);			// New gib - slice
	precache_model (ad_GIB4_STONE);			// New gib - small chunk/ball
	precache_model (ad_GIB5_STONE);			// New gib - large chunk/ball
};

//----------------------------------------------------------------------
void() ad_precache_poisongibs =
{
	ad_gibpoison = ad_TRUE;
	precache_model (ad_GIB1_POISON);			// New gib - arm/leg
	precache_model (ad_GIB2_POISON);			// New gib - body
	precache_model (ad_GIB3_POISON);			// New gib - slice
	precache_model (ad_GIB4_POISON);			// New gib - small chunk/ball
	precache_model (ad_GIB5_POISON);			// New gib - large chunk/ball
};

//----------------------------------------------------------------------
void() ad_precache_bloodgibs =
{
	ad_gibblood = ad_TRUE;
	precache_model (ad_GIB1_BLOOD);			// New gib - arm/leg
	precache_model (ad_GIB2_BLOOD);			// New gib - body
	precache_model (ad_GIB3_BLOOD);			// New gib - slice
	precache_model (ad_GIB4_BLOOD);			// New gib - small chunk/ball
	precache_model (ad_GIB5_BLOOD);			// New gib - large chunk/ball
};

//----------------------------------------------------------------------
float(float ad_gibsound) ad_check_gibsound =
{
	if (ad_gibsound == ad_GIB_IMPACT_HEAVY) return ad_TRUE;
	else if (ad_gibsound == ad_GIB_IMPACT_METALA) return ad_TRUE;
	else if (ad_gibsound == ad_GIB_IMPACT_METALB) return ad_TRUE;
	else if (ad_gibsound == ad_GIB_IMPACT_CHAIN) return ad_TRUE;
	else if (ad_gibsound == ad_GIB_IMPACT_WOOD) return ad_TRUE;
	else if (ad_gibsound == ad_GIB_IMPACT_ACID) return ad_TRUE;
	else if (ad_gibsound == ad_GIB_IMPACT_CUSTOM) return ad_TRUE;
	else return ad_FALSE;
};

//----------------------------------------------------------------------
void(entity ad_gibent) ad_DPP_blood_trail =
{
	// Cannot add particle trails to the player!
	if (ad_gibent.flags & ad_FL_CLIENT) {
		dprint("\b[GIB]\b Cannot add particle trail to player!\n");
		return;
	}
	
	// Stone = dark black dust on the floor
	if (ad_gibent.ad_gibtype == ad_GIBTYPE_STONE) {
		ad_gibent.ad_traileffectnum = particleeffectnum(ad_DPP_TRSBLOOD);
	}
	// Nothing for wood at this moment
	else if (ad_gibent.ad_gibtype == ad_GIBTYPE_WOOD) {}
	// Nothing for wood at this moment
	else if (ad_gibent.ad_gibtype == ad_GIBTYPE_GLASS) {}
	// Nothing for wood at this moment
	else if (ad_gibent.ad_gibtype == ad_GIBTYPE_METAL) {}
	// Glowing green blobs splashed about
	else if (ad_gibent.ad_gibtype == ad_GIBTYPE_POISON) {
		ad_gibent.ad_traileffectnum = particleeffectnum(ad_DPP_TRPBLOOD);
	}
	else {
		// DISABLED - Excessive blood trails can be bad for large maps
		// Typical blood stains (20% chance of more blood)
		//if (random() < 0.2) gibent.traileffectnum = particleeffectnum(DPP_ITSBLOOD);
		//else gibent.traileffectnum = particleeffectnum(DPP_TRBLOOD);
		ad_gibent.ad_traileffectnum = particleeffectnum(ad_DPP_TRBLOOD);
	}
};

/*======================================================================
 DirectionForDamage
  Takes the angle between self and enemy and projects backwards
======================================================================*/
vector(float ad_gibforce) ad_DirectionForDamage =
{
	local vector ad_gvel;
	local float ad_gftype;
	
	// Horrible hack!!! Need a way to override max_health
	// Sometimes gibs are thrown when monsters are not dead
	// This will create the correct velocity while alive
	if (self.ad_gibdir < 0) ad_gftype = self.ad_gibdir;
	else ad_gftype = self.max_health;
	
	// Gentle fountain, not much upward motion
	if (ad_gftype == ad_MON_GIBFOUNTAIN) {
		ad_gvel_x = ad_crandom()*100;
		ad_gvel_y = ad_crandom()*100;
		ad_gvel_z = 100 + (100 * random());
		return ad_gvel;
	}
	// Party popper version (large explosion)
	else if (ad_gftype == ad_MON_GIBEXPLOSION) {
		ad_gvel_x = ad_crandom()*250;
		ad_gvel_y = ad_crandom()*250;
		ad_gvel_z = 400 + (100 * random());
		return ad_gvel;
	}
	else if (ad_gftype == ad_MON_XYGIBVELOCITY) {
		// Back to front vector so gib will travel away from enemy
		ad_gvel = vectoangles(self.origin - self.enemy.origin);
		makevectors(ad_gvel);
		ad_gvel = v_forward * (50 + (100 * random()));
		ad_gvel = ad_gvel + (v_right * (200 * ad_crandom()));
		ad_gvel_z = 100 + (100 * random());
	}
	else if (ad_gftype == ad_MON_NOGIBVELOCITY) {
		// Back to front vector so gib will travel away from enemy
		ad_gvel = vectoangles(self.origin - self.enemy.origin);
		makevectors(ad_gvel);
		ad_gvel = v_forward * (50 + (100 * random()));
		ad_gvel = ad_gvel + (v_right * (100 * ad_crandom()));
		ad_gvel_z = 30;
	}
	// Designed for non monster entities (overwrites self entity keys)
	else if (ad_gftype == ad_MON_GIBTARGET) {
		// Check for any target entity tracking setup
		if (self.target != "") ad_TargetMovedir(self, ad_FALSE);
		// default movedir movement
		ad_gvel = self.movedir * (self.speed + (self.ad_gibvel_x * random()));
		// Add Left/Right random velocity
		ad_gvel = ad_gvel + (v_right * (self.ad_gibvel_y * ad_crandom()));
		// Add Up/Down random velocity
		ad_gvel = ad_gvel + (v_up * (self.ad_gibvel_z * ad_crandom()));
		return ad_gvel;
	}
	else {
		// Back to front vector so gib will travel away from enemy
		ad_gvel = vectoangles(self.origin - self.enemy.origin);
		makevectors(ad_gvel);
		ad_gvel = v_forward * (50 + (100 * random()));
		ad_gvel = ad_gvel + (v_right * (100 * ad_crandom()));
		ad_gvel_z = 100 + (100 * random());
	}

	if (ad_gibforce > -50) ad_gvel = ad_gvel * 1.25;
	return ad_gvel;
};

//======================================================================
void() ad_RemoveGib =
{
	// Stop any touch functions
	self.waitmin = ad_LARGE_TIMER;
	// Fade away model
	self.think = ad_model_fade;
	self.nextthink = time + 0.1;
	self.ltime = self.nextthink;
};

//----------------------------------------------------------------------
void() ad_CheckFloorGib =
{
	// Is it time for the gib to fade away?
	if (self.ad_pain_finished > time) {
		// Check for particles from gib
		if (self.ad_gibpartstyle > 0) {
			if (random() < self.ad_gibpartchance) {
				ad_particle_explode(self.origin+self.ad_gibpartoffset, self.ad_gibpartbase+random()*self.ad_gibpartrnd, self.ad_gibpartlife+random(), self.ad_gibpartstyle, 0);
			}
		}
		// Check floor below gib (global function)
		// Origin at base of model + 16 (typical step height)
		ad_ent_floorcheck(self, ad_FLOOR_TRACE_GIBS);

		// Check for final impact animation
		if (self.ad_gibAnimfinal > 0 && self.ad_gibAnimTimer < time) {
			if (self.ad_walkframe > self.ad_gibAnimfinal) {
				self.ad_gibAnimfinal = 0;
				ad_RemoveGib();
				return;
			}
			else {
				self.frame = self.ad_gibAnimstart + self.ad_walkframe;
				self.ad_walkframe = self.ad_walkframe + 1;
			}
		}
		
		// Keep checking
		self.think = ad_CheckFloorGib;
		self.nextthink = time + 0.1;
	}
	else ad_RemoveGib();
};

//----------------------------------------------------------------------
void() ad_TouchGib =
{
	// Always check for sky and void functions first
	if (self.ad_touchedvoid) return;				// Marked for removal
	
	//if (check_skycontent(self.origin)) {entity_remove(self, 0.1); return;}
	// Disabled - will cause extreme slowdowns with DP/FTE engines 
	// This function will check the whole surface list which can be
	// crazy for extremely large maps

	// Check if the gib can damage (only players) on touch
	if (self.ad_gib1dmg > 0 && other.flags & ad_FL_CLIENT) {
		ad_T_Damage (other, self, self, self.ad_gib1dmg, ad_DAMARMOR);
		self.ad_gib1dmg = 0;
		ad_SpawnExplosion(self.ad_gib1exp, self.origin, ad_SOUND_REXP3);
		ad_entity_remove(self, 0.1);
		return;
	}
	
	// Check rest of touch restrictions
	if (self.waitmin > time) return;			// Touch function disabled
	if (other == self.owner) return;			// Ignore original monster
	if (other.ad_classgroup == ad_CG_TEMPENT) return;	// Ignore other temp entities

	// Block multiple touch of impact sound
	self.waitmin = time + 2 + random() * 2;
	
	// Is there any time left to setup floor checks
	if (self.ad_pain_finished > time + 0.1) {
		self.think = ad_CheckFloorGib;
		self.nextthink = time + 0.1;
	}
	
	// stop gibs constantly touching moving func bmodels
	// let the impact sound work once and then stop
	if (other.ad_classgroup == ad_CG_FUNCMOVER) {
		if (self.ad_waitmin2 > time) return;
		self.ad_waitmin2 = ad_LARGE_TIMER;
	}
	
	//----------------------------------------------------------------------
	// Only need to pick the impact sound once
	// No point to keep randomly picking
	//----------------------------------------------------------------------
	if (self.noise == "") {
		// Setup defaults for gib impact sound
		self.volume = ad_ATTN_GIB;
		self.noise = ad_SOUND_EMPTY;

		// Check first for unique impact sound
		if (self.weapon > 0) {
			self.volume = ad_ATTN_NORM;
			if (self.weapon == ad_GIB_IMPACT_HEAVY) self.noise = ad_GIB_SOUND_HEAVY;
			else if (self.weapon == ad_GIB_IMPACT_METALA) self.noise = ad_GIB_SOUND_METALA;
			else if (self.weapon == ad_GIB_IMPACT_METALB) self.noise = ad_GIB_SOUND_METALB;
			else if (self.weapon == ad_GIB_IMPACT_CHAIN) self.noise = ad_GIB_SOUND_CHAIN;
			else if (self.weapon == ad_GIB_IMPACT_WOOD) self.noise = ad_GIB_SOUND_WOOD;
			else if (self.weapon == ad_GIB_IMPACT_ACID) self.noise = ad_GIB_SOUND_ACID;
		}
		// Check default gib impact types (stone, metal, blood)
		else {
			if (self.ad_gibtype == ad_GIBTYPE_STONE) {
				self.lip = random() * 3;
				if (self.lip < 1) self.noise = ad_GIBHIT1_STONESOUND;
				else if (self.lip < 2) self.noise = ad_GIBHIT3_STONESOUND;
				else self.noise = ad_GIBHIT5_STONESOUND;
			}
			else if (self.ad_gibtype == ad_GIBTYPE_METAL) {
				self.lip = random() * 3;
				if (self.lip < 1) self.noise = ad_GIBHIT1_METALSOUND;
				else if (self.lip < 2) self.noise = ad_GIBHIT3_METALSOUND;
				else self.noise = ad_GIBHIT5_METALSOUND;
			}
			// If no sound defined, use default flesh sounds
			else if (self.noise != "") {
				self.lip = random() * 5;
				if (self.lip < 1) self.noise = ad_GIBHIT1_SOUND;
				else if (self.lip < 2) self.noise = ad_GIBHIT2_SOUND;
				else if (self.lip < 3) self.noise = ad_GIBHIT3_SOUND;
				else if (self.lip < 4) self.noise = ad_GIBHIT4_SOUND;
				else self.noise = ad_GIBHIT5_SOUND;
			}
		}
	}
			
	// Has any impact sounds been defined?
	if (self.noise != "") sound(self, ad_CHAN_VOICE, self.noise, 1, self.volume);
};

//======================================================================
// ThrowGib was originally in player.qc (moved here instead)
// Spawns a gib model and throws it up into the air to bounce around
//======================================================================
void(float ad_gib_no, float ad_gib_qty) ad_ThrowGib =
{
	
	while (ad_gib_qty > 0) {
		ad_gibitem = spawn();
		ad_gibitem.owner = self;
		ad_gibitem.classname = "item_gib";
		ad_gibitem.ad_classtype = ad_CT_TEMPGIB;
		ad_gibitem.ad_classgroup = ad_CG_TEMPENT;
		ad_gibitem.frame = ad_gibitem.skin = 0;
		
		// Check for any touch/contact damage / explosions
		if (self.ad_gib1dmg > 0) ad_gibitem.ad_gib1dmg = self.ad_gib1dmg;
		if (self.ad_gib1exp > 0) ad_gibitem.ad_gib1exp = self.ad_gib1exp;

		// Setup gib type (particle trail)
		if (self.ad_gibtype) ad_gibitem.ad_gibtype = self.ad_gibtype;
		
		// Create extra blood particles for DP engine
		if (ad_ext_dppart) ad_DPP_blood_trail(ad_gibitem);
		
		// Arm/leg joint (small)
		if (ad_gib_no == 1) {
			if (self.ad_gibtype == ad_GIBTYPE_STONE && ad_gibstone) ad_gibitem.mdl = ad_GIB1_STONE;
			else if (self.ad_gibtype == ad_GIBTYPE_POISON && ad_gibpoison) ad_gibitem.mdl = ad_GIB1_POISON;
			else ad_gibitem.mdl = ad_GIB1_BLOOD;
		}
		// Torso (large lump)
		else if (ad_gib_no == 2) {
			if (self.ad_gibtype == ad_GIBTYPE_STONE && ad_gibstone) ad_gibitem.mdl = ad_GIB2_STONE;
			else if (self.ad_gibtype == ad_GIBTYPE_POISON && ad_gibpoison) ad_gibitem.mdl = ad_GIB2_POISON;
			else ad_gibitem.mdl = ad_GIB2_BLOOD;
		}
		// Slice (large and wedge like)
		else if (ad_gib_no == 3) {
			if (self.ad_gibtype == ad_GIBTYPE_STONE && ad_gibstone) ad_gibitem.mdl = ad_GIB3_STONE;
			else if (self.ad_gibtype == ad_GIBTYPE_POISON && ad_gibpoison) ad_gibitem.mdl = ad_GIB3_POISON;
			else ad_gibitem.mdl = ad_GIB3_BLOOD;
		}
		// Blob (small and round)
		else if (ad_gib_no == 4) {
			if (self.ad_gibtype == ad_GIBTYPE_STONE && ad_gibstone) ad_gibitem.mdl = ad_GIB4_STONE;
			else if (self.ad_gibtype == ad_GIBTYPE_POISON && ad_gibpoison) ad_gibitem.mdl = ad_GIB4_POISON;
			else ad_gibitem.mdl = ad_GIB4_BLOOD;
		}
		// Blob (large and round)
		else if (ad_gib_no == 5) {
			if (self.ad_gibtype == ad_GIBTYPE_STONE && ad_gibstone) ad_gibitem.mdl = ad_GIB5_STONE;
			else if (self.ad_gibtype == ad_GIBTYPE_POISON && ad_gibpoison) ad_gibitem.mdl = ad_GIB5_POISON;
			else ad_gibitem.mdl = ad_GIB5_BLOOD;
		}
		// Custom Gib (defined by monster)
		else if (ad_gib_no == 11) {
			// Check for custom model, skin and frame
			ad_gibitem.mdl = self.ad_gib1mdl;
			if (self.ad_gib1sound == ad_GIB_IMPACT_CUSTOM) ad_gibitem.noise = self.ad_gib1soundx;
			else ad_gibitem.weapon = self.ad_gib1sound;
			if (self.ad_gib1skin > 0) ad_gibitem.skin = self.ad_gib1skin;
			if (self.ad_gib1frame > 0) ad_gibitem.frame = rint(random()*self.ad_gib1frame);
			if (!(ad_CheckZeroVector(self.ad_gib1origin))) ad_gibitem.oldorigin = self.ad_gib1origin;
		}
		// Custom Gib (defined by monster)
		else if (ad_gib_no == 12) {
			// Check for custom model, skin and frame
			ad_gibitem.mdl = self.ad_gib2mdl;
			if (self.ad_gib2sound == ad_GIB_IMPACT_CUSTOM) ad_gibitem.noise = self.ad_gib2soundx;
			else ad_gibitem.weapon = self.ad_gib2sound;
			if (self.ad_gib2skin > 0) ad_gibitem.skin = self.ad_gib2skin;
			if (self.ad_gib2frame > 0) ad_gibitem.frame = rint(random()*self.ad_gib2frame);
			if (!(ad_CheckZeroVector(self.ad_gib2origin))) ad_gibitem.oldorigin = self.ad_gib2origin;
		}
		// Custom Gib (defined by monster)
		else if (ad_gib_no == 13) {
			// Check for custom model, skin and frame
			ad_gibitem.mdl = self.ad_gib3mdl;
			if (self.ad_gib3sound == ad_GIB_IMPACT_CUSTOM) ad_gibitem.noise = self.ad_gib3soundx;
			else ad_gibitem.weapon = self.ad_gib3sound;
			if (self.ad_gib3skin > 0) ad_gibitem.skin = self.ad_gib3skin;
			if (self.ad_gib3frame > 0) ad_gibitem.frame = rint(random()*self.ad_gib3frame);
			if (!(ad_CheckZeroVector(self.ad_gib3origin))) ad_gibitem.oldorigin = self.ad_gib3origin;
		}
		// Extra Custom Gib (just models, minimal paramters)
		else if (ad_gib_no == 14) {
			ad_gibitem.mdl = self.ad_gib4mdl;
			if (self.ad_gib4skin > 0) ad_gibitem.skin = self.ad_gib4skin;
		}
		// Extra Custom Gib (just models, minimal paramters)
		else if (ad_gib_no == 15) {
			ad_gibitem.mdl = self.ad_gib5mdl;
			if (self.ad_gib5skin > 0) ad_gibitem.skin = self.ad_gib5skin;
		}
		// Special head gib (based on headmdl and skin no)
		else if (ad_gib_no == 25) {
			ad_gibitem.mdl = self.ad_headmdl;
			ad_gibitem.skin = self.skin;
		}

		// Check for any particles setup on gib
		if (self.ad_gibpartstyle > 0) {
			if (self.ad_gibpartbase > 0) ad_gibitem.ad_gibpartbase = self.ad_gibpartbase;
			else ad_gibitem.ad_gibpartbase = 1;
			if (self.ad_gibpartrnd > 0) ad_gibitem.ad_gibpartrnd = self.ad_gibpartrnd;
			else ad_gibitem.ad_gibpartrnd = 1;
			if (self.ad_gibpartlife > 0) ad_gibitem.ad_gibpartlife = self.ad_gibpartlife;
			else ad_gibitem.ad_gibpartlife = 0.5;
			if (self.ad_gibpartchance > 0) ad_gibitem.ad_gibpartchance = self.ad_gibpartchance;
			else ad_gibitem.ad_gibpartchance = 0.5;
			ad_gibitem.ad_gibpartoffset = self.ad_gibpartoffset;
			ad_gibitem.ad_gibpartstyle = self.ad_gibpartstyle;
		}
		
		// Check for any animations on impact
		if (self.ad_gibAnimfinal > 0) {
			ad_gibitem.ad_walkframe = 0;
			ad_gibitem.ad_gibAnimstart = self.ad_gibAnimstart;
			ad_gibitem.ad_gibAnimfinal = self.ad_gibAnimfinal;
			ad_gibitem.ad_gibAnimTimer = time + self.ad_gibAnimTimer + random()*(self.ad_gibAnimTimer*2);
		}
		
		// Bounce like a grenade have trigger/touch impact
		ad_gibitem.movetype = ad_MOVETYPE_BOUNCE;
		ad_gibitem.solid = ad_SOLID_TRIGGER;

		setmodel (ad_gibitem, ad_gibitem.mdl);
		// Allow for custom bounding box for gib models
		if (!(ad_CheckZeroVector(self.ad_gibmins)))
			setsize (ad_gibitem, self.ad_gibmins, self.ad_gibmaxs);
		else setsize (ad_gibitem, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		
		// 10 frames of different pose/sizes for regular gibs
		if (ad_gib_no < 10) ad_gibitem.frame = rint(random()*9);
		
		// Special head gib (plenty of upward motion)
		if (ad_gib_no == 25) {
			ad_gibitem.oldorigin = self.origin;
			setorigin(ad_gibitem, ad_gibitem.oldorigin);
			
			ad_gibitem.velocity_x = 50 * ad_crandom();
			ad_gibitem.velocity_y = 50 * ad_crandom();
			ad_gibitem.velocity_z = 200 + 100 * random();

			ad_gibitem.avelocity = '0 0 0';
			ad_gibitem.avelocity_y = 200 + random() * 200;
			ad_gibitem.angles_y = ad_gibitem.ideal_yaw = random() * 360;
		}
		else {
			//----------------------------------------------------------------------
			// Make sure gibs fountain items have correct origins
			if (self.ad_classtype == ad_CT_MISCGIBF) ad_gibitem.oldorigin = self.origin;

			//----------------------------------------------------------------------
			// Spawn gib inside of owner model volume instead of from a single point
			// Not used anymore, does not cope very well with larger bound boxes
			//gibitem.oldorigin_x = self.absmin_x + random()*(self.maxs_x - self.mins_x);
			//gibitem.oldorigin_y = self.absmin_y + random()*(self.maxs_y - self.mins_y);	
			//gibitem.oldorigin_z = 16 + (random()*12) + self.origin_z;
			
			//----------------------------------------------------------------------
			// This version copes with taller enemies by using all of the bounding box
			if (ad_CheckZeroVector(ad_gibitem.oldorigin)) {
				ad_gibitem.oldorigin_x = ad_crandom()*(self.ad_bbmaxs_x*0.75);
				ad_gibitem.oldorigin_y = ad_crandom()*(self.ad_bbmaxs_y*0.75);
				// This function was originally designed for monster bbox only
				// Function has been expanded to use misc model (source) as well
				// Not every model is using the -24 unit monster floor setup
				// Check for odd model setups first (zero and < 0 unit)
				if (self.ad_bbmaxs_z == 0 && self.ad_bbmins_z == 0) ad_gibitem.oldorigin_z = 0;
				// If max is too small or negative, calc bbox and move downward
				// This is option really relies on the gib_ofs option to compensate
				if (self.ad_bbmaxs_z < 8)
					ad_gibitem.oldorigin_z = 0 - (((self.ad_bbmaxs_z-self.ad_bbmins_z)*0.5)*random());
				// This is designed for monster models only
				else ad_gibitem.oldorigin_z = (random()*self.ad_bbmaxs_z)-12;
				
				//gibitem.oldorigin_z = ((self.bbmaxs_z-self.bbmins_z)*0.5)*(random()*0.5);
				
				ad_gibitem.oldorigin = ad_gibitem.oldorigin + self.origin + self.ad_gib_ofs;
				// Debug marker to show gib spread within bbox
				//spawn_marker(gibitem.oldorigin,SPNMARK_WHITE);
			}
			setorigin(ad_gibitem, ad_gibitem.oldorigin);
		
			//----------------------------------------------------------------------
			// NEW Directional gib velocity with modifier
			ad_gibitem.velocity = ad_DirectionForDamage(self.health);
			ad_gibitem.angles_y = ad_gibitem.ideal_yaw = random() * 360;
			if (ad_gib_no < 10) ad_gibitem.avelocity = ad_vecrand(100,200,ad_FALSE);
			else ad_gibitem.avelocity = ad_crandom() * '0 300 0';
		}

		//----------------------------------------------------------------------
		// Check for water content, adjust for water friction
		if (pointcontents(ad_gibitem.oldorigin) == ad_CONTENT_WATER) {
			ad_gibitem.gravity = 0.35;
			ad_gibitem.velocity_z = 0;
		}
	
		ad_gibitem.touch = ad_TouchGib;
		ad_gibitem.nextthink = time + ad_GIB_FADETIME + random() * ad_GIB_FADETIME;
		ad_gibitem.ad_pain_finished = ad_gibitem.nextthink;
		ad_gibitem.think = ad_RemoveGib;
		VR_AD_GibThrown(ad_gibitem, ad_gib_no);

		ad_gib_qty = ad_gib_qty - 1;
	}
};

//======================================================================
// Explode monster into a shower of gibs (throw head as well)
//======================================================================
void() ad_monster_ThrowGib =
{
	self.ad_gibbed = ad_TRUE;		// Monster has offical gone to pieces ;)
	VR_AD_Gibbed();

	//----------------------------------------------------------------------
	// New set of gib sounds - gib1, gib3, gib5
	// FIXME - Sadly the source for these files is UT :(
	// Zombies have special gib sound because they always go that way!
	// Stone enemies are just a pile of rubble and dust!
	//----------------------------------------------------------------------
	if (self.ad_classgroup == ad_CG_ZOMBIE)
		sound (self, ad_CHAN_VOICE, "zombie/z_gib.wav", 1, ad_ATTN_NORM);
	else if (self.ad_gibtype == ad_GIBTYPE_STONE)
		sound(self, ad_CHAN_VOICE, ad_GIB_SOUND_SDEATH, 1, ad_ATTN_NORM);
	else {
		self.lip = random() * 4;
		if (self.lip < 1) sound (self, ad_CHAN_VOICE, ad_GIB1_SOUND, 1, ad_ATTN_NORM);
		else if (self.lip < 2) sound (self, ad_CHAN_VOICE, ad_GIB3_SOUND, 1, ad_ATTN_NORM);
		else {
			// Is the monster humanoid? (udeath is the original id gib sound)
			if (self.ad_blockudeath) sound (self, ad_CHAN_VOICE, ad_GIB5_SOUND, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_VOICE, ad_GIB_SOUND_UDEATH, 1, ad_ATTN_NORM);
		}
	}
		
	// Some monsters have special death setups
	//----------------------------------------------------------------------
	if (self.ad_th_gibdie) { self.ad_th_gibdie(); return; }
	
	//----------------------------------------------------------------------
	// If any special gib models defined, throw them
	//----------------------------------------------------------------------
	if (self.ad_gib1mdl != "") ad_ThrowGib(11, 1);
	if (self.ad_gib2mdl != "") ad_ThrowGib(12, 1);
	if (self.ad_gib3mdl != "") ad_ThrowGib(13, 1);
	if (self.ad_gib4mdl != "") ad_ThrowGib(14, 1);

	//----------------------------------------------------------------------
	// Work through each monster type (default = humanoid)
	// GIB 1 - arm/leg (small)
	// GIB 2 - torso (large)
	// GIB 3 - slice (medium)
	// GIB 4 - blob (small)
	// GIB 5 - blob (medium)
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONDEMON) { 
		ad_ThrowGib(4, 1 + rint(random()*2));
		ad_ThrowGib(5, 3 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONDROLE) { 
		ad_ThrowGib(4, 2 + rint(random()*2));
		ad_ThrowGib(5, 4 + rint(random()*2));
	}
	else if (self.ad_classtype == 	ad_CT_MONDOG) {
		ad_ThrowGib(4, 1 + rint(random()*3));
		ad_ThrowGib(5, 1 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONWRAITH) {
		ad_ThrowGib(4, 3 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONSHAL) {
		ad_ThrowGib(4, 2 + rint(random()*4));
		ad_ThrowGib(5, 2 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONGOLEM) {
		ad_ThrowGib(11, 4 + rint(random()*2));
		ad_ThrowGib(12, 8 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONSCORPION) {
		ad_ThrowGib(4, 2 + rint(random()*4));
		ad_ThrowGib(5, 2 + rint(random()*2));
	}
	// Includes brown/green spiders and vorelings
	else if (self.ad_classgroup == ad_CG_SPIDER) {
		ad_ThrowGib(4, rint(random()*3));
		ad_ThrowGib(11, rint(random()*2));
	}
	else if (self.ad_classtype == 	ad_CT_MONELF) {
		ad_ThrowGib(4, 3 + rint(random()*3));
	}
	else if (self.ad_classtype == ad_CT_MONSANTA) {
		ad_ThrowGib(3, 1);
		ad_ThrowGib(4, 8 + rint(random()*4));
		ad_ThrowGib(5, 4 + rint(random()*2));
		ad_ThrowGib(13, 8 + rint(random()*4));
	}
	else if (self.ad_classgroup == ad_CG_FISH) {
		ad_ThrowGib(4, 3 + rint(random()*3));
		ad_ThrowGib(5, 1);
	}
	else if (self.ad_classtype == ad_CT_MONBOIL) {
		ad_ThrowGib(3, 1 + rint(random()*2));
		ad_ThrowGib(4, 4 + rint(random()*2));
		ad_ThrowGib(4, 5 + rint(random()*3));
	}
	else if (self.ad_classgroup == ad_CG_ZOMBIE) {
		ad_ThrowGib(4, 3 + rint(random()*3));
		ad_ThrowGib(5, 1 + rint(random()*2));
	}
	// Includes vanilla and new hunter ogres
	else if (self.ad_classgroup == ad_CG_OGRE) {
		ad_ThrowGib(4, 1 + rint(random()*3));
		ad_ThrowGib(5, 2 + rint(random()*2));
	}
	else if (self.ad_classgroup == ad_CG_DCAPTAIN) {
		ad_ThrowGib(3, 1);
		ad_ThrowGib(4, 2 + rint(random()*4));
		ad_ThrowGib(5, 2 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONGARGOYLE) {
		ad_ThrowGib(4, 2 + rint(random()*3));
		ad_ThrowGib(5, 1 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONGAUNT) {
		ad_ThrowGib(4, 3 + rint(random()*2));
		ad_ThrowGib(5, 2 + rint(random()*2));
	}
	else if (self.ad_classtype == ad_CT_MONWIZARD) {
		ad_ThrowGib(4, 3 + rint(random()*3));
	}
	else if (self.ad_classtype == ad_CT_MONSHAM) {
		ad_ThrowGib(3, 1);
		ad_ThrowGib(4, 2 + rint(random()*4));
		ad_ThrowGib(5, 2 + rint(random()*4));
	}
	else if (self.ad_classtype == 	ad_CT_MONBOGLORD) {
		ad_ThrowGib(4, 5 + rint(random()*5));
		ad_ThrowGib(5, 10 + rint(random()*10));
	}
	else if (self.ad_classtype == 	ad_CT_MONMINOTAUR) {
		ad_ThrowGib(3, 1);
		ad_ThrowGib(4, 2 + rint(random()*4));
		ad_ThrowGib(5, 2 + rint(random()*4));
	}
	// Default gib setup
	else {
		// Is humanoid sound blocked?
		if (self.ad_blockudeath) {
			// Throw large slice gib
			ad_ThrowGib(3, rint(random()*2));
		}
		// Throw humanoid torso gib
		else if (random()<0.5) ad_ThrowGib(2, 1);
		// Regular gibs (4=small, 5=large)
		ad_ThrowGib(4, 3 + rint(random()*3));
		ad_ThrowGib(5, 1 + rint(random()*1));
	}				

	//----------------------------------------------------------------------
	// Throw head last because all previous gibs rely on the origin
	//----------------------------------------------------------------------
	if (self.ad_headmdl != "") {
		// If monster set for low velocity throw extra gibs instead
		if (self.max_health == ad_MON_NOGIBVELOCITY)
			ad_ThrowGib(4, rint(random()*4));
		// Throw a head gib instead of switching to one
		else ad_ThrowGib(25, 1);
	}
	// Finally hide monster
	ad_entity_hide (self);
};

//======================================================================
// Check health for gib condition
//======================================================================
void() ad_monster_check_gib =
{
	// There are always exceptions to the every rule!
	// Spawns=Explode, Wraith=Explode, Jim=Explode
	// SkullWiz=Fade away, Lost Souls=Explode
	if (self.ad_gibhealth == ad_MON_NEVERGIB) return;
	if (self.ad_touchedvoid) { ad_entity_hide(self); return; }

	// Can only gib a monster once!
	if (self.ad_gibbed) return;
	
	// Make sure gibondeath has gib velocity (health value)
	if (self.ad_gibondeath) self.health = self.ad_gibhealth;
	// Is it time to throw a gib party?
	if ( self.health < (self.ad_gibhealth + 1) || self.ad_gibondeath) {
		ad_monster_ThrowGib();
		ad_monster_gibrandomizer();
	}
};

//======================================================================
// Forward compiler reference
void(entity ad_targ, entity ad_attacker) ad_Killed;

//======================================================================
// Gib a body on the floor (special setup)
//======================================================================
void(entity ad_onflr, float ad_impactdmg) ad_monster_flrbody_gib =
{
	local entity ad_tself, ad_tother;
	
	ad_onflr.ad_bodyonflr = ad_string_null;	// no more body gibbing
	ad_tself = self; ad_tother = other;	// save self/other
	self = ad_onflr; other = ad_tself;	// switch around
	if (ad_onflr.ad_classgroup == ad_CG_ZOMBIE) {
		self.health = 0;
		ad_Killed(ad_onflr, ad_tself);
	}
	else {
		self.max_health = ad_MON_NOGIBVELOCITY; // use minimal velocity
		ad_monster_ThrowGib();			// throw parts
	}
	
	self = ad_tself; other = ad_tother;	// switch back
	ad_SpawnBlood (ad_onflr, ad_onflr.origin, '0 0 50', ad_impactdmg*4);
	if (ad_onflr.ad_bodyonflrtrig) ad_trigger_strs(ad_onflr.ad_bodyonflrtrig,self);
	// Hide/Remove original body/shadow
	ad_entity_hide(ad_onflr);
};