// AD's readme and docs/vr-port/CREDITS.md), my_progs/ai_pathcorner.qc, generated by Misc/quakevr/ad_import.py: every name
// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

//======================================================================
// Path_Corner FUNCTIONS
//======================================================================
float ad_PATHC_EXACT = 1;		// Exact route logic
float ad_PATHC_INSTANT = 2;	// Instantly move to this path_corner
float ad_PATHC_REVERSE = 4;	// Train direction is reversed at this corner
float ad_PATHC_NOPAUSE = 8;	// Train does not pause on this corner

float ad_PATHC_RESET = 15;		// Use to reset spawnflags

float ad_ARROW_PRIMARY = 1.5;	// Active route highlight
float ad_ARROW_GREEND = 0;
float ad_ARROW_BROWN = 1;
float ad_ARROW_GREENL = 2;
float ad_ARROW_WHITE = 3;
float ad_ARROW_RED   = 4;

float ad_PATHC_TARGET1 = 16;	// Has target been found
float ad_PATHC_TARGET2 = 32;	// Has target2 been found
float ad_PATHC_BACKLINK = 64;	// Backward path route
float ad_PATHC_DEADEND = 128;	// no targets found

float ad_STATE_ROUTE1 = 1;		// Route 1 is the priority (forward)
float ad_STATE_ROUTE2 = 2;		// Route 2 is the priority (forward)
float ad_STATE_ROUTE3 = 3;		// Route 3 is the priority (backward)
float ad_STATE_EXACT = 4;		// Switch to exact route selection
float ad_STATE_RANDOM = 5;		// Switch to random route selection

//======================================================================
/*ad:QUAKED path_corner (0.5 0.3 0) (-8 -8 -24) (8 8 48) EXACT INSTANT REVERSE NOPAUSE
Node based path routing system
-------- KEYS --------
targetname   : Name of current path corner
corner_event : Name of target(s) to trigger when used/touched
corner_route : Change path_corner route (1-3 routes, 4=exact, 5=random)
corner_switch: Change spawnflags REVERSE (-1=NO, 1=YES, 2=Toggle)
corner_pause : Change spawnflags NOPAUSE (-1=NO, 1=YES, 2=Toggle)
corner_pstate: Change passive state (-1=OFF, 1=ON, 2=TOGGLE)
state        : Starting route (1=forward, 2=alt forward, 3=backward)
target       : Targetname of FORWARD route
target2      : Alternative FORWARD route
targetback   : Override default BACKWARD route
wait   : fixed amount of time to pause at corner (=-1 stop)
delay  : random amount of time to pause at corner
alpha  : Override default for visual arrows (def=0.35)
speed  : Override default speed of func_train (def=100)
-------- SPAWNFLAGS --------
EXACT     : Exact route logic (def=random route choices)
INSTANT   : Move instantly to this corner if next destination
REVERSE   : Train direction is reversed for next corner
NOPAUSE   : Train does not pause on this path corner
-------- NOTES --------
Node based path routing system

======================================================================*/
entity(string ad_arrowmdl, vector ad_arroworg) ad_path_corner_spawnarrow =
{
	local entity ad_arrow;
	ad_arrow = spawn();
	ad_arrow.ad_classtype = ad_CT_ATTACHMENT;
	ad_arrow.movetype = ad_MOVETYPE_NONE;
	ad_arrow.solid = ad_SOLID_NOT;
	setmodel(ad_arrow, ad_arrowmdl);
	setorigin(ad_arrow, ad_arroworg);
	setsize(ad_arrow, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

	// If DP engine active remove particle shadow
	if (ad_engine == ad_ENG_DPEXT) ad_arrow.effects = ad_arrow.effects + ad_EF_NOSHADOW;

	return ad_arrow;
};

//----------------------------------------------------------------------
// Forward  - PATH_TARGET1  (self.attachment)
// Forward2 - PATH_TARGET2  (self.attackment2)
// Backward - PATH_BACKLINK (self.attachment3)
// PATHC_DEADEND = Back link is missing
// Original logic did not cope with broken or missing target/target2
// Moved red arrow updates to the end to catch all broken links
//----------------------------------------------------------------------
void() ad_path_corner_updatearrow =
{
	// ROUTE 2 (forward2) active
	if (self.spawnflags & ad_PATHC_TARGET2 && self.state == ad_STATE_ROUTE2) {
		if (self.ad_attachment) { self.ad_attachment.skin = ad_ARROW_GREENL; self.ad_attachment.alpha = self.alpha; }
		if (self.ad_attachment2) { self.ad_attachment2.skin = ad_ARROW_WHITE; self.ad_attachment2.alpha = self.alpha*ad_ARROW_PRIMARY; }
		if (self.ad_attachment3) { self.ad_attachment3.skin = ad_ARROW_GREEND; self.ad_attachment3.alpha = self.alpha; }
	}
	// ROUTE 3 (backward) active
	else if (self.spawnflags & ad_PATHC_BACKLINK && self.state == ad_STATE_ROUTE3) {
		if (self.ad_attachment) { self.ad_attachment.skin = ad_ARROW_GREEND; self.ad_attachment.alpha = self.alpha; }
		if (self.ad_attachment2) { self.ad_attachment2.skin = ad_ARROW_GREENL; self.ad_attachment2.alpha = self.alpha; }
		if (self.ad_attachment3) { self.ad_attachment3.skin = ad_ARROW_WHITE; self.ad_attachment3.alpha = self.alpha*ad_ARROW_PRIMARY; }
	}
	// ROUTE 1 (forward) active (default)
	else {
		if (self.ad_attachment) { self.ad_attachment.skin = ad_ARROW_WHITE; self.ad_attachment.alpha = self.alpha*ad_ARROW_PRIMARY; }
		if (self.ad_attachment2) { self.ad_attachment2.skin = ad_ARROW_GREENL; self.ad_attachment2.alpha = self.alpha; }
		if (self.ad_attachment3) { self.ad_attachment3.skin = ad_ARROW_GREEND; self.ad_attachment3.alpha = self.alpha; }
	}

	// Draw any broken/missing routes with RED arrows
	if (!(self.spawnflags & ad_PATHC_TARGET1) && self.ad_attachment) {
		self.ad_attachment.skin = ad_ARROW_RED; self.ad_attachment.alpha = self.alpha; }
	if (!(self.spawnflags & ad_PATHC_TARGET2) && self.ad_attachment2) {
		self.ad_attachment2.skin = ad_ARROW_RED; self.ad_attachment2.alpha = self.alpha; }
	if (!(self.spawnflags & ad_PATHC_BACKLINK) && self.ad_attachment3) {
		self.ad_attachment3.skin = ad_ARROW_RED; self.ad_attachment3.alpha = self.alpha; }
};

//----------------------------------------------------------------------
void() ad_path_corner_setuparrow =
{
	// Visual AI pathing only active in dev mode
	if (ad_query_configflag(ad_SVR_DEVHELPER)) return;

	// Setup default alpha for arrows
	if (!self.alpha) self.alpha = 0.35;
	
	// Draw back link arrow
	if (self.spawnflags & ad_PATHC_BACKLINK) {
		self.ad_attachment3 = ad_path_corner_spawnarrow( self.mdl, self.oldorigin+'0 0 -8');
		self.movedir = normalize(self.ad_movetarget3.oldorigin - self.oldorigin);
		self.ad_attachment3.angles = vectoangles(self.movedir);
	}
	// Missing backlink, this is a bad situation!
	// Highlight this problem with a pointing up RED arrow
	else {
		// There is no back link, so use forward target instead
		if (self.spawnflags & ad_PATHC_TARGET1) self.ad_oldenemy = self.ad_movetarget;
		else self.ad_oldenemy = self;
		
		self.ad_attachment3 = ad_path_corner_spawnarrow( self.mdl, self.oldorigin+'0 0 -8');
		self.movedir = normalize(self.ad_oldenemy.oldorigin - self.oldorigin);
		self.ad_attachment3.angles = vectoangles(self.movedir);
		makevectors(self.movedir);
		self.ad_attachment3.angles = self.ad_attachment3.angles + vectoangles(v_up);
	}
	
	// Draw route choice 1 (target)
	if (self.spawnflags & ad_PATHC_TARGET1) {
		self.ad_attachment = ad_path_corner_spawnarrow( self.ad_headmdl, self.oldorigin);
		self.movedir = normalize(self.ad_movetarget.oldorigin - self.oldorigin);
		self.ad_attachment.angles = vectoangles(self.movedir);
	}
	// Missing forward link (deadend)
	// Highlight this issue with a pointing up RED arrow
	else {
		// There is no forward link, so use back link instead
		if (self.spawnflags & ad_PATHC_BACKLINK) self.ad_oldenemy = self.ad_movetarget3;
		else self.ad_oldenemy = self;
		self.ad_attachment = ad_path_corner_spawnarrow( self.ad_headmdl, self.oldorigin);
		self.movedir = normalize(self.ad_oldenemy.oldorigin - self.oldorigin);
		self.ad_attachment.angles = vectoangles(self.movedir);
		makevectors(self.movedir);
		self.ad_attachment.angles = self.ad_attachment.angles + vectoangles(v_up);
	}
	
	// Draw route choice 2 (target2)
	if (self.spawnflags & ad_PATHC_TARGET2) {
		self.ad_attachment2 = ad_path_corner_spawnarrow( self.ad_headmdl, self.oldorigin);
		self.movedir = normalize(self.ad_movetarget2.oldorigin - self.oldorigin);
		self.ad_attachment2.angles = vectoangles(self.movedir);
	}
	
	// Update arrows if route logic active
	ad_path_corner_updatearrow();
};

//----------------------------------------------------------------------
void() ad_path_corner_setuptargets =
{
	local entity ad_fdest;
	
	// Reset primary, secondary and backlink target entities
	self.ad_movetarget = self.ad_movetarget2 = self.ad_movetarget3 = world;

	//------------------------------------------------------------
	// PRIMARY TARGET (target / self.movetarget)
	//------------------------------------------------------------
	if (self.target != "") {
		ad_fdest = find (world, targetname, self.target);
		while(ad_fdest) {
			if (ad_fdest.ad_classtype == ad_CT_PATHCORNER) {
				// Update (spawnflags) path_corner and save entity
				self.spawnflags = self.spawnflags | ad_PATHC_TARGET1;
				self.ad_movetarget = ad_fdest;
				ad_fdest = world; // Exit loop
			}
			// Keep searching for path_corner entity
			else ad_fdest = find(ad_fdest, targetname, self.target);
		}
	}
	//------------------------------------------------------------
	// SECONDARY TARGET (target2 / self.movetarget2)
	//------------------------------------------------------------
	if (self.ad_target2 != "") {
		ad_fdest = find (world, targetname, self.ad_target2);
		while(ad_fdest) {
			if (ad_fdest.ad_classtype == ad_CT_PATHCORNER) {
				// Update (spawnflags) path_corner and save entity
				self.spawnflags = self.spawnflags | ad_PATHC_TARGET2;
				self.ad_movetarget2 = ad_fdest;
				ad_fdest = world; // Exit loop
			}
			// Keep searching for path_corner entity
			else ad_fdest = find(ad_fdest, targetname, self.ad_target2);
		}
	}

	//------------------------------------------------------------
	// BACKLINK TARGET (targetback / self.movetarget3)
	//------------------------------------------------------------
	// Has the path corner back link override key been used?
	// If this override string does not exist, weird things will happen 
	if (self.ad_targetback != "") {
		ad_fdest = find (world, targetname, self.ad_targetback);
		while(ad_fdest) {
			// Update (spawnflags) path_corner and save entity
			if (ad_fdest.ad_classtype == ad_CT_PATHCORNER) {
				self.spawnflags = self.spawnflags | ad_PATHC_BACKLINK;
				self.ad_movetarget3 = ad_fdest;
				ad_fdest = world; // Exit loop
			}
			// Keep searching for path_corner entity
			else ad_fdest = find(ad_fdest, targetname, self.ad_targetback);
		}
	}
	else {
		// Setup back link name, if none exist use targetname
		self.ad_targetback = self.targetname;
		
		// Cycle through list for BACKLINK path_corner
		ad_fdest = find (world, target, self.ad_targetback);
		while(ad_fdest) {
			// Update (spawnflags) path_corner and save entity
			if (ad_fdest.ad_classtype == ad_CT_PATHCORNER) {
				self.spawnflags = self.spawnflags | ad_PATHC_BACKLINK;
				self.ad_movetarget3 = ad_fdest;
				ad_fdest = world; // Exit loop
			}
			// Keep searching for path_corner entity
			else ad_fdest = find(ad_fdest, target, self.ad_targetback);
		}
	}

	// Double check TARGET2 before declaring a deadend
	if ( !(self.spawnflags & ad_PATHC_BACKLINK) ) {
		ad_fdest = find (world, ad_target2, self.ad_targetback);
		while(ad_fdest) {
			if (ad_fdest.ad_classtype == ad_CT_PATHCORNER) {
				self.spawnflags = self.spawnflags | ad_PATHC_BACKLINK;
				self.ad_movetarget3 = ad_fdest;
				ad_fdest = world; // Exit loop
			}
			// Keep searching for path_corner entity
			else ad_fdest = find(ad_fdest, ad_target2, self.ad_targetback);
		}
	}

	// Bad situation : Found a path corner with no back-link
	// label as deadend (direction reverse) and circular link
	if ( !(self.spawnflags & ad_PATHC_BACKLINK) ) {
		dprint("\b[PATH_CORNER]\b ("); dprint(self.targetname);
		dprint(") - Deadend found\n");
		if (self.ad_movetarget) self.ad_movetarget3 = self.ad_movetarget;
		else self.ad_movetarget3 = self;
		self.spawnflags = self.spawnflags | ad_PATHC_DEADEND;
	}
	
	// Random time interval as this is not important
	// Generate developer arrow models on path_corner
	if (ad_developer > 0) {
		self.nextthink = time + 0.5 + random();
		self.think = ad_path_corner_setuparrow;
	}
	
};

//----------------------------------------------------------------------
// This is a TRIGGER entry point only!
//----------------------------------------------------------------------
void() ad_path_corner_use =
{
	// Change spawnflags NOPAUSE (-1=NO, 1=YES, 2=Toggle)
	if (other.ad_corner_pause) {
		// Store the parameter locally so it can modified
		self.ad_corner_pause = other.ad_corner_pause;
		if (self.ad_corner_pause == 2) {
			if (self.spawnflags & ad_PATHC_NOPAUSE) self.ad_corner_pause = 1;
			else self.ad_corner_pause = -1;
		}
		// The toggle state uses the on/off code by storing the value
		// locally and modifying it beforehand
		if (self.ad_corner_pause > 0) {
			if (self.spawnflags & ad_PATHC_NOPAUSE)
				self.spawnflags = self.spawnflags - ad_PATHC_NOPAUSE;
			self.wait = -1;
		}
		else if (self.ad_corner_pause < 0) {
			self.spawnflags = self.spawnflags | ad_PATHC_NOPAUSE;
			self.wait = 0;
		}
	}
		
	// Change spawnflags REVERSE (-1=NO, 1=YES, 2=Toggle)
	if (other.ad_corner_switch) {
		// Store the parameter locally so it can modified
		self.ad_corner_switch = other.ad_corner_switch;
		if (self.ad_corner_switch == 2) {
			if (self.spawnflags & ad_PATHC_REVERSE) self.ad_corner_switch = -1;
			else self.ad_corner_switch = 1;
		}
		// The toggle state uses the on/off code by storing the value
		// locally and modifying it beforehand
		if (self.ad_corner_switch > 0) {
			self.spawnflags = self.spawnflags | ad_PATHC_REVERSE;
		}
		else if (self.ad_corner_switch < 0) {
			if (self.spawnflags & ad_PATHC_REVERSE)
				self.spawnflags = self.spawnflags - ad_PATHC_REVERSE;
		}
	}

	// Change speed of train moving towards path_corner (default=100)
	if (other.ad_corner_speed > 0) self.speed = other.ad_corner_speed;

	// Changing routes?
	if (other.ad_corner_route) {
		// Double check that the routes exist before setting them
		if (other.ad_corner_route == ad_STATE_ROUTE1 && 
			self.spawnflags & ad_PATHC_TARGET1) self.state = ad_STATE_ROUTE1;
		else if (other.ad_corner_route == ad_STATE_ROUTE2 && 
			self.spawnflags & ad_PATHC_TARGET2) self.state = ad_STATE_ROUTE2;
		else if (other.ad_corner_route == ad_STATE_ROUTE3 && 
			self.spawnflags & ad_PATHC_BACKLINK) self.state = ad_STATE_ROUTE3;
		// If changing routing logic, make sure spawnflag is updated
		else if (other.ad_corner_route == ad_STATE_EXACT) {
			self.spawnflags = self.spawnflags | ad_PATHC_EXACT;
			self.state = ad_STATE_ROUTE1;
		}
		// When routing logic is changed, need to reset state
		else if (other.ad_corner_route == ad_STATE_RANDOM) {
			if (self.spawnflags & ad_PATHC_EXACT)
				self.spawnflags = self.spawnflags - ad_PATHC_EXACT;
			self.state = ad_STATE_ROUTE1;
		}
		dprint("Corner ("); dprint(self.targetname);
		dprint(") Route ("); dprint(ftos(self.state));
		dprint(")\n");
	}
	else {
		// Toggle route selection if EXACT routing logic is active
		// and the path corner has multiple routes available
		if (self.spawnflags & ad_PATHC_EXACT && self.spawnflags & ad_PATHC_TARGET2) {
			if (self.state == ad_STATE_ROUTE1) self.state = ad_STATE_ROUTE2;
			// Should not be cycled to backward route and switching
			// between forward routes only (1.7Patch 2 change)
			//else if (self.state == STATE_ROUTE2) self.state = STATE_ROUTE3;
			else self.state = ad_STATE_ROUTE1;
		}
	}

	// Visual AI pathing only active in dev mode
	if (ad_developer > 0) ad_path_corner_updatearrow();
};

//----------------------------------------------------------------------
void() ad_path_corner_stop =
{
	other.goalentity = other.ad_movetarget = world;
	other.ad_pausetime = time + ad_LARGE_TIMER;
	other.think = other.ad_th_stand;
	other.nextthink = time + 0.05;
};

//----------------------------------------------------------------------
void() ad_path_corner_touch =
{
	if (VR_AD_PathCornerTouch()) return;
	if (!(other.flags & ad_FL_MONSTER)) return;	// ONLY Monsters can use path corners
	if (other.health < 1) return;				// Dead things don't need path guidance
	if (other.enemy) return;					// In combat, no time to follow paths
	if (other.ad_movetarget != self) return;		// Suppose to follow this corner?

	// If ogre, play chainsaw drag sound (50% of the time)
	if (other.ad_classtype == ad_CT_MONOGRE || other.ad_classtype == ad_CT_MONHOGRE)
		if (random() > 0.5) sound (other, ad_CHAN_VOICE, "ogre/ogdrag.wav", 1, ad_ATTN_IDLE);

	// Fire any event targets (activator = monster)
	if (self.ad_corner_event) ad_trigger_strs(self.ad_corner_event,other);
	// Check if passive state switch active (-1=OFF, 1=ON, 2=TOGGLE)
	if (self.ad_corner_pstate != 0) {
		// Only use exact values (-1,1,2) no default/else functionality
		if (self.ad_corner_pstate == -1) ad_change_passivestate(other,0);
		else if (self.ad_corner_pstate == 1) ad_change_passivestate(other,1);
		else if (self.ad_corner_pstate == 2) ad_change_passivestate(other,2);
	}
	// Check if this path_corner is a dead end? (no target)
	if (self.spawnflags & ad_PATHC_DEADEND) ad_path_corner_stop();
	// Has this path corner been linked yet? Try again?
	if ( !(self.spawnflags & ad_PATHC_TARGET1) ) ad_path_corner_setuptargets();

	// Is there a target to move towards?
	if (self.spawnflags & ad_PATHC_TARGET1) {
		// Check for a second random path?
		if (self.spawnflags & ad_PATHC_TARGET2) {
			// Check route logic (only use forward routes)
			if (self.spawnflags & ad_PATHC_EXACT) {
				if (self.state == ad_STATE_ROUTE1) other.goalentity = self.ad_movetarget;
				else other.goalentity = self.ad_movetarget2;
			}
			else {
				// Removed random option, its not useful
				// Its better to use exact route changes
				// Default = random routes
				//if (random() < 0.5) other.goalentity = self.movetarget;
				//else other.goalentity = self.movetarget2;
			}
		}
		// Default, 1 path = 1 choice
		else other.goalentity = self.ad_movetarget;
		// Setup goal for monster to move toward
		other.ad_movetarget = other.goalentity;
		
		// Does the monster need to pause at current path_corner?
		if (self.wait < 0) ad_path_corner_stop();
		else if (self.wait > 0) {
			other.ad_pausetime = time + self.wait + random()*self.delay;
			other.think = other.ad_th_stand;
			other.nextthink = time + 0.05;
		}
		// no pause, turn and keep walking towards next goal
		else {
			other.ideal_yaw = vectoyaw(other.goalentity.origin - other.origin);
			other.ad_pausetime = 0;
		}
	}
	// No new target to follow, stand around
	else ad_path_corner_stop();
};

//----------------------------------------------------------------------
// Used by monsters, func_trains and tether system
//----------------------------------------------------------------------
void() ad_path_corner =
{
	// Really need to prevent path corners with no targetname
	// otherwise it will cause problems with linking later
	if (self.targetname == "") {
		dprint("\b[PATH_CORNER]\b Missing targetname!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	
	// Cache arrow models if devmode active
	if (ad_developer > 0) {
		self.ad_headmdl = ad_MODEL_CORNER1;	// Top of Arrow (forward)
		self.mdl = ad_MODEL_CORNER2;		// Bottom of Arrow (backward)
		precache_model(self.ad_headmdl);
		precache_model(self.mdl);
	}
	
	// Setup time delay at corner ( wait + delay*random() )
	if (self.wait == 0) self.wait = 0;
	if (self.delay <= 0) self.delay = 0;
	
	// Reset all path targets/entities, spawnflags (low 4 bits only)
	self.spawnflags = self.spawnflags & ad_PATHC_RESET;
	self.ad_movetarget = self.ad_movetarget2 = self.ad_movetarget3 = world;
	
	self.solid = ad_SOLID_TRIGGER;				// always touchable
	self.movetype = ad_MOVETYPE_NONE;			// Does not move
	self.ad_classtype = ad_CT_PATHCORNER;			// Self identification
	setsize (self, '-8 -8 -16', '8 8 16');	// Size of trigger
	self.touch = ad_path_corner_touch;			// Useable by monsters
	self.use = ad_path_corner_use;				// Used by trigger events
	
	// Work out which (random/toggle) route logic is active
	if (self.spawnflags & ad_PATHC_EXACT) {
		// If state is specified and outside range, reset
		if (self.state < ad_STATE_ROUTE1 || self.state > ad_STATE_ROUTE3)
			self.state = ad_STATE_ROUTE1;
	}
	else self.state = ad_STATE_ROUTE1;
	// Cannot start with route 2 (alt forward) if target2 is empty!?!
	if (self.state == ad_STATE_ROUTE2 && self.ad_target2 == "") self.state = ad_STATE_ROUTE1;

	// Many of the ID maps have path_corners buried in solid architecture
	// which makes it difficult to see where they are and impossible to draw
	// visual arrows on them.
	// 
	// This code checks for solid content and keeps nudging the
	// temporary origin upwards 8 units at a time (max 64 units)
	// If it cannot find any empty space above, it will give up and
	// use the original origin point instead
	//
	self.oldorigin = self.origin;
	if (pointcontents(self.oldorigin) == ad_CONTENT_SOLID) {
		self.lip = 8;
		while (self.lip > 0) {
			self.lip = self.lip - 1;
			self.oldorigin = self.oldorigin + '0 0 8';
			if (pointcontents(self.oldorigin) != ad_CONTENT_SOLID)
				self.lip = -1;
		}
	}
	// Origin is still in something solid, reset
	if (self.lip != -1) self.oldorigin = self.origin;

	// Check for alt corner speed (its really a duplicate of speed)
	if (self.ad_corner_speed > 0 && self.speed == 0)
		self.speed = self.ad_corner_speed;
	
	// Check for dead end path_corner
	if (self.target == "") self.spawnflags = self.spawnflags | ad_PATHC_DEADEND;

	// Allow 1 frame for path_corners to spawn
	// Got to start linking before func_train (2nd frame)
	self.think = ad_path_corner_setuptargets;
	self.nextthink = time + 0.1;
	
};
