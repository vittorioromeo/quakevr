// Charging attack B - single swing of flail
void() ad_dsergeant_char_b1 =[	$char_b1, ad_dsergeant_char_b2 ] {ad_ai_charge(23);
	ad_dsergeant_sword_sound();ad_CheckForSergeantCharge();};
void() ad_dsergeant_char_b2 =[	$char_b2, ad_dsergeant_char_b3 ] {ad_ai_charge(17);
	ad_monster_footstep(ad_FALSE);ad_CheckForSergeantCharge();};
void() ad_dsergeant_char_b3 =[	$char_b3, ad_dsergeant_char_b4 ] {ad_ai_charge(12);
	ad_CheckForSergeantCharge();};
void() ad_dsergeant_char_b4 =[	$char_b4, ad_dsergeant_char_b5 ] {ad_ai_charge(22);
	self.ad_meleecontact = ad_TRUE;ad_ai_meleesmash(20);ad_CheckForSergeantCharge();};
void() ad_dsergeant_char_b5 =[	$char_b5, ad_dsergeant_char_b6 ] {ad_ai_charge(18);
	ad_monster_footstep(ad_FALSE);ad_CheckForSergeantCharge();};
void() ad_dsergeant_char_b6 =[	$char_b6, ad_dsergeant_char_b1 ] {ad_ai_charge(8);
	ad_CheckForSergeantCharge();};

