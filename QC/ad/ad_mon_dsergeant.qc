//===========================================================================
void() ad_CheckForSergeantCharge =
{
	self.ad_attack_timer = time + 0.3;
	self.height = fabs(self.origin_z - self.enemy.origin_z);
	
	// If within melee range, go straight to melee
	if (ad_ai_checkmelee(ad_MONAI_MELEEFRONT,ad_FALSE)) {
		self.ad_attack_state = ad_AS_MELEE;
		self.think = self.ad_th_melee;
	}
	// Is the player visible or there is a large height difference?
	else if (ad_visblocked(self.enemy) || self.height > ad_MONAI_CHARGEZAXIS) {
		self.ad_attack_state = ad_AS_STRAIGHT;
		self.think = ad_dsergeant_run1;
	}
};

