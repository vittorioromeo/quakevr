void()	ad_dsergeant_stand9	=[	$stand9,	ad_dsergeant_stand10	] {ad_ai_stand();};
void()	ad_dsergeant_stand10	=[	$stand10,	ad_dsergeant_stand11	] {ad_ai_stand();};
void()	ad_dsergeant_stand11	=[	$stand11,	ad_dsergeant_stand12	] {ad_ai_stand();};
void()	ad_dsergeant_stand12	=[	$stand12,	ad_dsergeant_stand1	] {
	self.ad_idlebusy = ad_FALSE; 
	if (random() < ad_MON_IDLE_ANIMATION) {
		self.ad_idlebusy = ad_TRUE; 
		// Make sure the idle animations don't repeat in a row
		self.lefty = self.lip;
		while (self.lefty == self.lip) { self.lefty = rint(random()*4);}
		self.lip = self.lefty;
		if (self.lip < 1) self.think = ad_dsergeant_standD1;				// Big Sigh
		else if (self.lip < 2) self.think = ad_dsergeant_standC1;	// Look at weapon
		else if (self.lip < 3) self.think = ad_dsergeant_standA1;	// Shoulder hunch
		else self.think = ad_dsergeant_standB1;											// Look around
	}
	ad_ai_stand();};

