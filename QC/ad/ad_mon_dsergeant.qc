//----------------------------------------------------------------------
void() ad_dsergeant_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "hknight/death1.wav", 1, ad_ATTN_NORM);
		if (random() > 0.5) ad_dsergeant_die1 ();
		else ad_dsergeant_dieb1 ();
	}
};

//============================================================================
void() ad_dsergeant_sword_sound =
{
	self.ad_meleecontact = ad_TRUE;
	self.lip = random();
	if (self.lip < 0.25) sound (self, ad_CHAN_WEAPON, "weapons/sword1a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.5) sound (self, ad_CHAN_WEAPON, "weapons/sword2a.wav", 1, ad_ATTN_NORM);
	else if (self.lip < 0.75) sound (self, ad_CHAN_WEAPON, "weapons/sword1b.wav", 1, ad_ATTN_NORM);
	else sound (self, ad_CHAN_WEAPON, "weapons/sword2b.wav", 1, ad_ATTN_NORM);
};

//============================================================================
void(float ad_soundtype) ad_dsergeant_grunt_sound =
{
	if (ad_soundtype == ad_DSERG_SOUND_SIDESWING)
		sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt2.wav", 1, ad_ATTN_NORM);
	else if (ad_soundtype == ad_DSERG_SOUND_OVERSMASH)
		sound (self, ad_CHAN_WEAPON, "dknight/dfury_leap.wav", 1, ad_ATTN_NORM);
	else {
		self.ad_weaponswitch = 0.6 + random()*0.4;
		if (random() < 0.5) sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt3.wav", self.ad_weaponswitch, ad_ATTN_NORM);
		else sound (self, ad_CHAN_WEAPON, "dknight/dfury_grunt4.wav", self.ad_weaponswitch, ad_ATTN_NORM);
	}
};

/*======================================================================
QUAKED monster_dsergeant (1 0 0) (-16 -16 -24) (16 16 40) Ambush
======================================================================*/
void() ad_monster_dsergeant =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_dsergeant.mdl";			// Blue badass!
	self.ad_headmdl = "progs/h_dknight.mdl";
	self.ad_gib1mdl = "progs/w_blueflail.mdl";			// Unique weapon
	self.ad_gib2mdl = "progs/gib_knfoot_l.mdl";		// left foot
	self.ad_gib3mdl = "progs/gib_knfoot_r.mdl";		// right foot

	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_SERG);
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);

	self.ad_gib2skin = self.ad_gib3skin = 3;				// Sergeant skin
	self.ad_gib1sound = ad_GIB_IMPACT_CHAIN;

	self.ad_idle_sound = "hknight/idle.wav";
	precache_sound (self.ad_idle_sound);

	// Special extra sounds
	precache_sound ("dknight/dserg_hbreath.wav");	// Special long sigh (idle animation)
	precache_sound ("dknight/dserg_magic.wav");		// New Spike ball launch sound
	precache_sound ("hknight/death1.wav");
	self.ad_pain_sound = "hknight/pain1.wav";
	precache_sound (self.ad_pain_sound);

	// Jingle, Jangle of the flail chain
	self.ad_sight_sound = "dknight/dserg_sight.wav";
	precache_sound (self.ad_sight_sound);
	
	// Heavy thud sound	
	self.ad_meleehitsound = ad_GIB_SOUND_HEAVY2;
	precache_sound (self.ad_meleehitsound);

	// New sword sweep/slash sounds
	precache_sound ("weapons/sword1a.wav");
	precache_sound ("weapons/sword1b.wav");
	precache_sound ("weapons/sword2a.wav");
	precache_sound ("weapons/sword2b.wav");

	// New grunt sounds during combat
	precache_sound ("dknight/dfury_grunt2.wav");
	precache_sound ("dknight/dfury_grunt3.wav");
	precache_sound ("dknight/dfury_grunt4.wav");
	precache_sound ("dknight/dfury_leap.wav");

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_SHALGRN);	// Green voreball
	}

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TALL;
	if (self.health < 1) self.health = 400;		// Shalrath level
	self.ad_gibhealth = -60;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 80;				// Take a lot to go into pain
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_pain_timeout = 2;				// Shambler like pain level
	if (self.ad_infightextra <= 0) self.ad_infightextra = 2; // Double damage to other monsters
	self.ad_steptype = ad_FS_TYPEHEAVY;		// Heavy Player feet
	self.ad_meleecontact = ad_FALSE;			// Smash contact
	self.ad_meleerange = ad_MONAI_MELEEFRONT;	// Smash attack
	self.ad_attack_offset = '0 0 10';
	self.ad_deathstring = " was crushed by a Blue Flail Knight\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_DSergeantCheckAttack;
	self.ad_th_stand = ad_dsergeant_stand1;
	self.ad_th_walk = ad_dsergeant_walk1;
	self.ad_th_run = ad_dsergeant_run1;
	self.ad_th_melee = ad_dsergeant_melee;
	self.ad_th_missile = ad_dsergeant_magicc1;
	self.ad_th_pain = ad_dsergeant_pain;
	self.ad_th_die = ad_dsergeant_die;
	self.ad_th_charge = ad_dsergeant_charging;
	
	self.ad_meleeattack = rint(random()*3);	// randomize last melee attack

	self.ad_classtype = ad_CT_MONDSERG;
	self.ad_classgroup = ad_CG_DCAPTAIN;
	self.ad_classmove = ad_MON_MOVEWALK;
	
	ad_monster_start();
};
