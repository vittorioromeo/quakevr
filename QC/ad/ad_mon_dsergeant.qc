//----------------------------------------------------------------------
void() ad_dsergeant_melee =
{
	self.ad_meleeattack = random();
	if (self.ad_meleeattack < 0.4) ad_dsergeant_slice1 ();
	else if (self.ad_meleeattack < 0.9) ad_dsergeant_smash1 ();
	else ad_dsergeant_watk1 ();
};

//===========================================================================
// Death Sergeant Homing Missile Attack
//===========================================================================
void() ad_SergMissile =
{
	if (!self.enemy) return;
	if (self.health < 1) return;
	// Removing a fired homing missiles looks weird
	//if (!visxray(self.enemy, self.attack_offset, '0 0 10', FALSE)) return;

	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	sound (self, ad_CHAN_WEAPON, "dknight/dserg_magic.wav", 1, ad_ATTN_NORM);
	self.ad_attack_speed = ad_SPEED_SERGMISSILE + (ad_skill * ad_SPEED_SERGSKILL);
	ad_Launch_HomingMissile (self.ad_attack_offset, '0 0 10', ad_CT_PROJ_SERG, self.ad_attack_speed);
};

//----------------------------------------------------------------------
// Hell Knight - 11 frames / Death Knight - 14 frames (skipped 1, 10,14)
// Death Knight frames trimmed down to match Hell Knight (damage ratio)
// Block pain function from interrupting magic attack
void()	ad_dsergeant_magicc1 =[	$magicc2,	ad_dsergeant_magicc2	] {ad_ai_face();
	ad_SUB_AttackFinished (2 + random()*2);
	self.ad_pain_finished = time + 1;
};
