void() ad_golem_stomp24 = [ $stomp24, ad_golem_run1 ] {
	ad_golem_footstomp(); ad_monster_footstep(ad_FALSE);
	// Double check enemy is still alive?
	// Make sure golem can do range attacks (melee only ver exists)
	if (self.enemy.health > 1 && !(self.spawnflags & ad_MON_GOLEM_MELEEONLY)) {
		// If the enemy is visible, quickly go for range attack
		if (!ad_visblocked_wide(self.enemy, '0 0 34', '0 0 24')) {
			ad_SUB_AttackFinished (2 + 2*random());
			self.think = self.ad_th_missile;
		}
	}
};


//----------------------------------------------------------------------
void() ad_golem_melee =
{
	if (self.enemy.flags & ad_FL_MONSTER) ad_golem_knock1();
	else {
		self.ad_meleeattack = random();
		if (self.ad_meleeattack < 0.2) ad_golem_knock1();
		else if (self.ad_meleeattack < 0.6) ad_golem_punch1();
		else ad_golem_pound1();
	}
}

//============================================================================
// RANGE - ROCK STORM from Torso
//============================================================================
void() ad_golem_rockstorm = 
{
	local float ad_shotcount, ad_zpart;
	local vector ad_org, ad_dir, ad_yrand, ad_zrand;

	if (!self.enemy) return;
	if (self.health < 1) return;

	// Make sure facing the right direction
	ad_ai_face();
	makevectors(self.angles);

	// Spawn a mist of particles where projectiles came from
	ad_org = self.origin + v_forward*20;
	ad_zpart = 25 + rint(random()*25);
	ad_particle_explode(ad_org, ad_zpart, 2, ad_PARTICLE_BURST_WHITE, ad_PARTICLE_BURST_UPWARD);

	// Randomize quantity each time called
	if (random() < 0.5) ad_shotcount = 2;
	else ad_shotcount = 3;

	while (ad_shotcount > 0) {
		// Randomly spawn projectiles from golems chest
		ad_yrand = (ad_crandom()*30)*v_right;
		ad_zrand = (ad_crandom()*30)*v_up;
		ad_org = self.origin + ad_attack_vector(self.ad_attack_offset) + ad_yrand + ad_zrand;

		// Straight line velocity from source to target
		ad_dir = (self.enemy.origin - ad_org) + (v_right*(ad_crandom()*50));
		ad_dir = normalize (ad_dir);

		// Variable speed based on skill level with extra random spice
		self.ad_attack_speed = ad_SPEED_GOLEMSPIKE + (ad_skill * ad_SPEED_GOLEMSKILL) + random()*10;
		ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_GROCK, self.ad_attack_speed);
		ad_shotcount = ad_shotcount - 1;
	}
};

