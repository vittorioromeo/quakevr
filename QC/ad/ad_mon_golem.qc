//----------------------------------------------------------------------
void() ad_golem_wakeup =
{
	// Check for sudden death!
	if (self.health < 0) return;
	
	// Only call wakeup function once
	self.use = ad_SUB_Null;
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_SUB_Null;
	self.skin = 0;	// Glowing eyes!
	ad_golem_wake1();
};

//----------------------------------------------------------------------
void() ad_golem_statue =
{
	local float ad_targ_angle, ad_new_frame;

	// Check for sudden death!
	if (self.health < 0) return;
	
	if (random() < ad_MON_IDLE_SOUND && self.pos1_z > 1) {
		ad_new_frame = ad_TRUE;
		self.ad_oldenemy = checkclient();
		if (self.ad_oldenemy.flags & ad_FL_CLIENT) {
			ad_targ_angle  = ad_viewangle(self.origin, self.ad_oldenemy.origin, 0, ad_TRUE, self.ad_oldenemy.v_angle_y);
			if (ad_targ_angle < 135 || ad_targ_angle > 225) ad_new_frame = ad_FALSE;
		}
		self.lip = self.pos1_x + rint(random()*self.pos1_z);
		if (ad_new_frame) {
			sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
			self.frame = self.lip;
		}
	}
	
 	self.think = ad_golem_statue;
 	self.nextthink = time + 5 + random()*5;
};

/*======================================================================
QUAKED monster_golem (1 0.2 0) (-16 -16 -24) (16 16 24)
======================================================================*/
void() ad_monster_golem =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_golem.mdl";
	precache_model (self.mdl);
	precache_model (ad_MODEL_PROJ_RINGSHOCK);
	precache_model (ad_MODEL_PROJ_GROCK1);
	precache_model (ad_MODEL_PROJ_GROCK2);
	
	self.ad_gibtype = ad_GIBTYPE_STONE;		// Stoney gibs!
	self.ad_gib1mdl = ad_MODEL_PROJ_GROCK1;	// small golem rock
	self.ad_gib2mdl = ad_MODEL_PROJ_GROCK2;	// medium golem rock
	self.ad_gib1frame = self.ad_gib2frame = 9;

	// Idle1a-1b (long sound) idle2a-2b (short sound)
	self.ad_idle_sound = "golem/idle1a.wav";
	self.ad_idle_sound2 = "golem/idle1b.wav";
	self.ad_idle_soundcom = "golem/idle2a.wav";
	self.ad_idle_soundcom2 = "golem/idle2b.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);
	precache_sound (self.ad_idle_soundcom2);
	
	// Break free of statue pose
	precache_sound ("golem/wakestatue.wav");
	
	// Several melee smack sounds and giant ground slam
	precache_sound ("golem/melee_swipe.wav");
	precache_sound ("golem/melee_punch.wav");
	precache_sound ("golem/melee_pound.wav");
	precache_sound ("golem/groundslam.wav");
	
	// Rockstorm - range attack
	precache_sound ("golem/rockstorm.wav");
	precache_sound (ad_SOUND_IMP_ROCK1);
	precache_sound (ad_SOUND_IMP_ROCK2);
	precache_sound (ad_SOUND_IMP_ROCK3);
	precache_sound (ad_SOUND_IMP_ROCK4);
	
	self.ad_pain_sound = "golem/pain1.wav";
	self.ad_pain_sound2 = "golem/pain2.wav";
	precache_sound (self.ad_pain_sound);
	precache_sound (self.ad_pain_sound2);
	precache_sound ("golem/death.wav");

	// Roar!
	self.ad_sight_sound = "golem/sight.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;			// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;	// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_GOLEM;
	if (self.health < 1) self.health = 500;
	self.ad_gibhealth = -60;			// Same as shambler
	self.ad_gibbed = ad_FALSE;			// Still in one piece
	self.ad_pain_flinch = 200;			// Demon level
	self.ad_pain_longanim = ad_FALSE;		// resistant to shadow axe
	self.ad_pain_timeout = 2;			// Does not repeat pain
	self.ad_infightextra = 3;			// Triple damage to other monsters
	self.ad_steptype = ad_FS_TYPEGIANT;	// Giant sound
	self.ad_blockudeath = ad_TRUE;		// No humanoid death
	self.ad_bleedcolour = 16;			// Brown dust/dirt
	self.ad_no_liquiddmg = ad_TRUE;		// Immune to slime/lava
	self.ad_meleerange = ad_MONAI_MELEEGOLEM;
	self.ad_attack_offset = '10 0 30';		// Rock storm
	self.ad_poisonous = ad_FALSE;				// Stone is not poisonous
	self.ad_deathstring = " was crushed by a Golem\n";
	
	self.ad_th_checkattack = ad_GolemCheckAttack;
	self.ad_th_die = ad_golem_die;

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = 0; self.ad_resist_nails = 0.5;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	self.ad_reflectnails = ad_TRUE;		// Reflect nail projectiles

	//----------------------------------------------------------------------
	// Detect statues and setup different parameters
	// Tougher skin, less pain, heavy feet etc	
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_STATUE) {
		// statues can change position when the player is not looking
		// Specify a start/finish frame using pos1 or use frame
		if (!self.pos1_x) {
			self.pos1_x = $magic1;		// Default pose (wakeup)
			self.pos1_y = $magic24;
		}
		// A frame has been specified, create a small range from that
		if (self.frame > 0) {
			self.pos1_x = self.pos1_y = self.frame;
		}
		// Work out range, make sure no negative values
		self.pos1_z = fabs(self.pos1_y - self.pos1_x);
		self.frame = self.pos1_x;		// Setup frame / pose
		
		self.ad_spawnstatue = ad_TRUE;		// Start as a statue
		self.ad_th_stand = ad_golem_statue;	// Stone idle sound
		self.ad_think1 = ad_golem_wakeup;		// Wakeup statue angry at player
		self.skin = 1;					// Statue skin (+grey, no eyes)
	}
	else {
		self.ad_th_stand = ad_golem_stand1;
		self.ad_th_walk = ad_golem_walk1;
		self.ad_th_run = ad_golem_run1;
		self.ad_th_melee = ad_golem_melee;
		// Check for melee + stomp attack only version
		if (!(self.spawnflags & ad_MON_GOLEM_MELEEONLY)) 
			self.ad_th_missile = ad_golem_magic1;
		self.ad_th_slide = ad_golem_stomp1;
		self.ad_th_pain = ad_golem_pain;
	}
		
	self.ad_classtype = ad_CT_MONGOLEM;
	self.ad_classgroup = ad_CG_STONE;
	self.ad_classmove = ad_MON_MOVEWALK;

	ad_monster_start();
};