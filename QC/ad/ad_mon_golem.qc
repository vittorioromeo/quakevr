void() ad_golem_knock1 = [ $knock1, ad_golem_knock2 ] {ad_golem_mcharge(5);};
void() ad_golem_knock2 = [ $knock2, ad_golem_knock3 ] {ad_golem_mcharge(6);};
void() ad_golem_knock3 = [ $knock3, ad_golem_knock4 ] {ad_golem_mcharge(7);};
