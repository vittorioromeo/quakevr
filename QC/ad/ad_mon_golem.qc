//----------------------------------------------------------------------
void() ad_golem_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	
	// Spawn some extra rubble before dying
	ad_SpawnProjectileSmoke(self.origin, 200, 50, 150);
	ad_SpawnProjectileSmoke(self.origin, 300, 50, 150);
	ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "golem/death.wav", 1, ad_ATTN_NORM);
		ad_golem_death1 ();
	}
};

//============================================================================
// Wakeup From Statue form
//============================================================================
void() ad_golem_birth = {
	if (random() < 0.8) ad_SpawnProjectileSmoke(self.origin, 200, 50, 250);
	self.nextthink = time + 0.05;
};

//----------------------------------------------------------------------
void() ad_golem_wakefinished =
{
	// No longer need statue spawnflag, remove it
	if (self.spawnflags & ad_MON_STATUE) 
		self.spawnflags = self.spawnflags - ad_MON_STATUE;
	self.ad_spawnstatue = ad_FALSE;		// No longer stationary

	self.ad_th_stand = ad_golem_stand1;	// Idling on feet
	self.ad_th_walk = ad_golem_walk1;		// Walking
	self.ad_th_run = ad_golem_run1;		// Running
	self.ad_th_melee = ad_golem_melee;	// Fist attack
	// Check for melee + stomp attack only version
	if (!(self.spawnflags & ad_MON_GOLEM_MELEEONLY)) 
		self.ad_th_missile = ad_golem_magic1;
	self.ad_th_slide = ad_golem_stomp1;	// Floor stomp
	self.ad_th_pain = ad_golem_pain;		// Stumble and pain
	self.ad_th_die = ad_golem_die;		// Face meets floor
	self.takedamage = ad_DAMAGE_AIM;	// Can receive damage
	ad_monster_targets();				// Check for targets
	ad_golem_birth();					// more rubble
};

