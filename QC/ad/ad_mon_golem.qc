void() ad_golem_ai_walk = {
	if (self.frame == $walk1 || self.frame == $walk17)
		{ ad_ai_walk(0); ad_monster_footstep(ad_FALSE); }
	else if (self.frame == $walk2 || self.frame == $walk18) ad_ai_walk(1);
	else ad_ai_walk(2); 
	self.nextthink = time + 0.05;
	if (self.frame == $walk8 || self.frame == $walk25) ad_monster_idle_sound();
};

