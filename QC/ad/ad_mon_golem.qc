void() ad_golem_knock12 = [ $knock12, ad_golem_knock13 ] {ad_golem_mcharge(5);
	sound (self, ad_CHAN_VOICE, "golem/melee_swipe.wav", 1, ad_ATTN_IDLE);};
void() ad_golem_knock13 = [ $knock13, ad_golem_knock14 ] {ad_golem_mcharge(4);};
void() ad_golem_knock14 = [ $knock14, ad_golem_knock15 ] {ad_golem_mcharge(3);};
void() ad_golem_knock15 = [ $knock15, ad_golem_knock16 ] {ad_golem_mcharge(2);};
void() ad_golem_knock16 = [ $knock16, ad_golem_knock17 ] {ad_golem_mcharge(1);
	self.ad_meleehitsound = "golem/melee_punch.wav";
	self.ad_meleecontact = ad_TRUE;ad_ai_meleesmash(30);
	// If punch made contact, lift the enemy off ground
	if (self.ad_meleecontact == ad_FALSE) {
		self.pos1 = self.enemy.origin - self.origin;
		self.pos1_z = 0;
		self.pos1 = normalize(self.pos1);
		self.enemy.velocity = self.enemy.velocity + self.pos1 * 400;
		self.enemy.velocity_z = self.enemy.velocity_z + 250;
		self.enemy.flags = self.enemy.flags - (self.enemy.flags & ad_FL_ONGROUND);
	}
	self.ad_meleecontact = ad_FALSE;
};
void() ad_golem_knock17 = [ $knock17, ad_golem_knock18 ] {ad_golem_mcharge(1);};
void() ad_golem_knock18 = [ $knock18, ad_golem_knock19 ] {ad_golem_mcharge(2);};
void() ad_golem_knock19 = [ $knock19, ad_golem_knock20 ] {ad_golem_mcharge(3);};
void() ad_golem_knock20 = [ $knock20, ad_golem_knock21 ] {ad_golem_mcharge(4);};
void() ad_golem_knock21 = [ $knock21, ad_golem_knock22 ] {ad_golem_mcharge(5);};
void() ad_golem_knock22 = [ $knock22, ad_golem_knock23 ] {ad_golem_mcharge(5);};
void() ad_golem_knock23 = [ $knock23, ad_golem_knock24 ] {ad_golem_mcharge(5);};
void() ad_golem_knock24 = [ $knock24, ad_golem_run1 ] {
	ad_golem_mcharge(5); 
	// Make sure golem can do range attacks (melee only ver exists)
	if (self.enemy.health > 1 && !(self.spawnflags & ad_MON_GOLEM_MELEEONLY)) {
		// If the enemy is visible, quickly go for range attack
		if (!ad_visblocked_wide(self.enemy, '0 0 34', '0 0 24')) {
			ad_SUB_AttackFinished (2 + 2*random());
			self.think = self.ad_th_missile;
		}
	}
};

//----------------------------------------------------------------------
void() ad_golem_footstomp = {self.nextthink = time + 0.05;};

void() ad_golem_stomp1 = [ $stomp1, ad_golem_stomp2 ] {ad_golem_footstomp();
	self.ad_pain_finished = time + self.ad_pain_timeout;};
void() ad_golem_stomp2 = [ $stomp2, ad_golem_stomp3 ] {ad_golem_footstomp();
	sound (self, ad_CHAN_VOICE, self.ad_sight_sound, 1, ad_ATTN_IDLE);};
