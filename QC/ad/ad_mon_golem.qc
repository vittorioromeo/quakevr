void() ad_golem_ai_run = {
	if (self.frame == $run1 || self.frame == $run13)
		{ ad_ai_run(0); ad_monster_footstep(ad_FALSE); }
	else if (self.frame == $run2 || self.frame == $run14) ad_ai_run(3);
	else ad_ai_run(5); 
	self.nextthink = time + 0.05;
	if (self.frame == $run7 || self.frame == $run18) ad_monster_idle_sound();
};

