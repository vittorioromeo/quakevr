// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*==============================================================================
EEL by Rogue Entertainment
==============================================================================*/
$frame eswim1 eswim2 eswim3 eswim4 eswim5 eswim6

$frame edeath1 edeath2 edeath3 edeath4 edeath5 edeath6 edeath7 edeath8
$frame edeath9 edeath10 edeath11 edeath12 edeath13 edeath14 edeath15

float ad_EEL_STAND = 1;
float ad_EEL_WALK = 2;
float ad_EEL_RUN = 4;

//=============================================================================
void() ad_eel_swim = {
	// Do nothing if dead
	if (self.health < 1) return;
	
	self.skin = 0;		// Reset skin if come from combat
	self.nextthink = time + 0.1;
	if (self.ad_walkframe == 1) ad_monster_idle_sound();

	// Keep moving the animation frame forward
	self.ad_walkframe = self.ad_walkframe + 1;
	if (self.ad_walkframe > 5) self.ad_walkframe = 0;
	self.frame = $eswim1 + self.ad_walkframe;
	
	if (self.state == ad_EEL_STAND) ad_ai_stand();
	else if (self.state == ad_EEL_WALK) ad_ai_walk(6);
	else ad_ai_run(10);
};

//----------------------------------------------------------------------
void() ad_eel_stand = [ $eswim1, ad_eel_swim ] {
	self.ad_walkframe = 0; self.state = ad_EEL_STAND; ad_eel_swim();};
void() ad_eel_walk = [ $eswim1, ad_eel_swim ] {
	self.ad_walkframe = 0; self.state = ad_EEL_WALK; ad_eel_swim();};
void() ad_eel_run = [ $eswim1, ad_eel_swim ] {
	self.ad_walkframe = 0; self.state = ad_EEL_RUN; ad_eel_swim();};

//============================================================================
// RANGE - Plasma from mouth
//============================================================================
void() ad_eel_plasma =
{
	if (VR_AimCone_Wait(ad_eel_plasma, VR_AIM_NARROW)) return; // AD support: aim cone: far off its facing it waits, turning (vr_aimcone.qc)

	local vector ad_org, ad_dir;

	// Check if can fire bolt of plasma
	if (ad_visblocked_wide(self.enemy, self.ad_attack_offset, '0 0 0')) return;	
	
	self.effects = self.effects | ad_EF_MUZZLEFLASH;
	self.ad_attack_speed = ad_SPEED_EELBOLT + (ad_skill * ad_SPEED_EELSKILL);

	makevectors (self.angles);
	ad_org = self.origin + ad_attack_vector(self.ad_attack_offset);
	ad_dir = normalize(self.enemy.origin - self.origin);

	ad_launch_plasma(ad_org, ad_dir, ad_CT_MONEEL, self.ad_attack_speed);
};

//----------------------------------------------------------------------
void() ad_eel_attack1 = [ $eswim1, ad_eel_attack2 ] {self.skin = 1;ad_ai_face();
	sound (self, ad_CHAN_VOICE, "eel/attack1.wav", 1, ad_ATTN_NORM);};
void() ad_eel_attack2 = [ $eswim2, ad_eel_attack3 ] {self.skin = 2;ad_ai_face();
	self.effects = self.effects | ad_EF_MUZZLEFLASH;};
void() ad_eel_attack3 = [ $eswim3, ad_eel_attack4 ] {self.skin = 3;ad_ai_face();};
void() ad_eel_attack4 = [ $eswim4, ad_eel_attack5 ] {self.skin = 4;ad_ai_face();
	self.effects = self.effects | ad_EF_MUZZLEFLASH;};
void() ad_eel_attack5 = [ $eswim5, ad_eel_attack6 ] {self.skin = 5;ad_ai_face();};
void() ad_eel_attack6 = [ $eswim6, ad_eel_attack7 ] {
	self.skin = 4; ad_ai_face(); ad_eel_plasma();};
void() ad_eel_attack7 = [ $eswim1, ad_eel_attack8 ] {self.skin = 5;};
void() ad_eel_attack8 = [ $eswim2, ad_eel_attack9 ] {self.skin = 4;};
void() ad_eel_attack9 = [ $eswim3, ad_eel_attack10 ] {self.skin = 3;};
void() ad_eel_attack10 = [ $eswim4, ad_eel_attack11 ] {self.skin = 2;};
void() ad_eel_attack11 = [ $eswim5, ad_eel_attack12 ] {self.skin = 1;ad_ai_face();};
void() ad_eel_attack12 = [ $eswim6, ad_eel_run ] {self.skin = 0;ad_ai_face();};

//=============================================================================
// Pain & Death
//=============================================================================
void() ad_eel_pain1 = [ $edeath1, ad_eel_pain2] {};
void() ad_eel_pain2 = [ $edeath2, ad_eel_pain3] {};
void() ad_eel_pain3 = [ $edeath3, ad_eel_pain4] {};
void() ad_eel_pain4 = [ $edeath4, ad_eel_pain5] {};
void() ad_eel_pain5 = [ $edeath3, ad_eel_pain6] {};
void() ad_eel_pain6 = [ $edeath2, ad_eel_pain7] {};
void() ad_eel_pain7 = [ $edeath1, ad_eel_run] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_eel_pain =
{
	// Reset combat skin
	self.skin = 0;

	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) ad_eel_pain1();
	}
};

//=============================================================================
void() ad_eel_die1 = [ $edeath1, ad_eel_die2 ] {};
void() ad_eel_die2 = [ $edeath2, ad_eel_die3 ] {ad_monster_check_gib();};
void() ad_eel_die3 = [ $edeath3, ad_eel_die4 ] {ad_monster_check_gib();self.solid = ad_SOLID_NOT;};
void() ad_eel_die4 = [ $edeath4, ad_eel_die5 ] {
	// make sure the eel drops to the ground
	self.movetype = ad_MOVETYPE_TOSS;
	self.velocity_z = 10 + random()*10;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
};
void() ad_eel_die5 = [ $edeath5, ad_eel_die6 ] {};
void() ad_eel_die6 = [ $edeath6, ad_eel_die7 ] {};
void() ad_eel_die7 = [ $edeath7, ad_eel_die8 ] {};
void() ad_eel_die8 = [ $edeath8, ad_eel_die9 ] {};
void() ad_eel_die9 = [ $edeath9, ad_eel_die10 ] {};
void() ad_eel_die10 = [ $edeath10, ad_eel_die11 ] {};
void() ad_eel_die11 = [ $edeath11, ad_eel_die12 ] {};
void() ad_eel_die12 = [ $edeath12, ad_eel_die13 ] {};
void() ad_eel_die13 = [ $edeath13, ad_eel_die14 ] {};
void() ad_eel_die14 = [ $edeath14, ad_eel_die15 ] {ad_monster_death_postcheck();};
void() ad_eel_die15 = [ $edeath15, ad_eel_die15 ] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------
void() ad_eel_die =
{
	// Reset combat skin
	self.skin = 0;
	
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		// reduce self gravity to pretend to slowly sink
		if (pointcontents(self.origin) == ad_CONTENT_WATER) self.gravity = 0.25;

		sound (self, ad_CHAN_BODY, "eel/death1.wav", 1, ad_ATTN_NORM);

		// Death animation not at bottom of bounding box
		self.ad_bbmins = '-12 -12 -1';
		self.ad_bbmaxs = '12 12 12';
		setsize(self, self.ad_bbmins, self.ad_bbmaxs);
		
		// With the bounding box changed for the animation the
		// gib system now needs an offset to cope!
		self.max_health = ad_MON_GIBFOUNTAIN;
		self.ad_gib_ofs = '0 0 32';
		// Wiggle and keel over
		ad_eel_die1 ();
	}
};

//======================================================================
/*ad:QUAKED monster_eel (1 0 0) (-16 -16 -16) (16 16 16)
======================================================================*/
void() ad_monster_eel =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_eel.mdl";
	self.ad_headmdl = "progs/h_eel.mdl";
	precache_model (self.mdl);
	precache_model (self.ad_headmdl);
	precache_model (ad_MODEL_PROJ_PLASMA);		// Plasma spike/bolt

	self.ad_idle_sound = "eel/idle1.wav";
	precache_sound (self.ad_idle_sound);

	precache_sound ("eel/attack1.wav");
	precache_sound ("eel/death1.wav");
	self.ad_pain_sound = "eel/pain1.wav";
	precache_sound (self.ad_pain_sound);

	self.ad_sight_sound = "eel/sight1.wav";
	precache_sound (self.ad_sight_sound);

	// Check for poisonous entity flag
	if (self.ad_poisonous) {
		ad_precache_poisongibs();			// precache gibs
		self.ad_gibtype = ad_GIBTYPE_POISON;	// Poisonous blood trails
		precache_model (ad_MODEL_PROJ_PLASMAGRN);
	}
	
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_EEL;
	if (self.health < 1) self.health = 35;
	self.ad_gibhealth = -25;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 10;			// Easy response to pain
	self.ad_steptype = ad_FS_FLYING;		// It has no sea legs!
	self.ad_blockudeath = ad_TRUE;		// No humanoid death sound
	self.ad_attack_offset = '20 0 -2';	// Plasma start location
	self.ad_deathstring = " was electrified by an Eel\n";

	// Check for water sightline wakeup
	if (self.spawnflags & ad_MON_LIQUIDBLOCK) self.ad_liquidblock = ad_TRUE;
	
	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;
	
	self.ad_th_checkattack = ad_EelCheckAttack;
	self.ad_th_stand = ad_eel_stand;
	self.ad_th_walk = ad_eel_walk;
	self.ad_th_run = ad_eel_run;
	self.ad_th_pain = ad_eel_pain;
	self.ad_th_die = ad_eel_die;
	self.ad_th_missile = ad_eel_attack1;

	self.ad_classtype = ad_CT_MONEEL;
	self.ad_classgroup = ad_CG_FISH;
	self.ad_classmove = ad_MON_MOVESWIM;
	
	ad_monster_start();
};