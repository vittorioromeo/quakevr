//======================================================================
// MONSTER FUNCTIONS
//======================================================================

float ad_MONAI_ZOMBIEFLR = 1;		// start on floor
float ad_MONAI_ZOMBIEUPB = 2;		// zombie painb - 28 frames (9 = on ground)
float ad_MONAI_ZOMBIEUPD = 4;		// knight paind - 35 frames (12 = on ground)
float ad_MONAI_ZOMBIEUPE = 8;		// knight + zombie paine - 30 frames (12 = on ground)
float ad_MONAI_ZOMBGRDTIMER = 2;	// Zombie onground timer (between checking)
float ad_MONAI_ZOMBGRDBLOCK = 300;	// 0.1 * 300 = 30s
float ad_MONAI_ZOMBIELOW_DAM = 9;	// Pain threshold for animations	
float ad_MONAI_ZOMBIEHGH_DAM = 28;	// Has to be higher than SG (7x4)

void(float ad_frameno) ad_zombie_onground;
void(float ad_frameno) ad_zombiek_onground;

//----------------------------------------------------------------------
// Pre-defined bounding boxes for monsters
// Use 'bboxtype' to specify one of these
//----------------------------------------------------------------------
float ad_BBOX_TINY = 1;		// -16 -16 -24, 16 16 16	Vol 32 x 32 x 40
float ad_BBOX_SQUARE = 2;		// -20 -20 -20, 20 20 20	Vol 40 x 40 x 40
float ad_BBOX_BRKTINY = 3;		// -12 -12 -24, 12 12 16	Vol 24 x 24 x 40
float ad_BBOX_SHORT = 4;		// -16 -16 -24, 16 16 32	Vol 32 x 32 x 56
float ad_BBOX_TALL = 5;		// -16 -16 -24, 16 16 40	Vol 32 x 32 x 64
float ad_BBOX_XTALL = 6;		// -16 -16 -24, 16 16 64	Vol 32 x 32 x 88
float ad_BBOX_WIDE = 7;		// -24 -24 -24, 24 24 40	Vol 48 x 48 x 64
float ad_BBOX_GIANT = 8;		// -24 -24 -24, 24 24 64	Vol 48 x 48 x 88
float ad_BBOX_MASSIVE = 10;	// -32 -32 -24, 32 32 64	Vol 64 x 64 x 88
float ad_BBOX_XMASSIVE = 12;	// -32 -32 -24, 32 32 80	Vol 64 x 64 x 104
// Custom monster bound box sizes
float ad_BBOX_DOG = 20;		// -20 -20 -24, 20 20 16	Vol 40 x 40 x 40
float ad_BBOX_FISH = 30;		// -16 -16 -24, 16 16 24	Vol 32 x 32 x 48
float ad_BBOX_FISHS = 32;		// -12 -12 -16, 12 12 16	Vol 24 x 24 x 32
float ad_BBOX_EEL = 34;		// -16 -16 -16, 16 16 16	Vol 32 x 32 x 32
float ad_BBOX_HYDRA = 36;		// -20 -20 -16, 20 20 16	Vol 40 x 40 x 32
float ad_BBOX_JUSTICE = 40;	// -16 -16 -24, 16 16 56	Vol 32 x 32 x 80
float ad_BBOX_GOLEM = 50;		// -28 -28 -24, 28 28 80	Vol 56 x 56 x 104
float ad_BBOX_PSYDER = 60;		// -32 -32 -24, 32 32 160	Vol 64 x 64 x 184

float ad_BBOX_CUSTOM = 99;		// Custom size defined on monster

//======================================================================
// monster_use - trigger/make angry
//======================================================================
void() ad_monster_use =
{
	// Busy with another enemy or dead?
	if (self.enemy) return;
	if (self.health < 1) return;
	
	// Spiders/Vorelings can be setup on the ceilings
	// need to trigger/drop instead them before anything else
	if (((((self.ad_classtype == ad_CT_MONSPIDER && (self.spawnflags & ad_MON_SPIDER_CEILING)) ||
		self.ad_classtype == ad_CT_MONSWAMPLING) && (self.spawnflags & ad_MON_SWAMPLING_CEILING)) ||
		self.ad_classtype == ad_CT_MONVORELING) && (self.spawnflags & ad_MON_VORELING_CEILING)) {
		// Start with activator as enemy
		self.enemy = ad_activator;
		// Work through exceptions
		if (ad_activator.ad_classtype != ad_CT_PLAYER) self.enemy = world;
		if (ad_activator.items & ad_IT_INVISIBILITY) self.enemy = world;
		if (ad_activator.flags & ad_FL_NOTARGET) self.enemy = world;
		// Drop from ceiling
		self.ad_th_run();
		return;
	}
	
	// Player exceptions
	if (ad_activator.ad_classtype != ad_CT_PLAYER) return;
	if (ad_activator.items & ad_IT_INVISIBILITY) return;
	if (ad_activator.flags & ad_FL_NOTARGET) return;

	// Monster angry! Hunt enemy!?!
	self.enemy = ad_activator;

	// If wakeup trigger setup do not wait, special animation
	// This is really designed to go with a breakable trigger
	if (self.ad_wakeuptrigger && self.ad_th_wakeup) {
		self.ad_wakeuptrigger = ad_FALSE;	// Trigger no longer needed, reset
		ad_FoundHuntTarget(ad_TRUE);		// Setup goals and warn other monsters
		self.ad_th_wakeup();
	}
	else {
		// delay reaction (wait one frame) so if the monster
		// has been teleported the sound is heard correctly
		self.nextthink = time + 0.1;
		self.think = ad_FoundTarget;
	}
};

/*======================================================================
 liquid_check
  for some reason monsters never take damage from liquids
	This functions checks for liquid content and applies a
	modifier damage (they die too slow otherwise)
	* If a monster is in liquid there is often no way out!
	* Moves the content check to the monsters feet (shallow liquid)
======================================================================*/
void() ad_monster_liquid_check =
{
	local float ad_monster_dmg;
	local vector ad_monster_feet;
	
	// This function is for monsters only (high damage)
	if (self.ad_no_liquiddmg) return;
	if (ad_query_configflag(ad_SVR_LIQDAM)) return;
	if ( !(self.flags & ad_FL_MONSTER)) return;
	if (self.health < 1) return;
	if (self.ad_liquidcheck > time) return;
		
	// Reset liquid damage timer
	self.ad_liquidcheck = time + ad_LIQUID_TIMER;
	
	// Check for liquid at monsters feet (bottom of bounding box)
	ad_monster_feet = self.origin; 
	ad_monster_feet_z = ad_monster_feet_z + self.mins_z;
	self.ad_liquidbase = pointcontents(ad_monster_feet);
	
	// Some monsters start in lava/slime (ID1 maps)
	// If placed in laval/slime give immunity (old ID1 behaviour)
	if (ad_framecount < 50) {
		if (self.ad_liquidbase == ad_CONTENT_SLIME || self.ad_liquidbase == ad_CONTENT_LAVA)
		{ 
			self.ad_no_liquiddmg = ad_TRUE;
			ad_spawn_marker(self.origin, 0);
			dprint("\b[Monster]\b ("); dprint(self.classname);
			dprint(") at ("); dprint(vtos(self.origin));
			dprint(") in ("); dprint(ftos(self.ad_liquidbase));
			dprint(") FC ("); dprint(ftos(ad_framecount));
			dprint(")\n");
			return;
		}
	}
	// Setup standard damage for liquid types
	if (self.ad_liquidbase == ad_CONTENT_SLIME) ad_monster_dmg = ad_SLIME_DAMAGE * ad_MON_MULTIPLIER;
	else if (self.ad_liquidbase == ad_CONTENT_LAVA) ad_monster_dmg = ad_LAVA_DAMAGE * ad_MON_MULTIPLIER;
	else return;

	// Gib monster if about to die
	if (self.health < ad_monster_dmg + 5) {
		ad_monster_dmg = self.health + 5;
		self.ad_gibondeath = 1;
	}

	// Liquid damage
	self.ad_pain_finished = 0;		// Always pain
	ad_T_Damage (self, world, world, ad_monster_dmg, ad_DAMARMOR);
};

/*======================================================================
 monster_idle_sound
 - use one routine so more stuff can be added easily
 - easier to add any exceptions this way
 - zombies have their own unique idle routine
 - tarby added using sight sound
======================================================================*/
void() ad_monster_idle_sound =
{
	// No monsters, dead and timer not reset?
	if ( !(self.flags & ad_FL_MONSTER) ) return;
	if (self.health < 1) return;
	if (self.ad_idletimer > time) return;
	if (self.spawnflags & ad_MON_SPAWN_NOIDLE) return;

	self.ad_idletimer = time + 5 + (random() * 3);
	if (!self.ad_idlemoreoften && random() > ad_MON_IDLE_SOUND) return;
		
	// Is the monster active in combat (special idle sound)
	if (self.enemy && self.ad_idle_soundcom != "") {
		if (self.ad_idle_soundcom2 != "") {
			if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_idle_soundcom, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_VOICE, self.ad_idle_soundcom2, 1, ad_ATTN_NORM);
		}
		else sound (self, ad_CHAN_VOICE, self.ad_idle_soundcom, 1, ad_ATTN_NORM);
	}
	else {
		// setup each monster with unique idle sounds (easier and quicker)
		if (self.ad_idle_sound2 != "") {
			if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_VOICE, self.ad_idle_sound2, 1, ad_ATTN_NORM);
		}
		else sound (self, ad_CHAN_VOICE, self.ad_idle_sound, 1, ad_ATTN_NORM);
	}
};

/*======================================================================
 monster_sightsound
  - Switched sound channel to CHAN_BODY so death always stops it
  - Randomnly get sound file cut off using voice channel
======================================================================*/
void() ad_monster_sightsound =
{
	local float	ad_rsnd;

	// No monsters, dead and timer not reset?
	if ( !(self.flags & ad_FL_MONSTER) ) return;
	if (self.health < 1) return;
	if (!self.ad_sight_sound) return;
	if (self.spawnflags & ad_MON_SPAWN_NOSIGHT) return;
	if (ad_intermission_running > 0) return;
	if (ad_cinematic_running > 0) return;

	// Only do a sight sound when necessary, otherwise it overlaps and gets messy	
	if (self.ad_sight_timeout < time) {
		self.ad_sight_timeout = time + ad_MON_SIGHTSOUND;		// Use pre-defined reset values
	
		ad_rsnd = random();
		// The id enforcer has four sight sounds, which is a bit excessive
		// Check through sight strings to find out quantity
		if (self.ad_sight_count == 2) {
			if (ad_rsnd < 0.5) sound (self, ad_CHAN_BODY, self.ad_sight_sound, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_BODY, self.ad_sight_sound2, 1, ad_ATTN_NORM);
		}
		else if (self.ad_sight_count == 3) {
			if (ad_rsnd < 0.3) sound (self, ad_CHAN_BODY, self.ad_sight_sound, 1, ad_ATTN_NORM);
			else if (ad_rsnd < 0.6) sound (self, ad_CHAN_BODY, self.ad_sight_sound2, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_BODY, self.ad_sight_sound3, 1, ad_ATTN_NORM);
		}
		else if (self.ad_sight_count == 4) {
			if (ad_rsnd < 0.25) sound (self, ad_CHAN_BODY, self.ad_sight_sound, 1, ad_ATTN_NORM);
			else if (ad_rsnd < 0.5) sound (self, ad_CHAN_BODY, self.ad_sight_sound2, 1, ad_ATTN_NORM);
			else if (ad_rsnd < 0.75) sound (self, ad_CHAN_BODY, self.ad_sight_sound3, 1, ad_ATTN_NORM);
			else sound (self, ad_CHAN_BODY, self.ad_sight_sound4, 1, ad_ATTN_NORM);
		}
		// setup each monster with unique sight sounds (easier and quicker)
		else sound (self, ad_CHAN_BODY, self.ad_sight_sound, 1, ad_ATTN_NORM);
	}
};

/*======================================================================
 monster_footstep
  This function will play a footstep sound
  * Types : Slow, Drag, Light, Medium, Heavy, Large
  * called from animation blocks to sync with sound
======================================================================*/
void(float ad_altfoot) ad_monster_footstep = 
{
	local float ad_footstep, ad_footstepnext, ad_footvol;
	local string ad_footstepwav;
	
	if (ad_query_configflag(ad_SVR_FOOTSTEP)) return;	// Default(0) = ON
	if (self.health < 1) return;
	if (self.movetype == ad_MOVETYPE_NOCLIP) return;
	if (self.watertype < ad_CONTENT_EMPTY) return;
	if (self.ad_steptype == ad_FS_FLYING) return;
	
	// Wide volume range for player
	if (self.flags & ad_FL_CLIENT) ad_footvol = 0.2 + random()*0.6;
	// feetsteps need to be louder during combat
	else if (self.enemy) ad_footvol = 1;
	// Dogs have too many legs making noise, reduce volume	
	else if (self.ad_classtype == ad_CT_MONDOG) ad_footvol = 0.2 + random()*0.6;
	// Slight random volume level out of combat
	else ad_footvol = 0.7 + random()*0.3;
	
	// Decide which foot sound to play, long live clubfoot!
	if (ad_altfoot) {
		// Switch to ALTernative foot sound
		ad_footstep = self.ad_altsteptype;
		if (self.ad_altsteplast < 1) self.ad_altsteplast = rint(1 + random()*4);

		// Increase footstep sound index by one 
		ad_footstepnext = rint(self.ad_altsteplast + 1);
		// Every loop around, randomly reset
		if (ad_footstepnext > 5) ad_footstepnext = rint(1 + random()*4);
		self.ad_altsteplast = ad_footstepnext;
	}
	else {
		// Setup last footstep sound
		ad_footstep = self.ad_steptype;
		if (self.ad_steplast < 1) self.ad_steplast = rint(1 + random()*4);

		// Player is randomly selected footsteps
		if (self.flags & ad_FL_CLIENT) {
			// Quake random function is not really super random
			// Probably a bad seed starting point for function
			// Use 3 randoms to create something more random!
			ad_footstepnext = rint(self.ad_steplast + random() + random() + random());
			if (ad_footstepnext > 5) ad_footstepnext = ad_footstepnext - 5;
		}
		else {
			// Increase footstep sound index by one 
			ad_footstepnext = rint(self.ad_steplast + 1);
			// Every loop around, randomly reset
			if (ad_footstepnext > 5) ad_footstepnext = rint(1 + random()*4);
		}

		// update last footstep index
		self.ad_steplast = ad_footstepnext;
	}
	
	// Cycle through all footstep types and work out correct sound file
	// All footstep types reduced down to 5 possible choices (speed things up)
	// Could store sound files with entity and cycle round quicker, req more memory
	// re-checking the sound file every footstep is costly on time
	// Luckly most footstep sounds are several frames apart (too noisy as well)
	if (ad_footstep == ad_FS_TYPELIGHT) {
		// Light heal/ paw sound
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_LIGHT1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_LIGHT2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_LIGHT3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_LIGHT4;
		else ad_footstepwav = ad_SOUND_FS_LIGHT5;
	}
	else if (ad_footstep == ad_FS_TYPEMEDIUM) {
		// Average foot/boot sound
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_MEDIUM1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_MEDIUM2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_MEDIUM3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_MEDIUM4;
		else ad_footstepwav = ad_SOUND_FS_MEDIUM5;
	}
	else if (ad_footstep == ad_FS_TYPEHEAVY) {
		// Heavy foot with slight echo
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_HEAVY1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_HEAVY2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_HEAVY3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_HEAVY4;
		else ad_footstepwav = ad_SOUND_FS_HEAVY5;
	}
	else if (ad_footstep == ad_FS_TYPELARGE) {
		// Large foot with large echo
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_LARGE1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_LARGE2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_LARGE3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_LARGE4;
		else ad_footstepwav = ad_SOUND_FS_LARGE5;
	}
	else if (ad_footstep == ad_FS_TYPEGIANT) {
		// Giant foot with long echo
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_GIANT1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_GIANT2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_GIANT3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_GIANT4;
		else ad_footstepwav = ad_SOUND_FS_GIANT5;
	}
	else if (ad_footstep == ad_FS_TYPECUSTOM) {
		// Custom feet sounds (usually boss type creatures)
		if (ad_footstepnext < 2) ad_footstepwav = self.ad_stepc1;
		else if (ad_footstepnext < 3) ad_footstepwav = self.ad_stepc2;
		else if (ad_footstepnext < 4) ad_footstepwav = self.ad_stepc3;
		else if (ad_footstepnext < 5) ad_footstepwav = self.ad_stepc4;
		else ad_footstepwav = self.ad_stepc5;
	}
	else if (ad_footstep == ad_FS_TYPEDRAG) {
		// Small scraping foot on ground
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_DRAG1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_DRAG2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_DRAG3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_DRAG4;
		else ad_footstepwav = ad_SOUND_FS_DRAG5;
	}
	// FS_TYPESLOW (default)
	else {
		// Souless shoe foot sound
		if (ad_footstepnext < 2) ad_footstepwav = ad_SOUND_FS_SLOW1;
		else if (ad_footstepnext < 3) ad_footstepwav = ad_SOUND_FS_SLOW2;
		else if (ad_footstepnext < 4) ad_footstepwav = ad_SOUND_FS_SLOW3;
		else if (ad_footstepnext < 5) ad_footstepwav = ad_SOUND_FS_SLOW4;
		else ad_footstepwav = ad_SOUND_FS_SLOW5;
	}
	
	// Play the sound (large feet need to be heard further away)
	if (ad_footstep == ad_FS_TYPELARGE) sound (self, ad_CHAN_FEET, ad_footstepwav, ad_footvol, ad_ATTN_FEETL);
	else sound (self, ad_CHAN_FEET, ad_footstepwav, ad_footvol, ad_ATTN_FEET);
};

//======================================================================
// PRE/POST CHECK conditions for monster death
//======================================================================
void() ad_monster_death_precheck =
{
	if (self.flags & ad_FL_MONSTER) {
		// Check for minion monster and update parent counters
		if (self.owner.ad_minion_active) ad_update_minioncount(self.owner, -1);

		self.deadflag = ad_DEAD_DEAD;	// Its dead jim!
		self.effects = 0;			// Remove effects on death
		self.think = ad_SUB_Null;		// No more thinking/animation
		self.nextthink = -1;		// Never fire think
		
		ad_monster_check_gib();		// Check for gib state
	}
};

//----------------------------------------------------------------------
void() ad_monster_fade =
{
	// Make sure model/entity is removed
	self.height = 0;
	self.think = ad_model_fade;
	self.nextthink = time + 0.1;
	self.ltime = self.nextthink;
};

//----------------------------------------------------------------------
void() ad_monster_death_postcheck =
{
	local float ad_bodytimer;
	
	self.ad_blockudeath = ad_TRUE;	// Body is dead, no human death noise
	if (!self.ad_gibbed) self.ad_bodyonflr = ad_MON_ONFLR;

	// Allow for the dead body/head to touch triggers (void/hurt)
	setorigin(self, self.origin);
	self.solid = ad_SOLID_TRIGGER;
	self.touch = ad_SUB_Null;
	
	// Compatibility with Quoth body fade version
	if (self.ad_corpse_time > 0) self.ad_bodyfadeaway = self.ad_corpse_time;
	
	// Check for global or individual body fading mechanic
	if (self.ad_bodyfadeaway > 0 || ad_map_bodyfadeaway > 0) {
		if (ad_map_bodyfadeaway > 0) ad_bodytimer = ad_map_bodyfadeaway;
		else ad_bodytimer = self.ad_bodyfadeaway;
		self.ad_pain_finished = time + 10 + random() * ad_bodytimer;
	}
	// Body sticks around
	else self.ad_pain_finished = time + ad_LARGE_TIMER;
};

//----------------------------------------------------------------------
void() ad_monster_deadbody_check =
{
	// Remove/Fade out body if timer is finished
	if (self.ad_pain_finished < time) { ad_monster_fade(); return; }
	// Exit condition, body no longer has any interaction
	if (self.deadflag == ad_DEAD_FINISHED) return;
	
	// Check for deadflag first, if touched something this will be changed
	if ((self.deadflag == ad_DEAD_REMOVE || self.deadflag == ad_DEAD_EXPLODE)
		&& self.ad_gibbed == ad_FALSE) {
		// make sure touch,solid and body axe interaction are off
		self.touch = ad_SUB_Null;
		self.solid = ad_SOLID_NOT;
		self.ad_bodyonflr = "";
		self.ad_gibhealth = ad_TRUE;
		// Only two options available, gib explode or remove
		if (self.deadflag == ad_DEAD_EXPLODE) self.think = ad_monster_ThrowGib;
		// Replace animation frame group think function
		else self.think = ad_SUB_Remove;
		self.nextthink = time + 0.1;
		// Prevent this function from running again
		self.deadflag = ad_DEAD_FINISHED;
	}
	else {
		// Check global map variable first (default = off)
		// Check floor below dead body (global function)
		if (ad_map_bodyflrcheck == ad_TRUE)
			ad_ent_floorcheck(self, ad_FLOOR_TRACE_MONSTER);

		// Keep checking for dead body/head conditions
		self.think = ad_monster_deadbody_check;
		self.nextthink = time + 0.1;	
	}
};

/*======================================================================
 monster_death_use
  - When a mosnter dies, it fires all of its targets with the current
		enemy as activator.
======================================================================*/
void() ad_monster_death_use =
{
	// fall to ground or stop swimming
	if (self.flags & ad_FL_FLY) self.flags = self.flags - ad_FL_FLY;
	if (self.flags & ad_FL_SWIM) self.flags = self.flags - ad_FL_SWIM;

	// Always use a deathtarget if one defined
	if (self.ad_deathtarget != "") {
		// Validate deathtarget exists before firing it
		self.ad_movelast = find(world, targetname, self.ad_deathtarget);
		// Deathtarget valid, switch around and fire targets
		if (self.ad_movelast) self.target = self.ad_deathtarget;
	}

	// Is there no target defined?
	if (self.target == "") return;

	ad_activator = self.enemy;
	ad_SUB_UseTargets ();
};

/*======================================================================
 monster_remove_kill
  - A clean way to kill/remove a monster from a map
  - deathfunc to go through existing death function
  - gibdeath for explosion of blood and guts
======================================================================*/
void(entity ad_targ, float ad_deathfunc, float ad_gibdeath) ad_monster_remove_kill =
{
	dprint("\b[MON_KILL]\b "); dprint(ad_targ.classname);
	dprint(" dropped dead!\n");
	// There are always exceptions to the use of the monster flag
	// Point Hell knights don't use monster flag to prevent damage!
	if (ad_targ.spawnflags & ad_MON_POINT_KNIGHT && ad_targ.health > 0) 
		ad_targ.flags = ad_targ.flags | ad_FL_MONSTER;
	
	if (ad_targ.ad_bossflag) {
		dprint("\b[MON_KILL]\b Cannot kill bosses this way!\n");
		ad_spawn_marker(ad_targ.origin, ad_SPNMARK_YELLOW);
		return;
	}
	
	// only work with monsters, can't be dead, dying or negative health!
	if (ad_targ.flags & ad_FL_MONSTER && ad_targ.health > 0 && !ad_targ.deadflag) {
		// Check for any targets (counters will broken otherwise)
		if (self.target != "") ad_trigger_strs(self.target, self);
		if (self.ad_target2 != "") ad_trigger_strs(self.ad_target2, self);
		
		// Check if death function is required for monster
		// Also double check they have a death function setup!
		if (ad_deathfunc && ad_targ.ad_th_die) {
			// Quick way to make something gib, switch on the flag for it!
			if (ad_gibdeath) ad_targ.ad_gibondeath = ad_TRUE;
			// Make sure monster can take damage
			ad_targ.takedamage = ad_DAMAGE_YES;
			// Always do enough damage to kill the monster
			// Can be a problem for ammo resistant
			ad_T_Damage (ad_targ, world, world, ad_targ.health+1, ad_NOARMOR);
		}
		else {
			ad_targ.deadflag = ad_DEAD_DEAD;
			ad_targ.enemy = world;
			ad_targ.health = ad_targ.ad_gibhealth;

			// If a monster marked with no monster count dies
			// update HUD totals to reflect death properly
			if (ad_targ.ad_nomonstercount) {
				total_monsters = total_monsters + 1;
				ad_update_hud_totals(ad_HUD_MONSTERS);
			}	
			// Update global monster death totals
			killed_monsters = killed_monsters + 1;
			WriteByte (ad_MSG_ALL, ad_SVC_KILLEDMONSTER);

			// Stop all animation think functions
			ad_targ.think = ad_SUB_Null;
			ad_targ.nextthink = time + ad_LARGE_TIMER;
			// Finally stop and hide all models
			// Should not remove monster, it might have dependancies
			ad_entity_hide(ad_targ);
			if (ad_targ.ad_attachment) ad_entity_remove(ad_targ.ad_attachment, 0.1);
			if (ad_targ.ad_attachment2) ad_entity_remove(ad_targ.ad_attachment2, 0.1);
			if (ad_targ.ad_attachment3) ad_entity_remove(ad_targ.ad_attachment3, 0.1);
		}
	}
};

/*======================================================================
 monster_paincheck
  - Tests all pain conditions and returns what to do
  * 0 = Nothing
  * 1 = Sound + Animation
  * 2 = Sound + Long Animation
  * 3 = Sound ONLY
======================================================================*/
void(entity ad_attacker, float ad_damage) ad_monster_pain_check =
{
	self.ad_pain_check = 0;	// Reset pain check
	
	// already dying, don't go into pain frame
	if (self.health < 1) self.ad_pain_check = 0;
	// The new axe forces monsters into long pain animations (if they exist)
	else if (ad_attacker.ad_moditems & ad_IT_UPGRADE_AXE && self.ad_axhitme > 0 && self.ad_pain_longanim) self.ad_pain_check = 2;
	// always go into pain frame if it has been a while (first hit = pain)
	else if (time - self.ad_pain_finstate > ad_PAIN_ALWAY) self.ad_pain_check = 1;
	// Dangerous liquids should kill the monster and keeping them in
	// constant pain animations which makes them look better than doing nothing!
	else if (self.ad_liquidbase == ad_CONTENT_SLIME || self.ad_liquidbase == ad_CONTENT_LAVA) self.ad_pain_check = 1;
	// If being attacked by a world object (shooter, electricity, bmodel) in pain
	else if (ad_attacker == world) self.ad_pain_check = 1;
	// Random chance to flinch and not ignore the pain (play sound only)
	else if (random()* self.ad_pain_flinch > ad_damage ) self.ad_pain_check = 3;
	// DEFAULT  : pain animation + sound (last condition)
	else self.ad_pain_check = 1;
};

/*======================================================================
 monster_targets (second part of setup function)
  - Checks for any targets to get angry at or stand/walk around
======================================================================*/
void() ad_monster_targets =
{
	// Reset everything first
	self.enemy = self.goalentity = self.ad_movetarget = world;

	//----------------------------------------------------------------------
	// * Monsters can spawn angry at the player/activator
	// * the target key can point to a path_corner
	// * If the target key points at another monster they will infight
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_SPAWN_ANGRY || self.ad_angrytarget) {
		// Check if the activator is a player? if not find a player
		if (ad_activator.flags & ad_FL_CLIENT) self.enemy = ad_activator;
		else self.enemy = checkclient ();
		
		// Double check enemy is player and has notarget or wearing RoS?
		if (self.enemy.flags & ad_FL_CLIENT) {
			if (self.enemy.flags & ad_FL_NOTARGET) self.enemy = world;
			else if (self.enemy.items & ad_IT_INVISIBILITY) self.enemy = world;
		}
		// If the activator not a player, reset to world
		// Cannot get angry at triggers, use angrytarget for infighting
		else self.enemy = world;
			
		// If an alternative angry target defined, find it and attack!	
		if (self.ad_angrytarget) {
			self.ad_oldenemy = find(world, targetname, self.ad_angrytarget);
			// Is the attack target a monster and spawned/active (take damage)
			if (self.ad_oldenemy.flags & ad_FL_MONSTER && self.ad_oldenemy.takedamage != ad_DAMAGE_NO)
				self.enemy = self.ad_oldenemy;
		}

		// Check the enemy is a player/monster and alive
		if (self.enemy.flags & (ad_FL_CLIENT | ad_FL_MONSTER) && self.enemy.health > 0) {
			self.nextthink = time + 0.1;
			self.think = ad_FoundTarget;
			ad_monster_sightsound ();	// Wake up sound
			return;
		}
	}
	else {
		// If the monster has a target check if path_corner or something to attack?
		// Do nothing with patrol paths if spawning angry with the player
		if (self.target != "") {
			self.ad_movetarget = find(world, targetname, self.target);
			// Cannot chase a target if setup as a turret
			if (self.ad_movetarget && self.ad_movespeed != -1) {
				if (self.ad_movetarget.ad_classtype == ad_CT_PATHCORNER) {
					self.goalentity = self.ad_movetarget;
					self.ideal_yaw = vectoyaw(self.goalentity.origin - self.origin);
					self.nextthink = time + 0.1 + random()*0.5;
					self.think = self.ad_th_walk;
					return;
				}
			}
		}
	}

	// no angrytarget, enemy or path corner, stand around waiting
	self.nextthink = time + 0.1 + random()*0.5;
	self.think = self.ad_th_stand;					// Stand around
};

/*======================================================================
 monster_setup
  - Setup monster ready for action
======================================================================*/
void() ad_monster_spawn =
{
	//----------------------------------------------------------------------
	// Check if the monster can spawn without telefragging something
	if (self.ad_spawnnotelefrag > 0) {
		// Switch on world interaction
		self.solid = ad_SOLID_SLIDEBOX;
		// Not all monsters are step movement, some are stationary
		if (self.ad_classmove == ad_MON_MOVESTATIC) self.movetype = ad_MOVETYPE_NONE;
		else self.movetype = ad_MOVETYPE_STEP;
		// restore model/bbox to get world collision
		setmodel(self, self.mdl);
		setsize (self, self.ad_bbmins, self.ad_bbmaxs);
		// reset origin, just in case been moved since last
		setorigin(self, self.oldorigin);
		// Save origin for cinematic camera angle interpolation
		self.ad_lastorigin = self.origin;
		
		// Make sure movement flag types are correct
		if (self.ad_classmove == ad_MON_MOVEFLY ) 
			self.flags = self.flags | ad_FL_FLY;
		else if (self.ad_classmove == ad_MON_MOVESWIM ) 
			self.flags = self.flags | ad_FL_SWIM;

		// Can the monster walk without collision?
		if (!ad_walkmove (0, 0)) {
			// Switch off monster and wait again
			self.solid = ad_SOLID_NOT;
			setmodel(self,"");
			setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
			self.think = ad_monster_spawn;
			self.nextthink = time + 0.1 + random()*0.5;
			//dprint(self.classname); dprint(" is Blocked, waiting (");
			//dprint(ftos(self.nextthink - time)); dprint(") secs\n");
			return;
		}
		else {
			// make sure monster is not displayed yet
			// might have a nosight check to do
			self.solid = ad_SOLID_NOT;
			setmodel(self,"");
			setsize(self, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		}
	}

	//----------------------------------------------------------------------
	// Check for spawnnosight conditions
	if (self.ad_spawnnosight > 0) {
		// Setup maximum time limit for spawning regardless
		if (self.ad_attack_finished == ad_FALSE) {
			// Default is 30s (check for override condition first)
			if (self.ad_spawnnosighttime < 1) self.ad_spawnnosighttime = 30;
			self.ad_attack_finished = time + self.ad_spawnnosighttime;
		}
		
		// Reset sight condition first and find client in PVS
		self.lefty = ad_FALSE;
		self.ad_oldenemy = checkclient();
		// Did the client PVS check return an entity?
		if (self.ad_oldenemy) {
			// is the client a player?
			if (self.ad_oldenemy.flags & ad_FL_CLIENT) {
				// Check if the player can be seen?
				ad_enemy_vis = ad_visible(self.ad_oldenemy);
				if (ad_enemy_vis) self.lefty = ad_TRUE;
				// Check for an insight spawn distance
				if (self.ad_spawnnosight > 1) {
					// Find distance (3d vector distance)
					self.ad_enemydist = ad_range_distance(self.ad_oldenemy, ad_FALSE);
					// check for player being too close for spawn
					if (self.ad_enemydist > self.ad_spawnnosight)
						self.lefty = ad_FALSE;
				}
			}
			// Checks for notarget/inv player conditions
			// disabled - not really necessary as a spawn condition
			//if (self.oldenemy.flags & FL_NOTARGET) self.lefty = FALSE;
			//if (self.oldenemy.items & IT_INVISIBILITY) self.lefty = FALSE;
		}
		
		// Can the player see the spawn location? wait instead
		if (self.lefty == ad_TRUE && self.ad_attack_finished > time) {
			self.think = ad_monster_spawn;
			self.nextthink = time + 0.1;
			return;
		}
	}
		
	//----------------------------------------------------------------------
	// Time to finally spawn the monster!?! All conditions met!
	
	if (self.ad_think1) self.use = self.ad_think1;	// different use function?
	else self.use = ad_monster_use;				// default trigger event
	self.solid = ad_SOLID_SLIDEBOX;				// Standard monster movement
	// Some monsters never move, make sure they don't drift either
	if (self.ad_classmove == ad_MON_MOVESTATIC) self.movetype = ad_MOVETYPE_NONE;
	else self.movetype = ad_MOVETYPE_STEP;			// Standard monster movement
	setmodel(self, self.mdl);					// Setup model
	self.skin = self.ad_skin_override;				// Restore any skins
	self.frame = self.ad_frame_override;			// Restore any frames
	setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore BB size

	// Check for delay spawn monster count
	if (self.ad_delaymonstercount) {
		// Reset both monster count conditions
		self.ad_nomonstercount = self.ad_delaymonstercount = 0;
		total_monsters = total_monsters + 1;
		ad_update_hud_totals(ad_HUD_MONSTERS);
	}
	
	// Restore any effect flags settings (various dlight glows)
	if (self.ad_savedeffects > 0) self.effects = self.ad_savedeffects;
	
	// Should grenades bounce off the body?
	if (self.ad_bouncegrenade) self.takedamage = ad_DAMAGE_YES;
	else self.takedamage = ad_DAMAGE_AIM;			// Can receive damage

	self.velocity = '0 0 0';					// Make sure stationary
	self.deadflag = ad_DEAD_NO;					// used to stop death re-triggering
	self.ad_liquidbase = self.ad_liquidcheck = 0;		// Used for liquid content damage
	self.ad_dmgcombined = self.ad_dmgtimeframe = 0;	// combined damage over 0.1s
	if (!self.ad_pain_flinch) self.ad_pain_flinch = self.health;
	if (!self.ad_switchoverride) self.ad_switchoverride = 1;

	// Double check that all ammo resistance are within range
	ad_Resist_CheckRange(self);

	// Check for tether system (special target field)
	ad_setup_tethersystem();
	
	// Check for passive mode and add (defaults) extra variables
	ad_setup_passivestate(self);

	// Long time before first idle sound (except scorpions!)
	if (self.ad_idletimer < 1) {
		if (self.ad_classtype == ad_CT_MONSCORPION) self.ad_idletimer = time + 0.1 + random();
		else self.ad_idletimer = time + 4 + (random() * 4);
	}
	
	// Reset all enemy tracking entities
	if (!self.enemy) self.enemy = self.ad_movetarget = self.goalentity = world;
	self.ad_pausetime = time + ad_LARGE_TIMER;

	// Setup pain tolerence level based on current skill level
	if (!self.ad_pain_timeout) self.ad_pain_timeout = 1;	// Default
	if (ad_skill == ad_SKILL_HARD) self.ad_pain_timeout = self.ad_pain_timeout + 1;
	if (ad_skill == ad_SKILL_NIGHTMARE) self.ad_pain_timeout = self.ad_pain_timeout + 3;

	//----------------------------------------------------------------------
	// Setup different skin options
	//----------------------------------------------------------------------
	if (self.ad_exactskin > 0) self.skin = rint(self.ad_exactskin);
	else if (self.ad_randomskin > 1) self.skin = rint(random()*(self.ad_randomskin-1));
	if (self.skin < 0) self.skin = 0;	// Double check no negatives

	//----------------------------------------------------------------------
	self.ideal_yaw = self.angles * '0 1 0';
	if (self.ad_classmove == ad_MON_MOVEFLY ) {	// Flying Monsters
		if (!self.yaw_speed) self.yaw_speed = 15;
		self.flags = self.flags | ad_FL_FLY;
	}
	else if (self.ad_classmove == ad_MON_MOVESWIM ) {	// Swimming Monsters	
		if (!self.yaw_speed) self.yaw_speed = 10;
		self.flags = self.flags | ad_FL_SWIM;
	}
	else {
		// Default walking/static monsters
		if (!self.yaw_speed) self.yaw_speed = 20;
	}

	// Not all bounding boxes extend up very high, make sure the view_ofs
	// is relevant to where the top of the bounding box is
	if (self.view_ofs_z == 0) {
		if (self.maxs_z <= ad_MON_VIEWOFS) self.view_ofs_z = self.maxs_z*0.5;
		else self.view_ofs_z = ad_MON_VIEWOFS;
	}
	
	//----------------------------------------------------------------------
	// Is the monster a zombie (type) lying on the floor? (starting pose)
	// Angles key used for specific facing direction, 0 = random setup
	// This function check is before any droptofloor or content checks
	// It will allow onfloor monsters to exist in tight spaces, shallow graves
	//----------------------------------------------------------------------
	if ((self.spawnflags & ad_MON_ONFLOOR) && self.ad_classgroup == ad_CG_ZOMBIE) {
		if (self.ad_classtype == ad_CT_MONZOMBIEK) ad_zombiek_onground(ad_MONAI_ZOMBIEFLR);
		else ad_zombie_onground(ad_MONAI_ZOMBIEFLR);
		return;
	}

	//----------------------------------------------------------------------
	// Special minions (start small and grow fast)
	// CT_MINIONSPIDER, CT_MINIONVORELING, CT_MINIONGARGOYLE
	//----------------------------------------------------------------------
	if (self.ad_minion_active) {
		self.angles = vectoangles(self.enemy.origin - self.origin);
		self.angles_x = self.angles_z = 0;
		ad_update_hud_totals(ad_HUD_MONSTERS);
		self.ad_pain_finished = time + 1.2;
		self.ad_th_stand();
		return;
	}	
	
	//----------------------------------------------------------------------
	// Perched Gargoyles/Gaunt have special idle animation (sitting)
	// and need to fly up before resuming any normal behaviour 
	// (most think functions are intercepted)
	//----------------------------------------------------------------------
	if (((self.ad_classtype == ad_CT_MONGARGOYLE && (self.spawnflags & ad_MON_GARGOYLE_PERCH)) ||
		self.ad_classtype == ad_CT_MONGAUNT) && (self.spawnflags & ad_MON_GAUNT_PERCH) ) 
	{
		self.flags = self.flags | ad_FL_FLY;	// Stop any ground checks
		self.ad_th_stand();
		return;
	}

	//----------------------------------------------------------------------
	// Ceiling critters have special idle animation (rotated)
	// and need to let go of the ceiling before resuming any
	// normal behaviour (most think functions are intercepted)
	//----------------------------------------------------------------------
	if (((((self.ad_classtype == ad_CT_MONSPIDER && (self.spawnflags & ad_MON_SPIDER_CEILING)) ||
		self.ad_classtype == ad_CT_MONSWAMPLING) && (self.spawnflags & ad_MON_SWAMPLING_CEILING)) ||
		self.ad_classtype == ad_CT_MONVORELING) && (self.spawnflags & ad_MON_VORELING_CEILING)) {
		// Work out where the ceiling is (traceline upwards)
		traceline (self.origin, self.origin+'0 0 4096', ad_TRUE, self);
		
		// Check for empty content before moving
		if (pointcontents(trace_endpos) == ad_CONTENT_EMPTY) {
			self.flags = self.flags | ad_FL_FLY;	// Stop any ground checks
			self.ad_classmove = ad_MON_MOVEFLY;		// Avoid ground check function
			self.origin = trace_endpos;			// Move critter to ceiling
			setorigin(self, self.origin);
			// If the view_ofs is not underneath the critter, no sight
			// functions will work (checkclient for example)
			self.view_ofs = '0 0 -24';
			self.yaw_speed = 20;		// Ground yaw speed
			setsize(self, '-16 -16 -24', '16 16 0');
		}
		else {
			dprint("\b[MONSTER]\b Trying to place on ceiling, no space!\n");
			ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
			remove(self);
			return;
		}
	}
	
	//----------------------------------------------------------------------
	// Check to see if monster (walking) are stuck in geometry
	if (self.ad_classmove == ad_MON_MOVEWALK) {
		self.origin_z = self.origin_z + 1;
		droptofloor();
		
		if (!ad_walkmove(0,0)) {
			// Tempoaraily use lip variable for stuck condition
			self.lip = ad_TRUE;
			// Some monster placement in the original ID maps NEED original Bounding Boxes
			// this is something that cannot be easily fixed, so go back to original BB
			// and test the monster placement again
			if (ad_CheckZeroVector(self.ad_idmins) == ad_FALSE) {
				self.ad_bbmins = self.ad_idmins; self.ad_bbmaxs = self.ad_idmaxs;
				setsize (self, self.ad_bbmins, self.ad_bbmaxs);	// Restore ID BB size
				self.origin_z = self.origin_z + 1;
				droptofloor();
				// re-test monster movement using ID Bounding Box
				if (ad_walkmove(0,0)) self.lip = ad_FALSE;
			}
			
			// It seems that some mappers want to spawn stuff in mid air
			// and let it drop naturally over time (>1 frame)
			// check for empty point content at origin as final test
			if (pointcontents(self.origin) == ad_CONTENT_EMPTY) self.lip = ad_FALSE;
			
			// Is the monster stuck with new/old bounding box?
			// Stuck monsters contribute towards level monster totals
			if (self.lip) {
				// Need to check exceptions because this could go badly
				// wrong for certain types like bosses or special setups
				// Highlight this an warning with marker and messages!
				dprint ("\b[STUCK]\b "); dprint (self.classname);
				dprint (" at "); dprint (vtos(self.origin));
				dprint ("\n");
				ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
				ad_monster_remove_kill(self, ad_FALSE, ad_TRUE);
				return;
			}
		}
	}

	//----------------------------------------------------------------------
	// Telefrag (kill) anything at monster position
	// Phased monsters cannot telefrag or produce spawn effects
	if (!self.ad_bodyphased) {
		// New spawn condition via entity key nospawndamage
		// This is to prevent excessive damage to breakables
		// Monsters can spawn in very wierd situations (inside things)
		// if spawning damage is disabled (spawn_tdeath)
		if (self.ad_nospawndamage == 0)
			ad_spawn_tdeath(self.origin, self);	// 50K damage!
		
		// Don't show spawning effect if start of map spawning
		if (self.spawnflags & ad_MON_SPAWN_DELAY && !(self.spawnflags & ad_MON_SPAWN_NOGFX)) 
			ad_spawn_tfog(self.origin);
	}

	//----------------------------------------------------------------------
	// Hell Knights can be setup to point at a target and fire lightning
	// This uses the magicB attack by ID software that was never used
	// When the Hell Knight recieves damage from the player or triggered
	// will revert back to normal walking/talking/fighting monster!
	// ** Has unique use/think function
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONHELLK && self.spawnflags & ad_MON_POINT_KNIGHT) {
		self.nextthink = time + 0.1 + random()*0.5;
		self.think = self.ad_th_stand;			// statue function
		return;
	}

	//----------------------------------------------------------------------
	// Knights, Hell Knights, Golems and Gargoyles can start as statues
	// They are frozen in an selected pose and wake up on trigger
	// Have different skin, high pain resistance and stone gibs!
	// Added double check for statue spawnflag, just in case
	// ** Has unique use/think function
	//----------------------------------------------------------------------
	if (self.ad_spawnstatue && self.spawnflags & ad_MON_STATUE) {
		self.takedamage = ad_DAMAGE_NO;		// No damage till wakeup
		self.nextthink = time + 0.1 + random()*0.5;
		self.think = self.ad_th_stand;			// statue function
		return;
	}

	//----------------------------------------------------------------------
	// Floyd starts in special standby mode (front facing lights out)
	// Will wait for a trigger or damage from player/monster
	// Floyd starts in a death/rolling animation (lower HP)
	// ** Has unique use/think function
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONFLOYD && self.spawnflags & ad_MON_FLOYDCUSTOM) {
		self.nextthink = time + 0.1 + random()*0.5;
		self.think = self.ad_th_stand;			// custom function
		return;
	}
	
	//----------------------------------------------------------------------
	// Start in special standby mode with a blue halo glowing shield
	// Will wait for a trigger before reverted back to normal gameplay
	// ** Has unique use/think function
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONSEEKER && self.spawnflags & ad_MON_SEEK_SHIELD) {
		self.takedamage = ad_DAMAGE_NO;		// No damage till wakeup
		self.nextthink = time + 0.1 + random()*0.5;
		self.think = self.ad_th_stand;			// statue function
		return;
	}
	//----------------------------------------------------------------------
	// Start in special standby mode with a blue halo glowing shield
	// Will wait for a trigger before reverted back to normal gameplay
	// ** Has unique use/think function
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONSWEEPER && self.spawnflags & ad_MON_SWEEPER_SHIELD) {
		self.takedamage = ad_DAMAGE_YES;		// Resist damage only till wakeup
		self.nextthink = time + 0.1 + random()*0.5;
		self.think = self.ad_th_stand;			// statue function
		return;
	}
	
	//----------------------------------------------------------------------
	// Once the skull wizard is setup on the ground, phase out body
	//----------------------------------------------------------------------
	if (self.ad_classtype == ad_CT_MONSKULLW && self.ad_bodyphased == ad_MONAI_SKULLWINVIS) {
		self.takedamage = ad_DAMAGE_NO;
		self.solid = ad_SOLID_NOT;
		setmodel(self,"");
	}
	//----------------------------------------------------------------------
	// No more spawn exception check for targets
	// If monster has died, don't reset any timers
	if (self.health > 0) ad_monster_targets();
};

//======================================================================
void() ad_monster_spawndelay =
{
	self.think = ad_monster_spawn;
	self.nextthink = time + self.ad_spawndelay;
};

//----------------------------------------------------------------------
// Setup bounding box for monster (based on types)
//----------------------------------------------------------------------
void() ad_monster_bbox = 
{
	if (self.ad_bboxtype == ad_BBOX_CUSTOM) return;
	else if (self.ad_bboxtype == ad_BBOX_TINY)
		// Lost Soul, Scorpion, Spider, Voreling
		{ self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 16'; }
	else if (self.ad_bboxtype == ad_BBOX_BRKTINY)
		// Tiny spawn for breakables
		{ self.ad_bbmins = '-15 -15 -24'; self.ad_bbmaxs = '15 15 16'; }
	else if (self.ad_bboxtype == ad_BBOX_SQUARE)
		// Turret
		{ self.ad_bbmins = '-20 -20 -20'; self.ad_bbmaxs = '20 20 20'; }
	else if (self.ad_bboxtype == ad_BBOX_SHORT)
		// Player, Death Guards, Knights, Crossbow Knights, 
		// Army, Army_Rocket, Army_Grenade, Army_Plasma, Jim
		// Zombie, Poison Zombie, Zombie Knight
		{ self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 32'; }
	else if (self.ad_bboxtype == ad_BBOX_TALL)
		// Hell Knight, Death Knight, Fury Knight, Sergeant
		// Enforcer, Defender, Eliminator, Pyro, Centurion
		// Skull Wizard, Wizard, Gargoyles, Tarbaby, Wraith
		{ self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 40'; }
	else if (self.ad_bboxtype == ad_BBOX_XTALL)
		{ self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 64'; }
	else if (self.ad_bboxtype == ad_BBOX_WIDE)
		// Demon, Ogre, Hunter Ogre, _Mace, _Hammer, Shalrath
		{ self.ad_bbmins = '-24 -24 -24'; self.ad_bbmaxs = '24 24 40'; }
	else if (self.ad_bboxtype == ad_BBOX_GIANT)
		// Drole, Minotaur
		{ self.ad_bbmins = '-24 -24 -24'; self.ad_bbmaxs = '24 24 64'; }
	else if (self.ad_bboxtype == ad_BBOX_MASSIVE)
		// Shambler, ID Ogre
		{ self.ad_bbmins = '-32 -32 -24'; self.ad_bbmaxs = '32 32 64'; }
	else if (self.ad_bboxtype == ad_BBOX_XMASSIVE)
		// Judicator
		{ self.ad_bbmins = '-32 -32 -24'; self.ad_bbmaxs = '32 32 80'; }
	
	// Some monsters are custom sizes
	else if (self.ad_bboxtype == ad_BBOX_DOG)
		{ self.ad_bbmins = '-20 -20 -24'; self.ad_bbmaxs = '20 20 16'; }
	else if (self.ad_bboxtype == ad_BBOX_FISH)
		{ self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 24'; }
	else if (self.ad_bboxtype == ad_BBOX_FISHS)
		{ self.ad_bbmins = '-12 -12 -14'; self.ad_bbmaxs = '12 12 14'; }
	else if (self.ad_bboxtype == ad_BBOX_EEL)
		{ self.ad_bbmins = '-16 -16 -16'; self.ad_bbmaxs = '16 16 16'; }
	else if (self.ad_bboxtype == ad_BBOX_HYDRA)
		{ self.ad_bbmins = '-20 -20 -16'; self.ad_bbmaxs = '20 20 16'; }
	else if (self.ad_bboxtype == ad_BBOX_JUSTICE)
		{ self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 56'; }
	else if (self.ad_bboxtype == ad_BBOX_GOLEM)
		{ self.ad_bbmins = '-28 -28 -24'; self.ad_bbmaxs = '28 28 80'; }
	else if (self.ad_bboxtype == ad_BBOX_PSYDER)
		{ self.ad_bbmins = '-32 -32 16'; self.ad_bbmaxs = '32 32 168'; }
	
	// default bounding box = TALL
	else { self.ad_bbmins = '-16 -16 -24'; self.ad_bbmaxs = '16 16 40'; }
};

//======================================================================
// monster_checkspawn - check all spawn conditions
// return TRUE = do NOT spawn, got a problem
//======================================================================
float() ad_monster_checkspawn =
{
	// Classic exception - Multiplayer (modes 1 & 2)
	if (deathmatch) { remove(self); return ad_TRUE; }
	// This will break progression if monster is used with a counter
	if (cvar("nomonsters") != 0) { remove(self); return ad_TRUE; }
	// Check for spawning (entity keys) conditions (nightmare, coop)
	// uses entity_hide instead of remove(self) - done in check
	if (ad_check_nightmare() == ad_TRUE) return ad_TRUE;
	if (ad_check_coop() == ad_TRUE) return ad_TRUE;

	// No more execeptions
	return ad_FALSE;
};

/*======================================================================
 walkmonster_start
  - Main entry point for ALL monster routines
======================================================================*/
void() ad_monster_start =
{
	self.flags = ad_FL_MONSTER;			// Always reset this flag
	self.ad_ticktimer = 0.1;				// Model animations at 10fps
	self.ad_skin_override = self.skin;		// Save for later
	self.ad_frame_override = self.frame;
	
	// Warning if effects flag is active before spawning
	if (self.effects) {
		dprint("\b[MONSTER]\b Effects flag active\n");
		self.ad_savedeffects = self.effects;
	}
	// Reset effects flag because some engines will show effects
	// This is especially obvious for delay spawned monsters
	self.effects = 0;

	self.oldorigin = self.origin;		// Save origin
	self.max_health = self.health;		// Save max health
	if (!self.ad_gibhealth) self.ad_gibhealth = 0 - self.health;	// Default gib health
	if (self.ad_turrethealth < 0 || self.ad_turrethealth > 1) self.ad_turrethealth = 0.5;

	// Check if jump function has been disabled?
	if (self.jump_flag < 0) self.jump_flag = ad_LARGE_TIMER;
	
	// Default attack function and class group
	if (!self.ad_th_checkattack) self.ad_th_checkattack = ad_CheckAttack;
	if (!self.ad_classgroup) self.ad_classgroup = ad_CG_MONSTERS;
	
	// Highlight monsters with forced no_zaware entity key
	if (self.ad_no_zaware && ad_developer > 0 && !ad_query_configflag(ad_SVR_DEVHELPER)) 
		ad_spawn_marker(self.origin+'0 0 32', ad_SPNMARK_WHITE);

	// Setup bounding box based on presets
	ad_monster_bbox();
	
	// Cannot delay spawn a monster if nothing can trigger it!?!
	if (self.spawnflags & ad_MON_SPAWN_DELAY && self.targetname == "") {
		dprint("\b[MONSTER]\b Cannot delay spawn without targetname!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		remove(self);
		return;
	}
	
	// Allow mappers to spawn monsters that don't affect monster count
	// I know this can be a dangerous if used incorrectly, but good for statues
	// delaymonstercount = update count on spawn instead of death
	if (self.ad_nomonstercount > 0 || self.ad_delaymonstercount > 0) 	{
		// Some maps have way too many no monster counts
		if (world.ad_no_moncountdevmsg <= 0) {
			dprint("\b[MONSTER]\b ("); dprint(self.targetname);
			dprint(") - no monster count\n");
		}
	}
	// Default state - update monster total
	// HUD update done with client setup
	else total_monsters = total_monsters + 1;
	
	//----------------------------------------------------------------------
	// Detect monster armour map hack
	if (self.armorvalue || self.armortype) {
	// This hack really should be stopped, no point upsetting mappers at this point
	//		self.armorvalue = self.armortype = 0;
		dprint("\b[MAPHACKS]\b Using armor on monsters, use health key instead!\n");
	}

	if (self.spawnflags & ad_MON_SPAWN_DELAY) {
		setmodel(self, ad_string_null);
		self.solid = ad_SOLID_NOT;				// No world interaction
		self.use = ad_monster_spawn;			// Wait for trigger
		
		// Check for triggered spawndelay
		if (self.ad_spawndelay != 0) {
			if (self.ad_spawndelay <= 0) self.ad_spawndelay = 0.1 + random()*0.4;
			self.use = ad_monster_spawndelay;
		}
	
		// Display debug diamonds
		ad_monster_devmarker(self);
	}
	else {
		// Variable start delay on all monsters to reduce packet errors
		self.nextthink = time + 0.1 + random()*0.4;
		self.think = ad_monster_spawn;
	}
};

//======================================================================
// Map hacks are not supported in this MOD
// There is no use in pretending otherwise!
//======================================================================
void() ad_walkmonster_start_go = { remove(self); return; };
void() ad_flymonster_start_go = { remove(self); return; };
void() ad_swimmonster_start_go = { remove(self); return; };

//======================================================================
/*ad:QUAKED monster_x (1 0 0) (x y z) (x y z) AMBUSH x x NOSIGHT NOIDLE NOGFX STARTOFF ANGRY Not_Easy Not_Normal Not_Hard Not_DM
XXX, x health points.
-------- KEYS --------
targetname   : Name of monster used for triggering/reference
target       : A path_corner to walk towards or a trigger event on death
target2      : Additional trigger events to fire on death of monster
angrytarget  : something (monster/player) to get angry at once spawned
deathtarget  : entity to trigger upon death (use if target field in use)
health       : Override default health settings
exactskin    : Override default skin selection of 0 (no error checking)
nomonstercount : Exclude from initial monster count, will add if killed
infightextra : Damage multiplier for infighting damage
pain_ignore  : 1 = Ignore pain when hit by other monsters
noinfighting : Will not react to any infighting (it can look stupid)
no_liquiddmg : Blocks all liquid (slime/lava) damage checks
no_zaware    : All Z Aware projectiles will be disabled
bboxtype     : Change bbox 1=Tiny,4=Short,5=Tall,7=Wide,8=Giant,10=Massive
gibondeath   : 1 = always explode in a shower of gibs on death
bodyfadeaway : Time (secs) before body/head will fade away (default=0)
movespeed    : -1 = no movement(turret), =0/1 free movement (default)
turrethealth : = 0.0->1.0; % of HP when monster is released 
turrettarget : Target(s) to fire when monster % HP is reached
-------- SPAWNFLAGS --------
AMBUSH   : Only wake up on seeing the player, not by other monsters
NOSIGHT  : No sight sound
NOIDLE   : No idle sound
NOGFX    : No spawn effect or sound when triggered
STARTOFF : Trigger Spawn
ANGRY    : Trigger Spawn angry at the player

-------- NOTES --------
XXX, x health points.


// Can be added to monsters (there are plenty of exceptions)
//--------------------------------------------------------------------------
attack_sniper: Wakes up a monster on sight of player at distance
attack_instant: Will instantly attack enemy, good for setup behind breakables
sighttarget  : Creates a group of monster that get angry together
height       : Amount of height (flying only) to be above player (def=128)
passive_state: Enable passive monster system (-1=DISABLE, 0=OFF, 1=ON)
poisonous    : Special skin + Poison debuff melee/range attack
jump_flag    : (-1 = no jump) Stops a jumping monster from jumping
tethertarget : target entity (path_corner) for tether system
tetherrange  : The circular range around tether entity (def=300)
tetherwait   : Amount of time to wait before returning (def=30)
minion_maxcount : Max amount of active minions allowed (def=5)
turrethealth  : % HP for a trigger event to happen (+releases turret monsters)
turrettarget  : Targets to fire when % HP turrethealth is reached
turrethealth2 : % HP for a trigger event to happen (must be < turrethealth)
turrettarget2 : Targets to fire when % HP turrethealth2 is reached

// Other entity keys that affect most monsters
// Not included in def because these are rare functionality
//--------------------------------------------------------------------------
spawndelay       : Time to wait before spawning (reqs start off spawnflag)
delaymonstercount: Exclude from initial monster count, wait for delay spawn
spawnnotelefrag  : Will wait for spawn location to be empty before spawning
spawnnosight     : Will only spawn if cannot see the player (timeout does exist)
spawnnosighttime : Time (def=30s) to wait before giving up and spawning
proj_noskycheck  : Stop checking for sky brushes (fps issue on large maps only)

// Extra stuff for certain monster types
//--------------------------------------------------------------------------
monster_boil
wait         : time between random squirts of blood (def = wait + rnd x wait)
t_width      : Trigger radius for detecting a player (def = 80 / 120)
death_dmg    : Explosive radius damage on death (def = 60)
poisonous    : Green blood, gibs and poison debuff attack with radius damage

monster_dprince
attack_lifetime : Time that plasma will stay active on floor for damage

monster_golem
frame        : statue frame to be frozen in. (default 48)

monster_knight
frame        : statue frame to be frozen in. (default 44)

monster_hell_knight
frame        : statue frame to be frozen in. (default 73)

monster_hell_pointknight
target       : target for electricity
target2      : trigger to fire when electricity stopped
pos1         : XYZ offset to start lightning (uses v_forward/v_right/v_up)
pos2         : XYZ random offset to start lightning (uses v_forward/v_right/v_up)
pos3         : Animation lightning frame set (Start/Finish/Direction)
t_length     : random wobble to electricity target origin (0=def 5)
dmg          : amount of contact damage with electricity (0=def 5)

monster_seeker
state        : start with one arm removed 1=Left, 2=Right

monster_shambler
poisonous    : Green skin + Poison debuff attack on melee claws
attack_sniper: 1 = Lightning attack has no range limit (previous 600 units)

monster_skullwiz
target2      : A chain of info_skullwiz_destination entities for exact teleports
bodyphased   : Spawn phased out and wait to see player
bodystatic   : Prevents skull wizard from teleporting
height       : Maximum Z distance to search for teleport destination
distmin      : Minimum XY distance to search for teleport destination
destmax      : Maximum XY distance to search for teleport destination

monster_tarbaby
death_dmg    : Damage on Death (def=120)
poisonous    : 0=Jump attack (default, 1=Poison attack)
exactskin    : 0-1=Blue, 2-3=Green1, 4-5=Green2, 6-7=Green3

monster_turretbal
t_length      : Axis restriction for ceiling/floor version
t_width       : 2nd axis restriction for wall version
attack_count  : =-1 to disable increased fire rate
turretclosing : target(s) fired when turret hides back wall/ceil/floor
turretopening : target(s) fired when turret is coming out to play
turretlocked  : Turret will not hide and remain in combat
distance      : The range at which the turret will hide (def=600)
waitmin       : Time (def=2s) will pause before hiding if cannot see enemy
waitmin2      : Time (def=2s) to wait hidden before coming out again
waitmin3      : Time (def=2s) startup delay when spawning at start of map
wakeup_angle  : Angle lock boundary adjustment when turret is closed

monster_zombiek
aflag        : 0 = random, 1 = Facing down, 2 = Facing up - only for onfloor setup

======================================================================*/
