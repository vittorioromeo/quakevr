// AD defines is prefixed "ad_" (ARCANE_DIMENSIONS.md 5.2). Do not edit; change the importer.

/*======================================================================
 ITEM PROGRESSION SYSTEM
 
 * All spawn markers have the same item to pickup
 * The list determines the order the players gets items
 * Can only work with ITEM class types (no monsters etc)
 * The entity state system does not work with this system
 * Can have multiple progression lists in the same map
 * Extensive error and info checking reported to console
 * Works very closely with item touch2 functions
 
======================================================================*/
 
float ad_PROG_NOTELEFX = 32;	// No teleport FX at spawn marker
 
//======================================================================
/*ad:QUAKED item_progspawn (1 .8 .2) (-16 -16 0) (16 16 56) x x x x x NOTELEFX x x NOT_EASY NOT_NORMAL NOT_HARD NOT_DM
Spawn location for progression list
-------- KEYS --------
targetname : Must exist and be the same for all markers in same list
target  : Must point to the first item in the progresion list
target2 : targets to fire when the spawn marker is used
message : message to display when triggered
-------- SPAWNFLAGS --------
NOTELEFX    : No tele FX effect when changing item at spawn marker
-------- NOTES --------
Spawn location for progression list

======================================================================*/
void(entity ad_targ) ad_item_proglist_setup =
{
	if (!(ad_targ.flags & ad_FL_ITEM)) return;// Only works with items

	ad_targ.touch = ad_targ.think = ad_SUB_Null;	// No more thinking/animation
	ad_targ.nextthink = -1;				// Never fire think
	ad_targ.effects = 0;					// reset effects
	ad_targ.modelindex = 0;				// Make sure no model
	setmodel (ad_targ, "");				// invisible
	setsize (ad_targ, ad_VEC_ORIGIN, ad_VEC_ORIGIN);	// No size, no impact
	ad_targ.movetype = ad_MOVETYPE_NONE;		// Stationary
	ad_targ.solid = ad_SOLID_NOT;				// no world interaction
	ad_targ.ad_estate = ad_ESTATE_OFF;			// Entity state off
	ad_targ.takedamage = ad_DAMAGE_NO;		// No pain/death triggers
	ad_targ.velocity = ad_targ.avelocity = '0 0 0';	// Frozen inplace
};

//----------------------------------------------------------------------
void() ad_item_progspawn_animateskin = 
{
	// Spawn marker turned off?
	if (self.state == ad_STATE_OFF) return;
	// Skin animation disabled
	if (self.ad_item_skinanim == ad_FALSE) return;
	
	// Increase animation skin number, check range
	self.ad_item_skinanim_no = self.ad_item_skinanim_no + 1;
	if (self.ad_item_skinanim_no > ad_MODEL_ANIM_RANGE) {
		self.ad_item_skinanim_no = 0;
	}
	// Update skin
	self.skin = self.ad_item_skinanim_no;

	// Keep looping (slower than usual think timer)
	self.think = ad_item_progspawn_animateskin;
	self.nextthink = time + (ad_MODEL_ANIM_SPEED * 0.1);
};

//----------------------------------------------------------------------
void(vector ad_org) ad_item_progspawn_fx =
{
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_TELEPORT);
	WriteCoord (ad_MSG_BROADCAST, ad_org_x);
	WriteCoord (ad_MSG_BROADCAST, ad_org_y);
	WriteCoord (ad_MSG_BROADCAST, ad_org_z);
};

//----------------------------------------------------------------------
void(entity ad_targ) ad_item_progspawn_off =
{
	ad_targ.movetype = ad_MOVETYPE_NONE;
	ad_targ.solid = ad_SOLID_NOT;
	setmodel (ad_targ, "");
	setsize (ad_targ, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	// Turn off any ammo lids
	if (ad_targ.ad_attachment) {
		setmodel(ad_targ.ad_attachment,"");
		setsize(ad_targ.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	}
	// Turn off spawn marker and skin animation
	ad_targ.state = ad_STATE_OFF;
	ad_targ.ad_item_skinanim = ad_FALSE;
	
	// Are particles enabled?
	if (ad_query_configflag(ad_SVR_PARTICLES) && ad_targ.ad_part_emitter)
		// Always switch particle emitter off
		ad_misc_particle_off(ad_targ.ad_part_emitter);
};

//----------------------------------------------------------------------
void(entity ad_targ, entity ad_spnlist) ad_item_progspawn_on =
{
	ad_targ.movetype = ad_MOVETYPE_NONE;
	ad_targ.solid = ad_SOLID_TRIGGER;
	ad_targ.skin = ad_targ.frame = 0;
	setmodel (ad_targ, ad_spnlist.mdl);
	setsize (ad_targ, ad_spnlist.ad_bbmins, ad_spnlist.ad_bbmaxs);
	setorigin (ad_targ, ad_targ.oldorigin);
	ad_targ.velocity = '0 0 0';
	ad_targ.angles = '0 0 0';
	ad_targ.state = ad_STATE_ON;
	ad_targ.ad_estate = ad_ESTATE_ON;

	// Keys, Runes and Artifacts are setup -24 map units lower
	// Shift the models back up by adding a double negative
	if (ad_spnlist.ad_bbmins_z < 0) ad_targ.origin_z = ad_targ.oldorigin_z - ad_spnlist.ad_bbmins_z;
	
	// Update particle emitter style
	ad_targ.ad_part_active = ad_spnlist.ad_part_active;
	ad_targ.ad_respawn_style = ad_spnlist.ad_respawn_style;
	ad_targ.ad_respawn_ofs = ad_spnlist.ad_respawn_ofs;

	// Some particle styles read item inventory
	ad_targ.items = ad_spnlist.items;
	ad_targ.ad_moditems = ad_spnlist.ad_moditems;
	
	// Are particles enabled? (quake.rc option)
	if (ad_query_configflag(ad_SVR_PARTICLES) == ad_SVR_PARTICLES) {
		// Is item particle effects blocked?
		if (ad_spnlist.spawnflags & ad_ITEM_NOEFFECTS && ad_targ.ad_part_emitter)
			ad_misc_particle_off(ad_targ.ad_part_emitter);
		// Is the particle style defined?
		else if (ad_targ.ad_part_active < 1 && ad_targ.ad_part_emitter)
			ad_misc_particle_off(ad_targ.ad_part_emitter);
		// Can't do anything if no particle style
		else if (ad_targ.ad_part_active > 0) {
			// Has the particle emitter been created?
			if (!ad_targ.ad_part_emitter)
				ad_targ.ad_part_emitter = ad_spawn_pemitter(ad_targ, ad_targ, ad_targ.ad_part_active, ad_PARTICLE_START_ON);
			else {
				// Make sure the particle style is updated
				ad_targ.ad_part_emitter.ad_part_style = ad_targ.ad_part_active;
				ad_misc_particle_style(ad_targ.ad_part_emitter);
				ad_misc_particle_on(ad_targ.ad_part_emitter);
			}
		}
	}
	
	// Setup special lid and frame poses for ammo boxes only
	if (ad_spnlist.ad_classgroup == ad_CG_AMMOITEM) {
		// Setup random rotation or fixed angle (defined on item)
		if (ad_spnlist.angles_y < 1) ad_targ.angles_y = rint(random()*359);
		else ad_targ.angles = ad_spnlist.angles;
		
		// Setup extra frames for rockets/plasma
		if (ad_spnlist.ad_frame_override) {
			// frame options -1=random 0=nothing, 1-7=exact
			// Always generate a new frame number for respawning items
			if (ad_spnlist.ad_frame_box == -1) ad_targ.frame = rint(1 + random()*6);
			else if (ad_spnlist.ad_frame_box > 7) ad_spnlist.ad_frame_box = 1;
			if (ad_spnlist.ad_frame_box > 0) ad_targ.frame = ad_spnlist.ad_frame_box;
			// Turn off any ammo lids
			if (ad_targ.ad_attachment) {
				setmodel(ad_targ.ad_attachment,"");
				setsize(ad_targ.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
			}
		}
		// Setup lid attachment
		else if (ad_spnlist.spawnflags & ad_A_LID && ad_spnlist.ad_headmdl != "") {
			if (!ad_targ.ad_attachment) {
				ad_targ.ad_attachment = spawn();
				ad_targ.ad_attachment.owner = ad_targ;
			}
			// Setup LID attachment entity (match angles/origin)
			ad_targ.ad_attachment.solid = ad_SOLID_NOT;
			ad_targ.ad_attachment.movetype = ad_targ.movetype;
			setmodel(ad_targ.ad_attachment, ad_spnlist.ad_headmdl);
			// Give the lid the same bbox setup so it can move
			setsize (ad_targ.ad_attachment, ad_targ.mins, ad_targ.maxs);
			// Start lid off the ground and remove ground flag
			// This will let the lid naturally settle on the surface
			setorigin(ad_targ.ad_attachment, ad_targ.origin + '0 0 1');
			ad_targ.ad_attachment.flags = ad_targ.ad_attachment.flags - (ad_targ.ad_attachment.flags & ad_FL_ONGROUND);
			// Match angle and stored frame setup from ammo box
			ad_targ.ad_attachment.angles = ad_targ.angles;
			
			// lid frame options 0=random, 1-7=exact
			// Always generate a new lid position for respawning items
			if (ad_spnlist.ad_frame_box == 0) ad_targ.ad_attachment.frame = rint(1 + random()*6);
			else if (ad_spnlist.ad_frame_box > 7) ad_spnlist.ad_frame_box = 1;
			if (ad_spnlist.ad_frame_box > 0) ad_targ.ad_attachment.frame = ad_spnlist.ad_frame_box;
			
			// LID has different skins for shells and spikes
			if (ad_targ.ad_classtype == ad_CT_AMMOSHELLS) ad_targ.ad_attachment.skin = ad_targ.skin;
			else ad_targ.ad_attachment.skin = 2 + ad_targ.skin;
		}
	}
	
	// Skin Exceptions and Animations
	if (ad_spnlist.ad_classgroup == ad_CG_ARMOR) ad_targ.skin = ad_spnlist.skin;
	else if (ad_spnlist.ad_classgroup == ad_CG_KEY) ad_targ.skin = ad_spnlist.skin;
	else if (ad_spnlist.ad_classtype == ad_CT_AMMOITEMPACK) ad_targ.skin = ad_spnlist.ad_exactskin;
	else if (ad_spnlist.ad_classgroup == ad_CG_HEALTH && ad_spnlist.ad_item_skinanim) {
		ad_targ.ad_item_skinanim = ad_spnlist.ad_item_skinanim;
		ad_targ.ad_item_skinanim_no = 0;
		ad_targ.think = ad_item_progspawn_animateskin;
		ad_targ.nextthink = time + 0.1;
	}
};

//----------------------------------------------------------------------
void() ad_item_progspawn_touch =
{
	local entity ad_oself;
	
	// ----------------------------------------------------------------
	// SELF  = spawn marker (only works once)
	// OTHER = always player (lots of checks at beginning)
	// SELF.OWNER = List Controller
	// SELF.OWNER.STATE = off means its finished or broken
	// SELF.OWNER.TARGET = Targetname of NEXT item in list
	// SELF.OWNER.MOVETARGET = Entity of NEXT item
	// SELF.OWNER.TARGET2 = Targetname of all spawn marker(s)	
	// ----------------------------------------------------------------
	
	// Duplicate of item_touch functionality
	if (self.ad_touchedvoid) {ad_entity_hide(self); return;}
	// Various player checks
	if ( !(other.flags & ad_FL_CLIENT) ) return;
	if ( other.health < 1 ) return;
	if ( other.flags & ad_FL_NOTARGET ) return;
	
	// Has been used ONCE already or disabled?
	if (self.state == ad_STATE_OFF) return;
	// Is the progression list controller active?
	if (self.owner.state == ad_STATE_OFF) return;

	// PICKUP CONDITIONS
	// ----------------------------------------------------------------
	if (self.owner.ad_movetarget.ad_classgroup == ad_CG_HEALTH) {
		if (ad_health_pickupcondition(other, self.owner.ad_movetarget)) return;		
	}
	else if (self.owner.ad_movetarget.ad_classgroup == ad_CG_ARMOR) {
		if (ad_armor_pickupcondition(other, self.owner.ad_movetarget)) return;		
	}
	else if (self.owner.ad_movetarget.ad_classgroup == ad_CG_AMMOITEM) {
		if (ad_ammo_pickupcondition(other, self.owner.ad_movetarget)) return;
	}
	else if (self.owner.ad_movetarget.ad_classgroup == ad_CG_KEY) {
		if (ad_key_pickupcondition(other, self.owner.ad_movetarget)) return;
	}
	else if (self.owner.ad_movetarget.ad_classgroup == ad_CG_RUNE) {
		if (ad_sigil_pickupcondition(self.owner.ad_movetarget)) return;
	}
	
	// Spawn markers only work ONCE, switch it off
	ad_item_progspawn_off(self);
	// Fire any targets/messages on the spawn marker
	if (self.ad_target2 != "") ad_trigger_strs(self.ad_target2, other);
	if (self.message != "") ad_centerprint (other, self.message);
	
	// ITEM FUNCTIONALITY
	// ----------------------------------------------------------------
	// Need to switch around self (item) otherwise the item touch
	// functions won't work. The .other should still be a player
	if (self.owner.ad_movetarget.ad_touch2) {
		ad_oself = self; self = self.owner.ad_movetarget;
		self.ad_touch2();
		self = ad_oself;
	}

	// PROGRESSION LIST (All error checking done in controller setup)
	// ----------------------------------------------------------------
	// Reached the end of the list?
	if (self.owner.ad_movetarget.target == "") self.owner.state = ad_STATE_OFF;
	else {
		// Find next entity in progression list
		self.goalentity = find(world, targetname, self.owner.ad_movetarget.target);
		// Entity not found? -> end of list condition
		if (!self.goalentity) self.owner.state = ad_STATE_OFF;
		else self.owner.ad_movetarget = self.goalentity;
	}

	// SPAWN MARKERS
	// ----------------------------------------------------------------
	self.goalentity = find(world, targetname, self.owner.ad_target2);
	while (self.goalentity) {
		// End of list? reset all markers to off
		if (self.owner.state == ad_STATE_OFF) ad_item_progspawn_off(self.goalentity);
		// List is active, check which spawn markers are active
		else if (self.goalentity.state == ad_STATE_ON) {
			// Show teleporter particle effect?
			if (!(self.goalentity.spawnflags & ad_PROG_NOTELEFX)) 
				ad_item_progspawn_fx(self.goalentity.origin);
			// Switch marker to new item
			ad_item_progspawn_on(self.goalentity, self.owner.ad_movetarget);
		}
		// default = Spawn marked off/disabled
		else ad_item_progspawn_off(self.goalentity);
			
		// Find next spawn marker in list
		self.goalentity = find(self.goalentity, targetname, self.owner.ad_target2);
	}
};

//----------------------------------------------------------------------
void() ad_item_proglist_controller_setup =
{
	local float ad_error_ekey, ad_error_flag, ad_error_targ, ad_error_spawn;
	local float ad_exit_targ, ad_respawn_spnflag, ad_float_spnflag, ad_coop_warning;
	
	// Setup counters for total list items and spawn markers
	self.waitmin = self.ad_waitmin2 = 0;
	// Setup all error conditions
	ad_error_ekey = ad_error_flag = ad_error_targ = ad_error_spawn = ad_FALSE;
	ad_exit_targ = ad_coop_warning = ad_respawn_spnflag = ad_float_spnflag = ad_FALSE;

	// All these error checks are done on the controller so that
	// they only happen once, otherwise all spawn markers would
	// generate them to the console! (too much spam)
	//
	// CHECK progression list for errors
	self.ad_sighttarget = self.target;
	self.goalentity = find(world, targetname, self.ad_sighttarget);
	dprint("\b[-- Progression List Info --]\b\n"); 
	dprint("--------------------------------------\n");
	dprint("No Ekey Item Targ Class\n");
	while (self.goalentity) {
		// Increase counter and setup next target string
		self.waitmin = self.waitmin + 1;
		self.ad_sighttarget = self.goalentity.target;
		
		// Zero pad list numbers (alignment reasons)
		if (self.waitmin < 9) dprint("0");
		dprint(ftos(self.waitmin));
		// All entities in list have to marked with new entity key
		if (self.goalentity.ad_progspawnlist) dprint(" Yes ");
		else { dprint(" No  "); ad_error_ekey = ad_TRUE; }
		// All entities in list have to be ITEM class
		if (self.goalentity.flags & ad_FL_ITEM) dprint(" Yes ");
		else { dprint(" No  "); ad_error_flag = ad_TRUE; }
		// Some entities don't work well with prog lists + coop
		if (self.goalentity.ad_classgroup == ad_CG_KEY) ad_coop_warning = ad_TRUE;
		// Don't need respawn or float spawnflags
		if (self.goalentity.spawnflags & ad_ITEM_RESPAWN) ad_respawn_spnflag = ad_TRUE;
		if (self.goalentity.spawnflags & ad_ITEM_FLOATING) ad_float_spnflag = ad_TRUE;
		
		// FATAL ERROR: Empty target strings when used with the
		// FIND command will return player entity instead of world!
		if (self.goalentity.target != "") dprint(" Yes ");
		else { dprint(" END "); ad_exit_targ = ad_TRUE; }
		// Finally show item class type (good for multiple lists)
		dprint(" "); dprint(self.goalentity.classname);
		dprint("\n");
		
		// Any FATAL exit conditions found yet?
		if (ad_exit_targ) self.goalentity = world;
		else {
			// Find next entity in prog list
			self.goalentity = find(world, targetname, self.ad_sighttarget);
			// Check for 2nd entity target being setup wrong
			if (self.waitmin == 1 && !self.goalentity) ad_error_targ = ad_TRUE;
		}
		
	}
	// Close table
	dprint("--------------------------------------\n");

	// CHECK spawn markers for errors
	self.goalentity = find(world, targetname, self.ad_target2);
	while (self.goalentity) {
		// Count spawn markers
		self.ad_waitmin2 = self.ad_waitmin2 + 1;
		// All spawn markers need to be same entity type
		if (self.goalentity.ad_classtype != ad_CT_PROGSPAWN)
			ad_error_spawn = ad_TRUE;
		// Find next spawn marker
		self.goalentity = find(self.goalentity, targetname, self.ad_target2);
	}
	
	// ERROR check if entity key is defined on all of list?
	if (ad_error_ekey) {
		dprint("\b[PROG_LIST]\b missing progspawnlist key!\n");
		ad_spawn_marker(self.ad_movetarget.origin, ad_SPNMARK_YELLOW);
		self.state = ad_STATE_OFF;
	}
	// ERROR check if prog list contains wrong entity types?
	if (ad_error_flag) {
		dprint("\b[PROG_LIST]\b wrong entity type!\n");
		ad_spawn_marker(self.ad_movetarget.origin, ad_SPNMARK_YELLOW);
		self.state = ad_STATE_OFF;
	}
	// ERROR check if progression list ONLY has 1 item
	if (self.waitmin == 1) {
		dprint("\b[PROG_LIST]\b Only 1 item in list!\n");
		ad_spawn_marker(self.ad_movetarget.origin, ad_SPNMARK_YELLOW);
		self.state = ad_STATE_OFF;
	}
	// ERROR check if 2nd item in list actually exists?
	if (self.waitmin == 1 && ad_error_targ) {
		dprint("\b[PROG_LIST]\b 2nd list item missing!\n");
		ad_spawn_marker(self.ad_movetarget.origin, ad_SPNMARK_YELLOW);
		self.state = ad_STATE_OFF;
	}
	// WARNINGS if extra spawnflags are used on items
	if (ad_respawn_spnflag)
		dprint("\b[PROG_LIST]\b RESPAWN spawnflag ignored!\n");
	
	// ERROR check if spawn markers contain wrong entity types?
	if (ad_error_spawn) {
		dprint("\b[PROG_SPN]\b wrong entity type!\n");
		ad_spawn_marker(self.ad_movetarget.origin, ad_SPNMARK_YELLOW);
		self.state = ad_STATE_OFF;
	}
	// ERROR check if list & spawn totals match up?
	if (self.waitmin != self.ad_waitmin2) {
		dprint("\b[TOTAL]\b List ("); dprint(ftos(self.waitmin));
		dprint(") Spn ("); dprint(ftos(self.ad_waitmin2));
		dprint(") Dont match!\n");
		ad_spawn_marker(self.ad_movetarget.origin, ad_SPNMARK_YELLOW);
		self.state = ad_STATE_OFF;
	}

	// Any errors occured? - Close table
	if (self.state == ad_STATE_OFF)
		dprint("--------------------------------------\n\n");
	else {
		// FINALLY Setup all spawn markers
		self.goalentity = find(world, targetname, self.ad_target2);
		while (self.goalentity) {
			// Create touch functionality
			self.goalentity.touch = ad_item_progspawn_touch;
			// Copy over first item in list to spawn marker
			ad_item_progspawn_on(self.goalentity, self.ad_movetarget);
			// Setup link back to controller
			self.goalentity.owner = self;
			// Find next spawn marker
			self.goalentity = find(self.goalentity, targetname, self.ad_target2);
		}
		
		// Display progression list setup information
		dprint("\bTOTALS\b List ("); dprint(ftos(self.waitmin));
		dprint(") Spawns ("); dprint(ftos(self.ad_waitmin2));
		dprint(")\n\n");
	}
};

//----------------------------------------------------------------------
void() ad_item_proglist_controller = 
{
	// The first item in the progression list is unique, this
	// would be the perfect location for the controller.
	// Has it been setup yet?
	if (!self.ad_movetarget.ad_progspawncont) {
		self.ad_movetarget.ad_progspawncont = spawn();
		self.ad_movetarget.ad_progspawncont.ad_classtype = ad_CT_CONTROL;
		self.ad_movetarget.ad_progspawncont.ad_classgroup = ad_CG_PROGRESSION;
		self.ad_movetarget.ad_progspawncont.solid = ad_SOLID_NOT;
		self.ad_movetarget.ad_progspawncont.movetype = ad_MOVETYPE_NONE;
		setorigin(self.ad_movetarget.ad_progspawncont, self.ad_movetarget.origin+'0 0 32');
		setsize(self.ad_movetarget.ad_progspawncont, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		// Always have a link to first item, as it can change
		self.ad_movetarget.ad_progspawncont.owner = self.ad_movetarget;
		
		// TARGET (string)  = targetname of first item in list
		// MOVETARGET (ent) = entity pointer to start of list
		// TARGET2 (string) = spawn markers (never changes)
		
		// Start of the progression list
		self.ad_movetarget.ad_progspawncont.target = self.target;
		self.ad_movetarget.ad_progspawncont.ad_movetarget = self.ad_movetarget;
		// All Spawn marker(s) should be same name
		self.ad_movetarget.ad_progspawncont.ad_target2 = self.targetname;
		
		// Start controller in ON state (errors switch it off)
		self.ad_movetarget.ad_progspawncont.state = ad_STATE_ON;

		// Allow for all entities to spawn and link
		self.ad_movetarget.ad_progspawncont.nextthink = time + 0.5;
		self.ad_movetarget.ad_progspawncont.think = ad_item_proglist_controller_setup;	
	}
};

//----------------------------------------------------------------------
void() ad_item_progspawn_setup =
{
	// Cannot use this spawn if targetname missing
	if (self.targetname == "") {
		dprint("\b[PROG_SPN]\b targetname is missing!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}
	// Target has to point to first item in list!
	if (self.target == "") {
		dprint("\b[PROG_SPN]\b target is missing!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}	
	// Find target entity (Does entity actually exist!)
	self.ad_movetarget = find(world, targetname, self.target);
	if (!self.ad_movetarget) {
		dprint("\b[PROG_SPN]\b missing target entity!\n");
		ad_spawn_marker(self.origin, ad_SPNMARK_YELLOW);
		ad_entity_hide(self);
		return;
	}
	// Spawn location ready for items
	self.state = ad_STATE_ON;
	// Setup and enable controller entity
	ad_item_proglist_controller();
};

//----------------------------------------------------------------------
void() ad_item_progspawn =
{
	self.ad_classtype = ad_CT_PROGSPAWN;
	self.ad_classgroup = ad_CG_PROGRESSION;

	// No world interaction or movement
	self.solid = ad_SOLID_NOT;
	self.movetype = ad_MOVETYPE_NONE;
	self.ad_bbmins = self.ad_bbmaxs = ad_VEC_ORIGIN;
	setsize(self, self.ad_bbmins, self.ad_bbmaxs);
	self.oldorigin = self.origin;
	
	// reset all values to zero (used later)
	self.angles = '0 0 0';
	self.skin = self.frame = 0;
	self.velocity = self.avelocity = '0 0 0';
	self.state = ad_STATE_OFF;
	
	// Allow time for everything to spawn
	self.nextthink = time + 0.1 + (random()*0.4);
	self.think = ad_item_progspawn_setup;	
};
