void() ad_spider_bite6 = [ $atkloop1, ad_spider_bite7 ] {ad_ai_face();};
void() ad_spider_bite7=[ $atkloop3, ad_spider_bite8 ] {ad_ai_face();};
void() ad_spider_bite8 = [ $atkloop5, ad_spider_bite9 ] {ad_spider_melee();};
