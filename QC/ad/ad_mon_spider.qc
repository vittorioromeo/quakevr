//======================================================================
// BITE - Both spider types can bite if within range
//======================================================================
void() ad_spider_melee =
{
	local float ad_ldmg;

	if (!self.enemy) return;
	if (self.health < 1) return;
		
	ad_ai_charge(10);									// Get closer for extra bite
	ad_ai_damagebreakable(10);							// Damage any breakables
	if (!(ad_ai_checkmelee(ad_MONAI_MELEESPIDER,ad_FALSE) && VR_MeleeArc_Hits(FALSE))) return;	// Too far away // AD support: melee arc (fight.qc VR_MeleeArc_Hits)

	// Can the target bleed?
	if (!self.enemy.takedamage) return;

	if (random() < 0.5) sound(self, ad_CHAN_WEAPON, "spider/attackmunch.wav", ad_TRUE, ad_TRUE);
	else sound(self, ad_CHAN_WEAPON, "spider/attacktear.wav", ad_TRUE, ad_TRUE);

	// Spider bite (damage 1-9) is very weak
	ad_ldmg = (random() + random() + random()) * 3;
	if (ad_ldmg < 1) ad_ldmg = 1;
	ad_T_Damage (self.enemy, self, self, ad_ldmg, ad_DAMARMOR);

	// Check for poisonous attribute (generally green spider)
	if (self.ad_poisonous) ad_PoisonDeBuff(self.enemy);
	
	// Spawn blood at mouth of spider
	ad_spawn_touchblood (self, self.enemy, ad_ldmg*3);
};

