void() ad_spider_bite10 = [ $atkloop9, ad_spider_bite11 ] {
	if (ad_ai_checkmelee(ad_MONAI_MELEESPIDER,ad_FALSE) && self.enemy.health > 0 && self.health > 0) 
		self.think = ad_spider_bite6;};
// Exit bite attack loop
void() ad_spider_bite11 = [ $atkup7, ad_spider_bite12 ] {};
void() ad_spider_bite12 = [ $atkup5, ad_spider_run1 ] {};

//============================================================================
// SPIDER 1 - JUMP FUNCTION (range)
//============================================================================
void()	ad_Spider_JumpTouch =
{
	local	float	ad_ldmg;

	if (self.health <= 0) return;
	ad_ai_jumpbreakable(20);			// Damage any breakables
	self.touch = ad_SUB_Null;			// No more touching
	self.count = self.count + 1;	// Total amount of touch jumps
	self.think = self.ad_th_jumpexit;	// Exit frame
	self.ad_jumptouch = other;			// Keep track of touch target

	// Do not damage other spiders with jump attacks
	// Prevents packs from killing themselves
	if (self.ad_classgroup != other.ad_classgroup && other.takedamage) {
		if ( vlen(self.velocity) > 300 ) {
			ad_ldmg = 5 + 5*random();
			ad_T_Damage (other, self, self, ad_ldmg, ad_DAMARMOR);	
			// Spawn some touch blood (no explicit direction)
			ad_spawn_touchblood (self.enemy, self.enemy, ad_ldmg*3);
		}
	}

	// Is the spider floating in the air?
	if (!checkbottom(self)) {
		// Is the spider standing on something?		
		if (self.flags & ad_FL_ONGROUND) {	
			// Do an extra jump if got the count
			if (self.count < 2)  self.think = self.ad_th_jump;
		}
	}

	// Next timer
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------------
void() ad_spider_leap1 =[ $jump1, ad_spider_leap2 ] {ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	ad_monster_idle_sound();
};
void() ad_spider_leap2 =[ $jump3, ad_spider_leap3 ] {ad_ai_face();};
void() ad_spider_leap3 =[ $jump5, ad_spider_leap4 ] {
	ad_ai_face();
	self.jump_flag = time + ad_MONAI_JUMPTIMEOUT; // Stop jumping so much
	self.touch = ad_Spider_JumpTouch;
	makevectors (self.angles);
	self.velocity = (v_forward*self.ad_jumpdist_x) + ('0 0 1'*self.ad_jumpdist_z);
	self.origin_z = self.origin_z + 4;
	self.flags = self.flags - (self.flags & ad_FL_ONGROUND);
	self.oldorigin = self.origin;
};
void() ad_spider_leap4 =[ $jump7, ad_spider_leap5 ] {};
void() ad_spider_leap5 =[ $jump8, ad_spider_leap6 ] {};	
void() ad_spider_leap6 =[ $jump9, ad_spider_leap7 ] {};
void() ad_spider_leap7 =[ $jump10, ad_spider_leap8 ] {
	// Double check monster is still falling?
	if (ad_CheckZeroVector(self.velocity) || self.oldorigin == self.origin) {
		self.ideal_yaw = random() * 360; //random jump angle
		self.think = ad_spider_leap3;
	}
	self.oldorigin = self.origin;
};

