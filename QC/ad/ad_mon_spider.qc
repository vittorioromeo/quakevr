//----------------------------------------------------------------------
void() ad_spider_droptouch =
{
	// Check if landed on something that is not the ground?
	if (!checkbottom(self)) {
		// Is the spider standing on something?
		if (self.flags & ad_FL_ONGROUND) {
			self.flags = self.flags - ad_FL_ONGROUND;
			self.origin_z = self.origin_z + 8;
			setorigin(self, self.origin);		// raise up
			self.ad_attack_timer = time + 1;		// reset timer
			
			makevectors (self.angles);
			self.velocity = v_forward * 100 + '0 0 200';
		}
		return;
	}

	// No more flying, back to running
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_STEP;
	setsize(self, self.ad_bbmins, self.ad_bbmaxs);

	// Reset view offset (based on bbox height)
	self.view_ofs = '0 0 0';
	self.view_ofs_z = self.maxs_z*0.5;

	self.touch = ad_SUB_Null;			// No more jump touching
	ad_FoundHuntTarget(ad_TRUE);			// Setup goals and warn other monsters
	if (self.enemy.flags & ad_FL_CLIENT) ad_monster_sightsound();

	// Restore all think state functions (spider is off the ceiling)
	self.ad_th_stand = ad_spider_idle1;
	self.ad_th_walk = ad_spider_walk1;
	self.ad_th_run = ad_spider_run1; 
	self.ad_th_slide = ad_spider_slide1;
	self.ad_th_melee = ad_spider_bite1;

	// Spider 1 and 2 have different range attacks
	if (self.spawnflags & ad_MON_SPIDER_LARGE) self.ad_th_missile = ad_spider_spit1;
	else self.ad_th_jump = ad_spider_leap1;

	// Back to running or standing around!
	if (!self.enemy) self.think = self.ad_th_stand;
	else self.think = self.ad_th_run;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void()	ad_spider_drop1 =[	$drop1,	ad_spider_drop2 ] {};
void()	ad_spider_drop2 =[	$drop2,	ad_spider_drop3 ] {};
void()	ad_spider_drop3 =[	$drop3,	ad_spider_drop4 ] {};
void()	ad_spider_drop4 =[	$drop4,	ad_spider_drop5 ] {};
void()	ad_spider_drop5 =[	$drop5,	ad_spider_drop6 ] {};
void()	ad_spider_drop6 =[	$drop6,	ad_spider_drop6 ] {
	if (self.ad_attack_timer < time || self.velocity_z == 0) ad_spider_droptouch();
};

//----------------------------------------------------------------------------
void() ad_spider_wakeup =
{
	// Dead already?
	if (self.health < 1) return;
		
	// Only call wakeup function once
	self.ad_th_walk = self.ad_th_run = self.ad_th_slide = ad_SUB_Null;

	// No longer need cling to ceiling spawnflag, remove it
	self.spawnflags = self.spawnflags - (self.spawnflags & ad_MON_SPIDER_CEILING);

	self.flags = ad_FL_MONSTER;			// reset flags
	
	if (ad_engine == ad_ENG_FITZ) self.origin_z = self.origin_z - 8;
	else self.origin_z = self.origin_z - 32;	// Unstick from ceiling
	setorigin(self, self.origin);		// Move down slightly
	
	self.movetype = ad_MOVETYPE_TOSS;		// Affected by gravity
	self.solid = ad_SOLID_SLIDEBOX;
	self.ad_attack_timer = time + 1;		// Stuck timer

	self.ad_classmove = ad_MON_MOVEWALK;		// Back to walking/running 
	self.ad_pain_finished = time + 1.5;	// No pain
	ad_SUB_AttackFinished(2 + random());	// No attacking
		
	makevectors (self.angles);			// Move towards face direction
	self.velocity = v_forward * 50;		// Slight nudge forward

	self.touch = ad_spider_droptouch;		// Touch something?
	if (!self.jump_flag) 
	self.jump_flag = time + 1 + random()*2;	// Don't jump straight away
	ad_spider_drop1();						// Turn around, cat tricks!
};

//======================================================================
// MINION - Grow and spin up from nothing
//======================================================================
void() ad_spider_growangle = {self.angles_y = self.angles_y + self.lefty;};
void() ad_spider_grow1 = [ $grow1, ad_spider_grow2 ] {};
void() ad_spider_grow2 = [ $grow2, ad_spider_grow3 ] {ad_spider_growangle();};
void() ad_spider_grow3 = [ $grow3, ad_spider_grow4 ] {ad_spider_growangle();};
void() ad_spider_grow4 = [ $grow4, ad_spider_grow5 ] {ad_spider_growangle();};
void() ad_spider_grow5 = [ $grow5, ad_spider_grow6 ] {ad_spider_growangle();};
void() ad_spider_grow6 = [ $grow6, ad_spider_grow7 ] {ad_spider_growangle();};
void() ad_spider_grow7 = [ $grow7, ad_spider_grow8 ] {ad_spider_growangle();};
void() ad_spider_grow8 = [ $grow8, ad_spider_grow9 ] {ad_spider_growangle();};
void() ad_spider_grow9 = [ $grow9, ad_spider_grow10] {ad_spider_growangle();};
void() ad_spider_grow10= [ $grow10, ad_spider_run1 ] {
	// Is the spider stuck? cannot move?
	if (pointcontents(self.origin) == ad_CONTENT_SOLID) {
		// Time to die!
		self.health = self.ad_gibhealth;
		ad_Killed(self, self);
	}
	else {
		// Finally spin back to original position
		self.angles_y = self.angles_y + self.lefty;
		// Setup goals and warn other monsters
		ad_FoundHuntTarget(ad_TRUE);

		// Restore all think state functions
		self.ad_th_stand = ad_spider_idle1;
		self.ad_th_walk = ad_spider_walk1;
		self.ad_th_run = ad_spider_run1; 
		self.ad_th_slide = ad_spider_slide1;
		self.ad_th_melee = ad_spider_bite1;
		// Spider 1 and 2 have different range attacks
		if (self.spawnflags & ad_MON_SPIDER_LARGE) self.ad_th_missile = ad_spider_spit1;
		else {
			self.ad_th_jump = ad_spider_leap1;
			self.ad_th_jumpexit = ad_spider_leap9;
		}
	}
};

//----------------------------------------------------------------------------
void() ad_spider_grow =
{
	// Only call wakeup function once
	self.ad_th_stand = self.ad_th_walk = self.ad_th_run  = ad_SUB_Null;
	if (random() < 0.5) self.lefty = 36;
	else self.lefty = -36;
	ad_monster_sightsound();
	ad_spider_grow1();
};

//============================================================================
void() ad_spider_paind1	=[	$paindown1,	ad_spider_paind2	] {};
void() ad_spider_paind2	=[	$paindown3,	ad_spider_paind3	] {};
void() ad_spider_paind3	=[	$paindown5,	ad_spider_paind4	] {};
void() ad_spider_paind4	=[	$paindown7,	ad_spider_paind5	] {};
void() ad_spider_paind5	=[	$paindown9,	ad_spider_run1	] {};

//----------------------------------------------------------------------------
// Front legs up (in melee or missile attack)
void() ad_spider_painu1	=[	$painup1,	ad_spider_painu2	] {};
void() ad_spider_painu2	=[	$painup3,	ad_spider_painu3	] {};
void() ad_spider_painu3	=[	$painup5,	ad_spider_painu4	] {};
void() ad_spider_painu4	=[	$painup6,	ad_spider_run1	] {};

//----------------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_spider_pain = 
{
	// Has the spider been hit while on the ceiling?
	if (self.spawnflags & ad_MON_SPIDER_CEILING) {
		self.ad_pain_finished = time + 1;
		ad_spider_wakeup();
		return;
	}
		
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		if (random() < 0.5) sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		else sound (self, ad_CHAN_VOICE, self.ad_pain_sound2, 1, ad_ATTN_NORM);
		self.ad_pain_finished = time + 1;

		if (self.ad_pain_check == 1 || self.ad_pain_check == 2) {
			if (self.ad_pain_check == 2) {
				// reset axe hit and setup short pain recovery
				self.ad_pain_finished = time + 0.4;
				self.ad_axhitme = 0;
			}
			// Different types of pain animations based on current attack
			if ( self.frame > $atkup8 && self.frame < $atkloop10 ) ad_spider_painu1();
			else ad_spider_paind1();
		}
	}
};

//============================================================================
void() ad_spider_die1		=[	$death1,	ad_spider_die2	] {};
void() ad_spider_die2		=[	$death3,	ad_spider_die3	] {ad_monster_check_gib();};
void() ad_spider_die3		=[	$death5,	ad_spider_die4	] {ad_monster_check_gib();
	self.solid = ad_SOLID_NOT;};
void() ad_spider_die4		=[	$death7,	ad_spider_die5	] {};
void() ad_spider_die5		=[	$death9,	ad_spider_die6	] {};
void() ad_spider_die6		=[	$death11,	ad_spider_die7	] {};
void() ad_spider_die7		=[	$death13,	ad_spider_die8	] {};
void() ad_spider_die8		=[	$death15,	ad_spider_die9	] {};
void() ad_spider_die9		=[	$death17,	ad_spider_die10] {ad_monster_death_postcheck();};
void() ad_spider_die10		=[	$death19,	ad_spider_die10] {ad_monster_deadbody_check();};

//----------------------------------------------------------------------------
void() ad_spider_die = 
{
	// Spiders are small, gibs don't bounce far
	self.max_health = ad_MON_NOGIBVELOCITY;

	// Has the spider died while on the ceiling?
	if (self.spawnflags & ad_MON_SPIDER_CEILING)
		self.ad_gibondeath = ad_TRUE;

	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();

	// regular death
	if (!self.ad_gibbed) {
		sound (self, ad_CHAN_VOICE, "spider/death1.wav", 1, ad_ATTN_NORM);
		ad_spider_die1();
	}
};

//======================================================================
/*ad:QUAKED monster_spider (1 0 0) (-16 -16 -24) (16 16 24) Ambush
======================================================================*/
void() ad_setup_spider;
void() ad_monster_spider =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	if (self.spawnflags & ad_MON_SPIDER_LARGE) {
		self.mdl = "progs/mon_spiderg.mdl";
		self.ad_headmdl = "progs/h_spiderg.mdl";		// Front Jaws
		self.ad_gib1mdl = "progs/gib_spidlegg.mdl";	// Single Leg
		self.ad_gib2mdl = "progs/gib_spidbodyg.mdl";	// Back Body

		precache_model (self.mdl);
		precache_model (self.ad_headmdl);
		precache_model (self.ad_gib1mdl);
		precache_model (self.ad_gib2mdl);		
		precache_model (ad_MODEL_PROJ_SPID);			// Spit Projectile
	}
	if (!(self.spawnflags & ad_MON_SPIDER_LARGE) || 
		self.ad_classtype == ad_CT_CACHESPIDER) {
		self.mdl = "progs/mon_spiderb.mdl";
		self.ad_headmdl = "progs/h_spiderb.mdl";		// Front Jaws
		self.ad_gib1mdl = "progs/gib_spidlegb.mdl";	// Single Leg
		self.ad_gib2mdl = "progs/gib_spidbodyb.mdl";	// Back Body

		precache_model (self.mdl);
		precache_model (self.ad_headmdl);
		precache_model (self.ad_gib1mdl);
		precache_model (self.ad_gib2mdl);
	}

	// Head/Body and Special GIB models
	self.ad_gib1frame = 9;

	// IDLE/COMBAT and SIGHT sounds
	self.ad_idle_sound = "spider/idle1.wav";
	self.ad_idle_sound2 = "spider/hiss2.wav";
	self.ad_idle_soundcom = "spider/idle1.wav";
	self.ad_idle_soundcom2 = "spider/hiss3.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);
	precache_sound (self.ad_idle_soundcom2);

	// death/pain/attack sounds
	precache_sound("spider/death1.wav");
	self.ad_pain_sound = "spider/pain1.wav";
	self.ad_pain_sound2 = "spider/pain2.wav";
	precache_sound(self.ad_pain_sound);
	precache_sound(self.ad_pain_sound2);

	precache_sound("spider/miss.wav");
	precache_sound("spider/attackmunch.wav");
	precache_sound("spider/attacktear.wav");
	precache_sound("spider/jumpland.wav");

	self.ad_sight_sound = "spider/hiss1.wav";
	precache_sound (self.ad_sight_sound);

	// Cache spider is a special class sed for precache only
	if (self.ad_classtype != ad_CT_CACHESPIDER) ad_setup_spider();
};

//----------------------------------------------------------------------------
void() ad_monster_wraithminion = { 
	self.ad_classtype = ad_CT_CACHESPIDER; 
	self.spawnflags = ad_MON_SPIDER_LARGE;	// Precache both spiders
	ad_monster_spider();
};

//----------------------------------------------------------------------------
void() ad_setup_spider =
{
	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_TINY;
	self.ad_gibbed = ad_FALSE;
	self.ad_pain_flinch = 10;				// Always flinch
	self.ad_steptype = ad_FS_TYPELIGHT;
	self.ad_pain_longanim = ad_TRUE;			// can be chopped with shadow axe
	self.ad_blockudeath = ad_TRUE;			// No humanoid death sound
	self.ad_meleeoffset = '24 0 20';		// Bite attack offset
	self.ad_attack_offset = '14 0 8';		// Used by green spider, at jaws
	self.ad_movespeed = 1;					// Can never be a turret
	self.ad_deathstring = " was bitten by a Spider\n";

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_SpiderCheckAttack;
	self.ad_th_pain = ad_spider_pain;
	self.ad_th_die = ad_spider_die;

	if(!self.ad_classtype) self.ad_classtype = ad_CT_MONSPIDER;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEWALK;

	// Setup green/brown spider difference
	if (self.spawnflags & ad_MON_SPIDER_LARGE) {
		if (self.health < 1) self.health = 75;
		self.ad_gibhealth = -25;
		self.ad_poisonous = ad_TRUE;		// Always poisonous
		self.ad_th_missile = ad_spider_spit1;
	}
	else {
		if (self.health < 1) self.health = 30;
		self.ad_gibhealth = -20;
		self.ad_poisonous = ad_FALSE;		// Large only are poisonous
		self.ad_th_jump = ad_spider_leap1;
		self.ad_th_jumpexit = ad_spider_leap9;
		// Default jump forward/up distance
		if (ad_CheckZeroVector(self.ad_jumpdist)) self.ad_jumpdist = '400 0 200';
		if (self.ad_jumprange_x <= 0) self.ad_jumprange_x = ad_MONAI_JUMPSPIDERNEAR;
		if (self.ad_jumprange_y <= self.ad_jumprange_x) self.ad_jumprange_y = ad_MONAI_JUMPSPIDERFAR;
	}
	
	//----------------------------------------------------------------------
	// Check for quoth on ceiling entity flag
	//----------------------------------------------------------------------
	if (self.ad_dangle) {
		self.spawnflags = self.spawnflags | ad_MON_SPIDER_CEILING;
	}

	//----------------------------------------------------------------------
	// Ceiling spiders have special idle animation (rotated)
	// and need to let go of the ceiling before resuming any
	// normal behaviour (most think functions are intercepted)
	//----------------------------------------------------------------------
	if (self.spawnflags & ad_MON_SPIDER_CEILING) {
		self.ad_th_stand = self.ad_th_walk = ad_spider_idleup1;
		self.ad_th_run = self.ad_th_slide = ad_spider_wakeup;
		self.ad_th_melee = self.ad_th_missile = self.ad_th_jump = ad_spider_wakeup;
		// th_pain and th_die functions understand ceiling spiders
	}
	// Special spawning minion need to start spinning
	else if (self.ad_classtype == ad_CT_MINIONSPIDER) {
		self.ad_th_stand = self.ad_th_walk = self.ad_th_run = ad_spider_grow;
		self.ad_th_melee = self.ad_th_slide = ad_SUB_Null;
		self.ad_th_missile = self.ad_th_jump = ad_SUB_Null;
	}
	// Default spider behaviour functions
	else {
		self.ad_th_stand = ad_spider_idle1;
		self.ad_th_walk = ad_spider_walk1;
		self.ad_th_run = ad_spider_run1;
		self.ad_th_melee = ad_spider_bite1;
		self.ad_th_slide = ad_spider_slide1;
	}
	
	ad_monster_start();
};

//----------------------------------------------------------------------------
// A code way to spawn spiders (requires monster_spiderspawn entity)
//----------------------------------------------------------------------------
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_spider =
{
	local entity ad_minion;
	
	// Check if there is space to spawn entity
	if (ad_entity_pcontent(ad_minion_org)) return;
	
	ad_update_minioncount(self.owner, 1);		// Update spawn counters
	
	ad_minion = spawn();
	ad_minion.classname = "monster_spider";	// For function searching
	setorigin(ad_minion, ad_minion_org);			// Move to new location
	ad_minion.owner = self.owner;				// Spawner Parent Link
	self.owner = ad_minion;					// Stop gibs interacting with minion
	
	ad_minion.effects = ad_minion.flags = 0;		// make sure are blank
	ad_minion.ad_gibondeath = 1;					// Always gib on death
	ad_minion.ad_classtype = ad_CT_MINIONSPIDER;		// Special minion class
	ad_minion.enemy = ad_minion_targ;				// Target to attack
	ad_minion.ad_minion_active = ad_TRUE;			// Minion flag
	ad_minion.ad_bodyfadeaway = ad_TRUE;				// Get rid of body
	
	if (random() < 0.2) ad_minion.spawnflags = ad_MON_SPIDER_LARGE;
	else ad_minion.spawnflags = 0;
	
	if (ad_minion.spawnflags & ad_MON_SPIDER_LARGE) {
		ad_minion.mdl = "progs/mon_spiderg.mdl";
		ad_minion.ad_headmdl = "progs/h_spiderg.mdl";		// Front Jaws
		ad_minion.ad_gib1mdl = "progs/gib_spidlegg.mdl";	// Single Leg
		ad_minion.ad_gib2mdl = "progs/gib_spidbodyg.mdl";	// Back Body
	}
	else {	
		ad_minion.mdl = "progs/mon_spiderb.mdl";
		ad_minion.ad_headmdl = "progs/h_spiderb.mdl";		// Front Jaws
		ad_minion.ad_gib1mdl = "progs/gib_spidlegb.mdl";	// Single Leg
		ad_minion.ad_gib2mdl = "progs/gib_spidbodyb.mdl";	// Back Body
	}

	ad_minion.ad_gib1frame = 9;
	ad_minion.ad_idle_sound = "spider/idle1.wav";
	ad_minion.ad_idle_sound2 = "spider/hiss2.wav";
	ad_minion.ad_idle_soundcom = "spider/idle1.wav";
	ad_minion.ad_idle_soundcom2 = "spider/hiss3.wav";
	ad_minion.ad_sight_sound = "spider/hiss1.wav";
	ad_minion.ad_pain_sound = "spider/pain1.wav";
	ad_minion.ad_pain_sound2 = "spider/pain2.wav";
	
	ad_minion.nextthink = time + 0.01;
	ad_minion.think = ad_setup_spider;
};