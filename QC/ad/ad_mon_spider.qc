void() ad_spider_leap8 =[ $jump11, ad_spider_leap9] {ad_monster_footstep(ad_FALSE);};
void() ad_spider_leap9 =[ $jump13, ad_spider_leap10] {ad_monster_footstep(ad_FALSE);};
void() ad_spider_leap10 =[ $jump15, ad_spider_run1] {ad_ai_resetangles();};

