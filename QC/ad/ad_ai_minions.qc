/*======================================================================
 MINIONS FUNCTIONS

 Minion Support functions
  Setup and update minion counters centralized to reduce errors
  monster_death_precheck remove from the counter (dying event)
  minion_voreling, minion_spider add to the counter (spawn event)
  
======================================================================*/

.float		ad_minion_baseattack;	// Block base attack within melee range
.float		ad_minion_count;		// Current active amount of minions
.float		ad_minion_maxcount;	// Maximum amount of active minions
.float		ad_minion_trigger;		// Spawn counter for trigger event
.float		ad_minion_maxtrigger;	// Spawn total for trigger event
.string		ad_miniontarget;		// targetname string for trigger event
.float		ad_minion_throwspeed;  // Starting forward speed of ball
.float		ad_minion_throwextra;	// Extra random forward speed of ball
.float		ad_minion_throwside;	// Extra sideways momentum (+/-)
.entity		ad_minion_test;		// Test entity for minion collision
float ad_MIN_MAXACTIVE = 5;		// Maximum amount active at once
float ad_MIN_MAXTRIGGER = 5;		// How many spawns before triggering
float ad_MIN_THROWSPD = 200;		// Monster jump speed
float ad_MIN_THROWRND = 50;		// Some randomness
float ad_MIN_THROWSIDE = 50;		// Sideways movement (+/-)

void(vector ad_org, vector ad_dir, vector ad_avel, float ad_proj_type) ad_Launch_Grenade;

//----------------------------------------------------------------------
void() ad_setup_minionsupport =
{
	// Reset all counters
	self.ad_minion_active = ad_TRUE;
	self.ad_minion_count = 0;
	self.ad_minion_trigger = 0;

	// Setup default max counters (check for existing values)
	if (!self.ad_minion_maxcount) self.ad_minion_maxcount = ad_MIN_MAXACTIVE;
	if (!self.ad_minion_maxtrigger) self.ad_minion_maxtrigger = ad_MIN_MAXTRIGGER;
	
	// Chance to fire original (base) attack of monster
	if (!self.ad_minion_baseattack) self.ad_minion_baseattack = ad_TRUE;

	// Throw speed of minion ball/egg
	if (!self.ad_minion_throwspeed) self.ad_minion_throwspeed = ad_MIN_THROWSPD;
	if (!self.ad_minion_throwextra) self.ad_minion_throwextra = ad_MIN_THROWRND;
	if (!self.ad_minion_throwside) self.ad_minion_throwside = ad_MIN_THROWSIDE;
};

//----------------------------------------------------------------------
void(entity ad_msource, float ad_countupd) ad_update_minioncount =
{
	if (!ad_msource.ad_minion_active) return;
	// Add to the active minion counters (check range limits)
	ad_msource.ad_minion_count = ad_msource.ad_minion_count + ad_countupd;
	if (ad_msource.ad_minion_count < 0) ad_msource.ad_minion_count = 0;
	if (ad_msource.ad_minion_count > ad_msource.ad_minion_maxcount)
		ad_msource.ad_minion_count = ad_msource.ad_minion_maxcount;

	// Check for trigger events (ignore death triggers)
	if (ad_countupd > 0) {
		ad_msource.ad_minion_trigger = ad_msource.ad_minion_trigger + ad_countupd;
		if (ad_msource.ad_minion_trigger >= ad_msource.ad_minion_maxtrigger) {
			ad_msource.ad_minion_trigger = 0;
			// Check for trigger event string?
			if (ad_msource.ad_miniontarget != "") {
				ad_trigger_strs(ad_msource.ad_miniontarget, ad_msource);
			}
		}
	}
};

//----------------------------------------------------------------------
// Check if anymore minions can be spawned at the moment
//----------------------------------------------------------------------
float(entity ad_msource) ad_query_minionactive =
{
	if (!ad_msource.ad_minion_active) return ad_NEGATIVE;
	if (ad_msource.ad_minion_count < ad_msource.ad_minion_maxcount) return ad_TRUE;
	else return ad_FALSE;
};

//======================================================================
// Check if there is space to spawn a minion
// 
// Version 1 - use a touch trigger to detect players
// Version 2 - use a findradius command to find players
//======================================================================
void() ad_delete_minionspace = { if (self.ad_minion_test) ad_entity_remove(self.ad_minion_test,0.1); }
void() ad_touch_minionspace = { if (other.flags & ad_FL_CLIENT) self.aflag = ad_TRUE; };

//----------------------------------------------------------------------
// Touch trigger version for detecting client/players too close
//----------------------------------------------------------------------
void(vector ad_org, vector ad_minspace, vector ad_maxspace) ad_setup_minionspace =
{
	// Create a touch trigger if one does not exist
	if (!self.ad_minion_test) self.ad_minion_test = spawn();
	// reset all parameters
	self.ad_minion_test.movetype = ad_MOVETYPE_NONE;
	self.ad_minion_test.solid = ad_SOLID_TRIGGER;
	setmodel(self.ad_minion_test, ad_MODEL_EMPTY);
	self.ad_minion_test.skin = self.ad_minion_test.frame = 0;
	self.ad_minion_test.flags = 0;

	// Move touch trigger to correct location
	setorigin(self.ad_minion_test, ad_org);
	setsize (self.ad_minion_test, ad_minspace, ad_maxspace);
	// Enable touch function and reset collision flag
	self.ad_minion_test.touch = ad_touch_minionspace;
	self.ad_minion_test.aflag = ad_FALSE;
};

float() ad_test_minionspace =
{
	// Quick exit if no touch entity exists
	if (!self.ad_minion_test) return ad_FALSE;

	// Basic world collision test for origin/min/max of spawn
	if (pointcontents(self.ad_minion_test.origin) != ad_CONTENT_EMPTY) return ad_FALSE;
	if (pointcontents(self.ad_minion_test.origin+'-16 -16 -24') != ad_CONTENT_EMPTY) return ad_FALSE;
	if (pointcontents(self.ad_minion_test.origin+'16 16 40') != ad_CONTENT_EMPTY) return ad_FALSE;
	
	// Switch off touch function and check for collision
	self.ad_minion_test.touch = ad_SUB_Null;
	if (self.ad_minion_test.aflag == ad_TRUE) return ad_FALSE;
	else return ad_TRUE;
};

//----------------------------------------------------------------------
// Findradius version for detecting client/players too close
//----------------------------------------------------------------------
float(vector ad_org) ad_find_minionspace =
{
	local entity ad_minstuff;
	local float ad_foundclient;

	// Basic world collision test for origin/min/max of spawn
	if (pointcontents(ad_org) != ad_CONTENT_EMPTY) return ad_FALSE;
	if (pointcontents(ad_org+'-16 -16 -24') != ad_CONTENT_EMPTY) return ad_FALSE;
	if (pointcontents(ad_org+'16 16 40') != ad_CONTENT_EMPTY) return ad_FALSE;
	
	ad_foundclient = ad_TRUE;
	// The player can cover crazy amount of distance very fast
	// Extend radius out further to catch running players
	ad_minstuff = findradius(ad_org, ad_MONAI_RANGESUMMON);
	while (ad_minstuff) {
		if (ad_minstuff.flags & ad_FL_CLIENT) {
			ad_foundclient = ad_FALSE;
			ad_minstuff = world;
		}
		ad_minstuff = ad_minstuff.chain;
	}
	return ad_foundclient;
};

/*======================================================================
 MINION EGGS
 * Spawns a projecile (egg) at the player
 * Wait for egg to bounce and settle
 * Spawn (rotating) minion inside egg and then explode
======================================================================*/
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_spider;
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_scorpion;
void(vector ad_minion_org, entity ad_minion_targ) ad_minion_voreling;

//----------------------------------------------------------------------------
void() ad_Explode_Egg =
{
	// Remove egg and throw gibs up as minion grows
	setmodel (self, "");
	if (self.ad_classgroup == ad_CT_MONWRAITH) self.ad_gib1mdl = ad_MODEL_PROJ_WSHELL; 
	else if (self.ad_classgroup == ad_CT_MONSHAL) self.ad_gib1mdl = ad_MODEL_PROJ_SSHELL; 
	self.ad_gib1frame = 9;
	self.max_health = ad_MON_GIBFOUNTAIN;
	ad_ThrowGib(11,rint(2+random()*4));
	
	// Safely remove egg
	self.think = ad_SUB_Remove;
	self.nextthink = time + 0.1;
};	

//----------------------------------------------------------------------
// Once the egg has landed via Grenade Touch function
// The minion is spawned and the egg is set to explode
//----------------------------------------------------------------------
void() ad_Hatch_Egg =
{
	// Block this functions
	if (self.state == ad_STATE_DISABLED) return;
	// Has the egg been marked for removal?
	if (self.ad_touchedvoid) return;

	// Its possible for the egg to get stuck, setup death timer
	if (!self.ad_gibbed) {
		self.ad_gibbed = ad_TRUE;
		self.ad_attack_finished = time + 6;
	}
	// Egg has been stuck for too long, destroy it
	if (self.ad_attack_finished < time) {
		self.state = ad_STATE_DISABLED;
		self.think = ad_Explode_Egg;
		self.nextthink = time + 0.1;
		return;
	}

	// Turn off touch function and any movement
	self.touch = ad_SUB_Null;
	self.movetype = ad_MOVETYPE_NONE;
	self.takedamage = ad_DAMAGE_NO;
	self.velocity = '0 0 0';
	
	// Check if the egg can hatch? turn on collision
	// setup new bounds and extend upwards for testing
	setsize (self, ad_VEC_HULLT_MIN, ad_VEC_HULLT_MAX);
	self.solid = ad_SOLID_SLIDEBOX;
	self.movetype = ad_MOVETYPE_TOSS;
	self.oldorigin = self.origin;
	self.origin_z = self.origin_z + 8;
	droptofloor();
	
	// Can the egg hatch yet? Solid content?
	if (!ad_walkmove(0,0) || pointcontents(self.origin) == ad_CONTENT_SOLID) {
		self.origin = self.oldorigin;
		self.think = ad_Hatch_Egg;
		self.nextthink = time + 1 + random();
		self.solid = ad_SOLID_NOT;		// turn off again
		return;
	}
	
	// Setup egg ready for minion
	self.state = ad_STATE_DISABLED;

	// Setup spawn location for minion
	traceline (self.origin+'0 0 128', self.origin-'0 0 256', ad_TRUE, world);
	self.oldorigin = trace_endpos + '0 0 32';
	
	// Spawn minion inside of egg model
	// self.owner is re-assigned to minion to avoid shell gibs interacting
	if (self.owner.ad_classtype == ad_CT_MONWRAITH) {
		if (self.owner.spawnflags & ad_MON_WRAITH_SCORPIONS) ad_minion_scorpion(self.oldorigin, self.enemy);
		else ad_minion_spider(self.oldorigin, self.enemy);
	}
	else if (self.owner.ad_classtype == ad_CT_MONSHAL) ad_minion_voreling(self.oldorigin, self.enemy);

	// Skip a couple of frames
	self.think = ad_Explode_Egg;
	self.nextthink = time + 0.4;
};

//----------------------------------------------------------------------
// Work out direction speed of egg and then launch it!
//----------------------------------------------------------------------
void(vector ad_eggofs) ad_Create_Egg =
{
	local vector ad_org, ad_dir;
	local float ad_egg_speed;
	if (self.health < 1) return;
	
	// Turn towards player and drop the egg!
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_eggofs);
	ad_egg_speed = self.ad_minion_throwspeed + (random() * self.ad_minion_throwextra);
	ad_dir = (v_forward * ad_egg_speed) + (v_right * (ad_crandom()*self.ad_minion_throwside));
	ad_Launch_Grenade(ad_org,ad_dir,'0 0 0',ad_CT_PROJ_MEGG);
	ad_SUB_AttackFinished (2 + random());
};
