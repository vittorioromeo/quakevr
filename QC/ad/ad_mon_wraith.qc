void() ad_wraith_walk7 =[ $stand9, ad_wraith_walk8 ] { ad_ai_walk(5);};
void() ad_wraith_walk8 =[ $stand10, ad_wraith_walk9 ] { ad_ai_walk(4);};
void() ad_wraith_walk9 =[ $stand11, ad_wraith_walk10 ] { ad_ai_walk(8);};
