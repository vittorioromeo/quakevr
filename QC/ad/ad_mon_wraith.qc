//======================================================================
void() ad_wraith_run1 =[ $stand3, ad_wraith_run2 ] {ad_monster_idle_sound();
	if (self.ad_meleeattack < time) {
		self.ad_meleeattack = time + 4 + (random() + random() + random() * 4);
		self.lefty = rint(1 - self.lefty);
	}
	ad_ai_run(8);
};
void() ad_wraith_run2 =[ $stand4, ad_wraith_run3 ] {ad_ai_run(7);};
void() ad_wraith_run3 =[ $stand5, ad_wraith_run3 ] {ad_ai_run(7);};
void() ad_wraith_run4 =[ $stand6, ad_wraith_run3 ] {ad_ai_run(6);};
void() ad_wraith_run5 =[ $stand7, ad_wraith_run3 ] {ad_ai_run(6);};
void() ad_wraith_run6 =[ $stand8, ad_wraith_run3 ] {ad_ai_run(5);};
void() ad_wraith_run7 =[ $stand9, ad_wraith_run3 ] {ad_ai_run(5);};
void() ad_wraith_run8 =[ $stand10, ad_wraith_run3 ] {ad_ai_run(4);};
void() ad_wraith_run9 =[ $stand11, ad_wraith_run3 ] {ad_ai_run(8);};
void() ad_wraith_run10 =[ $stand12, ad_wraith_run3 ] {ad_ai_run(8);};

//============================================================================
// Attachment management (create, finish and delete)
//============================================================================
void() ad_wraith_create_attachment =
{
	// Are the attachments setup yet?
	if (!self.ad_attachment) {
		self.ad_attachment = spawn();
		self.ad_attachment.owner = self;
		self.ad_attachment.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment.mdl = ad_MODEL_PROJ_WBALL;
		self.ad_attachment.alpha = 0.85;
	}
	if (!self.ad_attachment2) {
		self.ad_attachment2 = spawn();
		self.ad_attachment2.owner = self;
		self.ad_attachment2.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment2.mdl = ad_MODEL_PROJ_WBALL;
		self.ad_attachment2.alpha = 0.85;
	}
	if (!self.ad_attachment3) {
		self.ad_attachment3 = spawn();
		self.ad_attachment3.owner = self;
		self.ad_attachment3.ad_classtype = ad_CT_ATTACHMENT;
		self.ad_attachment3.mdl = self.ad_weaponglow;
		self.ad_attachment3.alpha = 0.5;
	}
};

//----------------------------------------------------------------------
void() ad_wraith_finish_attachment =
{
	if (self.ad_attachment) {
		setmodel(self.ad_attachment, "");
		self.ad_attachment.state = ad_STATE_OFF;
	}
	if (self.ad_attachment2) {
		setmodel(self.ad_attachment2, "");
		self.ad_attachment2.state = ad_STATE_OFF;
	}
	if (self.ad_attachment3) {
		setmodel(self.ad_attachment3, "");
		self.ad_attachment3.state = ad_STATE_OFF;
		self.ad_attachment3.velocity = '0 0 0';
	}
};

//----------------------------------------------------------------------
void() ad_wraith_remove_attachment =
{
	if (self.ad_attachment) {
		self.ad_attachment.think = ad_SUB_Remove;
		self.ad_attachment.nextthink = time + 0.1;
	}
	if (self.ad_attachment2) {
		self.ad_attachment2.think = ad_SUB_Remove;
		self.ad_attachment2.nextthink = time + 0.1;
	}
	if (self.ad_attachment3) {
		self.ad_attachment3.think = ad_SUB_Remove;
		self.ad_attachment3.nextthink = time + 0.1;
	}
};

//======================================================================
// FADE OUT TEMPORARY MODELS
// Very quick fade (0.5s) - modified version of model_fade
//======================================================================
void() ad_debuff_fade =
{
    self.alpha = 0.5 - ((time - self.ltime) / 0.5);

    if (self.alpha < 0.2) {
        self.alpha = 0;
		self.modelindex = 0;		// Make sure no model
        self.model = "";			// hide model
		self.think = ad_SUB_Remove;
		self.nextthink = time + 0.1;
        return;
    }
    self.nextthink = time + ad_FADEDEBUFF_TIME;
};

//----------------------------------------------------------------------
// Start fading out (very quick, over 0.5s)
//----------------------------------------------------------------------
void() ad_wraith_debuff_chunk =
{
	self.think = ad_debuff_fade;
	self.nextthink = time + ad_FADEDEBUFF_TIME;
	self.ltime = self.nextthink;
};

//----------------------------------------------------------------------
// Manual animation of ball at end of the debuff particle trail
//----------------------------------------------------------------------
void() ad_wraith_debuff_shrink =
{
	// Count downwards getting smaller
	self.lip = self.frame - 1;
	if (self.lip < 0) ad_wraith_debuff_chunk();
	else {
		// Check frame number before assigning
		// Cannot set models with negative frame numbers
		self.frame = self.lip;
		self.think = ad_wraith_debuff_shrink;
		self.nextthink = time + 0.1;
	}
};

//======================================================================
// RANGE ATTACK 1 - Apply debuff to player (hitscan!)
//
// Generate an animated particle trail from 32 unit segments
// Slowly remove segments from source to target
// Generate a ball at target location slowly shrinking
//======================================================================
void() ad_wraith_fire_touch =
{
	if (other.solid == ad_SOLID_TRIGGER) return;
	if (other.ad_classtype == ad_CT_TEMPSTREAM) return;
	if (other.health > 0) return;
	if (self.ad_attack_finished > time) return;

	self.ad_attack_finished = time + 1;
	self.modelindex = 0;		// Make sure no model
	self.model = "";			// hide model
	self.think = ad_SUB_Remove;
	self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void() ad_wraith_fire_think =
{
	// Randomly drift upwards and slow down forward movement
	self.velocity_z = self.velocity_z + 10 + (random() * 20);
	self.velocity = self.velocity - (self.velocity * 0.125);
	
	self.frame = self.frame + 1;
	if (self.frame > self.count) ad_SUB_Remove();
	else self.nextthink = time + 0.1;
};

//----------------------------------------------------------------------
void(vector ad_start_org) ad_wraith_debuff_explode =
{
	local float ad_fire_loop;
	local vector ad_fire_angles, ad_org, ad_dir;
	
	ad_fire_loop = 0;
	ad_fire_angles = '0 0 0';
	
	while (ad_fire_loop < 360) {
		ad_newmis = spawn();
		ad_newmis.ad_classtype = ad_CT_TEMPSTREAM;
		ad_newmis.movetype = ad_MOVETYPE_FLY;		// Fly, no gravity
		ad_newmis.solid = ad_SOLID_TRIGGER;
		setmodel(ad_newmis, ad_SBURST_FLAME);

		ad_org = ad_start_org;
		ad_org_z = ad_org_z + (ad_crandom() * 24);
		setorigin(ad_newmis, ad_org);
		setsize (ad_newmis, ad_VEC_ORIGIN, ad_VEC_ORIGIN);

		ad_fire_angles_y = ad_fire_loop;
		makevectors(ad_fire_angles);
		ad_dir = ad_vecrand(0,50,ad_FALSE);
		ad_dir = ad_dir + (v_forward * (400 + random() * 50));
		ad_newmis.velocity = ad_dir;
		ad_newmis.count = 6;
		ad_newmis.frame = rint(random()*2);

		// If DP engine active remove particle shadow
		if (ad_engine == ad_ENG_DPEXT) ad_newmis.effects = ad_newmis.effects + ad_EF_NOSHADOW;

		ad_newmis.think = ad_wraith_fire_think;
		ad_newmis.touch = ad_wraith_fire_touch;
		ad_newmis.nextthink = time + 0.1;
		
		ad_fire_loop = ad_fire_loop + rint(random()*15);
	}
};

//----------------------------------------------------------------------
void() ad_wraith_debuff_trail =
{
	local vector ad_org, ad_orgofs, ad_dir, ad_tvec, ad_tang;
	local float ad_tdist, ad_tloop, ad_tcount, ad_tpc;
	local entity ad_tent;

	// Starting point of beam matched to wraith animation
	makevectors (self.angles);
	ad_orgofs = '52 4 6';

	// Calculate starting point and beam and vector direction
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	ad_tvec = ad_SUB_orgEnemyTarget() - ad_org;
	// Create facing angle for segments
	ad_dir = normalize(ad_tvec);
	ad_tang = vectoangles(ad_dir);
	
	// Check for solid wall very close
	ad_tpc = pointcontents(ad_org);
	if (ad_tpc == ad_CONTENT_SOLID || ad_tpc == ad_CONTENT_SKY) return;
	ad_tpc = pointcontents(ad_org+(ad_dir*16));
	if (ad_tpc == ad_CONTENT_SOLID || ad_tpc == ad_CONTENT_SKY) return;
	
	// Check for obstacles (geo and monsters)
	traceline(ad_org, ad_SUB_orgEnemyTarget(), ad_FALSE, self);
	ad_tdist = trace_fraction * vlen(ad_tvec);
	if (ad_tdist < 32) return;
	ad_tloop = ad_tdist / 32;
	ad_tcount = 0;

	//----------------------------------------------------------------------
	// Originally - BleedDeBuff(SUB_entEnemyTarget());
	// New version - Fire explosion + burning
	if (trace_ent.flags & ad_FL_CLIENT) {
		self.owner = self;	// Fix for T_damage inside ApplyFireDmg
		ad_ApplyFireDmg(ad_SUB_entEnemyTarget(), ad_DAMAGE_PYROWRAITH, ad_DAMAGE_PYROWRAITH);
	}
	else if (ad_ai_foundbreakable(self, trace_ent, ad_FALSE))
		ad_T_Damage (trace_ent, self, self, 100, ad_DAMARMOR);
	
	//----------------------------------------------------------------------
	// Generate particle beam in segments
	while(ad_tcount < ad_tloop) {
		// Create segment in the middle of 32 segment
		ad_tvec = ad_org + (ad_dir* (16 + ad_tcount*32) );

		// Spawn temporary entity
		ad_tent = spawn();
		ad_tent.owner = self;
		ad_tent.ad_classtype = ad_CT_PROJ_WBOLT;
		setsize (ad_tent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_tent.movetype = ad_MOVETYPE_FLYMISSILE;	// Needs to float up
		ad_tent.solid = ad_SOLID_NOT;
		
		// Special animated particle model (still, slow rotate, fast rotate)
		setmodel(ad_tent, ad_MODEL_PROJ_WTRAIL);
		setorigin(ad_tent, ad_tvec);
		
		ad_tent.velocity = -v_up*5;	// Slowly drift up to create trail particles
		ad_tent.angles = ad_tang;			// Rotate segment into place
		ad_tent.frame = 2;				// Fast rotate animation group
		ad_tent.skin = 3;				// Flame yellow/red
		ad_tcount = ad_tcount + 1;		// Next segment
		
		// Wait around for a while before fading out
		ad_tent.think = ad_wraith_debuff_chunk;
		ad_tent.nextthink = time + (ad_tcount *0.05);
	}

	// Workout final destination of explosion and effects
	self.ad_finaldest = ad_tvec+(ad_dir *16);

	//----------------------------------------------------------------------
	// Spawn a ball of plasma at the final destionation
	// Shrinking downwards in size over 0.1s frames
	ad_tent = spawn();
	ad_tent.owner = self;
	ad_tent.ad_classtype = ad_CT_PROJ_WBOLT;
	setsize (ad_tent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
	ad_tent.movetype = ad_MOVETYPE_FLYMISSILE;// Needs to float upward
	ad_tent.solid = ad_SOLID_NOT;
	setmodel(ad_tent, ad_MODEL_PROJ_WBALL);	// Initial ball
	setorigin(ad_tent, self.ad_finaldest);	// Move ball to end of final segment
	ad_tent.velocity = -v_up*5;			// Slowly drift upwards
	ad_tent.avelocity = '100 100 100';		// Slight rotation on all axis
	ad_tent.frame = 6;						// Start really large
	ad_tent.skin = ad_BALL_DEBUFF_COL2;
	ad_tent.think = ad_wraith_debuff_shrink;	// Animate manually
	ad_tent.nextthink = time + 0.1;

	//----------------------------------------------------------------------
	// Generate particle explosion (+ sound effect)
	WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
	WriteByte (ad_MSG_BROADCAST, ad_TE_EXPLOSION);	// hard coded explosion
	WriteCoord (ad_MSG_BROADCAST, self.ad_finaldest_x);
	WriteCoord (ad_MSG_BROADCAST, self.ad_finaldest_y);
	WriteCoord (ad_MSG_BROADCAST, self.ad_finaldest_z);
	// Play original explosion sound
	sound(ad_tent, ad_CHAN_WEAPON, "drole/r_explode.wav", 1, ad_ATTN_NORM);

	//----------------------------------------------------------------------
	// Large circular flame explosion
	ad_wraith_debuff_explode(self.ad_finaldest);
};

//----------------------------------------------------------------------
void(entity ad_handent, vector ad_orgofs, vector ad_orgside, float ad_dbframe) ad_wraith_debuffball =
{
	local vector ad_org;
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_dbframe == 0) {
		ad_handent.state = ad_STATE_ON;
		setorigin(ad_handent, self.origin);
		setmodel(ad_handent, ad_handent.mdl);
		setsize (ad_handent, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		ad_handent.movetype = ad_MOVETYPE_NONE;
		ad_handent.solid = ad_SOLID_NOT;
		ad_handent.skin = ad_BALL_DEBUFF_COL1;
	}
	
	// Generate attachment in hand (left)
	ad_org = self.origin + v_forward*ad_orgofs_x + ad_orgside*ad_orgofs_y + v_up*ad_orgofs_z;
	setorigin(ad_handent, ad_org);
	ad_handent.angles_y = rint(random()*359);
	ad_handent.frame = ad_dbframe;
};

//----------------------------------------------------------------------
void(vector ad_orgofs, float ad_dbframe) ad_wraith_debuff =
{
	if (self.health < 1) return;
	
	if (ad_dbframe == 0) {
		self.ad_pain_finished = time + 1.1;
		sound (self, ad_CHAN_WEAPON, "wraith/attack1.wav", 1, ad_ATTN_NORM);

		// Setup halo/glow models around wraith (5% larger)
		setorigin(self.ad_attachment3, self.origin);
		setmodel(self.ad_attachment3, self.ad_attachment3.mdl);
		setsize (self.ad_attachment3, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment3.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment3.solid = ad_SOLID_NOT;
	}
	
	// Should be visible during attack cycle
	self.skin = self.ad_exactskin + 1;
	self.alpha = ad_WRAITH_ALPHAFIRE;
	// Particles drifting up slowly from body
	ad_particle_explode(self.origin, 20, 2, self.ad_part_style, ad_PARTICLE_BURST_UPWARD);
	// Update halo/glow model
	self.ad_attachment3.angles = self.angles;
	self.ad_attachment3.frame = self.frame;
	self.ad_attachment3.velocity = self.velocity;
	// Randomly change alpha to make glow flicker
	self.ad_attachment3.alpha = 0.1 + random()*0.5;


	// Keep turning towards enemy
	ad_ai_face();
	makevectors(self.angles);
	
	// Generate a ball in each hand
	ad_wraith_debuffball(self.ad_attachment, ad_orgofs, v_right, ad_dbframe);
	ad_wraith_debuffball(self.ad_attachment2, ad_orgofs, -v_right, ad_dbframe);
};

//----------------------------------------------------------------------
// RANGE ATTACK 1 - Swing arms forward with hand meeting together
//
// The debuff attack is a hitscan attack but it does have 1s animation
// (backward frames) 30 32 8, 14 46 20, -6 46 28, -12 40 28
// (forward frames)   0 46 30, 16 42 24, 32 38 20, 48 26 10, 52 14 6, 52 4 6
void() ad_wraith_debuff1 =[ $magicA1, ad_wraith_magicA2 ] {ad_ai_face();};
void() ad_wraith_magicA2 =[ $magicA2, ad_wraith_magicA3 ] {ad_ai_face();};
void() ad_wraith_magicA3 =[ $magicA3, ad_wraith_magicA4 ] {ad_wraith_debuff('30 32 8',0);};
void() ad_wraith_magicA4 =[ $magicA4, ad_wraith_magicA5 ] {ad_wraith_debuff('14 46 20',1);};
void() ad_wraith_magicA5 =[ $magicA5, ad_wraith_magicA6 ] {ad_wraith_debuff('-6 46 28',2);};
void() ad_wraith_magicA6 =[ $magicA6, ad_wraith_magicA7 ] {ad_wraith_debuff('-12 40 28',3);};
void() ad_wraith_magicA7 =[ $magicA7, ad_wraith_magicA8 ] {ad_wraith_debuff('0 46 30',3);};
void() ad_wraith_magicA8 =[ $magicA8, ad_wraith_magicA9 ] {ad_wraith_debuff('16 42 24',4);};
void() ad_wraith_magicA9 =[ $magicA9, ad_wraith_magicA10 ] {ad_wraith_debuff('32 38 20',4);};
void() ad_wraith_magicA10 =[ $magicA10, ad_wraith_magicA11 ] {ad_wraith_debuff('48 26 10',5);};
void() ad_wraith_magicA11 =[ $magicA11, ad_wraith_magicA12 ] {ad_wraith_debuff('52 14 6',5);};
void() ad_wraith_magicA12 =[ $magicA12, ad_wraith_magicA13 ] {
	ad_wraith_debuff('52 4 6',6);
	ad_wraith_debuff_trail(); 
	self.skin = self.ad_exactskin; 
	self.alpha = ad_WRAITH_ALPHA;
};
void() ad_wraith_magicA13 =[ $magicA13, ad_wraith_magicA14 ] {ad_wraith_finish_attachment();};
void() ad_wraith_magicA14 =[ $magicA14, ad_wraith_run1 ] {};

//======================================================================
// RANGE ATTACK 2 - Small bone/nail attack (low damage)
//
// Create a ball of blood and throw it towards the player
// Turning the ball into a pile of bones/nails
//======================================================================
void(vector ad_orgofs, float ad_nbframe) ad_wraith_nailball =
{
	local vector ad_org;
	if (self.health < 1) return;

	// Frame 0 is start of the sequence (move everything into place)
	if (ad_nbframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		// Setup regular/poison projectile
		if (self.spawnflags & ad_MON_WRAITH_SPIDERS) self.ad_attachment.skin = ad_BALL_NAIL_COL2;
		else self.ad_attachment.skin = ad_BALL_NAIL_COL1;

		self.ad_pain_finished = time + 1;
		sound (self, ad_CHAN_WEAPON, "wraith/attack2.wav", 1, ad_ATTN_NORM);
	}
	
	// Turn towards enemy and make vector
	ad_ai_face();
	makevectors(self.angles);
	
	// Generate attachment in hand (left)
	ad_org = self.origin + ad_attack_vector(ad_orgofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles_y = rint(random()*359);
	self.ad_attachment.frame = ad_nbframe;
};

//----------------------------------------------------------------------
void(vector ad_boneofs) ad_wraith_firenails =
{
	local vector ad_org, ad_dir;
	if (self.health < 1) return;
	
	self.ad_attack_speed = ad_SPEED_WRAITHBONE + (ad_skill * ad_SPEED_WBONESKILL);
	makevectors(self.angles);

	// Generate spike/bone at final animation position
	ad_org = self.origin + ad_attack_vector(ad_boneofs);
	ad_dir = ad_SUB_orgEnemyTarget() + v_right*(ad_BONEOFFSET*3);
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_WBONE, self.ad_attack_speed+random()*25);
	ad_dir = ad_SUB_orgEnemyTarget() - v_right*(ad_BONEOFFSET*3);
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_WBONE, self.ad_attack_speed+random()*25);
	ad_dir = ad_SUB_orgEnemyTarget() + v_up*ad_BONEOFFSET;
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_WBONE, self.ad_attack_speed+random()*25);
	ad_dir = ad_SUB_orgEnemyTarget() - v_up*ad_BONEOFFSET;
	ad_dir = normalize(ad_dir - ad_org);
	ad_launch_projectile (ad_org, ad_dir, ad_CT_PROJ_WBONE, self.ad_attack_speed+random()*25);
};

//----------------------------------------------------------------------
// RANGE ATTACK 2 - Small bone/nail attack (low damage)
//
// 32 22 0, 29 29 6, 15 33 16, 4 28 24, -6 20 24, -10 16 20, 6 16 14, 
// 14 16 10, 54 5 6, 60 4 14
void() ad_wraith_nails1 =[ $magicC1, ad_wraith_magicC2 ] {ad_ai_face();
	ad_SUB_AttackFinished(1 + random());	// Fire more frequent
};
void() ad_wraith_magicC2 =[ $magicC2, ad_wraith_magicC3 ] {ad_ai_face();};
void() ad_wraith_magicC3 =[ $magicC3, ad_wraith_magicC4 ] {ad_wraith_nailball('15 33 16',0);};
void() ad_wraith_magicC4 =[ $magicC4, ad_wraith_magicC5 ] {ad_wraith_nailball('4 28 24',1);};
void() ad_wraith_magicC5 =[ $magicC5, ad_wraith_magicC6 ] {ad_wraith_nailball('-6 20 24',2);};
void() ad_wraith_magicC6 =[ $magicC6, ad_wraith_magicC7 ] {ad_wraith_nailball('-10 16 20',3);};
void() ad_wraith_magicC7 =[ $magicC7, ad_wraith_magicC8 ] {ad_wraith_nailball('6 16 14',4);};
void() ad_wraith_magicC8 =[ $magicC8, ad_wraith_magicC9 ] {ad_wraith_nailball('14 16 10',5);};
void() ad_wraith_magicC9 =[ $magicC9, ad_wraith_magicC10 ] {ad_wraith_nailball('54 5 6',6);};
void() ad_wraith_magicC10 =[ $magicC10, ad_wraith_magicC11 ] {
	ad_wraith_finish_attachment();
	ad_wraith_firenails('60 4 14');
};
void() ad_wraith_magicC11 =[ $magicC11, ad_wraith_magicC12 ] {ad_monster_idle_sound();};
void() ad_wraith_magicC12 =[ $magicC12, ad_wraith_magicC13 ] {};
void() ad_wraith_magicC13 =[ $magicC13, ad_wraith_magicC14 ] {};
void() ad_wraith_magicC14 =[ $magicC14, ad_wraith_magicC15 ] {ad_ai_face();};
void() ad_wraith_magicC15 =[ $magicC15, ad_wraith_run1 ] {ad_ai_face();};

//======================================================================
// RANGE ATTACK 3 - spawn spider minion (optional)
//
// Create a ball of green goo and throw it towards the player
// Once ball has landed, hatch/explode and create spider (brown/green)
//======================================================================
void(vector ad_eggofs, float ad_eggframe) ad_Setup_WraithEgg =
{
	local vector ad_org;
	if (self.health < 1) return;
	
	// Frame 0 is start of the sequence (move everything into place)
	if (ad_eggframe == 0) {
		self.ad_attachment.state = ad_STATE_ON;
		setorigin(self.ad_attachment, self.origin);
		setmodel(self.ad_attachment, self.ad_attachment.mdl);
		setsize (self.ad_attachment, ad_VEC_ORIGIN, ad_VEC_ORIGIN);
		self.ad_attachment.movetype = ad_MOVETYPE_NONE;
		self.ad_attachment.solid = ad_SOLID_NOT;
		self.ad_attachment.skin = ad_BALL_SPIDER_COL1;

		// Present wraith from going into pain during egg cycle
		self.ad_pain_finished = time + 1;
		sound (self, ad_CHAN_WEAPON, "wraith/attack3.wav", 1, ad_ATTN_NORM);
		// Should be visible during spawn minion cycle
		self.skin = self.ad_exactskin + 1;
		self.alpha = ad_WRAITH_ALPHAFIRE;
	}

	// Turn towards enemy and update model attachment
	// The offset is based on the wraith facing forward
	ad_ai_face();
	makevectors(self.angles);
	ad_org = self.origin + ad_attack_vector(ad_eggofs);
	setorigin(self.ad_attachment, ad_org);
	self.ad_attachment.angles = self.angles;
	self.ad_attachment.frame = ad_eggframe;
};

//======================================================================
// RANGE ATTACK 3 - Cup hands around a spider egg infront and fire
//
// Spawn a yellow/green egg ball shape and then drop it towards the player
// The egg is spawned in the middle and moved up/down to generate particles
// 20 2 12, 18 2 12
void() ad_wraith_minion1 =[ $magicB1, ad_wraith_magicB2 ] {ad_ai_face();};
void() ad_wraith_magicB2 =[ $magicB2, ad_wraith_magicB3 ] {ad_Setup_WraithEgg('20 2 12',0);};
void() ad_wraith_magicB3 =[ $magicB3, ad_wraith_magicB4 ] {ad_Setup_WraithEgg('18 2 12',1);};
void() ad_wraith_magicB4 =[ $magicB4, ad_wraith_magicB5 ] {ad_Setup_WraithEgg('20 2 12',2);};
void() ad_wraith_magicB5 =[ $magicB5, ad_wraith_magicB6 ] {ad_Setup_WraithEgg('18 2 12',3);};
void() ad_wraith_magicB6 =[ $magicB6, ad_wraith_magicB7 ] {ad_Setup_WraithEgg('20 2 12',4);};
void() ad_wraith_magicB7 =[ $magicB7, ad_wraith_magicB8 ] {ad_Setup_WraithEgg('18 2 12',5);};
void() ad_wraith_magicB8 =[ $magicB8, ad_wraith_magicB9 ] {ad_Setup_WraithEgg('20 2 12',6);};
void() ad_wraith_magicB9 =[ $magicB9, ad_wraith_magicB10 ] {
	self.skin = self.ad_exactskin;	// Not glowing anymore
	self.alpha = ad_WRAITH_ALPHA;	// Fade out
	ad_wraith_finish_attachment();
	ad_Create_Egg('20 2 12');
	// Particles drifting up slowly from body
	ad_particle_explode(self.origin, 30, 2, self.ad_part_style, ad_PARTICLE_BURST_UPWARD);

};
void() ad_wraith_magicB10 =[ $magicB10, ad_wraith_magicB11 ] {};
void() ad_wraith_magicB11 =[ $magicB11, ad_wraith_magicB12 ] {};
void() ad_wraith_magicB12 =[ $magicB12, ad_wraith_magicB13 ] {ad_ai_face();};
void() ad_wraith_magicB13 =[ $magicB13, ad_wraith_run1 ] {ad_ai_face();};

//----------------------------------------------------------------------
void() ad_wraith_magic =
{
	local entity ad_truetarg, ad_miniondef;
	
	// Make sure the attachments are setup ready
	ad_wraith_create_attachment();
	ad_truetarg = ad_SUB_entEnemyTarget();

	if (self.spawnflags & ad_MON_WRAITH_SPIDERS && !self.ad_minion_active) {
		// Check for minion template first
		ad_miniondef = find(world,classname,"monster_wraithminion");
		if (ad_miniondef.ad_classtype == ad_CT_CACHESPIDER) ad_setup_minionsupport();
		else {
			// If template no available, warn and remove feature
			dprint("\b[WRAITH]\b Cannot find spider template!\n");
			self.spawnflags = self.spawnflags - ad_MON_WRAITH_SPIDERS;
			self.ad_poisonous = ad_FALSE;
		}
	}
	if (self.spawnflags & ad_MON_WRAITH_SCORPIONS && !self.ad_minion_active) {
		// Check for minion template first
		ad_miniondef = find(world,classname,"monster_wraithminion2");
		if (ad_miniondef.ad_classtype == ad_CT_CACHESCORPION) ad_setup_minionsupport();
		else {
			// If template no available, warn and remove feature
			dprint("\b[WRAITH]\b Cannot find scorpion template!\n");
			self.spawnflags = self.spawnflags - ad_MON_WRAITH_SCORPIONS;
		}
	}
	
	// Is the target the player or monster?
	if (ad_truetarg.flags & ad_FL_CLIENT) {
		if (self.spawnflags & (ad_MON_WRAITH_SPIDERS | ad_MON_WRAITH_SCORPIONS)) {
			// Calculate a flat vector to ignore Z axis difference
			self.ad_enemydist = ad_range_distance(self.enemy, ad_TRUE);
			// If the player is too close (melee distance) try old base attack
			if (self.ad_minion_baseattack > 0 && self.ad_enemydist < ad_MON_RANGE_MELEE) ad_wraith_nails1();
			else {
				// has the minion limit been reached?
				if (ad_query_minionactive(self) == ad_TRUE) ad_wraith_minion1();
				else ad_wraith_nails1();
			}
		}
		// First ever attack is the fire debuff
		else if (self.ad_attack_speed < time) ad_wraith_debuff1();
		// Does the player have the debuff already?
		else if (ad_truetarg.ad_burning) ad_wraith_nails1();
		else {
			// Greater chance of debuff attack first
			if (random() < 0.7) ad_wraith_debuff1();
			else ad_wraith_nails1();
		}
		self.ad_attack_speed = ad_LARGE_TIMER;
	}
	// Always attack monsters with nails
	else ad_wraith_nails1();
};

//============================================================================
// Pain A - Short flinch backwards
void() ad_wraith_painA1 = [ $painA1, ad_wraith_painA2 ] {};
void() ad_wraith_painA2 = [ $painA2, ad_wraith_painA3 ] {};
void() ad_wraith_painA3 = [ $painA3, ad_wraith_painA4 ] {};
void() ad_wraith_painA4 = [ $painA4, ad_wraith_painA5 ] {};
void() ad_wraith_painA5 = [ $painA5, ad_wraith_painA6 ] {};
void() ad_wraith_painA6 = [ $painA6, ad_wraith_run1 ] {};

//----------------------------------------------------------------------
// Pain B - Long motion of being hit several times
void() ad_wraith_painB1 = [ $painB1, ad_wraith_painB2 ] {};
void() ad_wraith_painB2 = [ $painB2, ad_wraith_painB3 ] {};
void() ad_wraith_painB3 = [ $painB3, ad_wraith_painB4 ] {};
void() ad_wraith_painB4 = [ $painB4, ad_wraith_painB5 ] {};
void() ad_wraith_painB5 = [ $painB5, ad_wraith_painB6 ] {};
void() ad_wraith_painB6 = [ $painB6, ad_wraith_painB7 ] {};
void() ad_wraith_painB7 = [ $painB7, ad_wraith_painB8 ] {};
void() ad_wraith_painB8 = [ $painB8, ad_wraith_painB9 ] {};
void() ad_wraith_painB9 = [ $painB9, ad_wraith_painB10 ] {};
void() ad_wraith_painB10 = [ $painB10, ad_wraith_painB11 ] {};
void() ad_wraith_painB11 = [ $painB11, ad_wraith_run1 ] {};

//----------------------------------------------------------------------
void(entity ad_inflictor, entity ad_attacker, float ad_damage) ad_wraith_pain =
{
	// Check all pain conditions and set up what to do next
	ad_monster_pain_check(ad_attacker, ad_damage);

	// Make sure fire wraith skin/alpha is reset on pain/death
	self.skin = self.ad_exactskin;
	self.alpha = ad_WRAITH_ALPHA;
	
	// Hide any attachments
	ad_wraith_finish_attachment();
	
	// Any pain animation/sound required?
	if (self.ad_pain_check > 0) {
		sound (self, ad_CHAN_VOICE, self.ad_pain_sound, 1, ad_ATTN_NORM);
		if (self.ad_pain_check == 1) {
			// Randomly pick which pain animation to play
			if (random() < 0.85) ad_wraith_painA1 ();
			else {
				self.ad_pain_finished = time + 2;
				ad_wraith_painB1 ();
			}
		}
		// The new axe forces monsters into long pain animations
		else if (self.ad_pain_check == 2) {
			self.ad_axhitme = 0;
			self.ad_pain_finished = time + 2;
			ad_wraith_painB1 ();
		}
	}
};

//============================================================================
void() ad_wraith_death2 =[ $death2, ad_wraith_death3] {};
void() ad_wraith_death3 =[ $death3, ad_wraith_death4] {};
void() ad_wraith_death4 =[ $death4, ad_wraith_death5] {};
void() ad_wraith_death5 =[ $death5, ad_wraith_death7] {};
void() ad_wraith_death7 =[ $death7, ad_wraith_death9] {};
void() ad_wraith_death9 =[ $death9, ad_wraith_death11] {};
void() ad_wraith_death11 =[ $death11, ad_wraith_death13] {};
void() ad_wraith_death13 =[ $death13, ad_wraith_death15] {};
void() ad_wraith_death15 =[ $death15, ad_wraith_death15]
{
	// Throw gibs, but create more XY outward velocity
	self.max_health = ad_MON_XYGIBVELOCITY;
	ad_monster_ThrowGib();
	// Move the explosion up to the middle/top of the body
	// Use to be a regular explosion, switched to tarbaby instead
	self.origin = self.origin + '0 0 24';
	ad_T_RadiusDamage (self, self, ad_DAMAGE_WRAITH, world, ad_IGNORECLASS);
	
	// Big purple explosion
	if (ad_ext_dppart) 
		pointparticles(particleeffectnum(ad_DPP_WRAITHEXPLODE), self.origin, '0 0 0', 1);
	else {
		WriteByte (ad_MSG_BROADCAST, ad_SVC_TEMPENTITY);
		WriteByte (ad_MSG_BROADCAST, ad_TE_TAREXPLOSION);	// Hard coded explosion
		WriteCoord (ad_MSG_BROADCAST, self.origin_x);
		WriteCoord (ad_MSG_BROADCAST, self.origin_y);
		WriteCoord (ad_MSG_BROADCAST, self.origin_z);
	}
	
	// Play original explosion sound or replacement
	sound(self, ad_CHAN_WEAPON, ad_SOUND_REXP3, 1, ad_ATTN_NORM);
	// Stop thinking and hide entity (prevent wraith_death15 loop)
	self.nextthink = ad_LARGE_TIMER;
	self.think = ad_SUB_Null;
	ad_entity_hide(self);
};

//----------------------------------------------------------------------
void() ad_wraith_die =
{
	// Pre-check routine to tidy up extra entities
	ad_monster_death_precheck();
	self.solid = ad_SOLID_NOT;
	sound (self, ad_CHAN_VOICE, "wraith/death1.wav", 1, ad_ATTN_NORM);

	// Make sure fire wraith skin/alpha is reset on pain/death
	self.skin = self.ad_exactskin;
	self.alpha = ad_WRAITH_ALPHA;

	// Make sure any attachments are removed
	ad_wraith_remove_attachment();

	// Make sure body stays floating up where it finally dies
	// and do not drop to the ground (reset by monster_death_use func)
	self.flags = self.flags | ad_FL_FLY;
	self.movetype = ad_MOVETYPE_FLY;
	ad_wraith_death2();
};

//======================================================================
/*ad:QUAKED monster_wraith (1 0 0) (-16 -16 -24) (16 16 32) Ambush
======================================================================*/
void() ad_monster_wraith =
{
	// Check all spawn exceptions (monsters.qc)
	if (ad_monster_checkspawn() == ad_TRUE) return;

	self.mdl = "progs/mon_wraith.mdl";
	self.ad_weaponglow = "progs/mon_wraith_glow.mdl";
	self.ad_gib1mdl = "progs/gib_wraith1.mdl";	// Forearm
	self.ad_gib2mdl = "progs/gib_wraith2.mdl";	// Hand/Claw
	self.ad_gib3mdl = "progs/gib_wraith3.mdl";	// stump?
	
	precache_model (self.mdl);
	precache_model (self.ad_weaponglow);		// Glowing halo effect
	precache_model (ad_MODEL_PROJ_WTRAIL);		// Hitscan blood bolt
	precache_model (ad_MODEL_PROJ_WBALL);		// ball growing 8 frames
	precache_model (ad_MODEL_PROJ_WEGG);		// ball turned into egg
	precache_model (ad_MODEL_PROJ_WSHELL);		// Gibs from Egg
	
	precache_model (ad_MODEL_PROJ_WBONE);		// Bone nails (fire/scorpion)
	precache_model (ad_MODEL_PROJ_WPOISON);	// Poison nails (spider)
	
	precache_model (self.ad_gib1mdl);
	precache_model (self.ad_gib2mdl);
	precache_model (self.ad_gib3mdl);
	
	self.ad_idle_sound = "wraith/idle1.wav";
	self.ad_idle_sound2 = "wraith/idle2.wav";
	self.ad_idle_soundcom = "wraith/idle3.wav";
	precache_sound (self.ad_idle_sound);
	precache_sound (self.ad_idle_sound2);
	precache_sound (self.ad_idle_soundcom);
	
	precache_sound ("wraith/death1.wav");
	self.ad_pain_sound = "wraith/pain1.wav";
	precache_sound (self.ad_pain_sound);

	precache_sound ("wraith/attack1.wav");	// HITSCAN bolt
	precache_sound ("drole/r_explode.wav");
	precache_model (ad_SBURST_FLAME);			// Flames

	precache_sound ("wraith/attack2.wav");	// Nail/Bones
	precache_sound ("wraith/attack3.wav");	// Minions
	precache_sound ("wraith/bounce.wav");	// Egg bounce

	self.ad_sight_sound = "wraith/sight1.wav";
	precache_sound (self.ad_sight_sound);

	self.solid = ad_SOLID_NOT;				// No interaction with world
	self.movetype = ad_MOVETYPE_NONE;		// Static item, no movement
	if (self.ad_bboxtype < 1) self.ad_bboxtype = ad_BBOX_WIDE;
	if (self.health < 1) self.health = 350;
	self.alpha = ad_WRAITH_ALPHA;			// Semi transparent
	self.yaw_speed = 35;				// Can turn really fast
	self.ad_gibhealth = ad_MON_NEVERGIB;		// Cannot be gibbed by weapons
	self.ad_gibbed = ad_FALSE;				// Not falling apart
	self.ad_pain_flinch = 70;				// High pain threshold
	self.ad_blockudeath = ad_TRUE;			// no humanoid death sound
	self.ad_steptype = ad_FS_FLYING;			// Floating around!
	if (self.height < 1) self.height = ad_MONAI_ABOVEDIST; // Custom height
	self.frame = 1;						// First frame is never used!
	self.ad_deathstring = " was shattered by a Wraith\n";
	
	// Hitscan = 52 4 6; Nails = 60 4 14; Egg = 20 2 12;
	self.ad_attack_offset = '30 2 8';		// Half way point 

	// Always reset Ammo Resistance to be consistent
	self.ad_resist_shells = self.ad_resist_nails = 0;
	self.ad_resist_rockets = self.ad_resist_cells = 0;

	self.ad_th_checkattack = ad_WraithCheckAttack;
	self.ad_th_stand = ad_wraith_stand1;
	self.ad_th_walk = ad_wraith_walk1;
	self.ad_th_run = ad_wraith_run1;
	self.ad_th_missile = ad_wraith_magic;
	self.ad_th_pain = ad_wraith_pain;
	self.ad_th_die = ad_wraith_die;

	// Cannot be both scorpion and spider minion spawner, def=spider
	if (self.spawnflags & ad_MON_WRAITH_SCORPIONS && self.spawnflags & ad_MON_WRAITH_SPIDERS)
		self.spawnflags = self.spawnflags - ad_MON_WRAITH_SCORPIONS;
	
	// Setup each wraith type with different skins/particles
	if (self.spawnflags & ad_MON_WRAITH_SCORPIONS) {
		// Check for override first, default should be 3 not 5 (spiders)
		if (self.ad_minion_maxcount < 1) self.ad_minion_maxcount = 3;
		self.ad_exactskin = ad_WRAITH_SKINPURPLE;			// Purple/Blood skin
		self.ad_poisonous = ad_FALSE;						// Must be off for scorpion wraith
		self.ad_part_style = ad_PARTICLE_BURST_PURPLE;	// Purple cloud
	}
	else if (self.spawnflags & ad_MON_WRAITH_SPIDERS) {
		self.ad_exactskin = ad_WRAITH_SKINGREEN;			// Poison/Green skin
		self.ad_poisonous = ad_TRUE;						// Fires Poison needles
		self.ad_part_style = ad_PARTICLE_BURST_GREEN;		// Poison cloud
	}
	else {
		self.ad_exactskin = ad_WRAITH_SKINBLUE;	// Blue/Red skin
		self.ad_poisonous = ad_FALSE;				// Must be off for fire wraith
		self.ad_part_style = ad_PARTICLE_BURST_FIRE;
	}
		
	self.ad_classtype = ad_CT_MONWRAITH;
	self.ad_classgroup = ad_CG_SPIDER;
	self.ad_classmove = ad_MON_MOVEFLY;
	
	ad_monster_start();
};
