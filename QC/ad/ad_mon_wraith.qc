void() ad_wraith_stand6 =[ $stand9, ad_wraith_stand7 ] { ad_ai_stand();};
void() ad_wraith_stand7 =[ $stand9, ad_wraith_stand8 ] { ad_ai_stand();};
void() ad_wraith_stand8 =[ $stand8, ad_wraith_stand9 ] { ad_ai_stand();};
void() ad_wraith_stand9 =[ $stand7, ad_wraith_stand10 ] { ad_ai_stand();};
void() ad_wraith_stand10 =[ $stand6, ad_wraith_stand11 ] { ad_ai_stand();};
void() ad_wraith_stand11 =[ $stand5, ad_wraith_stand12 ] { ad_ai_stand();};
