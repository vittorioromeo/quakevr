/*
=========================================================================

HEALTH BOXES

=========================================================================
*/

float	cu_ITEM_HEALTH_ROTTEN = 1;
float	cu_ITEM_HEALTH_MEGA = 2;


void() cu_health_touch =
{
	if (!cu_CheckValidTouch()) return;
	
	if (!cu_T_Heal(other, self.healamount, (self.spawnflags & cu_ITEM_HEALTH_MEGA)))
		return;

	// coop 1 megahealth brings all other clients up to 100
	entity cu_pl;
	if (coop == 1 && self.spawnflags & cu_ITEM_HEALTH_MEGA)
	{
		cu_pl = cu_get_next_client(other);
		while (cu_pl != other)
		{
			if (cu_T_Heal(cu_pl, 100, cu_FALSE))
			{
				sprint(cu_pl, "You were restored by ");
				sprint(cu_pl, other.netname);
				sprint(cu_pl, "'s Megahealth\n");
				sound(cu_pl, cu_CHAN_ITEM, self.noise, 1, cu_ATTN_NORM);
			}
			cu_pl = cu_get_next_client(cu_pl);
		}
	}

	sound(other, cu_CHAN_ITEM, self.noise, 1, cu_ATTN_NORM);

	cu_ItemTouched();
}	


/*
================================
item_health & item_health_go
split up precaches and business code for late game health spawns
================================
*/
void() cu_item_health_go
{
	self.touch = cu_health_touch;
	self.cu_type = "health";

	if (self.spawnflags & cu_ITEM_HEALTH_ROTTEN)
	{
		setmodel(self, "progs/m_h15.mdl");
		self.noise = "items/r_item1.wav";
		self.healamount = 15;
	}
	else if (self.spawnflags & cu_ITEM_HEALTH_MEGA)
	{
		setmodel(self, "progs/m_h100.mdl");
		self.noise = "items/r_item2.wav";
		self.healamount = 100;
	}
	else
	{
		setmodel(self, "progs/m_h25.mdl");
		self.noise = "items/health1.wav";
		self.healamount = 25;
	}
	setsize (self, '0 0 0', '32 32 56');
	
	if (deathmatch == 1 || deathmatch == 3)
	{
		if (self.spawnflags & cu_ITEM_HEALTH_MEGA)
			// 20 seconds after health <= 100, minimum 25 seconds
			// Copper doesn't handle megahealth the same way, so we can't do that.
			// This is a longer time, picked somewhat arbitrarily.
			// This will be slower than vanilla id1 if you're taking a lot of damage,
			// but faster if you're being relatively safe.
			self.wait = 40;
		else
			self.wait = 20;
	}
		
	cu_StartItem ();
}

// ===============================================================================

/*cu:QUAKED item_health (0 .5 .5) (0 0 0) (32 32 24) SMALL MEGA SUSPENDED 
Health box. Normally gives 25 points.

Flags:
"mega" will add 100 health, then rot you down to your maximum health limit, one point per second
"small" gives 15 points

Keys:
"target/2/3/4/k" - entity to trigger when picked up
"targetname" - will not spawn until triggered
"wait" - will respawn after 'wait' seconds. fires targets every time.
"count" - limit number of times to respawn
*/
/*FGD
@PointClass size(0 0 0, 32 32 24) color(0 128 128) base(Item) 
	model(
        {{
            spawnflags & 2 ->   ":maps/b_bh100.bsp",
            spawnflags & 1 ->   ":maps/b_bh10.bsp",
                                ":maps/b_bh25.bsp"
        }}
    ) =
    item_health : "Health pack, +25" 
[
	spawnflags(flags) = 
	[
		1 : "Small, +15" : 0
		2 : "Megahealth, +100" : 0
	]
]
*/
void() cu_item_health =
{	
	if (!cu_SUB_ShouldSpawn()) return;
	if (self.spawnflags & cu_ITEM_HEALTH_MEGA)
	{
		cu_precache_model_safe("progs/m_h100.mdl");
		cu_precache_sound_safe("items/r_item2.wav");
	}
	else if (self.spawnflags & cu_ITEM_HEALTH_ROTTEN)
	{
		cu_precache_model_safe("progs/m_h15.mdl");
		cu_precache_sound_safe("items/r_item1.wav");
	}
	else
	{
		cu_precache_model_safe("progs/m_h25.mdl");
		cu_precache_sound_safe("items/health1.wav");
	}

	cu_item_health_go();
}





/*
===============================================================================

ARMOR

armorvalue = hit point quantity
armortype = 0-1 protection rate

===============================================================================
*/

float cu_ARMORTYPE_GREEN = 0.3;
float cu_ARMORTYPE_YELLOW = 0.5;
float cu_ARMORTYPE_RED = 0.7;

/*
============
armor_set_type
============
*/
void(entity cu_e) cu_armor_set_type =
{
	if (cu_e.classname != "player")
		return;
	
	cu_e.items = cu_not(cu_e.items, (cu_IT_ARMOR1 | cu_IT_ARMOR2 | cu_IT_ARMOR3));
	if (!cu_e.armorvalue)
	{
		cu_e.armortype = 0.0;
		return;
	}
	
	if (cu_e.armortype < cu_ARMORTYPE_YELLOW)
		cu_e.items |= cu_IT_ARMOR1;
	else if (cu_e.armortype < cu_ARMORTYPE_RED)
		cu_e.items |= cu_IT_ARMOR2;
	else
		cu_e.items |= cu_IT_ARMOR3;
	
	cu_e.armorvalue = cu_min(cu_e.armorvalue, 500);
}


/*
============
armor_give
============
*/
float(entity cu_e, float cu_amt, float cu_absorb, float cu_replace) cu_armor_give =
{
	if (!cu_amt)
		return cu_FALSE;
	if (cu_replace)
	{
		if (cu_absorb < cu_e.armortype)
		{
			// strength downgrade, quantity upgrade
			// quake's original armor comparison test weighted both amounts by their protection
			// strength with a straight multiply (a.type * a.amt > e.type * e.amt) to determine 
			// which was "worth" more. with the current values, those breakeven points fall on
			// 42, 60, and 107, so we round those off to make it easier for players to notice
			// and learn the pickup cutoffs
			if (cu_absorb == cu_ARMORTYPE_GREEN && cu_e.armortype == cu_ARMORTYPE_RED && cu_e.armorvalue > 40)
				return cu_FALSE;
			if (cu_absorb == cu_ARMORTYPE_GREEN && cu_e.armortype == cu_ARMORTYPE_YELLOW && cu_e.armorvalue > 60)
				return cu_FALSE;
			if (cu_absorb == cu_ARMORTYPE_YELLOW && cu_e.armortype == cu_ARMORTYPE_RED && cu_e.armorvalue > 100)
				return cu_FALSE;
		}
		else if (cu_absorb == cu_e.armortype)
		{	// strength match or strict downgrade
			if (cu_amt <= cu_e.armorvalue)
				return cu_FALSE;
		}
		else
		{	// strength upgrade
			if (cu_amt < cu_e.armorvalue)
			{	// weird edge case: strength upgrade, quantity downgrade
				// we can accumulate enough of a weak armor (by picking up backpacks or
				// through target_items horseplay) that we can be shut out of picking up
				// a stronger one, so let the player keep a portion of their saved-up 
				// extra armor at the new strength
				
				if (cu_absorb == cu_ARMORTYPE_RED && cu_e.armortype == cu_ARMORTYPE_GREEN)
					cu_amt = floor((cu_amt * 3 + cu_e.armorvalue) / 4);	// keep 1/4 of the excess
				else
					cu_amt = floor((cu_amt + cu_e.armorvalue) / 2);		// keep 1/2 if it
			}
		}
		cu_e.armorvalue = cu_amt;
		cu_e.armortype = cu_absorb;
	}
	else
	{
		if (cu_absorb > cu_e.armortype)
			cu_e.armortype = cu_absorb;
		else if (cu_e.armortype == 0)
			cu_e.armortype = cu_ARMORTYPE_GREEN;
		cu_e.armorvalue += cu_amt;
	}
	
	cu_armor_set_type(cu_e);
	return cu_TRUE;
}


/*
============
armor_touch
============
*/
void() cu_armor_touch =
{
	if (!cu_CheckValidTouch()) return;
	
	if (!cu_armor_give(other, self.armorvalue, self.armortype, cu_TRUE))
		return;

	sound(other, cu_CHAN_ITEM, "items/armor1.wav", 1, cu_ATTN_NORM);
	sprint(other, "You got armor\n");

	stuffcmd (other, "bf\n");
	cu_ItemTouched();
}

// ===============================================================================

/*
============
StartArmor
============
*/
void(float cu_skn, float cu_amt) cu_StartArmor =
{
	if (!cu_SUB_ShouldSpawn()) return;

	self.skin = cu_skn;
	self.armorvalue = cu_amt;
	if (cu_skn == 2)
		self.armortype = cu_ARMORTYPE_RED;
	else if (cu_skn == 1)
		self.armortype = cu_ARMORTYPE_YELLOW;
	else
		self.armortype = cu_ARMORTYPE_GREEN;

	self.touch = cu_armor_touch;
	self.cu_type = "armor";
	cu_precache_model_safe ("progs/armor.mdl");
	setmodel (self, "progs/armor.mdl");
	
	if (deathmatch == 1 || deathmatch == 3)
		self.wait = 20;

	setsize (self, '-16 -16 0', '16 16 56');
	cu_StartItem ();
}


