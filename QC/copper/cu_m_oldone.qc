// make fake versions of all players as standins, and move the real
// players to the intermission spot
void() cu_shub_set_viewpoints =
{
	local entity	cu_pos, cu_pl;

	cu_intermission_exittime = time + cu_A_SHITLOAD;	// no exit yet
	cu_intermission = 1;

	// find the intermission spot
	cu_pos = find (world, classname, "info_intermission");
	if (!cu_pos)
		cu_pos = find (world, classname, "info_player_start");
	if (!cu_pos)
		error ("no info_intermission");
	self.cu_buddy = cu_pos;
	cu_pl = find (world, classname, "misc_teleporttrain");
	if (cu_pl) remove (cu_pl);

	WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
	WriteString (cu_MSG_ALL, cu_string_null);

	cu_move_players_to_intermission();
}

void() cu_shub_dudecycle =
{
	self.frame += 1;
	if (cu_skill > 2)
	{
		if (self.frame > 28) self.frame = 17;
	}
	else
	{
		if (self.frame > 16) self.frame = 12; 
	}
	self.nextthink = time + 0.1;
}

void() cu_shub_finale_1 =
{
	local entity	cu_timer;

	cu_shub_set_viewpoints();
	
	// wait for 1 second
	cu_timer = spawn();
	cu_timer.nextthink = time + 1;
	cu_timer.think = cu_shub_finale_2;
	cu_timer.enemy = self;
}

void() cu_shub_finale_2 =
{
	local vector	cu_o;

	// start a teleport splash inside shub
	makevectors(self.angles);

	cu_o = self.origin + 100 * v_forward;
	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_BROADCAST, cu_TE_TELEPORT);
	WriteCoord (cu_MSG_BROADCAST, cu_o_x);
	WriteCoord (cu_MSG_BROADCAST, cu_o_y);
	WriteCoord (cu_MSG_BROADCAST, cu_o_z);

	sound (self.enemy, cu_CHAN_VOICE, "misc/r_tele1.wav", 1, cu_ATTN_NORM);
	
	self.nextthink = time + 2;
	self.think = cu_shub_finale_3;
}

void() cu_shub_finale_3 =
{
	// start shub thrashing wildly
	self.enemy.cu_strength = 2;
	self.enemy.think = cu_old_thrash1;
}

void() cu_shub_finale_4 =
{
	vector	cu_org;
	entity	cu_n;//, cl;
	float	x, y, z;
	float	cu_r;

	sound (self, cu_CHAN_VOICE, "boss2/pop2.wav", 1, cu_ATTN_NONE);

	// throw tons of meat chunks	
	cu_org = self.origin;
	
	for (z = 16; z <= 144; z += 96)
	{
		for (x = -64; x <= 64; x += 32)
		{
			for (y = -64; y <= 64; y += 32)
			{
				self.origin_x = cu_org_x + x;
				self.origin_y = cu_org_y + y;
				self.origin_z = cu_org_z + z;

				cu_r = random();
				if (cu_r < 0.3)				
					cu_ThrowGib ("progs/gib1.mdl", cu_GibVelocityForHealth(-150 - random() * 180));
				else if (cu_r < 0.6)
					cu_ThrowGib ("progs/gib2.mdl", cu_GibVelocityForHealth(-150 - random() * 180));
				else
					cu_ThrowGib ("progs/gib3.mdl", cu_GibVelocityForHealth(-150 - random() * 180));
			}
		}
	}
	
	lightstyle(0, "m");
	self.origin = cu_org;
	cu_killed_monster();
	cu_activator = self.enemy;
	cu_monster_death_use();
	
	// end the level
	if (!(self.spawnflags & 1))
	{
		// do this if we triggered shub to death
		if (self.health >= 0)
			cu_shub_set_viewpoints();
		
		// there's code here to clone all coop players for the tableau, but .colormap
		// hasn't worked on non-clients in any GL port of quake and four identical
		// rangers in yellow just look stupid instead
		
		makevectors(self.angles);
		/*
		cl = nextent(world);
		x = 0;
		while (cl.classname == "player")
		{*/
			// put a player model down
			cu_n = spawn();
			setmodel (cu_n, "progs/player.mdl");
			cu_n.angles = self.angles;
			/*
			if (coop)
			{
				n.colormap = cl.colormap;
				// line up coop players for the team portrait
				if (x == 0)
				{
					setorigin (n, self.origin + v_forward * 128 + v_right * -16);
					n.angles_y += 8;
				}
				else if (x == 1)
				{
					setorigin (n, self.origin + v_forward * 112 + v_right * 16);
					n.angles_y -= 4;
				}
				else if (x == 2)
				{
					setorigin (n, self.origin + v_forward * 88 + v_right * -40);
					n.angles_y += 16;
				}
				else if (x == 3)
				{
					setorigin (n, self.origin + v_forward * 80 + v_right * 40);
					n.angles_y -= 12;
				}
			}
			else
			{*/
				setorigin (cu_n, self.origin + v_forward * 128);	
			//}
			
			if (cu_skill > 2)	// axe on nightmare because you are very badass
			{
				cu_n.angles_y -= 35;
				cu_n.frame = 17 + floor(random() * 9.9);
			}
			else
			{
				cu_n.angles_y += 25;
				cu_n.frame = 12 + floor(random() * 2.9);
			}
			cu_n.think = cu_shub_dudecycle;
			cu_n.nextthink = time + 0.1;
			//cl = nextent(cl);
			//x++;
		//}
		
		// kill everything else
		cu_shub_gibnearby();
		cu_Cheat_Genocide();
		
		// allow the player to click back to a reset start map
		cu_nextmap = self.map;
		cu_intermission_exittime = time + 3;
		cu_intermission = 2;
		serverflags = 0;	// clear all the runes and stuff
		
		// start the end text
		WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
		WriteString (cu_MSG_ALL, self.noise4);

	// switch cd track
		WriteByte (cu_MSG_ALL, cu_SVC_CDTRACK);
		WriteByte (cu_MSG_ALL, 2);
		WriteByte (cu_MSG_ALL, 2);
	}
	
	remove (self);
}


void() cu_shub_axefinale_1 =
{
	cu_shub_set_viewpoints();
	cu_shub_finale_4();
}

//============================================================================

// clean up environs for the dramatic final shot - gib monsters in the way so the 
// body pile isn't too deep, and just get rid of backpacks
void() cu_shub_gibnearby =
{
	entity cu_head;
	
	cu_head = findradius(self.origin, 272);	
	while (cu_head)
	{
		if (cu_head.flags & cu_FL_MONSTER)
		{
			cu_monster_kill(cu_head);
		}
		cu_head = cu_head.chain;
	}
	
	cu_head = cu_findradiusplus(self.origin, 272, model, "progs/backpack.mdl");
	while (cu_head)
	{
		remove(cu_head);
		cu_head = cu_head.chain;
	}	
}

void() cu_shub_die =
{
	self.deadflag = cu_DEAD_DYING;
	if (self.spawnflags & 1)
		cu_shub_finale_4();
	else
		cu_shub_finale_1();
}

// rather than a telefrag, shub can be killed by triggering her a
// specifiable number of times, to allow for more possible encounters
void() cu_shub_use =
{
	self.cu_strength -= 1;
	self.enemy = cu_activator;
	cu_old_thrash1();
}

void (entity cu_attacker, float cu_damage) cu_shub_pain =
{
	if (self.deadflag) return;

	// a separate 'pain counter' is reduced by
	// any damage over 10000
	if (cu_damage >= 10000)
	{
		cu_shub_use();
	}
	if (self.health > 0)
		self.health = 49999;	// stay dead
}

