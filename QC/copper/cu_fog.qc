float cu_FOG_INTERVAL = 0.05;

/*FGD
@baseclass = Fog [ 
	fog_density(string) : "Fog Density (-1 for clear)" 
	fog_color(string) : "Fog Color" 
	fog_sky(string) : "Sky Fog Density (-1 for clear sky)" 
]
@baseclass = FogShift [ 
	fog_density(string) : "Start Fog Density (-1 for clear)" 
	fog_color(string) : "Start Fog Color" 
	fog_sky(string) : "Start Sky Fog Density (-1 for clear sky)" 
	fog_density2(string) : "End Fog Density (-1 for clear)" 
	fog_color2(string) : "End Fog Color" 
	fog_sky2(string) : "End Sky Fog Density (-1 for clear sky)" 
]
*/

/*
for mappers, -1 means "force to zero" and 0 means "ignore" (density and sky)

within this code, -1 means "ignore" and all values 0-1 are values to be set

yes these are opposites, but the first was necessary for consistency with
other behavior and for back compatibility (skyfog is 0 in all maps made before
1.30 when skyfog control was added, for example) and the second just makes the
code more sensible, so all entities are converted at spawn time

for added complication, the old way to force zero density on fog was to set
a non-black color but leave density at zero, which was a mistake to require,
but it's done now and needs to stay supported
*/
void() cu_fog_fixKeys =
{
	// if color is not set
		// 0 density counts as ignore (-1)
		// -1 density counts as set-to-0
	// if color is set
		// 0 density counts as set-to-0
		// -1 density counts as set-to-0
	if (self.fog_color == cu_VEC_ORIGIN)
		self.fog_density = cu_zeroconvertdefault(self.fog_density, -1);
	else
		if (self.fog_density <= 0)
			self.fog_density = 0;
	
	if (self.cu_fog_color2 == cu_VEC_ORIGIN)
		self.cu_fog_density2 = cu_zeroconvertdefault(self.cu_fog_density2, -1);
	else
		if (self.cu_fog_density2 <= 0)
			self.cu_fog_density2 = 0;
	
	if (self.fog_color_x > 1 || self.fog_color_y > 1 || self.fog_color_z > 1)
		self.fog_color /= 255;
	if (self.cu_fog_color2_x > 1 || self.cu_fog_color2_y > 1 || self.cu_fog_color2_z > 1)
		self.cu_fog_color2 /= 255;

	self.cu_fog_sky = cu_zeroconvertdefault(self.cu_fog_sky, -1);
	self.cu_fog_sky2 = cu_zeroconvertdefault(self.cu_fog_sky2, -1);
}

float(entity cu_e, float cu_dens, vector cu_col, float cu_sky) cu_fog_sigdif =
{
	float cu_sig;
	
	if ((cu_e.fog_density + cu_dens) * 0.5 < 0.1) cu_sig = 0.0025;
	else cu_sig = 0.005;
	if (fabs(cu_e.fog_density - cu_dens) > cu_sig) return cu_TRUE;
	
	if ((cu_e.cu_fog_sky + cu_sky) * 0.5 < 0.1) cu_sig = 0.005;
	else cu_sig = 0.01;
	if (fabs(cu_e.cu_fog_sky - cu_sky) > cu_sig) return cu_TRUE;
	
	if ((cu_e.fog_color_x + cu_col_x) * 0.5 < 0.1) cu_sig = 0.005;
	else cu_sig = 0.01;
	if (fabs(cu_e.fog_color_x - cu_col_x) > cu_sig) return cu_TRUE;
	
	if ((cu_e.fog_color_y + cu_col_y) * 0.5 < 0.1) cu_sig = 0.005;
	else cu_sig = 0.01;
	if (fabs(cu_e.fog_color_y - cu_col_y) > cu_sig) return cu_TRUE;
	
	if ((cu_e.fog_color_z + cu_col_z) * 0.5 < 0.1) cu_sig = 0.005;
	else cu_sig = 0.01;
	if (fabs(cu_e.fog_color_z - cu_col_z) > cu_sig) return cu_TRUE;
	
	return cu_FALSE;
}

float(float cu_a, float cu_b, float cu_f) cu_fog_lerpf =
{
	// don't lerp the -1 values
	if (cu_a < 0 || cu_f >= 1) return cu_b;
	if (cu_b < 0 || cu_f <= 0) return cu_a;
	return cu_b * cu_f + cu_a * (1 - cu_f);
}
float(float cu_a, float cu_b, float cu_f) cu_fog_lerpHermite =
{
	// don't lerp the -1 values
	if (cu_a < 0 || cu_f >= 1) return cu_b;
	if (cu_b < 0 || cu_f <= 0) return cu_a;
	return cu_lerpHermite(cu_a, cu_b, cu_f);
}

/*
================
fog_save
================
*/
void( entity cu_client, float cu_density, vector cu_color, float cu_sky ) cu_fog_save =
{
	if (cu_client.classname != "player") return;
	
	// save whatever we set the client's fog to in case of saves/loads
	cu_client.fog_density = cu_density;
	cu_client.fog_color = cu_color;
	cu_client.cu_fog_sky = cu_sky;
}

/*
================
fog_setFromEnt
================
*/
void( entity cu_client, entity cu_fogger ) cu_fog_setFromEnt =
{
	dprint("setting fog values\n");
	// don't set the fog if the entity has no values, because it might be a custom map with
	// _fog on the worldspawn instead
	if (cu_fogger.fog_density == -1 && cu_fogger.cu_fog_sky == -1)
		return;
	
	cu_fog_set(cu_client, cu_fogger.fog_density, cu_fogger.fog_color, cu_fogger.cu_fog_sky);
}

/*
================
fog_set
================
*/
void( entity cu_client, float cu_density, vector cu_color, float cu_sky ) cu_fog_set =
{
	if (cu_client.classname != "player") return;
	if (!cu_initCleanup)
	{
		if (cu_client.fog_density == cu_density && cu_client.fog_color == cu_color && cu_client.cu_fog_sky == cu_sky)
			return cu_FALSE;
	}

	//dprint5("fog ",ftos(density*1000),vtos(color),ftos(sky*100),"\n");

	if (cu_noTint && (cu_client.cu_customflags & cu_CFL_PLUNGE))	// don't interfere with no-tint void fog
	{
		cu_client.cu_fog_density2 = cu_density;
		cu_client.cu_fog_color2 = cu_color;
		if (cu_sky) cu_client.cu_fog_sky2 = cu_sky;
		return;
	}
	
	if (cu_density != -1)
	{
		MG_SetFog(cu_client, cu_density, cu_color * (cu_icantsee + 1)); // QVR: the one fog path (svc_fog, vr_mg_fog.qc), as MG's and AD's
	}
	if (cu_sky != -1)
	{
		float cu_skyz = cu_zeroconvert(cu_sky);
		stuffcmd(cu_client, "r_skyfog ");
		cu_stuffcmd_float(cu_client, cu_skyz);
		stuffcmd(cu_client, "\n");
	}
	cu_fog_save(cu_client, cu_density, cu_color, cu_sky);
}

/*
================
fog_blendTouch
================
*/
void() cu_fog_blendTouch =
{
	if (!cu_CheckValidTouch()) return;
	
	// fix for only first client getting a fog change when multiple coop clients are touching this at once
	if (time != self.cu_rad_time)	// because fog is rad?
		if (time < self.cu_attack_finished)
			return;
		
	float cu_f, cu_ldensity, cu_lsky, cu_leaving, cu_force;
	vector cu_dorg, cu_mid, cu_ovel;
	vector cu_lcolor;
	
	cu_force = (time - self.cu_invisible_time >= cu_FOG_INTERVAL * 10);
	
	// if you run/fall through a fogblend fast enough you can come out the other side 
	// partially blended, so check if player will exit the trigger bounds before the 
	// next touch (same class of bug as leaping through lasers in Q2)
	cu_ovel = (other.groundentity.velocity + other.velocity) * cu_FOG_INTERVAL;
	cu_leaving = ( (other.absmax_x + cu_ovel_x < self.absmin_x) ||
				(other.absmax_y + cu_ovel_y < self.absmin_y) ||
				(other.absmax_z + cu_ovel_z < self.absmin_z) ||
				(other.absmin_x + cu_ovel_x > self.absmax_x) ||
				(other.absmin_y + cu_ovel_y > self.absmax_y) ||
				(other.absmin_z + cu_ovel_z > self.absmax_z) );
				
	if (cu_leaving)
	{
		// last chance to set fog correctly, so snap it to the final values
		cu_leaving = cu_ovel * self.movedir;
		if (cu_leaving > 0)
		{
			cu_ldensity = self.cu_fog_density2;
			cu_lcolor = self.cu_fog_color2;
			cu_lsky = self.cu_fog_sky2;
		}
		else
		{
			cu_ldensity = self.fog_density;
			cu_lcolor = self.fog_color;
			cu_lsky = self.cu_fog_sky;
		}
		cu_force = cu_TRUE;
	}
	else
	{
		// in transition, blend proportionally between the two fogs
		cu_mid = (self.mins + self.maxs) * 0.5;
		cu_dorg = other.origin + other.view_ofs - cu_mid;
		
		cu_f = cu_dorg * self.movedir;
		cu_f = (cu_f / self.distance) + 0.5;
		
		cu_ldensity = cu_fog_lerpf(self.fog_density, self.cu_fog_density2, cu_f);
		cu_lcolor = cu_lerpVector(self.fog_color, self.cu_fog_color2, cu_f);
		cu_lsky = cu_fog_lerpf(self.cu_fog_sky, self.cu_fog_sky2, cu_f);
	}
	
	if (cu_force || cu_fog_sigdif(other,cu_ldensity,cu_lcolor,cu_lsky))
	{
		self.cu_invisible_time = time;
		cu_fog_set(other, cu_ldensity, cu_lcolor, cu_lsky);
	}
	
	self.cu_rad_time = time;
	self.cu_attack_finished = time + cu_FOG_INTERVAL / 2;
	
//	bprint(ftos(f*1000));
//	bprint("\n");
}


/*cu:QUAKED trigger_fogblend (.5 .5 .2) ?
Acts as a smoothly blending portal between two zones of different fog. Sets the fog for any client passing through it, blending their global fog settings between "fog_color"/"fog_density" and "fog_color2"/"fog_density2" proportional to their position within the trigger.
"fog_sky"/"fog_sky2" will affect r_skyfog at the same time if both are non-zero. Use -1 if you really want 0.

The axis of motion on which the blend happens is defined by "angle", pointing to whatever zone has color2 and density2.  Trigger therefore has two 'sides' - the side that "angle" points to, and the opposite side.  

"distance" - override the length of the blend period in world units - defaults to bounds size 
	on 'angle' otherwise. this is only useful for diagonal triggers.

CAVEATS:
- will 'stuffcmd' up to 20 times per frame so try not to make these huge, but as an optimization, Copper will avoid sending the stuffcmd if it determines that the fog difference frame over frame is not visually significant.
- a bug in most quake engine ports will reset the eye position smoothing that happens when climbing stairs or riding a plat on every frame that a 'stuffcmd' is sent, so fog transitions during upwards motion will cause noticeable stuttering.
*/
/*FGD
@SolidClass color(128 128 0) base(Appearflags, Targetname, FogShift) = trigger_fogblend : 
"Trigger: Fog Blend
Acts as a smoothly blending portal between two zones of different fog. Sets the fog for any client passing through it, blending their global fog settings between start and end values proportional to their position within the trigger.
fog_sky/fog_sky2 will affect r_skyfog at the same time if both are non-zero. Use -1 if you really want 0.

- will 'stuffcmd' up to 20 times per frame so try not to make these huge, but as an optimization, Copper will avoid sending the stuffcmd if it determines that the fog difference frame over frame is not visually significant.
- a bug in most quake engine ports will reset the eye position smoothing that happens when climbing stairs or riding a plat on every frame that a 'stuffcmd' is sent, so fog transitions during upwards motion will cause noticeable stuttering." 
[
	distance(integer) : "Length of blend distance (defaults to size of trigger)"
	angle(integer) : "Axis of motion of blend (points toward end values)"
]
*/
void() cu_trigger_fogblend =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (self.angles == '0 0 0')		// InitTrigger assumes angle 0 means no angle
		self.angles = '0 360 0';

	cu_InitTrigger ();
	self.touch = cu_fog_blendTouch;
	self.distance = cu_zeroconvertdefault(self.distance, cu_BoundsAngleSize(self.movedir, self.size));
	cu_fog_fixKeys();
}


// ================================

/*
================
target_fogblend_use
================
*/
void() cu_target_fogblend_use =
{
	self.enemy = cu_SUB_PlayerizeActivator();
	
	if (!(self.spawnflags & 1))
		self.state = 1 - self.state;
	
	if (self.state)
		self.cu_pain_finished = time + self.delay + self.speed;
	else
		self.cu_pain_finished = time + self.delay + self.speed2;
	
	if (self.delay > 0)
	{
		self.think = cu_fog_blendTimeThink;
		self.nextthink = time + self.delay;
	}
	else
		cu_fog_blendTimeThink();
}

/*
================
fog_blendTimeThink
================
*/
void() cu_fog_blendTimeThink =
{
	float cu_f, cu_ldensity, cu_lsky, cu_force;
	vector cu_lcolor;
	entity cu_pl;
	
	if (time >= self.cu_pain_finished)
	{
		cu_f = 1;
		self.use = cu_target_fogblend_use;
	}
	else
	{
		// don't allow retriggering before the blend is done or it looks super duper wacky
		self.use = cu_SUB_Null;
		self.nextthink = time + cu_FOG_INTERVAL;//self.delay;//wtf
		if (self.state && self.speed)
			cu_f = 1 - (self.cu_pain_finished - time) / self.speed;
		else if (!self.state && self.speed2)
			cu_f = 1 - (self.cu_pain_finished - time) / self.speed2;
		else
			cu_f = 1;
	}

	if (self.state == 0)
		cu_f = 1-cu_f;
	
	if (cu_f == 1)
	{
		cu_ldensity = self.cu_fog_density2;
		cu_lcolor = self.cu_fog_color2;
		cu_lsky = self.cu_fog_sky2;
		cu_force = cu_TRUE;
	}
	else if (cu_f == 0)
	{
		cu_ldensity = self.fog_density;
		cu_lcolor = self.fog_color;
		cu_lsky = self.cu_fog_sky;
		cu_force = cu_TRUE;
	}
	else
	{
		// in transition, blend proportionally between the two fogs
		cu_ldensity = cu_fog_lerpHermite(self.fog_density, self.cu_fog_density2, cu_f);
		cu_lcolor = cu_lerpVectorHermite(self.fog_color, self.cu_fog_color2, cu_f);
		cu_lsky = cu_fog_lerpHermite(self.cu_fog_sky, self.cu_fog_sky2, cu_f);
	}
	
	if (cu_force || cu_fog_sigdif(cu_pl, cu_ldensity, cu_lcolor, cu_lsky))
	{
		if (self.spawnflags & 4)
		{
			cu_pl = nextent(world);
			while (cu_pl.flags & cu_FL_CLIENT)
			{
				cu_fog_set(cu_pl, cu_ldensity, cu_lcolor, cu_lsky);
				cu_pl = nextent(cu_pl);
			}
		}
		else
			cu_fog_set(self.enemy, cu_ldensity, cu_lcolor, cu_lsky);
	}
}

/*cu:QUAKED target_fogblend (.5 .5 .2) (-8 -8 -8) (8 8 8) ONE_WAY REVERSE GLOBAL
Blends the fog for a client.  activator's fog will be blended from "fog_color" and "fog_density"
to "fog_color2" and "fog_density2".  Triggering again will blend it back, unless ONE_WAY is set.
"fog_sky"/"fog_sky2" will affect r_skyfog at the same time if both are non-zero. Use -1 if you really want 0.
Set REVERSE if you're tired of swapping the values by hand.
Set GLOBAL to affect all clients in multiplayer, not just the activator.

"delay" - pause before beginning to blend
"speed" - time to spend blending, -1 for an instant change to fog2.
"speed2" - time to spend blending back, if different than "speed". -1 for instant.

CAVEATS:
- will 'stuffcmd' up to 20 times per frame so try not to make this take too long, but as an optimization, Copper will avoid sending the stuffcmd if it determines that the fog difference frame over frame is not visually significant.
- a bug in most quake engine ports will reset the eye position smoothing that happens when climbing stairs or riding a plat on every frame that a 'stuffcmd' is sent, so fog transitions during upwards motion will cause noticeable stuttering.
*/
/*FGD
@PointClass base(Appearflags, Targetname, FogShift) color(128 128 50) = target_fogblend : 
"Target: Fog Blend
Activator's fog will be blended over time from start to end values.

- will 'stuffcmd' up to 20 times per frame so try not to make this take too long, but as an optimization, Copper will avoid sending the stuffcmd if it determines that the fog difference frame over frame is not visually significant.
- a bug in most quake engine ports will reset the eye position smoothing that happens when climbing stairs or riding a plat on every frame that a 'stuffcmd' is sent, so fog transitions during upwards motion will cause noticeable stuttering." 
[
	spawnflags(flags) = [
		1 : "One-Way Only" : 0
		2 : "Reverse Start/End" : 0
		4 : "All clients" : 0
	]
	delay(string) : "Pause before starting blend"
	speed(string) : "Time to blend (-1 for instant)"
	speed2(string) : "Time to blend back, if different (-1 for instant)"
]
*/
void() cu_target_fogblend =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.use = cu_target_fogblend_use;
	self.think = cu_fog_blendTimeThink;
	cu_fog_fixKeys();
	if (self.spawnflags & 2)
		self.state = 1;
	else
		self.state = 0;
	if (self.spawnflags & 1)
		self.state = 1 - self.state;
	
	if (!self.speed) self.speed = 1;
	if (self.speed == -1) self.speed = 0;
	
	if (!self.speed2) self.speed2 = self.speed;
	if (self.speed2 == -1) self.speed2 = 0;
}