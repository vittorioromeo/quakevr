void() cu_light_fluoro =
{
	if (self.style >= 32)
	{
		self.use = cu_light_use;
		if (self.spawnflags & cu_START_OFF)
			lightstyle(self.style, "a");
		else
			lightstyle(self.style, "m");
	}
	
	precache_sound ("ambience/fl_hum1.wav");
	ambientsound (self.origin, "ambience/fl_hum1.wav", 0.5, cu_ATTN_STATIC);
}

