string( float cu_st ) cu_GetLightStyle =
{
	if (cu_st == 1) return cu_light1;
	if (cu_st == 2) return cu_light2;
	if (cu_st == 3) return cu_light3;
	if (cu_st == 4) return cu_light4;
	if (cu_st == 5) return cu_light5;
	if (cu_st == 6) return cu_light6;
	if (cu_st == 7) return cu_light7;
	if (cu_st == 8) return cu_light8;
	if (cu_st == 9) return cu_light9;
	if (cu_st == 10) return cu_light10;
	if (cu_st == 11) return cu_light11;
/*	if (st == 12) return light12;
	if (st == 13) return light13;
	if (st == 14) return light14;
	if (st == 15) return light15;
	if (st == 16) return light16;
	if (st == 17) return light17;
	if (st == 18) return light18;*/
	
	if (cu_icantsee)
		return "z";
	return cu_light0;
}

void() cu_InitLightStyles =
{
	lightstyle(0, cu_light0);
	lightstyle(1, cu_light1);
	lightstyle(2, cu_light2);
	lightstyle(3, cu_light3);
	lightstyle(4, cu_light4);
	lightstyle(5, cu_light5);
	lightstyle(6, cu_light6);
	lightstyle(7, cu_light7);
	lightstyle(8, cu_light8);
	lightstyle(9, cu_light9);
	lightstyle(10, cu_light10);
	lightstyle(11, cu_light11);
/*	lightstyle(12, light12);
