    7 = candle: "mmmaaaabcdefgmmmmaaaammmaamm"
    8 = candle2: "mmmaaammmaaammmabcdefaaaammmmabcdefmmmaaaa"
    9 = slow strobe: "aaaaaaaazzzzzzzz"
    10 = flourescent flicker: mmamammmmammamamaaamammma"
    11 = slow pulse, fading to black: "abcdefghijklmnopqrrqponmlkjihgfedcba"

    styles 32-62 are assigned by the light program for switchable lights 
    (default: 0)
"message"	override the style string directly for the assigned style (clashes will overwrite each other)
"distance" sound attenuation range (integer) - defaults to 0, which is the same as other ambient sounds.
  1 = 'idle' - monster idle sound range
  2 = 'normal' - monster bark sound range
  3 = 'none' - loops everywhere forever (don't use this)
"volume" loudness (0-1), distinct from distance
*/
/*FGD
@PointClass base(Light, Flame) size(-4 -4 -12, 4 4 20) model({ "path": ":progs/flame2.mdl" }) = 
	light_flame_small_yellow : "Small yellow flame"  []
*/
void() cu_light_flame_small_yellow =
{
	precache_model ("progs/flame2.mdl");
	setmodel (self, "progs/flame2.mdl");
	cu_FireAmbient ();
	makestatic (self);
}

/*cu:QUAKED light_flame_small_white (1 1 0) (-4 -4 -12) (4 4 20)
Same as light_flame_small_yellow. Use that one.
*/
/*FGD
@PointClass base(Light, Flame) size(-4 -4 -12, 4 4 20) model({ "path": ":progs/flame2.mdl" }) = 
	light_flame_small_white : "Small white flame (same as light_flame_small_yellow)" []
*/
void() cu_light_flame_small_white =
{
	cu_light_flame_small_yellow();
}

// ================================================================

void() cu_light_candle_bob =
{
	self.dest = cu_func_bobbing_pos(time / self.speed + self.delay);
	self.velocity = (self.dest - self.origin) / self.cu_length;
	self.nextthink = time + self.cu_length;
}

float() cu_light_candle_check_bob =
{
	if (!(self.spawnflags & 4)) return cu_FALSE;
	
	// random bob offset
	self.delay = random();
	
	self.noise = ("misc/null.wav");
	self.noise1 = ("misc/null.wav");

	if (!self.distance)
		self.distance = 16;
	self.distance += 6 * cu_crandom();
	if (!self.speed)
		self.speed = 1;
	self.speed = (1 / self.speed) * (self.distance / (2 + random() + random()));
	self.wait = self.speed;

	self.movedir = '0 0 1';
	
	if (!self.pos1 && !self.pos2)
	{
		self.pos1 = self.origin + self.distance * 0.5 * self.movedir;
		self.pos2 = self.origin - self.distance * 0.5 * self.movedir;
	}
	self.cu_length = cu_min(0.1, self.wait / 6);

	self.movetype = cu_MOVETYPE_NOCLIP;
	self.think = cu_light_candle_bob;
	self.nextthink = time + 0.1;
	
	setorigin (self, cu_func_bobbing_pos(time / self.speed + self.delay));
	return cu_TRUE;
}


void() cu_light_candle_group_off =
{
	entity cu_c;
	cu_c = self;
	do {
		cu_c.frame = cu_not(cu_c.frame, 1);
		cu_c = cu_c.cu_buddy;
	} while (cu_c != self && cu_c != world);
}

void() cu_light_candle_group_on =
{
	entity cu_c;
	cu_c = self;
	do {
		cu_c.frame |= 1;
		cu_c = cu_c.cu_buddy;
	} while (cu_c != self && cu_c != world);
}

void() cu_light_candle_use =
{
	cu_light_use();
	if (self.spawnflags & cu_START_OFF)
		cu_light_candle_group_off();
	else
		cu_light_candle_group_on();
}

// cache all candles with the same targetname as a linked list, with the first
// one as master, so they can all be turned on and off in one target activation
// without searching the whole map each time
void() cu_light_candle_group =
{
	if (!self.cu_buddy)
	{
		entity cu_c, cu_clast;
		string cu_oh = self.targetname;
		cu_clast = cu_c = self;	
		do {
			cu_c = find(cu_c, targetname, cu_oh);
			if (cu_c.classname == "light_candle")
			{
				cu_clast.cu_buddy = cu_c;
				cu_c.targetname = cu_string_null;
				cu_clast = cu_c;
			}
		} while (cu_c != world);
		
		self.targetname = cu_oh;
		self.use = cu_light_candle_use;
	}
	cu_light_candle_check_bob();
}

/*cu:QUAKED light_candle (1 1 0) (-4 -4 0) (4 4 16) START_OFF - FLOATING
Candle. If triggered to turn on and off, all candles with a matching targetname will ignite or go out as well.
Keys:
"width" - choose width 1-3, default (0) is random
"height" - choose height 1-3, default (0) is random
"angle" - choose orientation, blank is random yaw
See 'light' keyvalues/spawnflags for more.

if FLOATING, will automatically become a gentle func_bobbing:
"distance" - rough float distance, default 16
"speed" - float speed modifier (<1 = slower, >1 = faster)
*/
/*FGD
@PointClass base(LightTriggerable) size(-4 -4 0, 4 4 16) model({ "path": ":progs/candle2.mdl" }) = 
	light_candle : "Animated candle. Trigger to turn on or off.
If triggered to turn on and off, all candles with a matching targetname will ignite or go out as well.
Choose size with 'width' and 'height' (leave either at 0 for random selection)."
[
	width(choices) : "Width" : 0 =
	[
		0: "Random"
		1: "Narrow"
		2: "Medium"
		3: "Thick"
	]
	height(choices) : "Height" : 0 =
	[
		0: "Random"
		1: "Short"
		2: "Medium"
		3: "Tall"
	]
	spawnflags(flags) = [
		4: "Floating" : 0
	]
	distance(string) : "Float distance (rough)" : "16"
	speed(string) : "Float speed modifier (<1 = slower, >1 = faster)" : "1.0"
]
*/
void() cu_light_candle =
{
	if (!self.cu_width)
		//self.width = 1 + floor(random()*2.99);
		self.cu_width = 1 + floor(fabs((self.origin_x % 5) + (self.origin_y % 13) - self.origin_z) % 3);
	if (!self.height)
		//self.height = 1 + floor(random()*2.99);
		self.height = 1 + floor(fabs((self.origin_x % 11) + (self.origin_y % 7) - self.origin_z) % 3);
	if (self.angles == cu_VEC_ORIGIN)
		self.angles_y = floor(fabs((self.origin_x % 17) + (self.origin_y % 23) - self.origin_z) % 10) * 36;
	
	if (self.height == 1)
		self.model = "progs/candle1.mdl";
	else if (self.height == 2)
		self.model = "progs/candle2.mdl";
	else if (self.height == 3)
		self.model = "progs/candle3.mdl";

	precache_model2(self.model);
	setmodel(self,self.model);
		
	if (self.cu_width == 1)
		self.frame = 4;
	else if (self.cu_width == 2)
		self.frame = 0;
	else if (self.cu_width == 3)
		self.frame = 2;
	if (!(self.spawnflags & cu_START_OFF))
		self.frame += 1;
	
	cu_light_message();
	
	if (self.targetname != cu_string_null || self.style >= 32)
	{
		cu_light_oldstyle();
		self.think = cu_light_candle_group;
		self.nextthink = time + 0.1;
		return;
	}
	if (!cu_light_candle_check_bob())
		makestatic(self);
}

// ================================================================

string() cu_target_lightstyle_next =
{
	entity cu_tls;
	if (self.owner) cu_tls = self.owner;
	else cu_tls = self;
	
	if (cu_tls.state == 0)
	{
		if (cu_tls.noise == cu_string_null)
			cu_tls.state = 0;
		else
			cu_tls.state += 1;
		return cu_tls.message;
	}
	else if (cu_tls.state == 1)
	{
		if (cu_tls.noise1 == cu_string_null)
			cu_tls.state = 0;
		else
			cu_tls.state += 1;
		return cu_tls.noise;
	}
	else if (cu_tls.state == 2)
	{
		if (cu_tls.noise2 == cu_string_null)
			cu_tls.state = 0;
		else
			cu_tls.state += 1;
		return cu_tls.noise1;
	}
	else if (cu_tls.state == 3)
	{
		if (cu_tls.noise3 == cu_string_null)
			cu_tls.state = 0;
		else
			cu_tls.state += 1;
		return cu_tls.noise2;
	}
	else if (cu_tls.state == 4)
	{
		if (cu_tls.noise4 == cu_string_null)
			cu_tls.state = 0;
		else
			cu_tls.state += 1;
		return cu_tls.noise3;
	}
	else if (cu_tls.state == 5)
	{
		cu_tls.state = 0;
		return cu_tls.noise4;
	}
	return cu_tls.message;
}

void(entity cu_l, string cu_st) cu_lightstyle_switch =
{
	if (cu_l.style)
		lightstyle(cu_l.style, cu_st);
	if (cu_l.cu_switchshadstyle)
		lightstyle(cu_l.cu_switchshadstyle, cu_st);
}

void() cu_target_lightstyle_go =
{
	float cu_st;
	string cu_newstyle = cu_target_lightstyle_next();
	if (self.style)
	{
		cu_st = cu_zeroconvert(self.style);		
		lightstyle(cu_st, cu_newstyle);
		return;
	}
	
	entity cu_l;
	if (self.target != cu_string_null)
	{
		cu_l = world;
		while (cu_l.style == 0 && cu_l.cu_switchshadstyle == 0)
		{
			cu_l = find(cu_l, targetname, self.target);		
			if (cu_l == world)
			{
				cu_dprint3("target_lightstyle couldn't find target ", self.target, "\n");
				break;
			}
		}
	}
	if (cu_l) cu_lightstyle_switch(cu_l, cu_newstyle);
	
	if (self.cu_target2 != cu_string_null)
	{
		cu_l = world;
		while (cu_l.style == 0 && cu_l.cu_switchshadstyle == 0)
		{
			cu_l = find(cu_l, targetname, self.cu_target2);	
			if (cu_l == world)
			{
				cu_dprint3("target_lightstyle couldn't find target2 ", self.target, "\n");
				break;
			}
		}
	}
	if (cu_l) cu_lightstyle_switch(cu_l, cu_newstyle);

	if (self.cu_target3 != cu_string_null)
	{
		cu_l = world;
		while (cu_l.style == 0 && cu_l.cu_switchshadstyle == 0)
		{
			cu_l = find(cu_l, targetname, self.cu_target3);
			if (cu_l == world)
			{
				cu_dprint3("target_lightstyle couldn't find target3 ", self.target, "\n");
				break;
			}
		}
	}
	if (cu_l) cu_lightstyle_switch(cu_l, cu_newstyle);

	if (self.cu_target4 != cu_string_null)
	{
		cu_l = world;
		while (cu_l.style == 0 && cu_l.cu_switchshadstyle == 0)
		{
			cu_l = find(cu_l, targetname, self.cu_target4);		
			if (cu_l == world)
			{
				cu_dprint3("target_lightstyle couldn't find target4 ", self.target, "\n");
				break;
			}
		}
	}	
	if (cu_l) cu_lightstyle_switch(cu_l, cu_newstyle);
}

void() cu_target_lightstyle_use =
{
	entity cu_tls;
	if (self.delay)
	{
		cu_tls = spawn();
		cu_tls.think = cu_target_lightstyle_go;
		cu_tls.nextthink = time + self.delay;
		cu_SUB_CopyTargets(cu_tls);
		cu_tls.style = self.style;
		cu_tls.owner = self;
	}
	else
	{
		cu_target_lightstyle_go();
	}

	cu_playercount_convert(count);
	if (self.count > 0)
	{
		self.count -= 1;
		if (self.count == 0)
			remove(self);
	}
}

/*cu:QUAKED target_lightstyle (.5 .8 .5) (-8 -8 -8) (8 8 8) START_ON
This entity changes a global lightstyle when triggered. Set "style" to the lightstyle you want to override, and set "message" to the brightness pattern you want to set it to. If style is not set, and this entity targets any triggerable lights, it sets the brightness pattern of those lights when triggered instead. Note that targeting anything at a light makes it a triggerable light with its own style automatically.

Setting style to -1 will override lightstyle 0, which is all static lights in the entire level.

"targetname" if unspecified, will auto-fire itself once at map start
"count" limit number of uses, 0 = infinite
"delay" pause between trigger and activation
"noise/noise1-4" cycle to additional brightness patterns on subsequent activations

START_ON: fire itself once when the map starts regardless of targetname
*/
/*FGD
@PointClass base(Appearflags, Targetname) color(128 210 128) = target_lightstyle : 
"Target : Lightstyle
Changes a global lightstyle when triggered. Will auto-fire at spawn if it has no targetname.

Cycles through 'message' and then all the 'noise' keys if triggered repeatedly."
[
	message(string) : "Brightness pattern"
	noise(string) : "Brightness pattern (2nd)"
	noise1(string) : "Brightness pattern (3rd)"
	noise2(string) : "Brightness pattern (4th)"
	noise3(string) : "Brightness pattern (5th)"
	noise4(string) : "Brightness pattern (6th)"
	style(integer) : "Lightstyle to change (0-63)" : 0
	count(integer) : "Limit uses" : 0
	delay(string) : "Delay before activation" : "0"
	target(target_destination) : "Target: acts on all with matching targetname" 
	target2(target_destination) : "Target 2: acts on all with matching targetname" 
	target3(target_destination) : "Target 3: acts on all with matching targetname" 
	target4(target_destination) : "Target 4: acts on all with matching targetname" 
	spawnflags(flags) = [
		1 : "Go at map start" : 0
	]
]
*/
void() cu_target_lightstyle =
{
	if (!cu_SUB_ShouldSpawn()) 
		return;
		
	if (self.message == cu_string_null)
		self.message = "azam";	// suitably garish accidental default
	self.use = cu_target_lightstyle_use;
	
	if (self.spawnflags & 1 || self.targetname == cu_string_null)
	{
		self.think = cu_target_lightstyle_go;
		self.nextthink = time + 0.1;
	}
}