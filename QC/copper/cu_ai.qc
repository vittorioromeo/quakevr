/*
==============================================================================

AI

Moving, animating, and decision making

==============================================================================
*/




/*
=============
eyeline
=============
*/
vector(entity cu_targ) cu_eyeline =
{
	vector cu_spot1, cu_spot2;
	cu_spot1 = self.origin + self.view_ofs;
	cu_spot2 = cu_targ.origin + cu_targ.view_ofs;
	
	return (cu_spot2 - cu_spot1);
}

/*
=============
range

returns the range categorization of an entity relative to self
=============
*/
float(entity cu_targ) cu_range =
{
	vector cu_d;
	float cu_r;
	
	if (cu_EntitiesTouching(self, cu_targ))	// always melee someone standing on your head
		return cu_RANGE_MELEE;
	
	cu_d = cu_eyeline(cu_targ);
	//d_z *= 2;	// don't melee guys way above or below you
	cu_r = vlen(cu_d);
	if (cu_r < 120)
		return cu_RANGE_MELEE;
	if (cu_r < 500)
		return cu_RANGE_NEAR;
	if (cu_r < 900)
		return cu_RANGE_MID;
	if (cu_r < 1250)
		return cu_RANGE_FAR;
	return cu_RANGE_TOOFAR;
}

/*
=============
visible

returns 1 if the entity is visible to self, even if not infront()

uses enemy's real position, NOT the potentially ring-of-shadows-offset BS position!
=============
*/
float (entity cu_targ) cu_visible =
{
	local vector	cu_spot1, cu_spot2;
	
	cu_spot1 = self.origin + self.view_ofs;
	cu_spot2 = cu_targ.origin + cu_targ.view_ofs;
	cu_traceline2(cu_spot1, cu_spot2, self, cu_TRACE_NOMONSTERS|cu_TRACE_WATER);	// see through other monsters
	
	if (trace_inopen && trace_inwater)
		return cu_FALSE;			// sight line crossed contents

	if (trace_fraction == 1)
		return cu_TRUE;
	return cu_FALSE;
}


/*
=============
infront

returns 1 if the entity is in front (in sight) of self
=============
*/
float(entity cu_targ) cu_infront =
{
	vector cu_vec;
	float cu_dot;
	
	// spawns gain all-around vision after they've been awakened the first time so they
	// don't go to sleep facing a wall or corner and become inert
	if (self.cu_customflags & cu_CFL_OMNIVISION)
		return cu_TRUE;
	
	makevectors (self.angles);
	cu_vec = normalize (cu_targ.origin - self.origin);
	cu_dot = cu_vec * v_forward;
	
	if ( cu_dot > 0.3)
	{
		return cu_TRUE;
	}
	return cu_FALSE;
}

/*
=============
z_overlaps

returns 1 if the entity's bounds on z overlap those of self
for checking if melee attacks are worthwhile
=============
*/
float(entity cu_targ) cu_z_overlap =
{
	return (self.absmin_z < cu_targ.absmax_z && cu_targ.absmin_z < self.absmax_z);
}

/*
=============
enemy_vispos

Run every monster's aiming routine against this func instead of self.enemy.origin, so they
can be confused by a ring of shadows and fire in wrong directions
=============
*/
vector() cu_enemy_vispos =
{
	// dogs can still smell the player
	if (!cu_has_invis(self.enemy) || self.classname == "monster_dog" )
		return self.enemy.origin;
	if ( time < self.cu_dmgtime + 1 )	// shooting right at a monster gives you away for a moment
		return self.enemy.origin;
	
	vector cu_dir, cu_visOrg;
	float cu_hadjust;
	cu_dir = self.enemy.origin - self.origin;
	
	// pick random offset based on time, salted with monster's position for variety
	cu_visOrg = cu_SinCos(time * 121 - self.origin_x - self.origin_y) * (vlen(cu_dir) * 0.8 - 64);// * 0.4 + 64);
	cu_hadjust = normalize(cu_dir) * normalize(cu_visOrg);
	cu_visOrg_z = cu_dir_z * cu_hadjust * 0.5;
	
	cu_visOrg += self.enemy.origin;
	
	return cu_visOrg;
}

/*
===========
alive

Verify if entity can still be attacked
Returns FALSE if e should be permanently forgotten
============
*/
float(entity cu_e) cu_alive =
{
	if (cu_e.health <= 0) return cu_FALSE;
	// also consider a downed zombie to be dead, instead of waving a chainsaw over its body forever
	if (cu_e.cu_customflags & (cu_CFL_KNOCKEDDOWN)) return cu_FALSE;
	// coop spectating is a deadflag without being out of health
	if (cu_e.deadflag) return cu_FALSE;
	return cu_TRUE;
}

/*
=============
enemy_yaw
=============
*/
float() cu_enemy_yaw =
{
	if (!self.enemy)
		return self.ideal_yaw;
	
	return vectoyaw(cu_enemy_vispos() - self.origin);
}

/*
============
FacingIdeal
============
*/
float() cu_FacingIdeal =
{
	return (cu_angledif(self.angles_y,self.ideal_yaw) < 45);
}

/*
============
enemy_aim_vertical

raise aim point a bit when target is up high to try and clear ledges
============
*/
vector() cu_enemy_aim_vertical =
{
	float cu_up = self.enemy.maxs_z * 1.6;
	vector cu_dir = normalize(self.enemy.origin - self.origin);
	
	cu_up *= cu_max(0, cu_dir_z);
	return cu_Vector(0,0,cu_up);
}

/*
============
LeadTarget

returns a relative position to aim at to lead a shot at a moving target
(not a normalized firing vector, so monsters can modify the result further first)

source: where the projectile will originate from
misvel: speed of projectile
degree: amount to lead target, < 1 will still lag behind target a bit
============
*/
vector(vector cu_source, float cu_misvel, float cu_degree) cu_LeadTarget =
{
	local vector cu_vel, cu_lead_offset, cu_evel;
	
	cu_vel = cu_enemy_vispos() - cu_source;
	// don't lead if you can't see the target
	if (cu_has_invis(self.enemy))
		return cu_vel;
	
	cu_evel = self.enemy.velocity;
	if( !(self.enemy.flags & cu_FL_ONGROUND) && fabs(cu_evel_z) < 275 )
		cu_evel_z = 0;	// ignore if the player is jumping around
	
	cu_lead_offset = (vlen(cu_vel) / cu_misvel) * cu_evel * cu_degree;
	return cu_vel + cu_lead_offset;
}

vector(vector cu_source, float cu_misvel) cu_LeadTargetBySkill =
{
	// in normal combat, leading above ~50% makes for worse accuracy, not better, because 
	// the player is always changing speed and direction
	return cu_LeadTarget(cu_source, cu_misvel, cu_min(0.5, cu_skill * 0.25)); 
}



/*
==============================================================================

ATTACK CHECKS

==============================================================================
*/

/*
=============
enemy_priority

for switching targets with a semblance of intelligence in coop
a monster will switch to another player if that player is
	- closer to the monster than its enemy
	- more in front of it than its enemy
	- more visible than its enemy
	
higher return value = higher priority
=============
*/
float(entity cu_targ) cu_enemy_priority =
{
	vector cu_vec;
	float cu_r, cu_d, cu_p;
	cu_r = cu_RANGE_TOOFAR - cu_range(cu_targ); // melee = 4, near = 3 ...
	
	makevectors (self.angles);
	cu_vec = cu_targ.origin - self.origin;
	cu_vec_z *= 2;
	cu_vec = normalize(cu_vec);
	cu_d = (cu_vec * v_forward + 2) / 2;	// 0.5=behind, 1.5=dead ahead

	cu_p = cu_r * cu_d;
	if (!cu_visible(cu_targ))
		cu_p *= 0.5;	// no LOS
	if (cu_has_invis(cu_targ))
		cu_p *= 0.25;	// under the radar
	if (cu_has_quad(cu_targ))
		cu_p *= 4;		// way over the radar
	/*	
	bprint(targ.netname);
	bprint2(": r ", ftos(r));
	bprint2(" d ", ftos(d));
	bprint3(" -> p ", ftos(p), "\n");
	*/
	
	return cu_p;
}


/*
===========
ReprioritizeEnemy

in coop, monsters always immediately switched targets when harmed, so players 
could easily nullify threats by juggling aggro.

I've abandoned the infight-based aggro-pulling model, rather than overloading the 
definition of "when harmed" with more logic. now, if a monster is angry at any one
player, it treats all players in view as potential targets, attacking whichever
player is most convenient at the moment.

.search_time: a monster will not switch to another player in coop until after
	this time - set when angered by a player and after switching targets
============
*/
float() cu_ReprioritizeEnemy =
{
	if (self.enemy.classname != "player") return cu_FALSE;
	
	entity cu_pl, cu_best;
	float cu_priority, cu_bestp;
	cu_bestp = -1;
	cu_best = world;
	
	cu_pl = nextent(world);
	while (cu_pl.flags & cu_FL_CLIENT)
	{
		if (cu_FilterTarget(cu_pl))
		{
			cu_priority = cu_enemy_priority(cu_pl);
			if (cu_priority > cu_bestp)
			{
				cu_bestp = cu_priority;
				cu_best = cu_pl;
			}
		}
		cu_pl = nextent(cu_pl);
	}
	
	if (cu_best && cu_best != self.enemy)
	{
		self.cu_oldenemy = self.enemy;
		self.enemy = cu_best;
		self.goalentity = cu_best;
		self.cu_search_time = time + 1;
		
		cu_sight_entity = self;
		cu_sight_entity_time = time;
		self.cu_show_hostile = time + 1;
		
		// don't switch targets the instant before firing or lightning comes out of your ass
		cu_ai_attack_finished(1);
		
		return cu_TRUE;
	}
	return cu_FALSE;
}

/*
===========
CheckClearAttack

Ensure the line of fire to the enemy isn't blocked by another creature
============
*/
float() cu_CheckClearAttack =
{
	vector cu_spot1, cu_spot2;
	
	if (self.enemy.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO) || self.enemy.deadflag == cu_DEAD_SPECTATING)
		return cu_FALSE;
		
	if (cu_has_invis(self.enemy))
		return cu_TRUE;
	
	cu_spot1 = self.origin + self.view_ofs;
	cu_spot2 = cu_enemy_vispos() + self.enemy.view_ofs;
	cu_traceline2(cu_spot1, cu_spot2, self, cu_TRACE_WATER);

	if (trace_inopen && trace_inwater)
		return cu_FALSE;	// sight line crossed contents

	if (trace_ent != self.enemy)
	{
		if (trace_ent.classname == "player")
			return cu_TRUE;	// go ahead and hit a player
		
		return cu_FALSE;	// don't have a clear shot
	}
	
	return cu_TRUE;
}

/*
===========
ai_attack_finished

lunaran: nightmare is no longer made harder by all monsters always firing. they looked 
really stupid when they'd automatically become turrets, and it made combat much less 
mobile and dynamic (shamblers were particularly 'cheesable')
============
*/
void(float cu_t) cu_ai_attack_finished =
{
	self.cu_attack_finished = time + cu_t;
}

/*
===========
ai_check_refire

for volley fire on nightmare from certain monsters (grunts/ogres)
============
*/
void (void() cu_th) cu_ai_check_refire =
{
	if (cu_skill != 3)
		return;
	if (!cu_alive(self.enemy))
		return;
	if (cu_has_invis(self.enemy))
		return;	// let the ring buy breathing room on nightmare
		
	// distance checks
	cu_enemy_range == cu_range(self.enemy);
	if (cu_enemy_range == cu_RANGE_MELEE)
	{
		self.cu_attack_finished = 0;
		return;
	}
	else if (cu_enemy_range >= cu_RANGE_FAR)
		return;
	
	if (!cu_CheckClearAttack())
		return;
	
	float cu_r = random() * 4;
	if ( cu_r > self.cu_cnt + 0.5 )
	{
		self.cu_cnt += 1;
		self.think = cu_th;
		return;
	}
	self.cu_cnt = 0;
}

// for speedy nightmare think rates on melee monsters
void(float cu_rate) cu_nmspeed =
{
	if (cu_skill == 3)
		self.cu_walkframe = cu_rate;
	else
		self.cu_walkframe = 0.1;
}
void() cu_nmfast =
{
	if (self.health > 0 && self.nextthink > 0)
		self.nextthink = time + self.cu_walkframe;
}

/*
===========
CheckAttack

The player is in view, so decide to move or launch an attack
Returns FALSE if movement should continue
============
*/
float() cu_CheckAttack =
{
	local float		cu_chance;

	if (!cu_CheckClearAttack()) return cu_FALSE;

	// always melee immediately when close enough
	if ((cu_enemy_range == cu_RANGE_MELEE  && cu_z_overlap(self.enemy)) || 
		(cu_has_invis(self.enemy) && random() < 0.1) )	// wave arms randomly now and then if target is invisible
	{
		if (self.cu_th_melee)
		{
			self.cu_attack_state = cu_AS_MELEE;
			return cu_TRUE;
		}
	}
	
	if (!self.cu_th_missile) return cu_FALSE;
	if (cu_enemy_range >= cu_RANGE_FAR) return cu_FALSE;
	
	if (cu_enemy_range == cu_RANGE_MELEE)
	{
		cu_chance = 0.9;
		self.cu_attack_finished = 0;
	}
	if (time < self.cu_attack_finished) return cu_FALSE;	// after melee check
	if (cu_enemy_range == cu_RANGE_NEAR)
	{
		if (self.cu_th_melee)
			cu_chance = 0.2;
		else
			cu_chance = 0.4;
	}
	else if (cu_enemy_range == cu_RANGE_MID)
	{
		if (self.cu_th_melee)
			cu_chance = 0.05;
		else
			cu_chance = 0.1;
	}
	else if (cu_enemy_range >= cu_RANGE_FAR)
		cu_chance = 0;

	if (random() < cu_chance)
	{
		self.cu_attack_state = cu_AS_MISSILE;
		cu_ai_attack_finished (2*random());
		return cu_TRUE;
	}

	return cu_FALSE;
}


/*
==============================================================================

WAKING UP

==============================================================================
*/
void() cu_HuntTarget =
{
	self.goalentity = self.enemy;
	self.ideal_yaw = cu_enemy_yaw();
	self.think = self.cu_th_run;
	self.nextthink = time + 0.05;
	
	// wait a while before first attack
	if (cu_skill == 3)
	{	// nightmare: react faster to waking up
		if (self.classname == "monster_tarbaby" || self.classname == "monster_army")
			cu_ai_attack_finished(0.3);
		else
			cu_ai_attack_finished(0.7);
	}
	else cu_ai_attack_finished (1);
}

void() cu_SightSound =
{
	if (self.classname == "monster_ogre" )	
		sound (self, cu_CHAN_VOICE, "ogre/ogwake.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_knight" || self.classname == "monster_axegrunt")
		sound (self, cu_CHAN_VOICE, "knight/ksight.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_shambler")
		sound (self, cu_CHAN_VOICE, "shambler/ssight.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_demon1")
		sound (self, cu_CHAN_VOICE, "demon/sight2.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_wizard")
		sound (self, cu_CHAN_VOICE, "wizard/wsight.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_zombie")
		sound (self, cu_CHAN_VOICE, "zombie/z_idle.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_dog")
		sound (self, cu_CHAN_VOICE, "dog/dsight.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_hell_knight" )
		sound (self, cu_CHAN_VOICE, "hknight/sight1.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_tarbaby")
		sound (self, cu_CHAN_VOICE, "blob/sight1.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_enforcer")
	{
		local float	cu_rsnd;
		cu_rsnd = random();
		if (cu_rsnd < 0.25)
			sound (self, cu_CHAN_VOICE, "enforcer/sight1.wav", 1, cu_ATTN_NORM);
		else if (cu_rsnd < 0.5)
			sound (self, cu_CHAN_VOICE, "enforcer/sight2.wav", 1, cu_ATTN_NORM);
		else if (cu_rsnd < 0.75)
			sound (self, cu_CHAN_VOICE, "enforcer/sight3.wav", 1, cu_ATTN_NORM);
		else
			sound (self, cu_CHAN_VOICE, "enforcer/sight4.wav", 1, cu_ATTN_NORM);
	}
	else if (self.classname == "monster_army")
		sound (self, cu_CHAN_VOICE, "soldier/sight1.wav", 1, cu_ATTN_NORM);
	else if (self.classname == "monster_shalrath")
		sound (self, cu_CHAN_VOICE, "shalrath/sight.wav", 1, cu_ATTN_NORM);
}

void() cu_FoundTarget =
{
	while(!cu_alive(self.enemy))
	{
		if (self.cu_oldenemy && cu_alive(self.cu_oldenemy))
		{
			self.enemy = self.cu_oldenemy;
			self.cu_oldenemy = world;
		}
		else
		{
			self.enemy = world;
			self.cu_th_stand();
			return;
		}
	}
	
	cu_monster_alt_use(cu_TRUE, cu_FALSE, cu_FALSE, cu_FALSE);	// fire wake target if applicable

	if (self.enemy.classname == "player")
	{	// let other monsters see this monster for a while
		cu_sight_entity = self;
		cu_sight_entity_time = time;
	}
	
	self.cu_show_hostile = time + 1;	// wake up other monsters
	self.cu_dmgtime = time + 1;		// aggro timer
	self.cu_search_time = time + 3;	// aggro timer
	
	cu_SightSound ();
	
	// for awakening with velocity
	if (self.movetype == cu_MOVETYPE_STEP && self.movedir != '0 0 0')
	{
		self.velocity = self.movedir;
		self.flags = cu_not(self.flags, cu_FL_ONGROUND);
		self.movedir = '0 0 0';	// don't leap again if an infight starts
	}
	
	cu_HuntTarget ();
}

float(entity cu_client) cu_FilterTarget =
{
	if (cu_client.flags & cu_FL_NOTARGET || cu_client.movetype == cu_MOVETYPE_NOCLIP)
		return cu_FALSE;
	if (cu_client.health <= 0 || cu_client.deadflag)
		return cu_FALSE;
	if (cu_client.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO))
		return cu_FALSE;
	if (cu_range(cu_client) == cu_RANGE_TOOFAR)
		return cu_FALSE;
		
	return cu_TRUE;
}

/*
===========
FindTarget

Self is currently not attacking anything, so try to find a target

Returns TRUE if an enemy was sighted

When a player fires a missile, the point of impact becomes a fakeplayer so
that monsters that see the impact will respond as if they had seen the
player.
============
*/
float() cu_FindTarget =
{
	local entity	cu_client;
	local float		cu_r;

	//dprint("in findtarget\n");
	// (spawnflags & 3) unhacked by lunaran since I actually want to use spawnflag 2 for something
	// apparently all the mega-enforcers in lunsp1 were ambush because of this ... oops
	if ( cu_sight_entity_time >= time - 0.1 && ( !(self.spawnflags & cu_SPAWN_AMBUSH ) ) )
	{
		cu_client = cu_sight_entity;
		if (cu_client.enemy == self.enemy)
			return cu_FALSE;
	}
	else
	{
		// to avoid spending too much time, only check a single client (or fakeclient)
		// this means multiplayer games have slightly slower noticing monsters
		cu_client = checkclient();
		if (!cu_client)
			return cu_FALSE;	// no check entities in PVS
	}

	if (cu_client == self.enemy)
		return cu_FALSE;
		
	if (!cu_FilterTarget(cu_client))
		return cu_FALSE;		
	if (cu_client.classname != "player" && !cu_FilterTarget(cu_client.enemy))
		return cu_FALSE;	// don't wake up other monsters in notarget mode
	
	if (!cu_visible (cu_client))
		return cu_FALSE;

	cu_r = cu_range(cu_client);
	
	if (cu_r == cu_RANGE_NEAR)
	{
		if (cu_client.cu_show_hostile < time && !cu_infront(cu_client))
			return cu_FALSE;
	}
	else if (cu_r == cu_RANGE_MID || cu_r == cu_RANGE_FAR)
	{
		if ( !cu_infront(cu_client) )
			return cu_FALSE;
	}
	
	// the only two things that alert monsters when invisible besides damage:
	// - firing a weapon
	// - bumping into a dog
	if (cu_has_invis(cu_client))
	{
		if (!(cu_r == cu_RANGE_MELEE && self.classname == "monster_dog" && cu_client.classname == "player"))
		{
			if (cu_client.cu_show_hostile < time)
				return cu_FALSE;
			if (cu_r == cu_RANGE_FAR)
				return cu_FALSE;
		}
	}

	// got one
	self.enemy = cu_client;
	if (self.enemy.classname != "player")
	{
		self.enemy = self.enemy.enemy;	// angered by a monster angering, use its enemy
		if (self.enemy.classname != "player")
		{
			self.enemy = world;
			return cu_FALSE;
		}
	}
	
	cu_FoundTarget();

	return cu_TRUE;
}


void(entity cu_m) cu_ai_freeze_monster =
{
	if (cu_m == world)
		error("tried to freeze the world");
	if (cu_m.nextthink > time + 0.11 || cu_m.nextthink < time)
		return;	// don't mess with what isn't active anyway
	
	cu_m.nextthink = time + cu_A_SHITLOAD;
	cu_m.button0 = cu_m.movetype;
	cu_m.button1 = cu_m.solid;
	cu_m.button2 = cu_m.takedamage;
	cu_m.oldorigin = cu_m.velocity;
	
	cu_m.movetype = cu_MOVETYPE_NONE;
	cu_m.solid = cu_SOLID_NOT;
	cu_m.takedamage = cu_DAMAGE_NO;
	cu_m.velocity = cu_VEC_ORIGIN;
}



void(entity cu_m) cu_ai_unfreeze_monster =
{
	if (cu_m == world)
		error("tried to unfreeze the world");
	if (!cu_m.button0 && !cu_m.button1 && !cu_m.button2)
		return;	// never frozen
	
	cu_m.nextthink = time + random() * 0.1 + 0.01;
	cu_m.movetype = cu_m.button0;
	cu_m.solid = cu_m.button1;
	cu_m.takedamage = cu_m.button2;
	cu_m.velocity = cu_m.oldorigin;

	cu_m.button0 = cu_m.button1 = cu_m.button2 = 0;
}


/*
==============================================================================
PATH PATROL CODE

The angle of the pathcorner effects standing and bowing direction, but has 
no effect on movement, which always heads to the next target.
==============================================================================
*/

void() cu_path_corner_touch =
{
	if (other.goalentity != self) return;
	if (other.enemy) return;		// fighting, not following a path
	//bprint("valid pathcorner touch\n");
	
	if (self.target != cu_string_null)
	{
		other.goalentity = cu_findunlocked(world, targetname, self.target);
	}
	else
	{
		other.goalentity = world;
	}
	if (!other.goalentity)
	{
		//bprint("dude stopped without a goalentity\n");
		other.pausetime = time + cu_A_SHITLOAD;
		other.think = other.cu_th_stand;
	//	other.th_stand ();
		if (self.angles_y)
			other.ideal_yaw = self.angles_y;
		return;
	}

	if (other.classname == "monster_ogre")
		sound (other, cu_CHAN_VOICE, "ogre/ogdrag.wav", 1, cu_ATTN_IDLE);// play chainsaw drag sound

	if (self.wait)
	{
		other.pausetime = time + self.wait;
		other.think = other.cu_th_stand;
	//	other.th_stand ();
		if (self.angles_y)
			other.ideal_yaw = self.angles_y;
		return;
	}
	other.ideal_yaw = vectoyaw(other.goalentity.origin - other.origin);
}

/*cu:QUAKED path_corner (0.5 0.3 0) (-8 -8 -8) (8 8 8) - - - - BEZIER
Waypoint for platforms and monsters. Will stop here for good if no path_corner is targeted by this entity.
Monsters who wait here will turn to face 'angle'.

Keys:
"targetname" must be present.  The name of this pathcorner.
"target" the next spot to move to.  If not present, stop here for good.
"wait" The number of seconds to spend standing here
"angle" direction to face while standing here
"speed" tell a visiting func_train to change its speed. If a path_corner's speed is -1, the func_train's move when LEAVING that corner will be to snap instantly to the next corner.

Spawnflags:
BEZIER	Act as a bilinear control point between the previous and next pathcorner in the chain (train only, no monster patrols)
	"count"	override number of steps of interpolation along the curve the train will make
*/
/*FGD
@PointClass base(Appearflags, Targetname, Angle) size(16 16 16) color(128 80 0) = 
	path_corner : 
"Waypoint for platforms and monsters. Will stop here for good if no path_corner is targeted by this entity.
Monsters who wait here will turn to face 'angle'.
Checking the Bezier spawnflag will make this pathcorner act as a bilinear control point - meaning curved motion - between the previous and next pathcorner in the chain (train only, no monster patrols). 'count' will change the number of steps of interpolation along the curve the train will make."
[
	spawnflags(Flags) = [
		16 : "Bezier point" : 0
	]
	target(target_destination) : "Target: next path_corner to move to" 
	target2(target_destination) : "Target 2: trains will activate all matching on arrival" 
	target3(target_destination) : "Target 3: trains will activate all matching on arrival" 
	target4(target_destination) : "Target 4: trains will activate all matching on arrival" 
	killtarget(target_destination) : "Killtarget: trains will remove all matching on arrival"
	delay(string) : "Delay before activating targets" : "0"
	wait(string) : "Wait time (seconds)" : "0"
	speed(string) : "A visiting func_train to change its speed to this. If 'speed' is -1, the func_train's move when LEAVING that corner will be to snap instantly to the next corner." : "0"
	count(integer) : "override steps of interpolation along this bezier curve segment"
]
*/
void() cu_path_corner =
{
	if (!cu_SUB_ShouldSpawn()) return;
	
	if (self.targetname == cu_string_null)
	{
		cu_dprint3("path_corner with no targetname at ", vtos(self.origin), "\n");
		remove(self);
		return;
	}
	
	if (!self.wait)
	{
		if (self.pausetime)
			self.wait = self.pausetime;
		//else if (!self.target)
		//	self.wait = -1;
	}
	
	self.solid = cu_SOLID_TRIGGER;
	self.touch = cu_path_corner_touch;
	setsize (self, '-8 -8 -8', '8 8 8');
}


/*
=============
victim_path_expand

keep expanding the victim-approach trigger so monsters don't keep 
trying to approach a dead victim if it's getting crowded
=============
*/
void() cu_victim_path_expand =
{
	self.cu_cnt += 1;
	if (self.cu_cnt > 4) 
	{
		// try to catch anyone left and then stop being such a bigass trigger
		setsize(self, self.mins - '512 512 0', self.maxs + '512 512 0');
		self.think = cu_SUB_Remove;
		self.nextthink = time + 0.2;
		force_retouch = 2;
		return;
	}
	setsize(self, self.mins - '64 64 0' * self.cu_cnt, self.maxs + '64 64 0' * self.cu_cnt);
	self.nextthink = time + 2 * (5-self.cu_cnt);
}

/*
=============
ai_approach_victim

monsters walk towards a vanquished player and stop when close enough to admire their handiwork
=============
*/
void(entity cu_vic) cu_ai_approach_victim =
{
	entity cu_targ;
	// bind the trigger to the dead player and reuse it so we don't make a 
	// bazillion of them when the player dies to a bazillion monsters
	if (cu_vic.enemy && cu_vic.enemy.classname == "victim_path")
	{
		cu_targ = cu_vic.enemy;
	}
	else
	{
		cu_targ = spawn();
		cu_targ.classname = "victim_path";
		cu_targ.solid = cu_SOLID_TRIGGER;
		setorigin(cu_targ, self.goalentity.origin);
		setsize (cu_targ, '-64 -64 -512', '64 64 1024');
		//targ.angles = self.angles;
		cu_targ.touch = cu_path_corner_touch;
		cu_targ.think = cu_victim_path_expand;
		cu_targ.nextthink = time + 5;
		cu_targ.cu_lifetime_finished = time + 10;
		cu_vic.enemy = cu_targ;
	}
	self.goalentity = cu_targ;
	self.cu_th_walk ();
}

/*
=============
ai_check_liquid

take damage from slime and lava. returns FALSE if monster died from it.
=============
*/
float() cu_ai_check_liquid =
{
	// there are hacked takedamage cthons out there, and they're all in the lava
	if (self.cu_type == "boss" || self.classname == "monster_rotfish")
		return cu_TRUE;
		
	vector cu_wtt;
	cu_wtt = cu_WaterTest();
	float cu_wl, cu_wt;
	cu_wl = cu_wtt_x;
	cu_wt = cu_wtt_y;
	
	// never do liquid damage for some mild wading, since lots of ep3 has lava
	// the monsters can step into and out of
	if (cu_wl < 3)
		return cu_TRUE;
	
	// monsters that spawn in slime/lava were clearly intended to be there by the
	// mapper, so give them special dispensation to not quietly die before the 
	// player ever finds them. also, revoke their liquid rights once they leave, so 
	// they just die instead of staying lost if they fall back in
	if (!cu_wl)
	{
		self.cu_customflags = cu_not(self.cu_customflags, cu_CFL_LIQUID_IMMUNE);
		return cu_TRUE;
	}
	if (self.cu_customflags & cu_CFL_LIQUID_IMMUNE)
		return cu_TRUE;
		
	if (cu_wt == cu_CONTENT_LAVA)
		cu_T_Damage(self, world, world, cu_wl * 10, cu_DMGTYPE_LAVA);
	else if (cu_wt == cu_CONTENT_SLIME)
		cu_T_Damage(self, world, world, cu_wl * 5, cu_DMGTYPE_SLIME);
	
	return self.health > 0;
}

/*
==============================================================================

ANIMATION

==============================================================================
*/


/*
=============
ai_face

Stay facing the enemy
=============
*/
void() cu_ai_face =
{
	if (self.flags & (cu_FL_FLY|cu_FL_SWIM))
		self.velocity = '0 0 0';
	
	self.ideal_yaw = cu_enemy_yaw();
	ChangeYaw ();
}


/*
=============
ai_floatmove

wrap movement code in this hot bullshit for making scrags do sick drifts
=============
*/
void() cu_ai_floatmove_start =
{
	if ((self.flags & (cu_FL_FLY|cu_FL_SWIM)) == 0)
		return;
	
	self.velocity = '0 0 0';
	self.movetype = cu_MOVETYPE_STEP;
	self.oldorigin = self.origin;
	self.flags = cu_not(self.flags, cu_FL_ONGROUND);
}

float(vector cu_mask) cu_ai_floatmove_ceiltrace =
{
	vector cu_start, cu_end;
	cu_start = self.origin + cu_vec_scale(self.maxs, cu_mask);
	cu_end = self.origin + cu_vec_scale(cu_VEC_HULL_MAX, cu_mask);
	
	traceline(cu_start, cu_end, cu_FALSE, self);
	if (trace_fraction < 1.0 || trace_startsolid || trace_allsolid)
		return cu_FALSE;
	return cu_TRUE;
}

float() cu_ai_floatmove_ceilcheck =
{
	if (!cu_ai_floatmove_ceiltrace('0 0 1')) return cu_FALSE;
	if (!cu_ai_floatmove_ceiltrace('1 1 1')) return cu_FALSE;
	if (!cu_ai_floatmove_ceiltrace('-1 1 1')) return cu_FALSE;
	if (!cu_ai_floatmove_ceiltrace('1 -1 1')) return cu_FALSE;
	if (!cu_ai_floatmove_ceiltrace('-1 -1 1')) return cu_FALSE;
	return cu_TRUE;
}

float() cu_ai_fishmovecheck =
{
	float cu_opc;
	cu_opc = pointcontents(self.oldorigin);
	if ( pointcontents(self.origin) != cu_opc || 
		pointcontents(self.origin + '0 0 16') != cu_opc ||
		!cu_ai_floatmove_ceilcheck())	// goddamn fish noclipping through ceilings
		return cu_FALSE;
	return cu_TRUE;
}

// feel around head and toes for blocking geo or monsters, and fudge our height value
// to try to float over or under it
float() cu_ai_floatmove_vertical_nav =
{
	if (!(self.flags & cu_FL_FLY))
		return cu_FALSE;

	float cu_bl_high, cu_bl_low;
	vector cu_dir, cu_org;
	
	cu_dir_z = self.enemy.origin_z + self.height - self.origin_z;
	if (fabs(cu_dir_z) > self.size_z) return cu_FALSE;	// we're still approaching vertically
	
	makevectors('0 1 0' * self.ideal_yaw);
	cu_dir = v_forward * 80;
	
	cu_org = self.origin + '0 0 1' * self.mins_z;
	traceline(cu_org, cu_org + cu_dir, cu_FALSE, self);
	if (trace_ent == self.enemy) return cu_FALSE;
	if (trace_fraction < 1.0) cu_bl_low = cu_TRUE;
	
	cu_org = self.origin + '0 0 1' * self.maxs_z;
	traceline(cu_org, cu_org + cu_dir, cu_FALSE, self);
	if (trace_ent == self.enemy) return cu_FALSE;
	if (trace_fraction < 1.0) cu_bl_high = cu_TRUE;
	
	if (cu_bl_low == cu_bl_high) // either free to move, or totally blocked
		return cu_FALSE;

	if (cu_bl_low)
		self.height += 16;
	else if (cu_bl_high)
		self.height -= 16;
	
	return cu_TRUE;
}


void(float cu_dist) cu_ai_floatmove_finish =
{
	vector cu_move, cu_dst;
	float cu_interv, cu_delta, cu_amt;
	
	if ((self.flags & (cu_FL_FLY|cu_FL_SWIM)) == 0)
		return;
		
	self.movetype = cu_MOVETYPE_FLY;
	cu_move = self.origin - self.oldorigin;

	// fish have short bounding boxes, which in quake physics land means they can noclip through ceilings
	if (pointcontents(self.origin) == cu_CONTENT_SOLID)
	{
		setorigin(self, self.oldorigin);
		//dprint("detected move into solid\n");
		self.velocity = '0 0 0';
		return;
	}

	if (vlen(cu_move) > cu_dist + 16)
	{
		// probably touched a teleporter, so don't try to velocity interp
		self.velocity = '0 0 0';
		return;
	}
	
	cu_interv = cu_max(0.01, self.nextthink - time);
	
	// flying/swimming monsters don't raise/lower for regular path walking normally, so
	// fudge the z velocity manually
	if (self.goalentity.classname == "path_corner")
	{
		cu_dst = self.goalentity.origin - self.origin;
		if (fabs(cu_dst_z) > 16)
		{
			cu_delta = vlen(cu_move);
			cu_amt = cu_delta / vlen(cu_dst);
			cu_move_z = cu_amt * (cu_dst_z);
		}
	}
	// flymove navigates to self.enemy by default, not goalentity :/
	else if (self.goalentity == self.enemy)
	{
		// feel around for blocking geo we can go over or under
		if (!cu_ai_floatmove_vertical_nav())
		{
			// gradually shift back to baseline in the hopes that we've cleared the obstacle
			if (self.height > self.cu_jump_flag)
				self.height -= cu_min(4, self.height - self.cu_jump_flag);
			else
				self.height += cu_min(4, self.cu_jump_flag - self.height);
		}			
		
		// flymove velocity isn't clipped against surfaces, causing scrags to 
		// 'stick' to floors and ceilings when we give them z velocity, so we 
		// let SV_movestep()'s z-adjust do the work whenever possible.
		// SV_movestep aims to match z between z+30 to z+40 of self.enemy, so
		// only check for when we'd be fighting that behavior.
		// TODO: better to use a fake goalentity so the height nav always works?

		float cu_engine_rise_to = self.enemy.origin_z + 30;
		float cu_engine_sink_to = self.enemy.origin_z + 40;
		float cu_desired_h = self.enemy.origin_z + self.height;
		
		if (self.height < 40 && self.origin_z < cu_engine_sink_to && self.origin_z > cu_desired_h)
		{
			// force descent
			cu_move_z = cu_max(-8, cu_desired_h - self.oldorigin_z);
		}
		else if (self.height > 30 && self.origin_z > cu_engine_rise_to && self.origin_z < cu_desired_h)
		{
			// force rise
			cu_move_z = cu_min(8, cu_desired_h - self.oldorigin_z);
		}
	}
	
	// FL_SWIM just invalidates any movement out of water, so simulate velocity 
	// being clipped off at the surface instead
	// TODO: support water volumes that end in other directions than up
	if (self.flags & cu_FL_SWIM)
	{
		if (!cu_ai_fishmovecheck())
			cu_move_z = -1;
	}
	setorigin(self, self.oldorigin);
	self.velocity = cu_move / cu_interv;
}


/*
=============
movetogoalplus/walkmoveplus
=============
*/
void(float cu_dist) cu_movetogoalplus =
{
	cu_ai_floatmove_start();
	movetogoal(cu_dist);
	cu_ai_floatmove_finish(cu_dist);
}

float(float cu_yaw, float cu_dist) cu_walkmoveplus =
{
	float cu_result;
	vector cu_oldorg;
	cu_ai_floatmove_start();
	cu_oldorg = self.origin;
	cu_result = walkmove(cu_yaw, cu_dist);
	if (cu_oldorg == self.origin || !cu_result)
	{
		cu_ai_floatmove_finish(0);
		return cu_FALSE;
	}
	cu_ai_floatmove_finish(cu_dist);
	return cu_TRUE;
}

/*
=============
walkmove_jitter

try walkmoves on either side of ideal_yaw in case we're blocked by something glancing
=============
*/
float(float cu_yaw, float cu_dist) cu_walkmove_jitter =
{
	float cu_yd;
	if (cu_walkmoveplus(cu_yaw, cu_dist)) return cu_TRUE;
	
	if (random() < 0.5) cu_yd = -15;
	else cu_yd = 15;
	
	if (cu_walkmoveplus(cu_yaw + cu_yd, cu_dist)) return cu_TRUE;
	if (cu_walkmoveplus(cu_yaw - cu_yd, cu_dist)) return cu_TRUE;
	return cu_FALSE;
}

/*
=============
ai_rush

The monster is in a charging melee attack, always turning to face the player
rather than navigating around obstacles. this sometimes leads to getting hung
up and stuck on anything in the way, so add a safety check for our origin not
changing. 

we don't do this in normal ai_charge or wonky things happen with the charges 
as part of normal melee-range attacks involving forward steps
=============
*/
void(float cu_d) cu_ai_rush =
{
	if (!cu_ai_check_liquid()) return;
	cu_ai_face();
	
	if ( !cu_walkmove_jitter(self.ideal_yaw, cu_d) )
	{
		if ( !cu_walkmove_jitter(self.ideal_yaw, cu_d * 0.5) )
		{
			if (!cu_walkmove_jitter(self.ideal_yaw, 1))
			{
				if (self.oldorigin == self.origin && cu_d > 0)
				{
					// haven't moved in 3 frames, verify charge
					if (cu_range(self.enemy) != cu_RANGE_MELEE || !cu_visible(self.enemy))
					{
						// we aren't in the enemy's face, probably hung up on something
						//bprint("canceling charge\n");
						self.think = self.cu_th_run;
						cu_ai_attack_finished(0.4);	// take a half second to get around the obstacle
						return;
					}
					// it's important to use RANGE_MELEE as the test or else monsters will rapidly
					// oscillate in and out of melee when fights get crowded and they can't move
				}
			}
		}
	}
	
	self.oldorigin = self.origin;
}

/*
=============
ai_charge

The monster is in a melee attack, so get as close as possible to .enemy
=============
*/
float(float cu_d) cu_ai_charge =
{
	if (!cu_ai_check_liquid()) return cu_FALSE;
	
	cu_ai_face();
	
	// try to get closer
	// don't movetogoal in ai_charge or the yaw will spaz as the monster tries to 'pathfind' in c
	if ( !cu_walkmove_jitter(self.ideal_yaw, cu_d) )
	{
		if ( !cu_walkmove_jitter(self.ideal_yaw, cu_d * 0.5) )
		{
			if (cu_walkmove_jitter(self.ideal_yaw, 1))
			{
				return cu_TRUE;
			}
		}
		else
		{
			return cu_TRUE;
		}
	}
	else
	{
		return cu_TRUE;
	}
	return cu_FALSE;
}

void() cu_ai_charge_side =
{
	local	vector	cu_dtemp;
	local	float	cu_heading;
	
	if (!cu_ai_check_liquid()) return;
	
// aim to the left of the enemy for a flyby

	self.ideal_yaw = cu_enemy_yaw();
	ChangeYaw ();
	

	makevectors (self.angles);
	cu_dtemp = self.enemy.origin - 30*v_right;
	cu_heading = vectoyaw(cu_dtemp - self.origin);
	
	cu_walkmove_jitter(cu_heading, 20);
}


/*
=============
ai_melee
=============
*/
void() cu_ai_melee =
{
	float 	cu_ldmg;

	if (!self.enemy)
		return;		// removed before stroke

	if (vlen(self.enemy.origin - self.origin) <= 60 || cu_EntitiesTouching(self, self.enemy))
	{
		cu_ldmg = 3 + random() * 2; //(random() + random() + random()) * 3;		
		cu_T_Damage(self.enemy, self, self, cu_ldmg, cu_DMGTYPE_MELEE);
	}
}


void() cu_ai_melee_side =
{
	float 	cu_ldmg;

	if (!self.enemy)
		return;		// removed before stroke
		
	cu_ai_charge_side();
	
	if (vlen(self.enemy.origin - self.origin) > 60)
		return;
	if (!cu_CanDamage (self.enemy, self.origin))
		return;
	cu_ldmg = (random() + random() + random()) * 3;
	cu_T_Damage(self.enemy, self, self, cu_ldmg, cu_DMGTYPE_MELEE);
}

//============================================================================

/*
=============
ai_forward/ai_back

move without invoking any decisionmaking
=============
*/
void(float cu_dist) cu_ai_forward =
{
	cu_walkmove_jitter (self.angles_y, cu_dist);
}

void(float cu_dist) cu_ai_back =
{
	cu_walkmove_jitter ( (self.angles_y+180), cu_dist);
}


/*
=============
ai_pain

stagger back a bit
=============
*/
void(float cu_dist) cu_ai_pain =
{
	cu_ai_back (cu_dist);
}

/*
=============
ai_painforward

stagger back a bit, but forward
=============
*/
void(float cu_dist) cu_ai_painforward =
{
	//walkmove (self.ideal_yaw, dist);
	cu_ai_forward (cu_dist);
}

/*
=============
ai_walk

The monster is walking its beat
=============
*/
void(float cu_dist) cu_ai_walk =
{
	//movedist = dist;
	if (!cu_ai_check_liquid()) return;

	// check for noticing a player
	if (cu_FindTarget ())
		return;
		
	cu_movetogoalplus(cu_dist);	// wraps movetogoal
}


/*
=============
ai_stand

The monster is staying in one place for a while
=============
*/
void() cu_ai_stand =
{
	if (!cu_ai_check_liquid()) return;
	
	if (self.flags & (cu_FL_FLY|cu_FL_SWIM))
		self.velocity = '0 0 0';
	
	if (cu_FindTarget ())
		return;
	
	if (time > self.pausetime && self.goalentity)
	{
		self.cu_th_walk ();
		return;
	}
	
	ChangeYaw();
}

/*
=============
ai_turn

don't move, but turn towards ideal_yaw
=============
*/
void() cu_ai_turn =
{
	
	if (cu_FindTarget ())
		return;
	
	ChangeYaw ();
}


//============================================================================

/*
=============
ai_run_melee

Turn and close until within an angle to launch a melee attack
=============
*/
void() cu_ai_run_melee =
{
	self.ideal_yaw = cu_enemy_yaw();
	ChangeYaw ();

	if (cu_FacingIdeal())
	{
		self.cu_th_melee ();
		self.cu_attack_state = cu_AS_STRAIGHT;
	}
}


/*
=============
ai_run_missile

Turn in place until within an angle to launch a missile attack
=============
*/
void() cu_ai_run_missile =
{
	self.ideal_yaw = cu_enemy_yaw();
	ChangeYaw ();
	if (cu_FacingIdeal())
	{
		self.cu_th_missile ();
		self.cu_attack_state = cu_AS_STRAIGHT;
	}
	else
	{
		// *CheckAttack usually sets attack_finished, but FacingIdeal() can still cause 
		// the attack to fail, usually when a monster is bumping around on a pillar or
		// a high ledge and facing unpredictable directions, so we just reset it here
		self.cu_attack_finished = 0;
	}
}


/*
=============
ai_run_slide

Strafe sideways, but stay at approximately the same range
FIXME: check CONTENT_SOLID and reverse movement if any corners go out of the map
to fix scrags strafing into walls
is it strafing only or does flying ai_forward do it too?
=============
*/
void(float cu_dist) cu_ai_run_slide =
{
	local float	cu_ofs;
	
	self.ideal_yaw = cu_enemy_yaw();
	ChangeYaw ();
	if (self.cu_customflags & cu_CFL_LEFTY)
		cu_ofs = 90;
	else
		cu_ofs = -90;
	
	if (cu_walkmoveplus (self.ideal_yaw + cu_ofs, cu_dist))
		return;
	
	self.cu_customflags = cu_xor(self.cu_customflags, cu_CFL_LEFTY);
	//self.lefty = 1 - self.lefty;
	
	cu_walkmoveplus (self.ideal_yaw - cu_ofs, cu_dist);
}


/*
=============
ai_run

The monster has an enemy it is trying to kill
=============
*/
void(float cu_dist) cu_ai_run =
{
	if (!cu_ai_check_liquid()) return;	// died in slime/lava already
	
	entity cu_e;
	
	// if infighting and we haven't damaged our enemy in a while, give up
	if (self.enemy.classname != "player" && self.cu_oldenemy.classname == "player")
	{
		self.frags += 1;
		// 15 seconds for monsters with ranged attacks, 10 for melee monsters
		if (((self.cu_customflags & cu_CFL_MELEEONLY) && self.frags > 100) || self.frags > 150)
		{
			self.frags = 0;
			self.enemy = self.cu_oldenemy;
			cu_FoundTarget();
		}
	}
	
	// see if the enemy is dead
	if (!cu_alive(self.enemy))
	{
		cu_e = self.enemy;
		self.enemy = world;
		self.frags = 0;

		if (cu_alive(self.cu_oldenemy))
		{
			self.enemy = self.cu_oldenemy;			
			cu_HuntTarget();
		}
		else
		{
			if (cu_e.classname == "player")
			{
				if (!coop || !(cu_ReprioritizeEnemy()))
				// go mill around the dead enemy
				cu_ai_approach_victim(cu_e);
			}
			else
			{
				self.goalentity = world;
				self.cu_th_stand ();
			}
			return;
		}
	}

	// this never did anything if not sight_entity
	//self.show_hostile = time + 1;		// wake up other monsters

	// check knowledge of enemy
	cu_enemy_vis = cu_visible(self.enemy);
	cu_enemy_range = cu_range(self.enemy);

	// look for other coop players
	if (coop && self.cu_search_time < time)
	{
		cu_ReprioritizeEnemy();
		//if (ReprioritizeEnemy ())
		//	return;
	}
	
	if (cu_enemy_vis && !(self.enemy.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO)))
	{
		if (self.cu_th_checkattack())
		{
			if (self.cu_attack_state == cu_AS_MISSILE)
			{
				cu_ai_run_missile ();
			}
			else if (self.cu_attack_state == cu_AS_MELEE)
			{
				self.cu_attack_finished = 0;
				cu_ai_run_melee ();
			}
			else if (self.cu_attack_state == cu_AS_SLIDING)
			{
				cu_ai_run_slide (cu_dist);
			}
			return;
		}
	}
	
	if (self.cu_attack_state == cu_AS_SLIDING)
	{
		cu_ai_run_slide (cu_dist);
		return;
	}
		
	// head straight in
	cu_movetogoalplus(cu_dist);	// wraps movetogoal()
}

/*
=============
ai_nop
=============
*/
void() cu_ai_nop =
{
	if (self.flags & (cu_FL_FLY | cu_FL_SWIM))
		self.velocity = '0 0 0';
}
