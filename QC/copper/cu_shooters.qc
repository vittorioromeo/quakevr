float cu_SF_SHOOT_SUPERSPIKE	= 1;
float cu_SF_SHOOT_LASER		= 2;
float cu_SF_SHOOT_OGRENADE		= 4;
float cu_SF_SHOOT_ROCKET		= 8;
float cu_SF_SHOOT_ACTIVATOR	= 16;


/*FGD
@baseclass base(Appearflags, Target, Targetname, Angle) color(220 150 150) = Shooter
[
	spawnflags(Flags) = 
	[
		1 : "Spike" : 0
		2 : "Laser" : 0
		4 : "Ogre Grenade" : 0
		8 : "Player Rocket" : 0
		16 : "Fire At Activator" : 0
	]
	movedir(string) : "Override launch vector (x y z)"
	volume(string) : "Override sound volume" : "1.0"
	delay(string) : "Pause before first shot" : "0"
	speed(integer) : "Launch velocity for grenades"
]
*/

void() cu_spikeshooter_fire =
{
	if (self.state) return;
	
	vector cu_dir;
	entity cu_e;
	
	if (self.spawnflags & cu_SF_SHOOT_ACTIVATOR)
	{
		if (!self.enemy)
			self.enemy = cu_activator;
		cu_dir = normalize(self.enemy.origin - self.origin);
	}
	else
	{
		if (self.target != cu_string_null)
			cu_e = find(world, targetname, self.target);
			
		if (cu_e)
			cu_dir = normalize(cu_BoundsCenter(cu_e) - self.origin);
		else
			cu_dir = self.movedir;
	}
	
	if (self.spawnflags & cu_SF_SHOOT_LASER)
	{
		sound (self, cu_CHAN_VOICE, "enforcer/enfire.wav", self.volume, cu_ATTN_NORM);
		cu_dprint5("shot from ", vtos(self.origin), " at ",vtos(cu_dir), "\n");
		cu_launch_laser (self.origin, cu_dir*600);
	}
	else if (self.spawnflags & cu_SF_SHOOT_OGRENADE)
	{
		sound (self, cu_CHAN_VOICE, "weapons/grenade.wav", self.volume, cu_ATTN_NORM);
		cu_e = cu_launch_grenade(self.origin, cu_dir * self.speed);
		cu_e.touch = cu_OgreGrenadeTouch;
		cu_e.cu_th_die = cu_OgreGrenadeExplode;
	}
	else if (self.spawnflags & cu_SF_SHOOT_ROCKET)
	{
		sound (self, cu_CHAN_VOICE, "weapons/sgun1.wav", self.volume, cu_ATTN_NORM);
		cu_e = cu_launch_rocket(self.origin, cu_dir * 1000);
	}
	else
	{
		sound (self, cu_CHAN_VOICE, "weapons/spike2.wav", self.volume, cu_ATTN_NORM);
		cu_e = cu_launch_nail (self.origin, cu_dir * 500);
		if (self.spawnflags & cu_SF_SHOOT_SUPERSPIKE)
		{
			cu_e.classname = "superspike";
			cu_e.skin = 1;
			cu_e.dmg = 18;
		}
	}
}

void() cu_shooter_proxy_think =
{
	self.cu_buddy.enemy = self.enemy;
	cu_SUB_CallAsSelf(cu_spikeshooter_fire,self.cu_buddy);
	remove(self);
}

void() cu_shooter_once_think =
{
	// iw - if a shooter is triggered more often than its .delay, nextthink is
	// repeatedly overwritten and the shooter never fires (bbin1)
	// lunaran - spawn a proxy that'll fire at the right time to 'queue up'
	// shots, so that none are missed
	if (self.nextthink)
	{
		entity cu_shooty = spawn();
		cu_shooty.cu_buddy = self;
		cu_shooty.enemy = cu_activator;
		cu_shooty.think = cu_shooter_proxy_think;
		cu_shooty.nextthink = time + self.delay;
		return;
	}
	self.enemy = cu_activator;
	self.think = cu_spikeshooter_fire;
	self.nextthink = time + self.delay;
}

void() cu_shooter_think =
{
	cu_spikeshooter_fire ();
	self.nextthink = time + self.wait + self.cu_rand * random();
}

void() cu_spikeshooter_use = {cu_spikeshooter_fire();}	// for id1 hacks
void() cu_shooter_use =
{
	self.state = !(self.state);
	
	if (self.state) return;
	
	self.nextthink = time + self.delay;
	self.enemy = cu_activator;
}

/*cu:QUAKED trap_spikeshooter (0 .5 .8) (-8 -8 -8) (8 8 8) SUPERSPIKE LASER OGRENADE ROCKET AT_ACTIVATOR
When triggered, fires a spike in the direction set by "angle".

"movedir" override angle with a launch vector of your choosing
"target" aim at an entity instead. can be moving (like a train.)
"delay" delay before firing (for staggering shooters)
"volume" override how loud these things are because damn
"speed" override launch velocity for grenades only (laser and nail speed is standardized for the player's sake)
*/
/*FGD
@PointClass base(Shooter) = trap_spikeshooter : "Triggered shooter. Trigger to fire one shot." []
*/
void() cu_trap_spikeshooter =
{
	if (!cu_SUB_ShouldSpawn()) return;
	cu_SetMovedir ();
	
	self.volume = cu_zeroconvertdefault_saturate(self.volume, 1);
	
	self.use = cu_shooter_once_think;
	if (self.spawnflags & (cu_SF_SHOOT_OGRENADE | cu_SF_SHOOT_ROCKET))
	{
		if (self.deathtype == cu_string_null)
			self.deathtype = "blew up";
		self.speed = cu_zeroconvertdefault(self.speed, 400);
	}
	if (self.spawnflags & cu_SF_SHOOT_LASER)
	{
		if (self.deathtype == cu_string_null)
			self.deathtype = "was blasted by a laser";
		precache_model2 ("progs/laser.mdl");
		
		precache_sound2 ("enforcer/enfire.wav");
		precache_sound2 ("enforcer/enfstop.wav");
	}
	else
	{
		if (self.deathtype == cu_string_null)
			self.deathtype = "was spiked";
		cu_precache_sound_safe ("weapons/spike2.wav");
	}
}

/*cu:QUAKED trap_shooter (0 .5 .8) (-8 -8 -8) (8 8 8) SUPERSPIKE LASER OGRENADE ROCKET AT_ACTIVATOR
Continuously fires spikes in the direction set by "angle". Trigger to turn on, trigger again to turn off.
Laser is only for REGISTERED. YOU PAY FOR LASER
"wait" time between shots (1.0 default)
"delay" delay before firing first spike, so multiple shooters can be staggered
"movedir" override angle with a launch vector of your choosing
"speed" override launch velocity for grenades only (laser and nail speed is standardized for the player's sake)
*/
/*FGD
@PointClass base(Shooter) = trap_shooter : "Continuous shooter. Trigger to turn on and off."
[
	delay(string) : "Delay before first shot, so multiple shooters can be staggered"
	wait(string) : "Interval between shots"
	rand(string) : "Random extra time between shots"
]
*/
void() cu_trap_shooter =
{
	if (!cu_SUB_ShouldSpawn()) return;
	cu_trap_spikeshooter ();
	
	if (self.targetname != cu_string_null)	// start off if something targets us
		self.state = 1;
	self.use = cu_shooter_use;
	if (self.wait == 0)
		self.wait = 1;
		
	// original id trap_shooter used nextthink as a mapper-editable delay, which is dumb
	// add it to nextthink here anyway for backwards compatibility
	self.nextthink = self.nextthink + self.delay + self.wait + self.ltime;
	self.think = cu_shooter_think;
}

//============================================================================

float cu_SF_LSHOOT_ONESHOT	= 1;
float cu_SF_LSHOOT_TRACKME	= 2;

void(vector cu_tgt) cu_trap_lightning_effect =
{
	WriteByte (cu_MSG_ALL, cu_SVC_TEMPENTITY);
	
	if (self.cu_strength == 3)
	{
		WriteByte (cu_MSG_ALL, cu_TE_LIGHTNING3);
	}
	else if (self.cu_strength == 2)
	{
		WriteByte (cu_MSG_ALL, cu_TE_LIGHTNING1);
	}
	else
	{
		WriteByte (cu_MSG_ALL, cu_TE_LIGHTNING2);
	}
	
	WriteEntity (cu_MSG_ALL, self); WriteByte (cu_MSG_ALL, 0);
	WriteCoord (cu_MSG_ALL, self.origin_x);
	WriteCoord (cu_MSG_ALL, self.origin_y);
	WriteCoord (cu_MSG_ALL, self.origin_z);
	WriteCoord (cu_MSG_ALL, cu_tgt_x);
	WriteCoord (cu_MSG_ALL, cu_tgt_y);
	WriteCoord (cu_MSG_ALL, cu_tgt_z);
}

void() cu_trap_lightning_fire =
{
	vector cu_tgt, cu_org, cu_nudge;
	entity cu_last, cu_oself;
	float cu_i = 0;
	
	if (!self.enemy)	// might already be activator
		self.enemy = cu_findunlockedtarget(self, world);
	if (!self.enemy)
	{
		if (self.target != cu_string_null || self.cu_target2 != cu_string_null || 
			self.cu_target3 != cu_string_null || self.cu_target4 != cu_string_null)
		{
			return;	// has targets, but none are unlocked
		}
		else
		{
			cu_tgt = self.origin + self.movedir;	// has no targets
		}
	}
	else
	{
		cu_tgt = cu_BoundsCenter(self.enemy);	// for aiming at trains or bobboes
	}
		
	//self.enemy = world;	
	cu_nudge = normalize(cu_tgt - self.origin) * 8;
	
	if ( !(self.spawnflags & cu_SF_LSHOOT_ONESHOT) || self.cu_strength == 3)
	{
		if (time >= self.cu_nextmovesound)
		{
			sound (self, cu_CHAN_VOICE, "misc/power.wav", self.volume, cu_ATTN_NORM);
			self.cu_nextmovesound = time + 1.2;
		}
	}
	
	if (self.cu_strength == 1)
	{
		// do 10 dmg every think
		cu_traceline2(self.origin, cu_tgt, self, 0);	// hit one target and stop
		cu_tgt = trace_endpos;
		if (trace_ent.takedamage)
		{
			cu_T_Damage(trace_ent, self, self, 10, cu_DMGTYPE_LIGHTNING);
			particle (trace_endpos + cu_nudge, cu_nudge * -8, 225, 40);
			sound (trace_ent, cu_CHAN_BODY, "weapons/lhit.wav", 1, cu_ATTN_NORM);
		}
	}
	else
	{
		// str 2 and 3 lightnings pierce creatures to world
		cu_traceline2(self.origin, cu_tgt, self, cu_TRACE_NOMONSTERS);
		cu_tgt = trace_endpos;
		
		if (!(self.spawnflags & cu_SF_LSHOOT_ONESHOT) || 	// always dmg on think in continuous mode
			(self.cu_strength == 2 && self.count == 3) ||	// dmg on first think only in oneshot mode
			self.cu_strength == 3 )	// fatbeam is instakill so do it either way
		{
			cu_org = self.origin;
			cu_last = self;
			do {
				cu_i++;
				cu_traceline2(cu_org, cu_tgt, cu_last, 0);
				
				// end on buttons and shootable bmodels 
				if ( (trace_ent.solid != cu_SOLID_BBOX && trace_ent.solid != cu_SOLID_SLIDEBOX) && 
					(!trace_ent.movetype || trace_ent.movetype == cu_MOVETYPE_PUSH) )
				{
					cu_i = 8;
					cu_tgt = trace_endpos;
				}
				cu_org = trace_endpos + cu_nudge;
			
				if (trace_ent.takedamage)
				{
					cu_last = trace_ent;
					if (self.cu_strength == 2)
					{
						cu_T_Damage(trace_ent, self, self, 30, cu_DMGTYPE_LIGHTNING);
						particle (cu_org, cu_nudge * -8, 225, 120);
					}
					else
					{
						// handle chthons and shubs intelligently
						if (trace_ent.classname == "monster_boss" || trace_ent.classname == "monster_oldone")
						{
							if (self.count == 10)	// first tic only so we don't melt the boss
							{
								if (trace_ent.classname == "monster_boss")
								{
									cu_T_Damage (trace_ent, self, self, 1000, cu_DMGTYPE_LIGHTNING);
								}
								else if (trace_ent.classname == "monster_oldone")
								{
									cu_dprint4(ftos(self.count)," ", ftos(self.cu_strength), " zapping shub with a thing\n");
									cu_T_Damage (trace_ent, self, self, 10001, cu_DMGTYPE_LIGHTNING);	// auto-trigger one pain warble
								}
							}
						}
						else
						{
							cu_T_Damage (trace_ent, self, self, trace_ent.health + cu_min(trace_ent.armorvalue, trace_ent.health / trace_ent.armortype) + 50, cu_DMGTYPE_LIGHTNING);
						}
					}
					sound (trace_ent, cu_CHAN_BODY, "weapons/lhit.wav", 1, cu_ATTN_NORM);
				}
				else if (trace_ent.classname == "monster_boss" && self.cu_strength == 3 && self.count == 10)
				{
					cu_last = trace_ent;
					// get non-takedamage cthons too
					cu_dprint4(ftos(self.count)," ", ftos(self.cu_strength), " zapping cthon with a thing\n");
					cu_oself = self;
					self = trace_ent;
					self.health = self.health - 1;
					cu_boss_pain(cu_activator, 1);
					self = cu_oself;
				}
				
			} while (cu_i < 8 && trace_ent != world);
		}
	}
	if (self.cu_strength == 3)
		cu_tgt -= cu_nudge * 12;	// fatbeams are extra long
	cu_trap_lightning_effect(cu_tgt);
	
	if (self.spawnflags & cu_SF_LSHOOT_ONESHOT)
	{
		self.count = self.count - 1;
		if (self.count <= 0)
			return;
	}
	self.think = cu_trap_lightning_fire; 
	self.nextthink = time + 0.1;
}

void() cu_trap_lightning_proxy =
{
	if (self.cu_buddy.spawnflags & cu_SF_LSHOOT_TRACKME)
		self.cu_buddy.enemy = self.enemy;
	sound(self.cu_buddy, cu_CHAN_WEAPON, "weapons/lstart.wav", self.cu_buddy.volume, cu_ATTN_NORM);
	cu_SUB_CallAsSelf(cu_trap_lightning_fire, self.cu_buddy);
	remove(self);
}

void() cu_trap_lightning_use =
{
	entity cu_proxy;
	
	if (self.spawnflags & cu_SF_LSHOOT_TRACKME)
		self.enemy = cu_activator;
	
	if (self.spawnflags & cu_SF_LSHOOT_ONESHOT)
	{
		if (time < self.cu_attack_finished) return;
		self.cu_attack_finished = time + 0.1;
		
		if (self.cu_strength == 3) self.count = 10;
		else if (self.cu_strength == 2) self.count = 3;
		else self.count = 1;
		
		if (self.delay > 0)
		{
			cu_proxy = spawn();
			cu_proxy.think = cu_trap_lightning_proxy;
			cu_proxy.nextthink = time + self.delay;
			cu_proxy.cu_buddy = self;
			cu_proxy.enemy = cu_activator;
			return;
		}
			
		sound(self, cu_CHAN_WEAPON, "weapons/lstart.wav", self.volume, cu_ATTN_NORM);
		cu_trap_lightning_fire();
		return;
	}

	// is a toggle zapper
	self.state = !self.state;
	self.cu_nextmovesound = 0;
	if (self.state)
	{
		sound(self, cu_CHAN_WEAPON, "weapons/lstart.wav", self.volume, cu_ATTN_NORM);
		cu_trap_lightning_fire();
	}
	else
	{
		sound (self, cu_CHAN_VOICE, "misc/null.wav", 1, cu_ATTN_NORM);	// stop zap noise
		self.nextthink = 0;
	}
}
	

/*cu:QUAKED trap_lightning (0 .5 .8) (-8 -8 -8) (8 8 8) BURST AT_ACTIVATOR
Continuously fires lightning in the direction set by "angle". Trigger to turn on, trigger again to turn off.

Spawnflags
BURST		Fire once when triggered rather than toggling
AT_ACTIVATOR	Ignore target and fire at whatever activated it if LOS is not broken

"delay" delay before firing if BURST
"movedir" override angle with a launch vector of your choosing (length sets distance)
"target" override angle by aiming at an entity (will also search target2/3/4)
"strength" choose type of beam:
	1 - thin beam, 100dps (burst 10), stops at first target, default
	2 - thicker beam, 300dps, burst 30
	3 - fat anti-Chthon beam, death to touch, can hurt Chthons and Shubs
*/
/*FGD
@PointClass base(Appearflags, Target, Targetname, Angle) color(220 150 150) = trap_lightning : "Lightning shooter. Trigger to turn on, trigger again to turn off. Fires 10 times per second, unless 'One-shot' spawnflag is checked.

You can choose from three power levels, set by selecting 'strength':
1: 10dmg/100dps. Does not penetrate targets. Uses thin LG beam. One-shot lasts 0.1 seconds. Default.
2: 30dmg/300dps. Penetrates targets. Uses thick Shambler beam. One-shot lasts 0.3 seconds.
3: Instakill. Penetrates targets. Uses fat Chthon beam. One-shot lasts 1 second. Does 1k damage to a Chthon and 10k damage to a Shub." [
	spawnflags(Flags) = 
	[
		1 : "One-shot" : 0
		2 : "Aim At Activator" : 0
	]
	movedir(string) : "Override aim vector (x y z) - length of vector sets distance"
	delay(string) : "Pause before firing, if oneshot" : "0"
	strength(choices) : "Beam Power" = 
	[
		1 : "Small, 10dmg"
		2 : "Medium, 30dmg"
		3 : "Large, instagib"
	]

]
*/
void() cu_trap_lightning =
{
	if (!cu_SUB_ShouldSpawn()) return;

	cu_SetMovedir();
	if (vlen(self.movedir) < 32)
	{
		self.movedir = normalize(self.movedir) * 768;
	}
	
	self.cu_strength = cu_min(3, cu_max(1, self.cu_strength));

	precache_sound ("weapons/lstart.wav");
	precache_sound ("misc/power.wav");
	precache_sound ("weapons/lhit.wav");
	
	self.volume = cu_zeroconvertdefault_saturate(self.volume, 1);
	
	self.state = 0;
	self.count = 0;
	self.use = cu_trap_lightning_use;
	
	if (self.deathtype == cu_string_null)
		self.deathtype = "was fried by a bolt of lightning";
}
