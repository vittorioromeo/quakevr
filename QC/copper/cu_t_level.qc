/*
=============================================================================

	LEVEL CHANGING / INTERMISSION

=============================================================================
*/

void() cu_GotoNextMap =
{
	// tell the csqc hud to clear the intermission stuff
	// or else it draws over the LOADING bar :(
	entity cu_e = nextent(world);
	while (cu_e.flags & cu_FL_CLIENT)
	{
		cu_e.cu_clientdata = -1;
		cu_e = nextent(cu_e);
	}
	
	if (cvar("samelevel"))	// if samelevel is set, stay on same level
		changelevel (mapname);	// name of current level
	else
		changelevel (cu_nextmap);	// global set to next level
}


void() cu_ExitIntermission =
{
	// skip any text in deathmatch
	if (deathmatch)
	{
		cu_GotoNextMap ();
		return;
	}
	
	if (!cu_intermission) return;
	
	cu_intermission_exittime = time + 1;
	cu_intermission = cu_intermission + 1;

	// end of episode drivel
	if (cu_intermission == 2)
	{
		WriteByte (cu_MSG_ALL, cu_SVC_CDTRACK);
		WriteByte (cu_MSG_ALL, 2);
		WriteByte (cu_MSG_ALL, 3);
		
		if (cu_inter_text != cu_string_null)
		{
			WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
			WriteString (cu_MSG_ALL, cu_inter_text);
			return;
		}
		if (world.model == "maps/e1m7.bsp")
		{
			if (!cvar("registered"))
			{
				WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
				WriteString (cu_MSG_ALL, "As the corpse of the monstrous entity\nChthon sinks back into the lava whence\nit rose, you grip the Rune of Earth\nMagic tightly. Now that you have\nconquered the Dimension of the Doomed,\nrealm of Earth Magic, you are ready to\ncomplete your task in the other three\nhaunted lands of Quake. Or are you? If\nyou don't register Quake, you'll never\nknow what awaits you in the Realm of\nBlack Magic, the Netherworld, and the\nElder World!");
			}
			else
			{
				WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
				WriteString (cu_MSG_ALL, "As the corpse of the monstrous entity\nChthon sinks back into the lava whence\nit rose, you grip the Rune of Earth\nMagic tightly. Now that you have\nconquered the Dimension of the Doomed,\nrealm of Earth Magic, you are ready to\ncomplete your task. A Rune of magic\npower lies at the end of each haunted\nland of Quake. Go forth, seek the\ntotality of the four Runes!");
			}
			return;
		}
		else if (world.model == "maps/e2m6.bsp")
		{
			WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
			WriteString (cu_MSG_ALL, "The Rune of Black Magic throbs evilly in\nyour hand and whispers dark thoughts\ninto your brain. You learn the inmost\nlore of the Hell-Mother; Shub-Niggurath!\nYou now know that she is behind all the\nterrible plotting which has led to so\nmuch death and horror. But she is not\ninviolate! Armed with this Rune, you\nrealize that once all four Runes are\ncombined, the gate to Shub-Niggurath's\nPit will open, and you can face the\nWitch-Goddess herself in her frightful\notherworld cathedral.");
			return;
		}
		else if (world.model == "maps/e3m6.bsp")
		{
			WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
			WriteString (cu_MSG_ALL, "The charred viscera of diabolic horrors\nbubble viscously as you seize the Rune\nof Hell Magic. Its heat scorches your\nhand, and its terrible secrets blight\nyour mind. Gathering the shreds of your\ncourage, you shake the devil's shackles\nfrom your soul, and become ever more\nhard and determined to destroy the\nhideous creatures whose mere existence\nthreatens the souls and psyches of all\nthe population of Earth.");
			return;
		}
		else if (world.model == "maps/e4m7.bsp")
		{
			WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
			WriteString (cu_MSG_ALL, "Despite the awful might of the Elder\nWorld, you have achieved the Rune of\nElder Magic, capstone of all types of\narcane wisdom. Beyond good and evil,\nbeyond life and death, the Rune\npulsates, heavy with import. Patient and\npotent, the Elder Being Shub-Niggurath\nweaves her dire plans to clear off all\nlife from the Earth, and bring her own\nfoul offspring to our world! For all the\ndwellers in these nightmare dimensions\nare her descendants! Once all Runes of\nmagic power are united, the energy\nbehind them will blast open the Gateway\nto Shub-Niggurath, and you can travel\nthere to foil the Hell-Mother's plots\nin person.");
			return;
		}
		cu_GotoNextMap();
	}
	
	if (cu_intermission == 3)
	{
		if (!cvar("registered"))
		{	// shareware episode has been completed, go to sell screen
			WriteByte (cu_MSG_ALL, cu_SVC_SELLSCREEN);
			return;
		}
		
		if ( (serverflags & cu_SVFL_ALLEPISODES) == cu_SVFL_ALLEPISODES)
		{
			WriteByte (cu_MSG_ALL, cu_SVC_FINALE);
			WriteString (cu_MSG_ALL, "Now, you have all four Runes. You sense\ntremendous invisible forces moving to\nunseal ancient barriers. Shub-Niggurath\nhad hoped to use the Runes Herself to\nclear off the Earth, but now instead,\nyou will use them to enter her home and\nconfront her as an avatar of avenging\nEarth-life. If you defeat her, you will\nbe remembered forever as the savior of\nthe planet. If she conquers, it will be\nas if you had never been born.");
			return;
		}
		cu_GotoNextMap();
	}
	
	if (cu_intermission == 4)
	{
		cu_GotoNextMap();
	}
		
	if (cu_intermission >= 5)
	{
		cu_GotoNextMap();
		return;
	}

	dprint("fell off the end of exitintermission\n");
	return;
}



/*
============
ClearItemEffects

turn off glow and screen coloring while we're in a camera
============
*/
void(entity cu_who) cu_ClearItemEffects =
{
	cu_who.items = cu_not(cu_who.items, cu_IT_INVISIBILITY | cu_IT_INVULNERABILITY | cu_IT_SUIT | cu_IT_QUAD);
	cu_who.effects = 0;

	// remember how much time was left on the powerup
	if (cu_who.cu_radsuit_finished > time)
		cu_who.cu_radsuit_finished -= time;
	if (cu_who.cu_invincible_finished > time)
		cu_who.cu_invincible_finished -= time;
	if (cu_who.cu_invisible_finished > time)
		cu_who.cu_invisible_finished -= time;
	if (cu_who.cu_super_damage_finished > time)
		cu_who.cu_super_damage_finished -= time;
	/*
	who.rad_time = 0;
	who.invincible_time = 0;
	who.invisible_time = 0;
	who.super_time = 0;
	*/
}


/*
============
RestoreItemEffects
============
*/
void(entity cu_who) cu_RestoreItemEffects =
{
	if ( cu_who.cu_radsuit_finished > 0 )
	{
		cu_who.cu_radsuit_finished += time;
		cu_who.items += cu_IT_SUIT;
	}
	if ( cu_who.cu_invincible_finished > 0 )
	{
		cu_who.cu_invincible_finished += time;
		cu_who.items += cu_IT_INVULNERABILITY;
	}
	if ( cu_who.cu_invisible_finished > 0 )
	{
		cu_who.cu_invisible_finished += time;
		cu_who.items += cu_IT_INVISIBILITY;
	}
	if ( cu_who.cu_super_damage_finished > 0 )
	{
		cu_who.cu_super_damage_finished += time;
		cu_who.items += cu_IT_QUAD;
	}
}


entity() cu_LoopIntermissions =
{
	entity cu_spot, cu_first, cu_last;
	cu_spot = find (world, classname, "info_intermission");
	if (!cu_spot) return world;
	if (cu_spot.enemy) return cu_spot;
	
	cu_first = cu_spot;
	while(cu_spot)
	{
		cu_spot.cu_oldenemy = cu_last;
		cu_last = cu_spot;
		cu_spot = find (cu_last, classname, "info_intermission");
		cu_last.enemy = cu_spot;
	}
	cu_last.enemy = cu_first;
	cu_first.cu_oldenemy = cu_last;
	return cu_first;
}

/*
============
FindIntermission

Returns an entity to view from
============
*/
entity() cu_FindIntermission =
{
	entity cu_spot, cu_spot2;
	float cu_cyc;

	// look for info_intermission first
	cu_spot = cu_LoopIntermissions();	
	if (cu_spot)
	{
		cu_spot2 = cu_spot;
		while (cu_cyc < 100)
		{
			if (cu_spot2.spawnflags & 1) return cu_spot2;	// SPAWN_FIRST
			cu_cyc += 1;
			cu_spot2 = cu_spot2.enemy;
			if (cu_spot2 == cu_spot) break;
		}
		cu_cyc = ceil(random() * cu_cyc);
		cu_spot2 = cu_spot;
		while (cu_cyc)
		{
			cu_spot2 = cu_spot2.enemy;
			cu_cyc -= 1;
		}
		return cu_spot2;
	}

// then look for the start position
	cu_spot = find (world, classname, "info_player_start");
	if (cu_spot)
		return cu_spot;
	
// testinfo_player_start is only found in regioned levels
	cu_spot = find (world, classname, "testplayerstart");
	if ( cu_spot && ( cu_spot.spawnflags & 1 ) )
		return cu_spot;
	
	objerror ("FindIntermission: no spot");
	return world;
}

entity(entity cu_start) cu_FindNextIntermission =
{
	if (!cu_start) return world;
	if (cu_start.classname != "info_intermission") return cu_start;
	
	return cu_start.enemy;
}

entity(entity cu_start) cu_FindPreviousIntermission =
{
	if (!cu_start) return world;
	if (cu_start.classname != "info_intermission") return cu_start;
	
	return cu_start.cu_oldenemy;
}

// ================================================================

void(entity cu_client, entity cu_spot) cu_move_player_to_intermission =
{
	cu_ClearItemEffects(cu_client);	// remove powerups to clear glows/tints
	
	cu_client.flags |= cu_FL_NOTARGET;
	cu_client.flags = cu_not(cu_client.flags, cu_FL_ONGROUND);
	cu_client.view_ofs = cu_VEC_ORIGIN;
	cu_client.velocity = cu_VEC_ORIGIN;
	cu_client.angles = cu_client.v_angle = cu_client.mangle = cu_spot.mangle;
	cu_client.fixangle = cu_TRUE;		// turn this way immediately
	cu_client.nextthink = time + 0.5;
	cu_client.takedamage = cu_DAMAGE_NO;
	cu_client.solid = cu_SOLID_NOT;
	cu_client.movetype = cu_MOVETYPE_NONE;
	cu_client.goalentity = cu_spot;
	//bprint3("setting origin to ", vtos(spot.origin), "\n");
	
	// dumb hack: origins don't update without a model?
	//client.modelindex = 0;//modelindex_eyes;
	//client.alpha = -1;
	setorigin (cu_client, cu_spot.origin);
	//client.modelindex = 0;
	cu_client.model = cu_string_null;
	cu_client.weaponmodel = cu_string_null;
	//setsize(client,VEC_ORIGIN,VEC_ORIGIN);
	
	cu_fog_setFromEnt(cu_client, cu_spot);	// need to get fog from any camera we jump to
}

void() cu_move_player_to_next_intermission =
{
	entity	cu_spot;
	cu_spot = cu_FindNextIntermission(self.goalentity);
	cu_move_player_to_intermission(self,cu_spot);
}

void() cu_move_player_to_previous_intermission =
{
	entity	cu_spot;
	cu_spot = cu_FindPreviousIntermission(self.goalentity);
	cu_move_player_to_intermission(self,cu_spot);
}

void() cu_move_players_to_intermission =
{
	entity cu_spot;
	
	cu_spot = cu_FindIntermission();

	other = find (world, classname, "player");

	while (other != world)
	{
		other.think = cu_player_run;	// properly end all weapon firing states
		other.nextthink = time;
		// an extant lightning beam will briefly persist for its lifetime, and it
		// doesn't seem clearable even by spamming TE_LIGHTNING events
		
		cu_move_player_to_intermission(other,cu_spot);		
		other.cu_lifetime_finished = time + 6;
		other = find (other, classname, "player");		
	}
}

void() cu_execute_changelevel =
{
	cu_intermission = 1;
	
// enforce a wait time before allowing changelevel
	if (deathmatch)
		cu_intermission_exittime = time + 5;
	else
		cu_intermission_exittime = time + 2;

	WriteByte (cu_MSG_ALL, cu_SVC_CDTRACK);
	WriteByte (cu_MSG_ALL, 3);
	WriteByte (cu_MSG_ALL, 3);

	cu_move_players_to_intermission();

	WriteByte (cu_MSG_ALL, cu_SVC_INTERMISSION);
}

// in timelimit coop, players who exit early can look through intermission
// cameras while waiting for other players
// returns TRUE if the level should end immediately
float() cu_changelevel_check_coop =
{
	if (!coop) return cu_TRUE;
	
	float cu_timelimit = cvar("timelimit");
	if (cu_timelimit <= 0) return cu_TRUE;

	if (!cu_gameover)
	{
		cu_gameover = cu_TRUE;
		cu_coop_time = time + cu_timelimit;
		bprint("Level will end in ");
		cu_bprint_int(cu_timelimit);
		bprint(" seconds\n");
	}

	entity cu_pl = nextent(world); //player1
	float cu_exited = 0;
	while (cu_pl.flags & cu_FL_CLIENT)
	{
		if (cu_pl == cu_activator || cu_pl.deadflag)
			cu_exited++;
		cu_pl = nextent(cu_pl);
	}
	// everybody's out
	if (cu_exited == cu_clients)
		return cu_TRUE;
	
	cu_activator.deadflag = cu_DEAD_SPECTATING;	// never coming back
	cu_move_player_to_intermission(cu_activator, cu_FindIntermission());
	return cu_FALSE;
}

void() cu_changelevel_do =
{
	if (coop || deathmatch)
	{
		bprint (other.netname);
		bprint (" exited the level\n");
	}
	
	cu_nextmap = self.map;
	if (self.message != cu_string_null)
	{
		cu_inter_text = self.message;
	}
	
	if ( (self.spawnflags & 1) && (deathmatch == 0) )
	{	// NO_INTERMISSION
		cu_GotoNextMap();
		return;
	}

	if (cu_changelevel_check_coop())
	{
		// we can't move people right now, because touch functions are called
		// in the middle of C movement code, so set a think time to do it
		self.think = cu_execute_changelevel;
		self.touch = cu_SUB_Null;
		self.nextthink = time;
	}
}


void() cu_changelevel_touch =
{
	if (!cu_CheckValidTouch()) return;
	if (self.cu_customflags & cu_CFL_LOCKED) return;

	if (deathmatch)
	{
		if ((cvar("noexit") == 1) || ((cvar("noexit") == 2) && (mapname != "start")))
		{
			cu_T_Damage (other, self, self, 50000);
			return;
		}
	}
	
	cu_activator = other;
	cu_SUB_UseTargetsSilent();	
		// silent so that a 'message' key on the changelevel, which is meant for intermission text,
		// doesn't also get insta-centerprinted
	
	cu_changelevel_do();
}

/*cu:QUAKED trigger_changelevel (.5 0 .5) ? no_intermission ? TRIGGER_FIRST
When the player touches this, he gets sent to the map listed in the 'map' variable. The view will go to the info_intermission spot and display stats.

Flags:
"no_intermission" bypasses intermission screen
"trigger_first" won't be touchable until triggered once by something else
   
Keys:
"map" set to name of next map (e.g. e1m1) if no map is set, the current map will restart
"message" ONE page of intermission text to display
*/
/*FGD
@baseclass = ChangeLevel [
	map(string) : "Next map"
	message(string) : "Intermission text (limit one page)"
	spawnflags(flags) =
	[
		1: "No intermission" : 0
	]
]
@SolidClass base(Trigger, ChangeLevel) = trigger_changelevel : "Trigger: Change level.
When the player touches this, he gets sent to the map listed in the 'map' variable. The view will go to the info_intermission spot and display stats."
[]
*/
void() cu_trigger_changelevel =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (!self.map)
		objerror ("trigger_changelevel doesn't have map");
	
	cu_InitTrigger ();
	self.touch = cu_changelevel_touch;
}

/*cu:QUAKED target_changelevel (0.65 0 0.65) (-16 -16 -16) (16 16 16) NO_INTERMISSION
When the player triggers this by any means, he gets sent to the map listed in the "map" variable.  
Spawnflags:
NO_INTERMISSION: the view will not go to the info_intermission spot and display stats
Keys:
"map" set to name of next map (e.g. e1m1) if no map is set, the current map will restart
"message" ONE page of intermission text to display
*/
/*FGD
@PointClass base(Appearflags, Targetname, ChangeLevel) color(160 0 160) size(32 32 32) = target_changelevel : "Target: Change level.
When this is triggered, the player is sent to the map listed in the 'map' variable. The view will go to the info_intermission spot and display stats."
[]
*/
void() cu_target_changelevel =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (!self.map)
		objerror ("target_changelevel doesn't have map");
	
	self.use = cu_changelevel_do;
}


/*cu:QUAKED info_intermission (.75 .25 .25) (-8 -8 -8) (8 8 8) FIRST
This is the camera point for the intermission. Use 'angles' instead of angle, so you can set pitch or roll as well as yaw.
Quake does a random pick if more than one exists.
If no info_intermission entity is set, Quake uses the player start.

Keys:
"angles" or "mangle" set pitch yaw roll, positive pitch is down
"fog_color"/"fog_density" set the fog for the view from this camera

*/
/*FGD
@PointClass size(16 16 16) color(192 64 64) base(Fog, Appearflags) = info_intermission : "Intermission camera" 
[
	angles(string) : "Camera angle (Pitch Yaw Roll, positive pitch down)"
	mangle(string) : "Camera angle (Pitch Yaw Roll, positive pitch down)"
	spawnflags(Flags) = [
		1 : "Always First" : 0
	]
]
*/
void() cu_info_intermission =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (self.mangle == cu_VEC_ORIGIN)
		self.mangle = self.angles;
	cu_fog_fixKeys();
}


