/*
================================
print_quant
pretty-print a quantity to a client's buffer
================================
*/
void(float cu_amt, string cu_noun, entity cu_to) cu_print_quant =
{
	string cu_s;
	
	if (cu_amt == 1)
	{
		sprint (cu_to, "1 ");
		sprint (cu_to, cu_noun);
		return;
	}
	
	cu_s = ftos(cu_amt);
	sprint (cu_to, cu_s);
	sprint (cu_to, " ");
	sprint (cu_to, cu_noun);
	sprint (cu_to, "s");
}

/*
================================
BackpackTouch
================================
*/
void() cu_BackpackTouch =
{
	if (!cu_CheckValidTouch()) return;

	// coop 1: players can only pick up their own backpacks
	//if (coop == 1 && self.buddy && self.buddy != other) return;
	// reverted:
	// with no good way to indicate whose backpack is whose (because .colormap
	// only works on players outside the original software renderer) this led to 
	// a lot of ignored mystery backpacks players kept obsessively touching.
	// going out of your way for your own ammo is also a waste of time unless
	// the level is extremely linear, which good quake levels never are

	float cu_acount;
	
	other.ammo_shells = other.ammo_shells + self.ammo_shells;
	other.ammo_nails = other.ammo_nails + self.ammo_nails;
	other.ammo_rockets = other.ammo_rockets + self.ammo_rockets;
	other.ammo_cells = other.ammo_cells + self.ammo_cells;
	cu_bound_ammo(other);
	cu_armor_give(other, self.armorvalue, 0, cu_FALSE);	
	
	sprint (other, "You got ");

	if (self.items && (other.items & self.items) == 0)
	{
		cu_acount = cu_TRUE;
		other.items |= self.items;
		sprint (other, "the ");
		sprint (other, self.netname);
	
		// change to the weapon
		cu_W_BetterWeapon(other, self.items);
	}

	if (self.armorvalue)
	{
		if (cu_acount) sprint(other, ", ");
		cu_acount = 1;
		sprint(other, ftos(self.armorvalue));
		sprint(other, " armor");
	}
	if (self.ammo_shells)
	{
		if (cu_acount) sprint(other, ", ");
		cu_acount = 2;
		cu_print_quant(self.ammo_shells, "shell", other);
	}
	if (self.ammo_nails)
	{
		if (cu_acount) sprint(other, ", ");
		cu_acount = 2;
		cu_print_quant(self.ammo_nails, "nail", other);
	}
	if (self.ammo_rockets)
	{
		if (cu_acount) sprint(other, ", ");
		cu_acount = 2;
		cu_print_quant(self.ammo_rockets, "rocket", other);
	}
	if (self.ammo_cells)
	{
		if (cu_acount) sprint(other, ", ");
		cu_acount = 2;
		cu_print_quant(self.ammo_cells, "cell", other);
	}
	
	sprint (other, "\n");
	
	// do this after because t_heal prints its own message
	if (self.healamount)
		cu_T_Heal(other, self.healamount, 0);

	// regular monster backpacks don't make the AWESOME NEW backpack sound
	if (self.classname == "item_backpack")
	{
		if (cu_acount == 2)
			sound(other, cu_CHAN_ITEM, "items/pack.wav", 1, cu_ATTN_NORM);
		else	// only got armor, play armor sound instead
			sound(other, cu_CHAN_ITEM, "items/patch.wav", 1, cu_ATTN_NORM);
	}
	else
		sound (other, cu_CHAN_ITEM, "weapons/lock4.wav", 1, cu_ATTN_NORM);
		
	stuffcmd (other, "bf\n");

	if ((coop == 1 && self.cu_buddy && self.cu_buddy == other)
		|| (!other.weapon))
		cu_SUB_CallAsSelf(cu_W_SelectBestWeapon, other);		
	else
		cu_SUB_CallAsSelf(cu_W_SetCurrentAmmo, other);
	cu_ItemTouched();
}

/*
================================
BackpackAutoTouch

backpacks can always be picked up, so mapper-placed ammo backpacks should 
give the player something else if they're maxxed out on any ammo types,
since they're little exploration rewards for hiding behind crates and etc
================================
*/
void() cu_BackpackAutoTouch =
{
	if (!cu_CheckValidTouch()) return;

	if (self.spawnflags & 1)
		sprint (other, "You found a big backpack!\n");
	else
		sprint (other, "You found a backpack\n");
		
	if (other.ammo_shells + self.ammo_shells > cu_MAX_AMMO_SHELLS)
	{
		self.armorvalue += other.ammo_shells + self.ammo_shells - cu_MAX_AMMO_SHELLS;
		self.ammo_shells = cu_MAX_AMMO_SHELLS - other.ammo_shells;
	}
	if (other.ammo_nails + self.ammo_nails > cu_MAX_AMMO_NAILS)
	{
		self.armorvalue += ceil((other.ammo_nails + self.ammo_nails - cu_MAX_AMMO_NAILS) / 2);
		self.ammo_nails = cu_MAX_AMMO_NAILS - other.ammo_nails;
	}
	if (other.ammo_rockets + self.ammo_rockets > cu_MAX_AMMO_ROCKETS)
	{
		self.armorvalue += (other.ammo_rockets + self.ammo_rockets - cu_MAX_AMMO_ROCKETS) * 3;
		self.ammo_rockets = cu_MAX_AMMO_ROCKETS - other.ammo_rockets;
	}
	if (other.ammo_cells + self.ammo_cells > cu_MAX_AMMO_CELLS)
	{
		self.armorvalue += (other.ammo_cells + self.ammo_cells - cu_MAX_AMMO_CELLS) * 3;
		self.ammo_cells = cu_MAX_AMMO_CELLS - other.ammo_cells;
	}
	
	self.armorvalue = floor(self.armorvalue / 2);
	cu_BackpackTouch();
	
	if (self.wait > 0)
	{
		// reset all the values we may have just vandalized
		self.ammo_shells = floor(3 * random() + 6);
		self.ammo_nails = floor(5 * random() + 12);
		if (self.spawnflags & 1)
		{
			self.ammo_shells *= 2;
			self.ammo_nails *= 2;
			
			self.ammo_rockets = 2;
			self.ammo_cells = 3;
			self.skin = 2;
		}
		self.armorvalue = 0;
	}
}

/*cu:QUAKED item_backpack (0 .5 .5) (-16 -16 0) (16 16 40) BIG ? SUSPENDED -
A forgotten explorer's backpack. Grants a paltry sum of shells and nails (about half a small pack of each). Grants armor instead of any ammo the player already has maxed.

Flags:
"big" doubles shells and nails, adds 2 rockets and 4 cells, appears red
    
Keys:
"target/2/3/4/k" - entity to trigger when picked up
"targetname" - will not spawn until triggered
"wait" - will respawn after 'wait' seconds. fires targets every time.
"count" - limit number of times to respawn
*/
/*FGD
@PointClass base(Item) size(-16 -16 0, 16 16 40) color(0 128 128) 
	model({ "path": ":progs/backpack.mdl" }) 
	= item_backpack : 
"A forgotten explorer's backpack. Grants a paltry sum of shells and nails (about half a small pack of each). Grants armor instead of any ammo the player already has maxed."
[
	spawnflags(flags) =	[
		1 : "Big (2x, red, +2 rockets/4 cells)" : 0
	]
]
*/
void() cu_item_backpack =
{
	if (!cu_SUB_ShouldSpawn()) return;
	cu_precache_model_safe("progs/backpack.mdl");
	cu_precache_sound3("items/pack.wav");	// backpacks can play either of these
	cu_precache_sound3("items/patch.wav");

	setmodel (self, "progs/backpack.mdl");
	setsize (self, '-16 -16 0', '16 16 56');
	self.skin = 1;
	
	self.ammo_shells = floor(3 * random() + 6);
	self.ammo_nails = floor(5 * random() + 12);
	if (self.spawnflags & 1)
	{
		self.ammo_shells *= 2;
		self.ammo_nails *= 2;
		
		self.ammo_rockets = 2;
		self.ammo_cells = 3;
		self.skin = 2;
	}
	
	self.touch = cu_BackpackAutoTouch;
	cu_StartItem ();
}




/*
===============
DropBackpack
===============
*/
void() cu_DropBackpack =
{
	entity cu_item;

	if (!(self.ammo_shells + self.ammo_nails + self.ammo_rockets + self.ammo_cells))
		return;	// nothing in it

	cu_item = spawn();
	cu_item.origin = self.origin - '0 0 24';
	
	if (coop != 1)
	{
		cu_item.items = self.weapon;
		if (cu_item.items == cu_IT_AXE)
			cu_item.netname = cu_string_null;
		else if (cu_item.items == cu_IT_SHOTGUN)
			cu_item.netname = "Shotgun";
		else if (cu_item.items == cu_IT_SUPER_SHOTGUN)
			cu_item.netname = "Double-Barrelled Shotgun";
		else if (cu_item.items == cu_IT_NAILGUN)
			cu_item.netname = "Nailgun";
		else if (cu_item.items == cu_IT_SUPER_NAILGUN)
			cu_item.netname = "Perforator";
		else if (cu_item.items == cu_IT_GRENADE_LAUNCHER)
			cu_item.netname = "Grenade Launcher";
		else if (cu_item.items == cu_IT_ROCKET_LAUNCHER)
			cu_item.netname = "Rocket Launcher";
		else if (cu_item.items == cu_IT_LIGHTNING)
			cu_item.netname = "Thunderbolt";
		else
			cu_item.netname = cu_string_null;
		
	}
	
	if (coop == 1)
	{
		// keep half your shells and nails on respawn to make getting your backpack possible
		self.ammo_shells = floor(self.ammo_shells / 2);
		self.ammo_nails = floor(self.ammo_nails / 2);
	}
	cu_item.ammo_shells = self.ammo_shells;
	cu_item.ammo_nails = self.ammo_nails;
	cu_item.ammo_rockets = self.ammo_rockets;
	cu_item.ammo_cells = self.ammo_cells;

	cu_item.velocity_z = 300;
	cu_item.velocity_x = -100 + (random() * 200);
	cu_item.velocity_y = -100 + (random() * 200);
	
	cu_item.flags = cu_FL_ITEM;
	cu_item.solid = cu_SOLID_TRIGGER;
	cu_item.movetype = cu_MOVETYPE_TOSS;
	setmodel (cu_item, "progs/backpack.mdl");
	setsize (cu_item, '-16 -16 0', '16 16 56');
	cu_item.touch = cu_BackpackTouch;
	
	if (self.flags & cu_FL_CLIENT)
	{	// apply player's colormap to his backpack, although currently this only works in software
		cu_item.colormap = self.colormap;
		cu_item.skin = 3;
		
		if (coop == 1)
		{	// players can only pick up their own backpacks, which never despawn (body run rules)
			cu_item.cu_buddy = self;
			return;
		}
	}
	
	cu_item.nextthink = time + 116;	// remove after 2 minutes
	cu_item.think = cu_ItemDespawnBlink;	// blink 4 times
}