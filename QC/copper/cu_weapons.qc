/*
========
SuperDamageSound
========
*/
void() cu_SuperDamageSound =
{
	if (!cu_has_quad(self)) return;
	if (self.cu_super_damage_finished < time + 3) return;
	if (self.cu_super_sound < time)
	{
		self.cu_super_sound = time + 0.9;
		sound (self, cu_CHAN_POWERUP, "items/damage3.wav", 1, cu_ATTN_NORM);
	}
}

// ==================================================================

float(float cu_w) cu_W_RankForWeapon =
{
	if (!cu_w)
		return 666;
	if (cu_w == cu_IT_LIGHTNING)
		return 1;
	if (cu_w == cu_IT_ROCKET_LAUNCHER)
		return 2;
	if (cu_w == cu_IT_SUPER_NAILGUN)
		return 3;
	if (cu_w == cu_IT_GRENADE_LAUNCHER)
		return 4;
	if (cu_w == cu_IT_SUPER_SHOTGUN)
		return 5;
	if (cu_w == cu_IT_NAILGUN)
		return 6;
	return 7;
}

/*
=============
W_BetterWeapon

Deathmatch weapon change rules for picking up a weapon
=============
*/
void(entity cu_e, float cu_new) cu_W_BetterWeapon =
{
	entity cu_oself = self;
	if (!deathmatch)
	{
		// don't switch to explosive weapons with quad
		// 1.12: don't switch to explosives when invisible either, since you can't see the stupid viewmodel
		if ( (cu_has_quad(cu_e) || cu_has_invis(cu_e)) &&
			(cu_new == cu_IT_ROCKET_LAUNCHER || cu_new == cu_IT_GRENADE_LAUNCHER))
			return;
		// don't switch to a lightning gun when standing in water
		if (cu_e.waterlevel >= 2 && cu_new == cu_IT_LIGHTNING)
			return;
	}	
	self = cu_e;
	if (!deathmatch || cu_W_RankForWeapon (cu_new) < cu_W_RankForWeapon (self.weapon) )
		cu_W_Select(cu_new);
	self = cu_oself;
}

float(float cu_weap) cu_W_HasAmmo =
{
	if (!cu_weap || cu_weap == cu_IT_AXE) return cu_TRUE;
	
	if (cu_weap == cu_IT_SUPER_SHOTGUN)	return (self.ammo_shells >= 2);
	if (cu_weap == cu_IT_SHOTGUN)			return (self.ammo_shells >= 1);
	if (cu_weap == cu_IT_NAILGUN)			return (self.ammo_nails >= 1);
	if (cu_weap == cu_IT_SUPER_NAILGUN)	return (self.ammo_nails >= 2);
	if (cu_weap == cu_IT_LIGHTNING)		return (self.ammo_cells >= 1);
	if (cu_weap == cu_IT_GRENADE_LAUNCHER || cu_weap == cu_IT_ROCKET_LAUNCHER)
		return (self.ammo_rockets >= 1);
		
	return cu_FALSE;
}

float() cu_W_BestWeapon =
{
	if(self.items & (cu_IT_SUPER_NAILGUN) && cu_W_HasAmmo(cu_IT_SUPER_NAILGUN))
		return cu_IT_SUPER_NAILGUN;
	if(self.items & (cu_IT_SUPER_SHOTGUN) && cu_W_HasAmmo (cu_IT_SUPER_SHOTGUN))
		return cu_IT_SUPER_SHOTGUN;

	if (self.items & (cu_IT_LIGHTNING) && self.waterlevel <= 1 && cu_W_HasAmmo(cu_IT_LIGHTNING))
		return cu_IT_LIGHTNING;
	if(self.items & (cu_IT_NAILGUN) && cu_W_HasAmmo(cu_IT_NAILGUN))
		return cu_IT_NAILGUN;
	if(self.items & (cu_IT_SHOTGUN) && cu_W_HasAmmo(cu_IT_SHOTGUN))
		return cu_IT_SHOTGUN;
	if (self.items & cu_IT_AXE)
		return cu_IT_AXE;
		
	if(self.items & (cu_IT_ROCKET_LAUNCHER) && cu_W_HasAmmo(cu_IT_ROCKET_LAUNCHER))
		return cu_IT_ROCKET_LAUNCHER;
	if(self.items & (cu_IT_GRENADE_LAUNCHER) && cu_W_HasAmmo (cu_IT_GRENADE_LAUNCHER))
		return cu_IT_GRENADE_LAUNCHER;
		
	return 0;
}

void() cu_W_SelectBestWeapon =
{
	cu_W_Select(cu_W_BestWeapon());
}

void() cu_W_SelectBestShotgun =
{
	if (self.items & (cu_IT_SHOTGUN|cu_IT_SUPER_SHOTGUN))
	{
		if (!cu_W_Select(cu_IT_SHOTGUN) && !cu_W_Select(cu_IT_SUPER_SHOTGUN))
			sprint (self, "not enough ammo.\n");
	}
	else
	{
		sprint(self, "no weapon.\n");
	}
}

void() cu_W_SelectBestNailgun =
{
	if (self.items & (cu_IT_NAILGUN|cu_IT_SUPER_NAILGUN))
	{
		if (!cu_W_Select(cu_IT_NAILGUN) && !cu_W_Select(cu_IT_SUPER_NAILGUN))
			sprint (self, "not enough ammo.\n");
	}
	else
	{
		sprint(self, "no weapon.\n");
	}
}


/*
============
W_ChangeWeapon
============
*/
void() cu_W_ChangeWeapon =
{
	local	float	cu_it, cu_am, cu_fl;
	
	if (self.cu_customflags & cu_CFL_PLUNGE)
		return;
		
	cu_it = self.items;
	cu_am = 0;
	
	if (self.impulse == 1)
	{
		cu_fl = cu_IT_AXE;
	}
	else if (self.impulse == 2)
	{
		cu_fl = cu_IT_SHOTGUN;
		if (self.ammo_shells < 1)
			cu_am = 1;
	}
	else if (self.impulse == 3)
	{
		cu_fl = cu_IT_SUPER_SHOTGUN;
		if (self.ammo_shells < 2)
			cu_am = 1;
	}		
	else if (self.impulse == 4)
	{
		cu_fl = cu_IT_NAILGUN;
		if (self.ammo_nails < 1)
			cu_am = 1;
	}
	else if (self.impulse == 5)
	{
		cu_fl = cu_IT_SUPER_NAILGUN;
		if (self.ammo_nails < 2)
			cu_am = 1;
	}
	else if (self.impulse == 6)
	{
		cu_fl = cu_IT_GRENADE_LAUNCHER;
		if (self.ammo_rockets < 1)
			cu_am = 1;
	}
	else if (self.impulse == 7)
	{
		cu_fl = cu_IT_ROCKET_LAUNCHER;
		if (self.ammo_rockets < 1)
			cu_am = 1;
	}
	else if (self.impulse == 8)
	{
		cu_fl = cu_IT_LIGHTNING;
		if (self.ammo_cells < 1)
			cu_am = 1;
	}

	self.impulse = 0;
	
	if (!(self.items & cu_fl))
	{	// don't have the weapon or the ammo
		sprint (self, "no weapon.\n");
		return;
	}
	
	if (cu_am)
	{	// don't have the ammo
		sprint (self, "not enough ammo.\n");
		return;
	}

	cu_W_Select(cu_fl);
}

/*
============
Weapon Cycling

for players who insist on shuffling through their inventory the slow way
============
*/
float cu_W_Next(float cu_w) =
{
	if (cu_w == cu_IT_AXE) return cu_IT_SHOTGUN;
	else if (cu_w == cu_IT_LIGHTNING) return cu_IT_AXE;
	else return cu_w * 2;
}

float cu_W_Prev(float cu_w) =
{
	if (cu_w == cu_IT_SHOTGUN) return cu_IT_AXE;
	else if (cu_w == cu_IT_AXE) return cu_IT_LIGHTNING;
	else return cu_w / 2;
}

// cycle weapon up
void() cu_CycleWeaponCommand =
{
	float cu_weap = self.weapon;
	self.impulse = 0;
	if (!cu_weap)
		cu_weap = cu_W_BestWeapon();
	else do {
		cu_weap = cu_W_Next(cu_weap);
		if (self.items & cu_weap && cu_W_HasAmmo(cu_weap))
			break;
	} while (cu_weap != self.weapon);
	cu_W_Select (cu_weap);
}

// cycle weapon down
void() cu_CycleWeaponReverseCommand =
{
	float cu_weap = self.weapon;
	self.impulse = 0;
	if (!cu_weap)
		cu_weap = cu_W_BestWeapon();
	else do {
		cu_weap = cu_W_Prev(cu_weap);
		if (self.items & cu_weap && cu_W_HasAmmo(cu_weap))
			break;
	} while (cu_weap != self.weapon);
	cu_W_Select (cu_weap);
}

// ==================================================================

void() cu_W_SetIdleWeaponFrame =
{
	self.weaponframe = 0;
}

void() cu_W_SetCurrentAmmo =
{
	self.items = self.items - ( self.items & (cu_IT_SHELLS | cu_IT_NAILS | cu_IT_ROCKETS | cu_IT_CELLS) );
	
	if (self.weapon == cu_IT_SHOTGUN || self.weapon == cu_IT_SUPER_SHOTGUN)
	{
		self.currentammo = self.ammo_shells;
		self.items = self.items | cu_IT_SHELLS;
	}
	else if (self.weapon == cu_IT_NAILGUN || self.weapon == cu_IT_SUPER_NAILGUN)
	{
		self.currentammo = self.ammo_nails;
		self.items = self.items | cu_IT_NAILS;
	}
	else if (self.weapon == cu_IT_GRENADE_LAUNCHER || self.weapon == cu_IT_ROCKET_LAUNCHER)
	{
		self.currentammo = self.ammo_rockets;
		self.items = self.items | cu_IT_ROCKETS;
	}
	else if (self.weapon == cu_IT_LIGHTNING)
	{
		self.currentammo = self.ammo_cells;
		self.items = self.items | cu_IT_CELLS;
	}
	else	// axes, etc
	{
		self.currentammo = 0;
	}
}

void() cu_W_ResetWeaponState =
{
	cu_player_run ();		// get out of any weapon firing states
	self.lip = 0;	// reset nailgun barrel cycle
	self.weaponframe = 0;
	//self.attack_finished = 0;	// don't lose attack debounce time from last attack,
		// if any, or picking up/switching weapons can cause double attacks
	
	if (self.weapon == cu_IT_AXE )
		self.weaponmodel = VR_ModelOr("progs/v_axe2.mdl", "progs/v_axe.mdl");
	else if (self.weapon == cu_IT_SHOTGUN)
		self.weaponmodel = "progs/v_shot.mdl";
	else if (self.weapon == cu_IT_SUPER_SHOTGUN)
		self.weaponmodel = "progs/v_shot2.mdl";
	else if (self.weapon == cu_IT_NAILGUN)
		self.weaponmodel = "progs/v_nail.mdl";
	else if (self.weapon == cu_IT_SUPER_NAILGUN)
		self.weaponmodel = "progs/v_nail2.mdl";
	else if (self.weapon == cu_IT_GRENADE_LAUNCHER)
		self.weaponmodel = "progs/v_rock.mdl";
	else if (self.weapon == cu_IT_ROCKET_LAUNCHER)
		self.weaponmodel = "progs/v_rock2.mdl";
	else if (self.weapon == cu_IT_LIGHTNING)
		self.weaponmodel = "progs/v_light.mdl";
	else
		self.weaponmodel = cu_string_null;

	cu_W_SetCurrentAmmo();
}

void() cu_W_SelectLastWeapon =
{
	if (self.cu_attack_state)
		cu_W_Select(self.cu_attack_state);
}

/*
============
W_Select
This should be the only function that changes .weapon
============
*/
float(float cu_weap) cu_W_Select =
{
	if (cu_weap)
	{
		if (self.weapon == cu_weap) return cu_TRUE;
		if ((self.items & cu_weap) == 0) return cu_FALSE;
		if (!cu_W_HasAmmo(cu_weap)) return cu_FALSE;
		self.cu_attack_state = self.weapon;
	}

	self.weapon = cu_weap;
	cu_W_ResetWeaponState();
	return cu_TRUE;
}

// ==================================================================


/*
============
W_Attack

An attack impulse can be triggered now
============
*/
void() cu_W_Attack =
{
	if (self.weapon && !cu_W_HasAmmo(self.weapon))
	{
		cu_W_SelectBestWeapon();
		if (!self.weapon || self.weapon == cu_IT_AXE)
		{
			sprint (self, "not enough ammo.\n");
			return;
		}
	}
	if (self.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO))
		return;

	makevectors	(self.v_angle);			// calculate forward angle for velocity

	if (self.weapon == cu_IT_AXE)
	{
		cu_player_axe();
		cu_W_AxeSwing();
		return;
	}
	
	// moved after axe so that silent swings don't wake monsters
	self.cu_show_hostile = time + 1;
	
	if (self.weapon == cu_IT_SHOTGUN)
	{
		cu_player_shot1 ();
		cu_W_FireShotgun ();
	}
	else if (self.weapon == cu_IT_SUPER_SHOTGUN)
	{
		cu_player_shot1 ();
		cu_W_FireSuperShotgun ();
	}
	else if (self.weapon == cu_IT_NAILGUN || self.weapon == cu_IT_SUPER_NAILGUN)
	{
		cu_player_nail();
		cu_W_FireSpikes ();
	}
	else if (self.weapon == cu_IT_GRENADE_LAUNCHER)
	{
		cu_player_rocket1();
		cu_W_FireGrenade();
	}
	else if (self.weapon == cu_IT_ROCKET_LAUNCHER)
	{
		cu_player_rocket1();
		cu_W_FireRocket();
	}

	else if (self.weapon == cu_IT_LIGHTNING)
	{
		cu_player_light1();
		self.cu_attack_finished = time + 0.1;
		sound (self, cu_CHAN_AUTO, "weapons/lstart.wav", 1, cu_ATTN_NORM);
	}
}

/*
============
W_WeaponFrame

Called every frame so impulse events can be handled as well as possible
============
*/
void() cu_W_WeaponFrame =
{
	if (self.impulse)
		cu_ImpulseCommands();
	if (time < self.cu_attack_finished)
		return;

	// check for attack
	if (self.button0)
	{
		cu_SuperDamageSound ();
		cu_W_Attack ();
	}
}

// impulses also moved to their own file
