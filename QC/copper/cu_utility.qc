float(entity cu_who) cu_has_invis = { return (cu_who.items & cu_IT_INVISIBILITY || cu_who.cu_invisible_finished > time); }
float(entity cu_who) cu_has_quad = { return (cu_who.items & cu_IT_QUAD || cu_who.cu_super_damage_finished > time); }
float(entity cu_who) cu_has_invuln = { return (cu_who.items & cu_IT_INVULNERABILITY || cu_who.cu_invincible_finished > time); }
