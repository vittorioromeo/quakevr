void(entity cu_who, string cu_s) cu_centerprintlocal =
{
	entity cu_e;
	vector cu_dir;
	cu_e = nextent(world);
		
	while (cu_e.flags & cu_FL_CLIENT)
	{
		if (cu_e == cu_who)
		{
			centerprint(cu_e, cu_s);
		}
		else
		{
			cu_dir = cu_e.origin - cu_who.origin;
			cu_dir = normalize(cu_dir);
			traceline(cu_who.origin, cu_who.origin + cu_dir * 500, cu_TRUE, cu_who);
			if (trace_ent == cu_e)
				centerprint(cu_e, cu_s);
		}
		cu_e = nextent(cu_e);
	}
}

void(string cu_s) cu_centerprintall =
{
	entity cu_e;
	cu_e = nextent(world);
		
	while (cu_e.flags & cu_FL_CLIENT)
	{
		centerprint(cu_e, cu_s);
		cu_e = nextent(cu_e);
	}
}

void(string cu_s, entity cu_excl) cu_centerprintothers =
{
	entity cu_e;
	cu_e = nextent(world);
		
	while (cu_e.flags & cu_FL_CLIENT)
	{
		if (cu_e != cu_excl)
			centerprint(cu_e, cu_s);
		cu_e = nextent(cu_e);
	}
}


// sprint_to_others
// for mirroring private centerprinted text to other clients
void(string cu_s, entity cu_excl) cu_sprint_to_others =
{
	if (!coop) return;

	entity cu_pl = nextent(world);
	while (cu_pl.flags & cu_FL_CLIENT)
	{
		if (cu_pl != cu_excl)
			sprint(cu_pl, cu_s);
		cu_pl = nextent(cu_pl);
	}
}

