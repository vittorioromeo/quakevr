// findradius only works on solid entities, because apparently it's only for explosions
entity(vector cu_point, float cu_rad, .string cu_fld, string cu_match) cu_findradiusplus =
{
	entity cu_head, cu_prev;
	cu_prev = world;
	cu_head = find(world, cu_fld, cu_match);
	
	float cu_found = 0;
	
	while(cu_head)
	{
		if ( vlen(cu_point - cu_head.origin) <= cu_rad )
		{
			cu_head.chain = cu_prev;		
			cu_prev = cu_head;
			cu_found += 1;
		}
		cu_head = find(cu_head, cu_fld, cu_match);
	}
	return cu_prev;
}


// just find every damn thing targeted by 'src' and return it as head.chain
// targets will be primarily in order by target/2/3/4, and secondarily by spawn order
// so 'target's always come before 'target2's in the chain, etc
entity(entity cu_src) cu_findalltargets =
{
	// WARNING: do not use this in the context of actually triggering targets.
	// an entity triggering down an active .chain of targets could trigger one
	// which itself calls findalltargets to do the same, which could blow away
	// the existing chain.
	entity cu_head, cu_f, cu_prev;
	cu_head = world;
	cu_f = world;
	cu_prev = world;
	
	if (cu_src.target != cu_string_null)
	{
		cu_f = find(world, targetname, cu_src.target);
		while(cu_f)
		{
			if (!cu_head) cu_head = cu_f;	// mark the start location
			if (cu_prev)
				cu_prev.chain = cu_f;		// connect the end of the chain
			cu_prev = cu_f;
			cu_f = find(cu_f, targetname, cu_src.target);
		}
	}
	if (cu_src.cu_target2 != cu_string_null)
	{
		cu_f = find(world, targetname, cu_src.cu_target2);
		while(cu_f)
		{
			if (!cu_head) cu_head = cu_f;
			if (cu_prev)
				cu_prev.chain = cu_f;
			cu_prev = cu_f;
			cu_f = find(cu_f, targetname, cu_src.cu_target2);
		}
	}
	if (cu_src.cu_target3 != cu_string_null)
	{
		cu_f = find(world, targetname, cu_src.cu_target3);
		while(cu_f)
		{
			if (!cu_head) cu_head = cu_f;
			if (cu_prev)
				cu_prev.chain = cu_f;
			cu_prev = cu_f;
			cu_f = find(cu_f, targetname, cu_src.cu_target3);
		}
	}
	if (cu_src.cu_target4 != cu_string_null)
	{
		cu_f = find(world, targetname, cu_src.cu_target4);
		while(cu_f)
		{
			if (!cu_head) cu_head = cu_f;
			if (cu_prev)
				cu_prev.chain = cu_f;
			cu_prev = cu_f;
			cu_f = find(cu_f, targetname, cu_src.cu_target4);
		}
	}
	
	cu_prev.chain = world;	// don't link to stale chains
	return cu_head;
}

// findalltargets, but in reverse: returns a chain of all entities that target dst
entity(entity cu_dst) cu_findalltargeters =
{
	if (cu_dst.targetname == cu_string_null)
		return world;
	
	entity cu_head, cu_f, cu_prev;
	cu_head = world;
	cu_f = world;
	cu_prev = world;
	
	cu_f = find(world, target, cu_dst.targetname);
	while(cu_f)
	{
		if (!cu_head) cu_head = cu_f;	// mark the start location
		if (cu_prev)
			cu_prev.chain = cu_f;		// connect the end of the chain
		cu_prev = cu_f;
		cu_f = find(cu_f, target, cu_dst.targetname);
	}

	cu_f = find(world, cu_target2, cu_dst.targetname);
	while(cu_f)
	{
		if (!cu_head) cu_head = cu_f;
		if (cu_prev)
			cu_prev.chain = cu_f;
		cu_prev = cu_f;
		cu_f = find(cu_f, cu_target2, cu_dst.targetname);
	}

	cu_f = find(world, cu_target3, cu_dst.targetname);
	while(cu_f)
	{
		if (!cu_head) cu_head = cu_f;
		if (cu_prev)
			cu_prev.chain = cu_f;
		cu_prev = cu_f;
		cu_f = find(cu_f, cu_target3, cu_dst.targetname);
	}

	cu_f = find(world, cu_target4, cu_dst.targetname);
	while(cu_f)
	{
		if (!cu_head) cu_head = cu_f;
		if (cu_prev)
			cu_prev.chain = cu_f;
		cu_prev = cu_f;
		cu_f = find(cu_f, cu_target4, cu_dst.targetname);
	}

	cu_prev.chain = world;	// don't link to stale chains
	return cu_head;
}

entity(entity cu_start, .string cu_fld, string cu_match) cu_findunlocked =
{
	entity cu_head;
	float cu_found = cu_FALSE;
	cu_head = find(cu_start, cu_fld, cu_match);
	while (cu_head)
	{
		if (!(cu_head.cu_customflags & cu_CFL_LOCKED))
			break;
		cu_head = find(cu_head, cu_fld, cu_match);
	}
	return cu_head;
}

entity(entity cu_e, entity cu_start) cu_findunlockedtarget =
{
	entity cu_head = world;
	if (cu_e.target != cu_string_null)
		cu_head = cu_findunlocked(cu_start, targetname, cu_e.target);
	if (cu_head) return cu_head;
	
	if (cu_e.cu_target2 != cu_string_null)
		cu_head = cu_findunlocked(cu_start, targetname, cu_e.cu_target2);
	if (cu_head) return cu_head;
	
	if (cu_e.cu_target3 != cu_string_null)
		cu_head = cu_findunlocked(cu_start, targetname, cu_e.cu_target3);
	if (cu_head) return cu_head;
	
	if (cu_e.cu_target4 != cu_string_null)
		return cu_findunlocked(cu_start, targetname, cu_e.cu_target4);
	return world;
}

// quake hates precaches that happen late, and
// some maphacks create trigger_first triggers by setting 'use' to 
// 'trigger_multiple', causing this to be called in mid-level
string(string cu_s) cu_precache_sound_safe =
{
	if (cu_framecount || cu_s == cu_string_null) return cu_string_null;
	return precache_sound(cu_s);
}
string(string cu_s) cu_precache_sound2_safe =
{
	if (cu_framecount || cu_s == cu_string_null) return cu_string_null;
	return precache_sound2(cu_s);
}

/*
i've brought over the quoth convention of letting mappers set the 'model' key on func_*
to override an entity's model with something external, which must be precached, but that 
collides with the existing use of the model keyvalue, and also causes precache-out-of-turn
errors on maps with map hacks like mce.bsp

however, if the entity already has a modelindex, it already has a model internal to the
bsp and precache should never be called no matter what time it is. (do not call when self
is world, like in W_Precache)
*/
void(string cu_s) cu_precache_model_safe	=
{
	if (cu_framecount) return;
	if (cu_s != cu_string_null && !self.modelindex)
		precache_model(cu_s);
}
void(string cu_s) cu_precache_model2_safe	=
{
	if (cu_framecount) return;
	if (cu_s != cu_string_null && !self.modelindex)
		precache_model2(cu_s);
}

/*
failed precaches still prevent the map from loading in most engines. put all mod-related 
precaches through these wrappers so they can be easily turned off, in the event you want 
to send small test builds to engine programmers to show them bugs without having to 
build and package your entire mod.
*/
void(string cu_s) cu_precache_model3	= { cu_precache_model2_safe(cu_s); }
void(string cu_s) cu_precache_sound3	= { cu_precache_sound2_safe(cu_s); }
/*
void(string s) precache_model3	= { return; }
void(string s) precache_sound3	= { return; }
*/

float(entity cu_e) cu_localtime =
{
	if (cu_e.solid == cu_SOLID_BSP || cu_e.movetype == cu_MOVETYPE_PUSH)
		return cu_e.ltime;
	return time;
}

// shorthand for turning -1 to 0 for keyvalues for which 0 is a valid non-default selection
float(float cu_in) cu_zeroconvert =
{
	if (cu_in == -1) return 0;
	return cu_in;
}
float(float cu_in, float cu_def) cu_zeroconvertdefault =
{
	if (cu_in == -1) return 0;
	if (cu_in == 0) return cu_def;
	return cu_in;
}
float(float cu_in, float cu_def) cu_zeroconvertdefault_saturate =
{
	if (cu_in == 0) return cu_def;
	return cu_saturate(cu_in);
}

//count -4 = numclients in coop
void(.float cu_fld) cu_playercount_convert =
{
	if (self.cu_fld != -4) return;
	if (!coop)
		self.cu_fld = 1;
	else
	{
		// limit this because we can't assume a max of 8 coop players (... thanks decino)
		if (cu_clients <= 4)
			self.cu_fld = cu_clients;
		else if (cu_clients >= 20)
			self.cu_fld = 10;	// hard cap of 10 @ 20 players
		else if (cu_clients >= 16)
			self.cu_fld = 9;
		else if (cu_clients >= 12)
			self.cu_fld = 8;
		else if (cu_clients >= 10)
			self.cu_fld = 7;
		else if (cu_clients >= 8)
			self.cu_fld = 6;
		else if (cu_clients >= 6)
			self.cu_fld = 5;		
		/*
			self.fld =	// magic formula ...
				min(4, clients)	+							// first four clients count full
				floor(max(0, min(12, clients) - 4) / 2) +	// clients above 4th count half
				floor(max(0, clients - 12) / 4);			// clients above 12th count quarter
		*/
	}
}




// ================================
//	Frustum/Box Tests
// ================================

vector(entity cu_e) cu_BoundsCenter =
{
	return cu_e.origin + 0.5 * ( cu_e.mins + cu_e.maxs );
}

vector(entity cu_e) cu_BoundsBottom =
{
	vector cu_out;
	cu_out = cu_e.origin + 0.5 * ( cu_e.mins + cu_e.maxs );
	cu_out_z = cu_e.origin_z + cu_e.mins_z;
	return cu_out;
}

// for measuring how large an entity is along an arbitrary vector
float(vector cu_v, vector cu_s) cu_BoundsAngleSize =
{
	/*
	v_x = fabs(v_x);
	v_y = fabs(v_y);
	v_z = fabs(v_z);
	
	// size is always + + + but this is in case I switch the parameters somewhere
	s_x = fabs(s_x);
	s_y = fabs(s_y);
	s_z = fabs(s_z);
	return v*s;
	*/
	
	/*
	oct 11 26: restoring old behavior even though it was just as broken. it was broken in a
	different way that numerous vanilla maps were built to compensate for (iris doors in
	sm190_newhouse, for example), and the fix broke those.
	will this reverse-fix break copper maps that were built to compensate for the other
	bad math? maybe? I hope not? this seems less likely since the .distance key solves the
	need to pick random-seeming numbers to make a door move diagonally a certain amount, and
	has existed since 1.0.
	*/
	return fabs(cu_v * cu_s);
}

float (vector cu_e1mins, vector cu_e1maxs, vector cu_e2mins, vector cu_e2maxs, float cu_pad) cu_BoundsTouching =
{
	if (cu_e1mins_x > cu_e2maxs_x + cu_pad) return cu_FALSE;
	if (cu_e1mins_y > cu_e2maxs_y + cu_pad) return cu_FALSE;
	if (cu_e1mins_z > cu_e2maxs_z + cu_pad) return cu_FALSE;
	if (cu_e1maxs_x < cu_e2mins_x - cu_pad) return cu_FALSE;
	if (cu_e1maxs_y < cu_e2mins_y - cu_pad) return cu_FALSE;
	if (cu_e1maxs_z < cu_e2mins_z - cu_pad) return cu_FALSE;
	return cu_TRUE;
}

// moved from doors
float (entity cu_e1, entity cu_e2) cu_EntitiesTouching =
{
	return cu_BoundsTouching(cu_e1.absmin, cu_e1.absmax, cu_e2.absmin, cu_e2.absmax, 0);
}

float(vector cu_org, float cu_hside, vector cu_point) cu_BoundingCubeTest =
{
	if (cu_point_x > cu_org_x + cu_hside) return cu_FALSE;
	if (cu_point_x < cu_org_x - cu_hside) return cu_FALSE;
	if (cu_point_y > cu_org_y + cu_hside) return cu_FALSE;
	if (cu_point_y < cu_org_y - cu_hside) return cu_FALSE;
	if (cu_point_z > cu_org_z + cu_hside) return cu_FALSE;
	if (cu_point_z < cu_org_z - cu_hside) return cu_FALSE;
	return cu_TRUE;
}

float(vector cu_planeN, float cu_planeD, vector cu_point) cu_PlaneTest =
{
	return cu_point * cu_planeN - cu_planeD;
}

float(vector cu_planeN, float cu_planeD, vector cu_mn, vector cu_mx) cu_BoxPlaneTest =
{
	local float cu_outCount;

	cu_outCount = 0;
	
	// you know what's cool?  arrays.
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mn_x, cu_mn_y, cu_mn_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mx_x, cu_mn_y, cu_mn_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mn_x, cu_mx_y, cu_mn_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mx_x, cu_mx_y, cu_mn_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mn_x, cu_mn_y, cu_mx_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mx_x, cu_mn_y, cu_mx_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mn_x, cu_mx_y, cu_mx_z)) <= 0) cu_outCount++;
	if (cu_PlaneTest(cu_planeN, cu_planeD, cu_Vector(cu_mx_x, cu_mx_y, cu_mx_z)) <= 0) cu_outCount++;
	
	dprint(": ");
	dprint(ftos(cu_outCount));
	dprint(" ");
	
	return cu_outCount;
}

float(entity cu_observer, float cu_fov, vector cu_mn, vector cu_mx) cu_FrustumCheck =
{
	local vector cu_vorg;
	cu_vorg = cu_observer.origin + cu_observer.view_ofs;
	makevectors(cu_observer.v_angle);
	
	// assume vertical fov is at most 3/4 hfov, because nobody plays quake in a square window
	local float cu_hfov, cu_vfov;
	cu_hfov = cu_fov * 0.6;
	cu_vfov = cu_fov * 0.45; // was 0.5/0.375
	// added a 20% buffer because engines like mk5 and quakespasm have added "correction" 
	// so now hfov can't be trusted to just be the actual fucking fov anymore
	
	local float cu_bpt, cu_hc, cu_hs, cu_vc, cu_vs;
	local vector cu_temp, cu_side0n, cu_side1n, cu_side2n, cu_side3n, cu_side4n;
	local float cu_side0d, cu_side1d, cu_side2d, cu_side3d, cu_side4d;
	
	cu_temp = cu_SinCos(cu_hfov);
	cu_hs = cu_temp_x;
	cu_hc = cu_temp_y;
	
	cu_temp = cu_SinCos(cu_vfov);
	cu_vs = cu_temp_x;
	cu_vc = cu_temp_y;
	
	// determine frustum planes one at a time, starting with near, then left/right, then top/bottom
	// far plane isn't really necessary
	cu_side0n = v_forward;
	cu_side0d = cu_vorg * cu_side0n;
	dprint("NR");
	cu_bpt = cu_BoxPlaneTest(cu_side0n, cu_side0d, cu_mn, cu_mx);
	if (cu_bpt == 8) return 0;
	
	cu_side1n = v_forward * cu_hs + v_right * cu_hc;
	cu_side1d = cu_vorg * cu_side1n;
	dprint("LF");
	cu_bpt = cu_BoxPlaneTest(cu_side1n, cu_side1d, cu_mn, cu_mx);
	if (cu_bpt == 8) return 0;
	
	cu_side2n = v_forward * cu_hs - v_right * cu_hc;
	cu_side2d = cu_vorg * cu_side2n;
	dprint("RT");
	cu_bpt = cu_BoxPlaneTest(cu_side2n, cu_side2d, cu_mn, cu_mx);
	if (cu_bpt == 8) return 0;
	
	cu_side3n = v_forward * cu_vs + v_up * cu_vc;
	cu_side3d = cu_vorg * cu_side3n;
	dprint("DN");
	cu_bpt = cu_BoxPlaneTest(cu_side3n, cu_side3d, cu_mn, cu_mx);
	if (cu_bpt == 8) return 0;
	
	cu_side4n = v_forward * cu_vs - v_up * cu_vc;
	cu_side4d = cu_vorg * cu_side4n;
	dprint("UP");
	cu_bpt = cu_BoxPlaneTest(cu_side4n, cu_side4d, cu_mn, cu_mx);
	if (cu_bpt == 8) return 0;
	
	return 1;	
}





