void cu_stuffcmd_digit( entity cu_client, float cu_f) =
{
	float cu_d;
	cu_d = floor(cu_f);
	cu_d = cu_mod(cu_d, 10);

	//CLOSE YOUR EYES, HONEY! DON'T LOOK!
	if(cu_d == 0)
		stuffcmd(cu_client, "0");
	else if(cu_d == 1)
		stuffcmd(cu_client, "1");
	else if(cu_d == 2)
		stuffcmd(cu_client, "2");
	else if(cu_d == 3)
		stuffcmd(cu_client, "3");
	else if(cu_d == 4)
		stuffcmd(cu_client, "4");
	else if(cu_d == 5)
		stuffcmd(cu_client, "5");
	else if(cu_d == 6)
		stuffcmd(cu_client, "6");
	else if(cu_d == 7)
		stuffcmd(cu_client, "7");
	else if(cu_d == 8)
		stuffcmd(cu_client, "8");
	else if(cu_d == 9)
		stuffcmd(cu_client, "9");	
}

void cu_stuffcmd_int( entity cu_client, float cu_f, float cu_numdigits) =
{
	
	float cu_tmp;

	
	if(cu_f == 0)
	{
		stuffcmd( cu_client, "0");
		return;
	}

	if(cu_f < 0)
	{
		// Yeah sure.
		stuffcmd( cu_client, "-");
		cu_f = fabs(cu_f);
	}
	
	if(cu_numdigits <= 0)
	{
		cu_tmp = cu_f;
		cu_numdigits = 1;
		while(cu_tmp >= 1){
			cu_tmp = cu_tmp / 10;
			cu_numdigits = cu_numdigits * 10;
		}
	}
	
	//I don't know what I'm thinking here...
	//I need to do this to get zero-padding to work.

	while( cu_numdigits > 1 )
	{
		cu_numdigits = cu_numdigits / 10;
		cu_tmp = cu_f / cu_numdigits;
		cu_stuffcmd_digit( cu_client, cu_tmp);
	}
}

void cu_stuffcmd_float( entity cu_client, float cu_f) =
{
	float cu_intpart, cu_decpart, cu_isNegative;
	
	cu_isNegative = cu_FALSE;
	
	if(cu_f == 0)
	{
		stuffcmd( cu_client, "0");
		return;
	}
	
	if(cu_f < 0)
	{
		// easier this way
		cu_isNegative = cu_TRUE;
		cu_f = fabs(cu_f);
	}	
	
	// 1: stuff the integer part.
	cu_intpart = floor(cu_f);
	if(cu_isNegative) 
		stuffcmd( cu_client, "-");
	cu_stuffcmd_int( cu_client, cu_intpart, 0);
	
	// 2: stuff the decimal point.
	stuffcmd( cu_client, ".");
	
	// 3: stuff the decimal part.
	cu_decpart = cu_mod( cu_f, 1);
	cu_decpart = cu_decpart * 10000;
	cu_stuffcmd_int( cu_client, cu_decpart, 10000);
}




/*
===============
dprint_float stuff

bc i'm tired of ftos cutting off all the important digits
===============
*/
void cu_dprint_digit( float cu_f) =
{
	float cu_d;
	cu_d = floor(cu_f);
	cu_d = cu_mod(cu_d, 10);

	if(cu_d == 0)		dprint("0");
	else if(cu_d == 1)	dprint("1");
	else if(cu_d == 2)	dprint("2");
	else if(cu_d == 3)	dprint("3");
	else if(cu_d == 4)	dprint("4");
	else if(cu_d == 5)	dprint("5");
	else if(cu_d == 6)	dprint("6");
	else if(cu_d == 7)	dprint("7");
	else if(cu_d == 8)	dprint("8");
	else if(cu_d == 9)	dprint("9");	
}

void cu_dprint_int( float cu_f, float cu_numdigits) =
{
	float cu_tmp;
	
	if(cu_f == 0)
	{
		dprint("0");
		return;
	}

	if(cu_f < 0)
	{
		dprint("-");
		cu_f = fabs(cu_f);
	}
	
	if(cu_numdigits <= 0)
	{
		cu_tmp = cu_f;
		cu_numdigits = 1;
		while(cu_tmp >= 1){
			cu_tmp = cu_tmp / 10;
			cu_numdigits = cu_numdigits * 10;
		}
	}
	
	while( cu_numdigits > 1 )
	{
		cu_numdigits = cu_numdigits / 10;
		cu_tmp = cu_f / cu_numdigits;
		cu_dprint_digit( cu_tmp );
	}
}

void cu_dprint_float( float cu_f) =
{
	float cu_intpart, cu_decpart, cu_isNegative;
	
	cu_isNegative = cu_FALSE;
	
	if(cu_f == 0)
	{
		dprint( "0");
		return;
	}
	
	if(cu_f < 0)
	{
		// easier this way
		cu_isNegative = cu_TRUE;
		cu_f = fabs(cu_f);
	}	
	
	// 1: stuff the integer part.
	cu_intpart = floor(cu_f);
	if(cu_isNegative) 
		dprint( "-");
	cu_dprint_int( cu_intpart, 0);
	
	// 2: stuff the decimal point.
	dprint(".");
	
	// 3: stuff the decimal part.
	cu_decpart = cu_mod( cu_f, 1);
	cu_decpart = cu_decpart * 10000;
	cu_dprint_int(cu_decpart, 10000);
}

void cu_dprint_vector(vector cu_v) =
{
	dprint("( ");
	cu_dprint_float(cu_v_x);
	dprint(" ");
	cu_dprint_float(cu_v_y);
	dprint(" ");
	cu_dprint_float(cu_v_z);
	dprint(" )");
}
