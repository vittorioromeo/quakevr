	self.oldorigin = self.origin;
	self.cu_lifetime_finished = time + 3;
}
void()	cu_demon1_jump11	=[ 	$leap11,	cu_demon1_jump12	] {cu_nmfast();}
void()	cu_demon1_jump12	=[ 	$leap12,	cu_demon1_run1	] {cu_nmfast();cu_ai_face();}


void() cu_demon1_airthink =
{
	self.think = cu_demon1_airthink;
	self.nextthink = time + 0.1;
	
	// if three seconds pass, assume demon is stuck and jump again
	if (time >= self.cu_lifetime_finished)
	{
		cu_demon1_jump1();
		return;
	}
	// we aren't moving, assume leap is over so we don't get stuck with our arms up
	if (self.origin == self.oldorigin && self.flags & cu_FL_ONGROUND)
	{
		cu_demon1_jump11();
		return;
	}
	self.oldorigin = self.origin;
}

void()	cu_Demon_JumpTouchGround =
{
	// FL_ONGROUND: in contact with a horizontal surface (cos < 0.7) in any way, always set by SV_Phys after impact
	// if we're not touching anything horizontal it's not the ground so we don't care
	if (!(self.flags & cu_FL_ONGROUND)) return;
	
	self.touch = cu_SUB_Null;
	
	// checkbottom: false if any corners are more than a step's height above the surface beneath
	if (checkbottom(self))		// safely on ground
	{
		// we didn't even complete the leap animation, meaning we hit world right away
		if (time < self.cu_attack_finished)
		{
			cu_ai_attack_finished(1);	// so don't keep doing it
		}
		cu_demon1_jump11();
		return;
	}
	
	// jump randomly to not get hung up
	self.think = cu_demon1_jump1;
	self.nextthink = time + 0.1;
}

void()	cu_Demon_JumpTouch =
{
	local	float	cu_ldmg;

	if (self.health <= 0)
		return;
		
	if (other.takedamage)
	{
		if ( vlen(self.velocity) > 300 )
		{
			if (other.classname != "player" || time > self.cu_touch_time)	// fix for landing on the player's head
			{
				if (other.classname == "player")
				{
					self.cu_touch_time = time + 0.2;
				}
				cu_ldmg = 40 + 10 * random();
				cu_T_Damage(other, self, self, cu_ldmg);	// fiend leap counts as a ranged attack
				cu_ai_attack_finished(0);	// free to keep going ham
			}
		}
	}

	cu_Demon_JumpTouchGround();
}


void() cu_Demon_Jump =
{
	vector cu_leap;
	//self.origin_z += 1;
	if (!self.speed) self.speed = cu_DEMON_LEAP_VEL;
	makevectors (self.angles);
	//bprint3("leaping at ", ftos(self.height), "\n");
	cu_leap = cu_SinCos(self.height);
	self.velocity = v_forward * cu_leap_y;
	self.velocity_z = cu_leap_x;
	self.velocity *= self.speed;
	self.touch = cu_Demon_JumpTouch;
	self.flags = cu_not(self.flags, cu_FL_ONGROUND);
	self.height = 0;
}

//===========================================================================


/*
==============
Demon_JumpSweep

do a bunch of traces along the jump vector to ensure the takeoff path is clear, 
so we don't deflect off doorways and stairs and bounce around like an idiot
==============
*/
float(vector cu_attack, float cu_ang) cu_Demon_JumpSweep =
{
	vector cu_corner, cu_wmins, cu_dir, cu_arc, cu_hullsize;
	float cu_headfails, cu_stepfails;
	float cu_sweepdist = 160;
	
	//bprint3("  sweep-checking ", ftos(ang), " degrees:\n");
	
	cu_arc = cu_SinCos(cu_ang - 1);	// vert, horz
	cu_dir = cu_attack * cu_arc_y;
	cu_dir_z = cu_arc_x;
	cu_dir *= cu_sweepdist;

	// early out check first from origin
	traceline(self.origin, self.origin+cu_dir, cu_TRUE, self);
	if (trace_fraction < 1)
		return cu_FALSE;
	
	float x, y, z;
	cu_wmins = self.origin + self.mins + '0 0 0.1';	// just off the ground
	cu_hullsize = cu_VEC_HULL2_MAX - cu_VEC_HULL2_MIN;
	for (x=0; x<=1; x+=1) for (y=0; y<=1; y+=1) for (z=0; z<=1; z+=1)
	{
		// don't test the back corners
		//if (fabs(attack_x) > fabs(attack_y) && (attack_x > 0) != x) continue;
		//if (fabs(attack_y) > fabs(attack_x) && (attack_y > 0) != y) continue;
	
		// treat the bounding box as shambler height because the engine physics will
		cu_corner = cu_wmins + cu_vec_scale(cu_hullsize, cu_Vector(x, y, z));
		traceline(cu_corner, cu_corner+cu_dir, cu_TRUE, self);
		//bprint5("   - sweeping from ", vtos(corner), " to ", vtos(corner+dir), "\n");
		if (trace_fraction < 1 || trace_startsolid || trace_allsolid )
		{
			//bprint5("   - HIT at ", vtos(trace_endpos), " frac ", ftos(trace_fraction), "\n");
			//if (fabs(trace_plane_normal * normalize(dir)) < 0.2)	// player and fiend are both along a wall
			//	continue;
			if (z) cu_headfails++;
			else cu_stepfails++;
			//bprint5(vtos(self.origin), ": ", vtos(corner), " + ", vtos(dir));
			//bprint("\n");
		}
	}
	//bprint5("  headfails: ", ftos(headfails), " stepfails: ", ftos(stepfails), "\n");
	// both = blocked by something vertical like a pillar, or otherwise hopelessly blocked
	if (cu_headfails && cu_stepfails) return cu_FALSE;
	
	if (cu_headfails) return cu_DEMON_BLOCKED_HEAD;	// ceiling too low, should try to aim lower
	if (cu_stepfails) return cu_DEMON_BLOCKED_TOE;	// bottom blocked by a step or ledge, aim higher
	
	// head and toe both clear geo
	return cu_TRUE;
}


float(vector cu_attack) cu_CheckDemonJumpClearance =
{
	//vector dir;
	float cu_try, cu_last;
	cu_attack_z = 0;
	cu_attack = normalize(cu_attack);

	//bprint("checking clearance:\n");
	//self.speed = DEMON_LEAP_VEL;
	cu_try = cu_Demon_JumpSweep(cu_attack, self.height);
	cu_last = cu_try;
	while (cu_try < 0 && cu_try == cu_last)
	{
		if (cu_try == cu_DEMON_BLOCKED_HEAD && self.height >= 15)
		{
			//bprint("  - head blocked\n");
			self.speed += 25;
			self.height -= 10;
			cu_try = cu_Demon_JumpSweep(cu_attack, self.height);
		}
		else if (cu_try == cu_DEMON_BLOCKED_TOE && self.height <= 35)
		{
			//bprint("  - foot blocked\n");
			self.height += 10;
			self.speed -= 25;
			cu_try = cu_Demon_JumpSweep(cu_attack, self.height);
		}
		else break;
	}

	if (cu_try > 0)
	{
		//bprint3(" - cleared to leap at ", ftos(self.height), " degrees\n");
		//self.height = ang;
		return cu_TRUE;
	}
	self.height = 0;
	return cu_FALSE;
}


/*
==============
CheckDemonJump
==============
*/
float()	cu_CheckDemonJump =
{
	vector	cu_org, cu_dir, cu_tgt, angles;
	float	cu_d, cu_ang;

	if (!(self.flags & cu_FL_ONGROUND))
		return cu_FALSE;
	
	cu_dir = self.enemy.origin - self.origin;
	cu_dir_z = cu_max(0, cu_dir_z * 2);
	cu_d = vlen(cu_dir);
	if (cu_d < 120) {//bprint("too close\n");
	return cu_FALSE;}
	if (cu_d > 360 && random() < 0.9) {//bprint("too far-ish\n");
	return cu_FALSE;}
	//if (d > DEMON_LEAP_HVEL) {//bprint("too far\n");
	//return FALSE;}
	
	cu_org = self.origin;
	cu_tgt = self.enemy.origin;
	if (!(self.enemy.flags & (cu_FL_ONGROUND|cu_FL_FLY)))
	{
		// wait if enemy is leaping through the air, or we'll make one of those high
		// arcs that looks OP and stupid
		if (self.enemy.velocity_z > 0) return cu_FALSE;
		traceline(cu_tgt,cu_tgt-'0 0 96',cu_TRUE,self.enemy);
		if (trace_fraction == 1.0) return cu_FALSE;
		cu_tgt = (cu_tgt + trace_endpos) * 0.5;
	}
	
	if (self.enemy.origin_z < self.origin_z - 16)
	{
		// make sure our head can see their feet
		cu_org_z += self.maxs_z;
		cu_tgt_z += self.enemy.mins_z;
	}
	else if (self.enemy.origin_z > self.origin_z + 16)
	{
		// make sure our feet can see their head
		cu_org_z += self.mins_z;
		cu_tgt_z += self.enemy.maxs_z;
	}
	traceline(cu_org,cu_tgt,cu_TRUE,self);
	if (trace_fraction != 1.0){//bprint("not clear\n");
	return cu_FALSE;}	
	
	cu_org = self.origin;
	cu_d = cu_hdist(cu_tgt,cu_org);
	// old demon aimed at a point 25 degrees up, so skew that triangle such that
	// we aim at a point the same height above the target's head
	cu_tgt_z += cu_DEMON_LEAP_VVEL * (cu_d / cu_DEMON_LEAP_HVEL);
	
	cu_dir = normalize(cu_tgt - cu_org);	
	angles = vectoangles(cu_dir);
	cu_ang = angles_x;
	if (cu_ang > 90) cu_ang -= 360;
	
	if (cu_ang > 45 || cu_ang < -5 ){ //bprint("too steep\n");
	return cu_FALSE;}
	
	self.speed = cu_DEMON_LEAP_VEL;
	if (cu_ang < 8)
	{
		self.speed -= (8-cu_ang) * 15;	// super rough
		cu_ang = 16 - cu_ang;
	}
	self.height = cu_ang;
	//bprint3("leap decided: ", ftos(ang)," degrees\n");
	return cu_CheckDemonJumpClearance(cu_dir);
}


