void()	cu_demon1_atta1	= [ $attacka1,	cu_demon1_atta2	] {cu_nmfast(); cu_ai_charge(4);}
void()	cu_demon1_atta2	= [ $attacka2,	cu_demon1_atta3	] {cu_nmfast(); cu_ai_charge(0);}
