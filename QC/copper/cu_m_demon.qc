void()	cu_demon1_jump1	=[	$leap1,		cu_demon1_jump2	]
{
	cu_ai_face();
	if (!self.height) {
		// something's effed in the jump decisionmaking
		cu_demon1_run1();
		return;
	}
	cu_ai_attack_finished(0.5);
	sound (self, cu_CHAN_VOICE, "demon/djump.wav", 1, cu_ATTN_NORM);
	//bprint("  djump\n");
	cu_nmfast();
}
