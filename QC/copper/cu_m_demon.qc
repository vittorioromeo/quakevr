void()	cu_demon1_atta6	= [ $attacka6,	cu_demon1_atta7	] {cu_nmfast(); cu_ai_charge(1);}
void()	cu_demon1_atta7	= [ $attacka7,	cu_demon1_atta8	] {cu_nmfast(); cu_ai_charge(6);}
void()	cu_demon1_atta8	= [ $attacka8,	cu_demon1_atta9	] {cu_nmfast(); cu_ai_charge(8);}
void()	cu_demon1_atta9	= [ $attacka9,	cu_demon1_atta10	] {cu_nmfast(); cu_ai_charge(4);}
void()	cu_demon1_atta10	= [ $attacka10,	cu_demon1_atta11	] {cu_nmfast(); cu_ai_charge(2);}
void()	cu_demon1_atta11	= [ $attacka11,	cu_demon1_atta12	] {cu_nmfast(); cu_Demon_Melee(-200);}
void()	cu_demon1_atta12	= [ $attacka12,	cu_demon1_atta13	] {cu_nmfast(); cu_ai_charge(5);}
void()	cu_demon1_atta13	= [ $attacka13,	cu_demon1_atta14	] {cu_nmfast(); cu_ai_charge(8);}
void()	cu_demon1_atta14	= [ $attacka14,	cu_demon1_atta15	] {cu_nmfast(); cu_ai_charge(4);}
void()	cu_demon1_atta15	= [ $attacka15,	cu_demon1_run1		] {cu_nmfast(); cu_ai_charge(4);
	cu_enemy_range = cu_range(self.enemy);
	if (cu_CheckDemonMelee()) self.think = cu_demon1_atta1;	// skip the one flash of run1, it makes the feet jump
}

/*
==============
CheckDemonMelee

Returns TRUE if a melee attack would hit right now
==============
*/
float()	cu_CheckDemonMelee =
{
	if ( !cu_alive(self.enemy)	||						// is dead
		cu_enemy_range > cu_RANGE_MELEE ||			// can't reach
		!cu_z_overlap(self.enemy) ||				// too high or low
		!cu_CanDamage(self.enemy, self.origin) ) 	// can't hit
		return cu_FALSE;
	return cu_TRUE;
}

void(float cu_side)	cu_Demon_Melee =
{
	local	float	cu_ldmg;
	local vector	cu_delta;
	
	cu_ai_face ();
	walkmove (self.ideal_yaw, 12);	// allow a little closing

	cu_delta = self.enemy.origin - self.origin;

	if (vlen(cu_delta) > 100)
		return;
	if (!cu_CanDamage (self.enemy, self.origin))
		return;
		
    sound (self, cu_CHAN_WEAPON, "demon/dhit2.wav", 1, cu_ATTN_NORM);
	cu_ldmg = 10 + 5*random();
	cu_T_Damage (self.enemy, self, self, cu_ldmg, cu_DMGTYPE_MELEE);	

	makevectors (self.angles);
	cu_SpawnMeatSpray (self.origin + v_forward*16, cu_side * v_right);
}

//===========================================================================

float()	cu_DemonCheckAttack =
{
	if (time < self.cu_attack_finished) return cu_FALSE;

	if (!cu_CheckClearAttack())
		return cu_FALSE;
	
	// if close enough for slashing, go for it
	if (cu_CheckDemonMelee())
	{
		self.cu_attack_state = cu_AS_MELEE;
		return cu_TRUE;
	}
	
	if (cu_CheckDemonJump())
	{
		self.cu_attack_state = cu_AS_MISSILE;
		return cu_TRUE;
	}
	
	// keep the stored jump decisions cleared
	self.speed = cu_DEMON_LEAP_VEL;
	self.height = 0;
	return cu_FALSE;
}




void() cu_monster_demon_spawn =
{
	self.classname = "monster_demon1";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/demon.mdl");

	//setsize (self, VEC_HULL2_MIN, VEC_HULL2_MAX);
	setsize (self, cu_VEC_HULL2_MIN, '32 32 40');
	self.health = 300;
	
	self.yaw_speed = 30;
	self.cu_customflags |= cu_CFL_MELEEONLY;

	self.cu_th_stand = cu_demon1_stand1;
	self.cu_th_walk = cu_demon1_walk1;
	self.cu_th_run = cu_demon1_run1;
	self.cu_th_die = cu_demon_die;
	self.cu_th_melee = cu_demon1_atta1;
	self.cu_th_missile = cu_demon1_jump1;
	self.cu_th_pain = cu_demon1_pain;
	self.cu_th_checkattack = cu_DemonCheckAttack;
	
	if (self.deathtype == cu_string_null)
		self.deathtype = "was eviscerated by a Fiend";

	cu_walkmonster_start();
}

void() cu_monster_demon_spawner = {cu_mon_spawner_use(cu_monster_demon_spawn);}

/*cu:QUAKED monster_demon1 (1 0 0) (-32 -32 -24) (32 32 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Fiend (Demon), 300 health points.

Flags:
"ambush"	only wake up on seeing the player, not another monster getting angry
"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-32 -32 -24, 32 32 64) model({ "path": ":progs/demon.mdl" }) = monster_demon1 : "Fiend" []
*/
void() cu_monster_demon1 =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model ("progs/demon.mdl");
	precache_model ("progs/h_demon.mdl");

	precache_sound ("demon/ddeath.wav");
	precache_sound ("demon/dhit2.wav");
	precache_sound ("demon/djump.wav");
	precache_sound ("demon/dpain1.wav");
	precache_sound ("demon/idle1.wav");
	precache_sound ("demon/sight2.wav");
	precache_sound ("misc/null.wav");

	self.health = 300;
	setsize (self, cu_VEC_HULL2_MIN, '32 32 40');
	if ( cu_monster_spawnsetup( cu_monster_demon_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_demon_spawn();
}
