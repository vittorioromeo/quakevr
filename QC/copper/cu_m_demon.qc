void(entity cu_attacker, float cu_damage)	cu_demon1_pain =
{
	if (self.touch == cu_Demon_JumpTouch)
	{
		return;
	}

	if (self.cu_pain_finished > time)
		return;

	if (random()*200 > cu_damage)
		return;		// didn't flinch
		
	cu_PainFinished(1);
    sound (self, cu_CHAN_VOICE, "demon/dpain1.wav", 1, cu_ATTN_NORM);
	cu_demon1_pain1 ();
}

