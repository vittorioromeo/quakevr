// ai_run already concluded we can't leap, but make sure we can't just run up some stairs
float() cu_DemonCheckCharge =
{
	// this is never called now, bc it seemed to supercede the leap on subsequent frames 
	// too often and isn't worth sorting out the overlapping timers/states causing that
	
	if (!cu_enemy_vis)
		return cu_FALSE;
	if (time < self.cu_attack_finished)
		return cu_FALSE;
		
	vector cu_edir = self.origin - self.enemy.origin;
	if ( fabs(cu_edir_z) > vlen(cu_edir) / 2)
		return cu_FALSE;		// too much height change
	
	if ( cu_range(self.enemy) == cu_RANGE_MELEE )
		return cu_FALSE;		// defer to regular attack

	// charge		
	cu_ai_attack_finished (0.5);
	cu_demon1_charge1 ();
	return cu_TRUE;
}

