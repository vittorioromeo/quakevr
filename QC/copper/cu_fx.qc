//============================================================================

//	bubbas
void() cu_bubble_split =
{
	if (pointcontents(self.origin + '0 0 8') != self.watertype)
		return;
		
	entity	cu_bubble;
	cu_bubble = cu_bubble_spawn(self.origin);
	cu_bubble.frame = 1;
	cu_bubble.cu_cnt = floor(9 + random()*4);
	cu_bubble.velocity = self.velocity + '0 0 2';
	self.frame = 1;
	self.cu_cnt = 10;
}

void() cu_bubble_remove =
{
	remove(self);
}

void() cu_bubble_bob =
{
	float		cu_rnd1, cu_rnd2, cu_rnd3;

	if (pointcontents(self.origin + '0 0 8') != self.watertype)
	{
		cu_SUB_Remove();
		return;
	}
	
	if (random() < 0.65)
		self.cu_cnt = self.cu_cnt + 1;
		
	if (self.cu_cnt >= 18)
		remove(self);
	if (self.cu_cnt == 8)
		cu_bubble_split();

	cu_rnd1 = self.velocity_x + cu_crandom() * 20;
	cu_rnd2 = self.velocity_y + cu_crandom() * 20;
	cu_rnd3 = self.velocity_z + cu_crandom() * 15;

	if (cu_rnd1 > 10)
		cu_rnd1 = 5;
	if (cu_rnd1 < -10)
		cu_rnd1 = -5;
		
	if (cu_rnd2 > 10)
		cu_rnd2 = 5;
	if (cu_rnd2 < -10)
		cu_rnd2 = -5;
		
	if (cu_rnd3 < 20)
		cu_rnd3 = 25;
	if (cu_rnd3 > 40)
		cu_rnd3 = 35;
	
	self.velocity_x = cu_rnd1;
	self.velocity_y = cu_rnd2;
	self.velocity_z = cu_rnd3;
		
	self.nextthink = time + 0.25;
	self.think = cu_bubble_bob;
}

entity(vector cu_org) cu_bubble_spawn =
{
	entity	cu_bubble;

	cu_bubble = spawn();
	cu_bubble.watertype = pointcontents(cu_org);
	setmodel (cu_bubble, "progs/s_bubble.spr");
	setorigin (cu_bubble, cu_org);
	cu_bubble.movetype = cu_MOVETYPE_NOCLIP;
	cu_bubble.solid = cu_SOLID_NOT;
	setsize (cu_bubble, '-8 -8 -8', '8 8 8');
	cu_bubble.velocity = '0 0 18';
	//bubble.alpha = 0.5;
	
	cu_bubble.nextthink = time + 0.25;
	cu_bubble.think = cu_bubble_bob;
	cu_bubble.touch = cu_SUB_RemoveSoon;
	cu_bubble.classname = "bubble";
	if (random() < 0.2)
	{
		cu_bubble.frame = 1;
		cu_bubble.cu_cnt = 11;
	}
	else
	{
		cu_bubble.frame = 0;
		cu_bubble.cu_cnt = 0;
	}
	return cu_bubble;
}

//============================================================================

// back compat named function, mostly for sock maps
void() cu_make_bubbles =
{
	cu_bubble_spawn(self.origin);
	self.nextthink = time + random() + 0.5;
	self.think = cu_make_bubbles;
};


void() cu_air_bubbles_make =
{
	vector cu_org;
	cu_org = self.origin;
	if (self.size != cu_VEC_ORIGIN)
		cu_org += cu_Vector(random() * self.size_x, random() * self.size_y, random() * self.size_z) - self.size * 0.5;
		
	cu_bubble_spawn(cu_org);
}

void() cu_air_bubbles_think =
{
	if (!self.state)
		return;
	
	if (!self.wait && !self.cu_rand)
	{
		// fix for 1000cuts using info_nulls with this as a think instead of just
		// placing an air_bubbles, skipping the init and causing every one of the
		// dozens of them to vomit bubbles per frame until the edict limit is hit
		// and the game crashes:
		self.wait = cu_zeroconvertdefault(self.wait, 1);
		self.cu_rand = cu_zeroconvertdefault(self.cu_rand, 1);
	}
	
	if (!cu_particlefield_should_sleep())
	{
		cu_air_bubbles_make();
	}
	self.nextthink = time + random() * self.cu_rand + self.wait;
	self.think = cu_air_bubbles_think;
}

void() cu_air_bubbles_use =
{
	if (self.spawnflags & 8)
	{
		if (cu_particlefield_should_sleep())
			return;
		
		for (float cu_i = 0; cu_i < self.count; cu_i++)
		{
			cu_air_bubbles_make();
		}
		return;
	}
	self.state = !(self.state);
	if (self.state)
	{
		self.think = cu_air_bubbles_think;
		self.nextthink = time + random() * self.cu_rand + self.wait;
	}
}

/*cu:QUAKED air_bubbles (0 .5 .8) (-8 -8 -8) (8 8 8) START_OFF ? ? BURST
air bubble emitter. always bubbles. trigger to toggle on or off. check BURST to make a one-time triggerable bubbler.

"wait" bubble interval, default 1
"rand" random extra interval, default 1
"size" size of random bubble emission zone, default '0 0 0'
"count" bubbles to emit at once if single burst
"distance" don't emit bubbles if no players are closer than this distance, default 1024
*/
/*FGD
@PointClass base(Appearflags, Targetname) color(0 150 220) = air_bubbles : "Air bubble emitter." 
[
	spawnflags(flags) = [
		1 : "Start off" : 0
		8 : "Single burst when triggered" : 0
	]
	wait(string) : "Bubble interval" : "1"
	rand(string) : "Random extra interval" : "1"
	size(string) : "Emit from random places within a box of this size" : "0 0 0"
	count(integer) : "Bubbles to emit at once if single burst" : 1
	distance(integer) : "Sleep if all players are further than this distance"
]
*/
void() cu_air_bubbles =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (deathmatch)
	{
		remove (self);
		return;
	}
	precache_model ("progs/s_bubble.spr");
	self.wait = cu_zeroconvertdefault(self.wait, 1);
	self.cu_rand = cu_zeroconvertdefault(self.cu_rand, 1);
	
	self.think = cu_air_bubbles_think;
	if (self.targetname == cu_string_null && (self.spawnflags & 1))
	{
		cu_dprint3("\bwarning:\b air_bubbles at ", vtos(self.origin), " with start_off and no targetname\n");
	}
	if (self.targetname != cu_string_null)
	{
		self.use = cu_air_bubbles_use;
		self.state = !(self.spawnflags & 1);
		if (!self.state)
			return;
	}
	else
		self.state = 1;

	if (self.spawnflags & 8)
		return;
	self.nextthink = time + self.wait;
}


// ==============================================================

void() cu_target_debris_use =
{
	float cu_i, cu_tries, cu_spd;
	entity cu_chunk;
	vector cu_org, cu_dir;
	
	if (self.noise != cu_string_null)
		sound (self, cu_CHAN_VOICE, self.noise, self.volume, self.distance);

	for (cu_i = 0; cu_i < self.count; cu_i++)
	{
		// keep debris out of the void
		while (cu_tries < 32)
		{
			cu_org_x = (random()-0.5) * self.size_x + self.origin_x;
			cu_org_y = (random()-0.5) * self.size_y + self.origin_y;
			cu_org_z = (random()-0.5) * self.size_z + self.origin_z;
			
			if (pointcontents(cu_org) == cu_CONTENT_SOLID)
			{
				cu_tries += 1;
				if (cu_tries == 32) return;
				continue;
			}
			break;
		}

		cu_dir_x = cu_crandom() + self.mangle_x * 2;
		cu_dir_y = cu_crandom() + self.mangle_y * 2;
		cu_dir_z = cu_crandom() + self.mangle_z * 2;
		
		cu_spd = self.speed * (0.8 + 0.4 * random());
		
		cu_chunk = cu_toss_projectile(cu_org, normalize(cu_dir) * cu_spd, "debris");
		cu_chunk.cu_type = "debris";
		cu_chunk.solid = cu_SOLID_NOT;
		
		// loop through 3 models if we have 3, alternate 2 if we 
		// have 2, or always use the only one if we have 1
		if (self.cu_cnt == 3 && cu_i % self.cu_cnt == 2)
			setmodel(cu_chunk, self.cu_model3);
		else if (self.cu_cnt >= 2 && cu_i % self.cu_cnt == 1)
			setmodel(cu_chunk, self.cu_model2);
		else if (cu_i % self.cu_cnt == 0)
			setmodel(cu_chunk, self.model);
		
		setsize(cu_chunk, cu_VEC_ORIGIN, cu_VEC_ORIGIN);
		
		cu_chunk.frame = self.frame;
		cu_chunk.alpha = self.alpha;
		cu_chunk.skin = self.skin;
		cu_chunk.avelocity = cu_Vector(random(),random(),random()) * 400;
		cu_chunk.angles = cu_Vector(random(),random(),random()) * 120;

		cu_chunk.cu_lifetime_finished = time + 6 + random() * 6;
	}
}

/*cu:QUAKED target_debris (0.5 0.5 0.5) (-8 -8 -8) (8 8 8)
emitter of chunks of debris

Keys
"count" number of chunks to emit, default 3
"delay" time to wait before first emit
"speed" speed of chunks
"mangle" override chunk direction, defaults to omni
"size" random location of chunks within bounds of this size

"model"	specify a different model for debris (use "model2" and "model3" for variety)
"frame"	will be copied to spawned chunks
"skin"	will be copied to spawned chunks
"alpha"	will be copied to spawned chunks
*/
/*FGD
@PointClass base(Appearflags, Targetname) size(16 16 16) color(180 180 180) = target_debris : "Emits debris chunks"
[
	count(integer) : "Number of chunks" : 3
	delay(string) : "Delay before first emit" : "0"
	size(string) : "Random location within bounds" : "0 0 0"
	speed(integer) : "Speed of chunks" : 128
	mangle(string) : "Specify chunk direction" : "0 0 0"
	frame(integer) : "Set frame on all debris" : 0
	skin(choices) : "Set skin on all debris" =
	[
		0 : "Wizbrick brown"
		1 : "Plaster brown"
		2 : "Runic grey"
		3 : "Rusty metal"
		4 : "Gloom red"
		5 : "Swampy green"
		6 : "Elder blue"
		7 : "Hottt"
	]
	alpha(string) : "Set alpha on all debris" : "1"
	model(string) : "Choose a model for debris" : ""
	model2(string) : "Choose a second model for debris" : ""
	model3(string) : "Choose a third model for debris" : ""
	noise(string) : "Play a sound when triggered" : ""
]
*/
void() cu_target_debris =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.speed = cu_zeroconvertdefault(self.speed, 128);
	self.count = cu_zeroconvertdefault(self.count, 3);
	self.use = cu_target_debris_use;
	
	self.volume = cu_zeroconvertdefault_saturate(self.volume, 1);
		
	if (!self.distance)
		self.distance = 1;
		
	if (self.mangle != cu_VEC_ORIGIN)
	{
		if (cu_is_angular(self.mangle))
		{
			makevectors(self.mangle);
			self.mangle = v_forward;
		}
		else
			self.mangle = normalize(self.mangle);
	}
	
	if (self.noise != cu_string_null)
		precache_sound(self.noise);

	if (self.model != cu_string_null)
	{
		precache_model(self.model);
		self.cu_cnt = 1;
		if (self.cu_model2 != cu_string_null)
		{
			precache_model(self.cu_model2);
			self.cu_cnt = 2;
			if (self.cu_model3 != cu_string_null)
			{
				precache_model(self.cu_model3);
				self.cu_cnt = 3;
			}
		}
	}
	else
	{
		self.cu_cnt = 3;
		self.model = VR_ModelOr("progs/debris1.mdl", "progs/vr_rock1.mdl");
		self.cu_model2 = VR_ModelOr("progs/debris2.mdl", "progs/vr_rock1.mdl");
		self.cu_model3 = VR_ModelOr("progs/debris3.mdl", "progs/vr_rock1.mdl");
		
		precache_model(VR_ModelOr("progs/debris1.mdl", "progs/vr_rock1.mdl"));
		precache_model(VR_ModelOr("progs/debris2.mdl", "progs/vr_rock1.mdl"));
		precache_model(VR_ModelOr("progs/debris3.mdl", "progs/vr_rock1.mdl"));
	}
}

// ==============================================================

/*
- target_fade
	- sets alpha on entities, or style on lights
	- over time or distance from activator
	- min/max alpha, min/max distance
	- exclude axes
	- alt target: fade target, 2 on start, 3 on finish, 4 on return
*/

#define cu_ALPHA_START health
#define cu_ALPHA_END max_health
#define cu_TIME_START cu_healthtime
#define cu_TIME_END cu_pain_finished

// targetname scanning 20 times a frame is a little rude, so we check for
// targets up front and remember them
void(entity cu_e) cu_target_fade_add =
{
	entity cu_fader;
	if (self.enemy)
	{
		// if this fader targets more than one entity, we need to list them somehow.
		// the quakeC way is a linked list, but multiple target_fades could affect the 
		// same entity, and even with our own .entity field this would clash. we have
		// to create a chain of dummy entities that just serve to keep the ref instead.
		cu_fader = spawn();
		cu_fader.classname = "fader";
		cu_fader.enemy = cu_e;
		cu_fader.chain = self.chain;
		self.chain = cu_fader;
	}
	else
	{
		self.enemy = cu_e;
	}
}

void() cu_target_fade_find =
{
	if (self.enemy) return;
	
	entity cu_tf = world;
	if (self.target != cu_string_null) do {
		cu_tf = find(cu_tf, targetname, self.target);
		if (!cu_tf) break;
		cu_target_fade_add(cu_tf);
	} while (1);

	if (!(self.spawnflags & cu_SPAWN_ALT_TARG))
	{
		if (self.cu_target2 != cu_string_null) do {
			cu_tf = find(cu_tf, targetname, self.cu_target2);
			if (!cu_tf) break;
			cu_target_fade_add(cu_tf);
		} while (1);
		if (self.cu_target3 != cu_string_null) do {
			cu_tf = find(cu_tf, targetname, self.cu_target3);
			if (!cu_tf) break;
			cu_target_fade_add(cu_tf);
		} while (1);
		if (self.cu_target4 != cu_string_null) do {
			cu_tf = find(cu_tf, targetname, self.cu_target4);
			if (!cu_tf) break;
			cu_target_fade_add(cu_tf);
		} while (1);
	}
}

void() cu_target_fade_cleanup =
{
	entity cu_t = self.chain;
	entity cu_ot;
	while (cu_t)
	{
		cu_ot = cu_t;
		cu_t = cu_t.chain;
		remove(cu_ot);
	}
	self.enemy = world;
	self.chain = world;
}

void(float cu_f) cu_target_fade_set =
{
	self.cu_strength = cu_f;
	if (!self.enemy) return;
	if (cu_f == 0) cu_f = -1;
	entity cu_t = self;
	entity cu_e;
	while (cu_t)
	{
		cu_e = cu_t.enemy;		
		cu_e.alpha = cu_f;
		if ((cu_e.style || cu_e.cu_switchshadstyle))
		{
			if (cu_e.cu_alpha2)
				cu_bmodel_lightstyle(cu_e, cu_zeroconvert(cu_e.cu_alpha2));
			else if (cu_e.style)
				lightstyle(cu_e.style, cu_light_str(cu_f));
		}	
		cu_t = cu_t.chain;
	}
	
	if (self.style)
		lightstyle(self.style, cu_light_str(cu_f));
}

void(float cu_a_from, float cu_a_to, float cu_f) cu_target_fade_lerp =
{
	float cu_blend;
	
	if (cu_f >= 1)
		cu_blend = cu_a_to;
	else if (cu_f <= 0)
		cu_blend = cu_a_from;
	else
		cu_blend = cu_lerp(cu_a_from, cu_a_to, cu_f);
	
	cu_target_fade_set(cu_blend);
}

// fade over time stuff ===========

void() cu_target_fade_think =
{
	float cu_f, cu_n, cu_d;
	cu_n = time - self.cu_TIME_START;
	cu_d = self.cu_TIME_END - self.cu_TIME_START;
	if (cu_d == 0)
		cu_f = 1;
	else
		cu_f = cu_n / cu_d;
	cu_target_fade_lerp(self.cu_ALPHA_START, self.cu_ALPHA_END, cu_f);
	
	if (cu_f >= 1)
		self.cu_think1();
	else
		self.nextthink = time + 0.05;
}

void(float cu_a, float cu_tlen, void() cu_endfn) cu_target_fade_to =
{
	self.cu_ALPHA_START = self.cu_strength;
	self.cu_ALPHA_END = cu_a;
	self.cu_TIME_START = time;
	self.cu_TIME_END = time + cu_tlen;
	
	self.think = cu_target_fade_think;
	self.nextthink = time;
	self.cu_think1 = cu_endfn;
}

void() cu_target_fade_time_done =
{
	if (self.state)
	{
		if (self.noise2 != cu_string_null)
			sound (self, cu_CHAN_VOICE, self.noise2, self.volume, cu_ATTN_NORM);
	}
	else
	{
		if (self.noise4 != cu_string_null)
			sound (self, cu_CHAN_VOICE, self.noise4, self.volume, cu_ATTN_NORM);
	}
	self.nextthink = time + 1;
	self.think = cu_target_fade_cleanup;
}

void() cu_target_fade_time =
{
	if (time < self.cu_attack_finished) return;
	
	cu_target_fade_find();
	
	if (self.spawnflags & 1)
	{
		self.state = 1;
		cu_target_fade_set(self.alpha);
	}
	else
		self.state = 1 - self.state;
	
	if (self.state)
	{
		if (self.noise != cu_string_null)
			sound(self, cu_CHAN_VOICE, self.noise, self.volume, cu_ATTN_NORM);

		cu_target_fade_to(self.cu_alpha2, self.delay + self.speed, cu_target_fade_time_done);
		self.cu_attack_finished = time + self.delay + self.speed;
	}
	else
	{
		if (self.noise3 != cu_string_null)
			sound(self, cu_CHAN_VOICE, self.noise3, self.volume, cu_ATTN_NORM);

		cu_target_fade_to(self.alpha, self.delay + self.speed2, cu_target_fade_time_done);
		self.cu_attack_finished = time + self.delay + self.speed2;
	}
		
	if (self.delay > 0)
	{
		self.cu_TIME_START = time + self.delay;
		self.nextthink = self.cu_TIME_START;
	}
}

// fade over distance stuff ===========

void() cu_target_fade_dist_done =
{
	self.nextthink = time + 1;
	self.think = cu_target_fade_cleanup;
}

void() cu_target_fade_dist =
{
	if (time < self.cu_attack_finished)
		return;
	
	//dprint("in target_fade_dist\n");
	self.cu_attack_finished = time + self.speed;
	
	cu_target_fade_find();
	
	float cu_dist, cu_f;
	vector cu_dir;
	
	cu_dir = cu_vec_scale(cu_SUB_PlayerizeActivator().origin - self.origin, self.dest);

	if (self.movedir)
	{
		cu_dist = cu_dir * self.movedir;
		if (self.spawnflags & 1)
			cu_dist = cu_max(0,cu_dist);
		else
			cu_dist = fabs(cu_dist);
	}
	else
		cu_dist = vlen(cu_dir);
	
	// state 0: outside
	// state 1: entered transition
	// state 2: entered center
	// state 3: re-entered transition (transition after center)
	// state 0: outside again
	cu_f = (cu_dist - self.lip) / self.distance;
	if (cu_f > 1)	// outside
	{
		cu_f = 1;
		if (self.state == 3 || self.state == 1)
		{
			self.state = 0;
			if (self.noise4 != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise4, self.volume, cu_ATTN_NORM);
			cu_SUB_UseTargetsAlt(cu_target4);
		}
	}
	else if (cu_f < 0)	// center
	{
		cu_f = 0;
		if (self.state == 1)
		{
			self.state = 2;
			if (self.noise2 != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise2, self.volume, cu_ATTN_NORM);
			cu_SUB_UseTargetsAlt(cu_target3);
		}
	}
	else	// transition
	{
		if (self.state == 0)
		{
			self.state = 1;
			if (self.noise != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise, self.volume, cu_ATTN_NORM);
			cu_SUB_UseTargetsAlt(cu_target2);
		}
		else if (self.state == 2)
		{
			self.state = 3;
			if (self.noise3 != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise3, self.volume, cu_ATTN_NORM);
		}

	}
	cu_f = cu_lerp(self.alpha, self.cu_alpha2, 1 - cu_f);
	
	cu_target_fade_to(cu_f, self.speed, cu_target_fade_dist_done);
}

// hold fade stuff ===========

void() cu_target_fade_hold_bottom =
{
	self.state = cu_STATE_BOTTOM;
	if (self.noise4 != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise4, self.volume, cu_ATTN_NORM);
	cu_SUB_UseTargetsAlt(cu_target4);
	self.think = cu_target_fade_cleanup;
	self.nextthink = time + 1;
}

void() cu_target_fade_down =
{
	self.state = cu_STATE_DOWN;
	cu_target_fade_to(self.alpha, self.speed2, cu_target_fade_hold_bottom);
}

void() cu_target_fade_hold_top =
{
	self.state = cu_STATE_TOP;
	if (self.noise2 != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise2, self.volume, cu_ATTN_NORM);
	cu_SUB_UseTargetsAlt(cu_target3);
	
	self.nextthink = time + self.wait;
	self.think = cu_target_fade_down;
}

void() cu_target_fade_hold =
{
	float cu_t;
	//dprint("target_fade_hold?\n");
	if (self.state == cu_STATE_BOTTOM)
	{
		//dprint("   tfh bottom\n");
		cu_target_fade_find();
		self.state = cu_STATE_UP;
		if (self.noise != cu_string_null) sound (self, cu_CHAN_VOICE, self.noise, self.volume, cu_ATTN_NORM);
		cu_target_fade_to(self.cu_alpha2, self.speed, cu_target_fade_hold_top);
		cu_SUB_UseTargetsAlt(cu_target2);
	}
	else if (self.state == cu_STATE_TOP)
	{
		//dprint("   tfh top\n");
		self.nextthink = time + self.wait;
	}
	else if (self.state == cu_STATE_DOWN)
	{
		//dprint("   tfh down\n");
		self.state = cu_STATE_UP;
		cu_t = (self.cu_TIME_END - time) / self.speed2;
		cu_target_fade_to(self.cu_alpha2, cu_t * self.speed, cu_target_fade_hold_top);
	}
	else if (self.state == cu_STATE_UP)
	{
		//dprint("   tfh up, noop\n");
	}
}

void() cu_target_fade_init =
{
	cu_target_fade_find();
	if (!self.enemy)
	{
		dprint("\bERROR:\b target_fade has no targets\n");
		remove(self);
		return;
	}
	cu_target_fade_set(self.alpha);
	self.think = cu_target_fade_cleanup;
	self.nextthink = time + 1;
}

/*cu:QUAKED target_fade (.5 .5 .2) (-8 -8 -8) (8 8 8) ONE_WAY REVERSE BY_DISTANCE HOLD
Changes the alpha of its targets over time from 'alpha' to 'alpha2'. Triggering again will fade it back, unless ONE_WAY is set.
Set REVERSE to swap the values.

If this targets brushmodels with switchable shadows or lightstyles, the lighting will fade appropriately.

"alpha"		starting translucency. -1 for clear
"alpha2"	ending translucency. -1 for clear
"delay"		pause before beginning to blend
"speed"		time to spend blending, -1 for instant.
"speed2"	time to spend blending back, if different than "speed". -1 for instant.
"style"		fade this lightstyle directly
"noise"		sound to play on begin fade
"noise2"	sound to play on end fade
"noise3"	sound to play on begin reverse fade
"noise4"	sound to play on end reverse fade
"volume"	volume for sounds (default 1.0)

If BY_DISTANCE is checked, it will set alpha immediately based on how far the activator is from its origin. 
"distance"	max distance beyond which alpha will be set to 'alpha'
"lip"		min distance within which alpha will be set to 'alpha2'
"angle/angles"	constrain distance measurement to this axis (like a fogblend)
ONE_WAY in distance mode constrains motion along 'angle' to the positive direction, instead of symmetrically.
"dest"		alternate distance constraint (scale position by these three values)

If HOLD is checked, it will exhibit door-like behavior when triggered: triggering multiple times while fading is ignored, triggering while faded extends the wait, and triggering while fading back starts fading out again. If not triggered when faded out, it will wait for 'wait' seconds until returning.

Alt Target Pattern: in distance mode, target is fading object, target2 on begin fade (enter distance range), target3 on complete fade (enter lip range), target4 on exit distance range
*/
/*FGD
@PointClass base(Appearflags, Targetname, Target, AltTarget) color(128 128 50) = target_fade : 
"Target: Fade
Changes the alpha of its targets over time from 'alpha' to 'alpha2'.
If this targets brushmodels with switchable shadows or lightstyles, the lighting will fade appropriately.
If 'Blend By Distance' is set, it will set alpha immediately based on how far the activator is from its origin.
'One Way' in distance mode constrains motion along 'angle' to the positive direction, instead of symmetrically.
If 'Hold Blend' is checked, it will exhibit door-like behavior when triggered: triggering multiple times while fading is ignored, triggering while faded extends the wait, and triggering while fading back starts fading out again. If not triggered when faded out, it will wait for 'wait' seconds until returning.

Alt Target Pattern: in distance mode, target is fading object, target2 on begin fade (enter distance range), target3 on complete fade (enter lip range), target4 on exit distance range" 
[
	spawnflags(flags) = [
		1 : "One Way" : 0
		2 : "Reverse alpha/alpha2" : 0
		4 : "Blend By Distance" : 0
		8 : "Hold Blend" : 0
	]
	delay(string) : "Pause before starting blend"
	alpha(string) : "Start alpha" : "1.0"
	alpha2(string) : "End alpha" : "0.0"
	speed(string) : "Time to blend (-1 for instant)"
	speed2(string) : "Time to blend back, if different (-1 for instant)"
	distance(integer) : "Max distance for 'alpha'"
	lip(integer) : "Min distance for 'alpha2'"
	angle(integer) : "Constrain distance to this axis"
	noise(string) : "Sound to play on begin fade"
	noise2(string) : "Sound to play on end fade"
	noise3(string) : "Sound to play on begin reverse fade"
	noise4(string) : "Sound to play on end reverse fade"
]
*/
void() cu_target_fade =
{
	if (!cu_SUB_ShouldSpawn()) return;

	self.state = 0;
	
	self.alpha = cu_zeroconvertdefault(self.alpha, 1);
	self.cu_alpha2 = cu_zeroconvert(self.cu_alpha2);
	
	self.volume = cu_zeroconvertdefault_saturate(self.volume, 1);

	if (self.noise != cu_string_null) precache_sound(self.noise);
	if (self.noise2 != cu_string_null) precache_sound(self.noise2);
	if (self.noise3 != cu_string_null) precache_sound(self.noise3);
	if (self.noise4 != cu_string_null) precache_sound(self.noise4);
	
	float cu_ta;
	if (self.spawnflags & 2)
	{
		cu_ta = self.alpha;
		self.alpha = self.cu_alpha2;
		self.cu_alpha2 = cu_ta;
		self.spawnflags -= 2;
	}

	if ((self.spawnflags & 4) && self.distance > 0)
	{
		self.speed = cu_zeroconvertdefault(self.speed, 0.2);
		if (!self.dest) self.dest = '1 1 1';
		self.use = cu_target_fade_dist;
		self.distance -= self.lip;
		if (self.angles)
			cu_SetMovedir();
	}
	else
	{
		self.speed = cu_zeroconvertdefault(self.speed, 1);
		self.speed2 = cu_zeroconvertdefault(self.speed2, self.speed);
		
		if (self.spawnflags & 8)
		{
			self.use = cu_target_fade_hold;
			self.state = cu_STATE_BOTTOM;
			self.wait = cu_zeroconvertdefault(self.wait, 3);
		}
		else
			self.use = cu_target_fade_time;
	}
	self.think = cu_target_fade_init;
	self.nextthink = time + 0.2;
}

#undef cu_ALPHA_START
#undef cu_ALPHA_END
#undef cu_TIME_START
#undef cu_TIME_END
