void() cu_target_telefog_use =
{
	float cu_i, cu_tnext;
	entity cu_tfog;
	vector cu_offset;
	
	cu_playercount_convert(count);
	if (self.count == 1 && self.delay == 0 && self.cu_rand == 0)
	{
		cu_tfog = spawn();
		if (self.size != cu_VEC_ORIGIN)
			cu_offset = cu_Vector(random() * self.size_x, random() * self.size_y, random() * self.size_z) - self.size * 0.5;
		setorigin(cu_tfog, self.origin + cu_offset);
		cu_tfog.think = cu_teleport_flasher;
		cu_tfog.nextthink = time;
		return;
	}
	
	cu_tnext = self.delay + self.cu_rand * random();
	for (cu_i = 0; cu_i < self.count; cu_i++)
	{
		cu_tfog = spawn();
		if (self.size != cu_VEC_ORIGIN)
			cu_offset = cu_Vector(random() * self.size_x, random() * self.size_y, random() * self.size_z) - self.size * 0.5;
		setorigin(cu_tfog, self.origin + cu_offset);
		cu_tfog.think = cu_teleport_flasher;
		cu_tfog.nextthink = time + cu_tnext;
		cu_tnext += self.wait + self.cu_rand * random();
	}
}

