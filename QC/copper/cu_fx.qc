float cu_PFIELD_START_ON = 1; 
float cu_PFIELD_INWARD = 2; 
float cu_PFIELD_OUTWARD = 4; 
float cu_PFIELD_BURST = 8;

float() cu_particlefield_should_sleep =
{
	if (self.distance <= 0) return cu_FALSE;
	if (cu_clients > 4) return cu_FALSE;	// probably dropping tons of particles anyway, don't bother
	
	entity cu_client = nextent(world);
	while (cu_client.classname == "player")
	{
		if (vlen(cu_BoundsCenter(self.cu_buddy) - cu_client.origin) < self.distance)
		{
			return cu_FALSE;
		}
		cu_client = nextent(cu_client);
	}
	return cu_TRUE;
}

vector(vector cu_org) cu_particlefield_dir =
{
	vector cu_dir;
	cu_dir = self.movedir;
	if (self.spawnflags & cu_PFIELD_INWARD)	// in
	{
		cu_dir -= cu_org * vlen(self.movedir);
	}
	else if (self.spawnflags & cu_PFIELD_OUTWARD)	// out
	{
		cu_dir += cu_org * vlen(self.movedir);
	}
	return cu_dir;
}

void(float cu_num) cu_particlefield_sweep =
{
	/*
	call x and y the two axes perpendicular to the sweep, z the direction of the sweep
	random x and y are chosen
	z determined by projecting x and y down z axis onto wherever the plane should be
		ie solving plane equation for z by plugging in x and y
		ax + by + cz = d
		cz = d - ax - by
		z = (d-ax-by)/c
	*/
	float cu_d, cu_t, z, cu_frac;
	vector cu_plane, cu_porg;
	
	// self.dest = transformed bounds
	// self.pos1 = transformed velocity
	
	cu_plane = normalize(self.pos1);
	cu_d = cu_vabs(cu_plane) * self.dest * 2;	// total distance
	
	// determine position in the cycle
	cu_t = time - self.cu_attack_finished;
	cu_frac = cu_t / (cu_d / vlen(self.pos1));
	if (cu_frac > 1)
	{
		if (self.spawnflags & cu_PFIELD_BURST)
		{
			self.state = 0;
			self.cu_buddy = world;
			return;	// done with a loop
		}
		cu_frac = 0;
		self.cu_attack_finished = time;
	}
	
	if (cu_particlefield_should_sleep()) return;
	
	z = cu_d * (cu_frac - 0.5);
	while (cu_num > 0)
	{
		cu_num -= 1;
		// choose x and y randomly within field bounds
		cu_porg_x = cu_crandom() * self.dest_x;
		cu_porg_y = cu_crandom() * self.dest_y;
		// solve plane equation to derive z (if sweep vel is non-axial)
		cu_porg_z = (z - cu_plane_x * cu_porg_x - cu_plane_y * cu_porg_y) / cu_plane_z;
		if (fabs(cu_porg_z) > self.dest_z)
			continue;	// reject outside bounds

		// transform result back
		if (self.worldtype == 0)	// sweeping down x
		{
			cu_porg = cu_Vector(cu_porg_z, cu_porg_x, cu_porg_y);
		}
		else if (self.worldtype == 1)	// sweeping down y
		{
			cu_porg = cu_Vector(cu_porg_x, cu_porg_z, cu_porg_y);
		}

		// add self.origin and go
		particle (cu_porg + cu_BoundsCenter(self.cu_buddy), cu_particlefield_dir(cu_porg), self.health, self.speed2);
	}
}

void(float cu_num) cu_particlefield_burst =
{
	if (cu_particlefield_should_sleep()) return;
	
	vector cu_org, cu_org2;
	while (cu_num > 0)
	{
		cu_num -= 1;
		cu_org = cu_Vector(cu_crandom(), cu_crandom(), cu_crandom());
		cu_org2 = cu_vec_scale(cu_org, self.size);
		
		particle (cu_org2 + cu_BoundsCenter(self.cu_buddy), cu_particlefield_dir(cu_org), self.health, self.speed2);
	}
}

void() cu_particlefield_think =
{
	if (self.cu_finaldest == cu_VEC_ORIGIN)
	{
		float cu_accum;
		self.cu_cnt += self.speed * self.wait;
		cu_accum = floor(self.cu_cnt);
		if (cu_accum > 0)
		{
			cu_particlefield_burst(cu_accum);
			self.cu_cnt -= cu_accum;
		}
	}
	else
	{
		cu_particlefield_sweep(self.speed);
	}
	
	if (self.state)
		self.nextthink = time + self.wait;
}

void() cu_particlefield_get_spot =
{
	if (self.cu_buddy) return;
	
	if (self.target == cu_string_null)
	{
		self.cu_buddy = self;
	}
	else
	{
		self.cu_buddy = find(world, targetname, self.target);
		if (!self.cu_buddy) self.cu_buddy = self;
	}
}

void() cu_particlefield_use =
{
	if (self.spawnflags & cu_PFIELD_BURST)
	{
		cu_particlefield_get_spot();
		if (self.cu_finaldest == cu_VEC_ORIGIN)
		{
			cu_particlefield_burst(self.speed);
			self.cu_buddy = world;
		}
		else
		{
			self.cu_attack_finished = time;
			self.state = 1;
			self.nextthink = time + self.wait;
			cu_particlefield_sweep(self.speed);
		}
		return;
	}
	
	self.state = !self.state;
	if (self.state)
	{
		cu_particlefield_get_spot();
		self.cu_cnt = 0;
		self.think = cu_particlefield_think;
		self.nextthink = time + self.wait;
	}
	else
	{
		self.nextthink = 0;
		self.cu_buddy = world;
	}
}


/*FGD
@baseclass color(0 128 224) = Particlefield [
