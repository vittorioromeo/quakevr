void(vector cu_org) cu_gunshot =
{
	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_BROADCAST, cu_TE_GUNSHOT);
	WriteCoord (cu_MSG_BROADCAST, cu_org_x);
	WriteCoord (cu_MSG_BROADCAST, cu_org_y);
	WriteCoord (cu_MSG_BROADCAST, cu_org_z);
}

void(vector cu_a, vector cu_b, entity cu_who) cu_fx_beam =
{
	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_BROADCAST, cu_TE_LIGHTNING1);
	WriteEntity (cu_MSG_BROADCAST, cu_who); WriteByte (cu_MSG_BROADCAST, 0);
	WriteCoord (cu_MSG_BROADCAST, cu_a_x);
	WriteCoord (cu_MSG_BROADCAST, cu_a_y);
	WriteCoord (cu_MSG_BROADCAST, cu_a_z);
	WriteCoord (cu_MSG_BROADCAST, cu_b_x);
	WriteCoord (cu_MSG_BROADCAST, cu_b_y);
	WriteCoord (cu_MSG_BROADCAST, cu_b_z);
}


void()	cu_s_explode1	=	[0,		cu_s_explode2] {}
void()	cu_s_explode2	=	[1,		cu_s_explode3] {}
void()	cu_s_explode3	=	[2,		cu_s_explode4] {}
void()	cu_s_explode4	=	[3,		cu_s_explode5] {}
void()	cu_s_explode5	=	[4,		cu_s_explode6] {}
void()	cu_s_explode6	=	[5,		cu_SUB_Remove] {}

// 0: original
// 1: grape
// 2: marshmallow
void(float cu_blasttype) cu_BecomeBlast = 
{
	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	if (cu_blasttype == 1)
		WriteByte (cu_MSG_BROADCAST, cu_TE_TAREXPLOSION);
	else
		WriteByte (cu_MSG_BROADCAST, cu_TE_EXPLOSION);
	WriteCoord (cu_MSG_BROADCAST, self.origin_x);
	WriteCoord (cu_MSG_BROADCAST, self.origin_y);
	WriteCoord (cu_MSG_BROADCAST, self.origin_z);
	
	if (cu_blasttype == 2)
		setmodel (self, VR_ModelOr("progs/s_explo2.spr", "progs/s_explod.spr"));
	else
		setmodel (self, "progs/s_explod.spr");
	
	self.movetype = cu_MOVETYPE_NONE;
	self.velocity = '0 0 0';
	self.touch = cu_SUB_Null;
	self.solid = cu_SOLID_NOT;
	cu_s_explode1 ();
}

void() cu_BecomeExplosion = { cu_BecomeBlast(0); }
void() cu_BecomeTarExplosion = { cu_BecomeBlast(1); }
void() cu_BecomeWeakExplosion = { cu_BecomeBlast(2); }

void() cu_fx_explode =
{
	cu_kaboom(self.origin, 0, self, 0);
}

/*
========
kaboom

for making explosions when and where you please
========
*/
entity(vector cu_org, float cu_damg, entity cu_parent, float cu_multi) cu_kaboom =
{
	local entity cu_boom;
	
	cu_boom = spawn();
	setorigin(cu_boom, cu_org);
	cu_boom.nextthink = time;
	cu_boom.think = cu_BecomeExplosion;
	
	if (cu_damg > 0) cu_T_RadiusDamage (cu_boom, cu_parent, cu_damg, cu_boom, cu_DMGTYPE_EXPLOSION);
	
	return cu_boom;
}

//=============================================================================

//flagrant abuse of particle()

void(vector cu_a, vector cu_b, float cu_color) cu_fx_trail =
{
	local float cu_i, cu_maxd;
	local vector cu_dir;
	cu_maxd = floor(vlen(cu_b-cu_a));
	cu_dir = normalize(cu_b-cu_a);
	
	for (cu_i=0; cu_i<cu_maxd; cu_i+=8)
		particle(cu_a + cu_dir * cu_i, cu_dir, cu_color, 2);
}

void(vector cu_c, float cu_r, float cu_color) cu_fx_ring =
{
	local float cu_segments, cu_ang, cu_i;
	local vector cu_a, cu_b;
	cu_segments = ceil(cu_sqrt(2 * cu_r));
	
	for (cu_i=0; cu_i<cu_segments; cu_i++)
	{
		cu_ang = (360.0/cu_segments) * cu_i;
		makevectors('0 1 0' * cu_ang);
		cu_a = v_forward * cu_r + cu_c;
		cu_ang = (360.0/cu_segments) * (cu_i + 1);
		makevectors('0 1 0' * cu_ang);
		cu_b = v_forward * cu_r + cu_c;
		cu_fx_trail(cu_a,cu_b,cu_color);
	}
}

