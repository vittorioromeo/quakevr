//============================================================================

float(entity cu_e) cu_tar_visible =
{
	return (cu_alive(cu_e) && cu_visible(cu_e) && !cu_has_invis(cu_e));
}

float() cu_Tar_Max =
{
	if (cu_skill == 0) return 3;
	if (cu_skill == 3) return 7;
	return 5;
}

void() cu_Tar_Forget =
{
	self.cu_customflags |= cu_CFL_OMNIVISION;	// gain 360 vision in case we fall asleep in a corner

	if (!self.cu_rad_time)	// time to be RAD
	{
		// we just woke up, don't forget right away, because if we were awoken
		// by another monster waking we'll just lay here and burp (ikspq2)
		self.cu_rad_time = time + 60;
	}
	
	if (time < self.cu_rad_time)
		return;
		
	if (!cu_tar_visible(self.enemy))
	{
		if (cu_tar_visible(self.cu_oldenemy))
		{
			self.enemy = self.cu_oldenemy;
		}
		else
		{
			self.enemy = world;
		}
		self.cu_oldenemy = world;
	}
	if (!self.enemy)
	{
		self.cu_rad_time = 0;	// reset the clock
		cu_ai_stand();
	}
}


void()	cu_Tar_JumpTouchGround =
{
	if (!checkbottom(self))
	{
		if (self.flags & cu_FL_ONGROUND)
		{	// jump randomly to not get hung up
			self.think = cu_tbaby_jump1;
			self.nextthink = time + 0.1;
		}
		return;	// not on ground yet
	}

	self.touch = cu_SUB_Null;
	if (self.cu_cnt > cu_Tar_Max() && (!cu_tar_visible(self.enemy)))
	{
		self.think = cu_tbaby_run1;
		self.cu_cnt = 0;
		// if the player listens to sound cues and ambushes the spawn just as it 
		// stops, he has an extra second to attack it (... outside of nightmare)
		if (cu_skill < 3) cu_ai_attack_finished(1);	
	}
	else
	{
		self.think = cu_tbaby_jump1;
	}
	self.nextthink = time + 0.1;
}

void()	cu_Tar_JumpTouch =
{
	local	float	cu_ldmg;

	if (other.takedamage &&
		other.classname != self.classname)
	{
		if ( vlen(self.velocity) > 400 )
		{
			if (other.classname != "player" || time > self.cu_touch_time)	// fix for landing on the player's head
			{
				if (other.classname == "player")
				{
					self.cu_touch_time = time + 0.2;
					self.cu_cnt = cu_max(0, self.cu_cnt - 1);
				}
				
				self.cu_rad_time = time + 60;
				cu_ldmg = 10 + 10*random();
				cu_T_Damage (other, self, self, cu_ldmg);	
				sound (self, cu_CHAN_WEAPON, "blob/hit1.wav", 1, cu_ATTN_NORM);
			}
		}
	}
	else
		sound (self, cu_CHAN_WEAPON, "blob/land1.wav", 1, cu_ATTN_NORM);
	
	cu_Tar_JumpTouchGround();
}

void()	cu_tbaby_fly1		=[	$fly1,	cu_tbaby_fly2	] {}
void()	cu_tbaby_fly2		=[	$fly2,	cu_tbaby_fly3	] {}
void()	cu_tbaby_fly3		=[	$fly3,	cu_tbaby_fly4	] {}
void()	cu_tbaby_fly4		=[	$fly4,	cu_tbaby_fly1	] 
{
	self.delay = self.delay + 1;
	if (self.delay == 4)
	{
		//dprint ("spawn hop\n");
		cu_tbaby_jump1 ();
	}
}

void()	cu_tbaby_jump1		=[	$jump1,	cu_tbaby_jump2		] {cu_nmfast(); cu_ai_face();}
void()	cu_tbaby_jump2		=[	$jump2,	cu_tbaby_jump3		] {cu_nmfast(); cu_ai_face();}
void()	cu_tbaby_jump3		=[	$jump3,	cu_tbaby_jump4		] {cu_nmfast(); cu_ai_face();}
void()	cu_tbaby_jump4		=[	$jump4,	cu_tbaby_jump5		] {cu_nmfast(); cu_ai_face();}
void()	cu_tbaby_jump5		=[	$jump5,	cu_tbaby_jump6		]
{	
	self.movetype = cu_MOVETYPE_BOUNCE;
	self.touch = cu_Tar_JumpTouch;
	makevectors (self.angles);
	//self.origin_z = self.origin_z + 1;
	self.velocity = v_forward * 600 + '0 0 200';
	self.velocity_z = self.velocity_z + random()*150;
	if (self.flags & cu_FL_ONGROUND)
		self.flags = self.flags - cu_FL_ONGROUND;
		
	if (!cu_tar_visible(self.enemy))
		self.cu_cnt = self.cu_cnt + 1;
		
	self.delay = 0;
	self.cu_rad_time = time + 60;
}
void()	cu_tbaby_jump6	=[	$jump6,cu_tbaby_fly1	] {}



//=============================================================================

void(entity cu_attacker, float cu_damage) cu_tbaby_pain =
{
	self.cu_rad_time = time + 60;
	
	// shooting a tbaby while invisible triggers one spastic leap
	if (cu_has_invis(cu_attacker) && self.cu_pain_finished < time)
	{
		self.cu_pain_finished = time + 1;
		self.cu_cnt = cu_Tar_Max();
		cu_tbaby_jump1();
		return;
	}
	
	self.cu_cnt = 0;	
}

void()	cu_tbaby_die1	=[	$exp,		cu_tbaby_die2	] {
self.takedamage = cu_DAMAGE_NO;
}
void()	cu_tbaby_die2	=[	$exp,		cu_tbaby_run1	] 
{
	cu_T_RadiusDamage (self, self, 120, world, cu_DMGTYPE_EXPLOSION );
	sound (self, cu_CHAN_VOICE, "blob/death1.wav", 1, cu_ATTN_NORM);
	cu_BecomeTarExplosion ();
}

//=============================================================================

float() cu_tbaby_check_attack =
{
	float cu_chance;
	
	// spawns don't launch an attack if the player is invisible, or else
	// they'd time out after five leaps and then just start again
	if (cu_has_invis(self.enemy)) return cu_FALSE;
	
	if (time < self.cu_attack_finished) return cu_FALSE;
	if (cu_enemy_range >= cu_RANGE_FAR) return cu_FALSE;
	if (!cu_CheckClearAttack()) return cu_FALSE;
		
	if (cu_enemy_range == cu_RANGE_MELEE)
	{
		cu_chance = 0.9;
		self.cu_attack_finished = 0;
	}
	else if (cu_enemy_range == cu_RANGE_NEAR)
		cu_chance = 0.4;
	else if (cu_enemy_range == cu_RANGE_MID)
		cu_chance = 0.1;
	else
		cu_chance = 0;

	if (random() < cu_chance)
	{
		self.cu_attack_state = cu_AS_MISSILE;
		cu_ai_attack_finished (2*random());
		return cu_TRUE;
	}

	return cu_FALSE;
}

void() cu_monster_tarbaby_spawn =
{
	self.classname = "monster_tarbaby";
	
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/tarbaby.mdl");

	setsize (self, '-16 -16 -24', '16 16 40');
	self.health = 80;
	self.yaw_speed = 30;

	self.cu_customflags |= cu_CFL_MELEEONLY;

	self.cu_th_stand = cu_tbaby_stand1;
	self.cu_th_walk = cu_tbaby_walk1;
	self.cu_th_run = cu_tbaby_run1;
	self.cu_th_missile = cu_tbaby_jump1;
	self.cu_th_melee = cu_tbaby_jump1;
	self.cu_th_die = cu_tbaby_die1;
	self.cu_th_checkattack = cu_tbaby_check_attack;
	self.cu_th_pain = cu_tbaby_pain;

	if (self.deathtype == cu_string_null)
		self.deathtype = "was slimed by a Spawn";

	cu_walkmonster_start ();
}

void() cu_monster_tarbaby_spawner = {cu_mon_spawner_use(cu_monster_tarbaby_spawn);}

/*cu:QUAKED monster_tarbaby (1 0 0) (-16 -16 -24) (16 16 24) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Spawn (Tarbaby), 80 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry

"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-16 -16 -24, 16 16 24) model({ "path": ":progs/tarbaby.mdl" }) = monster_tarbaby : "Spawn" []
*/
void() cu_monster_tarbaby =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model2 ("progs/tarbaby.mdl");

	precache_sound2 ("blob/death1.wav");
	precache_sound2 ("blob/hit1.wav");
	precache_sound2 ("blob/land1.wav");
	precache_sound2 ("blob/sight1.wav");
	precache_sound2 ("blob/idle.wav");

	setsize (self, '-16 -16 -24', '16 16 40');
	self.health = 80;
	if ( cu_monster_spawnsetup( cu_monster_tarbaby_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_tarbaby_spawn();
}
