/*
==============================================================================

MEAT FIREWORKS

moved from player.qc

the rule: gibs pass through .notrace monsterclip but heads do not, because heads
are kind of the trophies for gibbing something and should hang around rather
than fall through grates (also they look too big)

==============================================================================
*/

vector(float cu_dm) cu_GibVelocityForHealth =
{
	vector cu_v;
	float cu_voom;
	
	cu_v_x = 150 * cu_crandom();
	cu_v_y = 150 * cu_crandom();
	cu_v_z = 150 + 150 * random();

	cu_voom = cu_max(1, cu_min(10, cu_dm * cu_dm / 5000));
	
	return cu_v * cu_voom;
}

entity(string cu_gibname, vector cu_vel) cu_ThrowGib =
{
	entity cu_gib;
	cu_gib = spawn();
	
	// gibs have to be thinking ballistic projectiles to pass through monsterclip/notrace
	cu_gib.owner = cu_gib.cu_trueowner = self;
	cu_gib.touch = cu_projectile_touch_null;
	cu_gib.cu_th_die = cu_SUB_Remove;
	cu_gib.think = cu_projectile_toss_think;
	cu_gib.nextthink = time;
	cu_gib.touch = cu_projectile_touch_null;
	cu_gib.cu_lifetime_finished = time + 6 + random() * 6;

	setmodel(cu_gib, cu_gibname);
	setsize (cu_gib, cu_VEC_ORIGIN, cu_VEC_ORIGIN);
	setorigin (cu_gib, self.origin);

	cu_gib.velocity = cu_gib.cu_oldvelocity = cu_vel;	
	cu_gib.avelocity = cu_Vector(random(),random(),random()) * 600;

	cu_gib.movetype = cu_MOVETYPE_BOUNCE;
	
	cu_gib.cu_type = "gib";
	
	return cu_gib;
}

void(string cu_gibname, float cu_dm) cu_ThrowHead =
{
	setmodel (self, cu_gibname);
	self.frame = 0;
	self.think = cu_SUB_Null;
	self.nextthink = 0;
	
	self.movetype = cu_MOVETYPE_BOUNCE;
	self.takedamage = cu_DAMAGE_NO;
	self.solid = cu_SOLID_NOT;
	self.view_ofs = '0 0 8';
	setsize (self, '-16 -16 0', '16 16 56');
	self.velocity += cu_GibVelocityForHealth(cu_dm);
	self.origin_z = self.origin_z - 24;
	self.flags = self.flags - (self.flags & cu_FL_ONGROUND);
	self.cu_type = "head";
	self.avelocity = cu_crandom() * '0 600 0';
}


// Gib & GibSpray are split up since some monsters play special gib sounds (zombies/players)
void(string cu_headmdl, float cu_dm) cu_GibSpray =
{
	cu_ThrowGib ("progs/gib1.mdl", cu_GibVelocityForHealth(cu_dm));
	cu_ThrowGib ("progs/gib2.mdl", cu_GibVelocityForHealth(cu_dm));
	cu_ThrowGib ("progs/gib3.mdl", cu_GibVelocityForHealth(cu_dm));
	
	if (self.classname != "player" && cu_damage_attacker.classname == "func_void" )
	{
		cu_SUB_Remove();
		return;
	}
		
	cu_ThrowHead (cu_headmdl, cu_dm);
}

void(string cu_headmdl, float cu_dm) cu_Gib =
{
	sound (self, cu_CHAN_VOICE, "player/udeath.wav", 1, cu_ATTN_NORM);
	
	cu_GibSpray(cu_headmdl, cu_dm);
}


/*
================
SpawnMeatSpray
================
*/
void(vector cu_org, vector cu_vel) cu_SpawnMeatSpray =
{
	entity cu_meat;
	vector cu_mvel;
	
	cu_mvel = cu_vel;
	cu_mvel_z += 250 + 50 * random();

	cu_meat = cu_toss_projectile(cu_org, cu_mvel, "gib");
	//meat.solid = SOLID_NOT;
	cu_meat.cu_type = "gib";
	cu_meat.avelocity = '3000 1000 2000';
	cu_meat.cu_lifetime_finished = time + 1;
	
	cu_SUB_ChangeModel(cu_meat, "progs/zom_gib.mdl");
}

/*
================
SpawnBlood
================
*/
void(vector cu_org, vector cu_vel, float cu_damage) cu_SpawnBlood =
{
	particle (cu_org, cu_vel*0.1, 73, cu_damage*2);
}

//============================================================================

// meat noise
// meat noise
// play that funky meat noise
void() cu_meat_noise =
{
	float cu_r = random();
	if (cu_r < 0.25)
		sound (self, cu_CHAN_BODY, "player/teledth1.wav", 1, cu_ATTN_NORM);
	else if (cu_r < 0.5)
		sound (self, cu_CHAN_BODY, "player/tornoff2.wav", 1, cu_ATTN_NORM);
	else if (cu_r < 0.75)
		sound (self, cu_CHAN_BODY, "player/udeath.wav", 1, cu_ATTN_NORM);
	else
		sound (self, cu_CHAN_BODY, "player/gib.wav", 1, cu_ATTN_NORM);
}

void(string cu_gibname) cu_target_meat_fireworks_do =
{
	vector cu_spray;
	entity cu_gib;
	cu_spray = '1 1 1' - self.owner.mangle;
	cu_spray_x = cu_spray_x * cu_crandom() + self.owner.mangle_x * 4;
	cu_spray_y = cu_spray_y * cu_crandom() + self.owner.mangle_y * 4;
	cu_spray_z = cu_spray_z * cu_crandom() + self.owner.mangle_z * 4;
	cu_spray *= self.owner.speed * 2;
	
	cu_gib = cu_ThrowGib(cu_gibname, cu_spray);
	setorigin(cu_gib, self.origin + self.pos1);
}

void() cu_target_meat_fireworks_go =
{
	vector cu_spray;
	float cu_i;
	cu_meat_noise();
	
	self.pos1_x = (random()-0.5) * self.owner.size_x;
	self.pos1_y = (random()-0.5) * self.owner.size_y;
	self.pos1_z = (random()-0.5) * self.owner.size_z;

	for (cu_i = 0; cu_i < 3; cu_i++)
	{
		cu_spray = '1 1 1' - self.owner.mangle;
		cu_spray_x *= cu_crandom();
		cu_spray_y *= cu_crandom();
		cu_spray_z *= cu_crandom();
		cu_spray += self.owner.mangle;
		cu_SpawnMeatSpray(self.origin + self.pos1, cu_spray * self.owner.speed * 4);
	}
	
	cu_target_meat_fireworks_do(self.owner.model);
	
	if (self.owner.cu_cnt == 2)
		cu_target_meat_fireworks_do(self.owner.cu_model2);
	else
		cu_target_meat_fireworks_do(self.owner.model);
		
	if (self.owner.cu_cnt == 3)
		cu_target_meat_fireworks_do(self.owner.cu_model3);
	else
		cu_target_meat_fireworks_do(self.owner.model);
}

void() cu_target_meat_fireworks_use =
{
	float cu_i, cu_tnext;
	entity cu_meats;
	
	cu_playercount_convert(count);
	if (self.count == 1 && self.delay == 0 && self.cu_rand == 0)
	{
		cu_target_meat_fireworks_go();
		return;
	}
	
	cu_tnext = self.delay + self.cu_rand * random();
	for (cu_i = 0; cu_i < self.count; cu_i++)
	{
		cu_meats = spawn();
		cu_meats.owner = self;
		setorigin(cu_meats, self.origin);
		cu_meats.think = cu_target_meat_fireworks_go;
	//	meats.mangle = self.mangle;
	//	meats.speed = self.speed;
	//	meats.size = self.size;
		cu_meats.nextthink = time + cu_tnext;
		cu_tnext += self.wait + self.cu_rand * random();
	}
}

/*cu:QUAKED target_meat_fireworks (0.7 .0 .2) (-16 -16 -16) (16 16 16)
trigger for meat

Keys
"count" number of times of meat after triggering, default 1
"delay" time to wait before first meat
"wait" time to wait between meat
"rand" max random additional to wait before meat
"speed" speed of meat
"mangle" override meat direction, defaults to up
"size" random location of bursts within bounds of this size
*/
/*FGD
@PointClass base(Appearflags, Targetname) size(32 32 32) color(180 0 50) = target_meat_fireworks : "trigger for meat"
[
	count(integer) : "Repeat meat" : 1
	delay(string) : "Delay before first meat" : "0"
	wait(string) : "Wait between meat" : "1"
	rand(string) : "Random extra wait before meat" : "0"
	size(string) : "Random location within bounds" : "0 0 0"
	speed(integer) : "Speed of meat" : 128
	mangle(string) : "Override meat vector" : "0 0 1"
]
*/
void() cu_target_meat_fireworks =
{
	dprint("target_meat_fireworks\n");
	
	if (!cu_SUB_ShouldSpawn()) return;
	self.owner = self;	// delayed emitters have owner as this also
	self.speed = cu_zeroconvertdefault(self.speed, 128);
	self.count = cu_zeroconvertdefault(self.count, 1);
	self.use = cu_target_meat_fireworks_use;
	if (!self.wait)
		self.wait = 1;
	
	if (self.mangle == cu_VEC_ORIGIN)
	{
		self.mangle = cu_VEC_UP;
	}
	else
	{
		self.mangle = normalize(self.mangle);
	}
	
	if (self.model != cu_string_null)
	{
		precache_model(self.model);
		self.cu_cnt = 1;
		if (self.cu_model2 != cu_string_null)
		{
			precache_model(self.cu_model2);
			self.cu_cnt = 2;
			if (self.cu_model3 != cu_string_null)
			{
				precache_model(self.cu_model3);
				self.cu_cnt = 3;
			}
		}
	}
	else
	{
		self.cu_cnt = 3;
		self.model = "progs/gib1.mdl";
		self.cu_model2 = "progs/gib2.mdl";
		self.cu_model3 = "progs/gib3.mdl";
	}
}

void() cu_misc_meat_fireworks = {cu_target_meat_fireworks();}