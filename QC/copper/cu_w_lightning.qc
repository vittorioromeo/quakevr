/*
===============

LIGHTNING

===============
*/


/*
=================
Chain Lightning

damage repeats outward from the target to more behind them, halving damage each time

search around a little left or right behind the target so the lightning can appear 
to arc, so it isn't just a high speed railgun
=================
*/
void(vector cu_start, entity cu_from, float dmg) cu_W_ChainLightning =
{
	entity cu_head, cu_targ;
	float cu_len, cu_dist, cu_dot, cu_zpc;
	vector cu_dir, cu_h_org;
	cu_dir = normalize(cu_start - self.origin);	// self still attacker (player)

	cu_head = findradius(cu_start + cu_dir * 120, 100);
	
	cu_targ = cu_from;
	cu_len = cu_A_SHITLOAD;

	// find another enemy who hasn't been zapped yet
	while (cu_head)
	{
		if (cu_head != cu_from && 
			cu_head.takedamage && 
			!(cu_head.cu_customflags & cu_CFL_ZAPPED) && 
			(cu_head.movetype >= cu_MOVETYPE_WALK && cu_head.movetype <= cu_MOVETYPE_FLY))
		{
			cu_h_org = cu_BoundsCenter(cu_head);
			cu_traceline2(cu_start, cu_h_org, cu_from, 0);
			if (trace_ent == cu_head)
			{	
				// rank by distance
				cu_dist = vlen(cu_h_org - cu_start);
				// only jump to monsters within a narrow cone, so the player still has to
				// reposition smartly to get lightning to link downrange
				cu_dot = normalize(cu_h_org - cu_start) * cu_dir;
				if (cu_dist <= cu_len)
				{
					cu_zpc = pointcontents(cu_from.origin);
					if ( cu_dot > 0.825 || 
						(cu_dist < 72 && cu_dot > 0.725) ||
						// extra-wide zappy cone for anyone underwater
						(cu_dot > 0.25 && (cu_zpc == cu_CONTENT_WATER || cu_zpc == cu_CONTENT_SLIME) && pointcontents(cu_head.origin) == cu_zpc ) )
					{
						cu_targ = cu_head;
						cu_len = cu_dist;
					}
				}
			}
		}
		cu_head = cu_head.chain;
	}
	
	if (cu_targ != cu_from)
	{
		cu_LightningBeam(cu_start, cu_targ.origin, cu_from, dmg);
	}
}



/*
=================
LightningBeam
=================
*/
void(vector cu_start, vector cu_limit, entity cu_from, float cu_damage) cu_LightningBeam =
{
	// from is the originator of the beam - this is the shot monster when chaining
	// self always remains the actual attacker
	vector cu_left, cu_end;
	entity cu_targ;
	// fix for wonky 'three beams' bug:
	cu_left = cu_limit - cu_start;
	cu_left = cu_Vector(0 - cu_left_y, cu_left_x, 0);
	if (cu_left) {
		cu_left = normalize(cu_left) * 12;
	} else {
		// if beam is straight up or down, take the orientation from the source entity
		makevectors(cu_from.angles);
		cu_left = v_right * -12;
	}

	cu_traceline2(cu_start, cu_limit, cu_from, 0);
	cu_end = trace_endpos;
	if (trace_ent.takedamage && !(trace_ent.cu_customflags & cu_CFL_ZAPPED))
	{
		cu_targ = trace_ent;
		cu_targ.cu_customflags |= cu_CFL_ZAPPED;

		// don't chain from doors, buttons, or special wonky shootable triggers
		if ((cu_targ.solid == cu_SOLID_BBOX || cu_targ.solid == cu_SOLID_SLIDEBOX) && 
			cu_targ.movetype && cu_targ.movetype != cu_MOVETYPE_PUSH)
		{
			cu_end = trace_endpos;
			
			if (self.classname == "player")
			{
				// have the arc pull into the target a little
				//if (targ.maxs_x <= 32)	// not for cthon/etc, he's too big
				//	end = (trace_endpos + targ.origin) * 0.5;
				if (cu_targ.classname == "player")
					cu_targ.velocity_z = cu_targ.velocity_z + 400;
				
				if (cu_damage > 4)
					cu_W_ChainLightning(cu_end, cu_targ, ceil(cu_damage / 3 + 2)); // 30 12 6 4
			}
		}
		// we go through multidamage here because T_Damage clears ZAPPED and we
		// need to preserve that flag until we're done so we don't double damage
		cu_AddMultiDamage (cu_targ, cu_damage);
		// clear and apply multidamage must be called in an enclosing function!
		particle (cu_end, '0 0 100', 225, cu_damage*4);
	}
	
	// we do the lightning beam after the chain lightning recursion as the stack unwinds,
	// so that the closest beam gets sent last. this way, if quake runs out of beams 
	// in a big LG vs shambler showdown, we're likely to only overwrite the furthest 
	// and least noticeable beams
	if (self.classname == "monster_shambler")
	{
		WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
		WriteByte (cu_MSG_BROADCAST, cu_TE_LIGHTNING1);
	}
	else
	{
		if (cu_targ != world)
		sound (cu_targ, cu_CHAN_BODY, "weapons/lhit.wav", 1, cu_ATTN_NORM);
		WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
		WriteByte (cu_MSG_BROADCAST, cu_TE_LIGHTNING2);
	}
	// quake immediately reuses beams that come from the same entity, so the
	// entity the lightning jumped from has to own the next leg of lightning
	// or else they auto-overwrite and only the final (nearest) one appears
	WriteEntity (cu_MSG_BROADCAST, cu_from);
	WriteCoord (cu_MSG_BROADCAST, cu_start_x);
	WriteCoord (cu_MSG_BROADCAST, cu_start_y);
	WriteCoord (cu_MSG_BROADCAST, cu_start_z);
	WriteCoord (cu_MSG_BROADCAST, cu_end_x);
	WriteCoord (cu_MSG_BROADCAST, cu_end_y);
	WriteCoord (cu_MSG_BROADCAST, cu_end_z);


	cu_damage *= 0.3;	// tone down the side prongs or the LG is a total scythe vs crowds
	cu_traceline2(cu_start + cu_left, cu_end + cu_left, cu_from, 0);
	if (trace_ent.takedamage && !(trace_ent.cu_customflags & cu_CFL_ZAPPED))	// don't add damage to any target twice
	{
		trace_ent.cu_customflags |= cu_CFL_ZAPPED;
		particle (trace_endpos, '0 0 100', 225, cu_damage*4);
		cu_AddMultiDamage (trace_ent, cu_damage);
	}

	cu_traceline2(cu_start - cu_left, cu_end - cu_left, cu_from, 0);
	if (trace_ent.takedamage && !(trace_ent.cu_customflags & cu_CFL_ZAPPED))
	{
		trace_ent.cu_customflags |= cu_CFL_ZAPPED;
		particle (trace_endpos, '0 0 100', 225, cu_damage*4);
		cu_AddMultiDamage (trace_ent, cu_damage);
	}
}



