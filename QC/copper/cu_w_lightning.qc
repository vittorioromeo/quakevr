void() cu_W_FireLightning =
{
	local	vector		cu_org;
	local	float		cu_cells;

	if (self.ammo_cells < 1)
	{
		cu_W_SelectBestWeapon();
		return;
	}

// explode if under water
	if (self.waterlevel > 1)
	{
		cu_cells = self.ammo_cells;
		self.ammo_cells = 0;
		cu_W_SetCurrentAmmo ();
		cu_T_RadiusDamage (self, self, 35*cu_cells, world, cu_DMGTYPE_EXPLOSION);
		return;
	}

	if (self.cu_width < time)
	{
		sound (self, cu_CHAN_WEAPON, "weapons/lhit.wav", 1, cu_ATTN_NORM);
		self.cu_width = time + 0.6;
	}
	self.punchangle_x = -2;

	self.currentammo = self.ammo_cells = self.ammo_cells - 1;
	cu_org = self.origin + '0 0 16'+ v_forward * 8;
	
	cu_traceline2(cu_org, cu_org + v_forward * 720, self, cu_TRACE_NOMONSTERS);

	cu_ClearMultiDamage();
	cu_LightningBeam(cu_org, trace_endpos + v_forward * 8, self, 30);
	cu_ApplyMultiDamage(cu_DMGTYPE_LIGHTNING);
	
