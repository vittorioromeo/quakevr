void() cu_toggle_autosave =
{
	entity cu_e = world;
	float cu_printed = cu_FALSE;
	do {
		cu_e = find(cu_e, classname, "target_autosave");
		if (!cu_e) break;
		
		if (cu_e.use == cu_target_autosave_use)
		{
			cu_e.use = cu_SUB_Null;
			if (!cu_printed)
			{
				bprint("Autosaves disabled\n");
				cu_printed = cu_TRUE;
			}
		} else {
			cu_e.use = cu_target_autosave_use;
			if (!cu_printed)
			{
				bprint("Autosaves reenabled\n");
				cu_printed = cu_TRUE;
			}
		}

	} while (cu_e != world);
}

void() cu_target_autosave_use =
{
	if (time < self.cu_pain_finished)
		return;
	self.cu_pain_finished = time + 0.5;	// fix for juzley double autosaving, the numpty
	
	if (self.enemy)
	{
		cu_activator = self.enemy;
		self.enemy = world;
	}
	if (cu_activator.classname != "player") return;
	if (time < 2)	// make sure an autosave fired from a player start doesn't happen too early
	{
		if (serverflags & cu_SVFL_RESPAWNING)
		{
			dprint("RESPAWNING flag set, skipping autosave\n");
			return;
		}
		self.enemy = cu_activator;
		self.think = cu_target_autosave_use;
		self.nextthink = 2;
		return;
	}
	sound(cu_activator, cu_CHAN_VOICE, "misc/sav.wav", 1.0, cu_ATTN_NORM);
	cu_autosave(cu_activator, self.message);
}

/*cu:QUAKED target_autosave (1 .0 .5) (-8 -8 -8) (8 8 8)
Saves the game when triggered by a player. Never appears in multiplayer. 
the bprint tends to stomp any other prints on screen in most quake clients, so use a delayed trigger_relay if you fire this from an important pickup/trigger_counter/something else that puts text on screen more important than the autosave blurb.

Keys:
"message" change save file name, defaults to 'auto'
*/
/*FGD
@Pointclass base(Targetname, Appearflags) color(255 0 128) size(32 32 32) = target_autosave : 
"Saves the game when triggered by a player. Never appears in multiplayer. 
the bprint tends to stomp any other prints on screen in most quake clients, so use a delayed trigger_relay if you fire this from an important pickup/trigger_counter/something else that puts text on screen more important than the autosave blurb." 
[
	message(string) : "Change save filename" : "auto"
]
*/
void() cu_target_autosave =
{
	if (deathmatch)
	{
		remove(self);
		return;
	}
	
	// never autosave in coop anyway
	self.spawnflags = cu_not(self.spawnflags, cu_SPAWN_COOPONLY) | cu_SPAWN_NOTCOOP;
	if (!cu_SUB_ShouldSpawn()) return;
	
	if (self.message == cu_string_null)
		self.message = "auto";
	precache_sound2("misc/sav.wav");
	self.use = cu_target_autosave_use;
}


