void(entity cu_t) cu_target_kill_remove =
{
	if ((self.spawnflags & 1) == 0)
	{
		cu_RemoveTarget(cu_t);
		return;
	}

	// 'murder' spawnflag: actually kill monsters instead of removing them
	if ((cu_t.flags & cu_FL_MONSTER) && (cu_t.deadflag == cu_DEAD_NO))
	{
		cu_T_Damage(cu_t, cu_activator, self, cu_t.health + 20, cu_DMGTYPE_SCRIPT);
	}
	else if (cu_t.cu_customflags & cu_CFL_SPAWNER)
	{
		while (cu_t.count > 0)
		{
			killed_monsters = killed_monsters + 1;
			WriteByte (cu_MSG_ALL, cu_SVC_KILLEDMONSTER);
			cu_t.count -= 1;
		}
		remove(cu_t);
	}
	else
		cu_RemoveTarget(cu_t);
}

void() cu_target_kill_rando =
{
	cu_SUB_CountTargets();
	self.cu_cnt += self.frags;
	
	if (!self.cu_cnt) return;

	float cu_randy;
	entity cu_t;

	cu_randy = ceil( random() * self.cu_cnt );

	cu_t = world;
	if (self.target != cu_string_null) while ( cu_randy > 0 )
	{
		cu_t = find (cu_t, targetname, self.target);
		if (!cu_t) break;
		cu_randy = cu_randy - 1;
	}
	if (!cu_t && self.cu_target2 != cu_string_null) while ( cu_randy > 0 )
	{
		cu_t = find (cu_t, targetname, self.cu_target2);
		if (!cu_t) break;
		cu_randy = cu_randy - 1;
	}
	if (!cu_t && self.cu_target3 != cu_string_null) while ( cu_randy > 0 )
	{
		cu_t = find (cu_t, targetname, self.cu_target3);
		if (!cu_t) break;
		cu_randy = cu_randy - 1;
	}
	if (!cu_t && self.cu_target4 != cu_string_null) while ( cu_randy > 0 )
	{
		cu_t = find (cu_t, targetname, self.cu_target4);
		if (!cu_t) break;
		cu_randy = cu_randy - 1;
	}
	if (!cu_t && self.killtarget != cu_string_null) while ( cu_randy > 0 )
	{
		cu_t = find (cu_t, targetname, self.killtarget);
		if (!cu_t) break;
		cu_randy = cu_randy - 1;
	}
	
	cu_target_kill_remove(cu_t);
}

void() cu_target_kill_go =
{
	local entity cu_t;

	if (self.spawnflags & 2)
	{
		cu_target_kill_rando();
		return;
	}

	// kill targets
	if (self.target != cu_string_null) {
		cu_t = world;
		do	{
			cu_t = find(cu_t, targetname, self.target);
			if (!cu_t) break;
			cu_target_kill_remove (cu_t);
		} while ( 1 );
	}
	if (self.cu_target2 != cu_string_null) {
		cu_t = world;
		do	{
			cu_t = find(cu_t, targetname, self.cu_target2);
			if (!cu_t) break;
			cu_target_kill_remove (cu_t);
		} while ( 1 );
	}
	if (self.cu_target3 != cu_string_null) {
		cu_t = world;
		do	{
			cu_t = find(cu_t, targetname, self.cu_target3);
			if (!cu_t) break;
			cu_target_kill_remove (cu_t);
		} while ( 1 );
	}
	if (self.cu_target4 != cu_string_null) {
		cu_t = world;
		do	{
			cu_t = find(cu_t, targetname, self.cu_target4);
			if (!cu_t) break;
			cu_target_kill_remove (cu_t);
		} while ( 1 );
	}
	if (self.killtarget != cu_string_null) {
		cu_t = world;
		do	{
			cu_t = find(cu_t, targetname, self.killtarget);
			if (!cu_t) break;
			cu_target_kill_remove (cu_t);
		} while ( 1 );
	}
}

void() cu_target_kill_use =
{
	if (!self.delay)
	{
		cu_target_kill_go();
		return;
	}
	entity cu_killer = spawn();
	cu_SUB_CopyTargets(cu_killer);
	cu_killer.think = cu_target_kill_go;
	cu_killer.nextthink = time + self.delay;
}

/*cu:QUAKED target_kill (0.75 0.5 0) (-8 -8 -8) (8 8 8) MURDER RANDOM
Kills ALL of its targets (1-4) as well as killtargets when triggered. for targets you really don't like.

"delay" wait before killing

MURDER	monsters are damaged to death, and spawners will credit unspawned kills
RANDOM	randomly kill only one target out of all of them
*/
/*FGD
@Pointclass base(Targetname, Appearflags) color(192 64 0) size(16 16 16) = target_kill : 
"Removes all targets when triggered. for targets you really don't like." [
	spawnflags(flags) =	[
		1 : "Murder monsters instead of removing" : 0
		2 : "Remove one target at random" : 0
	]	
	target(target_destination) : "Target: removes all with matching targetname" 
	target2(target_destination) : "Target 2: removes all with matching targetname" 
	target3(target_destination) : "Target 3: removes all with matching targetname" 
	target4(target_destination) : "Target 4: removes all with matching targetname" 
	killtarget(target_destination) : "Killtarget: removes all with matching targetname" 
	delay(string) : "Delay before removing" : "0"
]
*/
void() cu_target_kill =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.use = cu_target_kill_use;
}

