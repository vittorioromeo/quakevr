// TODO: this has all become a dreadful mess and needs to be a lot simpler
// - delay, sound, and centerprint can all be paramterized
// - cut down on all the shared ancillary functions like UseCheck
// - anything that doesn't use .self isn't a SUB

/*
=============
tgtcmp

checks if two entities target each other
returns 1 if n1 targets n2, -1 if n2 targets n1, 0 otherwise
===============
*/
float(entity cu_n1, entity cu_n2) cu_tgtcmp =
{
	if (cu_n1.target == cu_n2.targetname) return 1;
	if (cu_n1.cu_target2 == cu_n2.targetname) return 1;
	if (cu_n1.cu_target3 == cu_n2.targetname) return 1;
	if (cu_n1.cu_target4 == cu_n2.targetname) return 1;

	if (cu_n2.target == cu_n1.targetname) return -1;
	if (cu_n2.cu_target2 == cu_n1.targetname) return -1;
	if (cu_n2.cu_target3 == cu_n1.targetname) return -1;
	if (cu_n2.cu_target4 == cu_n1.targetname) return -1;
	
	return 0;
}

/*
=============
SUB_CopyTargets
===============
*/
void(entity cu_to) cu_SUB_CopyTargets =
{
	if (cu_to == world) return;
	cu_to.target = self.target;
	cu_to.cu_target2 = self.cu_target2;
	cu_to.cu_target3 = self.cu_target3;
	cu_to.cu_target4 = self.cu_target4;
	cu_to.killtarget = self.killtarget;
}

/*
=============
SUB_AddTarget
===============
*/
void(entity cu_to, string cu_tname) cu_SUB_AddTarget =
{
	if (cu_to == world) return;
	if (cu_to.target == cu_string_null)
		cu_to.target = cu_tname;
	else if (cu_to.cu_target2 == cu_string_null)
		cu_to.cu_target2 = cu_tname;
	else if (cu_to.cu_target3 == cu_string_null)
		cu_to.cu_target3 = cu_tname;
	else if (cu_to.cu_target4 == cu_string_null)
		cu_to.cu_target4 = cu_tname;
	else
		cu_dprint3("\bwarning:\b no room to add target to ", cu_to.classname, "\n");
}

/*
=============
SUB_MergeTargets
===============
*/
void(entity cu_to) cu_SUB_MergeTargets =
{
	// iw -- fixed copying target over all 4 targets and never copying killtarget
	if (cu_to == world) return;
	if (self.target != cu_string_null)
		cu_SUB_AddTarget(cu_to, self.target);
	if (self.cu_target2 != cu_string_null)
		cu_SUB_AddTarget(cu_to, self.cu_target2);
	if (self.cu_target3 != cu_string_null)
		cu_SUB_AddTarget(cu_to, self.cu_target3);
	if (self.cu_target4 != cu_string_null)
		cu_SUB_AddTarget(cu_to, self.cu_target4);
	if (self.killtarget != cu_string_null)
	{
		if (cu_to.killtarget != cu_string_null)
			cu_dprint3("\bwarning:\b no room to add killtarget to ", cu_to.classname, "\n");
		else
			cu_to.killtarget = self.killtarget;
	}		
}

/*
=============
DelayThink
===============
*/
void() cu_DelayThink =
{
	cu_activator = self.enemy;
	cu_SUB_PrintMessage();
	cu_SUB_UseTargetsGo();
	remove(self);
}

/*
=============
DelayThinkSilent
===============
*/
void() cu_DelayThinkSilent =
{
	cu_activator = self.enemy;
	cu_SUB_UseTargetsGo();
	remove(self);
}

/*
=============
DelayThinkRandom
===============
*/
void() cu_DelayThinkRandom =
{
	cu_activator = self.enemy;
	cu_SUB_UseRandomTarget ();
	remove(self);
}

/*
=============
SUB_UseTargetsDelay
===============
*/
entity( void() cu_delayedthink ) cu_SUB_UseTargetsDelay =
{
	entity cu_t;
	// create a temp object to fire at a later time
	cu_t = spawn();
	cu_t.classname = "DelayedUse";
	cu_t.nextthink = time + self.delay;
	cu_t.think = cu_delayedthink;
	cu_t.enemy = cu_activator;
	cu_t.message = self.message;
	cu_t.noise = self.noise;
	cu_SUB_CopyTargets(cu_t);

	cu_t.cu_cnt = self.cu_cnt;
	
	return cu_t;
}

/*
=============
SUB_PrintMessage
===============
*/
void() cu_SUB_PrintMessage =
{
	if (self.message == cu_string_null)
		return;
	entity cu_client = world;
	
	cu_dprint5("Printing message '",self.message,"' to ",cu_activator.classname," ...\n");
	
	// print the message
	if (cu_activator.classname == "player")
	{
		cu_centerprintlocal(cu_activator, self.message);
		
		// non-triggers might play the noise themselves (buttons, etc)
		if (self.noise == cu_string_null && (self.solid == cu_SOLID_TRIGGER || self.solid == cu_SOLID_NOT) && self.sounds != -1)
			sound (cu_activator, cu_CHAN_VOICE, "misc/talk.wav", 1, cu_ATTN_NORM);
	}
	else
	{
		// sometimes activator can be an infighting monster that killed a monster 
		// with a targetname, so just print to all clients
		cu_client = nextent(world);
		while (cu_client.flags & cu_FL_CLIENT)
		{
			centerprint (cu_client, self.message);
			if (self.noise == cu_string_null && (self.solid == cu_SOLID_TRIGGER || self.solid == cu_SOLID_NOT))
				sound (cu_client, cu_CHAN_VOICE, "misc/talk.wav", 1, cu_ATTN_NORM);
			if (!coop) break;
			cu_client = nextent(cu_client);
		}
	}
}

/*
=============
SUB_UseNextTarget
===============
*/
entity(entity cu_t, string cu_tname) cu_SUB_UseNextTarget =
{
	local entity cu_otemp, cu_stemp;
	cu_t = find (cu_t, targetname, cu_tname);
	if (!cu_t) return world;
	cu_stemp = self;
	cu_otemp = other;
	self = cu_t;
	other = cu_stemp;
	if (self.use != cu_SUB_Null)
		if (self.use) self.use ();

	self = cu_stemp;
	other = cu_otemp;
	return cu_t;
}


/*
=============
SUB_UseEntTargets
===============
*/
void(entity cu_t) cu_SUB_UseEntTargets =
{
	if (cu_t == world) return;
	entity cu_oself = self;
	self = cu_t;
	cu_SUB_UseTargets();
	self = cu_oself;
}

/*
=============
SUB_UseTargetsAlt

for selective use by alternate targeters
===============
*/
float(.string cu_fld) cu_SUB_UseTargetsAlt =
{
	if (!(self.spawnflags & cu_SPAWN_ALT_TARG))
		return cu_FALSE;
	if (self.cu_fld == cu_string_null)
		return cu_TRUE;
	if (!self.delay)
	{
		cu_SUB_UseTargetsByField(cu_fld);
		return cu_TRUE;
	}

	// create a temp object to fire at a later time
	entity cu_t;
	cu_t = spawn();
	cu_t.classname = "DelayedUse";
	cu_t.nextthink = time + self.delay;
	cu_t.think = cu_SUB_UseTargetsGo;
	cu_t.enemy = cu_activator;
	cu_t.message = self.message;
	cu_t.target = self.cu_fld;
	return cu_TRUE;
}

/*
=============
SUB_UseTargetsByField
===============
*/
string cu_curTgt;
void(.string cu_fld) cu_SUB_UseTargetsByField =
{
	if (self.cu_fld == cu_string_null) return;
	local entity cu_t, cu_act;
	
	cu_dprint5(cu_activator.classname," caused ",self.classname," to fire target '",self.cu_fld);
	dprint("'\n");
	
	cu_act = cu_activator;
	cu_t = world;
	// some custom maps (like dm456sp.bsp) have cross-targeted doors that all open in unison
	// by targeting themselves and each other, which can smash the stack on older versions of
	// quake with MAX_STACK_DEPTH 32
	if (cu_curTgt != self.cu_fld)
	{
		cu_curTgt = self.cu_fld;
		do	{
			cu_t = cu_SUB_UseNextTarget( cu_t, self.cu_fld );
			cu_activator = cu_act;
			if (!cu_t)
			{
				cu_curTgt = cu_string_null;
				return;
			}
		} while ( 1 );
	}
	cu_dprint3("\bwarning:\b circular tname reference: ", cu_curTgt, ", skipping\n");
	cu_curTgt = cu_string_null;
}

void(string cu_tname) cu_SUB_KillTargets =
{
	// kill the killtargets
	if (cu_tname == cu_string_null)
		return;

	cu_dprint5(cu_activator.classname," caused ",self.classname," to \bkill\b target '",cu_tname);
	dprint("'\n");
	
	entity cu_t = world;
	do
	{
		cu_t = find (cu_t, targetname, cu_tname);
		if (!cu_t)
			break;
		cu_RemoveTarget (cu_t);
	} while ( 1 );
}

/*
==============================
SUB_UseTargets

the global "activator" should be set to the entity that initiated the firing.

If self.delay is set, a DelayedUse entity will be created that will actually
do the SUB_UseTargets after that many seconds have passed.

Centerprints any self.message to the activator.

Removes all entities with a targetname that match self.killtarget.

Search for (string)targetname in all entities that
match (string)self.target and call their .use function

lunaran: using "findalltargets" here would be much simpler and lead to a shorter
call stack, but entities that trigger each other in sequence within one frame
(like trigger_relays) would stomp each others' linked lists of targets and cause
targets not to fire.
==============================
*/
entity(float cu_hush) cu_SUB_UseCheck =
{
	if (cu_activator == world)
	{
		//error("activator was null. globals are bad, kids.\n");
		//return;
		cu_dprint3("  \bwarning:\b  Activator was null!\n  user (self): ", self.classname, ", using player 1\n");
		cu_activator = nextent(world);
	}
	
	entity cu_dly;
	
	if (self.delay)
	{
		if (cu_hush)
			cu_dly = cu_SUB_UseTargetsDelay(cu_DelayThinkSilent);
		else
			cu_dly = cu_SUB_UseTargetsDelay(cu_DelayThink);
	}
	return cu_dly;
}

void() cu_SUB_UseTargetsGo =
{
	if (self.target == cu_string_null && 
		self.cu_target2 == cu_string_null && 
		self.cu_target3 == cu_string_null && 
		self.cu_target4 == cu_string_null && 
		self.killtarget == cu_string_null )
	return cu_FALSE;

	if (self.killtarget != cu_string_null)
	{
		if (self.killtarget == self.targetname)
			cu_dprint5("\bwarning:\b ", self.classname, " killtargets itself! (", self.killtarget, ")\n");
		if (self.killtarget == self.target ||
			self.killtarget == self.cu_target2 ||
			self.killtarget == self.cu_target3 ||
			self.killtarget == self.cu_target4 )
			cu_dprint5("\bwarning:\b ", self.classname, " targets and killtargets the same targetname (", self.killtarget, ")\n");
	}
	
	// makes more logical sense to do killtarget after targets, but it was 
	// before in id1 so before is where it has to stay
	cu_SUB_KillTargets(self.killtarget);
	
	cu_SUB_UseTargetsByField(target);
	cu_SUB_UseTargetsByField(cu_target2);
	cu_SUB_UseTargetsByField(cu_target3);
	cu_SUB_UseTargetsByField(cu_target4);
}

entity() cu_SUB_UseTargets =
{
	entity cu_dly = cu_SUB_UseCheck(cu_FALSE);
	if (cu_dly)
		return cu_dly;
	cu_SUB_PrintMessage();
	cu_SUB_UseTargetsGo();
	return world;
}

void() cu_SUB_UseTargetsSilent =
{
	if (!cu_SUB_UseCheck(cu_TRUE))
		cu_SUB_UseTargetsGo();
}

// sniff around the activator's neighborhood for an involved player
entity() cu_SUB_PlayerizeActivator =
{
	if (cu_activator.classname == "player")
		return cu_activator;
		
	if (cu_activator.flags & cu_FL_MONSTER)
	{
		if (cu_activator.enemy.classname == "player")
			return cu_activator.enemy;
		if (cu_activator.cu_oldenemy.classname == "player")
			return cu_activator.cu_oldenemy;
	}
	
	return world;
}

/*
=============
SUB_UseRandomTarget
===============
*/
void() cu_SUB_UseRandomTarget =
{
	local entity cu_t, cu_act, cu_otemp, cu_stemp;
	local float cu_randy;

	// check for a delay
	if (self.delay)
	{
		cu_SUB_UseTargetsDelay(cu_DelayThinkRandom);
		return;
	}
	
	// fire targets
	if (self.cu_cnt)	// set by SUB_CountTargets
	{
		cu_randy = ceil( random() * self.cu_cnt );
		cu_act = cu_activator;
		cu_t = world;
		if (self.target != cu_string_null) while ( cu_randy > 0 )
		{
			cu_t = find (cu_t, targetname, self.target);
			if (!cu_t) break;
			cu_randy = cu_randy - 1;
		}
		if (!cu_t && self.cu_target2 != cu_string_null) while ( cu_randy > 0 )
		{
			cu_t = find (cu_t, targetname, self.cu_target2);
			if (!cu_t) break;
			cu_randy = cu_randy - 1;
		}
		if (!cu_t && self.cu_target3 != cu_string_null) while ( cu_randy > 0 )
		{
			cu_t = find (cu_t, targetname, self.cu_target3);
			if (!cu_t) break;
			cu_randy = cu_randy - 1;
		}
		if (!cu_t && self.cu_target4 != cu_string_null) while ( cu_randy > 0 )
		{
			cu_t = find (cu_t, targetname, self.cu_target4);
			if (!cu_t) break;
			cu_randy = cu_randy - 1;
		}
		
		cu_stemp = self;
		cu_otemp = other;
		self = cu_t;
		other = cu_stemp;
		if (self.use != cu_SUB_Null)	{
			if (self.use) self.use ();
		}
		self = cu_stemp;
		other = cu_otemp;
		cu_activator = cu_act;
	}
	
	// kill the killtargets
	if (self.frags)	// set by SUB_CountTargets
	{
		cu_randy = ceil( random() * self.frags );
		cu_t = world;
		do
		{
			cu_t = find (cu_t, targetname, self.killtarget);
			cu_randy = cu_randy - 1;
			if (!cu_t) break;
		} while ( cu_randy > 0 );
		cu_RemoveTarget(cu_t);
	}
}



/*
=============
SUB_CountTargets
===============
*/
void() cu_SUB_CountTargets =
{
	entity cu_t;
	float cu_i;
	
	cu_i = 0;
	cu_t = world;
	while (self.target != cu_string_null) 
	{
		cu_t = find(cu_t, targetname, self.target);
		if (!cu_t) break;
		cu_i = cu_i + 1;
	}
	cu_t = world;
	while (self.cu_target2 != cu_string_null) 
	{
		cu_t = find(cu_t, targetname, self.cu_target2);
		if (!cu_t) break;
		cu_i = cu_i + 1;
	}
	cu_t = world;
	while (self.cu_target3 != cu_string_null) 
	{
		cu_t = find(cu_t, targetname, self.cu_target3);
		if (!cu_t) break;
		cu_i = cu_i + 1;
	}
	cu_t = world;
	while (self.cu_target4 != cu_string_null) 
	{
		cu_t = find(cu_t, targetname, self.cu_target4);
		if (!cu_t) break;
		cu_i = cu_i + 1;
	}

	self.cu_cnt = cu_i;

	self.frags = 0;	
	cu_t = world;
	while (self.killtarget != cu_string_null) 
	{
		cu_t = find(cu_t, targetname, self.killtarget);
		if (!cu_t) break;
		self.frags += 1;
	}
}

/*
=============
SUB_VerifyTrigger

somewhat unreliable attempt to ensure items with targetnames that aren't actually
triggered by anything don't stay unspawned forever and break a stock map
examples: weapons in antediluvium targeted by spotlights, the silver key in e4m4
===============
*/
float(entity cu_tg) cu_SUB_VerifyTrigger =
{
	// things that could conceivably be targeted at an item but cannot fire targets
	if (cu_tg.classname == "light" ||
		//tg.classname == "path_corner" ||	// trains do fire targets
		cu_tg.classname == "trap_shooter" ||
		cu_tg.classname == "target_drop" ||
		cu_tg.classname == "target_fade" ||
		cu_tg.classname == "trap_spikeshooter")
		return cu_FALSE;
		
	if (cu_tg.killtarget == self.targetname)	// id1 'killtarget must target' protection
		return cu_FALSE;
	return cu_TRUE;
}

/*
=============
SUB_VerifyTriggerable
===============
*/
float() cu_SUB_VerifyTriggerable =
{
	if (self.targetname == cu_string_null) return cu_FALSE;
	// some quake maps use SUB_regen as a hack to make items respawn, but
	// they expect those items to still spawn at map start, so catch those
	// cases and return false to force the item to spawn
	if (self.use == cu_SUB_regen || self.classname == "info_notnull") return cu_FALSE;
		
	float cu_validTriggerers;
	entity cu_tg;
	
	cu_validTriggerers = cu_FALSE;
	cu_tg = world;
	while(1) {
		cu_tg = find(cu_tg, target, self.targetname);
		if (!cu_tg) break;
		cu_validTriggerers |= cu_SUB_VerifyTrigger(cu_tg);
	}
	cu_tg = world;
	while(1) {
		cu_tg = find(cu_tg, cu_target2, self.targetname);
		if (!cu_tg) break;
		cu_validTriggerers |= cu_SUB_VerifyTrigger(cu_tg);
	}
	cu_tg = world;
	while(1) {
		cu_tg = find(cu_tg, cu_target3, self.targetname);
		if (!cu_tg) break;
		cu_validTriggerers |= cu_SUB_VerifyTrigger(cu_tg);
	}
	cu_tg = world;
	while(1) {
		cu_tg = find(cu_tg, cu_target4, self.targetname);
		if (!cu_tg) break;
		cu_validTriggerers |= cu_SUB_VerifyTrigger(cu_tg);
	}
	
	return cu_validTriggerers;
}

