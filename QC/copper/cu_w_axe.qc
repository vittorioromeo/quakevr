/*
===============

THE AXE

===============
*/

// SOUNDS

void() cu_W_AxeWhiffSound =
{
		sound (self, cu_CHAN_OTHER, "weapons/ax1.wav", 1, cu_ATTN_NORM);
}

void() cu_W_AxeHitSound =
{
	if (random() < 0.5)
		sound (self, cu_CHAN_WEAPON, "weapons/axhit1.wav", 1, cu_ATTN_NORM);
	else
		sound (self, cu_CHAN_WEAPON, "weapons/axhit2.wav", 1, cu_ATTN_NORM);
}


void(float cu_foff) cu_W_AxeCycle =
{
	// lip and touch_time are overloaded on the player for animation event timing
	// lip = 10fps player anim clock (axe animates at 20 so player has to think on 20s)
	// touch_time = timer for the actual weapon attack trace event
	self.weaponframe = cu_min(57, self.weaponframe + cu_foff);
	
	// entire axe swing anim is scheduled to be done by now
	if (self.cu_attack_finished <= time)
	{
		// stop the player anim cycle and restore normal thinking
		cu_W_SetIdleWeaponFrame();
		cu_player_run();
		return;
	}
	
	if (self.cu_touch_time && self.cu_touch_time <= time)
	{
		self.cu_touch_time = 0;
		cu_W_FireAxe();
	}
	// time for a regular animation think
	else if (self.lip <= time)
	{
		self.cu_think1();	// advance the player anim on the standard 10fps clock
		self.lip = time + 0.1;
	}
	self.nextthink = time + 0.05;
}

void() cu_W_AxeThink = { self.think = cu_W_AxeThink; cu_W_AxeCycle(1);  } 
void() cu_W_AxeThinkReverse = {  self.think = cu_W_AxeThinkReverse; cu_W_AxeCycle(-1); } 

void() cu_W_AxeSwing =
{
	cu_W_AxeWhiffSound();
		self.weaponframe = 10 * (floor(4.99 * random()));
		self.cu_touch_time = time + 0.1;
		self.cu_attack_finished = time + 0.49;
	self.cu_think1 = cu_player_axe;
	cu_W_AxeThink();
}


/*
================
W_FireAxe
================
*/
void() cu_W_FireAxe =
{
	vector	cu_source, cu_org;
	if (self.health <= 0)
		return;
	
	makevectors (self.v_angle);
	cu_source = self.origin + self.view_ofs;//'0 0 16';
	cu_traceline2(cu_source, cu_source + v_forward * (64), self, 0);
	if (trace_ent == self)
		return;	// some notrace shit happened
	if (trace_fraction == 1.0) 
		return;
	
	self.cu_show_hostile = time + 1;	// wake monsters up
	
	cu_org = trace_endpos - v_forward*4;
	
	if (trace_ent.takedamage)
	{
		trace_ent.cu_customflags = trace_ent.cu_customflags | cu_CFL_AXEHITME;
		cu_SpawnBlood (cu_org, '0 0 0', 20);
		cu_T_Damage (trace_ent, self, self, 24, cu_DMGTYPE_MELEE);
		
		if (trace_ent.flags & cu_FL_MONSTER)
		{
			if (trace_ent.cu_type == "zombie")
				cu_zombie_knockdown(trace_ent);
			cu_W_AxeHitSound();
		}
		else
		{
			sound (self, cu_CHAN_WEAPON, "zombie/z_hit.wav", 1, cu_ATTN_IDLE);
		}
		
		// do knockback with a quad
		if (cu_has_quad(self))
		{
			if ((trace_ent.movetype == cu_MOVETYPE_STEP || trace_ent.movetype == cu_MOVETYPE_WALK) && 
				// don't swat bosses or other non-standard-sized enemies around
				trace_ent.maxs_x <= 32 && trace_ent.health > 0 && trace_ent.cu_type != "boss")
			{
				local vector cu_toss;
				cu_toss = v_forward;
				cu_toss_z = 0;
				cu_toss = normalize(cu_toss) * 400;
				cu_toss_z = 100;
				//bprint(vtos(toss));
				//bprint("\n");
				//toss *=  - vlen(head.maxs - head.mins)
				trace_ent.origin_z = trace_ent.origin_z + 1;
				trace_ent.velocity = cu_toss;
				trace_ent.flags = cu_not(trace_ent.flags, cu_FL_ONGROUND);
			}
		}
	}
	else
	{	// hit wall
		sound (self, cu_CHAN_WEAPON, "player/axhit2.wav", 1, cu_ATTN_NORM);
		cu_gunshot(cu_org);
	}
}


