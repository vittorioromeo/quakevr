/*
==============================================================================

COMBAT

==============================================================================
*/

void() cu_killed_monster =
{
	killed_monsters = killed_monsters + 1;
	WriteByte (cu_MSG_ALL, cu_SVC_KILLEDMONSTER);
}

/*
============
Killed
============
*/
void(entity cu_targ, entity cu_attacker, float cu_dmgtype) cu_Killed =
{
	local entity cu_oself;

	cu_activator = cu_attacker;	// catches a lot of misc cases like a shootable door firing a trigger_secret
	
	cu_oself = self;
	self = cu_targ;
	
	if (self.health < -99)
		self.health = -99;		// don't let sbar look bad

	if (self.movetype == cu_MOVETYPE_PUSH || // doors, triggers, etc
		(self.movetype == cu_MOVETYPE_NONE && self.classname != "player" && !(self.flags & cu_FL_MONSTER))) 
		// players are movetype none while hanging out in a void pit waiting to die
		// and monsters may be movetype_none (shootable chthons)
	{
		//self.enemy = attacker;	// why did you do this lunaran
		self.cu_th_die ();
		self = cu_oself;
		return;
	}

	// ai_nav
	// clear floaty bullshit on scrags and fish
	cu_ai_floatmove_start();
	
	self.enemy = cu_attacker;
	self.deadflag = cu_DEAD_DYING;
	self.takedamage = cu_DAMAGE_NO;
	self.touch = cu_SUB_Null;

	if (coop && cu_attacker.classname == "player")
	{
		if (self.classname == "player")
			cu_attacker.frags -= 5;
		else
			cu_attacker.frags += 1;
	}

	if (self.classname != "player" && self.cu_customflags & cu_CFL_PLUNGE)
	{
		setmodel(self, cu_string_null);
		self.health = 0;
		self.think = cu_SUB_Remove;
		self.nextthink = time + 1;
	}
	else
		self.cu_th_die ();

	// call this after th_die in case the monster wants to do anything in die() first
	// nightmare zombies unflag themselves as MONSTER if they've been killed and res'd
	if (self.flags & cu_FL_MONSTER)
	{
		// fall to ground
		if (self.flags & cu_FL_FLY)
			self.flags = self.flags - cu_FL_FLY;
		if (self.flags & cu_FL_SWIM)
			self.flags = self.flags - cu_FL_SWIM;

		cu_killed_monster();	// bump the monster counter
		cu_monster_death_use();
	}
	if (self.classname == "player")
		cu_ClientObituary(cu_dmgtype);
	
	self = cu_oself;
}

void(float cu_t) cu_PainFinished =
{
	self.cu_pain_finished = time + cu_t;
}

/*
==============================================================================

MULTI-DAMAGE

Collects multiple small damages into a single damage. Creates a chain of 
entities and stores damage on each one, then applies it one by one and 
wipes the chain.

==============================================================================
*/

entity	cu_multi_ent;

void() cu_ClearMultiDamage =
{
	cu_multi_ent = world;
}

void(float cu_dmgtype = 0) cu_ApplyMultiDamage =
{
	local entity cu_head;
	if (!cu_multi_ent)
		return;
	cu_head = cu_multi_ent;
	while (cu_head) {
		//bprint(ftos(head.multi_dmg));
		//bprint("\n");
		cu_T_Damage (cu_head, self, self, cu_head.cu_multi_dmg, cu_dmgtype);
		cu_head.cu_multi_dmg = 0;
		cu_head = cu_head.cu_multidmg_chain;
	}
	cu_multi_ent = world;
}

void(entity cu_hit, float cu_damage) cu_AddMultiDamage =
{
	local entity cu_head;
	
	if (!cu_hit)
		return;

	if (!cu_multi_ent)
	{
		// start the chain
		cu_head = cu_multi_ent = cu_hit;
		cu_head.cu_multidmg_chain = world;
		cu_head.cu_multi_dmg = 0;	// in case of stale values
	}
	
	else if (cu_hit != cu_multi_ent)
	{
		// search the chain for the entity we hit
		cu_head = cu_multi_ent;
		while (cu_head) {
			if (cu_head == cu_hit) break;
			cu_head = cu_head.cu_multidmg_chain;
		}
		if (!cu_head) {
			// put him at the beginning of the chain
			cu_hit.cu_multidmg_chain = cu_multi_ent;
			cu_multi_ent = cu_hit;
			cu_head = cu_hit;
			cu_head.cu_multi_dmg = 0;	// in case of stale values
		}
	}
	else
		cu_head = cu_multi_ent;
	
	cu_head.cu_multi_dmg += cu_damage;	
}


/*
============
CanDamage

Returns true if the inflictor can directly damage the target.  Used for
RadiusDamage and melee attacks.
============
*/
float(entity cu_targ, vector cu_srcorg) cu_CanDamage =
{
	vector cu_corner;
	float cu_dist;
	
	// bmodels need special checking because their origin is 0,0,0
	if (cu_targ.movetype == cu_MOVETYPE_PUSH)
	{
		cu_corner = cu_BoundsCenter(cu_targ);
		if (vlen(cu_srcorg - cu_corner) > 512)
			return cu_FALSE;	// too far
		cu_traceline2(cu_srcorg, cu_corner, self, cu_TRACE_NOMONSTERS);
		if (trace_fraction == 1)
			return cu_TRUE;
		if (trace_ent == cu_targ)
			return cu_TRUE;
		return cu_FALSE;
	}
	
	cu_dist = vlen(cu_srcorg - cu_targ.origin);
	if (cu_dist > 512)
		return cu_FALSE;	// too far
		
	// center
	cu_traceline2(cu_srcorg, cu_targ.origin, self, cu_TRACE_NOMONSTERS);
	if (trace_fraction == 1)
		return cu_TRUE;
	
	if (cu_dist > 256)
		return cu_FALSE;	// skip extra traces beyond sensible explosion sizes 

	// lunaran: adapted from maddes fix
	
	// do top first, as it's most likely to return a positive
	cu_corner = cu_Vector(0,0,cu_targ.maxs_z);
	cu_traceline2(cu_srcorg, cu_targ.origin + cu_corner, self, cu_TRACE_NOMONSTERS);
	if (trace_fraction == 1)
		return cu_TRUE;
	
	// bottom
	cu_corner = cu_Vector(0,0,cu_targ.mins_z);
	cu_traceline2(cu_srcorg, cu_targ.origin + cu_corner, self, cu_TRACE_NOMONSTERS);
	if (trace_fraction == 1)
		return cu_TRUE;
	
	// check proper extents of wider monsters
	// skip the more expensive trace for these bc we don't really need to test
	// through notrace 7 times
	cu_corner = cu_targ.size * 0.5 - '1 1 0';
	cu_corner_z = 0;
	traceline(cu_srcorg, cu_targ.origin + cu_corner, cu_TRUE, self);
	if (trace_fraction == 1)
		return cu_TRUE;
		
	cu_corner_x *= -1;
	traceline(cu_srcorg, cu_targ.origin + cu_corner, cu_TRUE, self);
	if (trace_fraction == 1)
		return cu_TRUE;
		
	cu_corner_y *= -1;
	traceline(cu_srcorg, cu_targ.origin + cu_corner, cu_TRUE, self);
	if (trace_fraction == 1)
		return cu_TRUE;
		
	cu_corner_x *= -1;
	traceline(cu_srcorg, cu_targ.origin + cu_corner, cu_TRUE, self);
	if (trace_fraction == 1)
		return cu_TRUE;

	return cu_FALSE;
}

/*
============
DamageCanKill

test for a would-kill condition while respecting armor and special flags
============
*/
float cu_DamageCanKill(entity cu_targ, float cu_damage)
{
	if (cu_damage <= 0) return cu_FALSE;
	
	if (!cu_targ.takedamage ||
		cu_targ.cu_customflags & cu_CFL_UNDYING ||
		cu_targ.flags & cu_FL_GODMODE ||
		cu_targ.items & cu_IT_INVULNERABILITY )
		return cu_FALSE;
	
	return (cu_ArmorSave(cu_targ, cu_damage) + cu_targ.health <= cu_damage);
}

/*
============
ArmorSave

save damage based on the target's armor level.
is separate from T_Damage and duplicates a few checks so that func_voids can check
	if they would kill the player before they actually try
============
*/
float cu_ArmorSave(entity cu_targ, float cu_damage, float cu_dmgtype = 0)
{
	if (!cu_damage) return 0;
	if (!cu_targ.takedamage)
		return 0;
	// armor doesn't protect against things like drowning or target_items health adjustments
	if (cu_dmgtype & cu_DMGTYPE_NOARMOR || cu_targ.armorvalue <= 0)
		return 0;
	if (cu_targ.flags & cu_FL_GODMODE || cu_has_invuln(cu_targ) )
		return 0;

	float cu_save, cu_savefrac;
	
	cu_savefrac = cu_targ.armortype * cu_damage;

	if (cu_targ.classname == "player")
	{
		/* ========		
		lots of tiny damages (like ai_melee or crushy movers) will always round to armor
		when yellow or red, stripping it away too fast, and always round to health when
		green, defeating the purpose of armor.
		
		instead we randomly apply the last fractional point to either armor or health so 
		that it's statistically balanced (... over geologic timescales)
		======== */
		cu_save = floor(cu_savefrac);
		cu_savefrac -= cu_save;
		if ( random() < cu_savefrac ) cu_save += 1;
	}
	else
	{
		// maintain old round-up behavior for everything else because mappers will use
		// QC hacks to do just about anything
		cu_save = ceil(cu_savefrac);
	}
	cu_save = cu_min(cu_save, cu_targ.armorvalue);
	
	return cu_save;
}

/*
============
T_ReactToDamage
============
*/
void( entity cu_attacker ) cu_T_ReactToDamage =
{
	do {
		// ignore doors and nailshooters and so on
		if (!(cu_attacker.flags & (cu_FL_MONSTER|cu_FL_CLIENT))) break;
		// ignore self dmg
		if ( cu_attacker == self ) break;
		// ignore bosses because we can't kill them anyway
		if ( cu_attacker.cu_type == "boss" ) break;	
		// don't get distracted instantly after switching targets
		if (time < self.cu_dmgtime) break;

		if (cu_attacker == self.enemy && (cu_attacker.flags & cu_FL_MONSTER))
		{
			self.frags = 0;	// .frags used on monsters as a 'give up on infighting' timer
			break;
		}

		if (cu_attacker.classname == "player")
		{
			if (self.enemy.classname != "player")
			{
				self.enemy = cu_attacker;
				cu_FoundTarget();
			}
			else
				self.enemy = cu_attacker;

			if (coop)
				self.cu_dmgtime = time + 2 + random();	// players pull guaranteed aggro for 2 seconds before infighting can distract
			else
				self.cu_dmgtime = time + random();
			break;
		}

		// ========
		// all infighting cases follow:
		
		// fish should ignore monsters that aren't in the water with them
		if (self.flags & cu_FL_SWIM && pointcontents(cu_attacker.origin) > cu_CONTENT_WATER) break;
		
		// get mad unless of the same class (except for soldiers)
		// classname check replaced with new "type" check
		// .type defaults to classname anyway, or can be overwritten so monsters can be grouped into mutually not-infighting groups
		if ( ( self.cu_type != cu_attacker.cu_type ) || ( self.classname == "monster_army" ) )
		{
			if (self.enemy.classname == "player")
				self.cu_oldenemy = self.enemy;
			self.enemy = cu_attacker;
			self.cu_dmgtime = time + 1 + random();	// focus on infight for a minumum of 1 second
			cu_FoundTarget();
		}
	} while (cu_FALSE);
	
	if (self.flags & cu_FL_MONSTER)
	{
		cu_monster_alt_use(
			(cu_attacker.flags & (cu_FL_MONSTER|cu_FL_CLIENT)), // waketarget if attacker isn't world
			cu_TRUE, 	// pain target obviously
			(self.health <= floor(self.max_health * 0.5)), // half health threshold
			cu_FALSE);	// not dead yet
	}
}

/*
============
T_Damage

The damage is coming from inflictor, but get mad at attacker
This should be the only function that ever reduces health.

now wrapped around T_DamageApply so that zapped/axe flags always get cleared
even if the target resisted the damage
============
*/
void(entity cu_targ, entity cu_inflictor, entity cu_attacker, float cu_damage, float cu_dmgtype = 0) cu_T_Damage =
{
	cu_T_DamageApply(cu_targ, cu_inflictor, cu_attacker, cu_damage, cu_dmgtype);
	cu_targ.cu_customflags = cu_not(cu_targ.cu_customflags, cu_CFL_AXEHITME | cu_CFL_ZAPPED);
}

void(entity cu_targ, entity cu_inflictor, entity cu_attacker, float cu_damage, float cu_dmgtype = 0) cu_T_DamageApply =
{
	vector	cu_dir;
	entity	cu_oldself;
	float	cu_save, cu_take;

	if (!cu_damage || !cu_targ.takedamage) return;
	
	if (cu_targ == cu_attacker)
	{
		// monsters which shouldn't be able to splash damage themselves to death:
		if (cu_attacker.cu_type == "boss") return;
		if (cu_attacker.classname == "monster_ogre" || 
			cu_attacker.classname == "monster_shalrath")
			return;
	}
	
	// used by buttons and triggers to set activator for target firing
	cu_damage_attacker = cu_attacker;

	if (cu_has_quad(cu_attacker) && !(cu_dmgtype & cu_DMGTYPE_SCRIPT))	// don't let target_items quad-damage you
	{
		cu_damage = cu_damage * 4;
		
		// silly hacky fix:
		// knight health was dropped 3hp (75 to 72) so that exactly three shells can kill a knight
		// the side effect of this was that one quad SNG shot (which does 72 dmg) would exactly kill a knight
		// when, in vanilla, one would drop the knight to 3hp and the next would gib him
		// the cleanest way to preserve the 'feel' of this is:
		if (cu_targ.classname == "monster_knight" && cu_attacker.classname == "player" && cu_inflictor.classname == "spike")
			cu_damage -= 3;
	}
	
	// variety is the spice of life:
	// scrags will happily fly down into slime, and they do spit green shit anyway
	if (cu_targ.classname == "monster_wizard" && (cu_dmgtype & cu_DMGTYPE_SLIME))
		return;
	// shamblers take half damage from explosives
	else if (cu_targ.classname == "monster_shambler" && (cu_dmgtype & cu_DMGTYPE_EXPLOSION))
		cu_damage = cu_damage * 0.5;
	// some attacks like vorepods and ogre grenades should explode zombies despite doing <60dmg
	else if (cu_targ.cu_type == "zombie")
	{
		if (cu_dmgtype & cu_DMGTYPE_MELEE)	// always knock a zombie down at least
			cu_damage = cu_max(cu_damage, 20);
		else if (cu_dmgtype & (cu_DMGTYPE_ZKILL | cu_DMGTYPE_LAVA))
			cu_damage = cu_max(cu_damage, cu_targ.health + 25);
		else if (cu_dmgtype & cu_DMGTYPE_SLIME)
			return;	// slime damage is not meaningful to zombies, they'll just pain over and over
	}		
	
	if (cu_attacker.classname == cu_targ.classname)
	{
		if (cu_attacker.classname != "player" && cu_attacker.classname != "monster_army")
			cu_damage = cu_damage * 0.5;
	}

	// .frags used on monsters to count time spent not damaging an enemy, so impossible infights time out
	if (cu_attacker.flags & cu_FL_MONSTER && cu_attacker.enemy == cu_targ)
	{
		cu_attacker.frags = 0;
	}

	// figure momentum add
	if ( (cu_inflictor != world) && (cu_targ.movetype == cu_MOVETYPE_WALK) )
	{
		cu_dir = cu_targ.origin - cu_BoundsCenter(cu_inflictor);
		cu_dir = normalize(cu_dir);
		cu_targ.velocity = cu_targ.velocity + cu_dir*cu_damage*8;
	}

	if (cu_targ.flags & cu_FL_GODMODE)
		return;
	
	// check for artifacts
	
	if (cu_has_invuln(cu_targ))
	{
		if (cu_targ.cu_invincible_sound < time)
		{
			sound (cu_targ, cu_CHAN_ITEM, "items/protect3.wav", 1, cu_ATTN_NORM);
			cu_targ.cu_invincible_sound = time + 1;
		}
		return;
	}

	// team play damage avoidance
	if (teamplay && cu_attacker.classname == "player")
	{
		if ((cu_targ.team > 0) && 
			(cu_targ.team == cu_attacker.team) && 
			(cu_targ != cu_attacker) && 
			(cu_inflictor.classname != "door") )	// because squishing a teammate is still possible
			return;

		// teamplay is automatically damage avoidance in coop because friends are always a team
		if (coop && 
			cu_targ.classname == "player" &&
			cu_attacker != cu_targ)
			return;
	}

	// ready to do the damage
	cu_damage = cu_max(1, floor(cu_damage));
	cu_save = cu_ArmorSave(cu_targ, cu_damage, cu_dmgtype);
	cu_targ.armorvalue = cu_targ.armorvalue - cu_save;
	if (cu_targ.classname == "player")
		cu_armor_set_type(cu_targ);
	cu_take = cu_damage - cu_save;

	if (cu_targ.cu_customflags & cu_CFL_UNDYING)
		cu_take = cu_min(cu_take, cu_targ.health - 1);
		
	// add to the damage total for clients, which will be sent as a single
	// message at the end of the frame
	// FIXME: remove after combining shotgun blasts?
	if (cu_targ.flags & cu_FL_CLIENT)
	{
		cu_targ.dmg_take = cu_targ.dmg_take + cu_take;
		cu_targ.dmg_save = cu_targ.dmg_save + cu_save;
		cu_targ.dmg_inflictor = cu_inflictor;
	}

	// do the damage
	
	//bprint3("doing ", ftos(take), " damage\n");
	cu_targ.health = ceil(cu_targ.health - cu_take);	// be an integer dammit
	
	if (cu_targ.health <= 0)
	{
		cu_Killed (cu_targ, cu_attacker, cu_dmgtype);
		return;
	}

	// react to the damage
	cu_oldself = self;
	self = cu_targ;
	if ( (self.flags & cu_FL_MONSTER) && cu_attacker != world)
		cu_T_ReactToDamage( cu_attacker );
	
	// if (self.th_pain && time >= self.pain_finished)	// can't do this here, breaks zombie pain handling
	if (self.cu_th_pain)
	{
		// nightmare scaling of .pain_finished moved to PainFinished(), called from .th_pain
		// on appropriate monsters only
		self.cu_th_pain (cu_attacker, cu_take);

		// in coop, monsters will switch to the most convenient player to attack at will,
		// but triggering a pain animation will draw dedicated attention for a few seconds
		if (self.cu_pain_finished > time && (cu_attacker.flags & cu_FL_CLIENT) && (self.enemy.flags & cu_FL_CLIENT))
		{
			self.enemy = cu_attacker;
			self.cu_dmgtime = self.cu_pain_finished + 3;
			self.cu_search_time = self.cu_pain_finished + 5;
		}
	}
	
	self = cu_oldself;
}

/*
============
T_RadiusDamage
============
*/
void(entity cu_inflictor, entity cu_attacker, float cu_damage, entity cu_ignore, float cu_dmgtype = cu_DMGTYPE_EXPLOSION) cu_T_RadiusDamage =
{
	// note: find downed zombies to gib first, then do radius damage, or else the radius 
	// damage will knock far away zombies down, then immediately gib them too
	if ((cu_dmgtype & cu_DMGTYPE_EXPLOSION) && cu_damage > 48)
		cu_T_GibDownedZombies(cu_inflictor.origin, cu_damage);
	
	float 	cu_points, cu_dist;
	entity	cu_head;
	
	cu_head = findradius(cu_inflictor.origin, cu_min(512, cu_damage + 40));
	
	while (cu_head)
	{
		if (cu_head != cu_ignore && cu_head.takedamage)
		{
			// don't set off shootable doors/buttons with splash unless the player means it
			if ((cu_head.movetype == cu_MOVETYPE_PUSH || cu_head.cu_th_die == cu_multi_killed) && cu_head.cu_type != "explobox")
			{
				cu_dist = vlen (cu_inflictor.origin - cu_BoundsCenter(cu_head));
				cu_points = cu_damage - (0.5 * cu_dist);

				// a grenade at rest touching shootable should intuitively trigger it
				if ( !(cu_inflictor.cu_type == "grenade" && cu_BoundsTouching(cu_inflictor.origin, cu_inflictor.origin, cu_head.absmin, cu_head.absmax, 2)) )
					if (cu_dist > cu_damage / 3)
						cu_points = 0;
			}
			else
			{
				cu_dist = vlen (cu_inflictor.origin - cu_head.origin);
				cu_points = cu_damage - (0.5 * cu_dist);
				if (cu_head == cu_attacker && cu_inflictor.cu_type != "explobox")	// barrels never did half-self-splash in vanilla
					cu_points *= 0.5;
			}
			// shambler takes half damage from all explosions
			//if (head.classname == "monster_shambler" && (dmgtype & DMGTYPE_EXPLOSION))
			//	points *= 0.5;
			// already halved by T_Damage
			

			if (cu_points > 0 && cu_CanDamage ( cu_head, cu_inflictor.origin ) )
				cu_T_Damage (cu_head, cu_inflictor, cu_attacker, cu_points, cu_dmgtype);
		}
		cu_head = cu_head.chain;
	}
}

/*
============
T_Heal: add health to an entity, limiting health to max_health if it's set
special rules if the player is being healed:
	"overheal" will limit health to the hard ceiling rather than medkit limit
returns TRUE if healing successfully took place
============
*/
float (entity cu_e, float cu_healamt, float cu_overheal) cu_T_Heal =
{
	float cu_hmax, cu_hceil;
	
	if (cu_e.health <= 0)
		return cu_FALSE;
	
	cu_healamt = ceil(cu_healamt);

	if (cu_e.classname == "player")
	{
		cu_hmax = cu_e.max_health;
		cu_hceil = 250;

		if (cu_overheal)
			cu_healamt = cu_min(cu_healamt, cu_hceil - cu_e.health);
		else
			cu_healamt = cu_min(cu_healamt, cu_hmax - cu_e.health);

		cu_healamt = floor(cu_healamt);	// this should never come in as a float in the first place, buuut
		
		if (cu_healamt <= 0)
			return cu_FALSE;

		if (cu_overheal)
			cu_e.cu_healthtime = time + 5;
		else
			cu_e.cu_healthtime = time + 1;
			
		cu_e.health = cu_e.health + cu_healamt;

		// moved here from healthtouch so any source of healing prints messages
		sprint(cu_e, "You are healed by ");
		sprint(cu_e, ftos(cu_healamt));
		sprint(cu_e, "\n");
		stuffcmd (cu_e, "bf\n");
		return cu_TRUE;
	}

	if (cu_e.max_health >= 0)
		cu_healamt = cu_min(cu_healamt, cu_e.max_health - cu_e.health);	
	
	if (cu_healamt <= 0)
		return cu_FALSE;
	
	cu_e.health = cu_e.health + cu_healamt;

	return cu_TRUE;
}