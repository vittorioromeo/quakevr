void() cu_bodyqueue =
{	// just here so spawn functions don't complain after the world creates bodyqueues
}

void() cu_InitBodyQueue =
{
	entity cu_bq;
	cu_bq = spawn();
	cu_bq.classname = "bodyqueue";
	cu_bq.owner = cu_bq;
	
	cu_bodyqueue_head = cu_bq;
	float cu_i = 0;
	while (cu_i < 5)
	{
		cu_bq = spawn();
		cu_bq.classname = "bodyqueue";
		cu_bq.owner = cu_bodyqueue_head.owner;
		cu_bodyqueue_head.owner = cu_bq;
		cu_i++;
	}
	
	/*
	bodyqueue_head.owner = spawn();
	bodyqueue_head.owner.classname = "bodyqueue";
	bodyqueue_head.owner.owner = spawn();
	bodyqueue_head.owner.owner.classname = "bodyqueue";
	bodyqueue_head.owner.owner.owner = spawn();
	bodyqueue_head.owner.owner.owner.classname = "bodyqueue";
	bodyqueue_head.owner.owner.owner.owner = bodyqueue_head;*/
}


// make a body queue entry for the given ent so the ent can be
// respawned elsewhere
void(entity cu_ent) cu_CopyToBodyQueue =
{
	cu_bodyqueue_head.angles = cu_ent.angles;
	cu_bodyqueue_head.model = cu_ent.model;
	cu_bodyqueue_head.modelindex = cu_ent.modelindex;
	cu_bodyqueue_head.frame = cu_ent.frame;
	cu_bodyqueue_head.colormap = cu_ent.colormap;
	cu_bodyqueue_head.movetype = cu_ent.movetype;
	cu_bodyqueue_head.velocity = cu_ent.velocity;
	cu_bodyqueue_head.flags = 0;
	setorigin (cu_bodyqueue_head, cu_ent.origin);
	setsize (cu_bodyqueue_head, cu_ent.mins, cu_ent.maxs);
	cu_bodyqueue_head = cu_bodyqueue_head.owner;
}