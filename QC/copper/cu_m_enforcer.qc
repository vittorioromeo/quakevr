vector() cu_enforcer_muzzle_org =
{
	vector cu_vec, cu_right;
	cu_vec = normalize(cu_enemy_vispos() - self.origin);
	cu_right = cu_CrossProduct(cu_vec, '0 0 1');

	return (self.origin + cu_vec * 24 + cu_right * 6 + '0 0 16');
}

float() cu_enforcer_clear_attack =
{
	vector cu_spot1, cu_spot2;

	if (cu_has_invis(self.enemy)) return cu_TRUE;	// blast away

	cu_spot1 = cu_enforcer_muzzle_org();
	cu_spot2 = cu_enemy_vispos() + self.enemy.view_ofs;

	cu_traceline2(cu_spot1, cu_spot2, self, cu_TRACE_WATER);

	if (trace_inopen && trace_inwater) return cu_FALSE;	// sight line crossed contents
	if (trace_ent != self.enemy) return cu_FALSE;			// don't have a clear shot
	return cu_TRUE;
}

float() cu_enforcer_check_attack =
{
	float cu_chance;

	if (time < self.cu_attack_finished) return cu_FALSE;
	if (cu_enemy_range >= cu_RANGE_FAR) return cu_FALSE;
	if (!cu_enforcer_clear_attack()) return cu_FALSE;

	if (cu_enemy_range == cu_RANGE_MELEE)
	{
		cu_chance = 0.9;
		self.cu_attack_finished = 0;
	}
	else if (cu_enemy_range == cu_RANGE_NEAR)
		cu_chance = 0.4;
	else if (cu_enemy_range == cu_RANGE_MID)
		cu_chance = 0.2;
	else
		cu_chance = 0;

	if (random() < cu_chance)
	{
		self.cu_attack_state = cu_AS_MISSILE;
		cu_ai_attack_finished (2*random());
		return cu_TRUE;
	}

	return cu_FALSE;
}

void() cu_enforcer_fire =
{
	vector cu_org, cu_vec;

	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	sound (self, cu_CHAN_WEAPON, "enforcer/enfire.wav", 1, cu_ATTN_NORM);

	cu_org = cu_enforcer_muzzle_org();
	cu_vec = normalize(cu_enemy_vispos() - cu_org + cu_enemy_aim_vertical());
	
	makevectors(self.angles);	
	if (cu_angledif(self.ideal_yaw, self.angles_y) > 80)	// no ass lasers
	{
		cu_vec_x = v_forward_x;
		cu_vec_y = v_forward_y;
		cu_vec = normalize(cu_vec);
	}
	
	cu_launch_laser(cu_org, cu_vec * 600);
}

