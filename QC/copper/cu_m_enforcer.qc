void() cu_enf_die =
{
// check for gib
	if (self.health < -35)
	{
		cu_Gib ("progs/h_mega.mdl", self.health);
		return;
	}

// regular death
	sound (self, cu_CHAN_VOICE, "enforcer/death1.wav", 1, cu_ATTN_NORM);
	if (random() > 0.5)
		cu_enf_die1 ();
	else
		cu_enf_fdie1 ();
}


void() cu_monster_enforcer_spawn =
{
	self.classname = "monster_enforcer";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/enforcer.mdl");

	setsize (self, '-16 -16 -24', '16 16 40');
	self.health = 80;

	self.cu_th_stand = cu_enf_stand1;
	self.cu_th_walk = cu_enf_walk1;
	self.cu_th_run = cu_enf_run1;
	self.cu_th_pain = cu_enf_pain;
	self.cu_th_die = cu_enf_die;
	self.cu_th_missile = cu_enf_atk1;
	self.cu_th_checkattack = cu_enforcer_check_attack;

	if (self.deathtype == cu_string_null)
		self.deathtype = "was blasted by an Enforcer";

	cu_walkmonster_start();
}

void() cu_monster_enforcer_spawner = {cu_mon_spawner_use(cu_monster_enforcer_spawn);}


/*cu:QUAKED monster_enforcer (1 0 0) (-16 -16 -24) (16 16 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Enforcer, 80 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry
"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-16 -16 -24, 16 16 40) model({ "path": ":progs/enforcer.mdl" }) = monster_enforcer : "Enforcer" []
*/
void() cu_monster_enforcer =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model2 ("progs/enforcer.mdl");
	precache_model2 ("progs/h_mega.mdl");
	precache_model2 ("progs/laser.mdl");

	precache_sound2 ("enforcer/death1.wav");
	precache_sound2 ("enforcer/enfire.wav");
	precache_sound2 ("enforcer/enfstop.wav");
	precache_sound2 ("enforcer/idle1.wav");
	precache_sound2 ("enforcer/pain1.wav");
	precache_sound2 ("enforcer/pain2.wav");
	precache_sound2 ("enforcer/sight1.wav");
	precache_sound2 ("enforcer/sight2.wav");
	precache_sound2 ("enforcer/sight3.wav");
	precache_sound2 ("enforcer/sight4.wav");

	self.health = 80;
	setsize (self, '-16 -16 -24', '16 16 40');
	if ( cu_monster_spawnsetup( cu_monster_enforcer_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_enforcer_spawn();
}
