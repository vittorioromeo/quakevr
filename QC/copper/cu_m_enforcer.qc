void(entity cu_attacker, float cu_damage)	cu_enf_pain =
{
	if (self.cu_pain_finished > time)
		return;

	float cu_r;
	self.yaw_speed = 20;
	
	cu_r = random();
	if (cu_skill == 3) cu_r *= 0.75;	// nightmare: longest stun is very rare
	
	if (cu_r < 0.5)
		sound (self, cu_CHAN_VOICE, "enforcer/pain1.wav", 1, cu_ATTN_NORM);
	else
		sound (self, cu_CHAN_VOICE, "enforcer/pain2.wav", 1, cu_ATTN_NORM);

	if (cu_r < 0.2)
		cu_enf_paina1 ();
	else if (cu_r < 0.4)
		cu_enf_painb1 ();
	else if (cu_r < 0.7)
		cu_enf_painc1 ();
	else
		cu_enf_paind1 ();
}

