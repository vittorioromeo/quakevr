float() cu_enf_shouldbreak =
{
	if (!cu_alive(self.enemy) || self.enemy.cu_customflags & cu_CFL_LIMBO )
		return cu_TRUE;
	
	cu_enemy_range = cu_range(self.enemy);
	if (cu_enemy_range >= cu_RANGE_TOOFAR)
		return cu_TRUE;
	
	if (cu_angledif(self.ideal_yaw, self.angles_y) > 80)	// player got behind us
		return cu_TRUE;
	
	// randomly break volley if player is being sneaky or backs out of attack range
	if ((cu_has_invis(self.enemy) || cu_enemy_range >= cu_RANGE_FAR) && random() > 0.80)
	{
		cu_ai_attack_finished(0.25 + random());
		return cu_TRUE;
	}
	// force a little maneuvering if LOS is broken
	if (!cu_enforcer_clear_attack())
	{
		cu_ai_attack_finished(1 + random());
		return cu_TRUE;
	}
	return cu_FALSE;
}

