/*
===========================================
BUTTONS

button and multiple button
for all your button
===========================================
*/

void() cu_button_wait =	// hit top
{
	self.state = cu_STATE_TOP;
	self.nextthink = self.ltime + self.wait;
	self.think = cu_button_return;
	cu_activator = self.enemy;
	self.frame = 1;			// use alternate textures
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	if (!cu_SUB_UseTargetsAlt(cu_target2))
		cu_SUB_UseTargets();
}

void() cu_button_done =	// hit bottom
{
	self.frame = 0;			// use normal textures
	self.state = cu_STATE_BOTTOM;
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	cu_SUB_UseTargetsAlt(cu_target4);
}

void() cu_button_return =	// go down
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	self.state = cu_STATE_DOWN;
	cu_SUB_CalcMove (self.pos1, self.speed, cu_button_done);
	self.frame = 0;			// use normal textures
	if (self.health)
		self.takedamage = cu_DAMAGE_YES;	// can be shot again
	cu_SUB_UseTargetsAlt(cu_target3);
}


void() cu_button_blocked =
{	// do nothing, just don't ome all the way back out
}


void() cu_button_fire =	// go up
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	if (self.state == cu_STATE_UP || self.state == cu_STATE_TOP)
		return;

	if (self.noise != cu_string_null)
		sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);

	self.state = cu_STATE_UP;
	cu_SUB_UseTargetsAlt(target);
	cu_SUB_CalcMove (self.pos2, self.speed, cu_button_wait);
}


void() cu_button_use =
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	self.enemy = cu_activator;
	
	if (self.state == cu_STATE_UP || self.state == cu_STATE_DOWN)
		return;
	
	cu_button_fire ();
}

void() cu_button_touch =
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	if (other.classname != "player" || other.health <= 0)
		return;
		
	self.enemy = other;
	cu_button_fire ();
}

// must preserve locked status until the end of the move so none of the four alt targets fire
void() cu_button_done_unlock =
{
	cu_button_done();
	self.cu_customflags = cu_not(self.cu_customflags,cu_CFL_LOCKED);	
}

void(float cu_unlock) cu_button_lock =
{
	if (cu_unlock)
	{
		if (self.max_health)
		{
			self.takedamage = cu_DAMAGE_YES;
			self.health = self.max_health;
		}
		self.frame = 0;			// use normal textures
		self.state = cu_STATE_DOWN;
		cu_SUB_CalcMove (self.pos1, self.speed, cu_button_done_unlock);
	}
	else
	{
		self.cu_customflags |= cu_CFL_LOCKED;
		if (self.max_health)
			self.takedamage = cu_DAMAGE_NO;
		self.state = cu_STATE_UP;
		cu_SUB_CalcMove (self.pos2, self.speed, cu_button_wait);
	}
}

