void() cu_button_killed =
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	self.enemy = cu_damage_attacker;
	self.health = self.max_health;
	self.takedamage = cu_DAMAGE_NO;	// wil be reset upon return
	cu_button_fire();
}

void(entity cu_b) cu_button_force =
{
	cu_b.enemy = self;
	cu_SUB_CallAsSelf(cu_button_fire, cu_b);
}

void() cu_button_sounds =
{
	if (self.sounds == 0)
	{
		self.noise = "buttons/airbut1.wav";
	}
	else if (self.sounds == 1)
	{
		self.noise = "buttons/switch21.wav";
	}
	else if (self.sounds == 2)
	{
		self.noise = "buttons/switch02.wav";
	}
	else if (self.sounds == 3)
	{
		self.noise = "buttons/switch04.wav";
	}
	else if (self.sounds == 4)
	{
		self.noise = "misc/trigger1.wav";
	}
	cu_precache_sound_safe (self.noise);
}

/*cu:QUAKED func_button (0 .5 .8) ? - - - - - - - START_INVIS
When a button is touched, it moves some distance in the direction of its angle, triggers all of its targets, waits some time, then returns to its original position where it can be triggered again.
Acts as if touched when triggered. Will depress itself when locked by a target_lock to look inactive.

"angle"		determines the opening direction
"target"	all entities with a matching targetname will be used
"speed"		override the default 40 speed
"wait"		override the default 1 second wait (-1 = never return)
"lip"		override the default 4 pixel lip remaining at end of move
"health"	if set, the button must be killed instead of touched
"sounds"
0) steam metal
1) wooden clunk
2) metallic click
3) in-out
4) trigger noise (big light switch)

Alt Target Pattern: 'target' when touched, 'target2' when fully depressed, 'target3' when returning, 'target4' when fully out.
*/
/*FGD
@SolidClass base(Appearflags, Angle, Target, Targetname, Func, FuncInvis, AltTarget) = func_button : 
"Button. When a button is touched, it moves some distance in the direction of its angle, triggers all of its targets, waits some time, then returns to its original position where it can be triggered again.
Acts as if touched when triggered. Depresses itself when locked by a target_lock to look inactive.

Alt Target Pattern: 'target' when touched, 'target2' when fully depressed, 'target3' when returning, 'target4' when fully out." 
[
	speed(integer) : "Speed" : 40
	health(integer) : "Health (shootable if > 0)"
	lip(integer) : "Lip remaining at end of move" : 4
	distance(string) : "Distance to travel (overrides Lip)" : "0.0"
	sounds(choices) : "Sounds" = 
	[
		-1 : "None/Custom (set 'noise')"
		0 : "Steam metal"
		1 : "Wooden clunk"
		2 : "Metallic clink"
		3 : "In-out"
		4 : "Trigger noise (big light switch)"
	]
	wait(string) : "Delay before reset" : "1"
	message(string) : "Message" 
	noise(string) : "Wav to play if sounds is -1" 
]
*/
void() cu_func_button =
{
	if (!cu_SUB_ShouldSpawn()) return;
	cu_button_sounds();
	cu_SetMovedir ();

	if (!self.speed)
		self.speed = 40;
	if (!self.wait)
		self.wait = 1;
	if (!self.lip)
		self.lip = 4;

	self.state = cu_STATE_BOTTOM;
	
	if (self.spawnflags & 128)
		self.use = cu_func_button_spawn;
	else
		cu_func_button_spawn();
}

void() cu_func_button_spawn =
{
	self.movetype = cu_MOVETYPE_PUSH;
	self.solid = cu_SOLID_BSP;
	setmodel (self, self.model);

	// after setmodel so self.size is set
	self.distance = cu_zeroconvertdefault(self.distance, 
		fabs(self.movedir*self.size) - self.lip);
	self.pos1 = self.origin;
	self.pos2 = self.pos1 + self.movedir * self.distance;

	self.blocked = cu_button_blocked;
	self.use = cu_button_use;
	self.cu_lock = cu_button_lock;

	if (self.health)
	{
		self.max_health = self.health;
		self.cu_th_die = cu_button_killed;
		self.takedamage = cu_DAMAGE_YES;
	}
	else
		self.touch = cu_button_touch;

	// do proper lock stuff in case the untriggered entity was locked
	if (self.cu_customflags & cu_CFL_LOCKED)
		cu_button_lock(cu_FALSE);
}


/*
===========================================
SKILL BUTTON

special button that has to react to other skill buttons being pressed, 
and the skill cvar changing at the console, and not be stupid about it

supports door fade lighting
hides like a locked button but doesn't count as locked status
registers itself with a global ent as a skill entity, chains itself
startframe checks for cvar change and walks the chain flipping status
===========================================
*/
entity cu_skill_head;

void() cu_skillbutton_go_up =
{
	if (self.state == cu_STATE_UP || self.state == cu_STATE_TOP) return;
	
	float cu_spd;
	self.state = cu_STATE_UP;
	self.frame = 1;
	if (self.max_health)
		self.takedamage = cu_DAMAGE_NO;
	
	if (cu_initCleanup || time < 1.2)
		cu_spd = cu_A_SHITLOAD;
	else
	{
		if (self.noise != cu_string_null)
			sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
		cu_spd = self.speed;
	}

	cu_SUB_CalcMoveLight(self.pos1, self.pos2, cu_spd, cu_skillbutton_hit_top, cu_FALSE);

	cu_SUB_UseTargetsAlt(target);
}

void() cu_skillbutton_hit_top =
{
	self.state = cu_STATE_TOP;
	if (!cu_SUB_UseTargetsAlt(cu_target2))
		cu_SUB_UseTargetsSilent();
	cu_bmodel_lightstyle(self, 0);
	
	// special message handling:
	// one button will always be set at map start, and we don't want a mystery message
	// printing when the start map loads announcing the skill you already have set at
	// the console
	if (self.enemy && self.enemy.classname == "player")
	{
		cu_centerprintall(self.message);
		self.enemy = world;
	}
}

void() cu_skillbutton_go_down =
{
	if (self.state == cu_STATE_DOWN || self.state == cu_STATE_BOTTOM) return;
	
	float cu_spd;
	self.state = cu_STATE_DOWN;
	self.enemy = world;
	
	if (cu_initCleanup || time < 1.2)
		cu_spd = cu_A_SHITLOAD;
	else
		cu_spd = self.speed2;
	
	cu_SUB_CalcMoveLight(self.pos2, self.pos1, cu_spd, cu_skillbutton_hit_bottom, cu_TRUE);

	cu_SUB_UseTargetsAlt(cu_target3);
}

void() cu_skillbutton_hit_bottom =
{
	self.state = cu_STATE_BOTTOM;
	self.frame = 0;	
	cu_bmodel_lightstyle(self, 1);
	if (self.max_health)
	{
		self.takedamage = cu_DAMAGE_YES;
		self.health = self.max_health;
	}
	cu_SUB_UseTargetsAlt(cu_target4);
}

void() cu_skillbutton_activate =
{
	float cu_match;
	
	// skill_str is already set immediately after loading a game, and is always
	// set by activating a skill-changing entity, so it's the most accurate
	cu_match = ((cu_skill_str == cu_string_null && cu_skill == self.cu_strength) ||
			(cu_skill_str != cu_string_null && cu_skill_str == self.netname));
	
	if (cu_match)
		cu_skillbutton_go_up();
	else
		cu_skillbutton_go_down();
}

void() cu_skillbutton_touch =
{
	if (!cu_CheckValidTouch()) return;
	
	if (self.state != cu_STATE_BOTTOM) return;
	self.enemy = other;
	cu_skill_set(self.netname);
}
void() cu_skillbutton_use =
{
	self.enemy = cu_activator;
	cu_skill_set(self.netname);
}
void() cu_skillbutton_die =
{
	self.enemy = cu_damage_attacker;
	cu_skill_set(self.netname);
}


/*cu:QUAKED func_button_skill (0 .5 .8) ? EASY NORMAL HARD NIGHTMARE SILENT
Special button for selecting skill level. Will always be pressed when the skill corresponding to the chosen spawnflag is set. Changes its state automatically when other skill buttons are pressed, when trigger_setskills are touched, or when skill is changed live at the console.

"message"	override message printed to clients when button is touched or used (or use SILENT spawnflag for no message)
"angle"		determines the opening direction
"target"	all entities with a matching targetname will be used
"speed"		override the default 40 speed
"wait"		override the default 1 second wait (-1 = never return)
"lip"		override the default 4 pixel lip remaining at end of move
"health"	if set, the button must be killed instead of touched
"sounds"
0) steam metal
1) wooden clunk
2) metallic click
3) in-out
4) trigger noise (big light switch)

Alt Target Pattern: 'target' when touched, 'target2' when fully depressed, 'target3' when returning, 'target4' when fully out.
*/
/*FGD
@SolidClass base(Appearflags, Angle, Target, Func, AltTarget) = func_button_skill : 
"Special button for selecting skill level. Will always be pressed when the skill corresponding to the chosen spawnflag is set. Changes its state automatically when other skill buttons are pressed, when trigger_setskills are touched, or when skill is changed live at the console.

Alt Target Pattern: 'target' when touched, 'target2' when fully depressed, 'target3' when returning, 'target4' when fully out." 
[
	spawnflags(Flags) = [
		1 : "Easy" : 0
		2 : "Normal" : 1
		4 : "Hard" : 0
		8 : "Nightmaaare" : 0
		16 : "No centerprint" : 0
	]
	speed(integer) : "Speed" : 40
	health(integer) : "Health (shootable if > 0)"
	lip(integer) : "Lip remaining at end of move" : 4
	distance(string) : "Distance to travel (overrides Lip)" : "0.0"
	sounds(choices) : "Sounds" = 
	[
		-1 : "None/Custom (set 'noise')"
		0 : "Steam metal"
		1 : "Wooden clunk"
		2 : "Metallic clink"
		3 : "In-out"
		4 : "Trigger noise (big light switch)"
	]
	message(string) : "Override skill selected message" 
	noise(string) : "Wav to play if sounds is -1" 
]
*/void() cu_func_button_skill =
{
	if (!cu_SUB_ShouldSpawn()) return;

	cu_button_sounds();
	cu_SetMovedir ();

	if (!self.speed)
		self.speed = 40;
	if (!self.speed2)
		self.speed2 = self.speed;
	if (!self.lip)
		self.lip = 4;

	if (cu_skill_head)
		self.owner = cu_skill_head;
	cu_skill_head = self;

	if (self.style || self.cu_switchshadstyle)
	{
		if (self.style < 0)
		{
			self.style *= -1;
			self.cu_customflags |= cu_CFL_INVLIGHT;
		}
		cu_bmodel_lightstyle(self, 1);
	}
	
	self.state = cu_STATE_BOTTOM;
	self.movetype = cu_MOVETYPE_PUSH;
	self.solid = cu_SOLID_BSP;
	setmodel (self, self.model);
	self.distance = cu_zeroconvertdefault(self.distance, 
		fabs(self.movedir*self.size) - self.lip);
	self.pos1 = self.origin;
	self.pos2 = self.pos1 + self.movedir * self.distance;

	self.blocked = cu_button_blocked;
	self.use = cu_skillbutton_use;

	if (self.health)
	{
		self.max_health = self.health;
		self.cu_th_die = cu_skillbutton_die;
		self.takedamage = cu_DAMAGE_YES;
	}
	else
		self.touch = cu_skillbutton_touch;

	if (self.spawnflags & 1)
	{
		self.cu_strength = 0;
		self.netname = "0";
	}
	else if (self.spawnflags & 4)
	{
		self.cu_strength = 2;
		self.netname = "2";
	}
	else if (self.spawnflags & 8)
	{
		self.cu_strength = 3;
		self.netname = "3";
	}
	else	// 2 or default
	{
		self.cu_strength = 1;
		self.netname = "1";
	}

	if (self.spawnflags & 16)	// silent
		self.message = cu_string_null;
	else if (self.message == cu_string_null)
	{
		if (self.spawnflags & 1)
			self.message = "EASY skill selected";
		else if (self.spawnflags & 4)
			self.message = "HARD skill selected";
		else if (self.spawnflags & 8)
			self.message = "\bNIGHTMARE\b skill selected";
		else	// 2 or default
			self.message = "NORMAL skill selected";
	}

	self.think = cu_skillbutton_activate;	// assume correct position and set up any related target states
	self.nextthink = self.ltime + 0.2;
}