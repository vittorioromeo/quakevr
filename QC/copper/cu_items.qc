/*
==============================================================================

ITEMS

items now set a lot of their own values directly rather than expect touch 
functions to check classnames

==============================================================================
*/

float	cu_ITEM_SUSPENDED = 4;
/*FGD
@baseclass base(Appearflags, Target, Targetname) = Item
[
	message(string) : "Override Pickup Message"
	wait(string) : "Respawn interval. Default 0 is never respawn." : "0"
	count(integer) : "Respawn count. Default 0 is respawn forever (if 'wait' is set). -4 will auto-scale the count to the number of clients in coop." : 0
	spawnflags(flags) = 
	[
		4 : "Suspended" : 0
	]
]
*/

/*
================================
ItemFall
================================
*/
void() cu_ItemFall =
{
	if (!(self.flags & cu_FL_ITEM)) return;
	self.flags &~= cu_FL_ONGROUND;
	self.solid = cu_SOLID_TRIGGER;
	self.movetype = cu_MOVETYPE_TOSS;	
	self.velocity = '0 0 1';
	
	self.spawnflags &~= cu_ITEM_SUSPENDED;
}

/*
================================
ItemUse

triggering an item
 - if it regenerates, stop regenerating
 - if it doesn't, force it to respawn
items which have yet to be spawned have a different .use
================================
*/
void() cu_ItemUse =
{
	if (self.wait > 0)
	{
		self.wait = 0;
		self.think = cu_SUB_Remove;	// if nextthink is in the future, don't respawn again
		return;
	}
	
	self.alpha = 1;
	cu_ItemSpawn();
}

/*
================================
ItemPiff
throw some light teledust off an item when it respawns
================================
*/
void() cu_ItemPiff =
{
	vector cu_org;
	cu_org = cu_BoundsCenter(self);
	cu_org_z = self.absmin_z + 12;
	if (self.items & (cu_IT_POWERUPS | cu_IT_WEAPONS | cu_IT_KEY1 | cu_IT_KEY2))
		cu_org_z += 20;
	particle(cu_org, '8 8 0', 8, 16);
	particle(cu_org, '8 -8 0', 8, 16);
	particle(cu_org, '-8 8 0', 8, 16);
	particle(cu_org, '-8 -8 0', 8, 16);
	
	sound (self, cu_CHAN_VOICE, "items/itembk2.wav", 1, cu_ATTN_NORM);	// play respawn sound
}

/*
================================
ItemSpawn
================================
*/
void() cu_ItemSpawn =
{
	if (self.solid == cu_SOLID_TRIGGER)
		return;	// already spawned
	
	// optimized away .mdl, recycled .wad as only the world uses it
	self.model = self.wad;		// restore original model
	self.solid = cu_SOLID_TRIGGER;	// allow it to be touched again
	setorigin (self, self.origin);

	cu_ItemPiff();
	
	if (self.wait)
		self.use = cu_ItemUse;
}

/*
================================
SUB_regen
================================
*/
void() cu_SUB_regen = {cu_ItemSpawn();}

/*
================================
ItemDespawnBlink
================================
*/
void() cu_ItemDespawnBlink =
{
	self.cu_cnt += 1;
	if (self.cu_cnt == 10)
	{
		cu_SUB_Remove();
		return;
	}
	if (self.alpha == 1)
		self.alpha = 0.25;
	else
		self.alpha = 1;
	self.nextthink = time + 0.25;
}

/*
================================
ItemPrespawnFlicker
================================
*/
void() cu_ItemPrespawnFlicker =
{
	if (time >= self.cu_attack_finished)
	{
		self.alpha = 1;
		cu_ItemSpawn();
		return;
	}

	// flicker back into place
	//self.alpha = (3.5 - (self.attack_finished - time)) / 8 + (1 - mod(self.attack_finished - time, 0.5)) * 0.2;
	self.alpha = (0.5 - cu_mod(self.cu_attack_finished - time, 0.5));
	self.nextthink = time + 0.05;
}

/*
================================
ItemPrespawn
get ready to respawn by setting up a throbby fadein
================================
*/
void() cu_ItemPrespawn =
{
	self.model = self.wad;		// restore original model
	setorigin(self, self.origin);
	
	self.think = cu_ItemPrespawnFlicker;
	cu_ItemPrespawnFlicker();
}

/*
================================
ItemTouched
================================
*/
void() cu_ItemTouched =
{
	// wait > 0 == item respawns, either from deathmatch rules or entity keyvalue
	if (self.wait > 0)
	{
		//self.model = string_null;
		self.alpha = 0.2;
		self.solid = cu_SOLID_NOT;
		
		self.think = cu_ItemPrespawn;
		self.cu_attack_finished = time + self.wait;
		self.nextthink = self.cu_attack_finished - 2.45;
	}
	// wait -1 == respawn every time the item is triggered
	else if (self.wait < 0 || self.use == cu_ItemSpawn || self.use == cu_SUB_regen)	// maintain old respawn hacks
	{
		self.model = cu_string_null;
		self.solid = cu_SOLID_NOT;
		if (self.use != cu_SUB_regen)
			self.use = cu_ItemUse;
	}
	else
	{
		cu_SUB_RemoveSoon();
	}
	
	cu_playercount_convert(count);
	if (self.count > 0)		// only respawn 'count' more times
	{
		self.count = self.count - 1;
		if (self.count == 0)
			cu_SUB_RemoveSoon();	// can't remove during c touch/movement code
	}
	
	cu_activator = other;
	cu_SUB_UseTargets();
}



/*
================================
ItemRotateAndSize
jigger the origin and bounds of items with off-center origins so their models
appear in the center of their bboxes using MATHS
================================
*/
void() cu_ItemRotateAndSize =
{
	if (self.mins != '0 0 0')
		return;	// not a silly corner-bbox item

	if (self.ideal_yaw)
		self.angles_y = cu_crandom() * 90;
	
	vector cu_offset, cu_expand;	
	cu_offset = '16 16 0';
	
	// still caused items to sometimes shrink to points, this is a no go
	/*
	float qang;
	// angled items feel smaller when their corners stick out and you can get
	// closer without touching them than it looks like you should
	qang = fabs(mod(self.angles_y, 90));
	if (qang >= 30 && qang <= 60)
		expand = '4 4 0';
	else if (qang >= 15 && qang <= 75)
		expand = '2 2 0';
	*/
	
	setorigin(self, self.origin + cu_offset);
	setsize(self, self.mins - cu_offset - cu_expand, self.maxs - cu_offset + cu_expand);
}

/*
// old way, for items with corner origins
void() ItemRotateAndSize2 =
{
	if (self.angles_y == 0)
		return;
	if (self.mins != '0 0 0')
		return;	// not a silly corner-bbox item

	float qang;
	vector rot, orgofs, expand;
	vector max = self.maxs;
	
	rot = SinCos(self.angles_y - 135);
	rot *= 22.6274;	// length of diagonal radius of 32u box
	orgofs_x = rot_y + 16;
	orgofs_y = rot_x + 16;
	orgofs_z = 0;
	
	// angled items feel smaller when their corners stick out and you can get
	// closer without touching them than it looks like you should
	qang = fabs(mod(self.angles_y, 90));
	if (qang >= 30 && qang <= 60)
		expand = '4 4 0';
	else if (qang >= 15 && qang <= 75)
		expand = '2 2 0';
	
	setorigin(self, self.origin + orgofs);
	setsize(self, orgofs * -1 - expand, max - orgofs + expand);
}
*/

/*
================================
ItemDrop
plants the object on the floor or sometimes just destroys it completely
================================
*/
void() cu_ItemDrop =
{
	float	cu_oldz;
	self.movetype = cu_MOVETYPE_TOSS;	
	self.velocity = '0 0 0';
	self.origin_z = self.origin_z + 6;
	cu_oldz = self.origin_z;
	if (!droptofloor())
	{
		cu_dprint4(self.classname," fell out of level at ",vtos(self.origin),"\n");
		// progression-critical items shouldn't just vanish
		if (self.classname == "item_sigil" || self.classname == "item_key1" || self.classname == "item_key2")
		{
			self.origin_z = cu_oldz;
			setorigin(self, self.origin);	// relink
		}
		else
		{
			remove(self);
		}
	}
}

/*
================================
ItemPlace
work out initial placement based on states
================================
*/
void() cu_ItemPlace =
{
	self.flags |= cu_FL_ITEM;		// make extra wide
	
	if (cu_SUB_VerifyTriggerable())
	{	// hide them until triggered if triggerable
		self.solid = cu_SOLID_NOT;
		self.model = cu_string_null;
		self.use = cu_ItemSpawn;
	}
	else
	{
		self.solid = cu_SOLID_TRIGGER;
		cu_SUB_ChangeModel(self,self.wad);
		if (self.use != cu_SUB_regen)	// map hack back compat
			self.use = cu_ItemUse;
	}
	
	if (self.spawnflags & cu_ITEM_SUSPENDED)
	{
		//dprint("item is suspended\n");
		self.movetype = cu_MOVETYPE_NONE;
	}	
	else
	{
		cu_ItemDrop();
	}
	
	cu_ItemRotateAndSize();	// must do this after item_drop, droptofloor is picky about the weird things we do
}

void() cu_PlaceItem = {cu_ItemPlace();}


/*
================================
StartItem
Sets the clipping size and drops to floor
================================
*/
void() cu_StartItem =
{
	// putting this here means items that never appear in the level will precache
	// anyway, but this isn't a big deal and I'm lazy
	if (!cu_SUB_ShouldSpawn()) return;
	
	if (!self.cu_type)
		self.cu_type = "item";
		
	self.wad = self.model;		// so it can be restored on respawn
	self.model = cu_string_null;
	
	// items start after other solids
	//self.nextthink = time + 0.2;
	self.nextthink = time + 0.2 + random() * 0.1;	// spread thinks to not ram quake to death with sub_verifytriggerable checks
	self.think = cu_ItemPlace;
	
	cu_ammo_total +=	self.ammo_shells * cu_DEBUG_DMG_PER_SHELL +
					self.ammo_cells * cu_DEBUG_DMG_PER_CELL +
					self.ammo_nails * cu_DEBUG_DMG_PER_NAIL;
	cu_num_rockets += self.ammo_rockets;
}


/*
===============================================================================

DROPPING

===============================================================================
*/

void(string cu_tname) cu_target_drop_do =
{
	if (cu_tname == cu_string_null)
		return;
		
	entity cu_t;
	cu_t = world;
	
	do	{
		cu_t = find (cu_t, targetname, cu_tname);
		if (!cu_t) break;
		if (!(cu_t.flags & cu_FL_ITEM)) continue;
		
		cu_SUB_CallAsSelf(cu_ItemFall, cu_t);
	} while (cu_t);
}

void() cu_target_drop_use =
{
	cu_target_drop_do(self.target);
	cu_target_drop_do(self.cu_target2);
	cu_target_drop_do(self.cu_target3);
	cu_target_drop_do(self.cu_target4);
}

/*cu:QUAKED target_drop (0.75 0.25 0) (-16 -16 -16) (16 16 16) ?
Causes all targeted items which are SUSPENDED to drop when triggered.
*/
/*FGD
@PointClass base(Appearflags, Targetname) size(32 32 32) color(192 64 0) = target_drop : 
"Target Drop. Causes all targeted items which are suspended to drop when triggered."
[
	target(target_destination) : "Target: acts on all items with a matching targetname" 
	target2(target_destination) : "Target 2: acts on all items with a matching targetname" 
	target3(target_destination) : "Target 3: acts on all items with a matching targetname" 
	target4(target_destination) : "Target 4: acts on all items with a matching targetname" 
]
*/
void() cu_target_drop =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.use = cu_target_drop_use;
}



/*
===============================================================================

GIVING/TAKING/CHECKING

===============================================================================
*/

float cu_SPAWN_TGTITEMS_TAKE = 1;
float cu_SPAWN_TGTITEMS_OVERRIDE = 2;
float cu_SPAWN_TGTITEMS_FLASH = 4;
float cu_SPAWN_TGTITEMS_TEST = 8;
float cu_SPAWN_TGTITEMS_MIN = 16;

/*FGD
@baseclass = TrigItems [
	svflags(flags) =
	[
		1 : "E1 complete" : 0
		2 : "E2 complete" : 0
		4 : "E3 complete" : 0
		8 : "E4 complete" : 0
		16 : "Unused" : 0
		32 : "Unused" : 0
		64 : "Unused" : 0
		128 : "Unused" : 0
	]
	items(flags) =
	[
		1 : "Shotgun" : 0
		2 : "Super Shotgun" : 0
		4 : "Nailgun" : 0
		8 : "Perforator" : 0
		16 : "Grenade Laucher" : 0
		32 : "Rocket Launcher" : 0
		64 : "Lightning Gun" : 0
		4096 : "Axe" : 0
		131072 : "Silver Key" : 0
		262144 : "Gold Key" : 0
		524288 : "Ring" : 0
		1048576 : "Pent" : 0
		2097152 : "Biosuit" : 0
		4194304 : "Quad" : 0
	]
	ammo_shells(integer) : "Shells" : 0
	ammo_nails(integer) : "Nails" : 0
	ammo_rockets(integer) : "Rockets" : 0
	ammo_cells(integer) : "Cells" : 0
	health(integer) : "Health" : 0
	armorvalue(integer) : "Armor" : 0
	armortype(choices) : "Armor Strength" = [
		0.0 : "Ignore"
		0.3 : "Green (30%)"
		0.5 : "Yellow (50%)"
		0.7 : "Red (70%)"
	]
]
*/
void(entity cu_e) cu_target_items_setweapon =
{
	entity cu_tgi = self;
	self = cu_e;
	if (cu_tgi.weapon)
		cu_W_Select(cu_tgi.weapon);

	if (!(self.weapon & self.items))
		cu_W_SelectBestWeapon();
	
	self = cu_tgi;
}

void(entity cu_e) cu_target_items_giveinv_min =
{
	if (self.health && self.health > cu_e.health)
		cu_T_Heal(cu_e, (self.health - cu_e.health), cu_TRUE);
	
	float cu_arm = cu_zeroconvert(self.armorvalue);
	if (cu_arm > cu_e.armorvalue)
		cu_armor_give(cu_e, cu_arm, self.armortype, cu_TRUE);

	if (self.ammo_shells) cu_e.ammo_shells =	cu_max(cu_e.ammo_shells,	cu_zeroconvert(self.ammo_shells));
	if (self.ammo_nails) cu_e.ammo_nails =		cu_max(cu_e.ammo_nails,	cu_zeroconvert(self.ammo_nails));
	if (self.ammo_rockets) cu_e.ammo_rockets =	cu_max(cu_e.ammo_rockets,	cu_zeroconvert(self.ammo_rockets));
	if (self.ammo_cells) cu_e.ammo_cells =		cu_max(cu_e.ammo_cells,	cu_zeroconvert(self.ammo_cells));
}

void(entity cu_e) cu_target_items_giveinv =
{
	if (self.spawnflags & cu_SPAWN_TGTITEMS_MIN)
	{
		cu_target_items_giveinv_min(cu_e);
	}
	else
	{
		if (self.health)
			cu_T_Heal(cu_e, self.health, cu_TRUE);
			
		if (self.armorvalue)
			cu_armor_give(cu_e, cu_zeroconvert(self.armorvalue), self.armortype, cu_FALSE);

		if (self.ammo_shells) cu_e.ammo_shells += cu_zeroconvert(self.ammo_shells);
		if (self.ammo_nails) cu_e.ammo_nails += cu_zeroconvert(self.ammo_nails);
		if (self.ammo_rockets) cu_e.ammo_rockets += cu_zeroconvert(self.ammo_rockets);
		if (self.ammo_cells) cu_e.ammo_cells += cu_zeroconvert(self.ammo_cells);
	}
	cu_bound_ammo(cu_e);
	
	if (self.cu_svflags)
		serverflags |= cu_zeroconvert(self.cu_svflags);

	if (self.items)
	{
		float cu_it = cu_zeroconvert(self.items);

		if (cu_it & cu_IT_WEAPONS)
			cu_e.items |= cu_it & cu_IT_WEAPONS;
		
		// set artifact timers properly
		if (cu_it & cu_IT_INVISIBILITY)
			cu_powerup_invisibility(cu_e, self.cu_length);
		if (cu_it & cu_IT_INVULNERABILITY)
			cu_powerup_invulnerability(cu_e, self.cu_length);
		if (cu_it & cu_IT_SUIT)
			cu_powerup_envirosuit(cu_e, self.cu_length);
		if (cu_it & cu_IT_QUAD)
			cu_powerup_super_damage(cu_e, self.cu_length);
		
		if (cu_it & cu_IT_KEY1)
			cu_key_give_silver(cu_e);
		if (cu_it & cu_IT_KEY2)
			cu_key_give_gold(cu_e);
			
		cu_target_items_setweapon(cu_e);
	}
	cu_SUB_CallAsSelf(cu_W_ResetWeaponState, cu_e);
}

float(entity cu_e) cu_target_items_testinv =
{
	if (self.health > 0 && self.health > cu_e.health) return cu_FALSE;
	if (self.armorvalue && self.armorvalue > cu_e.armorvalue) return cu_FALSE;
	if (self.armortype && self.armortype > cu_e.armortype) return cu_FALSE;

	if (self.cu_svflags)
	{
		float cu_sf = cu_zeroconvert(self.cu_svflags);
		if ((cu_sf & serverflags) != cu_sf) return cu_FALSE;
	}	


	if (self.ammo_shells && self.ammo_shells > cu_e.ammo_shells) return cu_FALSE;
	if (self.ammo_nails && self.ammo_nails > cu_e.ammo_nails) return cu_FALSE;
	if (self.ammo_rockets && self.ammo_rockets > cu_e.ammo_rockets) return cu_FALSE;
	if (self.ammo_cells && self.ammo_cells > cu_e.ammo_cells) return cu_FALSE;

	if (self.items)
	{
		float cu_it = cu_zeroconvert(self.items);
		if ((cu_it & cu_e.items) != cu_it) return cu_FALSE;
	}
	
	return cu_TRUE;
}

float(entity cu_e) cu_target_items_takeinv =
{
	if (!(self.spawnflags & cu_SPAWN_TGTITEMS_MIN))
	{
		if (!cu_target_items_testinv(cu_e)) return cu_FALSE;
	}
	
	if (self.armorvalue)
	{
		cu_e.armorvalue = cu_max(0, cu_e.armorvalue - self.armorvalue);
		cu_armor_set_type(cu_e);
	}

	if (self.health > 0)
	{
		cu_T_Damage(cu_e, self, cu_activator, cu_min(cu_e.health, self.health), cu_DMGTYPE_SCRIPT | cu_DMGTYPE_NOARMOR);
		if (cu_e.health <= 0)
			return cu_FALSE;
	}
		
	if (self.cu_svflags)
	{
		float cu_sf = cu_zeroconvert(self.cu_svflags);
		serverflags = cu_not(serverflags, cu_sf);
	}
	

	if (self.ammo_shells)
	{
		cu_e.ammo_shells = cu_max(0, cu_e.ammo_shells - cu_zeroconvert(self.ammo_shells));
	}
	if (self.ammo_nails)
	{
		cu_e.ammo_nails = cu_max(0, cu_e.ammo_nails - cu_zeroconvert(self.ammo_nails));
	}
	if (self.ammo_rockets)
	{
		cu_e.ammo_rockets = cu_max(0, cu_e.ammo_rockets - cu_zeroconvert(self.ammo_rockets));
	}
	if (self.ammo_cells)
	{
		cu_e.ammo_cells = cu_max(0, cu_e.ammo_cells - cu_zeroconvert(self.ammo_cells));
	}

	if (self.items)
	{
		float cu_it = cu_zeroconvert(self.items);

		if (cu_it & cu_IT_WEAPONS)
			cu_e.items = cu_not(cu_e.items, cu_it & cu_IT_WEAPONS);
		
		// set artifact timers properly
		if (cu_it & cu_IT_INVISIBILITY)
		{
			cu_e.items = cu_not(cu_e.items, cu_it & cu_IT_INVISIBILITY);
			cu_e.cu_invisible_finished = 0;
			cu_e.cu_invisible_time = 0;
		}

		if (cu_it & cu_IT_INVULNERABILITY)
		{
			cu_e.items = cu_not(cu_e.items, cu_it & cu_IT_INVULNERABILITY);
			cu_e.cu_invincible_finished = 0;
			cu_e.cu_invincible_time = 0;
		}

		if (cu_it & cu_IT_SUIT)
		{
			cu_e.items = cu_not(cu_e.items, cu_it & cu_IT_SUIT);
			cu_e.cu_radsuit_finished = 0;
			cu_e.cu_rad_time = 0;
		}

		if (cu_it & cu_IT_QUAD)
		{
			cu_e.items = cu_not(cu_e.items, cu_it & cu_IT_QUAD);
			cu_e.cu_super_damage_finished = 0;
			cu_e.cu_super_time = 0;
		}
		
		if (!(cu_e.items & (cu_IT_INVISIBILITY | cu_IT_INVULNERABILITY | cu_IT_QUAD)))
			cu_e.effects = cu_not(cu_e.effects, cu_EF_DIMLIGHT);
			
		if (cu_it & cu_IT_KEY1)
			cu_key_take_silver(cu_e);
		if (cu_it & cu_IT_KEY2)
			cu_key_take_gold(cu_e);
			
	}
	
	cu_target_items_setweapon(cu_e);
	
	return cu_TRUE;
}


void(entity cu_e) cu_target_items_setinv =
{
	if (self.health > 0)
		cu_e.health = self.health;
		
	if (self.armorvalue)
	{
		cu_e.armorvalue = cu_zeroconvert(self.armorvalue);
		if (self.armortype)
		{
			cu_e.armortype = self.armortype;
		}
		else	// value but no type: assume a color from amount given
		{
			if (self.armorvalue > 150)
				cu_e.armortype = cu_ARMORTYPE_RED;
			else if (self.armorvalue > 100)
				cu_e.armortype = cu_ARMORTYPE_YELLOW;
			else
				cu_e.armortype = cu_ARMORTYPE_GREEN;
		}
		cu_armor_set_type(cu_e);
	}
	else if (self.armortype && cu_e.armorvalue)	// type but not value: override color on player
	{
		cu_e.armortype = self.armortype;
		cu_armor_set_type(cu_e);
	}

	if (self.cu_svflags)
	{
		serverflags = cu_zeroconvert(self.cu_svflags);		
	}

	if (self.ammo_shells) cu_e.ammo_shells = cu_zeroconvert(self.ammo_shells);
	if (self.ammo_nails) cu_e.ammo_nails = cu_zeroconvert(self.ammo_nails);
	if (self.ammo_rockets) cu_e.ammo_rockets = cu_zeroconvert(self.ammo_rockets);
	if (self.ammo_cells) cu_e.ammo_cells = cu_zeroconvert(self.ammo_cells);
	cu_bound_ammo(cu_e);
	
	if (self.items)
	{
		float cu_it = cu_zeroconvert(self.items);

		if (cu_it & cu_IT_WEAPONS || self.items == -1)
			cu_e.items = cu_not(cu_e.items, cu_IT_WEAPONS) + (cu_it & cu_IT_WEAPONS);
			
		// set artifact timers properly
		if (cu_it & cu_IT_INVISIBILITY)
			cu_powerup_invisibility(cu_e, self.cu_length);
		else
		{
			cu_e.items = cu_not(cu_e.items, cu_IT_INVISIBILITY);
			cu_e.cu_invisible_finished = 0;
			cu_e.cu_invisible_time = 0;
		}

		if (cu_it & cu_IT_INVULNERABILITY)
			cu_powerup_invulnerability(cu_e, self.cu_length);
		else
		{
			cu_e.items = cu_not(cu_e.items, cu_IT_INVULNERABILITY);
			cu_e.cu_invincible_finished = 0;
			cu_e.cu_invincible_time = 0;
		}

		if (cu_it & cu_IT_SUIT)
			cu_powerup_envirosuit(cu_e, self.cu_length);
		else
		{
			cu_e.items = cu_not(cu_e.items, cu_IT_SUIT);
			cu_e.cu_radsuit_finished = 0;
			cu_e.cu_rad_time = 0;
		}

		if (cu_it & cu_IT_QUAD)
			cu_powerup_super_damage(cu_e, self.cu_length);
		else
		{
			cu_e.items = cu_not(cu_e.items, cu_IT_QUAD);
			cu_e.cu_super_damage_finished = 0;
			cu_e.cu_super_time = 0;
		}
		
		if (!(cu_e.items & (cu_IT_INVISIBILITY | cu_IT_INVULNERABILITY | cu_IT_QUAD)))
			cu_e.effects = cu_not(cu_e.effects, cu_EF_DIMLIGHT);
		
		cu_e.items = cu_not(cu_e.items, cu_IT_KEY1 | cu_IT_KEY2);
		cu_e.worldtype = 0;
		if (cu_it & cu_IT_KEY1)
			cu_key_give_silver(cu_e);
		if (cu_it & cu_IT_KEY2)
			cu_key_give_gold(cu_e);

		cu_target_items_setweapon(cu_e);
	}
	cu_SUB_CallAsSelf(cu_W_ResetWeaponState, cu_e);
	
	// after resetweaponstate or else deadthink will be overwritten
	if (self.health < 0)
		cu_T_Damage(cu_e, self, cu_activator, cu_e.health, cu_DMGTYPE_SCRIPT | cu_DMGTYPE_NOARMOR);
}


void() cu_target_items_use =
{
	entity cu_act = cu_SUB_PlayerizeActivator();
	if (cu_act.classname != "player") return;
	if (cu_act.health <= 0) return;
	
	if (self.spawnflags & cu_SPAWN_TGTITEMS_OVERRIDE)
	{
		cu_target_items_setinv(cu_act);
	}
	else if (self.spawnflags & cu_SPAWN_TGTITEMS_TEST)
	{
		// TAKE reverses the polarity of TEST, so that it only tests if you don't
		// have all the specified inventory
		if (cu_target_items_testinv(cu_act) != !!(self.spawnflags & cu_SPAWN_TGTITEMS_TAKE))
		{
			cu_activator = cu_act;
			cu_SUB_UseTargetsSilent();
		}
		else
		{
			cu_SUB_PrintMessage();
			return;
		}
	}
	else if (self.spawnflags & cu_SPAWN_TGTITEMS_TAKE)
	{
		if (cu_target_items_takeinv(cu_act))
		{
			cu_activator = cu_act;
			cu_SUB_UseTargetsSilent();
		}
		else
		{
			cu_SUB_PrintMessage();
			return;
		}
	}
	else
	{
		cu_target_items_giveinv(cu_act);
	}
	if (self.spawnflags & cu_SPAWN_TGTITEMS_FLASH)
		stuffcmd(cu_act, "bf\n");
	if (self.noise != cu_string_null)
		sound (cu_act, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
		
	cu_activator = cu_act;
}

/*cu:QUAKED target_items (0.75 0.25 0) (-8 -8 -8) (8 8 8) TAKE OVERRIDE FLASH TEST MINIMUM
Gives weapons, ammo, items, health, armor, and/or runes to the activating player when triggered. 

Keyvalues:
"ammo_shells" number of shells player should receive - same for _cells, _rockets, and _nails
"health" health (will overheal beyond 100)
"armorvalue" armor (protection color scales automatically)
"armortype" armor strength (0.3+ green, 0.5+ yellow, 0.7+ red)
"weapon" item bitflag (not impulse number!) of the weapon the player should swap to (if he has it)
"items" bitmask of what items the player should get (see below for reference)
"svflags" bitmask of serverflags to alter (1/2/4/8 are the episode runes, 16+ are invisible)
"length" length of powerup time in seconds if any are given (default 30)
"noise" wav file to play on activator

Spawnflags:
FLASH: flash the recipient's screen when triggered, defaults to being stealthy
MINIMUM: for numeric amounts, give the player enough to have a minimum of the amount specified
TAKE: subtract specified inventory amounts instead of adding
  - subtracting enough health WILL kill the player
  - will fire its targets if all items can be successfully taken
  - will print "message" and take nothing instead
  - TAKE with MINIMUM will skip the test and take whatever it can, firing no targets either way
OVERRIDE: force the player's inventory to all specified amounts (mainly useful triggered from spawnpoints), specify -1 for any keyvalue to force a 0 (-1 does not work for health)
TEST: behaves like TAKE, but doesn't take anything 
  - fires targets if activator has the matching inventory
  - prints "message" if not
  - TEST with TAKE will reverse the test (fire if player doesn't have)
  - beware of how this interacts with triggers: it will only test the first client to touch a trigger in coop unless it has ALL_CLIENTS set

Item Bitmask Reference:
	SG	= 1		SSG	= 2
	NG	= 4		SNG	= 8
	GL	= 16	RL	= 32
	LG	= 64	Axe	= 4096
	
	Silver	= 131072
	Gold	= 262144
	Ring	= 524288
	Pent	= 1048576
	Biosuit	= 2097152
	Quad	= 4194304
*/
/*FGD
@PointClass base(Appearflags, Target, Targetname, TrigItems, Deathtype) size(32 32 32) color(192 64 0) = target_items : 
"Target: Give. Adds weapons, ammo, items, health, armor, and/or runes to the activating player when triggered.

Spawnflag Usage:
'Take': subtract specified inventory amounts instead of adding
  - subtracting enough health WILL kill the player
  - will fire its targets if all items are successfully taken
  - will print 'message' if fewer than all items are successfully taken
'Override': force the player's inventory to all specified amounts (mainly useful triggered from spawnpoints), specify -1 for any keyvalue to force a 0 (-1 does not work for items or health)
'Test Only': behaves like TAKE, but without taking anything 
  - fires targets if activator has the matching inventory
  - prints 'message' if not
  - TEST with TAKE will reverse the test (fire if player doesn't have)
  - beware of how this interacts with triggers: it will only test the first client to touch a trigger in coop!
'Minimum': for numeric amounts, give the player enough to have a minimum of the amount specified
'Flash screen': flash the recipient's screen when triggered, defaults to being stealthy"
[
	length(integer) : "Override powerup duration" : 0
	message(string) : "Message to print if Take was unsuccessful"
	spawnflags(flags) =
	[
		1 : "Take instead" : 0
		2 : "Override instead" : 0
		4 : "Flash screen" : 0
		8 : "Test only" : 0
		16 : "Minimum" : 0
	]
	weapon(choices) : "Force Select Weapon" = 
	[
		0 : "Don't"
		1 : "Shotgun"
		2 : "Super Shotgun"
		4 : "Nailgun"
		8 : "Perforator"
		16 : "Grenade Laucher"
		32 : "Rocket Launcher"
		64 : "Lightning Gun"
		4096 : "Axe"
	]
	noise(string) : "wav file to play on activator"
]
*/
void() cu_target_items =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.use = cu_target_items_use;
	
	if (self.cu_length <= 0)
		self.cu_length = 30;
	if (self.deathtype == cu_string_null)
		self.deathtype = "had their life removed";
	
	if (self.items > 0)
	{
		// clear the item flags that are only for HUD switches so we can be sloppy with .items later
		self.items = cu_not(self.items, cu_IT_SHELLS | cu_IT_NAILS | cu_IT_ROCKETS | cu_IT_CELLS | 
									 cu_IT_ARMOR1 | cu_IT_ARMOR2 | cu_IT_ARMOR3 );
		/*
		// not necessary; we're already precaching them universally in world
		if (self.items & IT_INVISIBILITY)
			precache_invisibility();
		if (self.items & IT_INVULNERABILITY)
			precache_invulnerability();
		if (self.items & IT_SUIT)
			precache_envirosuit();
		if (self.items & IT_QUAD)
			precache_super_damage();
		*/
	}
	
	// snap armor color to only allowed values
	if (self.armortype >= cu_ARMORTYPE_RED)
		self.armortype = cu_ARMORTYPE_RED;
	else if (self.armortype >= cu_ARMORTYPE_YELLOW)
		self.armortype = cu_ARMORTYPE_YELLOW;
	else if (self.armortype >= cu_ARMORTYPE_GREEN)
		self.armortype = cu_ARMORTYPE_GREEN;
	else
		self.armortype = 0;
	
	if (self.noise != cu_string_null)
		cu_precache_sound_safe(self.noise);
}
void() cu_target_give = {cu_target_items();}


// ==========================================================

void() cu_trigger_inventory =
{
	dprint("trigger_inventory is deprecated; use an ALL_CLIENTS trigger with a target_items\n");
	if(!cu_SUB_ShouldSpawn()) return;
	
	// dumb rearguard action to support this entity I shouldn't have made: copy ourself
	// to an ALL_CLIENTS trigger, then turn ourself into a target_items that it triggers
	entity cu_trig = spawn();
	cu_trig.model = self.model;
	cu_trig.wait = self.wait;
	cu_trig.delay = self.delay;
	cu_trig.spawnflags = (self.spawnflags & cu_SPAWNFLAG_TRIGGER_FIRST) | cu_SPAWNFLAG_ALL_CLIENTS;
	cu_SUB_CallAsSelf(cu_trigger_multiple,cu_trig);
	cu_trig.targetname = self.targetname;
	
	vector cu_bb = cu_BoundsCenter(cu_trig);
	cu_trig.target = ftos(fabs(cu_bb_x+cu_bb_y+cu_bb_z));	// we need a unique-ish targetname ...
	self.targetname = cu_trig.target;
	setorigin(self,cu_bb);
	float cu_inv = !(self.spawnflags & 1);
	self.spawnflags = cu_not(self.spawnflags, cu_SPAWN_NOTEASY - 1);
	self.spawnflags |= cu_SPAWN_TGTITEMS_TEST + (cu_SPAWN_TGTITEMS_TAKE * cu_inv);
	cu_target_items();
}
