void() cu_boss_death1 = [$death1, cu_boss_death2] {
	self.takedamage = cu_DAMAGE_NO;
	sound (self, cu_CHAN_VOICE, "boss1/death.wav", 1, cu_ATTN_NORM);
	if (self.health == -99)	// telefragged or crushed or something
	{
		self.solid = cu_SOLID_NOT;
		cu_ThrowGib ("progs/gib1.mdl", cu_GibVelocityForHealth(96));
		cu_ThrowGib ("progs/gib2.mdl", cu_GibVelocityForHealth(97));
		cu_ThrowGib ("progs/gib3.mdl", cu_GibVelocityForHealth(98));
		cu_ThrowGib ("progs/gib1.mdl", cu_GibVelocityForHealth(99));
		cu_ThrowGib ("progs/gib2.mdl", cu_GibVelocityForHealth(101));
		cu_ThrowGib ("progs/gib3.mdl", cu_GibVelocityForHealth(103));
	}
}
