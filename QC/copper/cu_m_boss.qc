void() cu_boss_death9 = [$death9, cu_boss_death10]
{
	// moved kill count here to break boss_death10 killcount hack, as it was only 
	// used to fix the rotfish killcount bug (iw)
	if (!(self.spawnflags & 1))
	{
		killed_monsters = killed_monsters + 1;
		WriteByte (cu_MSG_ALL, cu_SVC_KILLEDMONSTER);
	}
	
	sound (self, cu_CHAN_BODY, "boss1/out1.wav", 1, cu_ATTN_NORM);
	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_BROADCAST, cu_TE_LAVASPLASH);
	WriteCoord (cu_MSG_BROADCAST, self.origin_x);
	WriteCoord (cu_MSG_BROADCAST, self.origin_y);
	WriteCoord (cu_MSG_BROADCAST, self.origin_z);
}

void() cu_boss_death10 = [$death9, cu_boss_death10]
{
	if (!(self.spawnflags & 1))
	{
		cu_activator = self.enemy;
		cu_SUB_UseTargets();
	}
	remove (self);
}

void() cu_boss_missile_touch =
{
	sound(self, cu_CHAN_VOICE, "misc/null.wav", 0.5, cu_ATTN_STATIC);
	sound(self, cu_CHAN_WEAPON, "misc/null.wav", 0.5, cu_ATTN_STATIC);
	sound(self, cu_CHAN_BODY, "misc/null.wav", 0.5, cu_ATTN_STATIC);
	cu_T_MissileTouch();
}

void(float cu_chan) cu_boss_lavahiss =
{
	float cu_r = random();
	if (cu_r < 0.25)
		sound(self, cu_chan + 1, "weapons/lavabal1.wav", 1, cu_ATTN_STATIC);
	else if (cu_r < 0.5)
		sound(self, cu_chan + 1, "weapons/lavabal2.wav", 1, cu_ATTN_STATIC);
	else if (cu_r < 0.75)
		sound(self, cu_chan + 1, "weapons/lavabal3.wav", 1, cu_ATTN_STATIC);
	else
		sound(self, cu_chan + 1, "weapons/lavabal4.wav", 1, cu_ATTN_STATIC);
}

void() cu_boss_missile_think =
{
	self.state = cu_cycle(self.state, 3);
	cu_boss_lavahiss(self.state);
	self.nextthink = time + 0.1;
}

void(vector cu_p) cu_boss_missile =
{
	vector	cu_org, cu_vec, cu_dir;
	entity	cu_missile;
	float 	cu_hard, cu_spd, cu_lead;

	cu_org = self.origin + cu_p_x*v_forward + cu_p_y*v_right + cu_p_z * '0 0 1';
	
	// accelerate the projectile danger with each phase
	cu_hard = (1 - (self.health+self.armorvalue)/self.max_health);
	cu_spd = 300 + 200 * cu_hard;
	
	// lead the player on hard mode
	cu_lead = cu_skill * 0.333;
	cu_lead = cu_lead * cu_lead + 0.05 * cu_hard;
	if (self.enemy.teleport_time > time)	// don't instantly snipe the player the moment he teleports in
		cu_dir = normalize(cu_enemy_vispos() - cu_org);
	else
		cu_dir = cu_LeadTarget(cu_org, cu_spd, cu_min(cu_lead, 0.8));
	
	cu_vec = normalize (cu_dir);

	cu_missile = cu_launch_lavamissile (cu_org, cu_vec*cu_spd);
	cu_missile.avelocity = '200 100 300';
	cu_missile.dmg = 100;
	cu_missile.think = cu_boss_missile_think;
	cu_missile.nextthink = time;
	cu_missile.touch = cu_boss_missile_touch;
	sound (self, cu_CHAN_WEAPON, "boss1/throw.wav", 1, cu_ATTN_NORM);

	// check for dead enemy
	if (!cu_alive(self.enemy))
	{
		if (self.enemy.classname == "player")
		{
			if (!coop || (coop == 1 && !cu_clientsAlive))
				cu_boss_idle1 ();
			else
				cu_ReprioritizeEnemy();
		}
		else
			self.enemy = cu_get_closest_client();	// break out of infights with dead monsters
	}
}

void(entity cu_attacker, float cu_damage) cu_boss_pain =
{
	float cu_d;
	
	if (self.spawnflags & 1)
	{
		if (time < self.cu_pain_finished)
			return;
			
		if (self.health + cu_damage < self.max_health)	// always pain the first time, to ensure players recognize we're takedamage 1
		{
			if (self.cu_customflags & cu_CFL_ZAPPED)	// boost LG stun chance a little
				cu_d = cu_damage;
			else
				cu_d = cu_max(0, cu_damage - 30);
				
			if (cu_d <= 0)
				return;
			if (cu_d < random() * 400)
				return;
		}
	}
	
	sound (self, cu_CHAN_VOICE, "boss1/pain.wav", 1, cu_ATTN_NORM);
	
	cu_d = floor(3 * self.health / self.max_health);
	
	if (cu_d >= 2)
		cu_boss_shocka1();
	else if (cu_d == 1)
		cu_boss_shockb1();
	else if (cu_d == 0)
		cu_boss_shockc1();
		
	// potentially shorter than the missile throw anim
	self.cu_pain_finished = time + 1 + random() + random() * 2;
}

void() cu_boss_awake =
{
	self.cu_type = "boss";	// so nobody gets mad at us
	self.classname = "monster_boss";	// map hack back compat
	
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;
	
	setmodel (self, "progs/boss.mdl");
	setsize (self, '-128 -128 -24', '128 128 256');
	
	if (self.spawnflags & 1)
	{
		self.takedamage = cu_DAMAGE_AIM;
		self.flags |= cu_FL_MONSTER;
		self.health = cu_zeroconvertdefault(self.health, 1000);
		self.max_health = self.health;
	}
	else
	{
		self.takedamage = cu_DAMAGE_NO;
		if (cu_skill == 0)
			self.health = 1;
		else
			self.health = 3;
	}
	self.max_health = self.health + self.armorvalue;	// for hacked takedamage cthons

	self.enemy = cu_activator;
	if (self.enemy.classname != "player")
		self.enemy = cu_get_closest_client();	// just get mad at player1 for now

	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_BROADCAST, cu_TE_LAVASPLASH);
	WriteCoord (cu_MSG_BROADCAST, self.origin_x);
	WriteCoord (cu_MSG_BROADCAST, self.origin_y);
	WriteCoord (cu_MSG_BROADCAST, self.origin_z);

	self.yaw_speed = 20;
	cu_boss_rise1 ();
}


/*cu:QUAKED monster_boss (1 0 0) (-128 -128 -24) (128 128 256) SHOOTABLE
Ch'thon. Throws lava bombs until electrocuted to death.
The more health he's lost, and the higher the skill level the player is on, the more accurately he leads his shots.
The E1M7 boss fight requires an event_lightning.

If 'SHOOTABLE' is set, he'll bleed when shot, and die the old-fashioned way when shot enough. Can even be telefragged. 'Health' defaults to 1000.
*/
/*FGD
@PointClass base(Angle, Appearflags, Target, Targetname, Deathtype) size(-128 -128 -24, 128 128 256) color(240 0 0) model({ "path": ":progs/boss.mdl" }) = monster_boss : "Ch'thon. Throws lava bombs until electrocuted to death.
The more health he's lost, and the higher the skill level the player is on, the more accurately he leads his shots.
The E1M7 boss fight requires an event_lightning.

If 'shootable' is set, he'll bleed when shot, and die the old-fashioned way when shot enough. Can even be telefragged. Health defaults to 1000."
[
	spawnflags(Flags) =
	[
		1 : "Shootable" : 0
	]
	health(integer) : "Hit points, if shootable" : 1000
]
*/
void() cu_monster_boss =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	cu_precache_model_safe ("progs/boss.mdl");
	cu_precache_model_safe ("progs/lavaball.mdl");

	cu_precache_sound_safe ("weapons/rocket1i.wav");
	cu_precache_sound_safe ("weapons/lavabal1.wav");
	cu_precache_sound_safe ("weapons/lavabal2.wav");
	cu_precache_sound_safe ("weapons/lavabal3.wav");
	cu_precache_sound_safe ("weapons/lavabal4.wav");
	cu_precache_sound_safe ("boss1/out1.wav");
	cu_precache_sound_safe ("boss1/sight1.wav");
	cu_precache_sound_safe ("misc/power.wav");
	cu_precache_sound_safe ("boss1/throw.wav");
	cu_precache_sound_safe ("boss1/pain.wav");
	cu_precache_sound_safe ("boss1/death.wav");
	
	if (self.deathtype == cu_string_null)
		self.deathtype = "was owned by Chthon";

	total_monsters = total_monsters + 1;

	self.cu_type = "boss";	// so nobody gets mad at us
	self.use = cu_boss_awake;
	self.cu_th_pain = cu_boss_pain;
	self.cu_th_die = cu_boss_death1;
	self.cu_th_run = cu_boss_missile1;
	
	self.cu_th_stand = cu_boss_missile1;
	self.cu_th_walk = cu_boss_missile1;
	
	if (cvar("nomonsters") != 0)
		self.cu_lifetime_finished = -1;
}

//===========================================================================

void() cu_lightning_fire =
{
	vector	cu_p1, cu_p2;
	entity	cu_le1, cu_le2;
	
	cu_le1 = self.cu_buddy;
	cu_le2 = cu_le1.cu_buddy;
	
	if (time >= self.cu_attack_finished)
	{	// done here, put the terminals back up
		cu_activator = self.enemy;
		cu_SUB_CallAsSelf(cu_door_go_down, cu_le1);
		cu_SUB_CallAsSelf(cu_door_go_down, cu_le2);
		return;
	}
	
	cu_p1 = (cu_le1.mins + cu_le1.maxs) * 0.5;
	cu_p1_z = cu_le1.absmin_z - 8;
	
	cu_p2 = (cu_le2.mins + cu_le2.maxs) * 0.5;
	cu_p2_z = cu_le2.absmin_z - 8;
	
	// compensate for length of bolt
	cu_p2 = cu_p2 - normalize(cu_p2-cu_p1)*100;

	self.nextthink = time + 0.1;
	self.think = cu_lightning_fire;

	WriteByte (cu_MSG_ALL, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_ALL, cu_TE_LIGHTNING3);
	WriteEntity (cu_MSG_ALL, world);
	WriteCoord (cu_MSG_ALL, cu_p1_x);
	WriteCoord (cu_MSG_ALL, cu_p1_y);
	WriteCoord (cu_MSG_ALL, cu_p1_z);
	WriteCoord (cu_MSG_ALL, cu_p2_x);
	WriteCoord (cu_MSG_ALL, cu_p2_y);
	WriteCoord (cu_MSG_ALL, cu_p2_z);
}

void() cu_lightning_use =
{
	entity	cu_le1, cu_le2;
	
	if (self.cu_attack_finished >= time + 1)
		return;

	cu_le1 = find( world, target, "lightning");
	cu_le2 = find( cu_le1, target, "lightning");
	if (!cu_le1 || !cu_le2)
	{
		dprint ("missing lightning targets\n");
		return;
	}
	
	self.cu_buddy = cu_le1;
	cu_le1.cu_buddy = cu_le2;
	
	if ((cu_le1.state != cu_le2.state) || 
		(cu_le1.state != cu_STATE_TOP && cu_le1.state != cu_STATE_BOTTOM) ||
		(cu_le2.state != cu_STATE_TOP && cu_le2.state != cu_STATE_BOTTOM) )
	{
//		dprint ("not aligned\n");
		return;
	}

// don't let the electrodes go back up until the bolt is done
	cu_le1.nextthink = -1;
	cu_le2.nextthink = -1;
	self.cu_attack_finished = time + 1;

	self.enemy = cu_activator;
	sound (self, cu_CHAN_VOICE, "misc/power.wav", 1, cu_ATTN_NORM);
	cu_lightning_fire ();		

	if (cu_le1.state == cu_STATE_TOP && cu_le2.state == cu_STATE_TOP)
		cu_SUB_UseTargets();
		
	// advance the boss pain if down
	self = find (world, classname, "monster_boss");
	if (!self)
		return;
	if (cu_le1.state == cu_STATE_TOP && self.health > 0)
	{
		self.health = self.health - 1;
		cu_boss_pain(cu_activator, 1);
	}
	
}


/*cu:QUAKED event_lightning (0 1 1) (-16 -16 -16) (16 16 16)
Just for boss level. Fires targets on a successful zap.
*/
/*FGD
@PointClass base(Appearflags, Target, Targetname) color(0 255 255) = event_lightning : "Chthon lightning. Fires targets on a successful zap.
Setup is weird and special: it must find two func_doors each with a 'target' (not targetname) of 'lightning', and it will branch the lightning between the bottom center of each door. If both doors are closed it won't hurt Ch'thon, but if both are open, it will, and otherwise lightning won't happen at all. Lightning doesn't actually have to go through Ch'thon." []
*/
void() cu_event_lightning =
{
	if (!cu_SUB_ShouldSpawn()) return;
	precache_sound ("misc/power.wav");			//lightning for boss

	self.use = cu_lightning_use;
}



