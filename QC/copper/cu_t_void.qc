/*
=============
THE VOID

The bottoms of pits have to be lit so scrags are lit, but then you can see their bodies at 
the bottom along with heads and shit.  Dead things are problematic to remove since they're 
all SOLID_NOT and don't touch triggers, and trying to undo that requires hacky stuff like 
thinking trigger bodies, and if you cover the bottom with a func static to just hide them 
inside it, the player still sees all the garbage when he falls down there and dies himself.

thus, a func_void:
- Sets itself as an invisible trigger that kills whatever touches it
- Creates a nonsolid 'ghost object' 32 units higher using its own brushmodel that hides 
	accumulated garbage
- Creates another trigger a specified height above itself that fades out players' view 
	when they fall through it

A player's screen has fully faded to black by the time he hits the ghost, so he doesn't
see the trash underneath.  Since he doesn't know he's not still falling, we can hold him 
in stasis for a little while longer before we splat him, to imply the pit is deeper than 
it really is (often not that deep).

===============
*/

const float cu_CSHIFT_CUTOFF = 90;
nosave float cu_noTint;

/*
============
TintScreen
============
*/
void(entity cu_who, float cu_amt) cu_TintScreen
{
//	bprint(ftos(amt)); bprint("\n");
	if (cu_noTint)
	{
		cu_who.cu_tint = cu_amt;
		cu_who.cu_tint_color = '0 0 0';
	}
	else
	{
		stuffcmd(cu_who, "\nv_cshift 0 0 0 ");
		stuffcmd(cu_who, ftos(cu_amt));
		stuffcmd(cu_who, "\n");
	}
}


/*
============
TintScreenColor
============
*/
void(entity cu_who, float cu_amt, vector cu_color) cu_TintScreenColor
{
	// cshifts are 0-255
	if (cu_color_x <= 1 && cu_color_y <= 1 && cu_color_z <= 1)
		cu_color *= 255;
	cu_color_x = ceil(cu_color_x);
	cu_color_y = ceil(cu_color_y);
	cu_color_z = ceil(cu_color_z);
	
	if (cu_noTint)
	{
		cu_who.cu_tint = cu_amt;
		cu_who.cu_tint_color = cu_color;
	}
	else
	{
		// ugh:
		stuffcmd(cu_who, "\nv_cshift ");
		stuffcmd(cu_who, ftos(cu_color_x));
		stuffcmd(cu_who, " ");
		stuffcmd(cu_who, ftos(cu_color_y));
		stuffcmd(cu_who, " ");
		stuffcmd(cu_who, ftos(cu_color_z));
		stuffcmd(cu_who, " ");
		stuffcmd(cu_who, ftos(cu_amt));
		stuffcmd(cu_who, "\n");
	}
}

/*
============
TintScreenFog

an ugly substitute for cshift
============
*/
void(entity cu_who, float cu_amt, vector cu_color) cu_TintScreenFog
{
	float cu_s, cu_d, cu_dx;
	vector cu_c;
	
	// initially store player's existing fog so we know what we're blending from
	if (!cu_who.cu_fog_density2)
	{
		if (!cu_who.fog_density)
		{
			cu_who.cu_fog_density2 = -1;
			cu_who.fog_color = cu_color;
			cu_who.cu_fog_color2 = cu_color;
		}
		else
		{
			cu_who.cu_fog_color2 = cu_who.fog_color;
			cu_who.cu_fog_density2 = cu_who.fog_density;
			cu_who.cu_fog_sky2 = cu_who.cu_fog_sky;
		}
	}
	
	// fog is 0-1
	if (cu_color_x > 1 || cu_color_y > 1 || cu_color_z > 1)
		cu_color /= 255;
	
	cu_c = cu_lerpVector(cu_who.cu_fog_color2, cu_color, cu_amt);
	cu_s = cu_lerp(cu_who.cu_fog_sky2, 1, cu_amt);
	
	// the fog density ramp in fitzquakes is astounding
	// this doesn't match it, but it looks right for the usual range of fogs maps have
	cu_d = cu_sqrt(cu_sqrt(cu_who.cu_fog_density2));	// un-steepen the existing value so we can map it linearly
	cu_d = cu_lerp(cu_d, 1, cu_amt);
	cu_d = cu_d * cu_d * cu_d * cu_d;	// the re-steepening
	if (cu_d > 0.5)
	{
		// add additional even more density, bc density 1 is only opaque at ~128u 
		// away and we want a solid screen by the time we hit bottom
		cu_dx = (cu_d-0.5) * 2;
		cu_d += cu_dx*cu_dx*20;
	}
	
	cu_noTint = 0;	// hack
	cu_fog_set(cu_who, cu_d, cu_c, cu_s);
	cu_noTint = 1;
}


// --------------------------------
// void_unplunge
// player was rescued, somehow, probably by being a noclipping whore
// --------------------------------
void(entity cu_e) cu_void_unplunge =
{
	cu_e.cu_customflags &~= cu_CFL_PLUNGE;
	//e.flags &~= FL_NOTARGET;
	cu_e.takedamage = cu_DAMAGE_AIM;
	cu_e.solid = cu_SOLID_SLIDEBOX;
	if (cu_e.movetype != cu_MOVETYPE_NOCLIP)
		cu_e.movetype = cu_MOVETYPE_WALK;
	cu_e.model = "progs/player.mdl";

	cu_SUB_CallAsSelf(cu_W_ResetWeaponState, cu_e);	// restore weaponmodel
	cu_TintScreen(cu_e,0);
}

// --------------------------------
// void_salvation
// sometimes we don't want to instantly murder the player for minor navigational errors
// --------------------------------
float(entity cu_me, entity cu_o) cu_void_salvation =
{
	// if this func_void targets a teledest, it's only for light punishment
	entity cu_spot = cu_void_find_teleport(cu_me);
	if (!cu_spot)
		return cu_FALSE;
	
	// light punishment is still lethal, proceed with the display
	if ( cu_DamageCanKill(cu_o, cu_me.dmg) )
		return cu_FALSE;
	
	cu_void_unplunge(cu_o);
	cu_o.velocity = '0 0 0';
	// damage has to come before the teleport, because in coop a player
	// might get put in teleport limbo and be TAKEDAMAGE_NO until reappearing
	if (cu_me.dmg > 0)
	{
		cu_T_Damage(cu_o, cu_me, cu_me, cu_me.dmg, cu_DMGTYPE_FALLING);
		cu_teleport(cu_o, cu_spot, cu_TRUE, cu_TRUE);	
		sound (cu_o, cu_CHAN_VOICE, "player/land2.wav", 1, cu_ATTN_NORM);
	}
	else
		cu_teleport(cu_o, cu_spot, cu_TRUE, cu_TRUE);	
	return cu_TRUE;
}

// --------------------------------
// void_func_touch
// player hit the physical bottom of the pit but may not have hit the implied bottom
// --------------------------------
void() cu_void_func_touch =
{
	if ( other.solid == cu_SOLID_BSP || other.solid == cu_SOLID_TRIGGER )
		return;
	
	if ( cu_CheckValidTouch() )	// a living player not in noclip
	{

	//	other.customflags = not(other.customflags, CFL_UNDYING);
	//	other.customflags = not(other.customflags, CFL_PLUNGE);
		
		cu_TintScreenColor(other, 255, self.cu_fadecolor);
		other.velocity = '0 0 0';
		other.solid = cu_SOLID_NOT;
		other.movetype = cu_MOVETYPE_NONE;
		//other.flags = other.flags | FL_NOTARGET;
		other.weaponmodel = cu_string_null;
		other.model = cu_string_null;
		
		if (!(other.cu_customflags & cu_CFL_PLUNGE))	
		{
			// this is non-optimal - means the player got in under a plunge trigger somehow.
			// can happen if the pit is wider at the top than the bottom, and the func_void
			// was made only as wide as the bottom
			other.armorvalue = 0;
			if (!cu_void_salvation(self, other))		// maybe save him anyway?
				cu_T_Damage(other, self, self, 5000, cu_DMGTYPE_FALLING);	// or just blast him now and forget about it
			return;
		}
		
		other.takedamage = cu_DAMAGE_NO;
		return;
	}
	else if (other.classname != "player")	// not a living player who IS in noclip
	{
		if (other.takedamage)
		{
			other.cu_customflags |= cu_CFL_PLUNGE;	// set this so Killed() doesn't throw gibs
			//T_Damage(other, self, other.enemy, other.health + 10);
			if (other.enemy.classname == "player")
				cu_Killed(other,other.enemy, cu_DMGTYPE_FALLING);
			else if (other.cu_oldenemy.classname == "player")
				cu_Killed(other,other.cu_oldenemy, cu_DMGTYPE_FALLING);
			// attacker must be the monster's enemy, so that players still count as the 
			// killer if they boosh monsters into a pit
			return;
		}

		// anything else just vanishes
		cu_SUB_CallAsSelf(cu_SUB_Remove,other);
	}
}


// --------------------------------
// void_hitbottom
// player hit the implied fake bottom (ie fell for 'delay' seconds), time to die
// --------------------------------
void() cu_void_fall_hitbottom =
{
	self.enemy.takedamage = cu_DAMAGE_YES;	// need this first for salvation damage check
	if (cu_void_salvation(self.owner, self.enemy))
		return;
	
	self.enemy.cu_customflags = cu_not(self.enemy.cu_customflags, cu_CFL_UNDYING);
	self.enemy.flags = cu_not(self.enemy.flags, cu_FL_GODMODE);
	
	// a pent will not save you from THE LEVEL DESIGNER
	if (cu_has_invuln(self.enemy))
	{
		self.enemy.items = self.enemy.items - (self.enemy.items & cu_IT_INVULNERABILITY);
		self.enemy.cu_invincible_finished = 0;
		self.enemy.cu_invincible_time = 0;
	}
	
	self.enemy.armorvalue = 0;
	cu_T_Damage(self.enemy, self.owner, self.owner, 5000, cu_DMGTYPE_FALLING);
	
	cu_SUB_RemoveSoon();
}


void() cu_void_fall_unplunge =
{
	cu_void_unplunge(self.enemy);
}

// --------------------------------
// void_fallthink
// timer for fading out the player's view as he's falling
// --------------------------------
void() cu_void_fallthink =
{
	local float cu_plummet;
	
	if ( self.enemy.origin_z > self.oldorigin_z		// player rose back up out of the pit, mostly convenience for noclipping around
		|| self.owner.flags & cu_CFL_LOCKED )			// player fell into a void as it was LOCKed :(
	{		
		cu_void_fall_unplunge();
		cu_SUB_RemoveSoon();
		return;
	}
	
	if (self.enemy.cu_customflags & cu_CFL_LIMBO)
	{
//		bprint("fallthink in limbo\n");
		self.nextthink = time + 0.1;
		self.cu_pain_finished += 0.1;	// don't instagib the player while waiting for the salvation spot to clear
		return;
	}
	
	if ( self.enemy.movetype == cu_MOVETYPE_NONE )	// has touched the func
	{
		if (self.cu_pain_finished <= time)
		{
			cu_void_fall_hitbottom();
		}
		else
		{
			self.think = cu_void_fall_hitbottom;
			self.nextthink = self.cu_pain_finished;
		}
		return;
	}
	
	cu_plummet = (self.enemy.origin_z - self.lip) / self.height;
	cu_plummet = 1 - cu_plummet * cu_plummet;	// exponential falloff seems to look more linear, since the player accelerates exponentially
	cu_plummet = cu_min( ceil( cu_plummet * 255 ), 255);
	
	cu_TintScreenColor(self.enemy, cu_plummet, self.cu_fadecolor);
	
	self.nextthink = time + 0.0333;
}

void() cu_player_void_monitor_think =
{
	// stop when body comes to rest or player respawns
	if (self.owner.flags & cu_FL_ONGROUND || self.owner.deadflag == cu_DEAD_NO )
	{
		remove(self);
		return;
	}
	
	// FIXME: falling fast through too narrow a void fall trigger can still skip through it
	setorigin (self, self.owner.origin + self.owner.view_ofs);
	self.velocity = self.owner.velocity;
	self.nextthink = time + 0.05;
}

// --------------------------------
// player_spawn_void_monitor
// buddy entity that follows a dead player (or head) to trigger the void fade
// if they die above a pit and then fall in
// --------------------------------
void() cu_player_spawn_void_monitor =
{
	entity cu_vmon = spawn();
	
	// self is the dying player at the moment
	cu_vmon.owner = self;
	cu_vmon.classname = "player_voidmonitor";
	cu_vmon.movetype = cu_MOVETYPE_TOSS;
	cu_vmon.solid = cu_SOLID_BBOX;
	setsize (cu_vmon, cu_VEC_ORIGIN, cu_VEC_ORIGIN);
	setorigin (cu_vmon, self.origin + self.view_ofs);
	cu_vmon.velocity = self.velocity;

	cu_vmon.think = cu_player_void_monitor_think;
	cu_vmon.nextthink = time;
}

// --------------------------------
// void_trigger_touch
// the is-now-irretrievably-falling trigger
// --------------------------------
void() cu_void_trigger_touch =
{
	entity cu_e;
	if (other.classname == "player_voidmonitor")
	{
		cu_e = other.owner;
		other.think = cu_SUB_Remove;
		cu_e.movetype = cu_MOVETYPE_TOSS; // so gib head doesn't bounce 'out' of the fog
		if (cu_e.cu_customflags & cu_CFL_PLUNGE) return;
	}
	else
	{
		if (!cu_CheckValidTouch()) return;
		cu_e = other;
		if (cu_e.cu_customflags & cu_CFL_PLUNGE) return;	// don't touch the trigger a bunch of times on the way down
		// we could set a refire time on the trigger but players in coop could go over the edge simultaneously
		sound (cu_e, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NONE);
	}
	
	if (time > self.cu_attack_finished)
	{
		cu_activator = cu_e;
		cu_SUB_UseTargets();
		self.cu_attack_finished = time + 0.5;
	}
	
	cu_e.cu_customflags = cu_e.cu_customflags | cu_CFL_PLUNGE;
	
	cu_e.weaponmodel = cu_string_null;
	
	local entity cu_fall;
	
	cu_fall = spawn();
	cu_fall.classname = "trigger_void";
	cu_fall.deathtype = self.deathtype;
	cu_fall.nextthink = time + 0.05;
	cu_fall.think = cu_void_fallthink;
	cu_fall.enemy = cu_e;
	cu_fall.owner = self.owner;
	cu_fall.height = self.height;
	cu_fall.oldorigin = cu_e.origin;	// track player's descent
	cu_fall.lip = cu_e.origin_z - self.height; // z at bottom
	cu_fall.cu_pain_finished = time + self.wait;
	cu_fall.cu_fadecolor = self.cu_fadecolor;
	
	// gl_cshiftpercent isn't native to OG quake, so the cvar call fails and returns 0 
	// in winquake/weird engines because the cvar doesn't exist, so use a cvar introduced
	// at the same time to determine if that 0 is valid
	cu_noTint = ((cvar("gl_cshiftpercent") < cu_CSHIFT_CUTOFF) && cvar("gl_farclip") && !coop); // QVR: Copper's bug fixed as meant (QC reads `x = a && b` as `(x = a) && b`): in coop the tint is stuffed
	// doesn't work in coop bc the server's values will be used to determine tint/fog for clients
}


entity(entity cu_me) cu_void_find_teleport =
{
	if (cu_me.target == cu_string_null &&
		cu_me.cu_target2 == cu_string_null &&
		cu_me.cu_target3 == cu_string_null &&
		cu_me.cu_target4 == cu_string_null)
		return world;

	entity cu_head;
	cu_head = world;
	while (1)
	{
		cu_head = find(cu_head, targetname, cu_me.target);
		if (!cu_head)
			break;
		if (cu_head.classname == "info_teleport_destination" && !(cu_head.cu_customflags & cu_CFL_LOCKED))
			return cu_head;
	}
	cu_head = world;
	while (1)
	{
		cu_head = find(cu_head, targetname, cu_me.cu_target2);
		if (!cu_head)
			break;
		if (cu_head.classname == "info_teleport_destination" && !(cu_head.cu_customflags & cu_CFL_LOCKED))
			return cu_head;
	}
	cu_head = world;
	while (1)
	{
		cu_head = find(cu_head, targetname, cu_me.cu_target3);
		if (!cu_head)
			break;
		if (cu_head.classname == "info_teleport_destination" && !(cu_head.cu_customflags & cu_CFL_LOCKED))
			return cu_head;
	}
	cu_head = world;
	while (1)
	{
		cu_head = find(cu_head, targetname, cu_me.cu_target4);
		if (!cu_head)
			break;
		if (cu_head.classname == "info_teleport_destination" && !(cu_head.cu_customflags & cu_CFL_LOCKED))
			return cu_head;
	}

	return world;
}

void(float cu_unlock) cu_void_lock =
{
	// self: solid bottom surface, invisible
	// self.buddy: nonsolid bottom cover, visible
	// self.enemy: plunge trigger
	
	if (cu_unlock)
	{
		self.solid = cu_SOLID_TRIGGER;
		self.enemy.touch = cu_void_trigger_touch;
		self.cu_buddy.modelindex = self.modelindex;
		
		self.flags = cu_not(self.flags, cu_CFL_LOCKED);
		self.enemy.flags = cu_not(self.enemy.flags, cu_CFL_LOCKED);
		self.cu_buddy.flags = cu_not(self.cu_buddy.flags, cu_CFL_LOCKED);
	}
	else
	{
		self.solid = cu_SOLID_NOT;
		self.enemy.touch = cu_SUB_Null;
		self.cu_buddy.modelindex = 0;
		
		self.flags |= cu_CFL_LOCKED;
		self.enemy.flags |= cu_CFL_LOCKED;
		self.cu_buddy.flags |= cu_CFL_LOCKED;
	}
}

/*cu:QUAKED func_void (.5 .2 0) ?
for holes into which one should not fall

Texture this with black (or sky?) and cover the bottom of the pit with it.  Automatically offsets its own visual model upward, to hide pesky heads and scrag corpses underneath.  Also automatically spawns a start-of-plunge trigger of the same size "height" units above itself that plays a yell sound and fades out the view of clients as they start to fall in.

The player's view will have faded completely by the time they touch the bottom, so we hold them in stasis for a little while longer there before splatting them, to imply the pit is deeper than it really is. The player can therefore feel like they fall for a long time before crash landing in darkness without you having to build a pit that deep.

Keyvalues
"delay" how long the player should 'fall' before the splat, default 3
"height" how high above the func_void the plunge trigger should spawn. do not make this high enough that players will touch it without falling in or they'll hear random screaming noises as they walk around and that'll be strange. default 128
"lip" distance to raise the visual model, default 32
"fadecolor" color to fade the screen to while falling, default black
"noise"/"noise2" override fall and splat sounds

Fires all "target"s/"killtarget"s when a client touches the plunge trigger (ie the yell, not the splat).
If the func_void's first target is an info_teleport_destination, it will hurt the player for "dmg" damage and teleport him to the destination. If "dmg" is enough to kill the player when he falls in, it continues with the fade and splat as normal.
*/
/*FGD
@SolidClass base(Target, Appearflags) color(128 50 0) = func_void : 
"for holes into which one should not fall

Texture this with black (or sky?) and cover the bottom of the pit with it.  Automatically offsets its own visual model upward, to hide pesky heads and scrag corpses underneath.  Also automatically spawns a start-of-plunge trigger of the same size 'height' units above itself that plays a yell sound and fades out the view of clients as they start to fall in.

The player's view will have faded completely by the time they touch the bottom, so we hold them in stasis for a little while longer there before splatting them, to imply the pit is deeper than it really is. The player can therefore feel like they fall for a long time before crash landing in darkness without you having to build a pit that deep.

Fires all targets when a client touches the plunge trigger (ie the yell, not the splat).

If the func_void's first target is an info_teleport_destination, it will hurt the player and teleport him to the destination. If the damage is enough to kill the player, it continues with the fade and splat as normal without teleporting."
[
	delay(string) : "how long the player should 'fall' before the splat" : "3"
	height(integer) : "how high above the func_void the plunge trigger should spawn. do not make this high enough that players will touch it without falling in or they'll hear random screaming noises as they walk around and that'll be strange." : 128
	lip(integer) : "distance to raise the visual model" : 32
	dmg(integer) : "pain to apply before salvation teleport" : 60
	fadecolor(string) : "color to fade the screen to while falling" : "0 0 0"
	noise(string) : "fall sound" : "player/q3fall.wav"
	noise2(string) : "splat sound" : "player/splat1.wav"
]
*/
void() cu_func_void =
{
	if (!cu_SUB_ShouldSpawn()) return;
	vector cu_offset;
	
	if (self.noise == cu_string_null) self.noise = "player/q3fall.wav";
	if (self.noise2 == cu_string_null) self.noise2 = "player/splat1.wav";
	cu_precache_sound3(self.noise);
	cu_precache_sound3(self.noise2);
	
	// set own model to link into world, then set to null to be solid but invisible
	self.solid = cu_SOLID_TRIGGER;
	self.movetype = cu_MOVETYPE_NONE;
	setmodel (self, self.model);
	self.touch = cu_void_func_touch;
	
	// recycle the same model on a nonsolid entity 32 units higher to hide detritus
	self.lip = cu_zeroconvertdefault(self.lip, 32);
	cu_offset = cu_VEC_UP * self.lip;
	self.cu_buddy = spawn();
	self.cu_buddy.solid = cu_SOLID_NOT;
	self.cu_buddy.movetype = cu_MOVETYPE_NONE;
	setorigin(self.cu_buddy, cu_offset);
	setmodel (self.cu_buddy, self.model);
	self.cu_buddy.modelindex = self.modelindex;
	self.cu_buddy.classname = "void_ghost";
	self.cu_buddy.owner = self;

	self.model = cu_string_null;
	
	if (!self.height) self.height = 128;	// height above func to spawn plunge trigger
	self.delay = cu_zeroconvertdefault(self.delay,3);	// time to spend "falling" after touching plunge trigger	
	
	// wait for other things to spawn
	//self.think = void_find_teleports;
	//self.nextthink = time + 0.1;
	self.dmg = cu_zeroconvertdefault(self.dmg, 60);
	
	// create another solid entity with the same bounds with solid_trigger as a catch on the way down
	self.enemy = spawn();
	self.enemy.classname = "void_plunge_trigger";
	self.enemy.movetype = cu_MOVETYPE_NONE;
	self.enemy.solid = cu_SOLID_TRIGGER;
	self.enemy.owner = self;
	self.enemy.touch = cu_void_trigger_touch;
	self.enemy.height = self.height + 32;
	self.enemy.wait = self.delay;	// if trigger has 'delay' field it adds a delay to its own usetargets
	self.enemy.deathtype = self.deathtype;
	self.enemy.cu_fadecolor = self.cu_fadecolor;
	self.enemy.noise = self.noise;
	self.enemy.noise2 = self.noise2;
	
	cu_SUB_CopyTargets(self.enemy);
	self.enemy.targetname = self.targetname;

	cu_offset = cu_VEC_UP * self.height;
	
	// fatten by 64u vertically to make it hard to fall through it at high speed without touching it
	setsize (self.enemy, self.mins + cu_offset - '0 0 32', self.maxs + cu_offset + '0 0 32');
	
	self.cu_lock = cu_void_lock;
}
