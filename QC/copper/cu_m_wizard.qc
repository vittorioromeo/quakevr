/*
=================
WizardCheckAttack
=================
*/
float()	cu_WizardCheckAttack =
{
	vector	cu_spot1, cu_spot2;	
	float		cu_chance;
	
	if (time < self.cu_attack_finished)
		return cu_FALSE;
	if (!cu_enemy_vis)
		return cu_FALSE;

	if (cu_enemy_range >= cu_RANGE_FAR)
	{
		self.cu_attack_state = cu_AS_STRAIGHT;
		return cu_FALSE;
	}
	
	// see if any entities are in the way of the shot
	if (!cu_has_invis(self.enemy))	// but not if we can't see him
	{
		// see if any entities are in the way of the shot
		cu_spot1 = self.origin + self.view_ofs;
		cu_spot2 = self.enemy.origin + self.enemy.view_ofs;

		cu_traceline2(cu_spot1, cu_spot2, self, cu_TRACE_WATER);

		if (trace_ent != self.enemy)
		{	// don't have a clear shot, so move to a side
			self.cu_attack_state = cu_AS_STRAIGHT;
			return cu_FALSE;
		}
	}
	
	if (cu_enemy_range == cu_RANGE_MELEE)
		cu_chance = 0.9;
	else if (cu_enemy_range == cu_RANGE_NEAR)
		cu_chance = 0.6;
	else if (cu_enemy_range == cu_RANGE_MID)
		cu_chance = 0.2;
	else
		cu_chance = 0;

	if (random () < cu_chance)
	{
		self.cu_attack_state = cu_AS_MISSILE;
		return cu_TRUE;
	}

	if (cu_enemy_range == cu_RANGE_MID)
		self.cu_attack_state = cu_AS_STRAIGHT;
	else
		self.cu_attack_state = cu_AS_SLIDING;
	
	return cu_FALSE;
}

/*
=================
WizardAttackFinished
=================
*/
void()	cu_WizardAttackFinished =
{
	cu_enemy_range = cu_range(self.enemy);
	cu_enemy_vis = cu_visible(self.enemy);
	
	if (cu_enemy_range != cu_RANGE_NEAR || !cu_enemy_vis || random() < 0.5)
		self.cu_attack_state = cu_AS_STRAIGHT;
	else
		self.cu_attack_state = cu_AS_SLIDING;
}

/*
==============================================================================

FAST ATTACKS

==============================================================================
*/

entity(vector cu_org, vector cu_vel) cu_launch_wizspike =
{
	entity cu_spike;
	
	if (cu_skill == 3)
	{
		cu_spike = cu_launch_projectile(cu_org, cu_vel*720, "wizspike");	// FLYMISSILE
		cu_spike.dmg = 20;
		cu_SUB_ChangeModel (cu_spike, VR_ModelOr("progs/w_spike2.mdl", "progs/w_spike.mdl"));
	}
	else
	{
		cu_spike = cu_launch_projectile(cu_org, cu_vel*600, "wizspike");	// FLYMISSILE
		cu_spike.dmg = 9;
		cu_SUB_ChangeModel (cu_spike, "progs/w_spike.mdl");
	}
	cu_spike.touch = cu_spike_touch;
	
	return cu_spike;	
}

void() cu_Wiz_FastFire =
{
	vector cu_vec;
	vector cu_dst;
	entity cu_wsp;

	if (self.owner.health > 0)
	{
		self.owner.effects = self.owner.effects | cu_EF_MUZZLEFLASH;

		cu_dst = cu_enemy_vispos() - self.movedir;
	
		cu_vec = normalize(cu_dst - self.origin);
		sound (self, cu_CHAN_WEAPON, "wizard/wattack.wav", 1, cu_ATTN_NORM);
		cu_wsp = cu_launch_wizspike (self.origin, cu_vec);
		cu_wsp.owner = cu_wsp.cu_trueowner = self.owner;
	}

	remove (self);
}

void(float cu_when, float cu_where) cu_Wiz_Shot =
{
	entity	cu_missile;
	
	cu_missile = spawn ();
	cu_missile.owner = self;
	setsize (cu_missile, '0 0 0', '0 0 0');		
	setorigin (cu_missile, self.origin + '0 0 24' + v_forward * 14 + v_right * cu_where);
	cu_missile.enemy = self.enemy;
	cu_missile.nextthink = time + cu_when;
	cu_missile.think = cu_Wiz_FastFire;
	cu_missile.movedir = v_right * cu_where;
}

void() cu_Wiz_StartFast =
{
	//sound (self, CHAN_WEAPON, "wizard/wattack.wav", 1, ATTN_NORM);
	self.v_angle = self.angles;
	makevectors (self.angles);

	cu_Wiz_Shot(0.3, -13);
	cu_Wiz_Shot(0.8, 13);
}



void() cu_Wiz_idlesound =
{
	if (self.cu_show_hostile > time) return;
local float cu_wr;
	cu_wr = random() * 5;

	if (self.wait < time)
	{
	 	self.wait = time + 2;
	 	if (cu_wr > 4.5) 
	 		sound (self, cu_CHAN_VOICE, "wizard/widle1.wav", 1,  cu_ATTN_IDLE);
	 	if (cu_wr < 1.5)
	 		sound (self, cu_CHAN_VOICE, "wizard/widle2.wav", 1, cu_ATTN_IDLE);
	}
	return;
}

