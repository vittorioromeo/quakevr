void()	cu_wiz_death1	=[	$death1,		cu_wiz_death2	] {
	self.velocity_x = -200 + 400*random();
	self.velocity_y = -200 + 400*random();
	self.velocity_z = 100 + 100*random();
	self.flags = cu_not(self.flags, cu_FL_ONGROUND);
	sound (self, cu_CHAN_VOICE, "wizard/wdeath.wav", 1, cu_ATTN_NORM);
}
void()	cu_wiz_death2	=[	$death2,		cu_wiz_death3	] {}
void()	cu_wiz_death3	=[	$death3,		cu_wiz_death4	] {self.solid = cu_SOLID_NOT; self.flags = cu_not(self.flags, cu_FL_ONGROUND);}
void()	cu_wiz_death4	=[	$death4,		cu_wiz_death5	] {}
void()	cu_wiz_death5	=[	$death5,		cu_wiz_death6	] {}
// would be nice to hold on frame 6 until the plunk, but SOLID_NOT things don't generate touch events
// if they did it would be a lot easier to remove dead scrags and heads in func_voids
void()	cu_wiz_death6	=[	$death6,		cu_wiz_death7	] {}
void()	cu_wiz_death7	=[	$death7,		cu_wiz_death8	] {}
void()	cu_wiz_death8	=[	$death8,		cu_SUB_Null	] {}// deathvoidcheck(); }

void() cu_wiz_die =
{
// check for gib
	if (self.health < -40)
	{
		cu_Gib ("progs/h_wizard.mdl", self.health);
		return;
	}

	cu_wiz_death1 ();
}


void(entity cu_attacker, float cu_damage) cu_Wiz_Pain =
{
	sound (self, cu_CHAN_VOICE, "wizard/wpain.wav", 1, cu_ATTN_NORM);
	if (random()*70 > cu_damage)
		return;		// didn't flinch

	cu_wiz_pain1 ();
}


void() cu_monster_wizard_spawn =
{
	self.classname = "monster_wizard";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/wizard.mdl");

	setsize (self, cu_VEC_HULL_MIN, cu_VEC_HULL_MAX);
	self.health = 80;

	self.cu_th_stand = cu_wiz_stand1;
	self.cu_th_walk = cu_wiz_walk1;
	self.cu_th_run = cu_wiz_run1;
	self.cu_th_missile = cu_wiz_fast1;
	self.cu_th_pain = cu_Wiz_Pain;
	self.cu_th_die = cu_wiz_die;
	self.cu_th_checkattack = cu_WizardCheckAttack;

	if (self.deathtype == cu_string_null)
		self.deathtype = "was scragged by a Scrag";

	self.height = cu_zeroconvertdefault(self.height, 35);
	self.cu_jump_flag = self.height;	// remember original value for short term nav tweaking
	cu_flymonster_start();
}

void() cu_monster_wizard_spawner = {cu_mon_spawner_use(cu_monster_wizard_spawn);}

/*cu:QUAKED monster_wizard (1 0 0) (-16 -16 -24) (16 16 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Scrag (the WIZARD), 80 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry

"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
*/
/*FGD
@PointClass base(Monster) size(-16 -16 -24, 16 16 40) model({ "path": ":progs/wizard.mdl" }) = monster_wizard : "Scrag" []
*/
void() cu_monster_wizard =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model ("progs/wizard.mdl");
	precache_model ("progs/h_wizard.mdl");
	precache_model ("progs/w_spike.mdl");
	precache_model (VR_ModelOr("progs/w_spike2.mdl", "progs/w_spike.mdl"));

	precache_sound ("wizard/hit.wav");		// used by c code
	precache_sound ("wizard/wattack.wav");
	precache_sound ("wizard/wdeath.wav");
	precache_sound ("wizard/widle1.wav");
	precache_sound ("wizard/widle2.wav");
	precache_sound ("wizard/wpain.wav");
	precache_sound ("wizard/wsight.wav");

	self.health = 80;
	//setsize (self, '-16 -16 -24', '16 16 40');
	setsize (self, cu_VEC_HULL_MIN, cu_VEC_HULL_MAX);
	if ( cu_monster_spawnsetup( cu_monster_wizard_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_wizard_spawn();
}







/*
=============
LaunchMissile

Sets the given entities velocity and angles so that it will hit self.enemy
if self.enemy maintains it's current velocity
0.1 is moderately accurate, 0.0 is totally accurate
=============
*/
