/*
============
traceline2

a more robust wrapper for traceline() that can ignore a wider array of entities.
performs one or more staggered traceline()s until the trace_ent isn't something we 
actually want to ignore, so what would be one trace can turn into several.
============
*/
void(vector cu_start, vector cu_end, entity cu_ignore, float cu_traceflags) cu_traceline2 =
{
	entity cu_ig = cu_ignore;
	//entity lastent = world;
	vector cu_src = cu_start;
	vector cu_lastend = cu_start;
	float cu_traces = 0;
	float cu_nomonsters = 0;
	
	if (cu_traceflags & cu_TRACE_NOMONSTERS) cu_nomonsters = cu_TRUE;
	
	float	cu_t_allsolid = 2;
	float	cu_t_startsolid = -1;
	float	cu_t_inopen = -1;
	float	cu_t_inwater = -1;

	if (cu_trace_debug)
	{
		dprint("tracing from ");
		cu_dprint_vector(cu_src);
		dprint( " to ");
		cu_dprint_vector(cu_end);
		dprint("\n");
	}

	// check for trace-through cases and repeat
	do {
		if (cu_trace_debug)
		{
			dprint("  trace ");
			cu_dprint_vector(cu_src);
			dprint( " to ");
			cu_dprint_vector(cu_end);
			dprint("\n");
		}
		traceline (cu_src, cu_end, cu_nomonsters, cu_ig);
		
		if (cu_traces == 0)
			if ((cu_traceflags & cu_TRACE_WATER) == 0 && (trace_fraction == 1.0 || trace_ent == world))
				return;
		
		// preserve the accuracy of the trace result flags
		if (cu_t_startsolid == -1) cu_t_startsolid = trace_startsolid;
		if (!trace_startsolid)
		{		
			cu_t_allsolid = cu_min(cu_t_allsolid, trace_allsolid);
			cu_t_inopen = cu_max(cu_t_inopen, trace_inopen);
			cu_t_inwater = cu_max(cu_t_inwater, trace_inwater);
			
			if ( trace_ent.deadflag == cu_DEAD_DYING || 	// don't let guys in death frames who aren't nonsolid yet act like solid walls to bullets
				trace_ent == cu_ignore || 					// always ignore the original ignore ent on future loops
				trace_ent.movetype == cu_MOVETYPE_NOCLIP || // don't shoot noclipping players
				cu_invis_miss_check(trace_ent, cu_start, cu_end - cu_start) || 
				trace_ent.cu_notrace)						// flag to make things game-functionally nonsolid (monsterclip/etc)
			{
				// if two entities that are both to be ignored are touching, the trace will
				// fail with a distance of zero once 'ig' changes, so nudge forward one unit
				// to make sure the point of origin isn't touching the old ig
				cu_lastend = trace_endpos;
				cu_src = trace_endpos + normalize(cu_end - cu_start);
				cu_ig = trace_ent;
				if (cu_trace_debug) cu_dprint3("    hit ", trace_ent.classname, ", trying again\n");
			}
			else cu_ig = world;
		}
		else
		{
			// if the nudge forward put the trace start in a solid, the last trace should 
			// have been the end. this can happen when a notrace surface and a legit solid 
			// surface are coincident in the path of the trace2, and the notrace one is the 
			// one quake 'sees' first.
			if (cu_trace_debug) dprint("  trace started solid!\n");
			trace_endpos = cu_lastend;
			cu_ig = world;
		}
		cu_traces++;
	} while (cu_ig != world);	// true if we hit a wall or hit nothing
	
	if (cu_trace_debug) cu_dprint3("trace complete after ", ftos(cu_traces), " traces \n");
	
	// unify global trace results so the calling function can pretend it only made one trace
	float cu_lastfrac = vlen(cu_start - trace_endpos) / vlen(cu_start - cu_end);
	entity cu_lastent = trace_ent;
	if ((cu_traceflags & (cu_TRACE_NOMONSTERS|cu_TRACE_WATER)) == cu_TRACE_WATER)
	{
		// thanks to a structural oddity in SV_ClipToLinks (world.c), a traceline() without nomonsters
		// doesn't properly populate the open/inwater trace flags, so we have to do another nomonsters
		// traceline2 over the path of the last one to catch the case of crossing water contents.
		
		// we can't just check pointcontents at start and end because it doesn't catch when mappers do
		// wacky things with water volumes (ie the E4 entry in the original start.bsp), and it can't be
		// a singular traceline() because a monster might be looking through a notrace bmodel into water.
		//dprint(" tracing again with nomonsters to get trace flags right\n");
		cu_traceline2(cu_start, trace_endpos, cu_ignore, cu_TRACE_NOMONSTERS);
	}
	else
	{
		trace_startsolid = cu_t_startsolid;
		trace_allsolid = cu_t_allsolid;
		trace_inopen = cu_t_inopen;
		trace_inwater = cu_t_inwater;
	}
	trace_fraction = cu_lastfrac;
	trace_ent = cu_lastent;
	
	if (cu_trace_debug) {
		if (trace_ent)
			cu_dprint3("  entity: ", trace_ent.classname, "\n");
		cu_dprint3("  end: ", vtos(trace_endpos), "\n");
		cu_dprint3("  fraction: ", ftos(trace_fraction*100), "%\n");
		cu_dprint3("  startsolid: ", ftos(trace_startsolid), "\n");
		cu_dprint3("  allsolid: ", ftos(trace_allsolid), "\n");
		cu_dprint3("  inopen: ", ftos(trace_inopen), "\n");
		dprint("----------\n");
	//	dprint3("  inwater: ", ftos(trace_inwater), "\n----------\n");
	}
}

/*
================================================================

PENETRATION AND PASSTHRU

we "patch" the limited options for solid/nonsolid interaction in the quake physics by
overriding the results of said physics in the progs .touch() functions that are called
immediately after.

to emulate objects being nonsolid to each other when quake didn't want them to be,
we respond to their collisions by setting one as the .owner of the other, which causes
quake to ignore their collisions on subsequent frames, then restoring the physics to 
roughly the state they'd be in if SV_Move had not altered their velocities in response to 
that collision. in the case of linear projectiles, this means restoring their starting
velocity, but for TOSS/BOUNCE projectiles it means tracking their always-changing 
velocities constantly with a frequent .think(). thus all grenades, as well as gibs, 
think at 20hz until they come to rest. not ideal, but not seriously so.

this is further complicated by not being able to alter .velocity from the touch function
itself, because at that point quake is in the physics half of the game frame when such
monkeying is not allowed. thus, we have to make our corrections immediately thereafter
in a .think(), while preserving the previous .think() and .nextthink so as not to break 
the projectile's normal behavior (voreball homing, particles, etc).

on all projectiles, .touch must be some function that calls CheckProjectilePassthru() and 
halts if it returns TRUE (representing "not an actual collision"). the check handles all 
consequences behind the scenes.

on ballistic projectiles, .think and .nextthink are overridden, so they cannot be used
for projectile timeout. set .lifetime_finished to the time when projectile should expire, 
and .th_die to the function to call when it does.

================================================================
*/


/*
============
projectile_passthru_think

think function to make a projectile ignore what it just hit
the new owner has been set by this point
============
*/
void() cu_projectile_passthru_think =
{
	self.flags = cu_not(self.flags, cu_FL_ONGROUND);
	self.velocity = self.cu_oldvelocity;
	self.think = self.cu_think1;
	self.nextthink = self.cu_pain_finished;
	
	// nudge the projectile forward a tiny bit to be inside its new owner
	setorigin(self, self.origin + normalize(self.velocity) * 0.1);
	// if the old owner and the new owner are touching at the point that the
	// projectile crosses over, next frame it'll be coincident with both old
	// and new, the trace in sv_move will wind up being allsolid, and the
	// projectile will travel through worldspawn.
}

/*
============
projectile_toss_think

when a passthru overrides server physics for a TOSS projectile, we must 
restore a recent enough velocity that the projectile appeared not to touch.
grenades change velocity every frame, so they have to save it near-continuously
============
*/
void() cu_projectile_toss_think =
{
	if (time > self.cu_lifetime_finished)
	{
		self.cu_th_die();
		return;
	}
	if (self.velocity == cu_VEC_ORIGIN)	// stopped on the ground
	{
		self.think = self.cu_th_die;
		self.nextthink = self.cu_lifetime_finished;
	//	bprint3("at rest, exploding in ", ftos(self.nextthink), " seconds\n");
		self.cu_th_die = cu_SUB_Null;
		self.cu_lifetime_finished = 0;
		self.solid = cu_SOLID_NOT;
		return;
	}
		
	self.flags = cu_not(self.flags, cu_FL_ONGROUND);
	self.cu_oldvelocity = self.velocity;
	self.nextthink = time + 0.05;	// 10hz is probably enough, but 20hz is surely twice as good
}

/*
============
projectile_valid_passthru

returns TRUE in cases where we pass through and should not collide
============
*/
float() cu_projectile_valid_passthru =
{
	// SOLID_NOT entities touch SOLID_BSP by default without generating touch events.
	// gibs had to be made SOLID_BBOX in order to make selectively passing through 
	// notrace/monsterclip even possible, so they need special handling by our owner-
	// changing hackery to ensure they stay nonsolid in the other cases too
	if (self.cu_type == "gib")
	{
		if (other.movetype == cu_MOVETYPE_PUSH || other.solid == cu_SOLID_BSP)
			return other.cu_notrace;
		return cu_TRUE;
	}
	
	if (other.deadflag == cu_DEAD_DYING || // corpses not yet on the ground
		other.cu_notrace  || 				// specially marked (monsterclip)
		cu_invis_miss_check(other,self.origin,self.velocity) || 
		other.movetype == cu_MOVETYPE_NOCLIP || // ignore noclipping players
		other == self.cu_trueowner	)		// still track the original owner - there are cases when monsters 
										// or players firing fat FLYMISSILE projectiles into an adjacent 
										// monsterclip can be hit by them when the owner switches
		return cu_TRUE;
		
	return cu_FALSE;
}

/*
============
projectile_passthru

we can't alter physics stuff to make the projectile physically penetrate during 
touch/physics, so set an immediate think to 'repair' the state of the projectile
============
*/
void() cu_projectile_passthru =
{
	self.owner = other;
	
	// our nextthink was probably to explode or remove, so save that
	self.cu_think1 = self.think;	
	self.cu_pain_finished = self.nextthink;
	
	self.think = cu_projectile_passthru_think;
	self.nextthink = time;
}

/*
============
CheckProjectilePassthru

called within every projectile touch function, returns TRUE if pierced an otherwise solid entity
============
*/
float() cu_CheckProjectilePassthru =
{
	if (!other) return cu_FALSE;	// always collide with world
	if (other == self.owner) return cu_FALSE;	// this actually shouldn't have been called, but: don't touch owner
	
	if (other.classname == "func_void")
	{
		// go away at the bottoms of pits
		cu_SUB_RemoveSoon();
		return cu_TRUE;
	}
	
	// handle overriding the quake physics with our own desired result
	if (cu_projectile_valid_passthru())
	{
		cu_projectile_passthru();
		return cu_TRUE;
	}

	return cu_FALSE;
}

void() cu_projectile_touch_null = { cu_CheckProjectilePassthru(); }

/*
========
invis_miss_check

when invisible, to split the difference between the near-invulnerability of notrace 
and the cheap weak feeling of catching a stray grenade because you dodged wrong,
projectiles and hitscan are verified against a thin cylinder (20u diameter) so most
incidental or glancing hits miraculously miss, while only the real dead-on shots land
========
*/
float(entity cu_tgt, vector cu_start, vector cu_dir) cu_invis_miss_check =
{
	if (!cu_has_invis(cu_tgt))
		return cu_FALSE;	
	vector cu_p = cu_CrossProduct('0 0 1', normalize(cu_dir));
	float cu_d = (cu_start - cu_tgt.origin) * cu_p;
	return (fabs(cu_d) >= 10);
}



/*
================================================================

	MISSILES

if you're looking for 'newmis' and 'launch_spike' this is where they went

projectile .type: for general behavior (ie any grenade type gets pulled by wind tunnels)
projectile .classname: for specific behavior (knightspike vs wizspike)

projectiles therefore require a classname at the function parameter level
to ensure it never gets left off

================================================================
*/

/*
========
launch_projectile

base linear projectile, does not set model, touch, or damage
speed expected to derive from the length of 'vel'
========
*/
entity(vector cu_org, vector cu_vel, string cu_cname) cu_launch_projectile =
{
	entity cu_prj;
	
	cu_prj = spawn();
	cu_prj.owner = cu_prj.cu_trueowner = self;
	cu_prj.movetype = cu_MOVETYPE_FLYMISSILE;
	cu_prj.solid = cu_SOLID_BBOX;

	cu_prj.angles = vectoangles(cu_vel);
	
	cu_prj.cu_type = "spike";
	cu_prj.touch = cu_projectile_touch_null;
	cu_prj.cu_th_die = cu_SUB_Remove;
	cu_prj.think = cu_SUB_Remove;
	cu_prj.nextthink = time + 6;

	setsize (cu_prj, cu_VEC_ORIGIN, cu_VEC_ORIGIN);
	setorigin (cu_prj, cu_org);

	cu_prj.velocity = cu_prj.cu_oldvelocity = cu_vel;
	
	cu_prj.classname = cu_cname;
	
	return cu_prj;
}

/*
========
toss_projectile

base ballistic projectile, does not set model, touch, or damage
speed expected to derive from the length of 'vel'
========
*/
entity(vector cu_org, vector cu_vel, string cu_cname) cu_toss_projectile =
{
	entity cu_g;
	cu_g = cu_launch_projectile(cu_org, cu_vel, cu_cname);
	cu_g.movetype = cu_MOVETYPE_BOUNCE;
	cu_g.cu_type = "grenade";
	
	cu_g.think = cu_projectile_toss_think;
	cu_g.nextthink = time;
	cu_g.touch = cu_projectile_touch_null;
	cu_g.cu_th_die = cu_SUB_Remove;
	cu_g.cu_lifetime_finished = time + 6;
	
	return cu_g;
}


//================================================================


/*
========
launch_nail

basic hurty projectile, used by trap_spikeshooter and player nailguns
inherited from by lots of other hurty projectiles
========
*/
entity(vector cu_org, vector cu_vel) cu_launch_nail =
{
	entity cu_spike;
	
	cu_spike = cu_launch_projectile(cu_org, cu_vel, "spike");
	cu_spike.touch = cu_spike_touch;
	
	cu_SUB_ChangeModel (cu_spike, "progs/spike.mdl");	
	cu_spike.dmg = 9;
	
	return cu_spike;
}

/*
========
launch_laser
used by trapshooter and enforcers
========
*/
entity(vector cu_org, vector cu_vel) cu_launch_laser =
{
	entity cu_spike;
	
	cu_spike = cu_launch_projectile(cu_org, cu_vel, "laser");
	cu_spike.touch = cu_spike_touch;
	cu_spike.effects = cu_EF_DIMLIGHT;
	cu_spike.movetype = cu_MOVETYPE_FLY;	// enforcer lasers aren't FLYMISSILE in id106

	cu_SUB_ChangeModel (cu_spike, "progs/laser.mdl");

	cu_spike.dmg = 12;
	
	return cu_spike;
}


/*
========
launch_rocket
basic missile, used by player and ogre rocket fire
========
*/
entity(vector cu_org, vector cu_vel) cu_launch_rocket =
{
	entity cu_missile;
	
	cu_missile = cu_launch_projectile(cu_org, cu_vel, "rocket");	// FLYMISSILE
	cu_missile.dmg = 100;
	cu_missile.touch = cu_T_MissileTouch;
	cu_missile.cu_type = "missile";
	
	cu_SUB_ChangeModel (cu_missile, "progs/missile.mdl");
	
	return cu_missile;
}

/*
========
launch_lavamissile
exploding cthon lavaball
========
*/
entity(vector cu_org, vector cu_vel) cu_launch_lavamissile =
{
	entity cu_missile;
	
	cu_missile = cu_launch_rocket(cu_org, cu_vel);	// FLYMISSILE
	cu_missile.classname = "lavaball";
	cu_missile.avelocity = '200 200 200';
	cu_SUB_ChangeModel (cu_missile, "progs/lavaball.mdl");
	
	return cu_missile;
}

/*
========
launch_grenade
basic grenade, used by player and ogre
========
*/
entity(vector cu_org, vector cu_vel) cu_launch_grenade =
{
	entity cu_grenade;
	
	cu_grenade = cu_toss_projectile(cu_org, cu_vel, "grenade");
	cu_grenade.cu_lifetime_finished = time + 2.5;
	cu_grenade.avelocity = '300 300 300';
	cu_SUB_ChangeModel (cu_grenade, "progs/grenade.mdl");
	
	return cu_grenade;
}

// GRENADE PHYSICS PATCH //

void(vector cu_normal) cu_GrenadeForceBounce;
vector(vector cu_incident, vector cu_normal, float cu_dampening) cu_reflect;

// From engine
float cu_GRENADE_BACKOFF = 1.5;

void() cu_GrenadeHandlePhysics = {
	float cu_dot;
	vector cu_horiz_vel, cu_horiz_normal;

	// if same frame that think was called
	if (self.count == cu_framecount) {
		// end our shenanigans
		self.velocity = '0 0 0';
		return;
	}

	if (self.velocity_z > 0) {
		return;
	} 

	if (self.velocity == '0 0 0') {
		return;
	}

	traceline(
			self.origin,
			self.origin + self.velocity,
			1,
			self);

	if (trace_ent != other || trace_plane_normal_z <= 0) {
		return;
	}

	cu_horiz_vel = self.velocity;
	cu_horiz_vel_z = 0;
	cu_horiz_normal = trace_plane_normal;
	cu_horiz_normal_z = 0;

	cu_dot = cu_horiz_vel * cu_horiz_normal;

	// if moving down-slope, bounce
	if (cu_dot > 0) {
		cu_GrenadeForceBounce(trace_plane_normal);
	// if surface slope is > 1/2
	} else if (trace_plane_normal_z < 2*vlen(cu_horiz_normal)) {
		cu_GrenadeForceBounce(trace_plane_normal);
	}
};

void() cu_GrenadeForceBounceThink = {

	if (time >= self.pausetime) {
		self.cu_think1();
	} else {
		self.think = self.cu_think1;
		self.nextthink = self.pausetime;
		self.velocity = self.pos1;
		self.avelocity = '300 300 300';
		self.flags = self.flags & (-1 - cu_FL_ONGROUND);
		self.count = cu_framecount;
	}
};

void(vector cu_normal) cu_GrenadeForceBounce = {
	// bounce grenade off surface
	self.velocity = cu_reflect(-self.velocity, cu_normal, 2-cu_GRENADE_BACKOFF);

	// cache velocity
	self.pos1 = self.velocity;

	// cache existing think
	self.cu_think1 = self.think;

	self.pausetime = self.nextthink;

	// FL_ONGROUND will get set, so clear it next frame
	self.think = cu_GrenadeForceBounceThink;
	self.nextthink = time;
};
