void() cu_hknight_die =
{
// check for gib
	if (self.health < -40)
	{
		cu_Gib ("progs/h_hellkn.mdl", self.health);
		return;
	}

// regular death
	sound (self, cu_CHAN_VOICE, "hknight/death1.wav", 1, cu_ATTN_NORM);
	if (random() > 0.5)
		cu_hknight_die1 ();
	else
		cu_hknight_dieb1 ();
}


