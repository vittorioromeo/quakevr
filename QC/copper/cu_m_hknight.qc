//============================================================================

// RANGED FIRE

void(vector cu_dir, vector cu_org) cu_hknight_bolt =
{
	entity cu_spike;
	if (cu_skill == 3)
	{
		cu_spike = cu_launch_projectile(self.origin + cu_org + cu_dir * 20, cu_dir * 600, "knightspike");	// FLYMISSILE
		cu_SUB_ChangeModel (cu_spike, "progs/k_spike2.mdl");
		cu_spike.dmg = 16 + 8 * random();
	}
	else
	{
		cu_spike = cu_launch_projectile(self.origin + cu_org + cu_dir * 20, cu_dir * 400, "knightspike");	// FLYMISSILE
		cu_SUB_ChangeModel (cu_spike, "progs/k_spike.mdl");
		cu_spike.dmg = 8;
	}

	cu_spike.touch = cu_spike_touch;
	sound (self, cu_CHAN_WEAPON, "hknight/attack1.wav", 1, cu_ATTN_NORM);
}

void(float cu_h_offset, float cu_v_offset) cu_hknight_shot =
{
	vector	cu_offang;
	vector	cu_vec;
	float	cu_badaim;

	cu_vec = cu_enemy_vispos() - self.origin;
	cu_vec += cu_enemy_aim_vertical();
	cu_offang = vectoangles(cu_vec);
	cu_offang_y = cu_offang_y + cu_h_offset * 6;
	cu_offang_x = -cu_offang_x;
	
	// assbolt protection
	cu_badaim = cu_angledif(vectoyaw(cu_vec), cu_offang_y) - 45;
	cu_badaim = cu_max(0, cu_badaim);
	cu_badaim = cu_badaim / 135;
	cu_vec = cu_lerpVector(cu_offang, self.angles + '0 6 0' * cu_h_offset, cu_badaim);

	makevectors(cu_vec);
	cu_vec = normalize(v_forward) + '0 0 0.05' * cu_v_offset;
	cu_hknight_bolt(cu_vec, '0 0 8');
}

void(float cu_v_offset) cu_hknight_shot2 =
{
	vector	cu_vec;

	cu_vec = cu_enemy_vispos() - self.origin;
	cu_vec += cu_enemy_aim_vertical();
	
	cu_vec = normalize(cu_vec) + '0 0 0.02' * cu_v_offset;
	cu_hknight_bolt(cu_vec, '0 0 22');
}


