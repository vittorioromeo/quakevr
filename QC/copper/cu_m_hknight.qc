//============================================================================

void() cu_hk_idle_sound =
{
	if (random() < 0.2 && time > self.cu_show_hostile)
		sound (self, cu_CHAN_VOICE, "hknight/idle.wav", 1, cu_ATTN_NORM);
}

void() cu_hknight_pain_go =
{
	cu_hknight_pain1 ();
	cu_PainFinished(1);
}

void(entity cu_attacker, float cu_damage)	cu_hknight_pain =
{
	if (self.cu_pain_finished > time)
		return;

	if (cu_skill < 3 && time - self.cu_pain_finished > 5)
	{	// always go into pain frame if it has been a while
		cu_hknight_pain_go();
		return;
	}
	
	if ( ( random()*30 > cu_damage ) )
		return;		// didn't flinch

	cu_hknight_pain_go();
}

float cu_hknight_type;

void() cu_hknight_melee =
{
	cu_hknight_type = cu_hknight_type + 1;

	sound (self, cu_CHAN_WEAPON, "hknight/slash1.wav", 1, cu_ATTN_NORM);
	if (cu_hknight_type == 1)
		cu_hknight_slice1 ();
	else if (cu_hknight_type == 2)
		cu_hknight_smash1 ();
	else if (cu_hknight_type == 3)
	{
		cu_hknight_watk1 ();
		cu_hknight_type = 0;
	}
}

void() cu_hknight_ranged =
{
	if (cu_skill == 3 && random() < 0.5)
		cu_hknight_magicnm1();
	else
		cu_hknight_magicc1();
}

void() cu_monster_hell_knight_spawn =
{
	self.classname = "monster_hell_knight";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/hknight.mdl");

	setsize (self, '-16 -16 -24', '16 16 40');

	self.cu_th_stand = cu_hknight_stand1;
	self.cu_th_walk = cu_hknight_walk1;
	self.cu_th_run = cu_hknight_run1;
	self.cu_th_melee = cu_hknight_melee;
	self.cu_th_missile = cu_hknight_ranged;
	self.cu_th_pain = cu_hknight_pain;
	self.cu_th_die = cu_hknight_die;
	self.cu_th_checkattack = cu_CheckAttack;

	self.cu_type = "brigade";	// no infighting amongst the hell death brigade legion squad

	if (self.deathtype == cu_string_null)
		self.deathtype = "was slain by a Death Knight";

	cu_walkmonster_start ();
}

void() cu_monster_hell_knight_spawner = {cu_mon_spawner_use(cu_monster_hell_knight_spawn);}

/*cu:QUAKED monster_hell_knight (1 0 0) (-16 -16 -24) (16 16 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
"Death" Knight, 250 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry
"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-16 -16 -24, 16 16 40) model({ "path": ":progs/hknight.mdl" }) = monster_hell_knight : "Death knight" []
*/
void() cu_monster_hell_knight =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model2 ("progs/hknight.mdl");
	precache_model2 ("progs/k_spike.mdl");
	precache_model2 ("progs/k_spike2.mdl");
	precache_model2 ("progs/h_hellkn.mdl");

	
	precache_sound2 ("hknight/attack1.wav");
	precache_sound2 ("hknight/death1.wav");
	precache_sound2 ("hknight/pain1.wav");
	precache_sound2 ("hknight/sight1.wav");
	precache_sound ("hknight/hit.wav");		// used by C code, so don't sound2
	precache_sound2 ("hknight/slash1.wav");
	precache_sound2 ("hknight/idle.wav");
	precache_sound2 ("hknight/grunt.wav");

	precache_sound ("knight/sword1.wav");
	precache_sound ("knight/sword2.wav");
	
	self.health = 250;
	setsize (self, '-16 -16 -24', '16 16 40');
	if ( cu_monster_spawnsetup( cu_monster_hell_knight_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_hell_knight_spawn();
}
