/*
===============================================================================

POWERUPS

===============================================================================
*/

/*
===============
powerup_envirosuit
===============
*/
void(entity cu_h, float cu_t) cu_powerup_envirosuit =
{
	sprint (cu_h, "It's stuffy in this thing ...\n");
	cu_h.items |= cu_IT_SUIT;
	cu_h.cu_rad_time = 1;
	cu_h.cu_radsuit_finished = time + cu_t;
}

/*
===============
powerup_invulnerability
===============
*/
void(entity cu_h, float cu_t) cu_powerup_invulnerability =
{
	sprint (cu_h, "An unholy ward surrounds you ...\n");
	cu_h.items |= cu_IT_INVULNERABILITY;
	cu_h.cu_invincible_time = 1;
	cu_h.cu_invincible_finished = time + cu_t;
}

/*
===============
powerup_invisibility
===============
*/
void(entity cu_h, float cu_t) cu_powerup_invisibility =
{
	sprint (cu_h, "Others' eyes deceive them, but yours give you away ...\n");
	cu_h.items |= cu_IT_INVISIBILITY;
	//h.notrace = 1;
	cu_h.cu_invisible_time = 1;
	cu_h.cu_invisible_finished = time + cu_t;
	cu_h.cu_invisible_sound = time + 1.5;
}

/*
===============
powerup_super_damage
===============
*/
void(entity cu_h, float cu_t) cu_powerup_super_damage =
{
	sprint (cu_h, "You begin to channel unstoppable power ...\n");
	cu_h.items |= cu_IT_QUAD;
	cu_h.cu_super_damage_finished = time + cu_t;
	cu_h.cu_super_time = 1;
}

/*
===============
powerup_touch
===============
*/
void() cu_powerup_touch =
{
	if ( !cu_CheckValidTouch() ) return;

	sound (other, cu_CHAN_POWERUP, self.noise, 1, cu_ATTN_NORM);
	stuffcmd (other, "bf\n");
	other.items = other.items | self.items;

	if (self.classname == "item_artifact_envirosuit")
		cu_powerup_envirosuit(other, 30);
	
	if (self.classname == "item_artifact_invulnerability")
		cu_powerup_invulnerability(other, 30);
	
	if (self.classname == "item_artifact_invisibility")
		cu_powerup_invisibility(other, 30);

	if (self.classname == "item_artifact_super_damage")
		cu_powerup_super_damage(other, 30);

	cu_ItemTouched();
}


/*
===============================================================================

PENTAGRAM

===============================================================================
*/
void() cu_precache_invulnerability =
{
	cu_precache_model_safe ("progs/invul.mdl");
	cu_precache_sound_safe ("items/protect.wav");
	cu_precache_sound_safe ("items/protect2.wav");
	cu_precache_sound_safe ("items/protect3.wav");
}
/*cu:QUAKED item_artifact_invulnerability (0 .5 .5) (-16 -16 -24) (16 16 32) ? ? SUSPENDED
Pentagram of Protection. Player is invulnerable for 30 seconds (both health and armor).

Keys:
"target/2/3/4/k" - entity to trigger when picked up
"targetname" - will not spawn until triggered
"wait" - will respawn after 'wait' seconds. fires targets every time.
"count" - limit number of times to respawn
*/
/*FGD
@PointClass size(-16 -16 -24, 16 16 32) color(255 0 0) base(Item) model({ "path": ":progs/invul.mdl" }) =
	item_artifact_invulnerability : "Pentagram of Protection. Player is invulnerable for 30 seconds (both health and armor)." []
*/
void() cu_item_artifact_invulnerability =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.touch = cu_powerup_touch;
	cu_precache_invulnerability();
	
	self.noise = "items/protect.wav";
	setmodel (self, "progs/invul.mdl");
	self.netname = "Pentagram of Protection";
	self.items = cu_IT_INVULNERABILITY;
	setsize (self, '-16 -16 -24', '16 16 32');
	if (deathmatch)
		self.wait = 300;
	cu_StartItem ();
}


