void(entity cu_attacker, float cu_damage)	cu_army_pain =
{
	local float cu_r;
	
	if (self.cu_pain_finished > time)
		return;

	cu_r = random();

	if (cu_r < 0.2)
	{
		cu_PainFinished(0.6);
		cu_army_pain1 ();
		sound (self, cu_CHAN_VOICE, "soldier/pain1.wav", 1, cu_ATTN_NORM);
	}
	else if (cu_r < 0.6)
	{
		cu_PainFinished(1.1);
		cu_army_painb1 ();
		sound (self, cu_CHAN_VOICE, "soldier/pain2.wav", 1, cu_ATTN_NORM);
	}
	else
	{
		cu_PainFinished(1.1);
		cu_army_painc1 ();
		sound (self, cu_CHAN_VOICE, "soldier/pain2.wav", 1, cu_ATTN_NORM);
	}
}

/*
vanilla grunts pretend to lag their shots by applying negative leading based
on player velocity. SV_PushMove only sets origins per hostframe and doesn't 
modify velocities, so a player standing on a train or a lift will have zero 
velocity and get drilled constantly. (see: SMEJ w1m1)

grunts now choose an aim vector 0.3 seconds before firing, rather than trying 
to work 0.2 seconds backwards at firing time
*/
void() cu_army_aim =
{
	// store it relative to self in case we're riding the same mover as our target
	self.dest = cu_enemy_vispos() + cu_enemy_aim_vertical() - self.origin;
}

void() cu_army_fire =
{
	local	vector	cu_dir;
	
	cu_ai_face();
	self.effects = self.effects | cu_EF_MUZZLEFLASH;	
	sound (self, cu_CHAN_WEAPON, "soldier/sattck1.wav", 1, cu_ATTN_NORM);	

// fire somewhat behind the player, so a dodging player is harder to hit
//	dir = enemy_vispos() - self.enemy.velocity*0.2;
//	dir = normalize (dir - self.origin);
	cu_dir = normalize (self.dest);

	// lunaran: moved multidamage here
	cu_ClearMultiDamage ();
	cu_FireBullets (4, cu_dir, '0.1 0.1 0');
	cu_ApplyMultiDamage ();
}


/*
===========
SoldierCheckAttack

The player is in view, so decide to move or launch an attack
Returns FALSE if movement should continue
============
*/
float() cu_SoldierCheckAttack =
{
	local float		cu_chance;

	if (time < self.cu_attack_finished)
		return cu_FALSE;
		
	if (cu_enemy_range >= cu_RANGE_FAR)
		return cu_FALSE;
		
	if (!cu_CheckClearAttack()) return cu_FALSE;

	// missile attack
	
	if (cu_enemy_range == cu_RANGE_MELEE)
		cu_chance = 0.9;
	else if (cu_enemy_range == cu_RANGE_NEAR)
		cu_chance = 0.4;
	else if (cu_enemy_range == cu_RANGE_MID)
		cu_chance = 0.05;
	else
		cu_chance = 0;

	if (random () < cu_chance)
	{
		self.cu_attack_state = cu_AS_MISSILE;
		cu_ai_attack_finished (1 + random() + random());
		return cu_TRUE;
	}

	return cu_FALSE;
}
