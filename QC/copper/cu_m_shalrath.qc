void() cu_monster_shalrath_spawn =
{
	self.classname = "monster_shalrath";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;
	
	setmodel (self, "progs/shalrath.mdl");
	setsize (self, cu_VEC_HULL2_MIN, cu_VEC_HULL2_MAX);
	self.health = 400;

	self.cu_th_stand = cu_shal_stand;
	self.cu_th_walk = cu_shal_walk1;
	self.cu_th_run = cu_shal_run1;
	self.cu_th_die = cu_shalrath_die;
	self.cu_th_pain = cu_shalrath_pain;
	self.cu_th_missile = cu_shal_attack1;
	self.cu_th_checkattack = cu_CheckAttack;

	if (self.deathtype == cu_string_null)
		self.deathtype = "was exploded by a Vore";
		
	//self.think = walkmonster_start;
	//self.nextthink = time + 0.1 + random ()*0.1;	
	
	cu_walkmonster_start();
}

void() cu_monster_shalrath_spawner = {cu_mon_spawner_use(cu_monster_shalrath_spawn);}


/*cu:QUAKED monster_shalrath (1 0 0) (-32 -32 -24) (32 32 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Vore (Shalrath), 400 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry

"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-32 -32 -24, 32 32 64) model({ "path": ":progs/shalrath.mdl" }) = monster_shalrath : "Vore" []
*/
void() cu_monster_shalrath =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model2 ("progs/shalrath.mdl");
	precache_model2 ("progs/h_shal.mdl");
	precache_model2 ("progs/v_spike.mdl");
	precache_model2 ("progs/v_spike2.mdl");
	
	precache_sound2 ("shalrath/attack.wav");
	precache_sound2 ("shalrath/attack2.wav");
	precache_sound2 ("shalrath/death.wav");
	precache_sound2 ("shalrath/idle.wav");
	precache_sound2 ("shalrath/pain.wav");
	precache_sound2 ("shalrath/sight.wav");
	
	self.health = 400;
	setsize (self, cu_VEC_HULL2_MIN, cu_VEC_HULL2_MAX);
	if ( cu_monster_spawnsetup( cu_monster_shalrath_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_shalrath_spawn();
}
