void( entity cu_attacker, float cu_damage ) cu_shalrath_pain =
{
	if (self.health <= 0) return;
	if (self.cu_pain_finished > time) return;

	sound (self, cu_CHAN_VOICE, "shalrath/pain.wav", 1, cu_ATTN_NORM);
	cu_shal_pain1();
	
	cu_PainFinished(3);
}

void() cu_shalrath_die =
{
// check for gib
	if (self.health < -90)
	{
		cu_Gib ("progs/h_shal.mdl", self.health);
		return;
	}

	sound (self, cu_CHAN_VOICE, "shalrath/death.wav", 1, cu_ATTN_NORM);
	cu_shal_death1();
}

/*
================
ShalMissile
================
*/

void() cu_ShalMissileExplode =
{
	cu_T_RadiusDamage (self, self.cu_trueowner, 40, world, cu_DMGTYPE_EXPLOSION); // QVR: the parameter's default, explicit
	//sound (self, CHAN_WEAPON, "weapons/r_exp3.wav", 1, ATTN_NORM);

	cu_T_ExplosiveTouch();
}

void() cu_ShalMissileTouch =
{
	if (cu_CheckProjectilePassthru()) return;
	if (other == self.owner)
		return;		// don't explode on owner

	if (other.cu_type == "zombie")
		cu_T_Damage (other, self, self.cu_trueowner, other.health + 25);
	else if (other.cu_type == "zombie")
		cu_T_Damage (other, self, self.cu_trueowner, 24);
	
	cu_ShalMissileExplode();
}

vector(vector cu_targ, float cu_turnrate) cu_ShalTurnToward =
{
	vector	cu_vel, cu_aimdir, cu_temp, cu_temp2, cu_out;

	cu_temp = cu_targ + '0 0 10';
	cu_aimdir = cu_temp - self.origin;
	cu_aimdir = normalize(cu_aimdir);
	cu_vel = normalize(self.velocity);
	
	cu_temp = cu_CrossProduct(cu_vel, cu_aimdir);
	
	// try to flatten the rotation to the horizontal plane unless the difference is extreme
	if (fabs(cu_temp_z) > 0.92)
	{
		cu_temp_z *= 4;
		cu_temp = normalize(cu_temp);
	}
	cu_out = cu_rotateVectorAround(cu_vel, cu_temp, cu_turnrate * cu_SHAL_BALL_THINK_RATE);
	
	// don't turn past the desired direction
	cu_temp2 = cu_CrossProduct(cu_out, cu_aimdir);
	if ((cu_temp * cu_temp2) < 0)
		return cu_aimdir;
	return cu_out;
}

void() cu_ShalHome =
{
	// a voreball with perfect homing causes combat to effectively stop, forcing the player
	// to run around around trying to shake it, often backpedaling through lots of empty map.
	// limiting the voreball's turn rate so they can be dodged and forgotten about makes vores
	// a more flexible enemy and more useful to the mapper
	float cu_dist, cu_rate, cu_dot;
	
	if (self.cu_lifetime_finished < time)
	{
		cu_ShalMissileExplode();
		return;
	}		
	if (!cu_alive(self.enemy))
	{
		self.think = cu_ShalMissileExplode;
		self.nextthink = self.cu_lifetime_finished;
		//remove(self);
		return;
	}
	
	if (!self.deadflag)
	{
		if ( self.owner.health <= 0		// if our mama dies
			|| self.owner.cu_customflags & cu_CFL_PLUNGE )	// or falls in a hole
		{
			self.deadflag = cu_TRUE;
			setmodel(self, "progs/v_spike2.mdl");	// stop sparkling
			setsize(self, cu_VEC_ORIGIN, cu_VEC_ORIGIN);
		}
	}
	
	self.think = cu_ShalHome;
	self.nextthink = time + cu_SHAL_BALL_THINK_RATE;
	cu_rate = cu_SHAL_BALL_TURN_RATE;
	cu_dot = normalize(self.velocity) * normalize(self.enemy.origin - self.origin);
	
	// reset our owner regularly, or else a voreball that passes through a notrace-invisible
	// player will become owned by the player and remain nonsolid to them after the ring ends
	self.owner = self.cu_trueowner;
	// if the projectile is inside a notrace entity at this time, it'll touch again this frame
	// and reset anyway, so this state will pingpong until it passes out the other side
	
	// go faster at long distance to close the gap, so snipey vores have a better presence
	cu_dist = vlen(self.enemy.origin - self.origin);
	cu_dist = cu_saturate( (cu_dist-200) / 600 );
	
	if (cu_skill < 3)
	{
		// 'poor' homing (half turn rate):
		if ( self.deadflag		// if our mama dies or falls in a hole
			//|| !visible(self.enemy)		// if we lost LOS
			// took ^^ this one out, because it made voreballs even more effective at going
			// around corners, which meant that courageous players had a nice new dodge move
			// but those who tried to fight the vore the old cautious way were punished			
			|| cu_has_invis(self.enemy)			// if target is invis
			|| pointcontents(self.origin) < cu_CONTENT_SOLID ) // if voreball is underwater
		{
			// voreballs headed straight at the player when he's hidden should maintain course, to
			// make the dodge possible without it immediately turning to hit him
			if (cu_dot > 0)
			{
				cu_rate *= cu_max(1, 1.5 * (1 - cu_dot));
			}
			self.velocity = cu_SHAL_BALL_VEL * cu_ShalTurnToward(self.enemy.origin, cu_rate * 0.33);
		}
		else // good homing (full turn rate):
		{
			// voreballs headed straight away from the player don't normally seem to be able to pick a direction to 
			// turn and wobble more or less straight away - amp turn rate in these cases to force a 'decision'
			if (cu_dot < 0)
			{
				cu_rate *= cu_min(1.4, 1.4 + fabs(cu_dot));
			}
			self.velocity = cu_SHAL_BALL_VEL * cu_ShalTurnToward(self.enemy.origin, cu_rate);
		}
		
		self.velocity *= 1 + cu_dist;
		self.velocity += cu_Vector(cu_crandom(),cu_crandom(),cu_crandom()) * 16;
	}
	else
	{
		// nightmare: vanilla-evil homing with corner following to force engagement rather than encourage it
		cu_enemy_vis = cu_visible(self.enemy);
		
		self.cu_dest2 = self.dest;
		if (cu_enemy_vis)	// go straight to follow player around corners
		{
			// remember last seen positions for corner hax
			self.dest = self.enemy.origin;
		}
		else if (self.cu_dest2 == self.dest)
		{
			// player has been out of sight for two frames, don't keep changing velocity or
			// when we reach that point we'll dance around it weirdly
			self.cu_oldvelocity = self.velocity;
			return;
		}
		
		// poor homing
		if ( self.deadflag		// if our mama dies or falls in a hole
			|| pointcontents(self.origin) < cu_CONTENT_SOLID )
		{
			if (cu_dot > 0)
			{
				cu_rate *= cu_max(1, 1.5 * (1 - cu_dot));
			}
			self.velocity = cu_SHAL_BALL_VEL * cu_ShalTurnToward(self.cu_dest2, cu_rate * 0.5);
		}
		else // evile homing
		{
			self.velocity = cu_SHAL_BALL_VEL * normalize(self.cu_dest2 + '0 0 10' - self.origin);
		}
		
		self.velocity *= 1 + cu_dist;
		self.velocity += cu_Vector(cu_crandom(),cu_crandom(),cu_crandom()) * 16;
	}

	self.cu_oldvelocity = self.velocity;	
}


void() cu_ShalMissile =
{
	entity 	cu_missile;
	vector	cu_dir;

	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	sound (self, cu_CHAN_WEAPON, "shalrath/attack2.wav", 1, cu_ATTN_NORM);
	makevectors(self.angles);
	
	cu_dir = (cu_enemy_vispos() + '0 0 10') - self.origin + cu_enemy_aim_vertical();
	cu_dir = normalize(cu_dir);
	
	// if player has strafed around behind, don't lob the missile out of our ass
	if (cu_angledif(self.ideal_yaw, self.angles_y) > 80)
	{
		cu_dir_x = v_forward_x;
		cu_dir_y = v_forward_y;
		cu_dir = normalize(cu_dir);
	}
	
	cu_missile = cu_launch_projectile(self.origin + '0 0 10' + v_forward * 16, cu_dir * cu_SHAL_BALL_VEL, "voreball");

	cu_SUB_ChangeModel (cu_missile, "progs/v_spike.mdl");

	cu_missile.avelocity = '300 300 300';
	cu_missile.nextthink = time + 0.1;
	cu_missile.think = cu_ShalHome;
	cu_missile.enemy = self.enemy;
	cu_missile.touch = cu_ShalMissileTouch;
	cu_missile.cu_lifetime_finished = time + 30;	 // blow up after a while
	if (cu_skill == 3) cu_missile.dest = self.dest;
}

