/*
=============
SUB_CalcAngleMoveDone
===============
*/
void() cu_SUB_CalcAngleMoveDone =
{
// After rotating, set angle to exact final angle
	self.angles = self.cu_dest2;
	self.avelocity = '0 0 0';
	self.nextthink = -1;
	if (self.cu_think1)
		self.cu_think1();
}

/*
=============
SUB_CalcAngleMove

calculate self.avelocity and self.nextthink to reach destangle from
self.angles rotating 

The calling function should make sure self.think is valid
===============
*/
void(vector cu_destangle, float cu_tspeed, void() cu_func) cu_SUB_CalcAngleMove =
{
local vector	cu_destdelta;
local float		cu_len, cu_traveltime;

	if (!cu_tspeed)
		objerror( "No speed is defined!");
		
// set destdelta to the vector needed to move
	cu_destdelta = cu_destangle - self.angles;
	
// calculate length of vector
	cu_len = vlen (cu_destdelta);
	
// divide by speed to get time to reach dest
	cu_traveltime = cu_len / cu_tspeed;

// set nextthink to trigger a think when dest is reached
	self.nextthink = self.ltime + cu_traveltime;

// scale the destdelta vector by the time spent traveling to get velocity
	self.avelocity = cu_destdelta * (1 / cu_traveltime);
	
	self.cu_think1 = cu_func;
	self.cu_dest2 = cu_destangle;
	self.think = cu_SUB_CalcAngleMoveDone;
}

/*
=============
SUB_CalcAngleMoveEnt
===============
*/
void(entity cu_ent, vector cu_destangle, float cu_tspeed, void() cu_func) cu_SUB_CalcAngleMoveEnt =
{
	local entity cu_stemp;
	cu_stemp = self;
	self = cu_ent;
	cu_SUB_CalcAngleMove (cu_destangle, cu_tspeed, cu_func);
	self = cu_stemp;
}