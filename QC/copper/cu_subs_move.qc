/*
=============
SetMovedir
===============
*/
void() cu_SetMovedir =
{
	if (self.movedir != cu_VEC_ORIGIN) return;	// we already did
	
	vector cu_t_angle;
	cu_t_angle = '0 0 0';
	if (self.mangle != '0 0 0')
	{
		cu_t_angle = self.angles;
		if (cu_t_angle == '0 -1 0')
			cu_t_angle = '0 -90 0';
		else if (cu_t_angle == '0 -2 0')
			cu_t_angle = '0 90 0';
		
	//	self.angles_x = self.mangle_y;
	//	self.angles_y = self.mangle_x;
	//	self.angles_z = self.mangle_z;
		self.angles = cu_Vector(self.mangle_y,self.mangle_x,self.mangle_z);
	}
	
	if (self.angles == '0 -1 0')
		self.movedir = '0 0 1';
	else if (self.angles == '0 -2 0')
		self.movedir = '0 0 -1';
	else
	{
		makevectors (self.angles);
		self.movedir = v_forward;
	}
	
	self.angles = cu_t_angle;
}

// ================================================================

/*
=============
SUB_CalcMoveDone
===============
*/
void()  cu_SUB_CalcMoveDone =
{
// After moving, set origin to exact final destination
	setorigin(self, self.cu_finaldest);
	self.velocity = '0 0 0';
	self.nextthink = -1;
	if (self.cu_think1)
		self.cu_think1();
}

/*
=============
SUB_CalcMove

calculate self.velocity and self.nextthink to reach dest from
self.origin traveling at speed
===============
*/
void(vector cu_tdest, float cu_tspeed, void() cu_func) cu_SUB_CalcMove =
{
	vector	cu_vdestdelta;
	float	cu_len, cu_traveltime;
	float	cu_chron = cu_localtime(self);

	if (!cu_tspeed)
		objerror( "No speed is defined!" );

	self.cu_think1 = cu_func;
	self.cu_finaldest = cu_tdest;
	self.think = cu_SUB_CalcMoveDone;

	if (cu_tdest == self.origin)
	{
		self.velocity = '0 0 0';
		self.nextthink = cu_chron + 0.1;
		return;
	}
		
// set destdelta to the vector needed to move
	cu_vdestdelta = cu_tdest - self.origin;
	
// calculate length of vector
	cu_len = vlen (cu_vdestdelta);
	
// divide by speed to get time to reach dest
	cu_traveltime = cu_len / cu_tspeed;

	if (cu_traveltime < 0.1)
	{
		self.velocity = '0 0 0';
		self.nextthink = cu_chron + 0.1;
		return;
	}
	
// set nextthink to trigger a think when dest is reached
	self.nextthink = cu_chron + cu_traveltime;

// scale the destdelta vector by the time spent traveling to get velocity
	self.velocity = cu_vdestdelta * (1/cu_traveltime);	// qcc won't take vec/float
}

/*
=============
SUB_CalcMoveEnt
===============
*/
void(entity cu_ent, vector cu_tdest, float cu_tspeed, void() cu_func) cu_SUB_CalcMoveEnt =
{
	local entity cu_stemp;
	cu_stemp = self;
	self = cu_ent;

	cu_SUB_CalcMove (cu_tdest, cu_tspeed, cu_func);
	self = cu_stemp;
}


// ================================================================

void() cu_shadowmonitor_think =
{
	float cu_frac;
	entity cu_o = self.owner;
	
	cu_frac = vlen(cu_o.origin - self.pos2) / vlen(self.pos2 - self.pos1);
	if (self.cu_customflags & cu_CFL_INVLIGHT)
		cu_frac = 1 - cu_frac;
	cu_bmodel_lightstyle(cu_o, cu_frac);
	
	self.nextthink = time + cu_min(0.05, (cu_o.nextthink - cu_localtime(cu_o)));

	// remove last so we don't miss a final eval
	if (self.nextthink <= time || 
		cu_localtime(cu_o) > self.cu_lifetime_finished || 
		self.state != cu_o.state)
		remove(self);
}

// move while blending lightstyles smoothly over the distance traveled

// to avoid damaging existing movement logic with extra thinks, we wrap
// it and create a helper entity to do this instead
void(vector cu_tstart, vector cu_tdest, float cu_tspeed, void() cu_endfn, float cu_invert) cu_SUB_CalcMoveLight =
{
	if (self.style || self.cu_switchshadstyle)
	{
		entity cu_mon = spawn();
		cu_mon.classname = "shadowmonitor";
		cu_mon.owner = self;
		cu_mon.state = self.state;	// removes self if these stop matching
		cu_mon.cu_lifetime_finished = cu_localtime(self) + vlen(cu_tdest - self.origin) / cu_tspeed;
		cu_mon.think = cu_shadowmonitor_think;
		cu_mon.nextthink = time;
		cu_mon.pos1 = cu_tstart;
		cu_mon.pos2 = cu_tdest;
		if (cu_invert)
			cu_mon.cu_customflags |= cu_CFL_INVLIGHT;
	}	
	cu_SUB_CalcMove(cu_tdest, cu_tspeed, cu_endfn);
}


