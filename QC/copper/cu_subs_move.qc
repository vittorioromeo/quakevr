/*
CURVACEOUS MOVE

pathcorners can have a curve spawnflag that marks them as bezier control points
bezier path corners affect the curve but will never be visited
	this means they don't affect speed, don't fire targets, etc
*/

void() cu_SUB_CalcMoveCurveSeg =
{
	float cu_chron = cu_localtime(self);
	// self.cnt is number of steps we've passed through
	// (when self.cnt == nodeCtrl.count we should be at nodeEnd)
	if (self.cu_cnt == self.count)
	{
		self.pos2 = cu_VEC_ORIGIN;
		cu_SUB_CalcMoveDone();
		return;
	}
	self.cu_cnt += 1;
	
	float cu_t = self.cu_cnt / self.count;
	vector cu_destdelta = cu_bez(self.pos1, self.pos2, self.cu_finaldest, cu_t) - self.origin;
	
	float cu_wishspeed = cu_lerp(self.speed, self.speed2, cu_t);
	float cu_traveltime = vlen(cu_destdelta) / cu_wishspeed;
	if (cu_traveltime < 0.05)
	{
		self.velocity = cu_VEC_ORIGIN;
		self.nextthink = cu_chron + 0.05;
		self.think = cu_SUB_CalcMoveDone;
		return;
	}	
	self.velocity = cu_destdelta * (1/cu_traveltime);
	self.think = cu_SUB_CalcMoveCurveSeg;
	self.nextthink = cu_chron + cu_traveltime;
}

// init curved motion
void(vector cu_end, vector cu_ctrl, float cu_segs, float cu_speedStart, float cu_speedEnd, void() cu_fnDone) cu_SUB_CalcMoveCurve =
{
	// self.oldenemy is current pathcorner already
	self.pos1 = self.origin;
	self.pos2 = cu_ctrl;
	self.cu_finaldest = cu_end;
	self.speed = cu_speedStart;
	self.speed2 = cu_speedEnd;
	self.cu_cnt = 0;
	self.count = cu_segs;
	self.cu_think1 = cu_fnDone;
	
	cu_SUB_CalcMoveCurveSeg();
}



