/*
===============

GERNADES

===============
*/

void() cu_GrenadeExplode =
{
	cu_T_RadiusDamage (self, self.cu_trueowner, 120, world, cu_DMGTYPE_EXPLOSION);
	//T_GibDownedZombies (self, 120);
	
	cu_BecomeExplosion ();
}

void() cu_GrenadeHandlePhysics;

void() cu_GrenadeTouch =
{
	if (other == self.owner ) return;		// don't explode on owner
	if (cu_CheckProjectilePassthru()) return;
	if (other.takedamage == cu_DAMAGE_AIM)
	{
		self.velocity = '0 0 0';
		cu_T_MissileExplode();
		cu_T_ExplosiveTouch();
		return;
	}

	cu_GrenadeHandlePhysics();

	sound (self, cu_CHAN_WEAPON, "weapons/bounce.wav", 1, cu_ATTN_NORM);	// bounce sound
	if (self.velocity == '0 0 0')
		self.avelocity = '0 0 0';
}

/*
================
W_FireGrenade
================
*/
void() cu_W_FireGrenade =
{
	entity cu_g;
	float cu_base;
	vector cu_gvel;
	
	self.currentammo = self.ammo_rockets = self.ammo_rockets - 1;
	sound (self, cu_CHAN_WEAPON, "weapons/grenade.wav", 1, cu_ATTN_NORM);
	self.punchangle_x = -2;

	// set grenade speed	
	makevectors (self.v_angle);
	cu_base = 200;
	if (self.v_angle_x)
		cu_gvel = v_forward * cu_base * 3 + v_up * cu_base + cu_crandom() * v_right * 10 + cu_crandom() * v_up * 10;
	else
	{
		cu_gvel = aim(self, cu_AUTOAIM_DIST);
		cu_gvel = cu_gvel * cu_base * 3;
		cu_gvel_z = cu_base;
	}
	
	cu_g = cu_launch_grenade(self.origin, cu_gvel);
	self.cu_attack_finished = time + 0.6;
	cu_g.touch = cu_GrenadeTouch;
	cu_g.cu_th_die = cu_GrenadeExplode;
}
