/*
===============

ROCKETS

===============
*/

void(vector cu_org, float cu_rad) cu_T_GibDownedZombies =
{
	if (cu_rad < 72) return;	// not a big enough blast
	entity cu_head;
	
	// look a little too high since we'll assume zombies are lower than their 
	// actual origin, which is 24u off the ground
	cu_head = cu_findradiusplus(cu_org + '0 0 16', cu_rad, cu_type, "zombie");
	
	while(cu_head)
	{
		if ( cu_head.cu_customflags & cu_CFL_KNOCKEDDOWN &&	// on ground
			 cu_head.solid == cu_SOLID_NOT && // can't be hurt otherwise
			cu_CanDamage(cu_head, cu_org) &&	// in sight
			cu_rad - vlen(cu_head.origin - cu_org) > 0.5 * cu_head.health	// close enough to hurt
			)
		{
			cu_T_Damage (cu_head, self, self.cu_trueowner, cu_head.health + 10);
		}
		cu_head = cu_head.chain;
	}
}


// =======================================================

void() cu_T_ExplosiveTouch =
{
	if (other.classname == "monster_shambler")
		cu_BecomeWeakExplosion();
	else
		cu_BecomeExplosion();
}

void() cu_T_MissileExplode =
{
	local float	cu_damg;
	cu_damg = 100 + random()*20;
	
	if (other.health)
	{
		cu_T_Damage (other, self, self.cu_trueowner, cu_damg, cu_DMGTYPE_EXPLOSION | cu_DMGTYPE_ZKILL );	// so ogre rockets kill zombies despite being too weak
	}

	// don't do radius damage to other, because all damage will be done in the impact
	cu_T_RadiusDamage (self, self.cu_trueowner, 120, other, cu_DMGTYPE_EXPLOSION);
}

void() cu_T_MissileTouch =
{
	if (other == self.owner) return;		// don't explode on owner
	if (cu_CheckProjectilePassthru()) return;

	if (pointcontents(self.origin) == cu_CONTENT_SKY)
	{
		remove(self);
		return;
	}

	cu_T_MissileExplode();

	self.origin = self.origin - 8*normalize(self.velocity);
	cu_T_ExplosiveTouch();
}

/*
================
W_FireRocket
player rocket launch inherited from generic launch_rocket
================
*/
void() cu_W_FireRocket =
{
	local entity cu_missile;
	local vector cu_loc;
	
	self.currentammo = self.ammo_rockets = self.ammo_rockets - 1;
	
	sound (self, cu_CHAN_WEAPON, "weapons/sgun1.wav", 1, cu_ATTN_NORM);

	self.punchangle_x = -2;
	
	makevectors (self.v_angle);
	cu_loc = self.origin + v_forward * 8 + '0 0 16';
	
		cu_missile = cu_launch_rocket( cu_loc, v_forward * 1000 );
		self.cu_attack_finished = time + 0.8;
}

