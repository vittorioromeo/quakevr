/*
============
ammo_touch
============
*/
void() cu_ammo_touch =
{
	if (!cu_CheckValidTouch()) return;

	// structured in dual if's instead of using && to preserve ammo_touch maphacks
	if (self.ammo_shells)
	{
		if (other.ammo_shells < cu_MAX_AMMO_SHELLS)
			other.ammo_shells += self.ammo_shells;
		else return;
	}
	else if (self.ammo_nails)
	{
		if (other.ammo_nails < cu_MAX_AMMO_NAILS)
			other.ammo_nails += self.ammo_nails;
		else return;
	}
	else if (self.ammo_rockets)
	{
		if (other.ammo_rockets < cu_MAX_AMMO_ROCKETS)
			other.ammo_rockets += self.ammo_rockets;
		else return;
	}
	else if (self.ammo_cells)
	{
		if (other.ammo_cells < cu_MAX_AMMO_CELLS)
			other.ammo_cells += self.ammo_cells;
		else return;
	}
	//else return;	

	cu_bound_ammo(other);
	
	sprint (other, "You got the ");
	sprint (other, self.netname);
	sprint (other, "\n");

	sound (other, cu_CHAN_ITEM, "weapons/lock4.wav", 1, cu_ATTN_NORM);
	stuffcmd (other, "bf\n");

	if (!self.weapon)
		cu_SUB_CallAsSelf(cu_W_SelectBestWeapon, other);
	else
		// if changed current ammo, update it	
		cu_SUB_CallAsSelf(cu_W_SetCurrentAmmo, other);
	
	cu_ItemTouched();
}

/*
============
StartAmmo
============
*/
void() cu_StartAmmo =
{
	self.cu_type = "ammo";
	setsize (self, '0 0 0', '32 32 56');
	self.touch = cu_ammo_touch;
	if (deathmatch == 1)
		self.wait = 30;
	if (deathmatch == 3)
		self.wait = 15;
	cu_StartItem ();
	//ItemRotateAndSize('32 32 56');
}

