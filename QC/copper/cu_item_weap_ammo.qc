// ================================


// still used in a few id maps, bleh
void() cu_item_weapon =
{
	float cu_WEAPON_SHOTGUN = 1;
	float cu_WEAPON_ROCKET = 2;
	float cu_WEAPON_SPIKES = 4;
	float cu_WEAPON_BIG = 8;
	
	float cu_oldflags;
	cu_oldflags = self.spawnflags & 15;
	self.spawnflags = cu_not(self.spawnflags, 15);
	
	if (cu_oldflags & cu_WEAPON_BIG)
		self.spawnflags = self.spawnflags | cu_ITEM_AMMO_BIG;
	
	if (cu_oldflags & cu_WEAPON_SHOTGUN)
		cu_item_shells();
	else if (cu_oldflags & cu_WEAPON_SPIKES)
		cu_item_spikes();
	else if (cu_oldflags & cu_WEAPON_ROCKET)
		cu_item_rockets();
};