float	cu_ITEM_AMMO_BIG = 1;


void(entity cu_e) cu_bound_ammo =
{
	cu_e.ammo_shells = cu_min(cu_e.ammo_shells, cu_MAX_AMMO_SHELLS);
	cu_e.ammo_nails = cu_min(cu_e.ammo_nails, cu_MAX_AMMO_NAILS);
	cu_e.ammo_rockets = cu_min(cu_e.ammo_rockets, cu_MAX_AMMO_ROCKETS);
	cu_e.ammo_cells = cu_min(cu_e.ammo_cells, cu_MAX_AMMO_CELLS);
}

/*
=============
weapon_touch_coop
=============
*/
void() cu_weapon_touch_coop =
{
	if (!coop) return;
	cu_activator = other;
	cu_SUB_UseTargets();
	self.killtarget = cu_string_null;
	self.target = cu_string_null;
	self.cu_target2 = cu_string_null;
	self.cu_target3 = cu_string_null;
	self.cu_target4 = cu_string_null;
}

void(entity cu_to) cu_weapon_give =
{
	cu_to.items |= self.items;
	cu_to.ammo_shells += self.ammo_shells;
	cu_to.ammo_nails += self.ammo_nails;
	cu_to.ammo_rockets += self.ammo_rockets;
	cu_to.ammo_cells += self.ammo_cells;
		
	cu_bound_ammo(cu_to);

	sprint (cu_to, "You got the ");
	sprint (cu_to, self.netname);
	sprint (cu_to, "\n");

	sound (cu_to, cu_CHAN_ITEM, "weapons/pkup.wav", 1, cu_ATTN_NORM);
	stuffcmd (cu_to, "bf\n");
}

/*
=============
weapon_touch
=============
*/
void() cu_weapon_touch =
{
	float	cu_leave, cu_nsw;

	if (!cu_CheckValidTouch()) return;

	if (deathmatch == 2 || deathmatch == 3 || coop > 1)
		cu_leave = 1;
	else
		cu_leave = 0;
	
	if (cu_leave)
	{
		if ((other.items & self.items) == self.items)	// already have it
		{
			cu_weapon_touch_coop();
			return;
		}
	}
	
	if (self.items & other.items) cu_nsw = cu_TRUE;

	cu_weapon_give(other);
	// change to the weapon
	if (cu_nsw)
		cu_SUB_CallAsSelf(cu_W_ResetWeaponState, other);
	else
		cu_W_BetterWeapon(other, self.items);

	if (coop == 1)
	{
		entity cu_pl = cu_get_next_client(other);
		while (cu_pl != other)
		{
			cu_weapon_give(cu_pl);
			cu_pl = cu_get_next_client(cu_pl);
		}
	}
	
	if (cu_leave)
	{
		cu_weapon_touch_coop();
		return;
	}

	cu_ItemTouched();
}


/*
============
StartWeapon
============
*/
void() cu_StartWeapon =
{
	self.cu_type = "weapon";
	self.touch = cu_weapon_touch;
	setsize (self, '-16 -16 0', '16 16 56');
	if (deathmatch == 1)
		self.wait = 30;
	cu_StartItem ();
}


