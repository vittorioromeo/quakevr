/*
================================================================

	MISC SUBSTITUTION FUNCTIONS

================================================================
*/

void() cu_SUB_Null = {}

/*
=============
SUB_Remove/SUB_RemoveSoon

RemoveSoon is to be used during touch functions to avoid touchlinks errors
===============
*/
void() cu_SUB_Remove = { remove(self); }
void() cu_SUB_RemoveSoon = 
{
	// ensure no shenanigans take place in the next hundredth of a second
	// otherwise we get weirdness like items being picked up twice at high framerates
	self.model = cu_string_null;
	self.solid = cu_SOLID_NOT;
	self.touch = cu_SUB_Null;
	self.use = cu_SUB_Null;
	
	self.think = cu_SUB_Remove;
	self.nextthink = time;
}

/*
=============
RemoveTarget

take an entity out of gameplay (independent of 'killing' it)
===============
*/
void(entity cu_victim) cu_RemoveTarget =
{
	// since the player won't get credit for the kill
	if (cu_victim.flags & cu_FL_MONSTER && cu_victim.deadflag == cu_DEAD_NO)	// iw -- don't change kill count when removing a dead monster
	{
		cu_addmonster(-1);
	}
	else if (cu_victim.cu_customflags & cu_CFL_SPAWNER)
	{
		if (cu_victim.count > 0)
		{
			cu_addmonster(-1 * cu_victim.count);
		}
	}
	// clean up door triggers so they don't get lonely and crash
	else if (cu_victim.cu_trigger_field != world)
		remove(cu_victim.cu_trigger_field);

	// silence movers
	sound(cu_victim, cu_CHAN_VOICE, "misc/null.wav", 1, 1);
	
	remove (cu_victim);
}

/*
=============
SUB_CallAsSelf

wrap the self/oself shuffle for code cleanliness elsewhere
===============
*/
void(void() cu_fun, entity cu_newself) cu_SUB_CallAsSelf =
{
	local entity cu_oself;
	
	cu_oself = self;
	self = cu_newself;
	cu_fun();
	self = cu_oself;	
}

/*
=============
SUB_ChangeModel

size changes after a model change, use this to preserve it
===============
*/
void(entity cu_ent, string cu_mdl) cu_SUB_ChangeModel =
{
	local vector cu_sz,cu_smin,cu_smax;
	cu_sz = cu_ent.size;
	cu_smin = cu_ent.mins;
	cu_smax = cu_ent.maxs;
	
	setmodel(cu_ent, cu_mdl);
	
	if (cu_sz == cu_VEC_ORIGIN)
		setsize(cu_ent, cu_VEC_ORIGIN, cu_VEC_ORIGIN);
	else
		setsize(cu_ent, cu_smin, cu_smax);
}

