/*
=============================================================================
Doors are similar to buttons, but can spawn a fat trigger field around them
to open without a touch, and they link together to form simultaneous
double/quad doors.
 
Door.owner is the master door.  If there is only one door, it points to itself.
If multiple doors, all will point to a single one.

Door.enemy chains from the master door through all doors linked in the chain.
=============================================================================
*/

float cu_DOOR_START_OPEN = 1;
float cu_DOOR_SPECIAL = 2;
float cu_DOOR_DONT_LINK = 4;
float cu_DOOR_GOLD_KEY = 8;
float cu_DOOR_SILVER_KEY = 16;
float cu_DOOR_TOGGLE = 32;
float cu_DOOR_CRUSHER = 64;

/*
=============================================================================

THINK FUNCTIONS

=============================================================================
*/

void() cu_door_blocked =
{
	VR_CU_ShaftBlocked(other); // QVR: lift shafts kept clear (vr_copper_bridge.qc)
	cu_T_Damage (other, self, self, self.dmg, cu_DMGTYPE_CRUSH);
	
	// if a door has a negative wait, it would never come back if blocked,
	// so let it just squash the object to death real fast
	if (self.wait >= 0 && !(self.spawnflags & cu_DOOR_CRUSHER))
	{
		if (self.state == cu_STATE_DOWN)
			cu_door_go_up ();
		else
			cu_door_go_down ();
	}
}


void() cu_door_hit_top =
{
	sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
	self.state = cu_STATE_TOP;
	cu_SUB_UseTargetsAlt(cu_target2);
	if (self.spawnflags & cu_DOOR_TOGGLE)
		return;		// don't come down automatically
	self.think = cu_door_go_down;
	self.nextthink = self.ltime + self.wait;
	
}

void() cu_door_hit_bottom =
{
	sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
	self.frame = self.skin;
	self.state = cu_STATE_BOTTOM;
	
	cu_SUB_UseTargetsAlt(cu_target4);
}

void() cu_door_go_down =
{
	//dprint("door_go_down\n");
	sound (self, cu_CHAN_VOICE, self.noise2, 1, cu_ATTN_NORM);
	if (self.max_health)
	{
		self.takedamage = cu_DAMAGE_YES;
		self.health = self.max_health;
	}
	
	self.state = cu_STATE_DOWN;
	cu_SUB_CalcMoveLight(self.pos2, self.pos1, self.speed2, cu_door_hit_bottom, cu_TRUE);
	
	cu_SUB_UseTargetsAlt(cu_target3);
}

void() cu_door_go_up =
{
	//dprint("door_go_up\n");
	if (self.state == cu_STATE_UP)
		return;		// already going up

	if (self.state == cu_STATE_TOP)
	{	// reset top wait time
		if (self.spawnflags & cu_DOOR_TOGGLE)
			return;		// don't come down automatically
		self.nextthink = self.ltime + self.wait;
		return;
	}
	
	sound (self, cu_CHAN_VOICE, self.noise2, 1, cu_ATTN_NORM);
	self.state = cu_STATE_UP;
	cu_SUB_CalcMoveLight(self.pos1, self.pos2, self.speed, cu_door_hit_top, cu_FALSE);
	self.frame = !self.skin;

	if (!cu_SUB_UseTargetsAlt(target))
		cu_SUB_UseTargetsSilent();	// door messages are for when they *don't* open
}

/*
=============================================================================

ACTIVATION FUNCTIONS

=============================================================================
*/

void() cu_door_fire =
{
	local entity 	cu_oself;
	local entity	cu_starte;
		
	//dprint("door_fire\n");
	if (self.owner != self)
		objerror ("door_fire: self.owner != self");

	// play use key sound
	if (self.items)
		sound (self, cu_CHAN_BODY, self.noise4, 1, cu_ATTN_NORM);	// was chan_voice, door move sound was cutting it off

	if (!( self.spawnflags & cu_DOOR_TOGGLE ) ) 
	{
		self.message = cu_string_null;		// no more message
	}
	else
	{
		cu_oself = self;
		if (self.state == cu_STATE_TOP || self.state == cu_STATE_UP )
		{
			cu_starte = self;
			do {
				cu_door_go_down ();
				self = self.enemy;
			} while ( (self != cu_starte) && (self != world) );
			self = cu_oself;
			return;
		}
	}

	// trigger all paired doors
	cu_starte = self;
	if ( !( self.spawnflags & cu_DOOR_TOGGLE ) || 
		( self.spawnflags & cu_DOOR_TOGGLE && (self.state == cu_STATE_BOTTOM || (self.state == cu_STATE_DOWN && mapname != "udob4" ) ) ) )
	do {
		cu_door_go_up ();
		self = self.enemy;
	} while ( (self != cu_starte) && (self != world) );
	self = cu_oself;
}


void() cu_door_use =
{
	//dprint("door_use\n");
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	if (!( self.spawnflags & cu_DOOR_TOGGLE ) ) 
	{
		self.message = cu_string_null;			// door message are for touch only
		self.owner.message = cu_string_null;	
		self.enemy.message = cu_string_null;
	}
	self.takedamage = cu_DAMAGE_NO;	// wil be reset upon return
	cu_SUB_CallAsSelf(cu_door_fire,self.owner);
}

void() cu_door_trigger_touch =
{
	if (other.health <= 0) return;
	if (other.movetype == cu_MOVETYPE_NOCLIP) return;
	if (time < self.cu_attack_finished) return;
		
	// silly fix for sleeping monsters standing behind doors inside their touch fields causing them to open
	if (other.flags & cu_FL_MONSTER && other.enemy == world && other.goalentity == world) return;
	
	self.cu_attack_finished = time + 1;
	cu_activator = other;
	self = self.owner;
	cu_door_use ();
}

void() cu_door_killed =
{
	local entity cu_oself;
	
	cu_oself = self;
	self = self.owner;
	self.health = self.max_health;
	cu_door_use ();
	self = cu_oself;
}

void(entity cu_d) cu_door_force =
{
	entity cu_od;
	cu_od = cu_d.owner;
	do {
		cu_od.items = 0;
		cu_od = cu_od.enemy;
	} while (cu_od != cu_d);

	cu_SUB_CallAsSelf(cu_door_fire,cu_d.owner);
}

/*
================
door_touch

Prints messages and opens key doors
================
*/
void() cu_door_touch =
{
	if (!cu_CheckValidTouch()) return;

	self = self.owner;
	if (self.cu_attack_finished > time)
		return;

	self.cu_attack_finished = time + 1;

	if (self.message != cu_string_null && self.state == cu_STATE_BOTTOM && !(self.items))
	{
		centerprint (other, self.message);
		sound (other, cu_CHAN_VOICE, self.noise3, 1, cu_ATTN_NORM);
	}
	
	// from here on is key door stuff
	if (!self.items)
		return;
	// key doors don't spawn trigger fields, so door_touch does a lot of what door_trigger_touch does

	if ( (self.items & other.items) != self.items || self.cu_customflags & cu_CFL_LOCKED )
	{
		centerprint (other, self.owner.message);
		sound (self, cu_CHAN_VOICE, self.noise3, 1, cu_ATTN_NORM);
		return;
	}
	
	if (self.items & cu_IT_KEY1)
	{
		cu_key_take_silver(other);
	}
	else if (self.items & cu_IT_KEY2)
	{
		cu_key_take_gold(other);
	}
	else
	{
		other.items = other.items - self.items;
	}
	
	self.touch = cu_SUB_Null;
	entity cu_t = self.enemy;
	while (cu_t != self)// get paired doors
	{
		cu_t.touch = cu_SUB_Null;
		cu_t = cu_t.enemy;
	}
		
	cu_activator = other;
	
	cu_door_use ();
}

void(float cu_unlock) cu_door_lock =
{
	entity cu_c;
	
	//dprint("door_lock\n");
	if (cu_unlock) cu_door_unlock_do(self);
	else cu_door_lock_do(self);
	// inner loop checks for doors that are linked by touch and not targetname
	cu_c = self.enemy;
	do {
		if (cu_c.targetname != self.targetname)	// outer loop will find this one
			if (cu_unlock) cu_door_unlock_do(cu_c);
			else cu_door_lock_do(cu_c);
		cu_c = cu_c.enemy;
	} while (cu_c != self);
}

void(entity cu_d) cu_door_lock_do =
{
	//dprint("door_lock_do\n");
	entity cu_e;
	if (cu_d.cu_customflags & cu_CFL_LOCKED)
		return;
	cu_d.cu_customflags = cu_d.cu_customflags | cu_CFL_LOCKED;

	// close any open doors immediately
	if (cu_d.state != cu_STATE_BOTTOM && !(cu_d.spawnflags & cu_DOOR_TOGGLE || cu_d.wait == -1))
	{
		cu_e = cu_d;
		do {
			cu_SUB_CallAsSelf(cu_door_go_down,cu_e);
			cu_e = cu_e.enemy;
		}
		while ( cu_e != cu_d && cu_e != world );
	}
	
	if (cu_d.max_health)
	{
		cu_d.takedamage = cu_DAMAGE_NO;
	}
	else
	{
		/*if (d.owner.trigger_field == world && !d.owner.items && !(d.spawnflags & DOOR_TOGGLE))
			objerror("door being locked doesn't have a trigger");
		else*/ if (cu_d.owner.cu_trigger_field)
			cu_d.owner.cu_trigger_field.touch = cu_SUB_Null;
	}
}

void(entity cu_d) cu_door_unlock_do =
{
	//dprint("door_unlock_do\n");
	if (!(cu_d.cu_customflags & cu_CFL_LOCKED))
		return;
		
	cu_d.cu_customflags = cu_not(cu_d.cu_customflags, cu_CFL_LOCKED);
	
	if (cu_d.max_health)
	{
		cu_d.takedamage = cu_DAMAGE_YES;
		cu_d.health = cu_d.max_health;
	}
	else
	{
		/*if (d.owner.trigger_field == world && !d.owner.items && !(d.spawnflags & DOOR_TOGGLE))
			objerror("door being unlocked doesn't have a trigger");
		else*/ if (cu_d.owner.cu_trigger_field)
			cu_d.owner.cu_trigger_field.touch = cu_door_trigger_touch;
	}
}

// checks if a door ONLY has locks targeting it
float(entity cu_d) cu_door_getslocked =
{
	if (cu_d.targetname == cu_string_null)
		return cu_FALSE;
	
	entity cu_t;
	float cu_found = cu_FALSE;
	cu_t = find(world, target, cu_d.targetname);
	while (cu_t) {
		cu_found = cu_TRUE;
		if (cu_t.classname != "target_lock") return cu_FALSE;
		cu_t = find(cu_t, target, cu_d.targetname);
	}
	cu_t = find(world, cu_target2, cu_d.targetname);
	while (cu_t) {
		cu_found = cu_TRUE;
		if (cu_t.classname != "target_lock") return cu_FALSE;
		cu_t = find(cu_t, cu_target2, cu_d.targetname);
	}
	cu_t = find(world, cu_target3, cu_d.targetname);
	while (cu_t) {
		cu_found = cu_TRUE;
		if (cu_t.classname != "target_lock") return cu_FALSE;
		cu_t = find(cu_t, cu_target3, cu_d.targetname);
	}
	cu_t = find(world, cu_target4, cu_d.targetname);
	while (cu_t) {
		cu_found = cu_TRUE;
		if (cu_t.classname != "target_lock") return cu_FALSE;
		cu_t = find(cu_t, cu_target4, cu_d.targetname);
	}
	return cu_found;	// no targeters has to be FALSE
}

/*
=============================================================================

SPAWNING FUNCTIONS

=============================================================================
*/

entity(vector cu_fmins, vector cu_fmaxs) cu_door_spawn_field =
{
	local entity	cu_trigger;
	local	vector	cu_t1, cu_t2;
	//dprint("spawning door field\n");
	cu_trigger = spawn();
	cu_trigger.movetype = cu_MOVETYPE_NONE;
	cu_trigger.solid = cu_SOLID_TRIGGER;
	cu_trigger.owner = self;
	cu_trigger.touch = cu_door_trigger_touch;

	cu_t1 = cu_fmins;
	cu_t2 = cu_fmaxs;
	setsize (cu_trigger, cu_t1 - '60 60 8', cu_t2 + '60 60 8');
	return (cu_trigger);
}

void(vector cu_cmins, vector cu_cmaxs) cu_door_finalize =
{
	entity cu_t;
	// switch positions after linking so START_OPEN doors link properly
	cu_t = self;
	do {
		// DOOR_START_OPEN is to allow an entity to be lighted in the closed position
		// but spawn in the open position
		if (cu_t.spawnflags & cu_DOOR_START_OPEN)
		{
			setorigin (cu_t, cu_t.pos2);
			cu_t.pos2 = cu_t.pos1;
			cu_t.pos1 = cu_t.origin;
		}
		cu_t = cu_t.enemy;
	} while (cu_t != self);
			
	if (self.items)
	{
		cu_door_key_init();
		return;
	}

	if (self.style < 0)
	{
		self.style *= -1;
		self.cu_customflags |= cu_CFL_INVLIGHT;
	}
	if (self.spawnflags & cu_DOOR_START_OPEN)
	{
		if (self.cu_customflags & cu_CFL_INVLIGHT)
			self.cu_customflags -= cu_CFL_INVLIGHT;
		else
			self.cu_customflags |= cu_CFL_INVLIGHT;
	}
	
	cu_bmodel_lightstyle(self, 1);

	if (self.health)
		return;
	if (self.targetname != cu_string_null)
		if (!cu_door_getslocked(self) || self.spawnflags & cu_DOOR_TOGGLE)
			return;
	
	self.cu_trigger_field = cu_door_spawn_field(cu_cmins, cu_cmaxs);
	
	if (self.cu_customflags & cu_CFL_LOCKED)
		cu_door_lock(cu_FALSE);
}

float(entity cu_door, entity cu_master) cu_door_can_link =
{
	if (cu_door == cu_master) return cu_TRUE;	// first door
	if (cu_door.enemy) return cu_FALSE;	// already linked
	if (cu_door.spawnflags & cu_DOOR_DONT_LINK) return cu_FALSE;	// will finalize itself later

	if (cu_door.targetname != cu_string_null && cu_master.targetname != cu_string_null && cu_master.targetname != cu_door.targetname)
		return cu_FALSE;	// part of different systems, might only touch coincidentally
	
	if (cu_door.items && cu_master.items && !(cu_master.items & cu_door.items))
		return cu_FALSE;	// different items requirements
	
	return cu_TRUE;
}

/*
=============
door_link
=============
*/
void() cu_door_link =
{
	entity	cu_t, cu_masterdoor;
	vector	cu_cmins, cu_cmaxs;

	if (self.enemy)
		return;		// already linked by another door
	if (self.spawnflags & cu_DOOR_DONT_LINK)
	{
		self.owner = self.enemy = self;
		cu_door_finalize(self.mins, self.maxs);
		return;		// don't want to link this door
	}

	cu_cmins = self.mins;
	cu_cmaxs = self.maxs;
	
	cu_masterdoor = self;
	cu_t = self;
	
	do
	{
		self.owner = cu_masterdoor;
		
		if (self != cu_masterdoor)
		{
			if ((self.targetname != cu_string_null && cu_masterdoor.targetname == cu_string_null) ||
				self.targetname == cu_masterdoor.targetname)
			{
				// all the doors in the chain having the same targetname will cause
				// the whole chain to be triggered once for every door in the chain
				cu_masterdoor.targetname = self.targetname;
				self.targetname = cu_string_null;
			}
			if (self.items)	// keylocked
			{
				cu_masterdoor.items |= self.items;
				cu_masterdoor.noise3 = self.noise3;
				cu_masterdoor.noise4 = self.noise4;
			}
			if (self.health != 0 && cu_masterdoor.health == 0)
				cu_masterdoor.health = self.health;

			cu_SUB_MergeTargets(cu_masterdoor);
			self.target = cu_string_null;
			self.cu_target2 = cu_string_null;
			self.cu_target3 = cu_string_null;
			self.cu_target4 = cu_string_null;
			self.killtarget = cu_string_null;
			if (self.message != cu_string_null && cu_masterdoor.message == cu_string_null)
				cu_masterdoor.message = self.message;
		}

		// skip doors with other targetnames to not fold them into the loop
		do {
			cu_t = find (cu_t, classname, self.classname);	
		} while (cu_t && (!cu_door_can_link(cu_t,cu_masterdoor) || !cu_EntitiesTouching(self,cu_t)));
		
		if (!cu_t)
		{
			self.enemy = cu_masterdoor;		// make the chain a loop
			self = self.owner;

			cu_door_finalize(cu_cmins, cu_cmaxs);
			
			return;
		}

		self.enemy = cu_t;
		self = cu_t;

		cu_cmins_x = cu_min(cu_t.mins_x, cu_cmins_x);
		cu_cmins_y = cu_min(cu_t.mins_y, cu_cmins_y);
		cu_cmins_z = cu_min(cu_t.mins_z, cu_cmins_z);
		cu_cmaxs_x = cu_max(cu_t.maxs_x, cu_cmaxs_x);
		cu_cmaxs_y = cu_max(cu_t.maxs_y, cu_cmaxs_y);
		cu_cmaxs_z = cu_max(cu_t.maxs_z, cu_cmaxs_z);
	} while (cu_t);
}

void() cu_LinkDoors = {cu_door_link();}

void() cu_door_key_init =
{
	if (self.message == cu_string_null)
	{
		if (self.items & cu_IT_KEY1)
		{
			if (world.worldtype == 2)
				self.message = "You need the Silver Keycard";
			else if (world.worldtype == 1)
				self.message = "You need the Silver Runekey";
			else if (world.worldtype == 0)
				self.message = "You need the Silver Key";
		}
		else if (self.items & cu_IT_KEY2)
		{
			if (world.worldtype == 2)
				self.message = "You need the Gold Keycard";
			else if (world.worldtype == 1)
				self.message = "You need the Gold Runekey";			
			else if (world.worldtype == 0)
				self.message = "You need the Gold Key";
		}
	}
	if (self.items)
	{
		if (self.owner != self)
		{
			self.noise3 = self.owner.noise3;
			self.noise4 = self.owner.noise4;
		}
		entity cu_t = self;
		do {
			cu_t.wait = -1;
			cu_t = cu_t.enemy;
		} while (cu_t != self);
	}
}

// always let specific noise fields on a door override 'sounds' regardless
// of number - maps that use custom door sounds can use 'sounds 5' to skip
// the sound code as a hack, but the sounds menu is longer in copper
void(.string cu_nois, string cu_path) cu_door_set_sound =
{
	if (self.cu_nois == cu_string_null) self.cu_nois = cu_path;
}

void() cu_door_sounds_init =
{
	if (self.items & (cu_IT_KEY1 | cu_IT_KEY2))
	{
		if (world.worldtype == 1)
		{
			cu_door_set_sound(noise3, "doors/runetry.wav");
			cu_door_set_sound(noise4, "doors/runeuse.wav");
		}
		else if (world.worldtype == 2)
		{
			cu_door_set_sound(noise3, "doors/basetry.wav");
			cu_door_set_sound(noise4, "doors/baseuse.wav");
		}
		else
		{
			cu_door_set_sound(noise3, "doors/medtry.wav");
			cu_door_set_sound(noise4, "doors/meduse.wav");
		} 
	}
	else
	{
		if (world.worldtype == 2)
		{
			cu_door_set_sound(noise3, "doors/locked5.wav");
		}
		else
		{
			cu_door_set_sound(noise3, "doors/locked4.wav");
		} 
		cu_door_set_sound(noise4, "misc/null.wav");
	}
	
	if (self.sounds == 0)
	{
		cu_door_set_sound(noise1, "misc/null.wav");
		cu_door_set_sound(noise2, "misc/null.wav");
	}
	else if (self.sounds == 1)
	{
		cu_door_set_sound(noise1, "doors/drclos4.wav");
		cu_door_set_sound(noise2, "doors/doormv1.wav");
	}
	else if (self.sounds == 2)
	{
		cu_door_set_sound(noise1, "doors/hydro2.wav");
		cu_door_set_sound(noise2, "doors/hydro1.wav");
	}
	else if (self.sounds == 3)
	{
		cu_door_set_sound(noise1, "doors/stndr2.wav");
		cu_door_set_sound(noise2, "doors/stndr1.wav");
	}
	else if (self.sounds == 4)
	{
		cu_door_set_sound(noise1, "doors/ddoor2.wav");
		cu_door_set_sound(noise2, "doors/ddoor1.wav");
	}
	else if (self.sounds == 5)
	{
		cu_door_set_sound(noise1, "doors/drclos4.wav");
		cu_door_set_sound(noise2, "doors/winch2.wav");
	}
	else if (self.sounds == 6)
	{
		cu_door_set_sound(noise1, "doors/basesec2.wav");
		cu_door_set_sound(noise2, "doors/basesec1.wav");
	}
	
	cu_precache_sound_safe(self.noise1);
	cu_precache_sound_safe(self.noise2);
	cu_precache_sound_safe(self.noise3);
	cu_precache_sound_safe(self.noise4);
	//precache_sound_safe("doors/locked4.wav");
}

/*cu:QUAKED func_door (0 .5 .8) ? START_OPEN ? DONT_LINK GOLD_KEY SILVER_KEY TOGGLE CRUSHER
Door. Opens; closes. 
If two doors touch, they are assumed to be connected and operate as a unit. Targets, targetnames, and the Crusher and Toggle spawnflags are safely shared between linked doors automatically.
Doors will not link if either has the "dont_link" spawnflag, if they have different targetnames, or different key requirements.

SPAWNFLAGS
"start_open" causes the door to move to its destination when spawned, and operate in reverse. It is used to temporarily or permanently close off an area when triggered (not usefull for touch or takedamage doors).
"dont_link" don't link to any touching doors
"toggle" causes the door to wait in both the start and end states for a trigger event.
"crusher" do not reverse when blocked

Key doors are always wait -1.

"message"	is printed when the door is touched if it is a trigger door and it hasn't been fired yet.  if locked, will print this instead of default silver/gold message.
"angle"		determines the opening direction
"targetname" if set, no touch field will be spawned and a remote button or trigger activates the door, unless the door is only targeted by a target_lock.
"health"	if set, door must be shot open
"speed"		movement speed (100 default)
"speed2"	make close speed different from open speed
"wait"		wait before returning (3 default, -1 = never return)
"lip"		lip remaining at end of move (8 default)
"distance"	specify movement distance directly, overrides lip (-1 to explicitly not move)
"dmg"		damage to inflict when blocked (2 default)
"noise1-4"	override stop/open/locked/unlocked sounds, respectively
"sounds"
0) silent
1) stone
2) base
3) stone chain
4) hissy metal
5) winchy secret door
6) base secret door

Alt Target Pattern: 'target' when starting to open, 'target2' when opened, 'target3' when starting to close, 'target4' when closed.
*/
/*FGD
@SolidClass base(Angle, Appearflags, Targetname, Target, Func, FuncInvis, AltTarget) = func_door : 
"Door. Opens; closes. 
If two doors touch, they are assumed to be connected and operate as a unit. Targets, targetnames, and the Crusher and Toggle spawnflags are safely shared between linked doors automatically.
Doors will not link if either has the 'don't link' spawnflag, if they have different targetnames, or different key requirements.

Alt Target Pattern: 'target' when starting to open, 'target2' when opened, 'target3' when starting to close, 'target4' when closed." 
[
	speed(integer) : "Speed" : 100
	speed2(integer) : "Close Speed (if different from open speed)" : 0
	sounds(choices) : "Sound" : 0 = 
	[
        0: "Silent"
		1: "Stone"
		2: "Machine"
		3: "Stone Chain"
		4: "Screechy Metal"
		5: "Winchy secret door"
		6: "Base secret door"
	]
	noise1(string) : "Override stop sound"
	noise2(string) : "Override move sound"
	noise3(string) : "Override key-required sound"
	noise4(string) : "Override key-unlocked sound"
	wait(string) : "Wait before close" : "3" 
	lip(integer) : "Lip remaining at end of move" : 8
	distance(string) : "Distance to travel (overrides Lip)" : "0.0"
	dmg(integer) : "Damage inflicted when blocked" : 2
	message(string) : "Message printed when the door is touched if it is a trigger door and it hasn't been fired yet. If locked, will print this instead of default silver/gold message."
	health(integer) : "Health (shootable)" : 0
	targetname(target_source) : "Name. If set, no touch field will be spawned and a remote button or trigger must activates the door, UNLESS the door is only targeted by a target_lock."
	spawnflags(flags) =
	[
		1 : "Starts Open" : 0
		4 : "Don't link with touching" : 0
		8 : "Gold Key" : 0
        16 : "Silver Key" : 0
        32 : "Toggle" : 0
        64 : "Crusher" : 0
	]
]
*/
void() cu_func_door =
{
	if (!cu_SUB_ShouldSpawn()) return;
	
	cu_SetMovedir ();

	self.max_health = self.health;
	//self.classname = "door";

	if (!self.speed)
		self.speed = 100;
	if (!self.speed2)
		self.speed2 = self.speed;
	self.dmg = cu_zeroconvertdefault(self.dmg, 2);
	if (!self.lip)
		self.lip = 8;
	if (self.spawnflags & cu_DOOR_SILVER_KEY)
	{
		self.items = cu_IT_KEY1;
		self.wait = -1;
	}
	else if (self.spawnflags & cu_DOOR_GOLD_KEY)
	{
		self.items = cu_IT_KEY2;
		self.wait = -1;
	}
	cu_door_sounds_init();

	//door_key_init();
	
	if (!self.wait)
		self.wait = 3;
	
	if (self.spawnflags & 128)
		self.use = cu_func_door_spawn;
	else
		cu_func_door_spawn();
}

void() cu_func_door_spawn =
{
	self.solid = cu_SOLID_BSP;
	self.movetype = cu_MOVETYPE_PUSH;
	setorigin (self, self.origin);	
	setmodel (self, self.model);

	self.distance = cu_zeroconvertdefault(self.distance, 
		cu_BoundsAngleSize( self.movedir, self.size ) - self.lip);
		// ^^ janky for non-cardinal angles
		
	if (self.pos1 && self.pos2)
	{
		setorigin(self, self.pos1);
	}
	else
	{
		self.pos1 = self.origin;
		self.pos2 = self.pos1 + self.movedir * self.distance;
	}

	self.state = cu_STATE_BOTTOM;

	if (self.health)
	{
		self.takedamage = cu_DAMAGE_YES;
		self.cu_th_die = cu_door_killed;
	}
	
	self.blocked = cu_door_blocked;
	self.use = cu_door_use;
	self.touch = cu_door_touch;
	self.cu_lock = cu_door_lock;

	// door_link can't be done until all of the doors have been spawned, so
	// the sizes can be detected properly.
	if (self.spawnflags & cu_DOOR_DONT_LINK)
	{
		self.owner = self.enemy = self;
		cu_door_finalize(self.mins, self.maxs);
		return;		// don't want to link this door
	}
	self.think = cu_door_link;
	self.nextthink = self.ltime + 0.1;
}

/*
=============================================================================

SECRET DOORS

=============================================================================
*/

void() cu_secretdoor_move1;
void() cu_secretdoor_move2;
void() cu_secretdoor_move3;
void() cu_secretdoor_move4;
void() cu_secretdoor_move5;
void() cu_secretdoor_move6;
void() cu_secretdoor_done;

float cu_SECRET_OPEN_ONCE = 1;		// stays open
float cu_SECRET_1ST_LEFT = 2;		// 1st move is left of angle
float cu_SECRET_1ST_DOWN = 4;		// 1st move is down from angle
float cu_SECRET_NO_SHOOT = 8;		// only opened by trigger
float cu_SECRET_YES_SHOOT = 16;	// shootable even if targeted

void () cu_secretdoor_use =
{
	self.health = self.max_health;

	// enter correct phase of opening if retriggered while moving
	if (self.origin != self.oldorigin)
	{
		cu_secret_door_force(self);
		return;
	}
	
	self.message = cu_string_null;		// no more message

	cu_SUB_UseTargetsSilent();				// fire all targets / killtargets
	
	if (!(self.spawnflags & cu_SECRET_NO_SHOOT))
	{
		// self.th_pain = SUB_Null;
		self.takedamage = cu_DAMAGE_NO;
	}
	self.velocity = '0 0 0';

	cu_secretdoor_move0();
}

// hodor correctly depending on what state the door is in
void(entity cu_door) cu_secret_door_force =
{
	entity cu_oself;
	cu_oself = self;
	self = cu_door;
	if (self.think == cu_secretdoor_move4)	// waiting in open pos, extend timer
	{
		self.nextthink = self.ltime + self.wait;
	}
	else if (self.cu_think1 == cu_secretdoor_move5)	// 2nd reverse move in progress or done
	{
		cu_secretdoor_move2();	// restart 2nd open move
	}
	else if (self.think == cu_secretdoor_move6 || self.origin == self.oldorigin)	// 1st reverse move in progress or done
	{
		cu_secretdoor_move0();	// restart 1st open move
	}
	self = cu_oself;
}

void(entity cu_attacker, float cu_damage) cu_secretdoor_pain =
{
	if (cu_attacker.classname != "player") return;	// no monsters opening secrets for you
	
	cu_secretdoor_use();
}


void() cu_secret_shadowmonitor_go =
{
	float cu_opac, cu_done;
	vector cu_mv, cu_p;
	entity cu_o = self.owner;
	
	self.nextthink = time + cu_min(0.05, (cu_o.nextthink - cu_o.ltime));
	
	if (cu_o.think == cu_secretdoor_move2 || cu_o.think == cu_secretdoor_move6)
	{
		cu_opac = 1;
		cu_done = cu_TRUE;
	}
	else if (cu_o.think == cu_SUB_Null)
	{
		cu_opac = 0;
		if (cu_o.wait == -1)
			cu_done = cu_TRUE;
	}
	else if (cu_o.think == cu_secretdoor_move4)
	{
		cu_opac = 0;
		self.nextthink += cu_o.wait;
	}
	else
	{
		cu_mv = cu_o.cu_dest2 - cu_o.dest1;
		cu_p = cu_o.origin - cu_o.cu_dest2;
		cu_opac = vlen(cu_p) / vlen(cu_mv);
	}

	cu_bmodel_lightstyle(cu_o, cu_opac);

	if (cu_done)
	{
		remove(self);
		return;
	}
	
	self.think = cu_secret_shadowmonitor_go;
}


// Make a sound, wait a little...
void () cu_secretdoor_move0 = 
{
	self.state = cu_STATE_UP;
	if (self.noise1 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
	self.nextthink = self.ltime + 0.1;
	cu_SUB_CalcMove(self.dest1, self.speed, cu_secretdoor_move1);
	if (self.noise2 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise2, 1, cu_ATTN_NORM);
}

// Wait after first movement...
void () cu_secretdoor_move1 = 
{
	self.nextthink = self.ltime + 1.0;
	self.think = cu_secretdoor_move2;
	if (self.noise3 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise3, 1, cu_ATTN_NORM);
}

// Start moving sideways w/sound...
void () cu_secretdoor_move2 =
{
	if (self.noise2 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise2, 1, cu_ATTN_NORM);
	cu_SUB_CalcMoveLight(self.dest1, self.cu_dest2, self.speed2, cu_secretdoor_move3, cu_FALSE);
}

// Wait here until time to go back...
void () cu_secretdoor_move3 =
{
	self.state = cu_STATE_TOP;
	if (self.noise3 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise3, 1, cu_ATTN_NORM);
	if (!(self.spawnflags & cu_SECRET_OPEN_ONCE) || self.wait > 0)
	{
		self.nextthink = self.ltime + self.wait;
		self.think = cu_secretdoor_move4;
		return;
	}
	self.think = cu_SUB_Null;
}

// Move backward...
void () cu_secretdoor_move4 =
{
	self.state = cu_STATE_DOWN;
	if (self.noise2 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise2, 1, cu_ATTN_NORM);
	cu_SUB_CalcMoveLight(self.cu_dest2, self.dest1, self.speed2, cu_secretdoor_move5, cu_TRUE);
}

// Wait 1 second...
void () cu_secretdoor_move5 = 
{
	self.nextthink = self.ltime + 1.0;
	self.think = cu_secretdoor_move6;
	if (self.noise3 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise3, 1, cu_ATTN_NORM);
}

// last move ...
void () cu_secretdoor_move6 =
{
	if (self.noise2 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise2, 1, cu_ATTN_NORM);
	cu_SUB_CalcMove(self.oldorigin, self.speed, cu_secretdoor_done);
}

void () cu_secretdoor_done =
{
	self.state = cu_STATE_BOTTOM;
	self.cu_think1 = cu_SUB_Null;
	if (!self.targetname || self.spawnflags & cu_SECRET_YES_SHOOT)
	{
		self.health = self.max_health;
		self.takedamage = cu_DAMAGE_YES;
		self.cu_th_pain = cu_secretdoor_pain;	
	}
	if (self.noise3 != cu_string_null)
		sound(self, cu_CHAN_VOICE, self.noise3, 1, cu_ATTN_NORM);
}

void () cu_secret_blocked =
{
	if (time < self.cu_attack_finished)
		return;
	self.cu_attack_finished = time + 0.5;
	cu_T_Damage (other, self, self, self.dmg, cu_DMGTYPE_CRUSH);
}

/*
================
secret_touch

Prints messages
================
*/
void() cu_secret_touch =
{
	if (!cu_CheckValidTouch()) return;

	if (self.cu_attack_finished > time)
		return;

	self.cu_attack_finished = time + 2;
	
	if (self.message != cu_string_null)
	{
		centerprint (other, self.message);
		sound (other, cu_CHAN_BODY, self.noise4, 1, cu_ATTN_NORM);
	}
}

void() cu_secret_door_moves =
{
	vector cu_firstmove, cu_secondmove;
	
	if (!self.dest1 && !self.cu_dest2)
	{
		// dumb old way
		makevectors(self.mangle);
		if (self.spawnflags & cu_SECRET_1ST_LEFT)
			cu_firstmove = v_right * -1;
		else if (self.spawnflags & cu_SECRET_1ST_DOWN) 
			cu_firstmove = v_up * -1;
		else
			cu_firstmove = v_right;
		cu_secondmove = v_forward;
	}
	else
	{
		cu_firstmove = normalize(self.dest1);
		cu_secondmove = normalize(self.cu_dest2);
	}
	
	if (!self.cu_t_width)
		self.cu_t_width = cu_BoundsAngleSize(cu_firstmove, self.size);
		
	if (!self.cu_t_length)
		self.cu_t_length = cu_BoundsAngleSize(cu_secondmove, self.size);

	self.dest1 = self.origin + cu_firstmove * self.cu_t_width;
	self.cu_dest2 = self.dest1 + cu_secondmove * self.cu_t_length;
}

void() cu_secret_door_find =
{
	// ok nobody knows what vectors are? what is our children learning
	entity cu_p = find(world, targetname, self.target);

	// now we support literal pathcorners like a literal train
	if (cu_p && cu_p.classname == "path_corner" && cu_p.target != cu_string_null)
	{
		entity cu_p2 = find(world, targetname, cu_p.target);
		if (cu_p2 && cu_p2.classname == "path_corner")
		{
			self.dest1 = cu_p.origin - self.mins;
			self.cu_dest2 = cu_p2.origin - self.mins;
			
			return;
		}
	}

	cu_secret_door_moves();
}

/*cu:QUAKED func_door_secret (0 .5 .8) ? OPEN_ONCE 1ST_LEFT 1ST_DOWN NO_SHOOT ALWAYS_SHOOT
Secret door. Slides back, then to the side. 

There are three ways to configure how this door moves:
1) Set 'Angle'. The secret door will first move to the right of that angle by t_width units, then in the direction of that angle by t_length units. The first move can be altered with the 'move left first' or 'move down first' spawnflags.
2) Set 'dest1' and 'dest2'. These are (x y z) vectors in worldspace corresponding to the first and second move, which will be scaled to the size of t_width and t_length.
3) Target a path_corner which targets a second path_corner. The door will move by its minimum corner like a func_train.

Activating this door with a trigger while it is opening will have no effect. Activating it while it is waiting open will reset its wait time (holding it open). Activating it while it is closing will cause it to reverse direction and open again. This lets you put a trigger_multiple in a secret room behind a func_door_secret to hold it open as long as a player is inside.

Flags:
"open_once" stays open
"1st_left" First move is opposite of v_right, then toward "angle"
"1st_down" First move is down, then toward "angle"
"no_shoot" only opened by trigger
"always_shoot" even if targeted, keep shootable

Keys:
"dmg" damage to inflict when blocked (default: 2). If a secret door has a targetname, it will only be opened by it's button or trigger, not by damage.
"speed" speed of first move, default 50
"speed2" speed of second move, defaults to "speed"
"sounds"
    1 = medieval
    2 = metal
    3 = base
"t_width" override distance for first move
"t_length" override distance for second move
"dest1"+"dest2" if both set, uses dest1 and dest2 for first and second move vectors, ignoring 1st_whatever spawnflags. still needs width and length.
"target" if pointed at a path_corner that targets a second path corner, will use these as the moves instead (relative to min corner, like a func_train) and ignore all of the above.
"wait"  # of seconds before coming back, default 5
*/
/*FGD
@SolidClass base(Appearflags, Targetname, Target, Func) = func_door_secret : 
"Secret door. Slides back, then to the side. 

There are three ways to configure how this door moves:
1) Set 'Angle'. The secret door will first move to the right of that angle by t_width units, then in the direction of that angle by t_length units. t_width and t_length default to the size of the door on those axes if left blank. The first move can be altered with the 'move left first' or 'move down first' spawnflags.
2) Set 'dest1' and 'dest2'. These are (x y z) vectors in worldspace corresponding to the first and second move, which will be scaled to the size of t_width and t_length.
3) Target a path_corner which targets a second path_corner. The door will move by its minimum corner like a func_train.

Activating this door with a trigger while it is opening will have no effect. Activating it while it is waiting open will reset its wait time (holding it open). Activating it while it is closing will cause it to reverse direction and open again. This lets you put a trigger_multiple in a secret room behind a func_door_secret to hold it open as long as a player is inside."
[
	angle(integer) : "Determines direction of SECOND move. FIRST move is to the RIGHT relative to 'angle'."
	t_width(integer) : "First move length"
	t_length(integer) : "Second move length"
	dmg(integer) : "Damage when blocked" : 2
	speed(integer) : "Speed of first move" : 50
	speed2(integer) : "Speed of second move" : 50
	wait(string) : "Wait before closing" : "2"
	dest1(string) : "Force vector for first move (requires dest2)"
	dest2(string) : "Force vector for second move (requires dest1)"
	sounds(choices) : "Sounds" : 3 =
	[
		1: "Medieval"
		2: "Metal"
		3: "Base"
	]
	message(string) : "Message"
	spawnflags(flags) = 
	[
		1 : "Open once" : 0
		2 : "Move left first" : 0
		4 : "Move down first" : 0
		8 : "Not shootable" : 0
        16 : "Always shootable" : 0
	]
]
*/
void () cu_func_door_secret =
{
	if (!cu_SUB_ShouldSpawn()) return;
	self.sounds = cu_zeroconvertdefault(self.sounds, 3);
	
	if (self.sounds == 1)
	{
		self.noise1 = "doors/latch2.wav";
		self.noise2 = "doors/winch2.wav";
		self.noise3 = "doors/drclos4.wav";
	}
	if (self.sounds == 2)
	{
		self.noise1 = "doors/airdoor2.wav";
		self.noise2 = "doors/airdoor1.wav";
		self.noise3 = "doors/airdoor2.wav";
	}
	if (self.sounds == 3)
	{
		self.noise1 = "doors/basesec2.wav";
		self.noise2 = "doors/basesec1.wav";
		self.noise3 = "doors/basesec2.wav";
	}
	if (self.noise3 == cu_string_null)
		self.noise3 = self.noise1;
	
	if (self.noise1 != cu_string_null)
	{
		cu_precache_sound_safe (self.noise1);
		cu_precache_sound_safe (self.noise2);
		cu_precache_sound_safe (self.noise3);
	}

	if (world.worldtype == 2)
	{
		cu_door_set_sound(noise4, "doors/locked5.wav");
	}
	else
	{
		cu_door_set_sound(noise4, "doors/locked4.wav");
	} 
	cu_precache_sound_safe (self.noise4);
	
	self.dmg = cu_zeroconvertdefault(self.dmg, 2);
	
	self.mangle = self.angles;
	self.angles = '0 0 0';
	self.solid = cu_SOLID_BSP;
	self.movetype = cu_MOVETYPE_PUSH;
	//self.classname = "door";
	setmodel (self, self.model);
	setorigin (self, self.origin);	
	
	self.touch = cu_secret_touch;
	self.blocked = cu_secret_blocked;
	
	if (self.speed <= 0) self.speed = 50;
	if (self.speed2 <= 0) self.speed2 = self.speed;
	
	if (self.spawnflags & cu_SECRET_OPEN_ONCE) self.wait = -1;
	if (!self.wait) self.wait = 5;	// 5 seconds before closing
	
	if (self.style < 0)
	{
		self.style *= -1;
		self.cu_customflags |= cu_CFL_INVLIGHT;
	}
	cu_bmodel_lightstyle(self, 1);
	
	self.use = cu_secretdoor_use;
	if ( !self.targetname || self.spawnflags & cu_SECRET_YES_SHOOT)
	{
		if (!self.health)
			self.health = 10;
		self.max_health = self.health;
		self.takedamage = cu_DAMAGE_YES;
		self.cu_th_pain = cu_secretdoor_pain;
		self.cu_th_die = cu_secretdoor_use;
	}
	self.oldorigin = self.origin;
	
	self.skin = self.frame;
	
	if (self.target != cu_string_null)
	{
		self.think = cu_secret_door_find;
		self.nextthink = self.ltime + 0.1;
	}
	else
		cu_secret_door_moves();
}
