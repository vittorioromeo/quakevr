/*
==============================================================================

TELEPORT TRIGGERS

all teleport functionality handled by one function, to allow me to invoke
teleports with a couple different entities that don't replicate each other's
code

==============================================================================
*/

float	cu_TELEPORT_PLAYER_ONLY	= 1;
float	cu_TELEPORT_SILENT			= 2;
float	cu_TELEPORT_PUSH			= 2;
float	cu_TELEPORT_TRIGGER_FIRST	= 4;
float	cu_TELEPORT_NOTRIGGER		= 8;
float	cu_TELEPORT_NOFLASH		= 16;
float	cu_TELEPORT_MONSTER_ONLY	= 32;

// --------------------------------

void() cu_teleport_flash = 
{
	local	float cu_v;
	local	string cu_snd;
	cu_v = random() * 5;
	if (cu_v < 1)
		cu_snd = "misc/r_tele1.wav";
	else if (cu_v < 2)
		cu_snd = "misc/r_tele2.wav";
	else if (cu_v < 3)
		cu_snd = "misc/r_tele3.wav";
	else if (cu_v < 4)
		cu_snd = "misc/r_tele4.wav";
	else
		cu_snd = "misc/r_tele5.wav";

	sound (self, cu_CHAN_VOICE, cu_snd, 1, cu_ATTN_NORM);

	WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
	WriteByte (cu_MSG_BROADCAST, cu_TE_TELEPORT);
	WriteCoord (cu_MSG_BROADCAST, self.origin_x);
	WriteCoord (cu_MSG_BROADCAST, self.origin_y);
	WriteCoord (cu_MSG_BROADCAST, self.origin_z);
}

// player teleports are the only case we don't want to play the tflash right on
// an entity, so teleport_flash still accepts an entity argument and we just make
// a temp entity for it in this single case
// arguably not at all better than changing teleport_flash to accept a vector arg
// but we need an ent to play the sound on anyway
void() cu_teleport_flasher =
{
	cu_teleport_flash();
	remove(self);
}

void(float cu_d) cu_teleport_flash_delay = 
{
	entity cu_flash;
	if (cu_d)
	{
		cu_flash = spawn();
		setorigin(cu_flash, self.origin);
		cu_flash.think = cu_teleport_flasher;
		cu_flash.nextthink = time + cu_d;
		return;
	}
	cu_teleport_flash();
}



/*
================================
TELEPORT LIMBO

not telefragging teammates in coop sometimes cannot be avoided (spawning in
the wrong place, or falling into a func_void two at a time)

instead clients will disappear into 'teleport limbo' if they would telefrag 
a teammate upon arrival, seeing a black screen until the destination is clear

a trigger_push is spawned at the destination to nudge players, but if this 
doesn't work after 1 second of waiting, the teleporting player can press jump
or fire to force a telefrag. after 5 seconds it happens automatically.
================================
*/
void(entity cu_client, entity cu_dst, float cu_tfog, float cu_nofwd) cu_teleport_enter_limbo =
{
	cu_ClearItemEffects(cu_client);	// remove powerups to clear glows/tints
	cu_TintScreen(cu_client, 255);
	
	cu_client.flags |= cu_FL_NOTARGET;
	cu_client.cu_customflags |= cu_CFL_LIMBO;
	cu_client.takedamage = cu_DAMAGE_NO;
	cu_client.solid = cu_SOLID_NOT;
	cu_client.movetype = cu_MOVETYPE_NONE;
	cu_client.goalentity = cu_dst;
	cu_client.dest = cu_Vector(cu_tfog, cu_nofwd, 0);	// z is for the 'force' flag
	cu_client.velocity = cu_VEC_ORIGIN;

	cu_client.model = cu_string_null;
	
	cu_client.cu_attack_finished = time + 1;	// allow forcing a telefrag after 1000ms
	cu_client.cu_search_time = time + 0.1;
	
	cu_spawn_tpush(cu_dst, cu_client);	// gust of wind at the spot to hasten the process
}

void(entity cu_client) cu_teleport_exit_limbo =
{
	cu_TintScreen(cu_client, 0);
	cu_RestoreItemEffects(cu_client);
	
	cu_client.flags = cu_not(cu_client.flags, cu_FL_NOTARGET);
	cu_client.cu_customflags = cu_not(cu_client.cu_customflags, cu_CFL_LIMBO);
	cu_client.takedamage = cu_DAMAGE_AIM;
	cu_client.solid = cu_SOLID_SLIDEBOX;
	cu_client.movetype = cu_MOVETYPE_WALK;
	
	self.cu_attack_finished = time + 0.1;	// don't shoot on the first frame
	cu_client.dest = cu_VEC_ORIGIN;

	if (cu_has_invis(cu_client))
	{
		cu_client.modelindex = cu_modelindex_eyes;
		cu_client.model = "progs/eyes.mdl";
	}
	else
	{
		cu_client.modelindex = cu_modelindex_player;
		cu_client.model = "progs/player.mdl";
	}
}

void() cu_teleport_limbo_think =
{
	// self is the player in limbo
	
	// if it's been a second, check for jump/fire and set force flag
	if (time >= self.cu_attack_finished)
	{
		if (self.button1 || self.button2 || self.button0 ||
			time >= self.cu_attack_finished + 4)	// autoforce after 5 seconds
		{
			self.dest_z = cu_TRUE;
		}		
	}
	
	// keep trying to teleport
	if (time >= self.cu_search_time)
	{
		self.cu_search_time = time + 0.1;
		cu_teleport(self, self.goalentity, self.dest_x, self.dest_y);
	}
}

float(entity cu_spot) cu_teleport_check_for_client =
{
	float cu_cl = 0;
	entity cu_pl = world;
	while (cu_cl < cu_clients)
	{
		cu_pl = find(cu_pl, classname, "player");
		if (!cu_pl) break;
		if (cu_pl.health <= 0 || cu_pl.cu_type == "head") continue;
		if (cu_pl != self)	// players can't block themselves
			if (cu_BoundsTouching(cu_spot.absmin, cu_spot.absmax, cu_pl.absmin, cu_pl.absmax, 2))
				return cu_TRUE;
		
		cu_cl++;
	}
	
	// also check for client owned teledeath here
	cu_pl = world;
	do {
		cu_pl = find(cu_pl, classname, "teledeath");
		if (cu_pl)
			if (cu_pl.owner.classname == "player")
				if (cu_BoundsTouching(cu_spot.absmin, cu_spot.absmax, cu_pl.absmin, cu_pl.absmax, 2))
					return cu_TRUE;				
	} while (cu_pl);
	
	return cu_FALSE;
}




/*
================================
TELEPORT

just call this to teleport something somewhere
================================
*/
void(entity cu_traveler, entity cu_dst, float cu_tfog, float cu_nofwd) cu_teleport =
{
	vector cu_vdir;
	float cu_flash = 3;	// 1 = @org, 2 = @dest, 3 = both
	entity cu_t;

	// telefrag protection in coop
	if (coop && cu_traveler.classname == "player")
	{
		if (cu_teleport_check_for_client(cu_dst))
		{
			if (!(cu_traveler.cu_customflags & cu_CFL_LIMBO))
			{
				cu_teleport_enter_limbo(cu_traveler, cu_dst, cu_tfog, cu_nofwd);
				cu_flash = 1;
			}
			else if (cu_traveler.dest_z != 0)
			{
				cu_teleport_exit_limbo(cu_traveler);
				cu_flash = 2;
			}
			else return;	// stay in limbo
		}
		else if (cu_traveler.cu_customflags & cu_CFL_LIMBO)
		{
			cu_teleport_exit_limbo(cu_traveler);
			cu_flash = 2;
		}
	}
	
	if (cu_dst.classname == "misc_teleporttrain")
	{
		// monsters get pooped out of a teleport train facing their enemy
		if ((cu_traveler.flags & cu_FL_MONSTER) && cu_traveler.enemy)
		{
			cu_vdir = vectoangles(cu_traveler.enemy.origin - cu_dst.origin);
		}
		// if the teleball isn't moving, emerge facing the direction you traveled to help orientation
		else if (cu_dst.cu_buddy && cu_dst.cu_buddy.velocity == cu_VEC_ORIGIN)
		{
			cu_vdir = vectoangles(cu_dst.origin - cu_traveler.origin);
			cu_nofwd = cu_TRUE;
		}
		// if the teleball is moving, face the direction the teleball is moving
		else 
		{
			cu_vdir = vectoangles(cu_dst.velocity);
		}
		cu_vdir_x = 0;	// null pitch
	}
	else
		cu_vdir = cu_dst.mangle;

	if (cu_tfog)
	{
		if (cu_flash & 1)
			cu_SUB_CallAsSelf(cu_teleport_flash, cu_traveler);	// flash at departure point
		
		if (cu_flash & 2)
		{
			cu_t = spawn();
			
			// teleport controller's origin is desired teleport flash location on arrival
			if (cu_traveler.classname == "player")
			{
				makevectors (cu_vdir);
				setorigin(cu_t, cu_dst.origin + v_forward * 16);
			}	
			else
			{
				setorigin(cu_t, cu_dst.origin);
			}
		
			cu_t.think = cu_teleport_flasher;
			cu_t.nextthink = time + 0.05;
		}
	}

	if (cu_traveler.cu_customflags & cu_CFL_LIMBO)
		return;
	
	cu_spawn_tdeath(cu_dst.origin, cu_traveler);

	setorigin(cu_traveler, cu_dst.origin);
	cu_traveler.angles = cu_vdir;
	if (cu_traveler.flags & cu_FL_MONSTER)
	{
		cu_traveler.ideal_yaw = cu_traveler.angles_y;
	}

	if (cu_traveler.classname == "player")
	{
		cu_fog_setFromEnt(cu_traveler, cu_dst);
		cu_traveler.fixangle = 1;		// turn this way immediately
		makevectors (cu_vdir);
		if (cu_dst.classname == "info_teleport_destination" ||
			cu_dst.classname == "info_teleport_target" ||
			cu_dst.classname == "misc_teleporttrain" ||
			cu_dst.classname == "info_notnull")
		{
			cu_t = self;
			self = cu_dst;
			cu_activator = cu_traveler;
			cu_SUB_UseTargets();
			self = cu_t;
		}
		if (cu_nofwd)
		{
			cu_traveler.velocity = cu_VEC_ORIGIN;
		}
		else
		{
			cu_traveler.teleport_time = time + 0.7;
			cu_traveler.velocity = v_forward * 300;
		}
	}
	else
	{
		cu_traveler.velocity = cu_VEC_ORIGIN;
	}
		
	cu_traveler.flags = cu_not(cu_traveler.flags, cu_FL_ONGROUND);
}

// --------------------------------
// tpush
//
// shove coop players off a teledest as a more neighborly alternative to telefragging them
// --------------------------------
void() cu_tpush_touch =
{
	if (!cu_CheckValidTouch()) return; // don't telepush monsters
	
	if (other == self.owner)
	{
		// our owner has arrived by teleport, tpush no longer needed
		cu_SUB_RemoveSoon();
		return;
	}
	
	// push all clients in coop
	if (time != self.cu_dmgtime)
		if (time < self.cu_attack_finished)
			return;

	other.velocity = self.mangle;
	
	self.cu_dmgtime = time;
	self.cu_attack_finished = time + 0.1;
}

void(entity cu_spot, entity cu_pusher) cu_spawn_tpush =
{
	entity cu_p;
	vector cu_dir;

	cu_p = spawn();
	cu_p.classname = "telepush";
	cu_p.movetype = cu_MOVETYPE_NONE;
	cu_p.solid = cu_SOLID_TRIGGER;
	setsize (cu_p, cu_pusher.mins - '1 1 1', cu_pusher.maxs + '1 1 1');
	setorigin (cu_p, cu_spot.origin);
	if (cu_spot.mangle != cu_VEC_ORIGIN)
		cu_dir = cu_spot.mangle;
	else
		cu_dir = cu_spot.angles;
	makevectors(cu_dir);
	cu_p.mangle = v_forward * 300 + '0 0 50';
	cu_p.touch = cu_tpush_touch;
	cu_p.nextthink = time + 1;
	cu_p.think = cu_SUB_Remove;
	cu_p.owner = cu_pusher;
	
	force_retouch = 2;		// make sure even still objects get hit
}

// --------------------------------
// tdeath
// --------------------------------
void() cu_tdeath_touch =
{
	if (other == self.owner)
		return;

	// original owner of this teledeath has cleared its bounds, and there's 
	// no more danger of overlapping bboxes, so remove it
	if (!cu_BoundsTouching(self.absmin, self.absmax, self.owner.absmin, self.owner.absmax, 2))
	{
		cu_SUB_RemoveSoon();
		return;
	}
	
// frag anyone who teleports in on top of an invincible player
	if (other.classname == "player")
	{
		if (cu_has_invuln(other))
			self.classname = "teledeath2";
		if (self.owner.classname != "player")
		{	// other monsters explode themselves
			cu_T_Damage (self.owner, self, self, 50000, cu_DMGTYPE_TELEFRAG);
			remove(self);	// our purpose is served
			return;
		}
	}

	if (other.health)
		cu_T_Damage (other, self, self, 50000, cu_DMGTYPE_TELEFRAG);
}

entity(vector cu_org, entity cu_death_owner) cu_spawn_tdeath =
{
	entity cu_death;

	cu_death = spawn();
	cu_death.classname = "teledeath";
	cu_death.movetype = cu_MOVETYPE_NONE;
	cu_death.solid = cu_SOLID_TRIGGER;
	setsize (cu_death, cu_death_owner.mins - '0.1 0.1 0.1', cu_death_owner.maxs + '0.1 0.1 0.1');
	setorigin (cu_death, cu_org);
	cu_death.angles = '0 0 0';
	cu_death.touch = cu_tdeath_touch;
	cu_death.nextthink = time + 0.2;
	cu_death.think = cu_SUB_Remove;
	cu_death.owner = cu_death_owner;
	
	force_retouch = 2;		// make sure even still objects get hit
	
	return cu_death;
}

// --------------------------------

void() cu_teleport_touch =
{
	local entity	cu_t;
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	if (other.health <= 0 || other.solid != cu_SOLID_SLIDEBOX) return;	// only teleport living creatures
	if (other.movetype == cu_MOVETYPE_NOCLIP) return;
	if ((self.spawnflags & cu_TELEPORT_PLAYER_ONLY) && (other.classname != "player")) return;
	if ((self.spawnflags & cu_TELEPORT_MONSTER_ONLY) && !(other.flags & cu_FL_MONSTER)) return;

	if ((self.spawnflags & cu_TELEPORT_NOTRIGGER) == 0)
		if (self.targetname != cu_string_null)
			if ((self.spawnflags & cu_TELEPORT_TRIGGER_FIRST) == 0) // not trigger first
				if (self.nextthink < time)
	{
		//dprint3("  teleport with targetname ", self.targetname, " not activated yet, not teleporting\n");
		return;
	}

	cu_t = cu_findunlockedtarget(self, world);//find (world, targetname, self.target);
	if (!cu_t)
	{
		objerror ("teleporter couldn't find target");
		return;
	}

	cu_playercount_convert(count);
	if (!self.count) 
	{
		cu_SUB_RemoveSoon();
		return;
	}
	else if (self.count > 0)
		self.count -= 1;
	
	cu_teleport( other, cu_t, ((self.spawnflags & cu_TELEPORT_NOFLASH) == 0), 0 );
	
	if (cu_t.classname == "misc_teleporttrain")
		return;
	cu_activator = other;
	cu_SUB_UseTargets();
}

