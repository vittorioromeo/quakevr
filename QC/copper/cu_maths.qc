float cu_mathlib_accuracy; //accuracy of sqrt & pow

// frikqcc doesn't like it when i swizzle directly
// TODO: see if fteqcc cares
vector(float x, float y, float z) cu_Vector =
{
	local vector cu_swiz;
	cu_swiz_x = x;
	cu_swiz_y = y;
	cu_swiz_z = z;
	return cu_swiz;
}

float (vector cu_a, vector cu_b) cu_vdist =
{
	return vlen(cu_b-cu_a);
}
float (vector cu_a, vector cu_b) cu_hdist =
{
	vector cu_c = cu_b - cu_a;
	cu_c_z = 0;
	return vlen(cu_c);
}

float (vector cu_v) cu_vlensqr =
{
	return cu_v_x * cu_v_x + cu_v_y * cu_v_y + cu_v_z * cu_v_z;
}

vector(float cu_num) cu_SinCos =
{
	local vector cu_angle, cu_vf, cu_vu, cu_vr, cu_result;
	
	cu_vf = v_forward;
	cu_vu = v_up;
	cu_vr = v_right;
	
	cu_angle = '0 1 0' * cu_num;
	makevectors(cu_angle);
	cu_result = cu_Vector(v_forward_y, v_forward_x, 0);
	
	v_forward = cu_vf;
	v_up = cu_vu;
	v_right = cu_vr;
	
	return cu_result;
}

float(float cu_num) cu_sin =
{
	vector cu_temp;
	cu_temp = cu_SinCos(cu_num);
	return cu_temp_x;
}

float(float cu_num) cu_cos =
{
	vector cu_temp;
	cu_temp = cu_SinCos(cu_num);
	return cu_temp_y;
}

float(float cu_num) cu_tan =
{
	vector cu_temp;
	cu_temp = cu_SinCos(cu_num);
	if (cu_temp_y == 0) return cu_A_SHITLOAD;	// to infinity and beyond
	return cu_temp_x / cu_temp_y;
}
 
float(float y, float x) cu_atan2 =
{
	local vector cu_ang; //temporary used to calculate trig values
	cu_ang = '0 0 0';
	cu_ang_x = x;
	cu_ang_y = y;
	return vectoyaw(cu_ang);
}

vector(vector cu_a, vector cu_b) cu_CrossProduct =
{
	vector cu_c;
	
	cu_c_x = cu_a_y * cu_b_z - cu_a_z * cu_b_y;
	cu_c_y = cu_a_z * cu_b_x - cu_a_x * cu_b_z;
	cu_c_z = cu_a_x * cu_b_y - cu_a_y * cu_b_x;
	
	return cu_c;
}

float(vector cu_a, vector cu_b) cu_DotProduct =
{
//	return (a_x * b_x) + (a_y * b_y) + (a_z * b_z);
	return cu_a * cu_b;	// you idiot
}

float(float cu_a, float cu_b, float cu_mix) cu_lerp =
{
	if (cu_mix <= 0) return cu_a;
	if (cu_mix >= 1) return cu_b;
	return (cu_b * cu_mix + cu_a * ( 1 - cu_mix ) );
}

vector(vector cu_a, vector cu_b, float cu_mix) cu_lerpVector =
{
	if (cu_mix <= 0) return cu_a;
	if (cu_mix >= 1) return cu_b;
	return (cu_b * cu_mix + cu_a * ( 1 - cu_mix ) );
}

// for a relaxing lerp: hermite lerp.
float(float cu_a, float cu_b, float cu_mix) cu_lerpHermite =
{
	if (cu_mix <= 0) return cu_a;
	if (cu_mix >= 1) return cu_b;
	
	local float cu_h01;
	
	cu_h01 = cu_mix * cu_mix;
	cu_h01 *= 3 - 2 * cu_mix;
	
	return (cu_b * cu_h01 + cu_a * ( 1 - cu_h01 ) );
}

vector(vector cu_a, vector cu_b, float cu_mix) cu_lerpVectorHermite =
{
	if (cu_mix <= 0) return cu_a;
	if (cu_mix >= 1) return cu_b;

	local float cu_h01;
	
	cu_h01 = cu_mix * cu_mix;
	cu_h01 *= 3 - 2 * cu_mix;
	
	return (cu_b * cu_h01 + cu_a * ( 1 - cu_h01 ) );
}

// even more smooth:
float(float cu_a, float cu_b, float cu_mix) cu_lerpCosine =
{
	if (cu_mix <= 0) return cu_a;
	if (cu_mix >= 1) return cu_b;
	
	local float cu_cmx;
	cu_cmx = (1 - cu_cos(cu_mix * 180)) / 2;
	
	return (cu_b * cu_cmx + cu_a * ( 1 - cu_cmx ) );
}

vector(vector cu_a, vector cu_b, float cu_mix) cu_lerpVectorCosine =
{
	if (cu_mix <= 0) return cu_a;
	if (cu_mix >= 1) return cu_b;

	local float cu_cmx;
	cu_cmx = (1 - cu_cos(cu_mix * 180)) / 2;
	
	return (cu_b * cu_cmx + cu_a * ( 1 - cu_cmx ) );
}

// bez is short for Bilinear EnterpolationZ
vector(vector cu_start, vector cu_ctrl, vector cu_end, float cu_t) cu_bez =
{
	vector cu_b1 = cu_t * cu_ctrl + (1-cu_t) * cu_start;
	vector cu_b2 = cu_t * cu_end + (1-cu_t) * cu_ctrl;
	return cu_t * cu_b2 + (1-cu_t) * cu_b1;
}

// quick bezier length approximation (2/3 chord len + 1/3 perimeter)
float(vector cu_start, vector cu_ctrl, vector cu_end) cu_bez_lenApprox =
{
	float cu_chord, cu_peri;
	
	cu_chord = vlen(cu_start - cu_end);
	cu_peri = vlen(cu_start - cu_ctrl) + vlen(cu_ctrl - cu_end);
	
	return (2 * cu_chord + cu_peri) / 3;
}

// rotates B around A
vector(vector cu_b, vector cu_a, float cu_r) cu_rotateVectorAround =
{
	float cu_sin, cu_cos, cu_dot;
	vector cu_cross, cu_temp;
	
	cu_cross = cu_CrossProduct(cu_a, cu_b);
	cu_dot = cu_a*cu_b;
	
	cu_temp = cu_SinCos(cu_r);
	cu_sin = cu_temp_x;
	cu_cos = cu_temp_y;
	
	return cu_b*cu_cos + cu_cross*cu_sin + cu_a*cu_dot*(1-cu_cos);
}

float() cu_crandom =
{
	return 2*(random() - 0.5);
}

vector(vector cu_v) cu_vabs =
{
	return cu_Vector(fabs(cu_v_x),fabs(cu_v_y),fabs(cu_v_z));
}

vector(vector cu_a, vector cu_b) cu_vec_scale =
{
	return cu_Vector(cu_a_x * cu_b_x, cu_a_y * cu_b_y, cu_a_z * cu_b_z);
}

float(vector cu_ang) cu_is_angular =
{
	return (fabs(cu_ang_x) > 1 || fabs(cu_ang_y) > 1 || fabs(cu_ang_z) > 1);
}

float(float cu_a, float cu_b) cu_min = { if (cu_a <= cu_b) return cu_a; return cu_b; }
float(float cu_a, float cu_b) cu_max = { if (cu_a >= cu_b) return cu_a; return cu_b; }
float(float cu_a, float cu_mn, float cu_mx) cu_clamp = { if (cu_a >= cu_mx) return cu_mx; if (cu_a <= cu_mn) return cu_mn; return cu_a; }
float(float cu_a) cu_saturate = { return cu_clamp(cu_a, 0, 1); }

float(float cu_a, float cu_b) cu_xor = { return (cu_a | cu_b) - (cu_a & cu_b); }
float(float cu_a, float cu_b) cu_not = { return cu_a - (cu_a & cu_b); }

float(float cu_a, float cu_limit) cu_cycle =
{
	cu_a += 1;
	if (cu_a >= cu_limit) return 0;
	return cu_a;
}

// ================================
//	Z-Aware Projectile Maths
// ================================
float cu_BAD_THETA = -666;

float(vector dest, float speed, float cu_th) cu_BallisticTheta =
{
	float cu_a, cu_b, cu_c, y, z;
	float cu_theta, cu_tan_theta, cu_oldtheta;

	cu_theta = cu_th;
	
	//calculate how far we are firing
	z = dest_z;
	dest_z = 0;
	y = vlen(dest);

	//find the coefficients of the quadratic in tan(theta)
	cu_a = 0.5 * world.gravity * y * y / (speed * speed);
	cu_b = -y;
	cu_c = cu_a + z;
	
	if(cu_b*cu_b >= 4*cu_a*cu_c)	//check if the destination is too far to reach
	{
		y = 0;
		// newton raphson to within 1 degree, no more than 4x
		while (fabs(cu_oldtheta - cu_theta) > 1 && y < 4)
		{
			cu_oldtheta = cu_theta;
			cu_tan_theta = cu_tan(cu_theta);
			cu_theta = cu_atan2(cu_a*cu_tan_theta*cu_tan_theta - cu_c, 2*cu_a*cu_tan_theta + cu_b);
			y += 1;
		}

		//constrain the values to stop anything too mad happening
		while(cu_theta > 90)
			cu_theta = cu_theta - 180;
	}
	else
		cu_theta = cu_BAD_THETA;
	
	return cu_theta;
}


// ================================


float(float cu_base, float cu_exp) cu_ipow =
{
	float x, cu_out;
	
	x = cu_exp - 1;
	cu_out = cu_base;
	
	while (x)
	{
		cu_out *= cu_base;
		x -= 1;
	}
	return cu_out;
}




// the following are by any one of the following people:
// frikac, preach, kashua, lordhavoc, sock

float(float cu_a, float cu_b) cu_mod =
{
	return cu_a - (floor(cu_a / cu_b) * cu_b);
}

//faster version of id's anglemod
float(float cu_v) cu_anglemod =
{
	return cu_v - floor(cu_v/360) * 360;
}

float(float cu_anga, float cu_angb) cu_angledif =
{
	float cu_dif;
	cu_dif	= fabs(cu_anga - cu_angb);
	if (cu_dif > 180)
		cu_dif = 360 - cu_dif;
	return cu_dif;
}

// mathlib_sqrt
float(float cu_num) cu_sqrt =
{
	local float cu_apr;

	if(cu_mathlib_accuracy <= 0)
		cu_mathlib_accuracy = 0.001;   //this sets a level of accuracy, it's a global float

	if (cu_num < cu_mathlib_accuracy)
		return 0;
	if (cu_num>1)
		cu_apr = cu_num;
	else
		cu_apr = 1;
	do
	{
		cu_apr = (cu_num + (cu_apr * cu_apr)) / (2 * cu_apr);
	}
	while (fabs((cu_apr * cu_apr) - cu_num) > (cu_num * cu_mathlib_accuracy));
	return cu_apr;
}

// reflect incident over normal, dampening it against the normal
vector(vector cu_incident, vector cu_normal, float cu_dampening) cu_reflect = {
	// project incident along normal
	float cu_d = cu_incident * cu_normal;
	vector cu_p = cu_d * cu_normal;

	vector cu_i2p = cu_p - cu_incident;
	vector cu_reflected = cu_incident + 2 * cu_i2p;

	return cu_reflected - cu_d * cu_dampening * cu_normal;
};

