void(entity cu_attacker, float cu_damage)	cu_knight_pain =
{
	local float cu_r;

	if (self.cu_pain_finished > time)
		return;
		
	sound (self, cu_CHAN_VOICE, "knight/khurt.wav", 1, cu_ATTN_NORM);
	cu_r = random();
	if (cu_r < 0.85)
		cu_knight_pain1 ();
	else
		cu_knight_painb1 ();

	cu_PainFinished(1);
}

