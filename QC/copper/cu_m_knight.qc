// moved from fight.qc
void() cu_knight_attack =
{
	local float		cu_len;
	
	// decide if now is a good swing time
	cu_len = vlen(self.enemy.origin+self.enemy.view_ofs - (self.origin+self.view_ofs));
	
	if (cu_len < 80 || ( cu_has_invis(self.enemy) && random() > 0.5 ))
		cu_knight_atk1 ();
	else
		cu_knight_runatk1 ();
}



