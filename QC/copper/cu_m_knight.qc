void() cu_knight_die =
{
	// check for gib
	if (self.health < -40)
	{
		cu_Gib ("progs/h_knight.mdl", self.health);
		return;
	}
	
	// regular death
	sound (self, cu_CHAN_VOICE, "knight/kdeath.wav", 1, cu_ATTN_NORM);
	if (random() < 0.5)
		cu_knight_die1 ();
	else
		cu_knight_dieb1 ();
}

//===========================================================================

void() cu_monster_knight_spawn =
{
	self.classname = "monster_knight";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/knight.mdl");

	setsize (self, '-16 -16 -24', '16 16 40');
	self.health = 72;
	
	self.cu_customflags |= cu_CFL_MELEEONLY;
	//if (self.lip == 555) self.skin = 4;

	self.cu_th_stand = cu_knight_stand1;
	self.cu_th_walk = cu_knight_walk1;
	self.cu_th_run = cu_knight_run1;
	self.cu_th_melee = cu_knight_attack;
	self.cu_th_pain = cu_knight_pain;
	self.cu_th_die = cu_knight_die;
	self.cu_th_checkattack = cu_CheckAttack;

	if (self.deathtype == cu_string_null)
		self.deathtype = "was slashed by a Knight";

	cu_nmspeed(0.075);

	cu_walkmonster_start ();
}

void() cu_monster_knight_spawner = {cu_mon_spawner_use(cu_monster_knight_spawn);}

/*cu:QUAKED monster_knight (1 0 0) (-16 -16 -24) (16 16 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Knight, 72 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry
"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-16 -16 -24, 16 16 40) model({ "path": ":progs/knight.mdl" }) = monster_knight : "Knight" []
*/
void() cu_monster_knight =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model ("progs/knight.mdl");
	precache_model ("progs/h_knight.mdl");
	precache_sound ("knight/kdeath.wav");
	precache_sound ("knight/khurt.wav");
	precache_sound ("knight/ksight.wav");
	precache_sound ("knight/sword1.wav");
	precache_sound ("knight/sword2.wav");
	precache_sound ("knight/idle.wav");

	self.health = 72;
	setsize (self, '-16 -16 -24', '16 16 40');

	if ( cu_monster_spawnsetup( cu_monster_knight_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_knight_spawn();
}
