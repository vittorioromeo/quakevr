void(float cu_side) cu_ShamClaw =
{
	float 	cu_ldmg;

	if (!self.enemy)
		return;

	if (cu_vdist(self.enemy.origin, self.origin) > 100)
		return;
		
	cu_ldmg = (random() + random() + random()) * 20;
	cu_T_Damage(self.enemy, self, self, cu_ldmg, cu_DMGTYPE_MELEE);
	sound (self, cu_CHAN_VOICE, "shambler/smack.wav", 1, cu_ATTN_NORM);

	if (cu_side)
	{
		makevectors (self.angles);
		cu_SpawnMeatSpray (self.origin + v_forward*16, cu_side * v_right);
	}
}

