void() cu_sham_melee =
{
	if (self.enemy.cu_type == "zombie")
	{
		cu_sham_smash1();	// just fuck up a zombie and get on with life
		return;
	}

	float cu_chance;
	cu_chance = random();
	
	// gradually building chance that the shambler will lightning instead of 
	// continuing to melee, so that attempting a shambler dance is an
	// increasingly dangerous gamble and not a solidly predictable exploit
	if (cu_chance < floor(self.lip) / 6.66)	// step up by 15% every other melee
	{
		cu_sham_magic1();
		return;
	}
	
	if (self.health > 575)
	{
		if (cu_chance > 0.2)
			cu_sham_smash1 ();
		else if (cu_chance > 0.1)
			cu_sham_swingr1 ();
		else
			cu_sham_swingl1 ();
	}
	else
	{
		if (cu_chance > 0.6)
			cu_sham_smash1 ();
		else if (cu_chance > 0.3)
			cu_sham_swingr1 ();
		else
			cu_sham_swingl1 ();
	}
	self.lip += 0.5;
}


//============================================================================


void() cu_CastLightning =
{
	vector	cu_org, cu_dir;
	
	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	cu_org = self.origin + '0 0 40';
	makevectors(self.angles);
	
	// shamblers look weird when their lightning jumps around seeking the player
	if (cu_has_invis(self.enemy) && (time > self.cu_dmgtime + 1))
	{
		cu_dir = v_forward;
	}
	else
	{
		cu_ai_face();
		cu_dir = cu_enemy_vispos() + '0 0 16' - cu_org;
		cu_dir = normalize (cu_dir);
		
		if (cu_angledif(self.ideal_yaw, self.angles_y) > 80)	// no ass lightning
		{
			cu_dir_x = v_forward_x;
			cu_dir_y = v_forward_y;
			cu_dir = normalize(cu_dir);
		}
	}

	cu_traceline2(cu_org, self.origin + cu_dir * cu_SHAM_LIGHTNING_RANGE, self, cu_TRACE_NOMONSTERS);

	cu_ClearMultiDamage();
	cu_LightningBeam (cu_org, trace_endpos, self, 10);
	cu_ApplyMultiDamage();
}

void() cu_sham_spawn_effect =
{
	entity cu_o;
	self.cu_buddy = spawn();
	cu_o = self.cu_buddy;
	setmodel (cu_o, "progs/s_light.mdl");
	setorigin (cu_o, self.origin);
	cu_o.angles = self.angles;
	cu_o.nextthink = time + 0.7;
	cu_o.think = cu_SUB_Remove;
	
}

