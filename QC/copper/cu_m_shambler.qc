// i get no kick from this function
void(entity cu_attacker, float cu_damage)	cu_sham_pain =
{
	if (self.health <= 0) return;	
	if (self.cu_pain_finished > time) return;
	if (random()*400 > cu_damage) return;		// didn't flinch
	
	sound (self, cu_CHAN_VOICE, "shambler/shurt2.wav", 1, cu_ATTN_NORM);
	cu_PainFinished(2);
	cu_sham_pain1 ();
}


//============================================================================

/*
===========
ShamCheckAttack

The player is in view, so decide to move or launch an attack
Returns FALSE if movement should continue
============
*/
float() cu_ShamCheckAttack =
{
	if (cu_enemy_range == cu_RANGE_MELEE && cu_CheckClearAttack() && cu_z_overlap(self.enemy))
	{
		if (cu_vdist(self.origin, self.enemy.origin) > 95)
		{
			// we'll have to step forward to hit, don't try if there's no room to close in
			// (fix for shambler-meleeing-in-place-harmlessly-forever behavior)
			if (cu_ai_charge(1))
			{
				self.cu_attack_state = cu_AS_MELEE;
				return cu_TRUE;
			}
		}
		else
		{
			self.cu_attack_state = cu_AS_MELEE;
			return cu_TRUE;
		}
	}

	if (time < self.cu_attack_finished)
		return cu_FALSE;
	
	if (!cu_enemy_vis)
		return cu_FALSE;
	
	// randomly melee if enemy has the ring of shadows
	if (cu_has_invis(self.enemy))
	{
		if (random() < 0.1)
		{
			self.cu_attack_state = cu_AS_MELEE;
			return cu_TRUE;
		}
	}

	if (!cu_CheckClearAttack()) return cu_FALSE;
	
	// missile attack
	//if (enemy_range >= RANGE_FAR)
	if (vlen(self.origin - cu_enemy_vispos()) > cu_SHAM_LIGHTNING_RANGE)
		return cu_FALSE;
		
	self.cu_attack_state = cu_AS_MISSILE;
	// attack_finished can't go here, because the attack may still not 
	// be successful and we shouldn't reset the next attack timer until it is
	//ai_attack_finished (2 + 2*random());
	return cu_TRUE;
}

