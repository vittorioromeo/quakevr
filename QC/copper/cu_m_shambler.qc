	sound (self, cu_CHAN_WEAPON, "shambler/sattck1.wav", 1, cu_ATTN_NORM);
	self.lip = 0;
}
void() cu_sham_magic2     =[      $magic2,       cu_sham_magic3    ] {cu_ai_face();}
void() cu_sham_magic2nm     =[      $magic2,       cu_sham_magic3    ]
{
	if (cu_range(self.enemy) == cu_RANGE_MELEE)
	{
		cu_sham_melee();
		return;
	}
	sound (self, cu_CHAN_WEAPON, "shambler/sattck1.wav", 1, cu_ATTN_NORM);
	cu_ai_face();
}
void() cu_sham_magic3     =[      $magic3,       cu_sham_magic4    ] {cu_ai_face();
	self.nextthink = self.nextthink + 0.2;
	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	cu_ai_face();
	cu_sham_spawn_effect();
}
void() cu_sham_magic4     =[      $magic4,       cu_sham_magic5    ]
{
	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	self.cu_buddy.frame = 1;
}
void() cu_sham_magic5     =[      $magic5,       cu_sham_magic6    ]
{
	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	self.cu_buddy.frame = 2;
}
void() cu_sham_magic6     =[      $magic6,       cu_sham_magic9    ]
{
	remove (self.cu_buddy);
	sound (self, cu_CHAN_WEAPON, "shambler/sboom.wav", 1, cu_ATTN_NORM);
	cu_CastLightning();
}
void() cu_sham_magic9     =[      $magic9,       cu_sham_magic10   ]{ cu_CastLightning();}
void() cu_sham_magic10    =[      $magic10,      cu_sham_magic11n   ]{ cu_CastLightning();
	if (vlen(self.origin - cu_enemy_vispos()) < cu_SHAM_LIGHTNING_RANGE)
		cu_ai_check_refire(cu_sham_magic2nm);
	cu_ai_attack_finished (1 + 2*random());
}
void() cu_sham_magic11n    =[      $magic11,      cu_sham_magic12   ] {}
void() cu_sham_magic12    =[      $magic12,      cu_sham_run1	   ] {}

// shambler refire replaces 4-tick nightmare lightning, but we save this function 
// with the name preserved because it's been used in past maps as a secret hack way 
// to fire nightmare-only triggers
void() cu_sham_magic11    =[      $magic11,      cu_sham_magic12   ]{ if (cu_skill >= 3) cu_CastLightning(); }


