/*
===============

BULLETS

sg:		6 * 4 = 24		/ 48 / 72 / 96 / 120
ssg:	14 * 4 = 56		/ 112 / 168 / 224 / 280

sg:		5 * 5 = 25		/ 50 / 75 / 100 / 125
ssg:	11 * 5 = 55		/ 110 / 165 / 220 / 275
ssg:	12 * 5 = 60		/ 120 / 180 / 240 / 300

===============
*/

vector(vector cu_dir, vector cu_spread) cu_SpreadVector = 
{
	return cu_dir + cu_crandom()*cu_spread_x*v_right + cu_crandom()*cu_spread_y*v_up;
}

/*
================
BulletImpact
Go to the trouble of combining multiple pellets into a single damage call.
================
*/
vector(float cu_damage, vector cu_dir) cu_BulletImpact =
{
	vector cu_vel, cu_org;
	
	cu_vel = normalize(cu_dir + v_up*cu_crandom() + v_right*cu_crandom());
	cu_vel = cu_vel + 2*trace_plane_normal;

	cu_org = trace_endpos - cu_dir*4;

	if (trace_ent.takedamage)
	{
		cu_SpawnBlood (cu_org, cu_vel*40, cu_damage);
		cu_AddMultiDamage (trace_ent, cu_damage);
	}
	else cu_gunshot(cu_org);

	return cu_org;
}

float(entity cu_t) cu_HasBeenShotToDeath =
{
	if (cu_t.cu_multi_dmg < cu_t.health) return cu_FALSE;
	if (cu_DamageCanKill(cu_t,cu_t.cu_multi_dmg)) return cu_TRUE;
	return cu_FALSE;
}

/*
================
FireBullets

Used by shotgun, super shotgun, and enemy soldier firing
================
*/
void(float cu_shotcount, vector cu_dir, vector cu_spread) cu_FireBullets =
{
	vector cu_src, cu_direction;
	entity cu_ig;
	float cu_s, cu_lim;
	
	if (cu_shotcount <= 0) return;
	
	makevectors(self.v_angle);

	if (cu_trace_debug) cu_dprint3("*** firing ", ftos(cu_shotcount), " bullets *\n\n");
	for (cu_s = 0; cu_s < cu_shotcount; cu_s++)
	{
		cu_src = self.origin + v_forward*10;
		cu_src_z = self.absmin_z + self.size_z * 0.7;
		cu_direction = cu_SpreadVector(cu_dir, cu_spread);
		
		if (cu_trace_debug) dprint("* firing a bullet *\n");
		
		cu_lim = 0;
		// check for trace-through cases
		for (cu_ig = self; cu_ig != world; cu_lim++)	// ig == world if we hit a wall or hit nothing
		{
			cu_traceline2(cu_src, cu_src + cu_direction*2048, cu_ig, 0);
			
			if (trace_ent == self)
				return;	// some notrace shit happened
		
			// if we've already pelted a monster enough to kill it, let additional bullets add 
			// up for possible gibs (ala quake), but trace them again through the target for 
			// better crowd control feels (ala doom).
			// this is only noticeable with big hordes of weak guys, but it makes big hordes of
			// weak guys not feel like solid ammo-sponge walls.
			if (trace_ent.takedamage && 
				(trace_ent.flags & cu_FL_MONSTER || trace_ent.classname == "player" ) && 
				// some id shootables are actually trigger_multiples with health and SOLID_BBOX, so this doesn't work (see e1m6):
				//( trace_ent.solid == SOLID_BBOX || trace_ent.solid == SOLID_SLIDEBOX ) &&	
				cu_HasBeenShotToDeath(trace_ent) )
			{
				cu_BulletImpact (2+2*random(), cu_direction);

				// start 0.1 unit forward, or else when shooting an adjacent enemy we'll
				// just hit ourselves again
				cu_src = trace_endpos + cu_direction * 0.1;
				cu_ig = trace_ent;
				if (cu_trace_debug) cu_dprint3("bullet hit ", cu_ig.classname, ", continuing thru\n");
			}
			else
			{
				if (cu_trace_debug) dprint("bullet reached world\n");
				cu_ig = world;
			}
			if (cu_lim > 8)
			{
				dprint("bullet pen limit exceeded\n");
				break;
			}
		}
		
		if (trace_fraction != 1.0)
		{
			cu_BulletImpact (4, cu_direction);
		}
		
		if (cu_trace_debug) dprint("bullet is over\n\n");
	}
}

/*
================
W_FireShotgun
================
*/
void() cu_W_FireShotgun =
{
	local vector cu_dir;
	
	// for ai_nav:
	/*if (nav_w_nodeLink())
	{
		self.attack_finished = time + 0.5;
		return;
	}*/
	
	sound (self, cu_CHAN_WEAPON, "weapons/guncock.wav", 1, cu_ATTN_NORM);	

	self.punchangle_x = -2;
	makevectors(self.v_angle);
	
	self.currentammo = self.ammo_shells = self.ammo_shells - 1;
	cu_dir = aim (self, cu_AUTOAIM_DIST);

	cu_ClearMultiDamage ();
	cu_FireBullets (6, cu_dir, '0.04 0.04 0');
	self.cu_attack_finished = time + 0.5;
	
	cu_ApplyMultiDamage ();
}


/*
================
W_FireSuperShotgun
================
*/
void() cu_W_FireSuperShotgun =
{
	local vector cu_dir;
	
	// for ai_nav:
	/*if (nav_w_nodeLinkSpecial())
	{
		self.attack_finished = time + 0.5;
		return;
	}*/

	if (self.currentammo == 1)
	{
		if (self.items & cu_IT_SHOTGUN)
			cu_W_FireShotgun ();
		return;
	}
		
	sound (self ,cu_CHAN_WEAPON, "weapons/shotgn2.wav", 1, cu_ATTN_NORM);	

	self.punchangle_x = -4;
	
	self.currentammo = self.ammo_shells = self.ammo_shells - 2;
	cu_dir = aim (self, cu_AUTOAIM_DIST);

	cu_ClearMultiDamage ();

	cu_FireBullets (14, cu_dir, '0.14 0.08 0');
	self.cu_attack_finished = time + 0.7;
	
	cu_ApplyMultiDamage ();

}
