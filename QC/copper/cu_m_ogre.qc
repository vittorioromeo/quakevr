//=============================================================================

void() cu_OgreGrenadeExplode =
{
	cu_T_RadiusDamage (self, self.cu_trueowner, 40, world, cu_DMGTYPE_EXPLOSION); // QVR: the parameter's default, explicit
	//sound (self, CHAN_VOICE, "weapons/r_exp3.wav", 1, ATTN_NORM);
	
	cu_T_ExplosiveTouch();
}

void() cu_GrenadeHandlePhysics;

void() cu_OgreGrenadeTouch =
{
	if (other == self.owner) return;		// don't explode on owner
	if (cu_CheckProjectilePassthru()) return;

	if (other.takedamage == cu_DAMAGE_AIM)
	{
		if (other.cu_type == "zombie")
			cu_T_Damage (other, self, self.cu_trueowner, other.health + 25);
		else if (other.cu_type == "explobox")
			cu_T_Damage (other, self, self.cu_trueowner, 24);
		cu_OgreGrenadeExplode();
		return;
	}

	cu_GrenadeHandlePhysics();

	sound (self, cu_CHAN_VOICE, "weapons/bounce.wav", 1, cu_ATTN_NORM);	// bounce sound
	if (self.velocity == '0 0 0')
		self.avelocity = '0 0 0';
}

/*
================
OgreAimGrenade
original OP aim code by Preach

the best solution seemed to be to average the perfect aim and the old 
one-vector-fits-all. ogres now aim within -20 and 40 degrees pitch, making 
them appear as ineffective as they used to be but providing more flexibility 
in placement, so rooms don't have to be designed around how high the ogres 
have to be
================
*/
vector(vector dest, float speed) cu_OgreAimGrenade =
{
	float cu_theta, cu_a;
	vector cu_angs;
	
	cu_theta = cu_BallisticTheta(dest,speed,18);		// stock quake ogre firing angle is 18
	if (cu_theta == cu_BAD_THETA) cu_theta = 18;
	
	cu_a = vectoyaw(dest);
	cu_angs = '0 0 0';
	cu_angs_y = cu_a;
	
	// clamp the perfect terminator-aim to limit deadon shots to the face, then average with 
	// old dumb aim for "z-only-slightly-aware"ness(tm)
	if (vlen(dest) < 160)
		cu_theta = cu_clamp(cu_theta, -80, 70);
	else
		cu_theta = cu_clamp(cu_theta, -60, 60);
		
	if (cu_skill == 3)
		cu_theta = (cu_theta + cu_theta + 18) / 3; // nightmare: 66% z-awareness
	else
		cu_theta = (cu_theta + 18) / 2;	// copper: 50% z-awareness
		
	cu_angs_x = -cu_theta;	
	makevectors(cu_angs);
	
	return v_forward * speed;
}


/*
================
OgreFire
================
*/
void() cu_OgreFireGrenade =
{
	local	entity cu_g;
	vector cu_gorg, cu_gvel;
	
	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	sound (self, cu_CHAN_WEAPON, "weapons/grenade.wav", 1, cu_ATTN_NORM);

	// set grenade speed	
	makevectors (self.angles);
	cu_gorg = self.origin + v_forward * 16;
	cu_gvel = cu_OgreAimGrenade(cu_enemy_vispos() - cu_gorg, 632);
	
	cu_g = cu_launch_grenade(cu_gorg, cu_gvel);
	cu_g.touch = cu_OgreGrenadeTouch;
	cu_g.cu_th_die = cu_OgreGrenadeExplode;
}



void() cu_ogre_dropammo =
{
	// reduced grenade drops from ogres
	// don't want to have to keep soaking them up with pointless zombie squads early on
	self.ammo_rockets = 1;
	cu_DropBackpack();
}


//=============================================================================

/*
================
chainsaw

FIXME
================
*/
void(float cu_side) cu_chainsaw =
{
local vector	cu_delta;
local float 	cu_ldmg;

	if (!self.enemy)
		return;
	if (!cu_CanDamage (self.enemy, self.origin))
		return;

	cu_ai_charge(10);
	if (self.deadflag) return;

	cu_delta = self.enemy.origin - self.origin;

	if (vlen(cu_delta) > 100)
		return;
		
	cu_ldmg = (random() + random() + random()) * 4;
	cu_T_Damage (self.enemy, self, self, cu_ldmg, cu_DMGTYPE_MELEE);
	
	if (cu_side)
	{
		makevectors (self.angles);
		if (cu_side == 1)
			cu_SpawnMeatSpray (self.origin + v_forward*16, cu_crandom() * 100 * v_right);
		else
			cu_SpawnMeatSpray (self.origin + v_forward*16, cu_side * v_right);
	}
}


