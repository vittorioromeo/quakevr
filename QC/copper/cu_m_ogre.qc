void(entity cu_attacker, float cu_damage)	cu_ogre_pain =
{
	local float	cu_r;
	
	// don't make multiple pain sounds right after each other
	if (self.cu_pain_finished > time)
		return;
		
	sound (self, cu_CHAN_VOICE, "ogre/ogpain1.wav", 1, cu_ATTN_NORM);		
	cu_r = random();
	if (cu_skill == 3)
		cu_r *= random();	// nightmare: make the long stuns rare
	
	if (cu_r < 0.25)
		cu_ogre_painb1 ();	// shortest
	else if (cu_r < 0.5)
		cu_ogre_pain1 ();
	else if (cu_r < 0.75)
		cu_ogre_painc1 ();
	else if (cu_r < 0.88)
		cu_ogre_paine1 ();
	else
		cu_ogre_paind1 ();	// longest
}

