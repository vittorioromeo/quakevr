/*
===========
OgreCheckAttack

The player is in view, so decide to move or launch an attack
Returns FALSE if movement should continue
============
*/
float() cu_OgreCheckAttack =
{
	if (cu_enemy_range == cu_RANGE_MELEE && cu_z_overlap(self.enemy))
	{
		if (cu_CanDamage (self.enemy, self.origin))
		{
			self.cu_attack_state = cu_AS_MELEE;
			return cu_TRUE;
		}
	}

	if (time < self.cu_attack_finished)
		return cu_FALSE;
	
	if (!cu_enemy_vis)
		return cu_FALSE;
	
	// randomly attack with the chainsaw if enemy has the ring of shadows
	// TODO: friendly chainsaw fire to start infights
	if (cu_has_invis(self.enemy))
	{
		if (random() < 0.2)
		{
			self.cu_attack_state = cu_AS_MELEE;
			return cu_TRUE;
		}
	}
		
	if (!cu_CheckClearAttack()) return cu_FALSE;
	
	// missile attack
	if (time < self.cu_attack_finished)
		return cu_FALSE;

	if (cu_enemy_range == cu_RANGE_TOOFAR || cu_enemy_range == cu_RANGE_FAR)
		return cu_FALSE;	// too far for grenades

	self.cu_attack_state = cu_AS_MISSILE;
	return cu_TRUE;
}


