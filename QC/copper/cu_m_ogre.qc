void()	cu_ogre_bdie8	=[	$bdeath8,	cu_ogre_bdie9	] {}
void()	cu_ogre_bdie9	=[	$bdeath9,	cu_ogre_bdie10	] {}
void()	cu_ogre_bdie10	=[	$bdeath10,	cu_SUB_Null	] {}

void() cu_ogre_die =
{
// check for gib
	if (self.health < -80)
	{
		cu_Gib ("progs/h_ogre.mdl", self.health);
		cu_ogre_dropammo();
		return;
	}

	sound (self, cu_CHAN_VOICE, "ogre/ogdth.wav", 1, cu_ATTN_NORM);
	
	if (random() < 0.5)
		cu_ogre_die1 ();
	else
		cu_ogre_bdie1 ();
}

void() cu_ogre_melee =
{
	if (random() > 0.5)
		cu_ogre_smash1 ();
	else
		cu_ogre_swing1 ();
}




//=============================================================================



void() cu_monster_ogre_spawn =
{
	self.classname = "monster_ogre";
	self.cu_type = "ogre";
	
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/ogre.mdl");

	setsize (self, cu_VEC_HULL2_MIN, '32 32 40');
	self.health = 200;

	self.cu_th_stand = cu_ogre_stand1;
	self.cu_th_walk = cu_ogre_walk1;
	self.cu_th_run = cu_ogre_run1;
	self.cu_th_die = cu_ogre_die;
	self.cu_th_melee = cu_ogre_melee;
	self.cu_th_missile = cu_ogre_nail1;
	self.cu_th_pain = cu_ogre_pain;
	self.cu_th_checkattack = cu_OgreCheckAttack;

	if (self.deathtype == cu_string_null)
		self.deathtype = "was destroyed by an Ogre";

	cu_walkmonster_start();
}

void() cu_monster_ogre_spawner = {cu_mon_spawner_use(cu_monster_ogre_spawn);}

/*cu:QUAKED monster_ogre (1 0 0) (-32 -32 -24) (32 32 40) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Ogre, 200 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry

"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
"movedir" set to a velocity to make the monster jump on awakening
*/
/*FGD
@PointClass base(Monster) size(-32 -32 -24, 32 32 64) model({ "path": ":progs/ogre.mdl" }) = monster_ogre : "Ogre" []
*/
void() cu_monster_ogre =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}

	precache_model ("progs/ogre.mdl");
	precache_model ("progs/h_ogre.mdl");
	precache_model ("progs/grenade.mdl");

	precache_sound ("ogre/ogdrag.wav");
	precache_sound ("ogre/ogdth.wav");
	precache_sound ("ogre/ogidle.wav");
	precache_sound ("ogre/ogidle2.wav");
	precache_sound ("ogre/ogpain1.wav");
	precache_sound ("ogre/ogsawatk.wav");
	precache_sound ("ogre/ogwake.wav");
	
	self.health = 200;
	setsize (self, cu_VEC_HULL2_MIN, '32 32 40');
	if ( cu_monster_spawnsetup( cu_monster_ogre_spawner ) ) return;
	
	cu_addmonster(1);
	cu_monster_ogre_spawn();
}

void() cu_monster_ogre_marksman =
{
	cu_monster_ogre ();
}

