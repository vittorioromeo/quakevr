/*
================
spawn_touchblood

only used by nailguns so now it's here
================
*/
void(float cu_damage) cu_spawn_touchblood =
{
	local vector	cu_vel;

	cu_vel = normalize(self.velocity) * -1;
	cu_vel = normalize(cu_vel + v_up*(random()- 0.5) + v_right*(random()- 0.5));
	
	//vel = vel + 2*trace_plane_normal;
	// nailguns don't do traces so there is no valid trace plane normal
	// (which explains why nailgun blood spurts always seemed to be caught in some strange wind)
	
	cu_SpawnBlood (self.origin + cu_vel, cu_vel * 40, cu_damage);
}



// --------------------------------

vector(vector cu_muzzle) cu_W_SpikeOrigin =
{
	return (self.origin + '0 0 16' + 
			11 * v_forward +
			cu_muzzle_x * v_right +
			cu_muzzle_z * v_up);
}

vector(vector cu_fwd, float cu_spread) cu_W_SpikeDir =
{
	return normalize(cu_fwd + (2 * v_right * cu_crandom() + v_up * cu_crandom()) * cu_spread / 100);
}

void() cu_W_FireNailgun =
{
	vector cu_offset, cu_v, cu_org, cu_dir;
	// remember sv_aim
	cu_dir = aim( self, cu_AUTOAIM_DIST );
	cu_v = vectoangles( cu_dir );
	cu_v_x *= -1;	// pitch comes back inverted from vectoangles :|
	makevectors( cu_v );

	sound (self, cu_CHAN_WEAPON, "weapons/rocket1i.wav", 1, cu_ATTN_NORM);
	self.currentammo = self.ammo_nails = self.ammo_nails - 1;
	cu_offset = cu_VEC_ORIGIN;
	if ( cu_mod( self.cu_cnt, 2 ) ) cu_offset_x = -2.5;
	else cu_offset_x = 2.5;	

	cu_org = cu_W_SpikeOrigin(cu_offset);

	// default sv_maxvelocity is 2000, any higher leads to weird 
	// angular offsets caused by clamping the velocity
	cu_launch_nail(cu_org, cu_dir * 1996);
	self.cu_attack_finished += 0.09;
}

void() cu_spike_unfatten = { self.movetype = cu_MOVETYPE_FLY; }

void() cu_W_FirePerforator =
{
	vector cu_offset;
	sound (self, cu_CHAN_WEAPON, "weapons/spike2.wav", 1, cu_ATTN_NORM);
	self.currentammo = self.ammo_nails = self.ammo_nails - 2;
	
	if (cu_mod(self.cu_cnt, 4) == 0) cu_offset = '0 0 1.25';
	else if (cu_mod(self.cu_cnt, 4) == 1) cu_offset = '1 0 1';
	else if (cu_mod(self.cu_cnt, 4) == 2) cu_offset = '1.25 0 0';
	else if (cu_mod(self.cu_cnt, 4) == 3) cu_offset = '1 0 -1';
	
	entity cu_spike1, cu_spike2;
	cu_spike1 = cu_launch_nail(cu_W_SpikeOrigin(cu_offset), cu_W_SpikeDir(v_forward, 2) * (940 + random()*30));
	cu_spike2 = cu_launch_nail(cu_W_SpikeOrigin(-cu_offset), cu_W_SpikeDir(v_forward, 2) * (1020 + random()*30));

	// weaken the SNG at long distance while keeping the spread under control
	cu_spike1.think = cu_spike_unfatten;
	cu_spike2.think = cu_spike_unfatten;
	cu_spike1.nextthink = time + 0.25;
	cu_spike2.nextthink = time + 0.3;
	
	self.cu_attack_finished += 0.09;
	
	if (cu_has_quad(self))
	{
		// here's a silly thing:
		// one vanilla SNG nail does 18 dmg, 72 with quad, enough to gib zombies and grunts.
		// two copper nails do 9 each, 36 each with quad, for the same total damage, but that
		//   only kills grunts and knocks zombies down because the second nail doesn't hit.
		
		// the dumb solution is to make one nail do 0 dmg and the other do 18 in quad mode
		//   so the math works out like the old math and the quad SNG still feels right
		cu_spike2.dmg = 18;
		cu_spike1.dmg = 18;
		cu_spike2.cu_buddy = cu_spike1;
		cu_spike1.cu_buddy = cu_spike2;
		// first one to hit does its damage and then nerfs its 'buddy'
	}
}

void() cu_W_FireSpikes =
{
	if (self.ammo_nails < 1 || (self.ammo_nails < 2 && !(self.items & cu_IT_NAILGUN)))
	{
		cu_W_SelectBestWeapon();
		return;
	}
	self.cu_attack_finished = time;
	if (self.ammo_nails >= 2 && self.weapon == cu_IT_SUPER_NAILGUN)
	{
		cu_W_FirePerforator();
	}
	else
	{
		cu_W_FireNailgun();
	}
	self.punchangle_x = -2;
	
	self.cu_cnt = cu_cycle(self.cu_cnt,8);
}

float() cu_CheckValidSpikeTouch =
{
	if (other == self.owner) return cu_FALSE;
	if (other.solid == cu_SOLID_TRIGGER) return cu_FALSE;
	if (cu_CheckProjectilePassthru()) return cu_FALSE;

	if (pointcontents(self.origin) == cu_CONTENT_SKY)
	{
		remove(self);
		return cu_FALSE;
	}
	
	return cu_TRUE;
}


void() cu_spike_touch =
{
	if (!cu_CheckValidSpikeTouch()) return;
	
	if (self.dmg)
	{
		if (other.takedamage)
		{
			cu_spawn_touchblood (self.dmg);
			cu_T_Damage (other, self, self.cu_trueowner, self.dmg);
		}
		else
		{
			WriteByte (cu_MSG_BROADCAST, cu_SVC_TEMPENTITY);
			
			switch(self.classname)
			{
			case "wizspike":
				WriteByte (cu_MSG_BROADCAST, cu_TE_WIZSPIKE); break;
			case "knightspike":
				WriteByte (cu_MSG_BROADCAST, cu_TE_KNIGHTSPIKE); break;
			case "laser":
				WriteByte(cu_MSG_BROADCAST, cu_TE_GUNSHOT); break;
			default:
				WriteByte (cu_MSG_BROADCAST, cu_TE_SPIKE);
			}
			WriteCoord (cu_MSG_BROADCAST, self.origin_x);
			WriteCoord (cu_MSG_BROADCAST, self.origin_y);
			WriteCoord (cu_MSG_BROADCAST, self.origin_z);
		}
		
		if (self.classname == "laser")
		{
			sound (self, cu_CHAN_WEAPON, "enforcer/enfstop.wav", 1, cu_ATTN_STATIC);
			particle (self.origin, self.velocity*-0.01, 235, 15);
		}
	}
	// nonsense for combining quad SNG spike damage
	if (self.cu_buddy)
		self.cu_buddy.dmg = 0;
	remove(self);
}


