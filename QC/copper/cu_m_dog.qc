void(entity cu_attacker, float cu_damage) cu_dog_pain =
{
	if (time < self.cu_pain_finished) return;
	sound (self, cu_CHAN_VOICE, "dog/dpain1.wav", 1, cu_ATTN_NORM);

	if (random() > 0.5)
	{
		cu_dog_pain1 ();
		cu_PainFinished(0.5);
	}
	else
	{
		cu_dog_painb1 ();
		cu_PainFinished(1.5);
	}
}

