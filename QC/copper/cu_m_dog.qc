void() cu_dog_leap2	=[	$leap2,		cu_dog_leap3	]
{
	cu_nmfast();
	cu_ai_face();
	cu_ai_attack_finished(0.2);
	if (self.flags & cu_FL_ONGROUND || self.velocity_z == 0)
	{	
		makevectors (self.angles);
		self.flags = cu_not(self.flags, cu_FL_ONGROUND);
		self.velocity = v_forward * 300 + '0 0 200';
		self.touch = cu_Dog_JumpTouch;
	}
}
