void() cu_dog_die =
{
// check for gib
	if (self.health < -35)
	{
		cu_Gib ("progs/h_dog.mdl", self.health);
		return;
	}

// regular death
	sound (self, cu_CHAN_VOICE, "dog/ddeath.wav", 1, cu_ATTN_NORM);

	if (random() > 0.5)
		cu_dog_die1 ();
	else
		cu_dog_dieb1 ();
}

//============================================================================

/*
==============
CheckDogMelee

Returns TRUE if a melee attack would hit right now
==============
*/
float()	cu_CheckDogMelee =
{
	if (cu_enemy_range == cu_RANGE_MELEE && cu_z_overlap(self.enemy))
	{	// FIXME: check canreach
		self.cu_attack_state = cu_AS_MELEE;
		return cu_TRUE;
	}
	return cu_FALSE;
}

/*
==============
CheckDogJump
==============
*/
float()	cu_CheckDogJump =
{
	local	vector	cu_dist;
	local	float	cu_d;

	if (self.origin_z + self.mins_z > self.enemy.origin_z + self.enemy.mins_z
	+ 0.75 * self.enemy.size_z)
		return cu_FALSE;
		
	if (self.origin_z + self.maxs_z < self.enemy.origin_z + self.enemy.mins_z
	+ 0.25 * self.enemy.size_z)
		return cu_FALSE;
		
	cu_dist = self.enemy.origin - self.origin;
	cu_dist_z = 0;
	
	cu_d = vlen(cu_dist);
	
	if (cu_d < 80)
		return cu_FALSE;
		
	if (cu_d > 150)
		return cu_FALSE;
		
	return cu_TRUE;
}

float()	cu_DogCheckAttack =
{
// if close enough for slashing, go for it
	if (cu_CheckDogMelee ())
	{
		self.cu_attack_state = cu_AS_MELEE;
		return cu_TRUE;
	}
	
	if (cu_CheckDogJump ())
	{
		self.cu_attack_state = cu_AS_MISSILE;
		return cu_TRUE;
	}
	
	return cu_FALSE;
}


