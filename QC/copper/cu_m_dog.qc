/*
================
dog_bite

================
*/
void() cu_dog_bite =
{
	vector	cu_delta;

	if (!self.enemy)
		return;

	cu_ai_charge(10);
	if (self.deadflag) return;

	if (!cu_CanDamage (self.enemy, self.origin))
		return;

	cu_delta = self.enemy.origin - self.origin;

	if (vlen(cu_delta) > 100)
		return;
		
	cu_T_Damage(self.enemy, self, self, 8 + random() * 8, cu_DMGTYPE_MELEE);
}

void()	cu_Dog_JumpTouchGround =
{
	if (!checkbottom(self))
	{
		if (self.flags & cu_FL_ONGROUND)
		{	// jump randomly to not get hung up
			self.touch = cu_SUB_Null;
			self.think = cu_dog_leap1;
			self.nextthink = time + 0.1;
		}
		return;	// not on ground yet
	}

	self.touch = cu_SUB_Null;
	self.think = cu_dog_run1;
	self.nextthink = time + 0.1;
}

void()	cu_Dog_JumpTouch =
{
	if (self.health <= 0)
		return;
		
	if (other.classname != "monster_dog" &&	// pack dogs whose bboxes brush each other during leaps wind up killing each other
		other.takedamage)
	{	
		if ( vlen(self.velocity) > 300 )
		{
			if (other.classname != "player" || time > self.cu_touch_time)	// fix for landing on the player's head
			{
				if (other.classname == "player")
				{
					self.cu_touch_time = time + 0.2;
				}
				cu_T_Damage(other, self, self, 10 + 10*random(), cu_DMGTYPE_MELEE);	
			}
		}
	}
	cu_Dog_JumpTouchGround();
}

void() cu_dog_airthink =
{
	self.think = cu_dog_airthink;
	self.nextthink = time + 0.1;
	
	// if three seconds pass, assume dog is stuck and jump again
	if (time >= self.cu_lifetime_finished)
	{
		cu_dog_leap1();
		return;
	}
	// we aren't moving, assume leap is over so we don't get stuck
	if (self.origin == self.oldorigin && self.flags & cu_FL_ONGROUND)
	{
		cu_dog_run1();
		return;
	}
	self.oldorigin = self.origin;
}

