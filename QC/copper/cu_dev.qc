void() cu_dev_test =
{
	local vector cu_org;
	makevectors(self.v_angle);
	cu_org = self.origin + self.view_ofs;
	cu_traceline2(cu_org, cu_org + v_forward * 8192, self, 0);

	if (trace_fraction == 1.0 || !trace_ent)
		return;

	entity cu_head = cu_findalltargets(trace_ent);
	while(cu_head)
	{
		cu_bprint4(cu_head.classname, " @ ", vtos(cu_head.origin), "\n");
		cu_head =  cu_head.chain;
	}
	bprint("-----\n");
}

void() cu_dev_tracetest =
{
	local vector cu_org;
	makevectors(self.v_angle);
	cu_org = self.origin + self.view_ofs;
	
	traceline (cu_org, cu_org + v_forward * 2048, cu_FALSE, self);
	
	cu_bprint3("startpos: ", vtos(cu_org), "\n");
	cu_bprint3("endpos: ", vtos(trace_endpos), "\n");
	cu_bprint3("water: ", ftos(trace_inwater), "\n");
	cu_bprint3("open: ", ftos(trace_inopen), "\n");
	cu_bprint3("allsolid: ", ftos(trace_allsolid), "\n");
	
	cu_traceline2 (cu_org, cu_org + v_forward * 2048, self, 0);
	
	cu_bprint3("startpos: ", vtos(cu_org), "\n");
	cu_bprint3("endpos: ", vtos(trace_endpos), "\n");
	cu_bprint3("water: ", ftos(trace_inwater), "\n");
	cu_bprint3("open: ", ftos(trace_inopen), "\n");
	cu_bprint3("allsolid: ", ftos(trace_allsolid), "\n");
}

void() cu_dev_hitpoints =
{
	if (!cvar("developer"))
	{
		bprint("start the map with developer 1 first\n");
		return;
	}
	float cu_zdif;
	
	bprint("----------\nRockets: ");
	bprint(ftos(cu_num_rockets));
	bprint(" Zombies: ");
	bprint(ftos(cu_num_zombies));
	
	cu_zdif = cu_num_rockets - cu_num_zombies;
	cu_zdif = cu_max(0,cu_num_rockets);
	cu_ammo_total += cu_zdif * cu_DEBUG_DMG_PER_ROCKET;
	
	bprint("\nMonster HP: ");
	bprint(ftos(cu_monster_health));
	bprint("\nAmmo DP: ");
	bprint(ftos(cu_ammo_total));
	bprint("\nRATIO: ");
	bprint(ftos(cu_ammo_total / cu_monster_health));
	bprint("\n");
}

void() cu_dev_warp =
{
	if(deathmatch || coop)
		return;
	local vector cu_org;
	makevectors(self.v_angle);
	cu_org = self.origin + self.view_ofs;
	traceline (cu_org, cu_org + v_forward * 8192, cu_FALSE, self);

	if (trace_fraction < 1.0)
	{
		cu_org = trace_endpos;
		cu_org += trace_plane_normal * 40;
	}
	setorigin(self,cu_org);
}

void() cu_dev_serverflags =
{
	cu_bprint3("SERVER FLAGS:\n========\n  ",ftos(serverflags),"  \n");
	if (serverflags & cu_SVFL_EPISODE1)	bprint("  episode 1 completed\n");
	if (serverflags & cu_SVFL_EPISODE2)	bprint("  episode 2 completed\n");
	if (serverflags & cu_SVFL_EPISODE3)	bprint("  episode 3 completed\n");
	if (serverflags & cu_SVFL_EPISODE4)	bprint("  episode 4 completed\n");
	if ((serverflags & cu_SVFL_ALLEPISODES) == cu_SVFL_ALLEPISODES)	bprint("  all of quake completed\n");
}


// this is the most fun cheat code in the history of anything:
void() cu_dev_invoke =
{
	if ((deathmatch || coop) && !cvar("developer"))
		return;
	local vector cu_org;
	makevectors(self.v_angle);
	cu_org = self.origin + self.view_ofs;
	cu_traceline2(cu_org, cu_org + v_forward * 8192, self, 0);
	if (trace_fraction < 1.0 && trace_ent)
	{
		cu_activator = self;
		
		if (trace_ent.flags & cu_FL_CLIENT)
			sound (trace_ent, cu_CHAN_VOICE, "player/plyrjmp8.wav", 1, cu_ATTN_NORM);	
		else if (trace_ent.flags & cu_FL_MONSTER)
			cu_monster_kill(trace_ent);
		else if (trace_ent.classname == "func_door")
			cu_door_force(trace_ent);
		else if (trace_ent.classname == "func_button")
			cu_button_force(trace_ent);
		else if (trace_ent.classname == "func_plat")
			cu_plat_force(trace_ent);
		else if (trace_ent.classname == "monster_boss")
			cu_SUB_CallAsSelf(cu_boss_death1, trace_ent);	
		else if (trace_ent.use)
			cu_SUB_CallAsSelf(trace_ent.use, trace_ent);		
	}
}

void() cu_dev_reveal =
{
//	bprint("dev\n");
	local vector cu_org;
	makevectors(self.v_angle);
	cu_org = self.origin + self.view_ofs;
	traceline (cu_org, cu_org + v_forward * 8192, cu_FALSE, self);

	if (trace_fraction < 1.0 && trace_ent)
	{
	//	trace_ent.developer = 1;
		//bprint("hit entity:\n");
		cu_bprint3("time: ", ftos(time), "\n");
		eprint(trace_ent);
		//bprint("hit ent's enemy:\n");
		//eprint(trace_ent.enemy);
		if (trace_ent.flags & cu_FL_ONGROUND) bprint("  entity is ONGROUND\n");
		if (trace_ent.flags & cu_FL_PARTIALGROUND) bprint("  entity is PARTIAL_GROUND\n");
		if (checkbottom(trace_ent)) bprint("  checkbottom is true\n");
		else bprint("  checkbottom is FALSE\n");
	}
}

void() cu_dev_trigger =
{
	if(deathmatch || coop)
		return;
	entity cu_t;
	
	cu_dprint3("dev trigger impulse firing '", self.netname, "'\n");
	cu_activator = self;
	cu_t = world;
	do	{
		cu_t = cu_SUB_UseNextTarget( cu_t, self.netname );
		cu_activator = self;
		if (!cu_t) break;
		cu_dprint3("  fired a ", cu_t.classname, "\n");
	} while ( 1 );
}

void(float cu_i) cu_dev_impulse =
{
	cu_bprint3("dev impulse ", ftos(cu_i), " triggering\n");
	entity cu_t;
	cu_activator = self;
	cu_t = world;
	do	{
		cu_t = find(cu_t, classname, "tg_imp");
		if (cu_t.impulse == cu_i)
			cu_SUB_CallAsSelf(cu_t.owner.use, cu_t.owner);
	} while ( cu_t != world );
}

void() cu_dev_impulse_list =
{
	bprint("dev impulses:\n");
	entity cu_t;
	cu_t = world;
	do	{
		cu_t = find(cu_t, classname, "tg_imp");
		if (cu_t)
		{
			cu_bprint4("  ", ftos(cu_t.impulse), ": ", cu_t.owner.classname);
			if (cu_t.owner.targetname != cu_string_null)
				cu_bprint3(", tname: ", cu_t.owner.targetname, "\n");
			else
				bprint("\n");
		}
	} while ( cu_t != world );
	bprint("end of list.\n");
}

void() cu_dev_enemychain =
{
	local vector cu_org;
	makevectors(self.v_angle);
	cu_org = self.origin + self.view_ofs;
	traceline (cu_org, cu_org + v_forward * 8192, cu_FALSE, self);

	entity cu_e;
	float cu_i;
	cu_i = 0;
	if (trace_fraction < 1.0 && trace_ent)
	{
		cu_e = trace_ent;
		do
		{
			cu_bprint5(ftos(cu_i),": ",cu_e.classname," at ~ ",vtos((cu_e.absmin + cu_e.absmax)* 0.5));
			bprint("\n");
			cu_e = cu_e.enemy;
			cu_i += 1;
		}
		while (cu_e != trace_ent);
	}
}


void() cu_dev_remaining_monsters
{
	entity cu_mon = world;
	bprint("Remaining monsters and spawners:\n");
	do {
		cu_mon = nextent(cu_mon);
		if (cu_mon.flags & cu_FL_MONSTER)
		{
			if (cu_mon.health <= 0 || cu_mon.deadflag || 
				(cu_mon.cu_type == "zombie" && cu_mon.cu_customflags & cu_CFL_RETURNED)) // no returned zombies on nightmare
				continue;
			cu_bprint4(cu_mon.classname, " at ", vtos(cu_mon.origin), "\n");
		}
		else if (cu_mon.cu_customflags & cu_CFL_SPAWNER)
		{
			if (cu_mon.count <= 0) continue;
			cu_bprint4(cu_mon.classname, " at ", vtos(cu_mon.origin), " (spawner: ");
			cu_bprint_int(cu_mon.count);
			cu_bprint3(" remaining, named '", cu_mon.targetname ,"')\n");
		}
	} while (cu_mon != world);
	bprint("end of list.\n----------\n");
}


// for when i light a map at 1am and then play it again the next afternoon
void() cu_dev_i_cant_see =
{
	if (cu_icantsee)
		lightstyle(0, "m");
	else
		lightstyle(0, "z");
	cu_icantsee = !cu_icantsee;
	cu_initCleanup = 2;
}


void() cu_dev_whatami =
{
	eprint(self);
}

// ====================================
// meatballs: fake clients for testing coop with fudged playercounts
// ... or playing solo in 'stupid crazy challenge' mode

void() cu_dev_add_meatball =
{
	if (!coop) return;
	entity cu_meatball = spawn();
	entity cu_spot = cu_SelectSpawnPoint();
	
	cu_meatball.classname = "meatball";
	setmodel(cu_meatball, "progs/player.mdl");
	setsize(cu_meatball,cu_VEC_HULL_MIN, cu_VEC_HULL_MAX);
	setorigin(cu_meatball,cu_spot.origin);
	cu_meatball.angles = cu_spot.mangle;
	cu_meatball.solid = cu_SOLID_NOT;
	cu_meatball.movetype = cu_MOVETYPE_NONE;
	
	cu_meatball.pos1 = '12 12 16';
	cu_meatball.frame = 12;
	cu_meatball.think = cu_misc_model_animate;
	cu_meatball.speed = 0.1;
	cu_meatball.nextthink = time + 0.1;
	
	sound (cu_meatball, cu_CHAN_VOICE, "items/itembk2.wav", 1, cu_ATTN_NONE);
	
	cu_clients += 1;
	cu_clientsAlive += 1;
}

void() cu_dev_remove_meatball =
{
	if (!coop) return;
	entity cu_meatball = find(world,classname,"meatball");
	if (cu_meatball)
	{
		sound (cu_meatball, cu_CHAN_BODY, "player/tornoff2.wav", 1, cu_ATTN_NONE);
		remove(cu_meatball);
		cu_clients -= 1;
		cu_clientsAlive -= 1;
	}
}