/*FGD
@baseclass base(Appearflags) = Ambient [
	distance(choices) : "Attenuation" : 0 = [
		0 : "Ambient"
		1 : "Monster Idle"
		2 : "Monster Bark"
		3 : "Global"
	]
]
*/
void(float cu_vol) cu_sound_setup =
{
	if (!self.volume)
		self.volume = cu_vol;
	else
		self.volume = cu_saturate(self.volume);
		
	if (!self.distance)
		self.distance = cu_ATTN_STATIC;
	else if (self.distance == 1) self.distance = cu_ATTN_IDLE;
	else if (self.distance == 2) self.distance = cu_ATTN_NORM;
	else if (self.distance == 3) self.distance = cu_ATTN_NONE;
	
	self.cu_width = 0;
	cu_precache_sound_safe(self.noise);
	
	if (self.noise1 == cu_string_null) return;
	cu_precache_sound_safe(self.noise1);
	self.cu_width++;

	if (self.noise2 == cu_string_null) return;
	cu_precache_sound_safe(self.noise2);
	self.cu_width++;

	if (self.noise3 == cu_string_null) return;
	cu_precache_sound_safe(self.noise3);
	self.cu_width++;

	if (self.noise4 == cu_string_null) return;
	cu_precache_sound_safe(self.noise4);
	self.cu_width++;
}

void(float cu_vol) cu_ambient_setup =
{
	cu_sound_setup(cu_vol);
	ambientsound (self.origin, self.noise, self.volume, self.distance);
}

