void() cu_f_run1 =[	$swim1, cu_f_run2 ] {cu_nmfast(); cu_ai_run(12);
	float cu_r = 0.33;
	if (cu_skill == 3) cu_r = 0.2;	// lots of fast fish on nightmare makes a racket
	if (random() < cu_r)
		sound (self, cu_CHAN_VOICE, "fish/idle.wav", 1, cu_ATTN_NORM);
	cu_fish_check_attack();	// calling this after ai_run is such a hack
							// but i don't want to load down calls to visible()
							// with exceptions for a fish deciding the player is
							// technically visible even though their eyes are
							// above water
}
