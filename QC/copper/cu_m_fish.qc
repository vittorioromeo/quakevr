void(entity cu_attacker, float cu_damage)	cu_fish_pain =
{
	if (time < self.cu_pain_finished) return;
	cu_f_pain1 ();
	cu_PainFinished(1);
}

void() cu_fish_throwgib =
{
	entity cu_meat;
	vector cu_mvel;
	
	cu_mvel_x = random() * 256 - 128;
	cu_mvel_y = random() * 256 - 128;
	cu_mvel_z = random() * 256;

	cu_meat = cu_ThrowGib("progs/zom_gib.mdl", cu_mvel);
	cu_meat.cu_lifetime_finished = time + 1;
}

void() cu_fish_gib =
{
	vector cu_org;
	cu_org = self.origin - '0 0 8';
	
	particle(cu_org + '-12 12 12', '-24 24 24', 73, 24);
	particle(cu_org + '12 12 12',  '24 24 24', 73, 24);
	particle(cu_org + '-12 -12 12', '-24 -24 24', 73, 24);
	particle(cu_org + '12 -12 12', '24 -24 24', 73, 24);
	particle(cu_org + '-12 12 -12', '-24 24 -24', 73, 24);
	particle(cu_org + '12 12 -12', '24 24 -24', 73, 24);
	particle(cu_org + '-12 -12 -12', '-24 -24 -24', 73, 24);
	particle(cu_org + '12 -12 -12', '24 -24 -24', 73, 24);
	
	sound (self, cu_CHAN_VOICE, "player/tornoff2.wav", 1, cu_ATTN_NORM);
	
	cu_fish_throwgib();
	cu_fish_throwgib();
	cu_fish_throwgib();
	
	remove(self);
}

void() cu_fish_die =
{
	self.solid = cu_SOLID_NOT;
	
	// just spray a bunch of blood and bubbles
	if (self.health < -30)
	{
		self.think = cu_fish_gib;
		self.nextthink = time;
		return;
	}
	
	sound (self, cu_CHAN_VOICE, "fish/death.wav", 1, cu_ATTN_NORM);
	cu_f_death1();
}

// fish need their own checkattack because CheckClearAttack() considers the
// attack not to be clear if the sight line crosses a liquid boundary, which
// can happen if the player is treading water with fish around his feet (thx 4LT)
float() cu_fish_check_attack =
{
	if (self.enemy.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO) || self.enemy.deadflag == cu_DEAD_SPECTATING)
		return cu_FALSE;
	
	if (pointcontents(self.origin) == cu_CONTENT_EMPTY)	// airfish
	{
		if (self.enemy.waterlevel >= cu_WL_EYES) return cu_FALSE;	// enemy is in a liquid and i'm not
	}
	else	// seafish
	{
		if (self.enemy.waterlevel <= cu_WL_FEET) return cu_FALSE;	// enemy is out of liquid
	}
	
	//if (fish_checkdash())
	//{
	//	f_dash();
	//	return TRUE;
	//}
	
	if (cu_enemy_range > cu_RANGE_MELEE) return cu_FALSE;
	vector cu_tgt = self.enemy.origin - self.origin;
	cu_tgt_z *= 0.75;	// fish can bite from above or below
	
	if (vlen((cu_tgt)) > 60) return cu_FALSE;
	
	// have to call melee directly because ai_run() won't catch AS_MELEE
	self.cu_th_melee();
	return cu_TRUE;
}

void() cu_monster_fish_spawn =
{
	self.classname = "monster_fish";
		
	self.solid = cu_SOLID_SLIDEBOX;
	//self.movetype = MOVETYPE_STEP;

	setmodel (self, "progs/fish.mdl");

	setsize (self, '-16 -16 -16', '16 16 16');
	//setsize (self, VEC_HULL_MIN, VEC_HULL_MAX);
	self.health = 35;
	self.cu_customflags |= cu_CFL_MELEEONLY;
	
	self.cu_th_stand = cu_f_stand1;
	self.cu_th_walk = cu_f_walk1;
	self.cu_th_run = cu_f_run1;
	self.cu_th_die = cu_fish_die;
	self.cu_th_pain = cu_fish_pain;
	self.cu_th_melee = cu_f_attack;
	//self.th_missile = f_dash;
	self.cu_th_checkattack = cu_fish_check_attack;

	if (self.deathtype == cu_string_null)
	{
		if (cu_skill == 3 && random() < 0.5)
			self.deathtype = "died from fish damage";
		else
			self.deathtype = "was fed to the Rotfish";
	}

	cu_nmspeed(0.055); // look at 'em go

	cu_swimmonster_start ();
}

void() cu_monster_fish_spawner = {cu_mon_spawner_use(cu_monster_fish_spawn);}


/*cu:QUAKED monster_fish (1 0 0) (-16 -16 -16) (16 16 16) AMBUSH ? ? ? TRIGGERED NOTFOG NOTELEFRAG INSTAWAKE
Rotfish, 35 health points.

Flags:
"ambush" only wake up on seeing the player, not another monster getting angry
"Triggered"	will not spawn until triggered - triggering again will wake him up. Set 'count' to make this a multi-use spawner.
"NoTfog" 	supress teleport glitter when spawned with 'triggered'
"NoTelefrag" will silently fail to spawn if doing so would telefrag an existing monster. will try again automatically 2x/second until it succeeds.
"Instawake" spawn angry at activator

Keys:
"target" entity to trigger when killed
"targetname" entity name
*/
/*FGD
@PointClass base(Monster) size(-16 -16 -16, 16 16 16) model({ "path": ":progs/fish.mdl" }) = monster_fish : "Rotfish" []
*/
void() cu_monster_fish =
{
	if (!cu_SUB_ShouldSpawn()) return;
	if (cu_nomonster()) return;
	if (deathmatch)
	{
		remove(self);
		return;
	}
	precache_model2 ("progs/fish.mdl");
	precache_model ("progs/zom_gib.mdl");
	precache_sound2 ("fish/death.wav");
	precache_sound2 ("fish/bite.wav");
	precache_sound2 ("fish/idle.wav");

	self.health = 35;
	setsize (self, '-16 -16 -16', '16 16 16');
	setorigin(self,self.origin - '0 0 8');
	//setsize (self, VEC_HULL_MIN, VEC_HULL_MAX);
	if ( cu_monster_spawnsetup( cu_monster_fish_spawner ) ) return;
	cu_addmonster(1);
	cu_monster_fish_spawn();
}
