void() cu_fish_melee =
{
	float cu_ldmg;

	if (!self.enemy || !cu_alive(self.enemy))
		return;		// removed before stroke
	
	if (vlen(self.enemy.origin - self.origin) > 60)
	{
		self.think = cu_f_run1;
		cu_ai_attack_finished(1);
		return;
	}
		
	sound (self, cu_CHAN_VOICE, "fish/bite.wav", 1, cu_ATTN_NORM);
	cu_ldmg = 6 + random() * 6;
	cu_T_Damage (self.enemy, self, self, cu_ldmg, cu_DMGTYPE_MELEE);
	
	// rob the player of air
	//if (skill == 3 && !has_biosuit(self.enemy))
	//	self.enemy.air_finished = min(self.enemy.air_finished, time);
}


float() cu_fish_checkdash =
{
	if (cu_skill != 3)
		return cu_FALSE;
	if (cu_enemy_range != cu_RANGE_NEAR || !cu_infront(self.enemy))
		return cu_FALSE;
	if (random() < 0.3)
		return cu_FALSE;
	return cu_TRUE;
}

void() cu_fish_checkcontinuedash =
{
	if (vlen(self.origin - self.enemy.origin) < 60)
	{
		if(cu_infront(self.enemy))
			cu_f_attack3();
		else
			cu_f_run1();
		return;
	}
	if (!cu_ai_fishmovecheck() || self.velocity != self.cu_oldvelocity)
	{
		cu_f_run1();
		return;
	}
}

void() cu_f_dash =
{
	cu_ai_face();
	cu_ai_face();

	self.velocity = normalize(cu_enemy_vispos() - self.origin) * 300;
	self.cu_oldvelocity = self.velocity;
	cu_f_dash1();
}

void() cu_f_dash1 =[	$swim1, cu_f_dash2 ] {
	//ai_rush(20);
	if (random() < 0.1)
		sound (self, cu_CHAN_VOICE, "fish/idle.wav", 1, cu_ATTN_NORM);
}
void() cu_f_dash2 =[	$swim3, cu_f_dash3 ] {cu_fish_checkcontinuedash();}
