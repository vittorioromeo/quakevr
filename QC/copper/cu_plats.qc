@baseclass = TrainSounds [
	sounds(choices) : "Sound" : 1 =
	[
		0: "Silent/Override"
		1: "Ratchet Metal"
		2: "Base Lift"
	]
]
@baseclass base(Appearflags, Targetname, TrainSounds, Func, AltTarget) = Train [
	speed(integer) : "Speed (units per second)" : 100
	target(target_source) : "Target to start at"
	dmg(integer) : "Damage on block" : 2
	noise(string) : "Override stop sound"
	noise1(string) : "Override move sound"
	pausetime(string) : "Default wait time" : "0.1"
]
*/

void() cu_flytrain_ghost_die =
{
	if (self.owner.cu_th_melee)
		cu_SUB_CallAsSelf(self.owner.cu_th_melee, self.owner);
	else
		remove(self.owner);
	remove(self);
}

void() cu_flytrain_ghost_resume =
{
	if (self.state == cu_STATE_OFF)	// already deactivated
		return;	
	if (self.pos2)
		// we were stopped along a bezier curve, resume with saved values
		cu_SUB_CalcMoveCurveSeg();
	else
		cu_SUB_CalcMove (self.enemy.origin - self.movedir, self.speed, self.cu_th_stand);
}

void() cu_flytrain_ghost_blocked =
{
	if (self.state == cu_STATE_OFF)	// already deactivated
		return;	
	self.velocity = cu_VEC_ORIGIN;
	self.think = cu_flytrain_ghost_resume;
	self.nextthink = cu_localtime(self) + 0.05;
}

// if the flytrain is blocked, it has to halt its buddy's movement and schedule it to restart immediately
void() cu_flytrain_blocked =
{
	if (self.cu_buddy.state == cu_STATE_ON)
		cu_SUB_CallAsSelf(cu_flytrain_ghost_blocked, self.cu_buddy);

	if (time < self.cu_attack_finished)
		return;
	self.cu_attack_finished = time + self.cu_dmgtime;
	cu_T_Damage (other, self, self, self.dmg, cu_DMGTYPE_CRUSH);
}

void() cu_flytrain_killed =
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	cu_activator = cu_damage_attacker;
	self.health = self.max_health;
	cu_SUB_CallAsSelf(cu_train_use, self.cu_buddy);
}

void() cu_flytrain_think =
{
	vector cu_ang, cu_delta, cu_wishvel;
	float cu_d, cu_t;
	
	self.takedamage = self.cu_buddy.takedamage;
	
	// if the ghost train hits a speed -1 teleport corner we have to teleport with it, not zoom to it
	if (self.cu_buddy.teleport_time)
	{
		self.cu_buddy.teleport_time = 0;
		setorigin(self, self.cu_buddy.origin - self.movedir);
		self.velocity = self.cu_buddy.velocity;
	}
	else
	{
		// rosette movement looks more orbital than the original bounce of random offsets
		cu_t = cu_localtime(self) + self.lip;
		cu_ang_y = (cu_sin(self.dest_x * cu_t) + cu_cos(self.dest_y * cu_t)) * 90 + cu_t;
		cu_d = cu_cos(cu_t * self.dest_z);
		cu_ang_z = cu_d * 180;
		makevectors(cu_ang);
		
		self.pos1 = v_forward * self.cu_width * cu_d;
		self.pos1_z = v_right_z * self.height;
		
		cu_delta = (self.cu_buddy.origin + self.pos1) - self.origin - self.movedir;
		cu_wishvel = self.cu_buddy.velocity + cu_delta;
		self.velocity = (self.velocity * 4 + cu_wishvel) * 0.2;
	}
	
	self.nextthink = cu_localtime(self) + 0.05;
}

void() cu_flytrain_init =
{
	setorigin (self, self.cu_buddy.origin - self.movedir);
	self.think = cu_flytrain_think;
	cu_flytrain_think();
}

void() cu_flytrain_setup =
{
	// spawn a nonsolid point ent to follow our path sensibly and 
	//	handle all train-like logic, bc it's a func_train
	// we shadow it at all times with floaty drifty movement to keep 
	//	that logic separate from train behavior and allow us to sludge
	//	the velocity over a few frames for rubber-bandy motion without
	//	colliding with state changes
	self.cu_buddy = spawn();
	self.cu_buddy.spawnflags = self.spawnflags | cu_TRAIN_INHERIT | cu_TRAIN_SMOOTHSPEED; // flytrains always inherit speed
	self.cu_buddy.speed = self.speed;
	self.dmg = cu_zeroconvertdefault(self.dmg, 2);
	if (!self.cu_dmgtime)
		self.cu_dmgtime = 0.5;
	self.cu_buddy.pausetime = self.pausetime;
	self.cu_buddy.health = self.health;
	self.cu_buddy.sounds = self.sounds;
	self.cu_buddy.solid = -1;
	if (!self.target)
	{
		cu_dprint3("flytrain without a target at ", vtos(self.origin + self.movedir), " will hover in place\n");
		self.cu_buddy.enemy = spawn();
		setorigin(self.cu_buddy.enemy, self.origin + self.movedir);
		self.cu_buddy.enemy.classname = "path_corner";
		self.cu_buddy.enemy.wait = -1;		
	}
	cu_SUB_CopyTargets(self.cu_buddy);
	self.cu_buddy.targetname = self.targetname;
	self.cu_buddy.owner = self;
	
	cu_SUB_CallAsSelf(cu_func_train_point, self.cu_buddy);
	self.cu_buddy.classname = "func_flytrain_ghost";
	self.cu_buddy.cu_th_stand = cu_train_wait;
	self.cu_buddy.cu_th_melee = cu_flytrain_ghost_die;
	
	self.cu_width = cu_zeroconvertdefault(self.cu_width, 8);
	self.height = cu_zeroconvertdefault(self.height, 8);
	self.max_health = 0;

	self.blocked = cu_flytrain_blocked;
	self.solid = cu_zeroconvertdefault(self.solid, cu_SOLID_BSP);
	if (!self.solid)
		self.movetype = cu_MOVETYPE_NOCLIP;
	else
	{
		self.movetype = cu_MOVETYPE_PUSH;
		if (self.health)
		{
			self.max_health = self.health;
			self.cu_th_die = cu_flytrain_killed;
			self.takedamage = cu_DAMAGE_YES;
		}
	}
	
	self.dest_x = 3 + random();
	self.dest_y = 1 + random();
	self.dest_z = 4 + random();
	if (self.speed2 <= 0) self.speed2 = 10;
	self.dest *= self.speed2;
	self.lip = random() * 20;
	
	self.think = cu_flytrain_init;	// wait for buddy to call train_find
	self.nextthink = cu_localtime(self) + 0.25; // magic amount of time :|
}

/*cu:QUAKED func_flytrain (0 .5 .8) ? - TOGGLE
Acts as a func_train with PATH_SPEED and SMOOTH_SPEED set, with additional random motion and and gentle smoothing at stops, starts, and hard corners.

"width"		Horizontal drift range, default 8 (-1 for 0)
"height"	Vertical drift range, default 8 (-1 for 0)
"lip"		Length of 'leash', default 64 (increase if train jumps around at high speeds)
"sounds"
0) none, or, set your own with 'noise' (stop sound) and 'noise1' (move sound)
1) ratchet metal
2) base plat

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination
*/
/*FGD
@baseclass base(Train) = Flytrain [
	width(string) : "Horizontal drift range" : "8"
	height(string) : "Vertical drift range" : "8"
]
@SolidClass base(Flytrain) = func_flytrain : 
"Acts as a func_train with PATH_SPEED and SMOOTH_SPEED set, with additional random motion and and gentle smoothing at stops, starts, and hard corners. Will fire all targets of a pathcorner on arrival, but does not normally fire its own targets.

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination"
[
	width(string) : "Horizontal drift range" : "8"
	height(string) : "Vertical drift range" : "8"
]
*/
void() cu_func_flytrain =
{
	if (!cu_SUB_ShouldSpawn()) return;
	dprint("in flytrain\n");
	
	cu_precache_model_safe(self.model);
	setmodel (self, self.model);
	setsize (self, self.mins , self.maxs);
	self.movedir = (self.mins + self.maxs) * 0.5;
	
	cu_flytrain_setup();
}

/*cu:QUAKED func_flytrain_point (0 .5 .8) (-8 -8 -8) (8 8 8) - TOGGLE
Acts as a func_train with PATH_SPEED and SMOOTH_SPEED set, with additional random motion and and gentle smoothing at stops, starts, and hard corners.

"model"		model to use
"width"		Horizontal drift range, default 8 (-1 for 0)
"height"	Vertical drift range, default 8 (-1 for 0)
"lip"		Length of 'leash', default 64 (increase if train jumps around at high speeds)
"sounds"
0) none, or, set your own with 'noise' (stop sound) and 'noise1' (move sound)
1) ratchet metal
2) base plat

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination
*/
/*FGD
@PointClass base(Flytrain, CustomModel) size(16 16 16) = func_flytrain_point : 
"Acts as a func_train with PATH_SPEED and SMOOTH_SPEED set, with additional random motion and and gentle smoothing at stops, starts, and hard corners. Will fire all targets of a pathcorner on arrival, but does not normally fire its own targets.

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination" 
[]
*/
void() cu_func_flytrain_point =
{	
	if (!cu_SUB_ShouldSpawn()) return;

	cu_precache_model_safe(self.model);
	setmodel (self, self.model);
	setsize (self, self.mins , self.maxs);
	self.classname = "func_flytrain";
	self.movedir = '0 0 0';
	
	cu_flytrain_setup();
}

//============================================================================

void() cu_train_blocked =
{
	VR_CU_ShaftBlocked(other); // QVR: lift shafts kept clear (vr_copper_bridge.qc)
	if (time < self.cu_attack_finished)
		return;
	self.cu_attack_finished = time + self.cu_dmgtime;
	cu_T_Damage (other, self, self, self.dmg, cu_DMGTYPE_CRUSH);
}

void() cu_train_killed =
{
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	cu_activator = cu_damage_attacker;
	self.health = self.max_health;
	cu_train_use();
}

void(float cu_unlock) cu_train_lock =
{
	if (cu_unlock)
	{
		self.cu_customflags = cu_not(self.cu_customflags, cu_CFL_LOCKED);
		if (self.max_health)
		{
			self.health = self.max_health;
			self.takedamage = cu_DAMAGE_YES;
		}
	}
	else
	{
		self.cu_customflags |= cu_CFL_LOCKED;
		self.takedamage = cu_DAMAGE_NO;
	}
}

void() cu_train_off =
{
	self.state = cu_STATE_OFF;
	if (self.cu_customflags & cu_CFL_LOCKED) return;
	if (self.max_health)
	{
		self.health = self.max_health;
		self.takedamage = cu_DAMAGE_YES;
	}
}
void() cu_train_on =
{
	self.state = cu_STATE_ON;
	if (self.max_health && !(self.spawnflags & cu_TRAIN_TOGGLE))
		self.takedamage = cu_DAMAGE_NO;
}

void() cu_train_use =
{
	self.aiment = cu_activator;	// .enemy is used so we store activating player here
	if ((self.spawnflags & cu_TRAIN_TOGGLE) && (self.origin + self.movedir) != self.enemy.origin)
	{
		if (self.state == cu_STATE_ON)
		{
			cu_train_off();
			self.velocity = cu_VEC_ORIGIN;
			self.nextthink = 0;
			sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
		}
		else
		{
			cu_train_on();
			sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
			if (self.pos2)
				// we were stopped along a bezier curve, resume with saved values
				cu_SUB_CalcMoveCurveSeg();
			else
				cu_SUB_CalcMove (self.enemy.origin - self.movedir, self.speed, self.cu_th_stand);
		}
		return;
	}

	if (self.state == cu_STATE_ON)	// already activated
		return;	
	cu_train_next();
}

void() cu_train_wait =	// arrival at a pathcorner
{
	entity cu_corner = self.enemy;
	if (cu_corner.wait)
		self.wait = cu_corner.wait;
	else
		self.wait = self.pausetime;
	
	// if a player is riding the train, treat them as activator
	cu_activator = self.aiment;
	if (cu_activator.classname != "player")
	{
		cu_activator = cu_get_closest_client();
		self.aiment = cu_activator;
	}
	cu_SUB_UseTargetsAlt(cu_target2);

	if (self.wait == -1)
	{
		cu_train_off();
		self.use = cu_train_use;
		sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
	}
	else if (self.wait > 0)
	{
		cu_train_off();	// allow triggering while waiting
		self.think = cu_train_next;
		self.nextthink = cu_localtime(self) + self.wait;
		if (self.wait > 0.1)
			sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
	}
	else 	// self.wait is 0 or a garbage value
	{
		cu_train_next();
	}
	
	// fire pathcorners' targets on arrival
	cu_SUB_UseEntTargets(cu_corner);
	// fire them after sorting corner wait stuff, in case the corner triggers
	// the train itself (useful for wait-locking a pathcorner with a relay)
}

void() cu_train_next =	// departure for next pathcorner
{
	entity cu_corner, cu_ctrl;
	float cu_dspeed, cu_segs;
	cu_corner = cu_findunlockedtarget(self.enemy, world);
	if (!cu_corner)
	{
		dprint("train_next: no next target\n");
		// .th_melee is a train's "expire at end of path" function, because .th_die
		// has to be reserved for shootable trains to work with T_Damage()/Killed()
		if (self.cu_th_melee)
			self.cu_th_melee();
		else
			remove(self);
		cu_SUB_UseTargetsAlt(cu_target4);
		return;
	}
	self.cu_oldenemy = self.enemy;
	if (cu_corner.spawnflags & 16)
	{
		cu_ctrl = cu_corner;
		cu_corner = cu_findunlockedtarget(cu_ctrl, world);
		if (!cu_corner)
		{
			dprint("train_next: no next target after curve point\n");
			if (self.cu_th_melee)
				self.cu_th_melee();
			else
				remove(self);
			cu_SUB_UseTargetsAlt(cu_target4);
			return;
		}
	}
	
	self.enemy = cu_corner;
	cu_SUB_UseTargetsAlt(cu_target3);
	cu_train_on();
	
	if (self.cu_oldenemy.speed == -1)
	{
		setorigin(self, cu_corner.origin - self.movedir);
		self.teleport_time = time;
		self.cu_th_stand();
		return;
	}
	else if (self.cu_oldenemy.speed > 0 && self.spawnflags & cu_TRAIN_INHERIT)
		self.speed = self.cu_oldenemy.speed;

	sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
	
	if (cu_ctrl)
	{
		if ((self.spawnflags & cu_TRAIN_INHERIT) && (self.spawnflags & cu_TRAIN_SMOOTHSPEED) && cu_corner.speed > 0)
			cu_dspeed = cu_corner.speed;
		else
			cu_dspeed = self.speed;
		
		if (cu_ctrl.count)
			cu_segs = cu_ctrl.count;
		else
			// chop the curve into roughly 166ms segments
			cu_segs = ceil(6 * cu_bez_lenApprox(self.origin + self.movedir, cu_ctrl.origin, cu_corner.origin) / ((self.speed + cu_dspeed) / 2));

		cu_SUB_CalcMoveCurve(cu_corner.origin - self.movedir, cu_ctrl.origin - self.movedir, cu_segs, self.speed, cu_dspeed, self.cu_th_stand);
		return;
	}
	
	if ((self.spawnflags & cu_TRAIN_INHERIT) && (self.spawnflags & cu_TRAIN_SMOOTHSPEED) && self.enemy.speed > 0)
	{
		// 'curved' motion in a straight line, for the speed stepping
		vector cu_travel = (cu_corner.origin - self.movedir) - self.origin;
		cu_segs = cu_max( 2, floor( vlen(cu_travel) / 64 ) );	// pick an intelligent segment count
		cu_SUB_CalcMoveCurve(cu_corner.origin - self.movedir, self.origin + cu_travel * 0.5, cu_segs, self.speed, self.enemy.speed, self.cu_th_stand);
	}
	else
		cu_SUB_CalcMove (cu_corner.origin - self.movedir, self.speed, self.cu_th_stand);
}

void() cu_func_train_find =
{
	if (!self.enemy)
		self.enemy = cu_findunlockedtarget(self, world);

	//self.target = self.enemy.target;
	setorigin (self, self.enemy.origin - self.movedir);
	if ((self.spawnflags & cu_TRAIN_INHERIT) && self.enemy.speed > 0)
		self.speed = self.enemy.speed;
	if (self.targetname == cu_string_null)
	{	// not triggered, so start immediately
		cu_train_wait();	// still go through wait in case we start at a wait -1 corner
	}
}

void() cu_func_train_setup =
{
	if (!self.speed)
		self.speed = 100;
	if (!self.target && !self.enemy)
		objerror("func_train without a target");
	
	self.dmg = cu_zeroconvertdefault(self.dmg, 2);
	if (!self.cu_dmgtime)
		self.cu_dmgtime = 0.5;
	self.pausetime = cu_zeroconvertdefault(self.pausetime, 0.1);
	self.wait = 0;	// this is american mcgee's fault

	cu_train_sounds();

//	self.cnt = 1;
	self.solid = cu_zeroconvertdefault(self.solid, cu_SOLID_BSP);
	if (!self.solid)
		self.movetype = cu_MOVETYPE_NOCLIP;
	else
		self.movetype = cu_MOVETYPE_PUSH;
	self.blocked = cu_train_blocked;
	self.use = cu_train_use;
	self.cu_lock = cu_train_lock;
	self.classname = "train";
	
	self.max_health = 0;
	if (self.health)
	{
		self.max_health = self.health;
		self.cu_th_die = cu_train_killed;
		self.takedamage = cu_DAMAGE_YES;
	}
	cu_train_off();

	// start trains on the second frame, to make sure their targets have had
	// a chance to spawn
	self.think = cu_func_train_find;
	self.nextthink = cu_localtime(self) + 0.1;
}

/*cu:QUAKED func_train (0 .5 .8) ? PATH_SPEED TOGGLE SMOOTHSPEED
Trains are moving platforms that players can ride. Its origin is the min corner of the train. 
The train spawns at the first target it is pointing at. If the train is the target of a button or trigger, it will not begin moving until activated.
A train will fire all targets of a pathcorner on arrival.

Keys:
"speed"	default 100
"dmg"	default	2
"sounds"
	0) none, or, set your own with 'noise' (stop sound) and 'noise1' (move sound)
	1) ratchet metal
	2) base plat
"pausetime"	pausetime at a pathcorner that doesn't specify a wait, default 0.1, -1 for continuous motion
"health" allow the train to be shot to trigger it whenever it could normally be triggered (toggle spawnflag applies)

Spawnflags:
PATH_SPEED: train will inherit 'speed' value from path_corners as it reaches them
If a path_corner's speed is -1, the func_train's move when LEAVING that corner will be to snap instantly to the next corner.
TOGGLE: allow starting/stopping motion anywhere on its path (default is to ignore triggerings when in motion)
SMOOTH_SPEED: if PATH_SPEED, train will smoothly blend to its destination's 'speed' as it travels to it

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination
*/
/*FGD
@SolidClass base(Train) = func_train : "Moving platform that players can ride. 
Its origin is the min corner of the train. 
The train spawns at the first target it is pointing at. If the train is the target of a button or trigger, it will not begin moving until activated.
Will fire all targets of a pathcorner on arrival, but does not normally fire its own targets.


If 'Speed from path' is set, the train will inherit the 'speed' value from path_corners as it reaches them. If 'blend speed smoothly' is also set, the train will instead smoothly blend to its destination's 'speed' as it travels to it.
If a path_corner's speed is -1, the func_train's move when LEAVING that corner will be to snap instantly to the next corner.
The 'Toggle' spawnflag allows starting and stopping the motion anywhere on the train's path (default is to ignore triggerings when in motion).
Setting 'health' will allow the train to be shot to trigger it whenever it could normally be triggered (toggle spawnflag applies). 

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination"
[
	spawnflags(Flags) = [
		1 : "Speed from path" : 0
		2 : "Toggle" : 0
		4 : "Blend speed smoothly" : 0
	]
	health(integer) : "Health (shootable if > 0)"
]
*/
void() cu_func_train =
{	
	if (!cu_SUB_ShouldSpawn()) return;
	cu_func_train_setup();
	
	self.cu_th_stand = cu_train_wait;
	
	cu_precache_model_safe(self.model);
	setmodel (self, self.model);
	setsize (self, self.mins , self.maxs);
	setorigin (self, self.origin);
	self.movedir = self.mins;
}

/*cu:QUAKED func_train_point (0 .5 .8) (-8 -8 -8) (8 8 8) PATH_SPEED
Trains are moving platforms that players can ride.
The targets origin specifies the min point of the train at each corner. The train spawns at the first target it is pointing at.
If the train is the target of a button or trigger, it will not begin moving until activated.
A train will fire all targets of a pathcorner on arrival.
Keys:
"model" model to use
"speed"	default 100
"dmg"	default	2
"sounds"
	0) none, or, set your own with 'noise' (stop sound) and 'noise1' (move sound)
	1) ratchet metal
	2) base plat
"pausetime"	pausetime at a pathcorner that doesn't specify a wait, default 0.1, -1 for continuous motion

Spawnflags:
PATH_SPEED: train will inherit 'speed' value from path_corners as it reaches them

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination
*/
/*FGD
@PointClass base(Train, CustomModel) = func_train_point : "Moving platform that players can ride. 
The point entity is the origin, even if a model is specified.
The train spawns at the first target it is pointing at. If the train is the target of a button or trigger, it will not begin moving until activated.
Will fire all targets of a pathcorner on arrival, but does not normally fire its own targets.

If 'Speed from path' is set, the train will inherit the 'speed' value from path_corners as it reaches them. If 'blend speed smoothly' is also set, the train will instead smoothly blend to its destination's 'speed' as it travels to it.
If a path_corner's speed is -1, the func_train's move when LEAVING that corner will be to snap instantly to the next corner.
The 'Toggle' spawnflag allows starting and stopping the motion anywhere on the train's path (default is to ignore triggerings when in motion).

Alt Target Pattern: 'target' selects path start, 'target2' on each pathcorner arrival, 'target3' on each departure, 'target4' on termination"
[
	spawnflags(Flags) = [
		1 : "Speed from path" : 0
		2 : "Toggle" : 0
		4 : "Blend speed smoothly" : 0
	]
]
*/
void() cu_func_train_point =
{	
	if (!cu_SUB_ShouldSpawn()) return;
	cu_func_train_setup();
	
	self.cu_th_stand = cu_train_wait;
	
	cu_precache_model_safe(self.model);
	setmodel (self, self.model);
	setsize (self, self.mins, self.maxs);
	setorigin (self, self.origin);
	self.movedir = cu_VEC_ORIGIN;
}

// =======================================

/*
	FUNC_BOBBING

a lot has been done here to never ever rely on values that are repeatedly summed
over time, as floating point error will cause gradual drift.

usually, movers use self.ltime so that time doesn't advance for them while they're
blocked, preventing SUB_CalcMove from being shifted off the end of its motion and
screwing up doors. we don't do that here, because accumulated time error in .ltime  
will cause bobbings to slowly slide out of phase with each other and not keep good 
time. if the mapper sets an oscillation period of 5.0 seconds, the mover damn sure
better oscillate once every exactly 5 seconds, not '5-ish'.

engine structure requires that mover thinks be scheduled using .ltime because that's
what it compares a MOVETYPE_PUSH's nextthink against, but we can use global time for
actual positioning/velocity. it requires some particular gymnastics in the .blocked()
function, but the result is precise and seamless.

.wait: wavelength in seconds
.delay: current phase offset (0-1)
.search_time: origin point in time of the cosine wave. whenever we save it, we shift
	it backwards by the current .delay * .wait
.length: think rate, usually 0.1 but can be lower on hyperactive bobbers
*/

const float cu_SFLAG_BOB_CRUSHER = 2;
const float cu_SFLAG_BOB_STOPLOW = 4;
const float cu_SFLAG_BOB_STOPMID = 8;
const float cu_SFLAG_BOB_STOPHI = 16;
const float cu_SFLAG_BOB_STOP = 4+8+16;

void() cu_func_bobbing_blocked = 
{
	cu_T_Damage (other, self, self, self.dmg, cu_DMGTYPE_CRUSH);
	
	if (self.spawnflags & cu_SFLAG_BOB_CRUSHER)	// don't reverse
		return;
	
	// reversing direction entails reversing the phase
	self.delay = (self.delay * -1) + 1 + (self.cu_length / self.wait);
	// put it one think in the future too
	
	// set new starting conditions to reanchor the reverse movement at
	// the moment of contact
	self.cu_search_time = time - self.delay * self.wait - self.cu_length;
	// subtracting .length puts the reversed wave one more think in the past.
	// if we don't we'll get a frame of 0 movement
	
	// start new movement now or we'll be a CRUSHER anyway
	cu_func_bobbing_think();
}

void() cu_func_bobbing_use = 
{
	self.think = cu_func_bobbing_think;
	
	if (self.state == 2)	// a future stop was requested but we never reached it
		self.state = 1;		// go back to being plain old 'on'
	else
		self.state = !self.state;
	
	if (self.state)	// start immediately
	{
		self.cu_search_time = time - self.delay * self.wait;
		sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);	// move
		self.think();
		return;
	}
	
	if (self.spawnflags & cu_SFLAG_BOB_STOP)	// stop at an apex, not immediately
	{
		self.state = 2;
		return;
	}
	
	// stop immediately
	sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);	// cut off move sound with stop sound
	self.nextthink = 0;
}

vector(float cu_phase) cu_func_bobbing_pos =
{
	vector cu_pos;
	float cu_cosD;
	
	cu_cosD = (1 - cu_cos(360 * cu_phase)) / 2;	// flip -1/1 and scale to 0-1
	cu_pos = self.pos1 + (cu_cosD * (self.pos2 - self.pos1));
	return cu_pos;
}

void() cu_func_bobbing_think =
{
	if (!self.state)
	{
		self.velocity = cu_VEC_ORIGIN;
		return;
	}

	vector cu_dst;
	float cu_phase;
	float cu_atLow, cu_atHigh, cu_stop;
	
	// always derive current phase from a fixed starting time rather than
	// summing an offset every think, or we'll accumulate error and drift
	cu_phase = ((time - self.cu_search_time) / self.wait) % 1;
	if (cu_phase < self.delay)
		cu_phase += 1;	// don't wrap yet
	
	cu_atLow = (self.delay < 0.5 && cu_phase >= 0.5);
	cu_atHigh = (self.delay < 1 && cu_phase >= 1);
	
	if (self.state == 2) // stop at our earliest convenience
	{
		if (cu_atLow && (self.spawnflags & cu_SFLAG_BOB_STOPLOW))
		{
			cu_phase = 0.5;
			cu_stop = cu_TRUE;
		}
		else if (cu_atHigh && (self.spawnflags & cu_SFLAG_BOB_STOPHI))
		{
			cu_phase = 0;
			cu_stop = cu_TRUE;
		}
		else if (self.spawnflags & cu_SFLAG_BOB_STOPMID)
		{
			if (self.delay < 0.25 && cu_phase >= 0.25)
			{
				cu_phase = 0.25;
				cu_stop = cu_TRUE;
			}
			else if (self.delay < 0.75 && cu_phase >= 0.75)
			{
				cu_phase = 0.75;
				cu_stop = cu_TRUE;
			}		
		}
	}	
	else if ( cu_atLow || cu_atHigh )
	{
		// when we pass either apex, repeat the noises
		sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);	// move
		sound (self, cu_CHAN_BODY, self.noise, 1, cu_ATTN_NORM);	// stop
	}
	
	if (cu_stop)
	{
		self.state = 0;
		sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);	// cut off move sound with stop sound
	}
	
	self.delay = cu_phase;
	if (self.delay > 1)	// now we can wrap
		self.delay -= 1;
	
	// whither are we going
	cu_dst = cu_func_bobbing_pos(cu_phase);
	
	self.velocity = (cu_dst - self.origin) / self.cu_length;
	self.nextthink = self.ltime + self.cu_length;
}

/*cu:QUAKED func_bobbing (0 .5 .8) ? START_OFF CRUSHER STOP_LOW STOP_MID STOP_HIGH - - START_INVIS
Bobbing platform. Moves in a smooth sine wave. Build at the center of motion, specify 'wait' for the wavelength in seconds and 'distance' for the amplitude (distance from end to end) in units.
Trigger to freeze/reactivate.

"angle" set bob axis
"distance" total distance of bob, will move half this far in either direction
"pos1"/"pos2" ignore angle/distance and set apex offsets directly
"wait" wavelength of bob in seconds
"delay" phase offset to start at (0 = pos1, 0.5 = pos2, 1.0 = back at pos1 again)
"sounds"
0) none, or, set your own with 'noise' (stop sound) and 'noise1' (move sound)
1) ratchet metal
2) base plat

Spawnflags
START_OFF	start off
CRUSHER		don't reverse when blocked
STOP_*		when triggered off, keep oscillating until reaching the low/high/midpoint and stop there. checking more than one adds eligible stopping places, and the bobber will stop at the first one reached.
*/
/*FGD
@baseclass base(Appearflags, Targetname, TrainSounds, Angle, Func, FuncInvis) = Bob
[
	spawnflags(flags) = [
		1 : "Start off" : 0
		2 : "Crusher (no reverse)" : 0
		4 : "Don't stop until low pos" : 0
		8 : "Don't stop until mid pos" : 0
		16 : "Don't stop until high pos" : 0
	]
	wait(string) : "Period (Wavelength)" : "4"
	distance(integer) : "Length (Amplitude)" : 64
	delay(string) : "Starting offset (0-1) (Phase)" : "0.0"
	dmg(integer) : "Damage when blocked" : 2
	noise(string) : "Override stop sound"
	noise1(string) : "Override move sound"
	pos1(string) : "Override peak position (relative)"
	pos2(string) : "Override trough position (relative)"
]
@SolidClass base(Bob) = func_bobbing : "Bobbing platform.
Moves in a smooth sine wave. Build at the center of motion, specify 'wait' for the wavelength in seconds and 'distance' for the amplitude (distance from end to end) in units. Use 'delay' to set a phase offset (0-1).
Trigger to freeze in place or reactivate. If any 'don't stop until' spawnflags are checked, the bobber will keep oscillating until it reaches one of the designated positions and stop there.

Set both 'pos1' & 'pos2' to override the two apex positions (ends of the bob) to build and light your plat wherever."  []
*/
void() cu_func_bobbing =
{
	if (!cu_SUB_ShouldSpawn()) return;
	
	cu_precache_model_safe(self.model);
	cu_train_sounds();

	cu_SetMovedir();
	if (!self.distance)
		self.distance = 64;
	if (self.wait <= 0)
		self.wait = 4;
	
	self.dmg = cu_zeroconvertdefault(self.dmg, 2);
	
	if (!self.pos1 && !self.pos2)
	{
		self.pos1 = self.origin + self.distance * 0.5 * self.movedir;
		self.pos2 = self.origin - self.distance * 0.5 * self.movedir;
	}
	self.cu_length = cu_min(0.1, self.wait / 6);

	if (self.spawnflags & 128)
		self.use = cu_func_bobbing_spawn;
	else
		cu_func_bobbing_spawn();
}

void() cu_func_bobbing_spawn =
{
	if (!(self.spawnflags & cu_START_OFF))
	{
		self.think = cu_func_bobbing_use;
		self.nextthink = 0.3;	// wait for items and monsters to rest on it
	}
	
	self.use = cu_func_bobbing_use;
	self.blocked = cu_func_bobbing_blocked;
	
	self.solid = cu_zeroconvertdefault(self.solid, cu_SOLID_BSP);
	if (!self.solid)
		self.movetype = cu_MOVETYPE_NOCLIP;
	else
		self.movetype = cu_MOVETYPE_PUSH;

	setmodel (self, self.model);
	setsize (self, self.mins, self.maxs);
	setorigin (self, cu_func_bobbing_pos(self.delay));
}


/*cu:QUAKED func_bobbing_point (0 .5 .8) (-8 -8 -8) (8 8 8) START_OFF CRUSHER STOP_LOW STOP_MID STOP_HIGH - - START_INVIS
Bobbing platform. Moves in a smooth sine wave. Build at the center of motion, specify 'wait' for the wavelength in seconds and 'distance' for the amplitude (distance from end to end) in units.
Trigger to freeze/reactivate.

"angle" set bobaxis
"distance" total distance of bob, will move half this far in either direction
"pos1"/"pos2" ignore angle/distance and set apex offsets directly
"wait" wavelength of bob in seconds
"delay" phase offset to start at (0 = pos1, 0.5 = pos2, 1.0 = back at pos1 again)
"sounds"
0) none, or, set your own with 'noise' (stop sound) and 'noise1' (move sound)
1) ratchet metal
2) base plat

Spawnflags
START_OFF	start off
CRUSHER		don't reverse when blocked
STOP_*		when triggered off, keep oscillating until reaching the low/high/midpoint and stop there. checking more than one adds eligible stopping places, and the bobber will stop at the first one reached.
*/
/*FGD
@PointClass size(16 16 16) base(Bob, CustomModel) = func_bobbing_point : "Bobbing platform.
Moves in a smooth sine wave. Build at the center of motion, specify 'wait' for the wavelength in seconds and 'distance' for the amplitude (distance from end to end) in units. Use 'delay' to set a phase offset (0-1).
Trigger to freeze in place or reactivate. If any 'don't stop until' spawnflags are checked, the bobber will keep oscillating until it reaches one of the designated positions and stop there.

Set both 'pos1' & 'pos2' to override the two apex positions (ends of the bob) to build and light your plat wherever."
[]
*/
void() cu_func_bobbing_point = {cu_func_bobbing();}

// =======================================

void() cu_teleball_init =
{
	//dprint("in teleball_init\n");
	if (self.spawnflags & 1)
	{
		self.spawnflags -= 1;
		setmodel (self, "progs/teleport.mdl");
		setsize (self, cu_VEC_ORIGIN, cu_VEC_ORIGIN);	
	}
	
	self.avelocity = 50 * cu_Vector(cu_crandom(), cu_crandom(), cu_crandom());
	self.use = cu_SUB_Null;
}

/*cu:QUAKED misc_teleporttrain (0 .5 .8) (-16 -16 -16) (16 16 16) START_INVIS
Annoying spiky ball which players who have beaten Quake understand as a moving teleport target.

Inherits movement speed from each path_corner's "speed" key. 

Spawnflags
START_INVIS	Invisible until triggered
*/
/*FGD
@PointClass base(Flytrain) size(32 32 32) color(0 128 200) model({ "path": ":progs/teleport.mdl" }) = misc_teleporttrain : "Flying teleporter destination
Annoying spiky ball which players who have beaten Quake understand as a moving teleport target. The teleball itself behaves like a func_flytrain."
[
	target(string) : "First stop target"
	spawnflags(flags) =
	[
		1 : "Start invisible" : 0
	]
]
*/
void() cu_misc_teleporttrain =
{	
	if (!cu_SUB_ShouldSpawn()) return;
	
	precache_model2 ("progs/teleport.mdl");
	
	// emulate old "spawn where you were placed and then move to the first pathcorner"
	// behavior so udob_end isn't broken by the first path_corner's targets not firing
	setorigin (self, self.origin);
	entity cu_path = spawn();
	setorigin(cu_path, self.origin);
	cu_path.classname = "path_corner";
	cu_path.targetname = vtos(self.origin);	// dumb, but unique!
	cu_path.target = self.target;
	self.target = cu_path.targetname;
	// do this first so train_find finds it
	
	if (!self.speed) self.speed = 100;
	self.speed2 /= 6;	// old teletrains have old dumb speed2 values from old dumb fly code
	self.pausetime = -1;
	self.solid = -1;
	
	cu_flytrain_setup();
	self.movetype = cu_MOVETYPE_NOCLIP;	// for avelocity
	
	if (!(self.spawnflags & 1))
	{
		cu_teleball_init();
		setmodel (self, "progs/teleport.mdl");
		setsize (self, cu_VEC_ORIGIN, cu_VEC_ORIGIN);	
	}
	else
	{
		self.use = cu_teleball_init;
	}
}

