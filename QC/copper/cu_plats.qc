float cu_PLAT_LOW_TRIGGER = 1;

float() cu_plat_try_find_trigger =
{
	entity cu_t;
	cu_t = find (world, targetname, self.target);
	if (!cu_t)
	{
		dprint("plat with unmatched target\n");
		return cu_FALSE;
	}
	else if ( (cu_t.classname != "trigger_once") && (cu_t.classname != "trigger_multiple") && (cu_t.classname != "trigger_multiple_box") ) 
	{
		dprint("plat targets a non-trigger\n");
		return cu_FALSE;
	}
	else
	{
		cu_dprint3("plat trigger found, ", cu_t.classname, "\n");
		cu_t.touch = cu_plat_center_touch;
		cu_t.think = cu_SUB_Null;
		cu_t.movetype = cu_MOVETYPE_NONE;
		cu_t.enemy = self;
		self.cu_trigger_field = cu_t;
		self.target = "";
	}
	self.think = cu_SUB_Null;
	return cu_TRUE;
}

void() cu_plat_spawn_inside_trigger =
{
	entity cu_t;
	vector cu_tmin, cu_tmax;

	if (self.target != cu_string_null)
	{
		dprint("overriding plat trigger\n");
		// find overridden trigger for custom trigger zones
		if (cu_plat_try_find_trigger())
			return;
	}
	
	// touch zone should extend from the top of the plat in its lowest position
	// to 8 units above the top of the plat in its highest position. pos1 cannot
	// be assumed to be the highest position.
	cu_t = spawn();
	local float cu_high, cu_low;
	
	cu_high = cu_max(self.pos1_z, self.pos2_z) + self.maxs_z;
	cu_low = cu_min(self.pos1_z, self.pos2_z) + self.maxs_z;
	
	cu_tmin = self.mins + '25 25 0';
	cu_tmax = self.maxs - '25 25 0';
	if (self.size_x <= 50)
	{
		cu_tmin_x = (self.mins_x + self.maxs_x) / 2;
		cu_tmax_x = cu_tmin_x + 1;
	}
	if (self.size_y <= 50)
	{
		cu_tmin_y = (self.mins_y + self.maxs_y) / 2;
		cu_tmax_y = cu_tmin_y + 1;
	}
	
	cu_tmin_z = cu_low;
	if (self.spawnflags & cu_PLAT_LOW_TRIGGER)
		cu_tmax_z = cu_low + 8;
	else
		cu_tmax_z = cu_high + 8;
	
	cu_t.solid = cu_SOLID_TRIGGER;
	setsize (cu_t, cu_tmin, cu_tmax);
	
	cu_t.touch = cu_plat_center_touch;
	cu_t.think = cu_SUB_Null;
	cu_t.movetype = cu_MOVETYPE_NONE;
	cu_t.enemy = self;
	self.cu_trigger_field = cu_t;
}

void() cu_plat_hit_top =
{
	sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
	self.state = cu_STATE_TOP;
	self.think = cu_plat_go_down;
	self.nextthink = self.ltime + self.wait;
	cu_SUB_UseTargetsAlt(cu_target2);
}

void() cu_plat_hit_bottom =
{
	sound (self, cu_CHAN_VOICE, self.noise1, 1, cu_ATTN_NORM);
	self.state = cu_STATE_BOTTOM;
	cu_SUB_UseTargetsAlt(cu_target4);
}

void() cu_plat_go_down =
{
	sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
	self.state = cu_STATE_DOWN;
	cu_SUB_CalcMove (self.pos2, self.speed, cu_plat_hit_bottom);
	cu_SUB_UseTargetsAlt(cu_target3);
}

void() cu_plat_go_up =
{
	sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
	self.state = cu_STATE_UP;
	cu_SUB_CalcMove (self.pos1, self.speed, cu_plat_hit_top);
	cu_SUB_UseTargetsAlt(target);
}

// ---------------------------------------------------------
// plat_can_go
//
// plats are guaranteed to split the party in coop, requiring multiple 
// players who want to take the same plat to stop at the edge, hold
// hands, and jump together - not foolproof in netquake. so, if any
// clients are about to get on the plat with us, just wait a moment
// so players can take the actions they want to take and not have to
// be so precious
// ---------------------------------------------------------
float() cu_plat_can_go =
{
	if (!coop) return cu_TRUE;

	// currently waiting
	if (time < self.cu_attack_finished)
		return cu_FALSE;
	
	// wait completed, don't wait more than once
	if (self.cu_attack_finished > 0)
	{
		self.cu_attack_finished = 0;
		return cu_TRUE;
	}
	
	if (cu_plat_check_other_clients())
	{
		// play a sound
		sound (self.enemy, cu_CHAN_VOICE, self.enemy.noise1, 1, cu_ATTN_NORM);
		self.cu_attack_finished = time + 1.2;
		return cu_FALSE;
	}
	return cu_TRUE;
}

float() cu_plat_check_other_clients =
{
	// self is trigger, other is player
	float cu_cl = 0;
	entity cu_pl = world;
	entity cu_oself;
	while (cu_cl < cu_clients)
	{
		cu_pl = find(cu_pl, classname, "player");
		if (!cu_pl) break;
		
		if (cu_pl != self &&	// players can't block themselves
			vlen(other.origin - cu_pl.origin) < 192 && // within 192u
			!cu_EntitiesTouching(cu_pl,self) && // not already aboard
			normalize(other.origin - cu_pl.origin) * cu_pl.velocity > -100 ) // not moving away
		{
			cu_oself = self;
			self = other;
			if (cu_visible(cu_pl))	// visible to the first player
			{
				self = cu_oself;
				return cu_TRUE;
			}
			self = cu_oself;
		}
		cu_cl++;
	}
	return cu_FALSE;
}

void() cu_plat_center_touch =
{
	if (!cu_CheckValidTouch()) return;

	if (self.enemy.state == cu_STATE_BOTTOM)
	{
		if (cu_plat_can_go())
			cu_SUB_CallAsSelf(cu_plat_go_up, self.enemy);
	}
	else if (self.enemy.state == cu_STATE_TOP)
		self.enemy.nextthink = cu_max(self.enemy.nextthink, self.enemy.ltime + 1);	// delay going down
}
/*
void() plat_outside_touch =
{
	if (!CheckValidTouch()) return;
		
//dprint ("plat_outside_touch\n");
	self = self.enemy;
	if (self.state == STATE_TOP)
		plat_go_down ();
}
*/
void() cu_plat_trigger_use =
{
	if (self.think)
		return;		// already activated
	cu_plat_go_down();
}


void() cu_plat_crush =
{
	VR_CU_ShaftBlocked(other); // QVR: lift shafts kept clear (vr_copper_bridge.qc)
//dprint ("plat_crush\n");
	if (self.dmg)
		cu_T_Damage (other, self, self, self.dmg, cu_DMGTYPE_CRUSH);
	
	if (self.state == cu_STATE_UP)
		cu_plat_go_down ();
	else if (self.state == cu_STATE_DOWN)
		cu_plat_go_up ();
	else
		dprint("plat_crush: bad self.state\n");
}

void(entity cu_p) cu_plat_force = 
{
	if (cu_p.cu_customflags & cu_CFL_LOCKED) return;
	if (cu_p.state == cu_STATE_TOP || cu_p.state == cu_STATE_UP)
		cu_SUB_CallAsSelf(cu_plat_go_down, cu_p);
	else
		cu_SUB_CallAsSelf(cu_plat_go_up, cu_p);
}

void() cu_plat_use =
{
	self.use = cu_SUB_Null;
	if (self.state != cu_STATE_UP)
		dprint("plat_use: not in up state\n");
	cu_plat_go_down();
}

void(float cu_unlock) cu_plat_lock =
{
	if (cu_unlock)
	{
		self.cu_trigger_field.touch = cu_plat_center_touch;
		if (self.targetname != cu_string_null)
			self.use = cu_plat_use;
		self.cu_customflags = cu_not(self.cu_customflags, cu_CFL_LOCKED);
	}
	else
	{
		self.cu_trigger_field.touch = cu_SUB_Null;
		self.use = cu_SUB_Null;
		self.cu_customflags |= cu_CFL_LOCKED;
	}
}

void() cu_plat_finalize =
{
	cu_plat_spawn_inside_trigger ();	// the "start moving" trigger	
	// delayed to finalize() bc if the plat spawns before the trigger this will fail

	// also delayed so all targeters can spawn:
	if (self.targetname != cu_string_null && !cu_door_getslocked(self))
	{
		setorigin (self, self.pos1);
		self.state = cu_STATE_UP;
		self.use = cu_plat_use;
	}
	else
	{
		setorigin (self, self.pos2);
		self.state = cu_STATE_BOTTOM;
	}
}

/*cu:QUAKED func_plat (0 .5 .8) ? PLAT_LOW_TRIGGER
Plats are always drawn in the extended position, so they will light correctly.
If the plat is the target of another trigger or button, it will start out disabled in the top position until it is triggered, when it will lower and become a normal plat.
If the plat targets a trigger once/multiple/multiple_box, it will override the plat's default activation zone (consuming the trigger).

"PLAT_LOW_TRIGGER" activation zone will only be at the bottom of the movement course, instead of the whole vertical

"speed"		default 150
"lip"		implicitly determine the distance the plat moves
"height"	explicitly determine the distance the plat moves
"pos1"&"pos2"	directly override top and bottom positions - plat can be built anywhere else in the map
"wait"		time to pause at apex in seconds, default 3
"sounds"
	1: base fast
	2: chain slow (default if 0)
	-1: silent

Alt Target Pattern: 'target' upon rising, 'target2' upon reaching top, 'target3' upon descending, 'target4' upon reaching bottom.
*/
/*FGD
@SolidClass base(Appearflags, Targetname, Func, Target, AltTarget) = func_plat : "Elevator platform.
Plats are always drawn in the extended position, so they will light correctly.
If the plat is the target of another trigger or button, it will start out disabled in the top position until it is triggered, when it will lower and become a normal plat.
If the plat targets a trigger once/multiple/multiple_box, it will override the plat's default activation zone (consuming the trigger).

Movement distance can be defined with 'height' or 'lip'. By instead setting 'pos1' & 'pos2' you can directly override the top and bottom positions, allowing the plat to be built anywhere else in the map. This is useful for building a plat where it will be lit the best.

The 'low trigger volume' spawnflag will put the activation zone only at the bottom of the movement course, instead of the whole vertical.

Alt Target Pattern: 'target' upon rising, 'target2' upon reaching top, 'target3' upon descending, 'target4' upon reaching bottom." 
[	
	spawnflags(Flags) =
	[
		1 : "Low trigger volume" : 0
	]
	target(target_destination) : "Custom activation trigger"
	speed(integer) : "Speed" : 150
	height(integer) : "Travel altitude (can be negative)" : 0
	lip(integer) : "Lip remaining at bottom of move" : 8
	dmg(integer) : "Punishment for banging your head" : 1
	wait(string) : "Apex pause time" : "3"
	pos1(string) : "Override top position (x y z)"
	pos2(string) : "Override bottom position (x y z)"
	sounds(choices) : "Sound" : 2 =
	[
		-1: "Silent"
		1: "Base fast"
		2: "Chain Slow"
	]
]	
*/
void() cu_func_plat =
{
	if (!cu_SUB_ShouldSpawn()) return;

	cu_precache_model_safe(self.model);

	if (self.sounds == 0)
		self.sounds = 2;
	// FIXME load generic plat sound

	if (self.sounds == -1)
	{
		if (!self.noise)
			self.noise = ("misc/null.wav");
		if (!self.noise1)
			self.noise1 = ("misc/null.wav");
		cu_precache_sound_safe(self.noise);
		cu_precache_sound_safe(self.noise1);
	}
	if (self.sounds == 1)
	{
		cu_precache_sound_safe ("plats/plat1.wav");
		cu_precache_sound_safe ("plats/plat2.wav");
		self.noise = "plats/plat1.wav";
		self.noise1 = "plats/plat2.wav";
	}

	if (self.sounds == 2)
	{
		cu_precache_sound_safe ("plats/medplat1.wav");
		cu_precache_sound_safe ("plats/medplat2.wav");
		self.noise = "plats/medplat1.wav";
		self.noise1 = "plats/medplat2.wav";
	}

	self.mangle = self.angles;
	self.angles = '0 0 0';

//	self.classname = "plat";
	self.solid = cu_SOLID_BSP;
	self.movetype = cu_MOVETYPE_PUSH;
	setorigin (self, self.origin);	
	setmodel (self, self.model);
	setsize (self, self.mins, self.maxs);

	if (!self.speed)
		self.speed = 150;
	if (!self.wait)
		self.wait = 3;
	self.dmg = cu_zeroconvertdefault(self.dmg, 1);
	
	if (!self.height)
	{
		if (self.distance)
			self.height = self.distance;
		else
		{
			if (!self.lip) self.lip = 8;
			self.height = self.size_z - self.lip;
		}
	}	
	if (!self.height)
	{
		// this one's for tc_cement_mixer
		dprint("\bwarning:\b func_plat had 0 height - are you using lip correctly?");
		self.height = self.size_z;
	}
	
	if (!self.pos1 && !self.pos2)
	{
		// pos1 is the top position, pos2 is the bottom
		self.pos1 = self.origin;
		self.pos2 = self.origin;
		if (self.height)
			self.pos2_z = self.origin_z - self.height;
	}
	self.blocked = cu_plat_crush;
	self.use = cu_plat_trigger_use;
	self.cu_lock = cu_plat_lock;

	self.think = cu_plat_finalize;
	self.nextthink = self.ltime + 0.1;
}

//============================================================================

const float cu_TRAIN_INHERIT = 1;
const float cu_TRAIN_TOGGLE = 2;
const float cu_TRAIN_SMOOTHSPEED = 4;

void() cu_train_sounds =
{
	if (self.sounds == 0)
	{
		if (!self.noise)
			self.noise = ("misc/null.wav");
		if (!self.noise1)
			self.noise1 = ("misc/null.wav");
		cu_precache_sound_safe(self.noise);
		cu_precache_sound_safe(self.noise1);
	}

	if (self.sounds == 1)
	{
		self.noise = ("plats/train2.wav");
		cu_precache_sound_safe ("plats/train2.wav");
		self.noise1 = ("plats/train1.wav");
		cu_precache_sound_safe ("plats/train1.wav");
	}
	if (self.sounds == 2)
	{
		cu_precache_sound_safe ("plats/plat1.wav");
		cu_precache_sound_safe ("plats/plat2.wav");
		self.noise1 = "plats/plat1.wav";
		self.noise = "plats/plat2.wav";
	}

}

