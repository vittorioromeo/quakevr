// --------------------------------
void() cu_ServerflagsCommand =
{
	serverflags = serverflags * 2 + 1;
	cu_dev_serverflags();
};


// --------------------------------
// ImpulseCommands
// --------------------------------
void() cu_ImpulseCommands =
{
	if (!self.impulse) return;
	
	if (self.impulse < 9)
	{
		cu_W_ChangeWeapon();
	}
	else if (self.impulse >= 20 && self.impulse <= 39)
	{
		cu_dev_impulse(self.impulse);
	}
	else switch(self.impulse)
	{
	case 10:
		cu_CycleWeaponCommand();
		break;
	case 12:
		cu_CycleWeaponReverseCommand();
		break;
	case 11:
		cu_ServerflagsCommand();
		break;
	case 13:
		cu_W_SelectBestShotgun();
		break;
	case 14:
		cu_W_SelectBestNailgun();
		break;
	case 15:
		cu_W_SelectBestWeapon();
		break;
	case 16:
		cu_W_SelectLastWeapon();
		break;

	case 40:
		cu_dev_impulse_list();
		break;
	case 64:
		cu_dev_i_cant_see();
		break;
	case 72:
		cu_dev_test();
		break;
	case 80:
		cu_dev_add_meatball();
		break;
	case 81:
		cu_dev_remove_meatball();
		break;
	case 100:
		cu_dev_invoke();
		break;
	case 101:
		cu_dev_reveal();
		break;
	case 102:
		cu_dev_trigger();
		break;
	case 103:
		cu_dev_hitpoints();
		break;
	case 104:
		cu_dev_serverflags();
		break;
	case 105:
		cu_dev_warp();
		break;
	case 106:
		cu_dev_whatami();
		break;
	case 108:
		cu_dev_tracetest();
		break;
	case 127:
	case 129:
		coredump();
		break;
	
	case 140:
		sound(self, cu_CHAN_VOICE, "player/tornoff2.wav", 1, cu_ATTN_STATIC);
		centerprint(self, cu_version_s);
		break;
	
	case 9:
		cu_Cheat_Items();
		break;
	case 99:
		cu_Cheat_Keys();
		break;
	// how about, execute order six?
	// nah. makes it sound like there aren't that many orders
	case 66:
	case 205:
		if(!deathmatch && !coop)
			cu_Cheat_Genocide();
		break;
	case 200:
		cu_dev_remaining_monsters();
		break;
	case 210:
		cu_toggle_autosave();
		break;
	case 215:
		cu_Cheat_Undying();
		break;
	case 225: 
		cu_Cheat_Suit();
		break;
	case 235:
		cu_Cheat_Pent();	
		break;
	case 245:
		cu_Cheat_Ring();	
		break;
	case 255:
		cu_Cheat_Quad();	
		break;
		
	default:
		return;
	}
	
	self.impulse = 0;
}
