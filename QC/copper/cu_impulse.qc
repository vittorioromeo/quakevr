// --------------------------------
// Cheat_Keys
// --------------------------------
void() cu_Cheat_Keys =
{
	if(deathmatch || coop)
		return;

	cu_key_give_silver(self);
	cu_key_give_gold(self);
	stuffcmd(self,"bf\n");
}


// --------------------------------
// Cheat_Items
// --------------------------------
void() cu_Cheat_Items =
{
	if(deathmatch || coop)
		return;

	self.ammo_shells = cu_MAX_AMMO_SHELLS;
	self.ammo_nails = cu_MAX_AMMO_NAILS;
	self.ammo_rockets = cu_MAX_AMMO_ROCKETS;
	self.ammo_cells = cu_MAX_AMMO_CELLS;
	
	self.items = self.items |
	//	IT_KEY1 | IT_KEY2 | 
		cu_IT_AXE |
		cu_IT_SHOTGUN |
		cu_IT_SUPER_SHOTGUN |
		cu_IT_NAILGUN |
		cu_IT_SUPER_NAILGUN |
		cu_IT_GRENADE_LAUNCHER |
		cu_IT_ROCKET_LAUNCHER;

	self.items = self.items | cu_IT_LIGHTNING;

	cu_W_SetCurrentAmmo();
	cu_W_Select(cu_IT_ROCKET_LAUNCHER);

	stuffcmd(self,"bf\n");
}

// --------------------------------
// Cheat_Genocide
// --------------------------------
void() cu_Cheat_Genocide =
{
	entity cu_t;
	
	cu_t = nextent(world);	
	while(cu_t != world)
	{
		// these monsters haven't spawned yet, turn them into relays so their 
		// deathtargets fire as soon as they're triggered and their absence doesn't
		// break the level
		if(cu_t.cu_customflags & cu_CFL_SPAWNER)
		{
			cu_t.classname = "trigger_relay";
			cu_t.count = 0;
			cu_t.use = cu_trigger_relay_use;
			cu_t.spawnflags = 0;
		}
		cu_t = nextent(cu_t);
	}
	// kill existing monsters second, so that any monsters triggered by other monsters
	// are already de-monsterized
	cu_t = nextent(world);
	while(cu_t != world)
	{
		if(cu_t.flags & cu_FL_MONSTER)
		{
			// don't forget monsters on the verge of spawning
			if (cu_t.think == cu_mon_spawner_tryspawn || cu_t.modelindex == 0 || cu_t.classname == cu_string_null )
				remove(cu_t);
			else
				cu_T_Damage(cu_t, self, self, cu_t.health, cu_DMGTYPE_SCRIPT);		// waurgh
		}
		cu_t = nextent(cu_t);
	}
}

// --------------------------------
// Cheat_Undying
// --------------------------------
void() cu_Cheat_Undying =
{
	if(deathmatch || coop)
		return;
	if(self.cu_customflags & cu_CFL_UNDYING)
	{
		sprint(self, "Undying mode disabled\n");
		self.cu_customflags = cu_not(self.cu_customflags, cu_CFL_UNDYING);
		return;
	}
	sprint(self, "Undying mode enabled\n");
	self.cu_customflags |= cu_CFL_UNDYING;
}


