/*FGD
@baseclass base(Angle, Appearflags, Target, Targetname, Deathtype, AltTarget) color(220 0 0) = Monster 
[
	spawnflags(Flags) = 
	[
		1 : "Ambush" : 0
		16 : "Triggered Spawn" : 0
		32 : "No Teleflash on Spawn" : 0
		64 : "Don't Spawn If Would Telefrag" : 0
		128 : "Spawn Angry" : 0
	]
	movedir(string) : "Auto jump velocity on spawn/awaken (x y z, in worldspace)"
	rmovedir(string) : "Angle-relative auto jump velocity on spawn/awaken (forward right up)"
	count(integer) : "If triggered: Number of times a spawn can be triggered before stopping. -1 for infinite spawns, -4 to auto-scale the count to the number of clients in coop."
	wait(string) : "If triggered: Pause before spawning" : "0"
	rand(string) : "If triggered: Random extra time before spawning" : "0"
	netname(string) : "If triggered: Spawned monster(s) will have this targetname"
]
*/

// at map start, anything that is a monster calls this and adds itself to various
// balance debugging totals, to take some of the guesswork out of ammo placement
void() cu_TallyHitpoints =
{
	if (!cvar("developer")) return;
	
	//dprint5("tally hitpoints for ",self.classname," adding ",ftos(self.health),"\n");
	if (self.classname == "monster_boss" || self.classname == "monster_oldone")
		return;
	
	local float cu_num;
	cu_num = 1;
	if (self.spawnflags & cu_SPAWN_TRIGGERED)
	{
		if (self.count > 1)
			cu_num = self.count;
	}
	
	if (self.cu_type == "zombie")
	{
		if ( !( self.spawnflags & cu_SPAWN_CRUCIFIED ) )
			cu_num_zombies += cu_num;
	}
	else
		cu_monster_health += self.health * cu_num;
	
	if (self.classname == "monster_army")
		cu_ammo_total += 5 * cu_DEBUG_DMG_PER_SHELL;
	//if (self.classname == "monster_enforcer")
	//	ammo_total += 5 * DEBUG_DMG_PER_CELL;
	if (self.classname == "monster_ogre")
		cu_num_rockets += 1;
}

/*
================================================================

SPAWNING

all monster_* entities can be used as triggerable monster teleport spawns,
which is way better than building a big teleport setup in a hidden room
for each one.

setting 'count' on any monster allows the same entity to be triggered more than 
once to spawn monsters repeatedly. 'count' monsters are added to the kill total 
when the map starts.
setting count to a negative number makes the spawner unlimited use, and monsters
are added to the kill total as they're spawned. 

FIXME: their bodies and head gibs WILL stick around forever

================================================================
*/



/*
================
monster_spawnsetup_go

sanity check for trigger-spawned monsters with no existing targeters
fix by iw
================
*/
void() cu_monster_spawnsetup_go =
{
	self.think = cu_SUB_Null;  // just to tidy up after ourselves

	if (self.targetname == cu_string_null)
	{
		cu_dprint5("\bwarning:\b removed triggered-spawn ", self.classname,
			" with no targetname at ", vtos(self.origin), "\n");
		remove(self);
		return;
	}

	if (cvar("developer"))
	{
		if (!cu_SUB_VerifyTriggerable())
		{
			cu_dprint4("\bwarning:\b triggered-spawn ", self.classname,
				" with unmatched targetname '", self.targetname);
			cu_dprint3("' at ", vtos(self.origin), "\n");
			//remove(self);
			return;
		}
	}

	self.cu_customflags |= cu_CFL_SPAWNER;
	self.use = self.cu_think1;
	self.cu_think1 = cu_SUB_Null;  // just to tidy up after ourselves

	if (!self.count)
		self.count = 1;
	if (self.count == -1)
		self.count = 0;
	if (self.count != -4)
		cu_addmonster(self.count);	// this count gets added late
};

/*
================
monster_spawnsetup

Checks if this monster is in some way a spawner of monsters, and returns
TRUE if so, after scheduling appropriate setup. A return of TRUE should
signal the calling spawnfunc that the monster shouldn't continue to be
spawned right now.

'spawnthink' is the function that should be used as the triggering action
if this monster is a spawner.
================
*/
float( void() cu_spawnthink ) cu_monster_spawnsetup =
{
	cu_TallyHitpoints();
	
	if (!(self.spawnflags & cu_SPAWN_TRIGGERED))
		return cu_FALSE;
	
	// if we're not in coop mode, count -4 will always evaluate to 1, so go ahead and default 
	// this field back to 0 so the kill count doesn't change during play if it doesn't have to
	if (self.count == -4 && !cvar("coop"))
		self.count = 0;

	// wait for all potential targeters to finish spawning
	self.cu_think1 = cu_spawnthink;
	self.think = cu_monster_spawnsetup_go;
	self.nextthink = time + 0.1 + random() * 0.05;	// spread thinks to not ram quake to death with sub_verifytriggerable checks
	
	return cu_TRUE;
}

void(float cu_num) cu_addmonster =
{
	if (!self.cu_th_checkattack)
		self.cu_th_checkattack = cu_CheckAttack;
	
	if (!cu_num) return;
	
	total_monsters = total_monsters + cu_num;
	WriteByte (cu_MSG_ALL, cu_SVC_UPDATESTAT);
	WriteByte (cu_MSG_ALL, cu_STAT_TOTALMONSTERS);
	WriteLong (cu_MSG_ALL, total_monsters);
}

float(entity cu_me) cu_monster_check_enemy_activator =
{
	if ((cu_activator.flags & (cu_FL_CLIENT|cu_FL_MONSTER)) && !cu_alive(cu_activator))
		return cu_FALSE;
	return cu_TRUE;
}

float(entity cu_me) cu_monster_check_enemy_inheritance =
{
	if (!(cu_activator.flags & cu_FL_MONSTER))
		return cu_FALSE;
	if (!cu_alive(cu_activator.enemy) && !cu_alive(cu_activator.cu_oldenemy))
		return cu_FALSE;
	if (!(cu_activator.enemy.classname == "player" || cu_activator.cu_oldenemy.classname == "player"))
		return cu_FALSE;
	return cu_TRUE;
}


entity(float cu_onlymonsters) cu_find_touching =
{
	entity cu_head = findradius(cu_BoundsCenter(self), self.size_z + 64);
	while (cu_head != world)
	{
		if (cu_head.health <= 0 ||
			(cu_head.solid == cu_SOLID_NOT || cu_head.solid == cu_SOLID_TRIGGER) ||
			!cu_BoundsTouching(self.absmin, self.absmax, cu_head.absmin, cu_head.absmax, 2) ||
			(cu_onlymonsters && !(cu_head.flags & cu_FL_MONSTER)) )
		{
			cu_head = cu_head.chain;
		}
		else return cu_head;
	}
	return world;
}

void() cu_mon_spawner_tryspawn
{
	if (cu_find_touching(cu_TRUE))
	{
		self.nextthink = time + 0.25;
		return;
	}
	
	if (!(self.spawnflags & cu_SPAWN_NO_TFOG))
		cu_teleport_flash();
	self.cu_think1();
}

entity( void() cu_spawnthink ) cu_mon_spawner_use =
{
	//playercount_convert(count);
	if (self.count == -4)
	{
		self.count = cu_clients;
		cu_addmonster(cu_clients);
	}
	
	entity cu_mon;
	float cu_pause;
	
	cu_mon = spawn();
	
	cu_mon.flags |= cu_FL_MONSTER;
	setorigin(cu_mon, self.origin);
	cu_mon.angles = self.angles;
	
	cu_pause = self.wait + random() * self.cu_rand;
	cu_mon.nextthink = time + cu_pause;
	cu_mon.spawnflags = self.spawnflags;
	cu_mon.movedir = self.movedir;
	cu_mon.cu_rmovedir = self.cu_rmovedir;
	cu_mon.lip = self.lip;
	cu_mon.state = self.state;
	cu_mon.alpha = self.alpha;
	cu_mon.skin = self.skin;
	cu_mon.effects = self.effects;
	cu_mon.armortype = self.armortype;
	cu_mon.armorvalue = self.armorvalue;
	cu_mon.items = self.items;
	cu_mon.gravity = self.gravity;
	cu_mon.cu_invincible_finished = self.cu_invincible_finished;
	cu_mon.cu_invisible_finished = self.cu_invisible_finished;
	cu_mon.cu_super_damage_finished = self.cu_super_damage_finished;
	cu_mon.cu_radsuit_finished = self.cu_radsuit_finished;
	cu_mon.health = self.health;
	cu_mon.delay = self.delay;
	cu_mon.message = self.message;
	cu_mon.deathtype = self.deathtype;
	cu_SUB_CopyTargets(cu_mon);
	cu_mon.targetname = self.netname;
	
	// don't spawnfrag monsters if the mapper expects us to be spawning into chaos
	if ( (self.spawnflags & cu_SPAWN_NO_TFRAG) )
	{
		// set monster's size now so we can check the landing zone for other monsters
		setsize(cu_mon,self.mins,self.maxs);
		cu_mon.think = cu_mon_spawner_tryspawn;
		cu_mon.cu_think1 = cu_spawnthink;
		cu_mon.spawnflags |= cu_SPAWN_NO_TFRAG;
	}
	else
	{
		cu_mon.think = cu_spawnthink;
		if (!(self.spawnflags & cu_SPAWN_NO_TFOG))
			cu_teleport_flash_delay(cu_pause);
	}

	// set .enemy before monster_start thinks, because 'activator' will be different by then
	if ( !self.enemy && (self.spawnflags & cu_SPAWN_INSTAWAKE) && cu_monster_check_enemy_activator(cu_mon) )
	{
		// theSolipsist fix: monsters triggered or awakened by other monsters inherit their enemies
		if (cu_monster_check_enemy_inheritance(cu_mon))
		{
			cu_mon.enemy = cu_activator.enemy;
			cu_mon.cu_oldenemy = cu_activator.cu_oldenemy;
		}
		else
			//mon.enemy = activator;
			cu_mon.enemy = nextent(world);	// just blame player1
	}	

	if (self.count > 0)
	{
		self.count = self.count - 1;
		if (self.count == 0)
		{
			cu_SUB_Remove();
		}
	}
	else 
	{
		cu_addmonster(1); // add them one at a time if this is an unlimited spawner
	}
	
	// eliminate unnecessary frame of delay
	if (cu_pause == 0)
		cu_SUB_CallAsSelf(cu_mon.think, cu_mon);
	
	return cu_mon;
}

void(entity cu_m) cu_monster_kill =
{
	cu_T_Damage(cu_m, self, self, cu_m.health + 100, cu_DMGTYPE_SCRIPT | cu_DMGTYPE_NOARMOR);
}

/*
================
monster_use

Using a monster makes it angry at the current activator, because
nobody likes to be used
================
*/
void() cu_monster_use =
{
	if (self.health <= 0)
		return;
	if (self.enemy)
		return;
	if (cu_has_invis(cu_activator))
		return;
	if (cu_activator.flags & cu_FL_NOTARGET)
		return;

	if (!cu_monster_check_enemy_activator(self)) return;	
	
	// theSolipsist fix: monsters triggered or awakened by other monsters inherit their enemies
	if (cu_monster_check_enemy_inheritance(self))
	{
		self.enemy = cu_activator.enemy;
		self.cu_oldenemy = cu_activator.cu_oldenemy;
	}
	else 
		//mon.enemy = activator;
		self.enemy = nextent(world);	// just blame player1

	// delay reaction so the monster is still heard if it's teleported
	self.nextthink = time + 0.1;
	self.think = cu_FoundTarget;

}

/*
================
monster_alt_use

alternate monster target firing pattern, gathered together for efficiency

target: on waking up
target2: when first hurt by anything
target3: when first brought under half health
target4: on death (message and killtarget go off here too)	

first three are single-use only. monsters can be awoken more than once (infighting), hurt more 
than once (obv), & cross under half health more than once (if healed), and we don't want to 
require a count-1 relay on every trigger just to guard against the unpredictable.

target (wakeup) is not guaranteed: monsters can be killed slowly by traps and never wake up,
	and arbitrarily firing it later (like on death) just to cover it doesn't make much sense
target2 (first hurt), target3 (half health), and target4 (death) are guaranteed: if a monster
	is one-shot by a quad rocket, they'll fire in that order and none will be skipped. 
if a sleeping monster is one-shot by a quad rocket from the player, all four will fire because
	it would have woken the monster up anyway.
================
*/
float(float cu_wake, float cu_hurt, float cu_bloody, float cu_dead) cu_monster_alt_use =
{
	if (!(self.spawnflags & cu_SPAWN_ALT_TARG))
		return cu_FALSE;

	entity cu_t;
	entity cu_oact = cu_activator;

	// Monsters use themselves as activators for all events except death, which tries
	// to find the most relevant player if they weren't killed by one. This is so
	// monsters can activate teleport targets and not teleport the player randomly
	// instead.
	
	if (self.delay)
	{
		if (cu_wake||cu_hurt||cu_bloody)
		{
			// create a temp object to fire at a later time
			cu_t = spawn();
			cu_t.classname = "DelayedUse";
			cu_t.nextthink = time + self.delay;
			cu_t.think = cu_SUB_UseTargetsGo;
			cu_t.enemy = self;
			
			if (cu_wake)
			{
				cu_t.target = self.target;
				self.target = cu_string_null;
			}
			if (cu_hurt)
			{
				cu_t.cu_target2 = self.cu_target2;
				self.cu_target2 = cu_string_null;
			}
			if (cu_bloody)
			{
				cu_t.cu_target3 = self.cu_target3;
				self.cu_target3 = cu_string_null;
			}	
		}
		if (cu_dead)
		{
			cu_t = spawn();
			cu_t.classname = "DelayedUse";
			cu_t.nextthink = time + self.delay;
			cu_t.think = cu_SUB_UseTargetsGo;
			cu_t.enemy = cu_activator;
			cu_t.message = self.message;
			cu_t.target = self.cu_target4;
			cu_t.killtarget = self.killtarget;
		}		
	}
	else
	{
		cu_activator = self;
		if (cu_wake)
		{
			cu_SUB_UseTargetsByField(target);
			self.target = cu_string_null;
		}
		if (cu_hurt)
		{
			cu_SUB_UseTargetsByField(cu_target2);
			self.cu_target2 = cu_string_null;
		}
		if (cu_bloody)
		{
			cu_SUB_UseTargetsByField(cu_target3);
			self.cu_target3 = cu_string_null;
		}
		
		if (cu_dead)
		{
			cu_activator = cu_oact;
			cu_SUB_PrintMessage();
			cu_SUB_UseTargetsByField(cu_target4);
			cu_SUB_KillTargets(self.killtarget);
		}
	}
	cu_activator = cu_oact;
	return cu_TRUE;
}


/*
================
monster_death_use

When a monster dies, it fires all of its targets with the current
enemy as activator.
================
*/
void() cu_monster_death_use =
{
	if (!self.target && !self.cu_target2 && !self.cu_target3 && !self.cu_target4 && !self.killtarget)
		return;
	
	// make a player activator even if the monster was killed while infighting
	if (self.enemy.classname != "player")
	{
		if (self.cu_oldenemy.classname == "player")
			cu_activator = self.cu_oldenemy;
		else
			cu_activator = cu_get_closest_client();
	}
	else cu_activator = self.enemy;
	
	if (cu_monster_alt_use((self.enemy.flags & cu_FL_CLIENT), cu_TRUE, cu_TRUE, cu_TRUE))
		return;
		
	cu_SUB_UseTargets ();
}


//============================================================================

/*
================
Common monster starts
================
*/

void() cu_monster_start =
{
	//if (self.oldorigin == VEC_ORIGIN)
	//	self.oldorigin = self.origin;
	
	if (self.cu_rmovedir != cu_VEC_ORIGIN)
	{
		makevectors(self.angles);
		self.movedir = v_forward * self.cu_rmovedir_x + v_right * self.cu_rmovedir_y + v_up * self.cu_rmovedir_z;
	}
		
	// dumb hack so the world isn't flooded with a tdeath for every monster at map start
	if (time > 2)
	{
		// moved from mon_spawner_use because it was too early to catch the monster's mins and maxs
		if ((self.cu_type != "zombie" || !(self.spawnflags & cu_SPAWN_LYING)))	// lying zombies are nonsolid
		{
			entity cu_tdeath = cu_spawn_tdeath(self.origin, self);
			if (cu_tdeath && self.spawnflags & cu_SPAWN_NO_TFRAG)
			{
				// we still need to spawn a tdeath so players counter-telefrag these monsters if 
				// they're in the way
				cu_tdeath.nextthink = time + 0.05;
				// we make the tdeath remove itself before the minimum time for the spawned 
				// monster's nextthink, or else monsters can graze the telefrag trigger and 
				// explode even if they weren't truly blocking the spawn
			}
		}
	}
	
	// wait a few frames to make sure doors have spawned before doing droptofloor
	self.nextthink = 1.15;
	// why 1.15 is a magic number:
	// - quake starts 'time' at 1.0 seconds.
	// - doors and movers and stuff reposition themselves at 1.1 seconds.
	// - items drop themselves into place at 1.2 seconds, after movers, so that they fall on them 
	//    in their final positions.
	// - we want monsters to do this too, but before items do, because they were always before
	//    items originally and altering the drop order too much could cause items that didn't
	//    fall out of the world before to do so erroneously in Copper.
	// - we don't use 'time + 0.15' because this could be running on a late spawn. a constant
	//    1.15 will always be when we want at map start but in the past upon late spawn.

	if (self.cu_type == cu_string_null)
		self.cu_type = self.classname;
	
	// needed for monsters to be healed by a target_heal
	self.max_health = self.health;
}

void() cu_monster_start_go =
{
	local entity cu_pathgoal;
	self.takedamage = cu_DAMAGE_AIM;
	
	self.ideal_yaw = self.angles * '0 1 0';
	self.use = cu_monster_use;
	self.flags = self.flags | cu_FL_MONSTER;
	// default speedup rate for monsters with fast nightmare frames
	if (!self.cu_walkframe)
	{
		if (cu_skill == 3) self.cu_walkframe = 0.075;
		else self.cu_walkframe = 0.1;
	}

	// check if the mapper placed them touching a killer liquid and grant them immunity to it
	vector cu_wtt;
	cu_wtt = cu_WaterTest();
	if (cu_wtt_x)
	{
		if (cu_wtt_y == cu_CONTENT_LAVA || cu_wtt_y == cu_CONTENT_SLIME)
		{
			self.cu_customflags |= cu_CFL_LIQUID_IMMUNE;
		}
	}
	// ai_nav
	//self.radius = (self.maxs_x - self.mins_x) * 0.7;

	if (self.enemy.flags & cu_FL_NOTARGET || self.enemy.movetype == cu_MOVETYPE_NOCLIP)
		self.enemy = world;
	
	if (self.enemy)
	{
		self.cu_th_stand();
		self.think = cu_FoundTarget;
	}
	else if (self.target)
	{
		cu_pathgoal = find(world, targetname, self.target);
		if (!cu_pathgoal)
		{
			dprint (self.classname);
			dprint (" at ");
			dprint (vtos(self.origin));
			dprint (" can't find target\n");
		}
		
		if (cu_pathgoal.classname == "path_corner")
		{
			self.goalentity = cu_pathgoal;
			self.ideal_yaw = vectoyaw(self.goalentity.origin - self.origin);
			self.cu_th_walk ();
		}
		else
		{
			self.pausetime = time + cu_A_SHITLOAD;
			self.cu_th_stand ();
		}
	}
	else
	{
		self.pausetime = time + cu_A_SHITLOAD;
		self.cu_th_stand ();
	}

	// spread think times so they don't all happen at same time
	// add tiny minimum in case random() ever returns exactly 0 (rare but possible)
	self.nextthink = time + random()*0.1 + 0.05;

}

/*
================
Walkmonster starts
================
*/

void() cu_walkmonster_start_go =
{
	self.movetype = cu_MOVETYPE_STEP;
	// fix monsters being stuck in floor because of QSS fix
	//if (self.oldorigin != VEC_ORIGIN)
	//	setorigin(self,self.oldorigin);
	
	if (self.cu_rmovedir != cu_VEC_ORIGIN)
	{
		makevectors(self.angles);
		self.movedir = v_forward * self.cu_rmovedir_x + v_right * self.cu_rmovedir_y + v_up * self.cu_rmovedir_z;
		self.cu_rmovedir = cu_VEC_ORIGIN;
	}
	
	if (self.movedir == cu_VEC_ORIGIN && !(self.spawnflags & cu_SPAWN_TRIGGERED) )	// always put telespawned monsters where the mapper wants
	{
		self.origin_z = self.origin_z + 1;	// raise off floor a bit
		droptofloor();
	}
	
	if (!walkmove(0,0))
	{
		dprint ("walkmonster in wall at: ");
		dprint (vtos(self.origin));
		dprint ("\n");
	}
	
	if (!self.yaw_speed)
		self.yaw_speed = 20;
	self.view_ofs = '0 0 25';
	
	if (self.spawnflags & cu_SPAWN_TRIGGERED && self.movedir != cu_VEC_ORIGIN)
	{
		self.velocity = self.movedir;
		self.movedir = cu_VEC_ORIGIN;
	}
	
	cu_monster_start_go();
}


void() cu_walkmonster_start =
{
	cu_monster_start();
	
	// if we're spawning on a late frame, go immediately. the one frame pause
	// for other entity spawning isn't necessary, and we need to exist at the same
	// time as our tdeath so player velocity isn't zeroed by the collision before
	// tfragging us
	if (self.nextthink <= time)
		cu_walkmonster_start_go();
	else
		// wait so funcs we might be standing on can spawn, etc
		self.think = cu_walkmonster_start_go;
}

/*
================
Flymonster starts
================
*/

void() cu_flymonster_start_go =
{
	self.movetype = cu_MOVETYPE_FLY;
	
	// fix monsters dropping to floor because of QSS fix
	if (self.oldorigin != cu_VEC_ORIGIN)
		setorigin(self,self.oldorigin);
		
	if (!self.yaw_speed)
		self.yaw_speed = 10;
	self.view_ofs = '0 0 25';

	if (!walkmove(0,0))
	{
		dprint ("flymonster in wall at: ");
		dprint (vtos(self.origin));
		dprint ("\n");
	}

	cu_monster_start_go();
}

void() cu_flymonster_start =
{
	cu_monster_start();
	// iw -- move these here so fish don't fall for a frame and a half
	self.flags = self.flags | cu_FL_FLY;

	if (self.nextthink <= time)
		cu_flymonster_start_go();
	else
		self.think = cu_flymonster_start_go;
}

/*
================
Swimmonster starts
================
*/

void() cu_swimmonster_start_go =
{
	self.movetype = cu_MOVETYPE_FLY;
	
	// fix monsters dropping to floor because of QSS fix
	if (self.oldorigin != cu_VEC_ORIGIN)
		setorigin(self,self.oldorigin);

	if (!self.yaw_speed)
		self.yaw_speed = 20;//10
	self.view_ofs = '0 0 10';
	
	// FIXME: why don't fish do a walkmove test?
	cu_monster_start_go();
	// yes besides the fact that they don't have feet dickhead
}

void() cu_swimmonster_start =
{
	cu_monster_start();
	// iw -- move these here so fish don't fall for a frame and a half
	self.flags = self.flags | cu_FL_SWIM;

	if (self.nextthink <= time)
		cu_swimmonster_start_go();
	else
		self.think = cu_swimmonster_start_go;
}


/*
================
stuff for nomonsters 1
monsters which fire targets on death can't just not be spawned or the map
will break, so they become invisible eyes that fire their targets on sight
================
*/

float() cu_nomonster_findtarget =
{
	local entity	cu_client;
	local float		cu_r;

	if ( cu_sight_entity_time >= time - 0.1 && ( !(self.spawnflags & cu_SPAWN_AMBUSH ) ) )
	{
		cu_client = cu_sight_entity;
		if (cu_client.enemy == self.enemy)
			return cu_FALSE;
	}
	else
	{
		cu_client = checkclient();
		if (!cu_client)
			return cu_FALSE;	// no check entities in PVS
	}
		
	if (!cu_FilterTarget(cu_client))
		return cu_FALSE;		
	
	if (!cu_visible (cu_client))
		return cu_FALSE;

	cu_r = cu_range(cu_client);	
	if (cu_r == cu_RANGE_TOOFAR)
	{
		return cu_FALSE;
	}

	return cu_TRUE;
}

void() cu_nomonster_sleep =
{
	if (cu_nomonster_findtarget())
	{
		cu_sight_entity = self;
		cu_sight_entity_time = time;
		self.cu_show_hostile = time + 1;
		cu_SUB_UseTargets();
		self.think = cu_SUB_Remove;
		//self.think = BecomeExplosion;
	}
	self.nextthink = time + 0.2;
	//particle(self.origin, '0 0 0', 64, 16);
}

void() cu_nomonster_find =
{
	self.think = cu_nomonster_sleep;
	self.nextthink = time + 0.2;
	entity cu_e;

	if (self.target != cu_string_null)
	{
		cu_e = find(world, targetname, self.target);
		while(cu_e)
		{
			if (cu_e.classname != "path_corner")
				return;
			cu_e = find(cu_e, targetname, self.target);
		}
	}
	if (self.cu_target2 != cu_string_null)
	{
		cu_e = find(world, targetname, self.cu_target2);
		while(cu_e)
		{
			if (cu_e.classname != "path_corner")
				return;
			cu_e = find(cu_e, targetname, self.cu_target2);
		}
	}
	if (self.cu_target3 != cu_string_null)
	{
		cu_e = find(world, targetname, self.cu_target3);
		while(cu_e)
		{
			if (cu_e.classname != "path_corner")
				return;
			cu_e = find(cu_e, targetname, self.cu_target3);
		}
	}
	if (self.cu_target4 != cu_string_null)
	{
		cu_e = find(world, targetname, self.cu_target4);
		while(cu_e)
		{
			if (cu_e.classname != "path_corner")
				return;
			cu_e = find(cu_e, targetname, self.cu_target4);
		}
	}

	remove(self);
}

void() cu_nomonster_go =
{
	// a nomonster still has to be a solid so that it can be teleported out of teleboxes
	self.solid = cu_SOLID_SLIDEBOX;
	self.movetype = cu_MOVETYPE_FLY;
	setsize(self, cu_VEC_HULL_MIN, cu_VEC_HULL_MAX);
	self.think = cu_nomonster_find;
	self.view_ofs = '0 0 25';
	self.nextthink = time + 0.2 + random();
}

float() cu_nomonster =
{
	if (cvar("nomonsters") == 0)
		return cu_FALSE;
	
	if (self.target == cu_string_null &&
		self.cu_target2 == cu_string_null &&
		self.cu_target3 == cu_string_null &&
		self.cu_target4 == cu_string_null &&
		self.killtarget == cu_string_null)
	{
		remove(self);
		return cu_TRUE;
	}
	
	// make teleports work:
	self.health = 1;
	self.flags += cu_FL_MONSTER;
	
	if (self.targetname != cu_string_null && self.spawnflags & cu_SPAWN_TRIGGERED)
		self.use = cu_nomonster_go;
	else
		cu_nomonster_go();
	
	//self.classname = "nomonster";
	
	return cu_TRUE;
}
