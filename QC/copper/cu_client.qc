void() cu_SetChangeParms =
{
	if(cu_reset_flag)
	{
		setspawnparms(self);
		return;
	}
	
	if (self.health <= 0)
	{
		cu_SetNewParms ();
		return;
	}

	// remove items
	self.items = self.items - (self.items & (
		cu_IT_KEY1 | cu_IT_KEY2 | 
		cu_IT_INVISIBILITY | cu_IT_INVULNERABILITY | cu_IT_SUIT | cu_IT_QUAD
		) );
	
	// gung-ho players can run forward and grab weapons before other clients have
	// finished connecting, causing them to miss out on the global distribution
	// of that weapon in coop 1. since players can't actually have differing
	// sets of weapons in coop 1 otherwise, we union existing players' weapon sets
	// on connect to make sure nothing is missed and no late joins wind up gimped
	// for the rest of the episode
	if (coop == 1)
	{
		entity cu_pl;
		cu_pl = nextent(world);
		while (cu_pl.flags & cu_FL_CLIENT)
		{
			self.items |= cu_pl.items & cu_IT_WEAPONS;
			cu_pl = nextent(cu_pl);
		}		
	}
	
	// cap super health
	self.health = cu_min(self.health, self.max_health);		
	// bump the player up if he's below 50 <- pretty much the only 'autobalance' in quake
	if (cu_skill == 3)	// nightmare players get just enough not to crater
		self.health = cu_max(self.health, 10);
	else
		self.health = cu_max(self.health, 50);
	
	parm1 = self.items;
	parm2 = self.health;
	parm3 = self.armorvalue;
	// provide an ammo floor similar to the health floor on easy/medium
	if (cu_skill < 2 && self.ammo_shells < 25 && self.ammo_nails < 50)
		parm4 = cu_max(self.ammo_shells, floor((50 - self.ammo_nails) / 2));
	else
		parm4 = self.ammo_shells;
	parm5 = self.ammo_nails;
	parm6 = self.ammo_rockets;
	parm7 = self.ammo_cells;
	parm8 = self.weapon;
	parm9 = self.armortype;

}

void() cu_SetNewParms =
{
	parm1 = cu_IT_SHOTGUN | cu_IT_AXE;
	parm2 = 100;
	parm4 = 25;
	parm8 = cu_IT_SHOTGUN;
	parm3 = 0;
	parm5 = 0;
	parm6 = 0;
	parm7 = 0;
	parm9 = 0;
//	parm10 = 0;
}


// COOP 1 ONLY
// shells and nails are kept over on respawn
void() cu_SetCoopParms =
{
	parm1 = self.items & cu_IT_WEAPONS;
	parm2 = 100;
	parm4 = cu_max(25,self.ammo_shells);
	if (parm1 & cu_IT_SUPER_SHOTGUN)
		parm8 = cu_IT_SUPER_SHOTGUN;
	else
		parm8 = cu_IT_SHOTGUN;

	parm3 = 0;
	parm5 = self.ammo_nails;
	parm6 = 0;
	parm7 = 0;
	parm9 = 0;
//	parm10 = 0;
}

void() cu_DecodeLevelParms =
{
	if (world.model == "maps/start.bsp")
		cu_SetNewParms ();		// take away all stuff on starting new episode
	
	self.items = parm1;
	self.health = parm2;
	self.armorvalue = parm3;
	self.ammo_shells = parm4;
	self.ammo_nails = parm5;
	self.ammo_rockets = parm6;
	self.ammo_cells = parm7;
	self.armortype = parm9;
	
	if (!cu_W_Select(parm8))
		// your current weapon can be invalid if you fired your last shot but the
		// animation/attack_finished aren't done yet, and if you exit the map in 
		// this window, incoming parms have a bad .weapon
		cu_W_SelectBestWeapon();
		
	cu_armor_set_type(self);
}

// should this use localcmd()?
void(entity cu_client, string cu_savename) cu_autosave =
{
	// quake rerelease default behavior is to quicksave over s0,
	// so just go ahead and do that in that engine for consistency
	if (!cu_isKex)
	{
		stuffcmd(cu_client, "echo Autosaving...; wait; save ");
		stuffcmd(cu_client, cu_savename);
		stuffcmd(cu_client, "\n");
	}
}

