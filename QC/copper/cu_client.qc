/*
=============================================================================

PLAYER GAME EDGE FUNCTIONS

=============================================================================
*/

entity() cu_get_closest_client =
{
	if (coop == 0 || cu_clients == 1)
		return nextent(world);
		
	entity cu_next, cu_best;
	float cu_close, cu_dist;
	cu_close = cu_A_SHITLOAD;
	cu_next = nextent(world);
	while (cu_next.flags & cu_FL_CLIENT)
	{
		cu_dist = vlen(self.origin - cu_next.origin);
		if (cu_dist < cu_close)
		{
			cu_best = cu_next;
			cu_close = cu_dist;
		}
		cu_next = nextent(cu_next);
	}
	return cu_best;
}

entity(entity cu_start) cu_get_next_client =
{
	// nice trick from necros: clients are always the first entities after world
	entity cu_next;
	cu_next = nextent(cu_start);
	if ((cu_next.flags & cu_FL_CLIENT) == 0)
		cu_next = nextent(world);
	return cu_next;
}

/*
================================
transfer_keys
take a player's keys and give them to other clients

letting the player carry more than one of each key broke coop. keys don't vanish 
when touched so the game doesn't break if a key gets lost through death/lava/disconnect,
but a coop player could thus get a full load of keys within 15 frames by touching
one of these eternal keys. changing one requires fixing the other in a different way.
================================
*/
float() cu_TransferKeys =
{
	if (!coop) return cu_TRUE;
	
	float cu_silver, cu_gold, cu_give;
	entity cu_recipient;	
	
	cu_silver = cu_key_count_silver(self);
	cu_gold = cu_key_count_gold(self);
	
	// no keys
	if (!cu_silver && !cu_gold)
		return cu_TRUE;

	cu_recipient = cu_get_next_client(self);
	// if it's coop in name only and we're the only client, recipient will be self right away
	while (cu_recipient != self)
	{
		if (cu_silver > 0)
		{
			cu_give = 16 - cu_key_count_silver(cu_recipient);
			cu_give = cu_min(cu_give, cu_silver);
			if (cu_give)
			{
				if (cu_recipient.items & cu_IT_KEY1)
				{
					cu_recipient.worldtype += cu_give;
				}
				else
				{
					cu_recipient.items |= cu_IT_KEY1;
					cu_recipient.worldtype += cu_give - 1;
				}
			
				cu_silver -= cu_give;
				cu_key_take_silvers(self, cu_give);
				
				sprint(cu_recipient, "You got ");
				if (cu_give > 1)
				{
					sprint(cu_recipient, ftos(cu_give));
					cu_key_sprint_name(cu_recipient, cu_FALSE);
					sprint(cu_recipient, "s");
				}
				else
				{
					sprint(cu_recipient, "the");
					cu_key_sprint_name(cu_recipient, cu_FALSE);
				}
				sprint(cu_recipient, " from ");
				sprint(cu_recipient, self.netname);
				sprint(cu_recipient, "\n");
				stuffcmd(cu_recipient, "bf\n");
				sound (cu_recipient, cu_CHAN_ITEM, cu_key_sound(), 1, cu_ATTN_NORM);
			}
		}
		if (cu_gold > 0)
		{
			cu_give = 16 - cu_key_count_gold(cu_recipient);
			cu_give = cu_min(cu_give, cu_gold);
			if (cu_give)
			{
				if (cu_recipient.items & cu_IT_KEY2)
				{
					cu_recipient.worldtype += cu_give * 16;
				}
				else
				{
					cu_recipient.items |= cu_IT_KEY2;
					cu_recipient.worldtype += (cu_give - 1) * 16;
				}
			
				cu_gold -= cu_give;
				cu_key_take_golds(self, cu_give);
				
				sprint(cu_recipient, "You got ");
				if (cu_give > 1)
				{
					sprint(cu_recipient, ftos(cu_give));
					cu_key_sprint_name(cu_recipient, cu_TRUE);
					sprint(cu_recipient, "s");
				}
				else
				{
					sprint(cu_recipient, "the");
					cu_key_sprint_name(cu_recipient, cu_TRUE);
				}
				sprint(cu_recipient, " from ");
				sprint(cu_recipient, self.netname);
				sprint(cu_recipient, "\n");
				stuffcmd(cu_recipient, "bf\n");
				sound (cu_recipient, cu_CHAN_ITEM, cu_key_sound(), 1, cu_ATTN_NORM);
			}
		}
		// no keys left, all given away
		if (!cu_silver && !cu_gold)
		{
			self.worldtype = 0;
			self.items = cu_not(self.items, cu_IT_KEY1|cu_IT_KEY2);
			return cu_TRUE;
		}
		
		cu_recipient = cu_get_next_client(cu_recipient);
	}
	// we didn't give all the keys away, either all other players are full or we're the
	// only dude left on the server
	self.worldtype = cu_silver + cu_gold * 16;
	return cu_FALSE;
	// just leave the rest in our own inventory and we'll respawn with them ourselves
	
	// keys can still be 'lost' from the server in the following way:
	// if someone makes a map for copper (possible) with more than 15 of the same key in 
	// it (unlikely) and coop players (very unlikely) pick them all up and then
	// someone disconnects such that there isn't enough room in all other players' 
	// combined inventories for them (infinitesimal), the remainder have nowhere to go
	// and vanish with the disconnecting player
}

void() cu_set_respawn_delay =
{
	self.cu_lifetime_finished = time + 1;
	
	if (coop != 1 || cu_gameover || mapname == "start") return;
	
	if (cu_clientsAlive)
	{
		bprint ("5 seconds added to respawn delay\n");
		cu_coop_time = cu_max(time + 6, cu_coop_time + 5);
	}
	else
	{
		bprint ("All players have died\n");
		cu_coop_time = time + 2;
	}

}

void() cu_clear_respawning_flag_do =
{
	dprint("RESPAWNING flag cleared\n");
	serverflags = cu_not(serverflags, cu_SVFL_RESPAWNING);
	remove(self);
}

void() cu_clear_respawning_flag =
{
	entity cu_e = spawn();
	cu_e.think = cu_clear_respawning_flag_do;
	cu_e.nextthink = 2;
}

// restart the level
void() cu_restart =
{
	//localcmd ("restart\n");
	
	// preach's runefix:
	// put serverflags back to map's initial setting
	serverflags = cu_startingserverflags | cu_SVFL_RESPAWNING;	// notify starting autosaves not to autosave
	cu_reset_flag = cu_TRUE;			// request a reset to the parms
	localcmd("changelevel ");	// "change" to the same level
	localcmd(mapname);
	localcmd("\n");
}

// called by ClientKill and DeadThink
void() cu_respawn =
{
	if (deathmatch)
	{
		// make a copy of the dead body for appearances sake
		cu_CopyToBodyQueue (self);
		// set default spawn parms
		cu_SetNewParms ();
		// respawn		
		cu_PutClientInServer ();
		return;
	}
	if (coop)
	{
		if (coop == 1 && mapname != "start")
		{
			// no restarting if someone else has already exited
			if (cu_gameover)
			{
				centerprint(self, "You didn't make it!");
				sound (self, cu_CHAN_VOICE, "misc/talk.wav", 1, cu_ATTN_STATIC);
				return;
			}
			
			// must restart if all players are dead
			if (!cu_clientsAlive)
			{
				if (time < cu_coop_time)	// timer was bumped by 5 more, wait 2
				{
					centerprint(self, "Everyone is dead!");
					sound (self, cu_CHAN_VOICE, "misc/talk.wav", 1, cu_ATTN_STATIC);
				}
				else
					cu_restart();
					
				return;
			}
			
			if (time < cu_coop_time)
			{
				if (self.cu_nextmovesound < time)	// don't spam it
				{
					self.cu_nextmovesound = time + 1;
			
					// fart if it's not respawning time yet
					switch(ceil(cu_coop_time - time))
					{
					case 10:
						centerprint(self, "You can respawn in \b10\b seconds"); break;
					case 9:
						centerprint(self, "You can respawn in \b9\b seconds"); break;
					case 8:
						centerprint(self, "You can respawn in \b8\b seconds"); break;
					case 7:
						centerprint(self, "You can respawn in \b7\b seconds"); break;
					case 6:
						centerprint(self, "You can respawn in \b6\b seconds"); break;
					case 5:
						centerprint(self, "You can respawn in \b5\b seconds"); break;
					case 4:
						centerprint(self, "You can respawn in \b4\b seconds"); break;
					case 3:
						centerprint(self, "You can respawn in \b3\b seconds"); break;
					case 2:
						centerprint(self, "You can respawn in \b2\b seconds"); break;
					case 1:
						centerprint(self, "You can respawn in \b1\b second!"); break;
					default:
						centerprint(self, "You cannot respawn yet");
					}
					sound (self, cu_CHAN_VOICE, "misc/talk.wav", 1, cu_ATTN_STATIC);
				}
				return;
			}
		}

		// make a copy of the dead body for appearances sake
		cu_CopyToBodyQueue (self);
		
		if (coop == 1)
		{
			cu_bprint2(self.netname, " respawned\n");
			cu_SetCoopParms();		// lose ammo, keep weapons
		}
		else
			setspawnparms (self); // old 'respawn however you started the level' rules
			
		cu_PutClientInServer ();
		return;
	}
	
	cu_restart();
}



entity(entity cu_spot) cu_NextCoopStart =
{
	entity cu_next;
	cu_next = find(cu_spot, classname, "info_player_coop");
	if (cu_next == world)
		cu_next = find (world, classname, "info_player_coop");
	return cu_next;
}

/*
============
SelectSpawnPoint

Returns the entity to spawn at
============
*/
entity() cu_SelectSpawnPoint =
{
	entity cu_spot;
	float  cu_pcount;
	
	if (deathmatch)
	{
		cu_spot = cu_lastspawn;
		cu_pcount = ceil(random() * 4);
		while (cu_pcount)
		{
			cu_pcount--;
			
			cu_spot = find(cu_spot, classname, "info_player_deathmatch");
			if (cu_spot == world)
				cu_spot = find(world, classname, "info_player_deathmatch");
			if (cu_spot == world)
				error("This map does not support deathmatch! (no spawn points)\n");
		}
		cu_lastspawn = cu_spot;
		return cu_spot;
	}

	// choose a start point
	if (coop)
	{
		// spawn at the next coop start in the cycle not blocked by a client
		// if all are blocked, enter limbo waiting for the least recently used spot
		// if no coop spots, use the player start, also entering limbo if blocked
		
		cu_lastspawn = cu_NextCoopStart(cu_lastspawn);
		cu_spot = cu_lastspawn;
		do {
			if (!cu_teleport_check_for_client(cu_spot))
				break;
			cu_spot = cu_NextCoopStart(cu_spot);
		} while (cu_spot != cu_lastspawn && cu_spot != world);

		if (!cu_spot)
			cu_spot = find(world, classname, "info_player_start");
		if (!cu_spot)
			error ("SelectSpawnPoint: no info_player_start or info_player_coop on level");
		
		cu_lastspawn = cu_spot;
		return cu_lastspawn;
	}

	// testinfo_player_start is only found in regioned levels
	cu_spot = find (world, classname, "info_player_start_test");
	if (cu_spot)
		return cu_spot;

	if (serverflags)	// return with a rune to start
	{
		cu_spot = world;

		while (cu_TRUE)
		{
			cu_spot = find (cu_spot, classname, "info_player_start2");
			if (!cu_spot) break;
			
			// all
			if (cu_spot.style == 1 && ((cu_spot.cu_svflags & serverflags) == cu_spot.cu_svflags))
				break;
			// none
			else if (cu_spot.style == 2 && ((cu_spot.cu_svflags & serverflags) == 0))
				break;
			// any
			else if (cu_spot.style == 0 && ((cu_spot.cu_svflags & serverflags) != 0))
				break;
		}
		if (cu_spot)
			return cu_spot;
	}
	
	cu_spot = find (world, classname, "info_player_start");
	if (!cu_spot)
		error ("SelectSpawnPoint: no info_player_start on level");
	
	return cu_spot;
}


/*
===========
PutClientInServer

called each time a player is spawned
============
*/
void() cu_PutClientInServer =
{
	local	entity cu_spot;
	
	cu_spot = cu_SelectSpawnPoint();
	self.classname = "player";
	
	self.max_health = 100;
	self.health = self.max_health;
	
	self.takedamage = cu_DAMAGE_AIM;
	self.solid = cu_SOLID_SLIDEBOX;
	self.movetype = cu_MOVETYPE_WALK;
	self.cu_show_hostile = 0;
	self.flags = cu_FL_CLIENT;
	self.cu_customflags = 0;
	self.cu_air_finished = time + 12;
	self.dmg = 0;   		// initial water damage
	self.cu_super_damage_finished = 0;
	self.cu_radsuit_finished = 0;
	self.cu_invisible_finished = 0;
	self.cu_notrace = 0;	// fix for dying with the ring
	self.cu_invincible_finished = 0;
	self.cu_invincible_time = 0;
	self.effects = 0;
	self.enemy = world;

	cu_DecodeLevelParms();
	cu_SetChangeParms();
	cu_W_ResetWeaponState();
	
	// put global key type in the high bits so the CSQC hud gets to see it :/
	self.worldtype = (self.worldtype & 255) + world.worldtype * 256;

	// we respawned with keys not taken away, make sure .items reflects this
	if (self.worldtype & 15) self.items |= cu_IT_KEY1;
	if (self.worldtype & 240) self.items |= cu_IT_KEY2;
	
	self.cu_attack_finished = time;
	self.cu_th_pain = cu_player_pain;
	self.cu_th_die = cu_PlayerDie;
	
	self.deadflag = cu_DEAD_NO;
	cu_clientsAlive += 1;

// paustime is set by teleporters to keep the player from moving a while
	self.pausetime = 0;
	
	self.dmg_take = 0;
	self.dmg_save = 0;
	self.dmg_inflictor = world;
	self.velocity = cu_VEC_ORIGIN;

	self.origin = cu_spot.origin + '0 0 1';
	self.v_angle = self.angles = cu_spot.angles;
	self.fixangle = cu_TRUE;		// turn this way immediately
	self.cu_attack_finished = time + 0.1;	// don't shoot on the first frame if we clicked to spawn
	
	// yet another thing that doesn't work on the first frame
	if (cu_spot.fog_density != -1 || cu_spot.fog_color || cu_spot.cu_fog_sky != -1)
	{
		cu_fog_save(self, cu_spot.fog_density, cu_spot.fog_color, cu_spot.cu_fog_sky);
	}
	else if (world.fog_density != -1 || world.fog_color || world.cu_fog_sky != -1)
	{
		cu_fog_save(self, world.fog_density, world.fog_color, world.cu_fog_sky);
	}
	else
	{	// if there's a world fog key, save -1s so we don't stomp it
		cu_fog_save(self, -1, '0 0 0', -1);
	}

	if (self.cu_fog_sky == -1)
		self.cu_fog_sky = cvar("r_skyfog");
	cu_initCleanup = 2;

// oh, this is a hack!
	setmodel (self, "progs/eyes.mdl");
	cu_modelindex_eyes = self.modelindex;

	setmodel (self, "progs/player.mdl");
	cu_modelindex_player = self.modelindex;

	setsize (self, cu_VEC_HULL_MIN, cu_VEC_HULL_MAX);
	
	self.view_ofs = '0 0 22';

	cu_player_stand1();
	
	// spawns fire targets when spawned at
	cu_activator = self;
	cu_SUB_UseEntTargets(cu_spot);
	if (serverflags & cu_SVFL_RESPAWNING) cu_clear_respawning_flag();
	
	// enter teleport limbo instead of telefragging teammates
	if (coop)
	{
		if (cu_teleport_check_for_client(cu_spot))
		{
			cu_teleport_enter_limbo(self, cu_spot, cu_TRUE, cu_TRUE);
			return;
		}
		cu_teleport_flash();
	}
	else if (deathmatch)
	{
		cu_teleport_flash();
	}
	cu_spawn_tdeath (self.origin, self);
	
}

/*
===============================================================================

DEATHMATCH RULES

===============================================================================
*/

/*
go to the next level for deathmatch
only called if a time or frag limit has expired
*/
void() cu_NextLevel =
{
	local entity cu_o;

	if (mapname == "start")
	{
		if (!cvar("registered"))
		{
			mapname = "e1m1";
		}
		else if (!(serverflags & cu_SVFL_EPISODE1))
		{
			mapname = "e1m1";
			serverflags = serverflags | cu_SVFL_EPISODE1;
		}
		else if (!(serverflags & cu_SVFL_EPISODE2))
		{
			mapname = "e2m1";
			serverflags = serverflags | cu_SVFL_EPISODE2;
		}
		else if (!(serverflags & cu_SVFL_EPISODE3))
		{
			mapname = "e3m1";
			serverflags = serverflags | cu_SVFL_EPISODE3;
		}
		else if (!(serverflags & cu_SVFL_EPISODE4))
		{
			mapname = "e4m1";
			serverflags = serverflags - 7;	// cycle back to 1
		}

		cu_o = spawn();
		cu_o.map = mapname;
	}
	else
	{
		// find a trigger changelevel
		cu_o = find(world, classname, "trigger_changelevel");

		// go back to start if no trigger_changelevel
		if (!cu_o)
		{
			mapname = "start";
			cu_o = spawn();
			cu_o.map = mapname;
		}
	}

	cu_nextmap = cu_o.map;
	cu_gameover = cu_TRUE;
	
	if (cu_o.nextthink < time)
	{
		cu_o.think = cu_execute_changelevel;
		cu_o.nextthink = time + 0.1;
	}
}

/*
============
CheckRules

Exit multiplayer games upon conditions
============
*/
void() cu_CheckRules =
{
	float cu_timelimit;
	float cu_fraglimit;
	
	if (coop == 1 && cu_gameover && time > cu_coop_time)
	{
		cu_execute_changelevel();
		return;
	}
	
	if (cu_gameover || !deathmatch)
		return;
		
	cu_timelimit = cvar("timelimit") * 60;
	cu_fraglimit = cvar("fraglimit");
	
	if (cu_timelimit && time >= cu_timelimit)
	{
		cu_NextLevel ();
		return;
	}
	
	if (cu_fraglimit && self.frags >= cu_fraglimit)
	{
		cu_NextLevel ();
		return;
	}	
}



/*
//============================================================================

PLAYER THINKS AND MOVEMENT

//============================================================================
*/

// the player's health will always rot off to the soft max
// countdown is global now and not controlled by a touched megahealth thinking
void() cu_PlayerHealthTick =
{
	if ( time < self.cu_healthtime )
		return;
	if ( self.health <= 0 )
		return;
	
	float cu_hmax = self.max_health;
	
	if (self.health > cu_hmax)
	{
		if (self.waterlevel < cu_WL_EYES)
			self.dmg = 0;	// clear drown damage when overhealed
		self.health -= 1;
		self.cu_healthtime = time + 1;
	}
	else
	{
		if (self.dmg > 0 && (self.waterlevel < cu_WL_EYES || cu_has_biosuit(self) ) )
		{
			// recover damage taken from drowning
			//T_Heal(self, self.dmg, 0);
			self.health = cu_min(cu_hmax, self.health + ceil(self.dmg/2));
			self.dmg = cu_max(0, self.dmg - 1);
			self.cu_healthtime = time + 0.5;
		}	
	}
	
	
}	


/*
============
IntermissionThink

When the player presses attack or jump, change to the next level
============
*/
void() cu_IntermissionThink =
{
	// this was for coop pre-exit camera spectating, but it shudders really badly 
	// on non-server clients, so players just get to look around while waiting
//	self.angles = self.v_angle = self.goalentity.mangle;
//	self.fixangle = TRUE;
	self.flags = cu_not(self.flags, cu_FL_ONGROUND);

	if (self.impulse)
	{
		// cycle forward or back in the intermissions with weapnext/weapprev
		if (self.cu_attack_finished < time)
		{
			// stay on cameras twice as long if player cycles to them manually
			if (self.impulse == 10 || self.impulse == 14)
			{
				cu_move_player_to_next_intermission();
				self.cu_attack_finished = time + 0.2;
				self.cu_lifetime_finished = time + 12;
			}
			else if (self.impulse == 12 || self.impulse == 13)
			{
				cu_move_player_to_previous_intermission();
				self.cu_attack_finished = time + 0.2;
				self.cu_lifetime_finished = time + 12;
			}
		}
		self.impulse = 0;
	}
	
	if (!cu_intermission) return;
	
	// auto-cycle intermission camera after six seconds
	else if (time > self.cu_lifetime_finished)
	{
		cu_move_player_to_next_intermission();
		self.cu_lifetime_finished = time + 6;
	}
	
	if (time < cu_intermission_exittime)
		return;

	// start listening for input to leave
	if (!self.button0 && !self.button1 && !self.button2) {
		if (self.wait) cu_ExitIntermission ();
		self.wait = 0;
		return;
	}
	
	self.wait = 1;
}

/*
============
PlayerDeathThink

When the player presses attack or jump, respawn or restart
============
*/
void() cu_PlayerDeathThink =
{
	local float		cu_forward;

	if ((self.flags & cu_FL_ONGROUND))
	{
		cu_forward = vlen (self.velocity);
		cu_forward = cu_forward - 20;
		if (cu_forward <= 0)
			self.velocity = '0 0 0';
		else	
			self.velocity = cu_forward * normalize(self.velocity);
	}

	// fix noclip cmd hard-coded setting the player back to WALK
	if (self.movetype != cu_MOVETYPE_NOCLIP && self.movetype != cu_MOVETYPE_TOSS)
		self.movetype = cu_MOVETYPE_TOSS;

	if (self.flags & cu_FL_GODMODE && self.deadflag)
	{
		cu_CopyToBodyQueue (self);
		
		self.health = self.max_health;
		self.deadflag = cu_DEAD_NO;
		cu_clientsAlive += 1;
		self.takedamage = cu_DAMAGE_AIM;
		self.cu_air_finished = time + 12;
		self.dmg = 0;   		// initial water damage
		
		self.movetype = cu_MOVETYPE_WALK;
		self.solid = cu_SOLID_SLIDEBOX;
		setsize (self, cu_VEC_HULL_MIN, cu_VEC_HULL_MAX);
		self.flags = cu_FL_CLIENT;
		self.cu_customflags = 0;

		self.effects = 0;
		self.enemy = world;
		self.cu_show_hostile = 0;
		self.cu_attack_finished = time + 0.1;	// don't shoot on the first frame if we clicked to spawn
		
		cu_teleport_flash();
		cu_spawn_tdeath (self.origin, self);
		
		self.view_ofs = '0 0 22';
		self.modelindex = cu_modelindex_player;
		cu_player_stand1();
		cu_W_ResetWeaponState();
		
		return;
	}
	
	if (time < self.cu_lifetime_finished) return;
	
	// wait for all buttons released
	if (!self.button0 && !self.button1 && !self.button2) {
		if (self.wait)
			cu_respawn();
		
		self.wait = 0;
		return;
	}
	
	self.wait = 1;
}


void() cu_PlayerJump =
{

	float cu_upspeed;

	if (self.flags & cu_FL_WATERJUMP)
		return;
	
	if (self.waterlevel >= cu_WL_WAIST)
	{
		// fix for +jump not swimming upward as fast as +moveup
		cu_upspeed = cvar("cl_upspeed");
		if (self.waterlevel < cu_WL_EYES)
			cu_upspeed *= 0.5; // match vanilla swim values at the surface so 
							// we don't launch out of the water any higher
		else
			cu_upspeed *= 0.7;	// match moveup from SV_WaterMove
		
		if (self.watertype == cu_CONTENT_LAVA)
			cu_upspeed *= 0.5;	// originally 50
		else if (self.watertype == cu_CONTENT_SLIME)
			cu_upspeed *= 0.8;	// originally 80
		
		// scale upspeed to match WaterMove since playerjump gets called after it
		self.velocity_z = cu_upspeed - 0.8 * self.waterlevel * frametime * cu_upspeed;

		
		
		// play swimming sound
		if (self.cu_nextmovesound < time)
		{
			self.cu_nextmovesound = time + 1;
			if (random() < 0.5)
				sound (self, cu_CHAN_BODY, "misc/water1.wav", 1, cu_ATTN_NORM);
			else
				sound (self, cu_CHAN_BODY, "misc/water2.wav", 1, cu_ATTN_NORM);
		}

		return;
	}

	if (self.movetype != cu_MOVETYPE_NOCLIP)
	{
		if (!(self.flags & cu_FL_ONGROUND)) return;
		if ( !(self.flags & cu_FL_JUMPRELEASED) ) return;		// don't pogo stick
		sound (self, cu_CHAN_VOICE, "player/plyrjmp8.wav", 1, cu_ATTN_NORM);	// h00rt
	}
	
//	self.flags = self.flags - (self.flags & FL_JUMPRELEASED);
//	self.flags = self.flags - FL_ONGROUND;	// don't stairwalk
	self.flags = cu_not(self.flags, cu_FL_JUMPRELEASED | cu_FL_ONGROUND);	// don't stairwalk
	
	self.button2 = 0;
	self.velocity_z = self.velocity_z + 270;
}



/*
===========
WaterTest
test for liquids touching self from all directions

doesn't set self.waterlevel/self.watertype directly because it's also used by
monsters, and faffing with those values makes them spam constant splash noises
============
*/
vector() cu_WaterTest =
{
	if (self.movetype == cu_MOVETYPE_NOCLIP)
		return cu_VEC_ORIGIN;
		
	float cu_wl = 0;
	float cu_wt = 0;
	float cu_wp;
	
	// iw -- fix waterlevel detection
	vector cu_waist;

	// this is how the engine calculates the player's waist height (see
	// the "SV_CheckWater" function in "sv_phys.c")
	cu_waist = self.origin;
	cu_waist_z += (self.mins_z + self.maxs_z) * 0.5;

	//wp = pointcontents(self.origin);
	cu_wp = pointcontents(cu_waist);
	// iw -- END
	if (cu_wp < -2 && cu_wp > -6)
	{
		cu_wl += 1;
		cu_wt = cu_min(cu_wt,cu_wp);
	}
	cu_wp = pointcontents(self.origin + self.mins);
	if (cu_wp < -2 && cu_wp > -6)
	{
		cu_wl += 1;
		cu_wt = cu_min(cu_wt,cu_wp);
	}
	cu_wp = pointcontents(self.origin + self.maxs);
	if (cu_wp < -2 && cu_wp > -6)
	{
		cu_wl += 1;
		cu_wt = cu_min(cu_wt,cu_wp);
	}
	cu_wp = pointcontents(self.origin + self.view_ofs);
	if (cu_wp < -2 && cu_wp > -6)
	{
		cu_wl += 1;
		cu_wt = cu_min(cu_wt,cu_wp);
	}
	
	return cu_Vector(cu_min(3,cu_wl),cu_wt,0);
}

/*
===========
PlayerWaterTest
============
*/
void() cu_PlayerWaterTest =
{
	vector cu_wtt;
	cu_wtt = cu_WaterTest();
	float cu_wl, cu_wt;
	cu_wl = cu_wtt_x;
	cu_wt = cu_wtt_y;

	self.waterlevel = cu_max(cu_wl,self.waterlevel);
	self.watertype = cu_min(cu_wt,self.watertype);
}

/*
===========
WaterMove
============
*/
void() cu_WaterMove =
{
	if (self.movetype == cu_MOVETYPE_NOCLIP) {
		self.cu_air_finished = time + 120;
		self.waterlevel = 0;
		self.watertype = 0;
		return;
	}
	if (self.health < 0)
		return;
	
	if (self.waterlevel < cu_WL_EYES)	// view is above water
	{
		if (self.flags & cu_FL_UNDERWATER)
		{
			self.flags -= cu_FL_UNDERWATER;
			self.cu_nextmovesound = time + 0.5;
			if (random() < 0.5)
				sound (self, cu_CHAN_BODY, "misc/water1.wav", 1, cu_ATTN_NORM);
			else
				sound (self, cu_CHAN_BODY, "misc/water2.wav", 1, cu_ATTN_NORM);
		}
		if (time > 1)	// QSS-only hack for gasping after every level transition
		{
			if ((time > self.cu_air_finished ||
				time > self.cu_air_finished - 10) && self.dmg) // QVR: Copper as shipped (QC reads `a || b && c` as `(a || b) && c`)
			{
				sound (self, cu_CHAN_VOICE, "player/gasp2.wav", 1, cu_ATTN_NORM);
				self.cu_healthtime = time + 0.5;
			}
			else if (time > self.cu_air_finished - 9)
			{
				sound (self, cu_CHAN_VOICE, "player/gasp1.wav", 1, cu_ATTN_NORM);
			}
		}		
		// pentagram protects you from drowning, but if you spend enough time underwater,
		// you're instantly out of air when it ends
		self.cu_air_finished = cu_max(self.cu_invincible_finished, time + 12);
		//self.dmg = 0;	// remember damage taken to recover it slowly
	}
	else	// view is below the water
	{
		if (!(self.flags & cu_FL_UNDERWATER))
		{
			self.flags |= cu_FL_UNDERWATER;
			if (self.watertype != cu_CONTENT_LAVA)
			{
				if (self.cu_jump_flag < -300)
				{
					sound (self, cu_CHAN_OTHER, "misc/w_under2.wav", 1, cu_ATTN_NORM);
					local float cu_i = 0;
					local vector cu_b;
					while(cu_i > self.cu_jump_flag)
					{
						cu_i -= 75;
						cu_b = self.absmin + cu_vec_scale(self.size, cu_Vector(random(),random(),random()));
						if (pointcontents(cu_b) == cu_CONTENT_WATER)
							cu_bubble_spawn(cu_b);
					}
				}
				else
				{
					sound (self, cu_CHAN_OTHER, "misc/w_under.wav", 1, cu_ATTN_STATIC);
				}
			}
		}
		// if you don't catch your breath from the last drowning episode before diving 
		// again, you start to drown sooner the next time
		if (self.cu_air_finished < time + self.dmg / 2)
		{	// drown!
			if (self.cu_pain_finished < time)
			{
				cu_T_Damage (self, world, world, cu_max(self.dmg, 1), cu_DMGTYPE_DROWNING | cu_DMGTYPE_NOARMOR);
				self.cu_pain_finished = time + 1;
				
				if (!cu_has_invuln(self))	// don't advance the drowning timer with pent, or we
					self.dmg = cu_min(15, self.dmg + 1);	// could recover health we didn't lose
			}
		}
	}
	
	if (!self.waterlevel)
	{
		if (self.flags & cu_FL_INWATER)
		{	
			// play leave water sound
			sound (self, cu_CHAN_BODY, "misc/outwater.wav", 1, cu_ATTN_NORM);
			self.flags = self.flags - cu_FL_INWATER;
		}
		return;
	}

	if ( !(self.flags & cu_FL_INWATER) )
	{	// player enter water sound
		if (self.watertype == cu_CONTENT_LAVA)
			sound (self, cu_CHAN_BODY, "player/inlava.wav", 1, cu_ATTN_NORM);
		else if (self.watertype == cu_CONTENT_WATER)
		{
			if (self.cu_jump_flag < -300)
				sound (self, cu_CHAN_BODY, "player/h2ojump.wav", 1, cu_ATTN_NORM);
			else
				sound (self, cu_CHAN_BODY, "player/inh2o.wav", 1, cu_ATTN_NORM);
		}
		else if (self.watertype == cu_CONTENT_SLIME)
			sound (self, cu_CHAN_BODY, "player/slimbrn2.wav", 1, cu_ATTN_NORM);

		self.flags = self.flags + cu_FL_INWATER;
		self.cu_dmgtime = 0;
	}
	
	if (self.watertype == cu_CONTENT_LAVA)
	{	// do damage
		if (self.cu_dmgtime < time)
		{
			if (cu_has_biosuit(self))
				self.cu_dmgtime = time + 1;
			else
				self.cu_dmgtime = time + 0.2;

			if (self.waterlevel)
			{
				// biosuit protects from lava if it's 16u deep or less
				if (!(cu_has_biosuit(self) && pointcontents(self.origin - '0 0 7') != cu_CONTENT_LAVA))
					cu_T_Damage (self, world, world, 10 * self.waterlevel, cu_DMGTYPE_LAVA);
			}
		}
	}
	else if (self.watertype == cu_CONTENT_SLIME)
	{	// do damage
		if (self.cu_dmgtime < time && self.cu_radsuit_finished < time)
		{
			self.cu_dmgtime = time + 1;
			cu_T_Damage (self, world, world, 4 * self.waterlevel, cu_DMGTYPE_SLIME);
		}
	}
	
	if ( !(self.flags & cu_FL_WATERJUMP) )
	{
		// this is for water friction
		self.velocity = self.velocity - 0.8 * self.waterlevel * frametime * self.velocity;
	}
}

void() cu_CheckWaterJump =
{
	if (self.movetype == cu_MOVETYPE_NOCLIP)
		return;
		
	local vector cu_start, cu_end;

	
	// check for a jump-out-of-water
	makevectors (self.angles);
	cu_start = self.origin;
	cu_start_z = cu_start_z + 8; 
	
	if (v_forward_z < -0.25)
		return;		// don't waterjump if looking down into the water
		
	v_forward_z = 0;
	normalize(v_forward);
	cu_end = cu_start + v_forward*24;
	
	traceline (cu_start, cu_end, cu_TRUE, self);
	
	if (trace_fraction < 1)
	{
		// solid at waist
		cu_start_z = cu_start_z + self.maxs_z - 8;
		cu_end = cu_start + v_forward*24;
		self.movedir = trace_plane_normal * -50;
		
		traceline (cu_start, cu_end, cu_TRUE, self);
		
		if (trace_fraction == 1)
		{
			// open at eye level
			self.flags = self.flags | cu_FL_WATERJUMP;
			self.velocity_z = 225;
			self.flags = self.flags - (self.flags & cu_FL_JUMPRELEASED);
			self.teleport_time = time + 2;	// safety net
			
			return;
		}
	}
}


/*
================
CheckPowerups

Check for turning off powerups
================
*/
void() cu_CheckPowerups =
{
	if (self.health <= 0)
		return;

// invisibility
	if (self.cu_invisible_finished)
	{
		// sound and screen flash when items starts to run out
		if (self.cu_invisible_finished < time + 3)
		{
			if (self.cu_invisible_time == 1)
			{
				sprint (self, "Ring of Shadows' magic is fading ...\n");
				stuffcmd (self, "bf\n");
				sound (self, cu_CHAN_POWERUP, "items/inv2.wav", 1, cu_ATTN_NORM);
				self.cu_invisible_time = time + 1;
			}
			
			if (self.cu_invisible_time < time)
			{
				self.cu_invisible_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		// ambient whispering
		else if (self.cu_invisible_sound < time)
		{
			sound (self, cu_CHAN_POWERUP, "items/inv3.wav", 0.5, cu_ATTN_IDLE);
			self.cu_invisible_sound = time + ((random() * 3) + 1);
		}


		if (self.cu_invisible_finished < time)
		{	// just stopped
			self.items = cu_not(self.items, cu_IT_INVISIBILITY);
			//self.notrace = 0;
			self.cu_invisible_finished = 0;
			self.cu_invisible_time = 0;
		}
		
	// use the eyes
		self.frame = 0;
		self.modelindex = cu_modelindex_eyes;
	}
	else
		self.modelindex = cu_modelindex_player;	// don't use eyes

// invincibility
	if (self.cu_invincible_finished)
	{
// sound and screen flash when items starts to run out
		if (self.cu_invincible_finished < time + 3)
		{
			if (self.cu_invincible_time == 1)
			{
				sprint (self, "Protection is almost burned out ...\n");
				stuffcmd (self, "bf\n");
				sound (self, cu_CHAN_POWERUP, "items/protect2.wav", 1, cu_ATTN_NORM);
				self.cu_invincible_time = time + 1;
			}
			
			if (self.cu_invincible_time < time)
			{
				self.cu_invincible_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}
		
		if (self.cu_invincible_finished < time)
		{	// just stopped
			self.items = cu_not(self.items, cu_IT_INVULNERABILITY);
			self.cu_invincible_time = 0;
			self.cu_invincible_finished = 0;
		}
		if (self.cu_invincible_finished > time)
			self.effects = self.effects | cu_EF_DIMLIGHT;
		else
			self.effects = self.effects - (self.effects & cu_EF_DIMLIGHT);
	}

// super damage
	if (self.cu_super_damage_finished)
	{

// sound and screen flash when items starts to run out

		if (self.cu_super_damage_finished < time + 3)
		{
			if (self.cu_super_time == 1)
			{
				sprint (self, "Quad damage's power weakens ...\n");
				stuffcmd (self, "bf\n");
				sound (self, cu_CHAN_POWERUP, "items/damage2.wav", 1, cu_ATTN_NORM);
				self.cu_super_time = time + 1;
			}	  
			
			if (self.cu_super_time < time)
			{
				self.cu_super_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}

		if (self.cu_super_damage_finished < time)
		{	// just stopped
			self.items = cu_not(self.items, cu_IT_QUAD);
			self.cu_super_damage_finished = 0;
			self.cu_super_time = 0;
		}
		if (self.cu_super_damage_finished > time)
			self.effects = self.effects | cu_EF_DIMLIGHT;
		else
			self.effects = self.effects - (self.effects & cu_EF_DIMLIGHT);
	}	

// suit	
	if (self.cu_radsuit_finished)
	{
		self.cu_air_finished = time + 12;		// don't drown

// sound and screen flash when items starts to run out
		if (self.cu_radsuit_finished < time + 3)
		{
			if (self.cu_rad_time == 1)
			{
				sprint (self, "Air supply in Biosuit expiring ...\n");
				stuffcmd (self, "bf\n");
				sound (self, cu_CHAN_POWERUP, "items/suit2.wav", 1, cu_ATTN_NORM);
				self.cu_rad_time = time + 1;
			}
			
			if (self.cu_rad_time < time)
			{
				self.cu_rad_time = time + 1;
				stuffcmd (self, "bf\n");
			}
		}

		if (self.cu_radsuit_finished < time)
		{	// just stopped
			self.items = self.items - cu_IT_SUIT;
			self.cu_rad_time = 0;
			self.cu_radsuit_finished = 0;
		}
	}	

}

