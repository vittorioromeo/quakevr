/*
===========
ClientObituary

called when a player dies
============
*/
void(float cu_dmgtype) cu_ClientObituary =
{
	local	float cu_rnum;
	local	string cu_deathstring, cu_deathstring2;
	cu_rnum = random();
	
	entity cu_attacker = self.enemy;

	if (coop == 1 && mapname != "start")
	{
		// centerprint before bprint if you want players to see both
		entity cu_e;
		cu_e = nextent(world);
			
		while (cu_e.flags & cu_FL_CLIENT)
		{
			if (cu_e != self)
			{
				if (cu_clientsAlive == 1)
					cu_centerprint2(cu_e, self.netname, " is down -\nthere's no one left but you!");
				else
					cu_centerprint2(cu_e, self.netname, " is down!");
			}
			cu_e = nextent(cu_e);
		}
	}
	
	if (self.dmg_inflictor.cu_type == "explobox")
	{
		bprint(self.netname);
		bprint(" ");
		bprint(self.dmg_inflictor.deathtype);
		bprint("\n");
		
		return;
	}
	if (cu_attacker.deathtype != cu_string_null && cu_attacker.classname != "player" )
	{
		bprint(self.netname);
		bprint(" ");
		bprint(cu_attacker.deathtype);
		bprint("\n");
		
		if (deathmatch && (cu_attacker.classname == "trigger_void" || cu_attacker.classname == "func_void"))
			self.frags = self.frags - 1;
		return;
	}
	if (cu_attacker.classname == "teledeath")
	{
		bprint (self.netname);
		bprint (" was telefragged by ");
		bprint (cu_attacker.owner.netname);
		bprint ("\n");

		if (deathmatch)
			cu_attacker.owner.frags = cu_attacker.owner.frags + 1;
		return;
	}
	if (cu_attacker.classname == "trigger_void" || cu_attacker.classname == "func_void")
	{
		bprint (self.netname);
		bprint (" was lost to the void\n");
		if (deathmatch)
			self.frags = self.frags - 1;
		return;
	}
	if (cu_attacker.classname == "teledeath2")
	{
		bprint ("Satan's power deflects ");
		bprint (self.netname);
		bprint ("'s telefrag\n");

		if (deathmatch)
			self.frags = self.frags - 1;
		return;
	}

	if (cu_attacker.classname == "player")
	{
		if (self == cu_attacker)
		{
			// killed self
			cu_attacker.frags = cu_attacker.frags - 1;
			bprint (self.netname);
			
			if (self.weapon == cu_IT_LIGHTNING && self.waterlevel >= cu_WL_WAIST)
			{
				bprint (" discharges into the water\n");
				return;
			}
			if (self.weapon == cu_IT_GRENADE_LAUNCHER)
				bprint (" tries to put the pin back in\n");
			else if (self.weapon == cu_IT_ROCKET_LAUNCHER)
			{
				if (random() < 0.5)
					bprint (" rocket-jumps into the next world\n");
				else
					bprint (" is no rocket surgeon\n");
			}
			else if (self.dmg_inflictor.deathtype != cu_string_null)
			{
				bprint(" ");
				bprint(self.dmg_inflictor.deathtype);
				bprint("\n");
			}				
			else
				bprint (" becomes bored with life\n");
			return;
		}
		
		if ( (teamplay == 2) && (self.team > 0) && (self.team == cu_attacker.team) )
		{
			if (cu_rnum < 0.25)
				cu_deathstring = " mows down a teammate\n";
			else if (cu_rnum < 0.50)
				cu_deathstring = " checks their glasses\n";
			else if (cu_rnum < 0.75)
				cu_deathstring = " gets a frag for the other team\n";
			else
				cu_deathstring = " loses another friend\n";
			bprint (cu_attacker.netname);
			bprint (cu_deathstring);
			if (deathmatch)
				cu_attacker.frags = cu_attacker.frags - 1;
			return;
		}
		else
		{
			if (deathmatch)
				cu_attacker.frags = cu_attacker.frags + 1;

			cu_rnum = cu_attacker.weapon;
			if (cu_rnum == cu_IT_AXE)
			{
				if (random() < 0.5)
					cu_deathstring = " was axe-murdered by ";
				else
					cu_deathstring = " got the chop from ";
				cu_deathstring2 = "\n";
			}
			if (cu_rnum == cu_IT_SHOTGUN)
			{
				cu_deathstring = " chewed on ";
				cu_deathstring2 = "'s boomstick\n";
			}
			if (cu_rnum == cu_IT_SUPER_SHOTGUN)
			{
				cu_deathstring = " ate 2 loads of ";
				cu_deathstring2 = "'s buckshot\n";
			}
			if (cu_rnum == cu_IT_NAILGUN)
			{
				cu_deathstring = " was nailed by ";
				cu_deathstring2 = "\n";
			}
			if (cu_rnum == cu_IT_SUPER_NAILGUN)
			{
				cu_deathstring = " was punctured by ";
				cu_deathstring2 = "\n";
			}
			if (cu_rnum == cu_IT_GRENADE_LAUNCHER)
			{
				cu_deathstring = " eats ";
				cu_deathstring2 = "'s pineapple\n";
				if (self.health < -40)
				{
					cu_deathstring = " was gibbed by ";
					cu_deathstring2 = "'s grenade\n";
				}
			}
			if (cu_rnum == cu_IT_ROCKET_LAUNCHER)
			{
				cu_deathstring = " rides ";
				cu_deathstring2 = "'s rocket\n";
				if (self.health < -40)
				{
					cu_deathstring = " was gibbed by ";
					cu_deathstring2 = "'s rocket\n" ;
				}
			}
			if (cu_rnum == cu_IT_LIGHTNING)
			{
				cu_deathstring = " accepts ";
				if (cu_attacker.waterlevel >= cu_WL_WAIST)
					cu_deathstring2 = "'s discharge\n";
				else
					cu_deathstring2 = "'s shaft\n";
			}
			bprint (self.netname);
			bprint (cu_deathstring);
			bprint (cu_attacker.netname);
			bprint (cu_deathstring2);
		}
		return;
	}
	else
	{
		//self.frags = self.frags - 1;
		bprint (self.netname);

		// killed by a monster?
		if (cu_attacker.flags & cu_FL_MONSTER)
		{
			// moved monster obits to their individual *.qc files
			bprint (" was uninsured\n");
			return;
		}

		// tricks and traps
		if (cu_attacker.classname == "explo_box")
		{
			bprint (" blew up\n");
			return;
		}
		if (cu_attacker.solid == cu_SOLID_BSP && cu_attacker != world || (cu_dmgtype & cu_DMGTYPE_CRUSH) )
		{	
			bprint (" was squished\n");
			return;
		}
		if (cu_attacker.classname == "trap_shooter" || cu_attacker.classname == "trap_spikeshooter")
		{
			bprint (" was spiked\n");
			return;
		}
		if (cu_attacker.classname == "fireball")
		{
			bprint (" ate a lavaball\n");
			return;
		}
		if (cu_attacker.classname == "trigger_changelevel")
		{
			bprint (" tried to leave\n");
			return;
		}

		// liquid deaths
		if (cu_dmgtype & cu_DMGTYPE_DROWNING)
		{
			if (random() < 0.5)
				bprint (" sleeps with the fishes\n");
			else
				bprint (" sucks it down\n");
			return;
		}
		else if (cu_dmgtype & cu_DMGTYPE_SLIME)
		{
			if (random() < 0.5)
				bprint (" gulped a load of slime\n");
			else
				bprint (" can't exist on slime alone\n");
			return;
		}
		else if (cu_dmgtype & cu_DMGTYPE_LAVA)
		{
			if (self.waterlevel < cu_WL_EYES)
			{
				bprint (" burst into flames\n");
				return;
			}
			if (random() < 0.5)
				bprint (" turned into hot slag\n");
			else
				bprint (" visits the Volcano God\n");
			return;
		}
		// fell to their death?
		else if (cu_dmgtype & cu_DMGTYPE_FALLING)
		{
			if (random() < 0.5)
				bprint (" cratered\n");
			else
				bprint (" fell to their death\n");
			return;
		}

		// ELEPHINO
		bprint (" died\n");
	}
}



/*
=============================================================================

	SPAWNPOINTS

=============================================================================
*/

/*FGD
@baseclass base(Appearflags, Angle, Fog, Target) size(-16 -16 -24, 16 16 32) 
	color(0 255 0) model({ "path": ":progs/player.mdl" }) = PlayerClass []
*/

/*cu:QUAKED info_player_start (1 0 0) (-16 -16 -24) (16 16 24) 
The normal starting point for a level. Only one is allowed. Will fire its targets when a player is spawned here, with player as activator.

"angle" viewing angle when spawning
"fog_color"/"fog_density"/"fog_sky" set the fog when spawning at this spot (fog_sky 0 = no change, -1 = clear to 0)
*/
/*FGD
@PointClass base(PlayerClass) = info_player_start : "Player 1 start. Fires targets when a player spawns here." []
*/
void() cu_info_player_start =
{
	setsize(self,cu_VEC_HULL_MIN,cu_VEC_HULL_MAX);	// for telefrag testing
	self.mangle = self.angles;
	cu_fog_fixKeys();
}


/*cu:QUAKED info_player_start2 (1 0 0) (-16 -16 -24) (16 16 24) 
Only used on start map for the return point from an episode. Will fire its targets when a player is spawned here, with player as activator.

"angle" viewing angle when spawning
"fog_color"/"fog_density"/"fog_sky" set the fog when spawning at this spot (fog_sky 0 = no change, -1 = clear to 0)
"svflags" set the bits for a specific set of runes/serverflags you want to test
"style" how to interpret svflags:
	0: player will spawn here if they have any of the runes in svflags
	1: player will only spawn here if they have all of them
	2: player will NOT spawn here if they have any of them
*/
/*FGD
@PointClass base(PlayerClass) = info_player_start2 : "Player episode return point. Fires targets when a player spawns here." [
	svflags(Flags) =
	[
		1		: "Episode 1" : 0
		2		: "Episode 2" : 0
		4		: "Episode 3" : 0
		8		: "Episode 4" : 0
		16		: "Bit 5" :  0
		32		: "Bit 6" :  0
		64		: "Bit 7" :  0
		128		: "Bit 8" :  0
		256		: "Bit 9" :  0
		512		: "Bit 10" : 0
		1024	: "Bit 11" : 0
		2048	: "Bit 12" : 0
		4096	: "Bit 13" : 0
		8192	: "Bit 14" : 0
		16384	: "Bit 15" : 0
		32768	: "Bit 16" : 0
		65536	: "Bit 17" : 0
		131072	: "Bit 18" : 0
		262144	: "Bit 19" : 0
		524288	: "Bit 20" : 0
		1048576	: "Bit 21" : 0
	]
	style(Choices) : "Requirement" : 0 =
	[
		0 : "Have Any"
		1 : "Must Have All"
		2 : "Must Not Have Any"
	]
]
*/
void() cu_info_player_start2 =
{
	setsize(self,cu_VEC_HULL_MIN,cu_VEC_HULL_MAX);	// for telefrag testing
	self.mangle = self.angles;
	cu_fog_fixKeys();
	
	if (!self.cu_svflags)
		self.cu_svflags = 2097151;	// all bits up to 21
	if (self.style < 0 || self.style > 2)
		self.style = 0;
}


/*cu:QUAKED info_player_start_test (1 0 0) (-16 -16 -24) (16 16 24) USE
Debug starting point for a level.  Overrides info_player_start if present and 'USE' is checked, does nothing if 'USE' is not checked. Will fire its targets when a player is spawned, here with player as activator.

"angle" viewing angle when spawning
"fog_color"/"fog_density"/"fog_sky" set the fog when spawning at this spot (fog_sky 0 = no change, -1 = clear to 0)
*/
/*FGD
@PointClass base(PlayerClass) = info_player_start_test : "Developer-only spawn point" [
	spawnflags(flags) = [
		1 : "Spawn at this one plz" : 0
	]
]
*/
void() cu_info_player_start_test =
{
	if (!(self.spawnflags & 1))
	{
		remove(self);
		return;
	}
	self.mangle = self.angles;
	cu_fog_fixKeys();
}
void() cu_testplayerstart = {cu_info_player_start_test();}	// back compat with old editors that use regioned compiles

/*cu:QUAKED info_player_deathmatch (1 0 1) (-16 -16 -24) (16 16 24)
potential spawning position for deathmatch games

"angle" viewing angle when spawning
"fog_color"/"fog_density"/"fog_sky" set the fog when spawning at this spot (fog_sky 0 = no change, -1 = clear to 0)
*/
/*FGD
@PointClass base(PlayerClass) = info_player_deathmatch : "Deathmatch start" []
*/
void() cu_info_player_deathmatch =
{
	cu_fog_fixKeys();
}

// dumb way to make coop starts visible/invisible to the cyclical spawnpoint search 
// code without making that code overly complex
void(float cu_unlock) cu_coop_lock =
{
	if (cu_unlock)
		self.classname = "info_player_coop";
	else
		self.classname = "info_player_coop_notyet";
}

void() cu_coop_enable =
{
	self.classname = "info_player_coop";
	self.use = cu_SUB_Null;
}

/*cu:QUAKED info_player_coop (1 0 1) (-16 -16 -24) (16 16 24) TRIGGER_FIRST
Potential spawning position(s) for coop games. Will fire its targets when a player is spawned here, with player as activator.

"angle" viewing angle when spawning
"fog_color"/"fog_density"/"fog_sky" set the fog when spawning at this spot (fog_sky 0 = no change, -1 = clear to 0)

TRIGGER_FIRST - this start won't be used to spawn coop players until triggered, so respawning players don't have to walk all the way back to the action
*/
/*FGD
@PointClass base(PlayerClass, Targetname) = info_player_coop : "Player cooperative start" [
	spawnflags(flags) = [
		1 : "Trigger first" : 0
	]
]
*/
void() cu_info_player_coop =
{
	self.mangle = self.angles;
	if (self.spawnflags & 1)
	{
		self.classname = "info_player_coop_notyet";
		self.use = cu_coop_enable;
	}
	self.cu_lock = cu_coop_lock;
	cu_fog_fixKeys();
	setsize(self,cu_VEC_HULL_MIN,cu_VEC_HULL_MAX);	// for telefrag testing
}