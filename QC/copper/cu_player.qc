void(entity cu_attacker, float cu_damage) cu_player_pain =
{
	if (self.weaponframe)
		return;

	if (cu_has_invis(self))
		return;		// eyes don't have pain frames

	if (self.weapon == cu_IT_AXE )
		cu_player_axpain1 ();
	else
		cu_player_pain1 ();
}

void() cu_DeathBubblesSpawn =
{
	entity	cu_bubble;
	if (self.owner.waterlevel < 3)
	{
		remove(self);	// remove bubble spawner
		return;
	}
	cu_bubble = cu_bubble_spawn(self.owner.origin + '0 0 24');

	self.nextthink = time + 0.1;
	self.think = cu_DeathBubblesSpawn;
	self.cu_air_finished += 1;
	if (self.cu_air_finished >= self.cu_bubble_count)
		remove(self);
}

void(float cu_num_bubbles) cu_DeathBubbles =
{
local entity	cu_bubble_spawner;
	
	cu_bubble_spawner = spawn();
	setorigin (cu_bubble_spawner, self.origin);
	cu_bubble_spawner.movetype = cu_MOVETYPE_NONE;
	cu_bubble_spawner.solid = cu_SOLID_NOT;
	cu_bubble_spawner.nextthink = time + 0.1;
	cu_bubble_spawner.think = cu_DeathBubblesSpawn;
	cu_bubble_spawner.cu_air_finished = 0;
	cu_bubble_spawner.owner = self;
	cu_bubble_spawner.cu_bubble_count = cu_num_bubbles;
	return;
}


void() cu_DeathSound =
{
local float		cu_rs;

	// water death sounds
	if (self.waterlevel >= 3 && !cu_has_biosuit(self))
	{
		if (self.watertype == cu_CONTENT_WATER || self.watertype == cu_CONTENT_SLIME)
		{
			cu_DeathBubbles(20);
			sound (self, cu_CHAN_VOICE, "player/h2odeath.wav", 1, cu_ATTN_NONE);
			return;
		}
	}
	
	cu_rs = rint ((random() * 4) + 1);
	if (cu_rs == 1)
		self.noise = "player/death1.wav";
	if (cu_rs == 2)
		self.noise = "player/death2.wav";
	if (cu_rs == 3)
		self.noise = "player/death3.wav";
	if (cu_rs == 4)
		self.noise = "player/death4.wav";
	if (cu_rs == 5)
		self.noise = "player/death5.wav";

	sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NONE);
	return;
}


void() cu_PlayerDead =
{
	self.nextthink = -1;
// allow respawn after a certain time
	self.deadflag = cu_DEAD_DEAD;
}

void() cu_GibPlayer =
{
	cu_PlayerDead();
	//self.deadflag = DEAD_DEAD;

	if (cu_damage_attacker.classname == "trigger_void" || cu_damage_attacker.classname == "func_void" )
	{
		sound (self, cu_CHAN_VOICE, cu_damage_attacker.noise2, 1, cu_ATTN_NONE);
		cu_TintScreenColor(self, 255, '32 0 0');
		//stuffcmd( self, "\nv_cshift 16 0 0 255\n");
		return;
	}
	
	if (cu_damage_attacker.classname == "teledeath")
	{
		sound (self, cu_CHAN_VOICE, "player/teledth1.wav", 1, cu_ATTN_NONE);
	}
	else if (cu_damage_attacker.classname == "teledeath2")
	{
		sound (self, cu_CHAN_VOICE, "player/teledth1.wav", 1, cu_ATTN_NONE);
	}
	else
	{
		if (random() < 0.5)
			sound (self, cu_CHAN_VOICE, "player/gib.wav", 1, cu_ATTN_NONE);
		else
			sound (self, cu_CHAN_VOICE, "player/udeath.wav", 1, cu_ATTN_NONE);
	}	
	cu_GibSpray ("progs/h_player.mdl", self.health);	
}

void() cu_PlayerDie =
{
	local	float	cu_i;
	
	self.items = self.items - (self.items & cu_IT_INVISIBILITY);
	self.cu_invisible_finished = 0;	// don't die as eyes
	self.cu_invincible_finished = 0;
	self.cu_super_damage_finished = 0;
	self.cu_radsuit_finished = 0;
	self.modelindex = cu_modelindex_player;	// don't use eyes

	self.items = cu_not(self.items, cu_IT_INVISIBILITY | cu_IT_INVULNERABILITY | cu_IT_SUIT | cu_IT_QUAD);
	self.effects = 0;

	cu_clientsAlive -= 1;

	cu_set_respawn_delay();	// coop 1 respawn lockout
	
	if ((deathmatch || coop) && mapname != "start")
		cu_DropBackpack();
	if (coop) // save the keys
		cu_TransferKeys();
	
	self.weaponmodel = cu_string_null;
	self.view_ofs = '0 0 0';
//	self.deadflag = DEAD_DYING;	// moved to Killed() so I can use this flag on monsters
	self.solid = cu_SOLID_NOT;
	self.flags = self.flags - (self.flags & cu_FL_ONGROUND);
	self.movetype = cu_MOVETYPE_TOSS;
	//setsize(self, '-16 -16 -16', '16 16 8');
	if (self.velocity_z < 10)
		self.velocity_z = self.velocity_z + random()*300;

	cu_player_spawn_void_monitor();
	
	if (self.health < -40)
	{
		cu_GibPlayer ();
		return;
	}

	cu_DeathSound();
	
	self.angles_x = 0;
	self.angles_z = 0;
	
	if (self.weapon == cu_IT_AXE )
	{
		cu_player_die_ax1 ();
		return;
	}
	
	cu_i = 1 + floor(random()*6);
	
	if (cu_i == 1)
		cu_player_diea1();
	else if (cu_i == 2)
		cu_player_dieb1();
	else if (cu_i == 3)
		cu_player_diec1();
	else if (cu_i == 4)
		cu_player_died1();
	else
		cu_player_diee1();

}

void() cu_set_suicide_frame =
{	// used by kill command and disconnect command
	if (self.model != "progs/player.mdl")
		return;	// already gibbed
	self.frame = $deatha11;
	self.solid = cu_SOLID_NOT;
	self.movetype = cu_MOVETYPE_TOSS;
	self.deadflag = cu_DEAD_DEAD;
	self.nextthink = -1;
}


