void()	cu_player_axe =
{
	float cu_r;
	cu_r = random();
	if (cu_r < 0.25)
		self.frame = $axatt1;
		//player_axe1();
	else if (cu_r<0.5)
		self.frame = $axattb1;
		//player_axeb1();
	else if (cu_r<0.75)
		self.frame = $axattc1;
		//player_axec1();
	else
		self.frame = $axattd1;
		//player_axed1();
		
	self.cu_think1 = cu_player_axecyc;
}

//============================================================================

void() cu_player_nail =
{
	if (!self.button0)
	{
		cu_player_run();
		return;
	}
		
	self.effects |= cu_EF_MUZZLEFLASH;

	if (self.frame != $nailatt1) self.frame = $nailatt1;
	else self.frame += 1;
	self.think = cu_player_nail;
	self.nextthink = time + 0.125;	// TODO: oh fuck it, it works, you're never touching this again
	
	self.weaponframe = self.cu_cnt + 1;
}

//============================================================================

void() cu_player_light1   =[$light1, cu_player_light2  ] 
{
	if (!self.button0 || (self.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO)))
	{
		cu_player_run();
		return;
	}

	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	self.weaponframe = self.weaponframe + 1;
	if (self.weaponframe == 5)
		self.weaponframe = 1;

	cu_W_FireLightning();
	self.cu_attack_finished = time + 0.2;
}
void() cu_player_light2   =[$light2, cu_player_light1  ]
{
	if (!self.button0 || (self.cu_customflags & (cu_CFL_PLUNGE|cu_CFL_LIMBO)))
	{
		cu_player_run();
		return;
	}
	
	self.effects = self.effects | cu_EF_MUZZLEFLASH;
	self.weaponframe = self.weaponframe + 1;
	if (self.weaponframe == 5)
		self.weaponframe = 1;

	cu_W_FireLightning();
	self.cu_attack_finished = time + 0.2;
}

