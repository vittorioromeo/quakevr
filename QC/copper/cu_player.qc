void()	cu_player_stand1 =[	$axstnd1,	cu_player_stand1	]
{
	cu_W_SetIdleWeaponFrame();
	if (self.velocity_x || self.velocity_y)
	{
		self.cu_walkframe=0;
		cu_player_run();
		return;
	}

	if (self.weapon == cu_IT_AXE )
	{
		if (self.cu_walkframe >= 12)
			self.cu_walkframe = 0;
		self.frame = $axstnd1 + self.cu_walkframe;
	}
	else
	{
		if (self.cu_walkframe >= 5)
			self.cu_walkframe = 0;
		self.frame = $stand1 + self.cu_walkframe;
	}
	self.cu_walkframe = self.cu_walkframe + 1;	
}

void()	cu_player_run =[	$rockrun1,	cu_player_run	]
{
	cu_W_SetIdleWeaponFrame();
	if (!self.velocity_x && !self.velocity_y)
	{
		self.cu_walkframe=0;
		cu_player_stand1();
		return;
	}

	if (self.weapon == cu_IT_AXE )
	{
		if (self.cu_walkframe >= 6)
			self.cu_walkframe = 0;
		self.frame = $axrun1 + self.cu_walkframe;
	}
	else
	{
		if (self.cu_walkframe >= 6)
			self.cu_walkframe = 0;
		self.frame = self.frame + self.cu_walkframe;
	}
	self.cu_walkframe = self.cu_walkframe + 1;
}

void()	cu_player_shot1 =	[$shotatt1, cu_player_shot2	] {self.weaponframe=1;
self.effects = self.effects | cu_EF_MUZZLEFLASH;}
void()	cu_player_shot2 =	[$shotatt2, cu_player_shot3	] {self.weaponframe=2;}
void()	cu_player_shot3 =	[$shotatt3, cu_player_shot4	] {self.weaponframe=3;}
void()	cu_player_shot4 =	[$shotatt4, cu_player_shot5	] {self.weaponframe=4;}
void()	cu_player_shot5 =	[$shotatt5, cu_player_shot6	] {self.weaponframe=5;}
void()	cu_player_shot6 =	[$shotatt6, cu_player_run	] {self.weaponframe=6;}



/*
========================================
Player Axe Thinks

this was done to decouple the player's in-world animations from the weaponframe cycle,
so that the weapon code can take over the think cycle directly and drive (normally
invisible) player animation as a secondary consideration, rather than vice versa
========================================
*/


// simplified little machine for cycling through an axe attack anim, then the
// axe run to artificially extend the anim up to 1.2 seconds
void()	cu_player_axecyc =
{
	self.frame += 1;
	if (cu_mod(cu_max(0,self.frame - $axatt1), 6) == 0)	// conveniently all the same length
	{
		self.frame = $axrun1;
	}
}


void()	cu_player_axe1 =	[$axatt1, cu_player_axe2	] {cu_W_AxeWhiffSound();}
void()	cu_player_axe2 =	[$axatt2, cu_player_axe3	] {self.weaponframe += 1;}
void()	cu_player_axe3 =	[$axatt3, cu_player_axe4	] {self.weaponframe += 1; cu_W_FireAxe();}
void()	cu_player_axe4 =	[$axatt4, cu_player_axe5	] {self.weaponframe += 1;}
void()	cu_player_axe5 =	[$axatt5, cu_player_run	] {self.weaponframe += 1;}
void()	cu_player_axe6 =	[$axatt6, cu_player_run	] {self.weaponframe += 1;}

