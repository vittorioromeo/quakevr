void() cu_PainSound = {
	float		cu_rs;

	if (self.health < 0)
		return;
	if (cu_damage_attacker.classname == "teledeath")
	{
		sound (self, cu_CHAN_VOICE, "player/teledth1.wav", 1, cu_ATTN_NONE);
		return;
	}

	// water pain sounds
	if (self.watertype == cu_CONTENT_WATER && self.waterlevel >= 3 && !cu_has_biosuit(self))
	{
		cu_DeathBubbles(1);
		if (random() > 0.5)
			sound (self, cu_CHAN_VOICE, "player/drown1.wav", 1, cu_ATTN_NORM);
		else
			sound (self, cu_CHAN_VOICE, "player/drown2.wav", 1, cu_ATTN_NORM);
		return;
	}

	// slime/lava pain sounds
	if (( (self.watertype == cu_CONTENT_SLIME || self.watertype == cu_CONTENT_LAVA) && cu_damage_attacker == world) || 
		cu_damage_attacker.classname == "fireball")
	{
		if (random() > 0.5)
			sound (self, cu_CHAN_VOICE, "player/lburn1.wav", 1, cu_ATTN_NORM);
		else
			sound (self, cu_CHAN_VOICE, "player/lburn2.wav", 1, cu_ATTN_NORM);
		return;
	}

	// don't make multiple pain sounds right after each other
	if (self.cu_pain_finished > time)
	{
		self.cu_customflags = cu_not(self.cu_customflags, cu_CFL_AXEHITME );
		return;
	}
	self.cu_pain_finished = time + 0.5;


// ax pain sound
	if (self.cu_customflags & cu_CFL_AXEHITME)
	{
		self.cu_customflags = cu_not(self.cu_customflags, cu_CFL_AXEHITME );
		sound (self, cu_CHAN_VOICE, "player/axhit1.wav", 1, cu_ATTN_NORM);
		return;
	}
	

	cu_rs = rint((random() * 5) + 1);

	self.noise = cu_string_null;
	if (cu_rs == 1)
		self.noise = "player/pain1.wav";
	else if (cu_rs == 2)
		self.noise = "player/pain2.wav";
	else if (cu_rs == 3)
		self.noise = "player/pain3.wav";
	else if (cu_rs == 4)
		self.noise = "player/pain4.wav";
	else if (cu_rs == 5)
		self.noise = "player/pain5.wav";
	else
		self.noise = "player/pain6.wav";

	sound (self, cu_CHAN_VOICE, self.noise, 1, cu_ATTN_NORM);
	return;
}

void()	cu_player_pain1 =	[	$pain1,	cu_player_pain2	] {cu_PainSound();self.weaponframe=0;}
void()	cu_player_pain2 =	[	$pain2,	cu_player_pain3	] {}
