<?xml version="1.0" encoding="utf-8"?>
<!-- Quake VR on Android (the Quest): docs/vr-port/QUEST_PLAN.md, C3 and C4a. An immersive OpenXR app (the VR category,
     head tracking); the lines marked vr-only are left out of the flat-panel APK (Android/package_apk.sh with
     QVR_ANDROID_FLAT=1: the headset runs it as a 2D panel). The game's files: the app's external files folder
     (/sdcard/Android/data/com.vittorioromeo.quakevr/files: id1/ and quakevr/), which needs no permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.1.0"
    android:installLocation="auto">

    <!-- OpenGL ES 3.2 (the engine's ES profile) -->
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" /> <!-- vr-only -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Multiplayer (the room service, joining and hosting: sockets) and voice chat's microphone (asked for at run
         time the first time voice chat opens it: vr_voicechat.cpp). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Body tracking (the tracked elbows and legs: vr_bodytrack_xr.cpp, which asks for the grant at run time before
         making the tracker): Horizon OS's run-time permission and the older systems' name, the feature optional. -->
    <uses-feature android:name="com.oculus.software.body_tracking" android:required="false" /> <!-- vr-only -->
    <uses-permission android:name="com.meta.permission.FOCUSED_BODY_TRACKING" /> <!-- vr-only -->
    <uses-permission android:name="com.oculus.permission.BODY_TRACKING" /> <!-- vr-only -->
    <!-- Khronos' OpenXR loader (its AAR's manifest, which no Gradle merge brings in here): the runtime broker and the
         runtime's and API layers' services. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application android:label="Quake VR"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true"
        android:debuggable="true">
        <!-- debuggable: the development APK (debug key): `adb shell run-as` reads the game's files (eye images, logs,
             saves: 0660 to adb's shell) and simpleperf profiles it; the release APK (package_apk.sh with
             QVR_ANDROID_RELEASE=1, docs/vr-port/ANDROID_RELEASE.md) turns it off. -->

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|quest3s" />

        <activity android:name="com.vittorioromeo.quakevr.QuakeVRActivity"
            android:label="Quake VR"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <!-- The system's menus over the game without ending its session (focus lost and back: OpenXR's states). -->
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" /> <!-- vr-only -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" /> <!-- vr-only -->
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" /> <!-- vr-only -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
