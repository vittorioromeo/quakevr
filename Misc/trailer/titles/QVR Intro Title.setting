						Intermediate1 = Input { Value = "((x*w1 - n1)/max(n3, 1) - 0.40)/0.85", },
						Intermediate2 = Input { Value = "min(max(i1, 0), 1)", },
						Intermediate3 = Input { Value = "n5*n4*0.09*if(i1 > 0, if(i1 < 1, sin(180*i2^0.55), 0), 0)", },
						Intermediate4 = Input { Value = "abs(y*h1 - n2 - n4*(0.16 - 0.36*(1 - (1 - i2)^2)))", },
						RedExpression = Input { Value = "max(r1, min(1, max(0, i3 - i4 + 0.5))*min(1, i3))", },
						GreenExpression = Input { Value = "max(g1, min(1, max(0, i3 - i4 + 0.5))*min(1, i3))", },
						BlueExpression = Input { Value = "max(b1, min(1, max(0, i3 - i4 + 0.5))*min(1, i3))", },
						AlphaExpression = Input { Value = "max(a1, 0.9*min(1, max(0, i3 + n6 - i4 + 0.5))*min(1, i3), min(1, max(0, i3 - i4 + 0.5))*min(1, i3))", },
