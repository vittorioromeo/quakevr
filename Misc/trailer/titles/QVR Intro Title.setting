			Tools = ordered() {
				Ctl = Background {
					NameSet = true,
					Inputs = {
						EffectMask = Input { SourceOp = "ScrimMask", Source = "Mask", },
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						TopLeftRed = Input { Value = 0.012, },
						TopLeftGreen = Input { Value = 0.008, },
						TopLeftBlue = Input { Value = 0.008, },
						TopLeftAlpha = Input { Expression = "ScrimAmount*Env", },
						Line1 = Input { Value = "Quake VR", },
						Blood = Input { Value = 1, },
						AccentRed = Input { Value = 0.42, },
						AccentGreen = Input { Value = 0.015, },
						AccentBlue = Input { Value = 0.01, },
						MetalRed = Input { Value = 0.56, },
						MetalGreen = Input { Value = 0.46, },
						MetalBlue = Input { Value = 0.34, },
						Relief = Input { Value = 1, },
						SweepGain = Input { Value = 1, },
						SweepDir = Input { Value = 0, },
						SweepStart = Input { Value = 24, },
						SweepFrames = Input { Value = 110, },
						Intensity = Input { Value = 1, },
						L1Start = Input { Value = 0, },
						L1In = Input { Value = 46, },
						L2Start = Input { Value = 34, },
						L2In = Input { Value = 44, },
						RuleStart = Input { Value = 66, },
						RuleIn = Input { Value = 26, },
						L3Start = Input { Value = 84, },
						L3In = Input { Value = 34, },
						OutFrames = Input { Value = 36, },
						OutAt = Input { Value = 0, },
						Backdrop = Input { Value = 0, },
						ScrimAmount = Input { Value = 0.55, },
						ShadowOpacity = Input { Value = 0.8, },
						ShadowSoftness = Input { Value = 12, },
						ShadowOffset = Input { Value = 8, },
						VOffset = Input { Value = 0, },
						RuleWidth = Input { Value = 0.6, },
						L3Track = Input { Value = 1.16, },
						GapD = Input { Value = 0.075, },
						Gap12 = Input { Value = 0.07, },
						Gap3 = Input { Value = 0.034, },
						LT = Input { Expression = "time - comp.RenderStart", },
						OutStart = Input { Expression = "iif(OutAt > 0, OutAt, comp.RenderEnd - comp.RenderStart + 1 - OutFrames)", },
						P1 = Input { Expression = "min(max((LT - L1Start)/max(L1In, 1), 0), 1)", },
						P2 = Input { Expression = "min(max((LT - L2Start)/max(L2In, 1), 0), 1)", },
						PR = Input { Expression = "min(max((LT - RuleStart)/max(RuleIn, 1), 0), 1)", },
						P3 = Input { Expression = "min(max((LT - L3Start)/max(L3In, 1), 0), 1)", },
						POut = Input { Expression = "min(max((LT - OutStart)/max(OutFrames, 1), 0), 1)", },
						E1 = Input { Expression = "1 - (1 - P1)^2.4", },
						ER = Input { Expression = "1 - (1 - PR)^3", },
						E3 = Input { Expression = "1 - (1 - P3)^2.4", },
						EOut = Input { Expression = "POut^1.6", },
						Env = Input { Expression = "min(1, max(P1, P2)*1.6)*(1 - EOut)", },
						Flick = Input { Expression = "1 - min(1, Intensity)*0.7*max(1 - P1, POut)*iif(abs(sin(LT*78.233 + LT*LT*0.131)) > 0.6, 1, 0)", },
						Torch = Input { Expression = "0.9 + 0.1*sin(LT*0.23)*sin(LT*0.071 + 1.3)", },
						Low1 = Input { Expression = "1.06 - 1.12*E1 + 1.15*EOut", },
						Low2 = Input { Expression = "-0.06 + 1.15*EOut", },
						Low3 = Input { Expression = "1.06 - 1.12*E3 + 1.15*EOut", },
						Mold = Input { Expression = "min(1, max(0, (LT - L2Start)/max(0.2*L2In, 1)))", },
						Flood = Input { Expression = "1 - (1 - min(1, max(0, (LT - L2Start - 0.18*L2In)/max(0.82*L2In, 1))))^1.7", },
						Splash = Input { Expression = "min(1, max(0, (LT - L2Start - 0.16*L2In)/8))", },
						Grow = Input { Expression = "min(1, max(0, (LT - L2Start - 0.45*L2In)/(L2In + 140)))^0.5", },
						Pool = Input { Expression = "min(1, max(0, (LT - L2Start - 0.7*L2In)/(L2In + 100)))^0.6", },
						Shake = Input { Expression = "Intensity*iif(LT > L2Start + 0.16*L2In, 0.8^(LT - L2Start - 0.16*L2In), 0)*(1 - EOut)", },
						PSweep = Input { Expression = "min(max((LT - SweepStart)/max(SweepFrames, 1), 0), 1)", },
						USweep = Input { Expression = "iif(SweepDir == 0, PSweep*PSweep*(3 - 2*PSweep), 1 - PSweep*PSweep*(3 - 2*PSweep))", },
						LightEnv = Input { Expression = "SweepGain*min(1, PSweep*5)*min(1, (1 - PSweep)*5)", },
						Glisten = Input { Expression = "0.8 + 0.2*sin(LT*0.37)*sin(LT*0.113 + 0.7)", },
						LeadQ = Input { Expression = "iif(Ctl.Line1.Value:sub(1, 1):upper() == 'Q', 1, 0)", },
						YR = Input { Expression = "0.35 + VOffset", },
					},
