					NameSet = true,
					Inputs = {
						NumberIn1 = Input { Expression = "G1.X1 + G1.OL - G1.PX0", },
						NumberIn2 = Input { Expression = "G1.OB - G1.PY0", },
						NumberIn3 = Input { Expression = "G1.OW", },
