						NumberIn5 = Input { Expression = "1.6*Ctl.LightEnv", },
						NumberIn6 = Input { Expression = "0.3/G1.CW", },
						NumberIn7 = Input { Expression = "G1.Res", },
						PointIn1 = Input { Expression = "Point((G1.LX - G1.CX0)/G1.CW, (G1.LY - G1.CY0)/G1.CH)", },
						Setup1 = Input { Value = "2.4*n7/w1", },
						Setup2 = Input { Value = "2.4*n7/h1", },
						Intermediate1 = Input { Value = "(getr1d(x - s1, y) - getr1d(x + s1, y))*n1", },
						Intermediate2 = Input { Value = "(getr1d(x, y - s2) - getr1d(x, y + s2))*n1", },
						Intermediate3 = Input { Value = "1/sqrt(i1*i1 + i2*i2 + 1)", },
						RedExpression = Input { Value = "n4*max(0, (0.7 - 0.45*i1 + 0.55*i2)*i3) + n5/(1 + (sqrt((p1x - x)^2 + ((p1y - y)*h1/w1)^2 + n2*n2)/n6)^2)*max(0, (i1*(p1x - x) + i2*(p1y - y)*h1/w1 + n2)*i3/sqrt((p1x - x)^2 + ((p1y - y)*h1/w1)^2 + n2*n2))", },
						GreenExpression = Input { Value = "0.35*n4*max(0, (1.7 - 0.45*i1 + 0.55*i2)*i3/1.842)^n3 + n5/(1 + (sqrt((p1x - x)^2 + ((p1y - y)*h1/w1)^2 + n2*n2)/n6)^2)*max(0, (i1*(p1x - x) + i2*(p1y - y)*h1/w1 + n2 + sqrt((p1x - x)^2 + ((p1y - y)*h1/w1)^2 + n2*n2))*i3/sqrt(2*((p1x - x)^2 + ((p1y - y)*h1/w1)^2 + n2*n2) + 2*n2*sqrt((p1x - x)^2 + ((p1y - y)*h1/w1)^2 + n2*n2)))^n3", },
						BlueExpression = Input { Value = "r1", },
						AlphaExpression = Input { Value = "1", },
