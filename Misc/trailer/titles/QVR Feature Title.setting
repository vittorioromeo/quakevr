				SubText = TextPlus {
					NameSet = true,
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						StyledText = Input { Value = "Charge, throw, and stab.\nLift and manipulate impaled enemies.", },
						Font = Input { Value = "Cinzel", },
						Style = Input { Value = "Regular", },
