						InFrames = { LINKS_Name = "In (frames)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 40, INP_Integer = true, INP_MinScale = 1, INP_MaxScale = 120, INP_MinAllowed = 1, ICS_ControlPage = "Controls", },
						OutFrames = { LINKS_Name = "Out (frames)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 26, INP_Integer = true, INP_MinScale = 1, INP_MaxScale = 120, INP_MinAllowed = 1, ICS_ControlPage = "Controls", },
						HoldFrames = { LINKS_Name = "Hold (frames, 0 = to clip end)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_Integer = true, INP_MinScale = 0, INP_MaxScale = 600, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
						SubDelay = { LINKS_Name = "Subtitle Delay (frames)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 10, INP_Integer = true, INP_MinScale = 0, INP_MaxScale = 60, INP_MinAllowed = 0, ICS_ControlPage = "Controls", },
