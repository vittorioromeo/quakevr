			Tools = ordered() {
				Ctl = Background {
					NameSet = true,
					Inputs = {
						EffectMask = Input { SourceOp = "ScrimMask", Source = "Mask", },
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						TopLeftRed = Input { Value = 0.012, },
						TopLeftGreen = Input { Value = 0.008, },
						TopLeftBlue = Input { Value = 0.008, },
						TopLeftAlpha = Input { Expression = "ScrimAmount*Env", },
						Corner = Input { Value = 0, },
						AccentRed = Input { Value = 0.42, },
						AccentGreen = Input { Value = 0.015, },
						AccentBlue = Input { Value = 0.01, },
						Intensity = Input { Value = 1, },
						Blood = Input { Value = 1, },
						MetalRed = Input { Value = 0.56, },
						MetalGreen = Input { Value = 0.46, },
						MetalBlue = Input { Value = 0.34, },
						Relief = Input { Value = 1, },
						SweepGain = Input { Value = 1, },
						SweepDir = Input { Value = 0, },
						SweepStart = Input { Value = 4, },
						SweepFrames = Input { Value = 84, },
						InFrames = Input { Value = 40, },
						OutFrames = Input { Value = 26, },
						HoldFrames = Input { Value = 0, },
						SubDelay = Input { Value = 10, },
						ScrimAmount = Input { Value = 0.72, },
						ShadowOpacity = Input { Value = 0.8, },
						ShadowSoftness = Input { Value = 9, },
						ShadowOffset = Input { Value = 6, },
						MarginX = Input { Value = 0.06, },
						MarginY = Input { Value = 0.075, },
						Gap1 = Input { Value = 0.016, },
						Gap2 = Input { Value = 0.02, },
						TitleH = Input { Value = 1.25, },
						LT = Input { Expression = "time - comp.RenderStart", },
						OutStart = Input { Expression = "iif(HoldFrames > 0, InFrames + HoldFrames, comp.RenderEnd - comp.RenderStart + 1 - OutFrames)", },
						PIn = Input { Expression = "min(max(LT/max(InFrames, 1), 0), 1)", },
						PSub = Input { Expression = "min(max((LT - SubDelay)/max(InFrames, 1), 0), 1)", },
						POut = Input { Expression = "min(max((LT - OutStart)/max(OutFrames, 1), 0), 1)", },
						EIn = Input { Expression = "1 - (1 - PIn)^2.4", },
						ESub = Input { Expression = "1 - (1 - PSub)^2.4", },
						EOut = Input { Expression = "POut^1.6", },
						Right = Input { Expression = "iif(Corner == 0, 1, iif(Corner == 3, 1, 0))", },
						Top = Input { Expression = "iif(Corner < 1.5, 1, 0)", },
						Dir = Input { Expression = "Right*2 - 1", },
						AX = Input { Expression = "iif(Right == 1, 1 - MarginX, MarginX)", },
						Env = Input { Expression = "min(1, PIn*1.6)*(1 - EOut)", },
						Flick = Input { Expression = "1 - min(1, Intensity)*0.7*max(1 - PIn, POut)*iif(abs(sin(LT*78.233 + LT*LT*0.131)) > 0.6, 1, 0)", },
						Torch = Input { Expression = "0.9 + 0.1*sin(LT*0.23)*sin(LT*0.071 + 1.3)", },
						LowTitle = Input { Expression = "1.06 - 1.12*EIn + 1.15*EOut", },
						LowSub = Input { Expression = "1.06 - 1.12*ESub + 1.15*EOut", },
						Grow = Input { Expression = "min(1, max(0, (LT - 0.35*InFrames)/(InFrames + 170)))^0.55", },
						PSweep = Input { Expression = "min(max((LT - SweepStart)/max(SweepFrames, 1), 0), 1)", },
						USweep = Input { Expression = "iif(SweepDir == 0, PSweep*PSweep*(3 - 2*PSweep), 1 - PSweep*PSweep*(3 - 2*PSweep))", },
						LightEnv = Input { Expression = "SweepGain*min(1, PSweep*5)*min(1, (1 - PSweep)*5)", },
						Glisten = Input { Expression = "0.8 + 0.2*sin(LT*0.37)*sin(LT*0.113 + 0.7)", },
					},
					ViewInfo = OperatorInfo { Pos = { -440, -60 } },
					UserControls = ordered() {
						Corner = { LINKS_Name = "Corner", LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0, INP_Integer = true, ICS_ControlPage = "Controls", CC_LabelPosition = "Horizontal", { CCS_AddString = "Top-Right" }, { CCS_AddString = "Top-Left" }, { CCS_AddString = "Bottom-Left" }, { CCS_AddString = "Bottom-Right" }, },
