#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D RuntimeDepth;
layout(set=0,binding=1,std430) buffer Output { float values[]; };
layout(push_constant) uniform Size { uint width; uint height; } size;
void main()
{
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(pixel.x>=size.width || pixel.y>=size.height) return;
    values[pixel.y*size.width+pixel.x]=texelFetch(RuntimeDepth,ivec2(pixel),0).r;
}
