@SolidClass =
	func_group : "Group of brushes for in-editor use"
[
]

@SolidClass =
	func_detail : "Group of brushes for certain compilers"
[
]

@SolidClass =
	func_detail_illusionary : "func_detail variant with no collision (players / monsters / gunfire) and doesn't split world faces."
[
]

@SolidClass =
	func_detail_wall : "func_detail variant that doesn't split world faces."
[
]

@SolidClass =
	func_detail_fence : "Detail with see-through texels (ericw-tools)

A func_detail for fences and grates: brushes with a { texture (a masked texture: palette index 255 is see-through),
which do not block vis."
[
]

@SolidClass =
	func_illusionary_visblocker : "Walk-through brush that blocks vis (ericw-tools)

Like func_illusionary (the player walks through it), but it blocks visibility like a wall: for curtains of liquid
or fake walls between areas."
[
]

//
// Other point entities
//

@PointClass size(-8 -8 -8, 8 8 8) =
	misc_external_map : "Prefab from another .map (ericw-tools)

qbsp imports the worldspawn brushes of _external_map, turns them by _external_map_angles, moves them to its
origin, and makes them an entity of class _external_map_classname (func_detail by default is common)."
[
	_external_map(string) : "Map file" :  : "The .map to import (relative to this map's folder)."
	_external_map_classname(string) : "Classname" : "func_detail" : "The class the imported brushes become (worldspawn merges them into the world)."
	_external_map_angles(string) : "Angles (pitch yaw roll)" : "0 0 0"
	_external_map_scale(string) : "Scale" : "1"
]
