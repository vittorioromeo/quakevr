@PointClass color(0 128 0) size(-4 -4 -4, 4 4 4) =
	info_aimhelp_rocket : "From Honey (czg): Quake VR does not ship Honey's own models and sounds (honey/...).

Used as a helpful aim target for rockets."
[
	distance(float) : "Distance" :  : "A distance (units) or an angle (degrees): see the help for this entity."
	volume(float) : "Volume" :  : "Sound volume, 0 to 1."
	lip(integer) : "Lip" :  : "Units of the brush left showing at the end of its move."
]

@PointClass color(76 26 153) size(-10 -10 -8, 10 10 8) =
	info_command : "From the Scourge of Armagon (hipnotic): its models and sounds come from the hipnotic folder.

Stuffs a command into the console to allow map designers to set server variables.

'message' is the command to send to the console."
[
	message(string) : "Message" :  : "Text shown to the player. \n makes a new line."
]

@PointClass base(Angle, Targetname) =
	info_endcam : "Honey: end camera

Honey's ending: shortly after the level starts it plays the ending cutscene (the players fly free, the music
stops), fires its targets, and wait seconds later ends the game. Honey's own maps only."
[
	wait(float) : "Seconds before the end" : 180
]

@PointClass base(Appearflags) color(255 128 128) size(-16 -16 -16, 16 16 16) =
	info_intermission : "Intermission camera

This is the camera point for the intermission. Use mangle instead of angle, so you can set pitch or roll as well as yaw. 'pitch roll yaw'"
[
	mangle(string) : "Camera angle (Pitch Yaw Roll)"
]

@PointClass base(Appearflags, Target, Targetname) color(200 150 150) size(-4 -4 -4, 4 4 4) =
	info_notnull : "Wildcard entity

Used as a positional target for lightning."
[
	use(string) : "self.use"
	think(string) : "self.think"
	nextthink(integer) : "nextthink"
	noise(string) : "noise"
	touch(string) : "self.touch"
]

@PointClass color(200 150 150) size(-4 -4 -4, 4 4 4) =
	info_null : "info_null (spotlight target)

Used as a positional target for spotlights, etc."
[
	targetname(target_source) : "Name"
]

