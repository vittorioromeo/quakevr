<?xml version="1.0" encoding="utf-8"?>
<!-- mimalloc (Quake/vr/external/mimalloc/README.md): the process's C heap (vr_crtheap.c), as a static library linked into
     ironwail (quakevr.props, when QVR_MIMALLOC). Its own project so that it is compiled once: a rebuild of the engine's
     project, or a change to the engine's settings, leaves it alone (docs/vr-port/ROUND22.md, "Build speed, round 3").
     One C file, src/static.c, includes the others. The settings are the ones it had inside ironwail.vcxproj, per
     configuration (that project's and quakevr.props' C settings: optimisation, runtime library, the Release flags, ThinLTO
     except with QvrNoLto=1, the defines the Windows and C runtime headers read); MI_DEBUG follows NDEBUG (types.h: 0 with
     it, else 2: its asserts and invalid-free checks in Debug). An archive is fine here: on Windows static.c defines no C
     runtime function (vr_crtheap.c does, and its calls to mi_* pull static.obj in). -->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release-Tracy|x64">
      <Configuration>Release-Tracy</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release-TracyFull|x64">
      <Configuration>Release-TracyFull</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{38CD0922-A220-4CCA-BCD1-64B6B0688C89}</ProjectGuid>
    <RootNamespace>mimalloc</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <CharacterSet>NotSet</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="quakevr.toolset.props" /><!-- clang-cl, as the engine -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)Build-$(ProjectName)\bin\$(PlatformShortName)\$(Configuration)\</OutDir>
    <IntDir>Build-$(ProjectName)\$(PlatformShortName)\$(Configuration)\</IntDir>
    <QvrLto>true</QvrLto>
    <QvrLto Condition="'$(QvrNoLto)'=='1' or '$(QvrNoLto)'=='true'">false</QvrLto>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- As ironwail's: the ClangCL toolset's single-process compile leaves StringPooling (/GF) and the C standard out. -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <AdditionalIncludeDirectories>..\..\Quake\vr\external\mimalloc\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_CRT_NONSTDC_NO_DEPRECATE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Debug'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- quakevr.props' Release settings (Release and Release-Tracy, as there), and its ThinLTO. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' or '$(Configuration)'=='Release-Tracy'">
    <ClCompile>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <StringPooling>true</StringPooling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <SDLCheck>false</SDLCheck>
      <FloatingPointModel>Precise</FloatingPointModel>
      <AdditionalOptions>/Ob3 /Gw %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="('$(Configuration)'=='Release' or '$(Configuration)'=='Release-Tracy') and '$(QvrLto)'=='true'">
    <ClCompile>
      <AdditionalOptions>-flto=thin %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\Quake\vr\external\mimalloc\src\static.c" />
    <ClInclude Include="..\..\Quake\vr\external\mimalloc\include\*.h;..\..\Quake\vr\external\mimalloc\include\mimalloc\*.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
