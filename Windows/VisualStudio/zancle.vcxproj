<?xml version="1.0" encoding="utf-8"?>
<!-- Zancle (Quake/vr/external/zancle/README.md): its concurrency module and what that needs, with vr_jobs.cpp (the
     game's thread pool: the only file that includes Zancle), as a static library linked into ironwail (quakevr.props).
     clang-cl (the ClangCL toolset: Visual Studio's "C++ Clang tools for Windows"), because Zancle is written against
     the GCC/Clang builtins (__atomic_*, __has_builtin); the engine stays on MSVC, the objects link together (the same
     ABI, the same runtime library per configuration). C++23 and optimised without Zancle's asserts (NDEBUG) in every
     configuration; no whole-program optimisation (the MSVC linker's LTCG takes only MSVC objects). -->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{E286BCD0-E4E0-4F68-B335-083019EA8E02}</ProjectGuid>
    <RootNamespace>zancle</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>ClangCL</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)Build-$(ProjectName)\bin\$(PlatformShortName)\$(Configuration)\</OutDir>
    <IntDir>Build-$(ProjectName)\$(PlatformShortName)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- C++23 (clang-cl's /std:c++latest leaves _MSVC_LANG below 202302L, which Zancle's Config.hpp rejects). -->
      <AdditionalOptions>/clang:-std=c++23 %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <FloatingPointModel>Precise</FloatingPointModel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>..\..\Quake\vr;..\..\Quake\vr\external\zancle\include;..\..\Quake\vr\external\zancle\src;..\..\Quake\vr\external\zancle\extlibs\moodycamel;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;NDEBUG;ZA_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- The runtime library and its debug level as ironwail's, per configuration (the objects are linked together). -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\**\*.cpp">
      <ObjectFileName>$(IntDir)%(RecursiveDir)</ObjectFileName>
    </ClCompile>
    <ClCompile Include="..\..\Quake\vr\vr_jobs.cpp" />
    <ClInclude Include="..\..\Quake\vr\vr_jobs.hpp;..\..\Quake\vr\external\zancle\include\Zancle\**\*.hpp;..\..\Quake\vr\external\zancle\extlibs\moodycamel\*.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
