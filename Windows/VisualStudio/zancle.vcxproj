<?xml version="1.0" encoding="utf-8"?>
<!-- Zancle (Quake/vr/external/zancle/README.md): the modules the Quake VR code uses and what they need, as a static
     library linked into ironwail (quakevr.props). Its own project for its own settings: C++23; in Release optimised
     without Zancle's asserts (NDEBUG), ThinLTO as the engine; in Debug by the switch QVR_ZANCLE_DEBUG (as CMake's
     option and the Makefiles' variable of that name): true, built as the engine's Debug (unoptimised, _DEBUG, Zancle's
     asserts on: a failure calls vr_zancle.cpp's handler, as in the engine's files); false, optimised without its
     asserts as in Release. Pass /p:QVR_ZANCLE_DEBUG=false (or true) to MSBuild to choose. clang-cl, as the whole engine
     (Zancle is written against the GCC/Clang builtins: __atomic_*, __has_builtin). -->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{E286BCD0-E4E0-4F68-B335-083019EA8E02}</ProjectGuid>
    <RootNamespace>zancle</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture><!-- the 64-bit clang-cl (VC/Tools/Llvm/x64) -->
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>ClangCL</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(QVR_ZANCLE_DEBUG)'==''">
    <!-- On during the Zancle migration (docs/vr-port/ROUND21.md, "Zancle migration"): Zancle in Debug with its asserts. -->
    <QVR_ZANCLE_DEBUG>true</QVR_ZANCLE_DEBUG>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)Build-$(ProjectName)\bin\$(PlatformShortName)\$(Configuration)\</OutDir>
    <IntDir>Build-$(ProjectName)\$(PlatformShortName)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- C++23 (clang-cl's /std:c++latest leaves _MSVC_LANG below 202302L, which Zancle's Config.hpp rejects). -->
      <AdditionalOptions>/clang:-std=c++23 %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <FloatingPointModel>Precise</FloatingPointModel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <AdditionalIncludeDirectories>..\..\Quake\vr\external\zancle\include;..\..\Quake\vr\external\zancle\src;..\..\Quake\vr\external\zancle\extlibs\moodycamel;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;ZA_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- The runtime library and its debug level as ironwail's, per configuration (the objects are linked together). -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- QVR_ZANCLE_DEBUG: Zancle as the engine's Debug (unoptimised, its asserts on; QVR_ZANCLE_DEBUG tells its Assert.cpp
       to leave the handler to vr_zancle.cpp). Else optimised without its asserts, Debug as Release. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' and '$(QVR_ZANCLE_DEBUG)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>QVR_ZANCLE_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>Disabled</Optimization>
      <InlineFunctionExpansion>Default</InlineFunctionExpansion>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Debug' or '$(QVR_ZANCLE_DEBUG)'!='true'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>-flto=thin %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\**\*.cpp">
      <ObjectFileName>$(IntDir)%(RecursiveDir)</ObjectFileName>
    </ClCompile>
    <ClInclude Include="..\..\Quake\vr\external\zancle\include\Zancle\**\*.hpp;..\..\Quake\vr\external\zancle\extlibs\moodycamel\*.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
