// Quake VR startup script (replaces id1/quake.rc when running -game quakevr).

exec default.cfg
exec config.cfg
// The settings picked on Setup's settings page (installer_settings.cfg), once: vr_cvars.cpp, docs/vr-port/INSTALLER.md.
vr_installer_settings
exec quakevr.cfg
exec autoexec.cfg

stuffcmds

// With VR enabled, the vrstart hub; otherwise the attract demos (Quake/vr/vr_main.cpp).
vr_startgame
