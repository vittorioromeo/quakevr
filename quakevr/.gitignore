# Quake VR's build output and the files the game writes in its folder
/progs.dat
/progs.lno
/*.cfg
!/quakevr.cfg
!/default.cfg
!/vr_bindings.cfg
!/vr_defaults.cfg
!/relight_textures.cfg
/*.sav
/*.dem
/autosave/
/maps/autosave/
/screenshots/
/notes/
/proposed_defaults/
/ragtool/
/motions/*
!/motions/expect.cfg
!/motions/suspects.cfg
/profile/
/sound_tests/
/cache/
/bodycal/
/bodycal_history.txt
/eyeshots/
/agglitch/
/relit/
/envmap.tga
/checklist_ticks.txt
/tips_seen.txt
/tips_seen.txt.tmp
/graphics_my_settings.cfg
/graphics_my_settings.cfg.tmp
/search_recent.txt
/textures_ext/
/retro_overrides.txt
/imagehash.txt
/relight_on_first_start.txt
/relit_custom/
/relight_lights.txt
# Saves anywhere in the game folder (tests write them under maps/ too) and the config's copies (the kit's
# ironwail.cfg.baseline, ironwail.cfg.from-tests, dated backups)
*.sav
*.sav.addon
# The player's runtime brushes kept for a map (vr_brush_save: brushes/<map>.brushes), and brush_test.py's map with
# them baked in (vr_brush_bake_write)
/brushes/
/maps/brushbake_*
/ironwail.cfg.*
# What the engine writes for debugging and tests (vr_highlights, vr_portals_shot, vr_wounds, the traces' cvars,
# vr_decal_atlas, the grasp dump, -condebug)
/highlights/
/portalshots/
/wounds/
/*_trace.txt
/weight_test.csv
/bodytrack_dump*.csv
/decal_atlas.png
/grasp_dump.obj
/qconsole.log
# Local maps and mods kept in the development game folder (not Quake VR's)
/ad
/apsp3
/maps/apsp3.bsp
/maps/warden.bsp
/maps/vrwip.*
/progs/hand_rig.md5mesh.old
/qvr_openxr.txt
# Crash reports (vr_crash.cpp: quakevr/crash/<date>_<time>.txt and .dmp)
/crash/
# Diagnostics mode's folders (vr_diagnostics.cpp: quakevr/diagnostics/<date>_<time>/)
/diagnostics/
# Every run's logs and the bug reports (vr_runlogs.cpp: quakevr/logs/<date>_<time>/, quakevr/bugreports/<date>_<time>.zip)
/logs/
/bugreports/
# Doom on the wrist gadget (vr_doom): its settings and saves, and the player's own WADs dropped in
/doom/*.cfg
/doom/savegame/
/doom/wads/*
!/doom/wads/README.txt
