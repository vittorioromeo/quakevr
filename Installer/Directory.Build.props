<Project>
  <!-- Shared by every project of the Quake VR installer (Installer/README.md). -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The game's version, the repository's VERSION file (docs/vr-port/RELEASING.md, "Versions"): the installer's file and
         assembly version (its window's "Installer x.y.z"). The release script passes the same with /p:Version. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Company>Vittorio Romeo</Company>
    <Product>Quake VR Installer</Product>
    <Copyright>GPL-2.0-or-later</Copyright>
  </PropertyGroup>
  <!-- onnxruntime's NuGet package (Core's reliefs step) carries its import library, onnxruntime.lib: never needed at run
       time, and a single-file publish would leave it beside QuakeVR-Setup.exe (make_release.ps1 refuses extra files). -->
  <Target Name="QvrDropImportLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
</Project>
