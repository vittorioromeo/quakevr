<UserControl x:Class="QuakeVR.Installer.Views.StatementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One half of a YES/NO switch: a slot of cold iron; the picked half glows in its colour (Tag). Neither is lit
             until the player picks one, and radio buttons cannot be un-picked: no way back to neither. -->
        <Style x:Key="SwitchHalf" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontFamily" Value="{StaticResource CondensedFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Width" Value="62" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="{StaticResource DarkText}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70FFE6C0" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="8" Opacity="0.8" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding StatementTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatementSubtitle}" Style="{StaticResource PageSubtitle}" />

            <!-- The paragraphs, and the author's photo to their right, top-aligned. Docked first, the photo keeps its
                 size and the text wraps in what is left (at most 700 wide). The column is at most the text's 700 and
                 the photo's 174: the photo's edge lines up with the claims' below at the default size, and stays
                 beside the text in a wide window instead of drifting to the far edge. -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="874" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Width="150" Height="188" VerticalAlignment="Top" Margin="24,3,0,10" CornerRadius="3"
                            BorderBrush="{StaticResource CardEdge}" BorderThickness="1" Background="{StaticResource Card}"
                            AutomationProperties.Name="Photo of Vittorio Romeo">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="10" Opacity="0.6" />
                        </Border.Effect>
                        <Border CornerRadius="2">
                            <Border.Background>
                                <ImageBrush ImageSource="/QuakeVR-Setup;component/Assets/author.jpg" Stretch="UniformToFill"
                                            RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border.Background>
                        </Border>
                    </Border>
                    <ItemsControl ItemsSource="{Binding StatementParagraphs}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="15" LineHeight="21.5" Margin="0,0,0,10" MaxWidth="700"
                                           HorizontalAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding StatementChoices}" Margin="0,6,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,7">
                            <DockPanel>
                                <!-- The switch: YES | NO in a sunken slot. -->
                                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Padding="2" CornerRadius="3"
                                        Background="#FF0B0907" BorderBrush="{StaticResource SunkenEdge}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="YES" Style="{StaticResource SwitchHalf}" Tag="{StaticResource Ok}"
                                                     IsChecked="{Binding IsYes, Mode=TwoWay}"
                                                     AutomationProperties.Name="Yes" AutomationProperties.HelpText="{Binding Text}" />
                                        <RadioButton Content="NO" Style="{StaticResource SwitchHalf}" Tag="{StaticResource Error}"
                                                     IsChecked="{Binding IsNo, Mode=TwoWay}"
                                                     AutomationProperties.Name="No" AutomationProperties.HelpText="{Binding Text}" />
                                    </StackPanel>
                                </Border>
                                <!-- A rune: the claim's number while unanswered, a check for YES, a cross for NO. -->
                                <Grid Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Rectangle x:Name="Rune" Width="18" Height="18" Fill="{StaticResource Card}" Stroke="#FF5C4A3B" StrokeThickness="1"
                                               RadiusX="2" RadiusY="2">
                                        <Rectangle.LayoutTransform><RotateTransform Angle="45" /></Rectangle.LayoutTransform>
                                    </Rectangle>
                                    <TextBlock x:Name="Mark" Text="{Binding Number}" FontFamily="{StaticResource CondensedFont}" FontSize="12.5"
                                               FontWeight="Bold" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"><Run Text="{Binding TextBefore, Mode=OneWay}" /><Run Text="{Binding TextEmphasis, Mode=OneWay}" FontStyle="Italic" /><Run Text="{Binding TextAfter, Mode=OneWay}" /></TextBlock>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsYes}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Ok}" />
                                <Setter TargetName="Rune" Property="Fill" Value="{StaticResource Ok}" />
                                <Setter TargetName="Mark" Property="Text" Value="&#xE73E;" />
                                <Setter TargetName="Mark" Property="FontFamily" Value="{StaticResource IconFont}" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DarkText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNo}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Error}" />
                                <Setter TargetName="Rune" Property="Fill" Value="{StaticResource Error}" />
                                <Setter TargetName="Mark" Property="Text" Value="&#xE711;" />
                                <Setter TargetName="Mark" Property="FontFamily" Value="{StaticResource IconFont}" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DarkText}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
