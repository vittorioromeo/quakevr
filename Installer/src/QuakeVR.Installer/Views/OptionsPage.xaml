<UserControl x:Class="QuakeVR.Installer.Views.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Size" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="16,2,0,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Options" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Change anything you like." />

            <!-- Where Quake VR: Unleashed comes from: a local package (no internet), or the online release. When the online
                 release can't be reached, this says so and offers a local package instead of a dead end. -->
            <TextBlock Text="PACKAGE" Style="{StaticResource SectionTitle}" />
            <Border Padding="16,13">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FeedUnavailable}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="90" Height="6" VerticalAlignment="Center"
                                     Visibility="{Binding FeedChecking, Converter={StaticResource BoolToVis}}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0"
                                    Visibility="{Binding FeedUnavailable, Converter={StaticResource BoolToVis}}">
                            <Button Content="Use a local package…" Style="{StaticResource AccentButton}" Command="{Binding BrowsePackageCommand}" />
                            <Button Content="Try again" Style="{StaticResource GhostButton}" Command="{Binding RetryFeedCommand}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding PackageSourceTitle}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding PackageSourceText}" Style="{StaticResource Small}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding FeedErrorDetail}" Style="{StaticResource Small}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,4,0,0"
                               Visibility="{Binding FeedUnavailable, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding PackageError}" Style="{StaticResource Small}" Foreground="{StaticResource Error}" Margin="0,6,0,0"
                               Visibility="{Binding HasPackageError, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Use a local package instead…" Style="{StaticResource LinkButton}" Command="{Binding BrowsePackageCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding FeedAvailable, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Use another package…" Style="{StaticResource LinkButton}" Command="{Binding BrowsePackageCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasLocalPackage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <TextBlock Text="INSTALL FOLDER" Style="{StaticResource SectionTitle}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource GhostButton}" Command="{Binding BrowseInstallDirCommand}" Margin="10,0,0,0" />
                <TextBox Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Text="{Binding InstallDirError}" Style="{StaticResource Small}" Foreground="{StaticResource Error}" Margin="2,6,0,0"
                       Visibility="{Binding HasInstallDirError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding DiskText}" Style="{StaticResource Small}" Margin="2,6,0,0" />

            <TextBlock Text="COMPONENTS" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource CardBorder}" Padding="16,14,16,4">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CoreSizeText}" Style="{StaticResource Size}" />
                        <CheckBox IsChecked="True" IsEnabled="False">
                            <StackPanel>
                                <TextBlock Text="Quake VR: Unleashed" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="The game: engine, models, sounds, the hub and its maps, and the author's default settings." />
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TexturesSizeText}" Style="{StaticResource Size}" />
                        <CheckBox IsChecked="{Binding HdTextures}">
                            <StackPanel>
                                <TextBlock Text="HD textures (highly recommended)" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="{Binding TexturesText}" />
                                <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0" Foreground="{StaticResource Warn}"
                                           Visibility="{Binding FeedUnavailableForTextures, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Their download isn't available right now: they are skipped (run Setup again later), or" />
                                    <Hyperlink Command="{Binding BrowseTexturesCommand}" Foreground="{StaticResource AccentHover}">pick the texture pack's zip</Hyperlink><Run Text="." />
                                </TextBlock>
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="about a minute" Style="{StaticResource Size}" />
                        <CheckBox IsChecked="{Binding Relight}">
                            <StackPanel>
                                <TextBlock Text="Relight the maps at the first start (highly recommended)" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0"
                                           Text="Light from lamps, lava and glowing panels, made on your PC by the game's Relighting tool." />
                                <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Foreground="{StaticResource Faint}"
                                           Text="With see-through water: VisPatch's data for your games is downloaded with it (about 2.5 MB, from SourceForge)." />
                            </StackPanel>
                        </CheckBox>
                    </DockPanel>
                    <!-- The shortcuts: one row under the components (the page fits a 1366 x 768 screen). -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="-16,0" Padding="16,12,16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shortcuts" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <CheckBox IsChecked="{Binding DesktopShortcut}" Content="On the desktop" Margin="0,0,28,0" />
                            <CheckBox IsChecked="{Binding StartMenuShortcuts}" Content="In the Start menu" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
