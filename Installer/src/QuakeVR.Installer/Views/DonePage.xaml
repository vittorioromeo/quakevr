<UserControl x:Class="QuakeVR.Installer.Views.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Grid Width="52" Height="52" Margin="0,0,18,0" VerticalAlignment="Top">
                    <Ellipse Fill="{StaticResource Ok}" Opacity="0.18" />
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{StaticResource Ok}" />
                </Grid>
                <StackPanel>
                    <TextBlock Text="Quake VR is ready" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Start your VR software, put on your headset, and press Play." />
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Style="{StaticResource AccentButton}" Command="{Binding LaunchVrCommand}" Padding="22,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,10,0" />
                        <TextBlock Text="Play in VR" />
                    </StackPanel>
                </Button>
                <Button Content="Play on the monitor" Style="{StaticResource GhostButton}" Command="{Binding LaunchFlatCommand}" Margin="10,0,0,0" Padding="18,10" Click="Button_Click" />
                <Button Content="Open the Quake VR folder" Style="{StaticResource LinkButton}" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </StackPanel>

            <TextBlock Text="GOOD TO KNOW" Style="{StaticResource SectionTitle}" Margin="2,26,0,10" />
            <ItemsControl ItemsSource="{Binding DoneNotes}" ItemTemplate="{StaticResource CheckItemTemplate}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Play from Steam or SteamVR's library (optional)" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Small}" Margin="0,4,0,0">
                        <Run Text="In Steam: Games > Add a Non-Steam Game to My Library > Browse, pick" />
                        <Run Text="{Binding SteamExePath, Mode=OneWay}" Foreground="{StaticResource Text}" />
                        <Run Text=". Then in its Properties, paste these Launch Options:" />
                    </TextBlock>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource GhostButton}" Command="{Binding CopySteamOptionsCommand}"
                                MinWidth="0" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding SteamLaunchOptions, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
