<UserControl x:Class="QuakeVR.Installer.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skin="clr-namespace:QuakeVR.Installer.Skin">
    <UserControl.Resources>
        <!-- A feature's icon: a small riveted iron plate with an ember glyph. -->
        <Style x:Key="FeatureIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SkinTrimBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RaisedEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="CacheMode">
                <Setter.Value>
                    <BitmapCache />
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="6" Opacity="0.8" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeatureGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFFF7A20" ShadowDepth="0" BlurRadius="10" Opacity="1" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- The logo, over its own fire. -->
            <Grid Height="190" ClipToBounds="True">
                <skin:FireView Heat="0.85" CellSize="4" EmberCount="26" FireOpacity="0.9" Glow="0.2" />
                <Image Source="/QuakeVR-Setup;component/Assets/logo_wide.png" Height="172" Margin="0,8,0,0" VerticalAlignment="Top"
                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" CacheMode="BitmapCache">
                    <Image.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="22" Opacity="0.95" />
                    </Image.Effect>
                </Image>
            </Grid>
            <TextBlock Style="{StaticResource PageTitle}" FontSize="32" Margin="0,8,0,0" ><Run Text="Quake, "/><Run Language="it-it" Text="UNLEASHED"/><Run Language="it-it" Text=" "/><Run Text="in virtual reality"/></TextBlock>
            <TextBlock Style="{StaticResource PageSubtitle}" FontSize="15" MaxWidth="640" HorizontalAlignment="Left">
                Hands, physics, full-body melee and a tuned look, built on the Ironwail engine. This installer sets
                everything up in a few clicks.
            </TextBlock>

            <!-- An existing install: the Update screen. The footer's one primary button updates (or repairs); Install
                 again from scratch and Remove are the secondary choices. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,24,0,0" BorderBrush="{StaticResource Accent}"
                    Visibility="{Binding HasExisting, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove…" Style="{StaticResource GhostButton}" Command="{Binding UninstallCommand}"
                                VerticalAlignment="Top" Margin="12,0,0,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding ExistingTitle}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Text="{Binding ExistingText}" Style="{StaticResource Body}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Small}" Margin="0,6,0,0"
                                       Visibility="{Binding ExistingNeedsPackage, Converter={StaticResource BoolToVis}}">
                                <Hyperlink Command="{Binding BrowsePackageCommand}" Foreground="{StaticResource AccentHover}">Pick a package…</Hyperlink>
                                <Run Text="   " />
                                <Hyperlink Command="{Binding RetryFeedCommand}" Foreground="{StaticResource AccentHover}">Try again</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding ExistingDetail}" Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OtherInstallsText}" Style="{StaticResource Small}" Foreground="{StaticResource Faint}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding HasOtherInstalls, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0">
                                <Hyperlink Command="{Binding ToggleReinstallCommand}" Foreground="{StaticResource AccentHover}">Install again from scratch…</Hyperlink>
                                <Run Text="   " />
                                <Hyperlink Command="{Binding BrowseExistingCommand}" Foreground="{StaticResource AccentHover}">Use another install…</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <!-- Install again from scratch: two choices, a backup first, then the whole wizard. -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowReinstall, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="INSTALL AGAIN FROM SCRATCH" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap"
                                   Text="Every program file is copied again, and you pick the options again. Only what you tick here is reset or removed:" />
                        <CheckBox IsChecked="{Binding ResetSettings}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ReinstallSettingsText}" Style="{StaticResource Body}" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding RemoveSaves}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ReinstallSavesText}" Style="{StaticResource Body}" />
                        </CheckBox>
                        <TextBlock Text="{Binding BackupText}" Style="{StaticResource Small}" Foreground="{StaticResource Faint}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Install again…" Style="{StaticResource GhostButton}" Command="{Binding ReinstallCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,24,0,0">
                <DockPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource FeatureIcon}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource FeatureGlyph}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Finds your Quake" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,3,0,0"
                                   Text="Steam, GOG or Epic, the original or the 2021 rerelease, and the expansions you own." />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource FeatureIcon}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource FeatureGlyph}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Leaves your Quake untouched" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,3,0,0"
                                   Text="Quake VR goes in its own folder and reads your game files, music included, where they are." />
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Style="{StaticResource FeatureIcon}">
                        <TextBlock Text="&#xE793;" Style="{StaticResource FeatureGlyph}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" ><Run Language="it-it" Text="Enhances maps and graphics"/></TextBlock>
                        <TextBlock Style="{StaticResource Small}" Margin="0,3,0,0"
                                   ><Run Text="HD textures"/><Run Text=", "/><Run Text="relit maps"/><Run Text=", dynamic lights, and parallax mapping -- filtered through customizable retro shaders"/><Run Language="it-it" Text="."/></TextBlock>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource FeatureIcon}">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource FeatureGlyph}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Works with your headset" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Small}" Margin="0,3,0,0"
                                   Text="Any OpenXR runtime: Virtual Desktop, SteamVR, Meta Quest Link." />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
