<UserControl x:Class="QuakeVR.Installer.Views.SettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <!-- Reset to default, hidden but keeping its place when the value is the default (WPF: Visibility Hidden). -->
        <Style Selector="Button.LinkButton.hidden"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
    </UserControl.Styles>
    <!-- The settings page (ViewModels/SettingsViewModels.cs): a tree of categories > subcategories > settings, each
         with its control (on/off, a row of choices, a slider with its value), the game's help, and Reset. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SettingsPage}">
        <StackPanel>
            <TextBlock Text="Set up the game" Classes="PageTitle" />
            <TextBlock Classes="PageSubtitle" Text="{Binding Subtitle}" />

            <DockPanel Margin="0,16,0,10">
                <Button DockPanel.Dock="Right" Content="Reset all to defaults" Classes="LinkButton" Command="{Binding ResetAllCommand}"
                        VerticalAlignment="Center" Margin="18,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Open or close all" Classes="LinkButton" Command="{Binding ExpandAllCommand}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding ChangedText}" Classes="Small" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <ToggleButton Classes="TreeHeader" IsChecked="{Binding IsExpanded}">
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource CondensedFont}" FontSize="17" FontWeight="SemiBold" />
                            </ToggleButton>
                            <!-- The branch: a brass guide line down its left, as a tree's. -->
                            <ItemsControl ItemsSource="{Binding Subcategories}" Focusable="False" Margin="17,0,0,0"
                                          IsVisible="{Binding IsExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brass}" BorderThickness="1,0,0,0" Padding="16,10,0,2" Opacity="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Classes="SectionTitle" Margin="0,0,0,6"
                                                           IsVisible="{Binding HasTitle}" />
                                                <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="CardBorder" Margin="0,0,0,6" Padding="14,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Label}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <TextBlock Text="  changed" Classes="Small" Foreground="{StaticResource AccentHover}"
                                                                                   VerticalAlignment="Center" IsVisible="{Binding IsChanged}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="Reset to default" FontSize="12.5"
                                                                            Command="{Binding ResetCommand}" VerticalAlignment="Center"
                                                                            ToolTip.Tip="{Binding Def.Default, StringFormat=Default: {0}}" Classes="LinkButton" Classes.hidden="{Binding IsDefault}" />

                                                                    <!-- The control its kind needs. -->
                                                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                                        <CheckBox Content="On" IsChecked="{Binding IsOn}"
                                                                                  IsVisible="{Binding IsToggle}" />
                                                                        <ItemsControl ItemsSource="{Binding Choices}" Focusable="False"
                                                                                      IsVisible="{Binding IsChoice}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <RadioButton Classes="ChoicePill" Content="{Binding Label}"
                                                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip.Tip="{Binding Help}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <DockPanel IsVisible="{Binding IsSlider}">
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Classes="Body"
                                                                                       FontFamily="{StaticResource MonoFont}" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center" />
                                                                            <Slider Minimum="{Binding SliderMin}" Maximum="{Binding SliderMax}" Value="{Binding Number}"
                                                                                    SmallChange="{Binding SliderStep}" LargeChange="{Binding SliderStep}" TickFrequency="{Binding SliderStep}"
                                                                                    IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                        </DockPanel>
                                                                    </Grid>

                                                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                                        <TextBlock Text="{Binding SelectedHelp}" Classes="Small" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                                                                                   IsVisible="{Binding HasSelectedHelp}" Margin="0,0,0,4" />
                                                                        <TextBlock Text="{Binding Help}" Classes="Small" TextWrapping="Wrap"
                                                                                   IsVisible="{Binding HasHelp}" />
                                                                        <TextBlock Text="{Binding WhereInGame}" Classes="Small" Foreground="{StaticResource Faint}"
                                                                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
