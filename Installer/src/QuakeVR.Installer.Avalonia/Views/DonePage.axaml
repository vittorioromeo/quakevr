<UserControl x:Class="QuakeVR.Installer.Views.DonePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Image Source="avares://QuakeVR-Setup/Assets/logo_square.png" Width="92" Height="92" Margin="-6,-10,14,0" VerticalAlignment="Top"
                       RenderOptions.BitmapInterpolationMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect OffsetX="0" OffsetY="0" Color="Black" BlurRadius="14" Opacity="0.9"/>
                    </Image.Effect>
                </Image>
                <StackPanel>
                    <TextBlock Text="Quake VR: Unleashed is ready" Classes="PageTitle" />
                    <TextBlock Classes="PageSubtitle" Text="Start your VR software, put on your headset, and press Play." />
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Classes="AccentButton" Command="{Binding LaunchVrCommand}" Padding="22,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Classes="Glyph" FontSize="13" Margin="0,0,10,0" />
                        <TextBlock Text="Play in VR" />
                    </StackPanel>
                </Button>
                <Button Content="Play on the monitor" Classes="GhostButton" Command="{Binding LaunchFlatCommand}" Margin="10,0,0,0" Padding="18,10" />
                <Button Content="Open the Quake VR folder" Classes="LinkButton" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </StackPanel>

            <TextBlock Text="GOOD TO KNOW" Classes="SectionTitle" Margin="2,26,0,10" />
            <ItemsControl ItemsSource="{Binding DoneNotes}" ItemTemplate="{StaticResource CheckItemTemplate}" />

            <Border Classes="CardBorder" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Play from Steam or SteamVR's library (optional)" Classes="Body" FontWeight="SemiBold" />
                    <TextBlock Classes="Small" Margin="0,4,0,0">
                        <Run Text="In Steam: Games > Add a Non-Steam Game to My Library > Browse, pick" />
                        <Run Text="{Binding SteamExePath, Mode=OneWay}" Foreground="{StaticResource Text}" />
                        <Run Text=". Then in its Properties, paste these Launch Options:" />
                    </TextBlock>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Classes="GhostButton" Command="{Binding CopySteamOptionsCommand}"
                                MinWidth="0" Padding="14,6" Margin="10,0,0,0" />
                        <TextBox Text="{Binding SteamLaunchOptions, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
