<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything the installer does that is not UI: detection, manifests, install/uninstall, shortcuts, downloads.
       Testable without a window (tests/QuakeVR.Installer.SelfTest, the CLI). -->
  <PropertyGroup>
    <RootNamespace>QuakeVR.Installer.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine's own lists of each official pack's required files (Quake/vr/vr_gamedir.cpp): one source of truth. -->
    <EmbeddedResource Include="..\..\..\Quake\vr\vr_pack_*.inc" LogicalName="QuakeVR.Packs.%(Filename).inc" Link="Packs\%(Filename).inc" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QuakeVR.Installer.SelfTest" />
  </ItemGroup>
  <ItemGroup>
    <!-- "Make reliefs for Dwell and Quoth" (Reliefs/ReliefMaker.cs): PBRify's two CC0 models as ONNX
         (Misc/quakevr/pbr_export_onnx.py), run by onnxruntime with DirectML (CPU when DirectML fails). The installer's
         only NuGet package; its native DLLs go inside the single-file QuakeVR-Setup.exe. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.22.0" />
    <EmbeddedResource Include="Reliefs\Models\*.onnx" LogicalName="QuakeVR.Reliefs.%(Filename).onnx" />
  </ItemGroup>
</Project>
