<Project Sdk="Microsoft.NET.Sdk">
  <!-- qvr-setup: the installer's core from a console (detection report, install/uninstall from a local package,
       manifests for packages, downloads). Used by tests and the packaging script; players use the window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>qvr-setup</AssemblyName>
    <RootNamespace>QuakeVR.Installer.Cli</RootNamespace>
    <!-- net9.0-windows by default: the Windows build (bin\<config>\net9.0-windows\qvr-setup.exe, as the release scripts
         and "dotnet run" expect). The property QvrPortable=true: net9.0, the portable build, for Linux
         (dotnet publish with QvrPortable=true and the linux-x64 runtime, self-contained: docs/vr-port/INSTALLER.md,
         "Cross-platform"). The core always builds both. -->
    <TargetFramework Condition="'$(QvrPortable)' == 'true'">net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuakeVR.Installer.Core\QuakeVR.Installer.Core.csproj" />
  </ItemGroup>
</Project>
