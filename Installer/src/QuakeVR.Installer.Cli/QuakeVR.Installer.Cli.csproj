    <OutputType>Exe</OutputType>
    <AssemblyName>qvr-setup</AssemblyName>
    <RootNamespace>QuakeVR.Installer.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuakeVR.Installer.Core\QuakeVR.Installer.Core.csproj" />
  </ItemGroup>
</Project>
