<?xml version="1.0" encoding="utf-8"?>
<!-- qvr_checks: the build's source checks (README.md). Built by the kit's build.sh and, before the QC step, by
     Windows/VisualStudio/ironwail.vcxproj (qvr_checks.targets); not in the solution. Release x64 only, clang-cl. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5C1B7E52-3D0A-4E8B-9A41-7F2C6D9E0B13}</ProjectGuid>
    <RootNamespace>qvr_checks</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>ClangCL</PlatformToolset>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <CharacterSet>NotSet</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\..\..\build\qvr_checks\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\..\..\build\qvr_checks\obj\</IntDir>
    <TargetName>qvr_checks</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- C++23, as the engine's Zancle (zancle.vcxproj: clang-cl's /std:c++latest leaves _MSVC_LANG below 202302L,
           which Zancle's Config.hpp rejects). -->
      <AdditionalOptions>/clang:-std=c++23 %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Zancle (docs/vr-port/ZANCLE.md) for the strings, vectors, maps and algorithms; its few compiled sources below,
           without its asserts (NDEBUG), as the engine's Release. -->
      <AdditionalIncludeDirectories>..\..\Quake\vr\external\zancle\include;..\..\Quake\vr\external\zancle\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;_CRT_SECURE_NO_WARNINGS;ZA_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>None</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <!-- Zancle's clock and sleeps (timeBeginPeriod). -->
      <AdditionalDependencies>winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="common.cpp" />
    <ClCompile Include="statics.cpp" />
    <ClCompile Include="small_checks.cpp" />
    <ClCompile Include="test_numbers.cpp" />
    <ClCompile Include="cvars_qc.cpp" />
    <ClCompile Include="canonical.cpp" />
    <ClCompile Include="qc_compiles.cpp" />
    <ClCompile Include="std_uses.cpp" />
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\Base\Abort.cpp" />
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\Base\Assert.cpp" />
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\Chrono\Clock.cpp" />
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\Concurrency\Thread.cpp" />
    <ClCompile Include="..\..\Quake\vr\external\zancle\src\Zancle\String\String.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="common.hpp" />
    <ClInclude Include="maps.hpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
