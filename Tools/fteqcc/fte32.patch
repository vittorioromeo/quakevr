 				outputsttype = PST_FTE32;
 			}
+			else if (flag_fte32)
+				outputsttype = PST_FTE32;
 		}
 
 		if (qcc_targetformat == QCF_QSS || qcc_targetformat == QCF_DARKPLACES)
